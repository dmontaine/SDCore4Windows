# Compiler intermediates - regenerated by `make` in sdb_ai/sd64.
# The linked binaries in sdb_ai/sd64/bin are deliberately still tracked, since
# the install scripts deploy them straight from the repository.
sdb_ai/sd64/gplobj/*.o

# Generated by the `terminfo` make target, which runs
# `sdtic -pterminfo terminfo.src` after clearing the directory.
# terminfo.src is the real source and stays tracked.
sdb_ai/sd64/terminfo/

# Scratch output from the pcode build (gplbld/bbcmp.py, gplbld/pcode_bld.py).
sdb_ai/sd64/pcode_bld.log
sdb_ai/sd64/pass1
sdb_ai/sd64/pass2
