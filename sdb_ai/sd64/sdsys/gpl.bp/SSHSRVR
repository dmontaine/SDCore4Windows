* START-DESCRIPTION:
*
*    SSH.SERVER INSTALL | REMOVE
*
*    Adds or removes the Windows OpenSSH SERVER on this machine.
*
*    With no keyword it reports whether one is present and changes nothing.
*
* ***WHY THIS MATTERS MORE THAN IT LOOKS.***  Accounts SD creates sign in over
* ssh or over the API - deny-logon.ps1:29 denies them the console and Remote
* Desktop - so removing the server takes away the ssh way in, and for an account
* that has only ssh (including at this keyboard, where it arrives by "ssh
* localhost") that is its only way in.  That is why REMOVE asks before it acts.
*
* ***THE REMOVAL IS STAGED BEHIND A REBOOT AND THE VERB SAYS SO.***  Measured on
* the development host 30 Aug 2026: after Remove-WindowsCapability reported
* success, sshd.exe was still on disk, the sshd service was still Running and
* RebootPending was True.  An administrator who runs this, sees ssh still
* working and reports a bug is what not saying it produces.
*
* ***INSTALL IS SLOW AND SILENT.***  The capability comes from Windows Update
* and can take several minutes with nothing on screen; install-ssh.ps1 carries
* that warning and the installer's own status message says the same.
*
* ***THE CLIENT IS NOT TOUCHED.***  ssh.exe, scp.exe and sftp.exe are a separate
* Windows capability.  This verb is about who can reach THIS machine.
*
* END-DESCRIPTION
*
* START-CODE

$internal

program $ssh.server
$catalog $SSHSRVR

* int$keys.h carries K$ADMINISTRATOR and K$WINPATH; the other three are the set
* MODIFY.ACCOUNT and DELETE.ACCOUNT take.
$include keys.h
$include int$keys.h
$include parser.h
$include err.h

   deffun ps_script(script) calling '!ps_script'

* 31 Aug 26 Windows port - THE REPORTING FORM.  PRE_RELEASE_FIXES 90.  This
*   verb's own description promises "with no keyword it reports whether one is
*   present and changes nothing", and it printed NOTHING: ps_script returns a
*   status and the elevated helper threw the script's output away.  The verb is
*   administrator-gated, so it always took that branch.  Measured 31 Aug 2026.
*   ONLY THE REPORT PATH CHANGED - the INSTALL and REMOVE paths still discard
*   output, because their own messages (10142, 10146, 10147, 10148) already say
*   what happened and showing the script underneath would say it twice.
   deffun ps_script_out(script, want.out) calling '!ps_script_out'

   prompt ''

   if not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001)  ;* Command requires administrator privileges
   end

*  Assigned for BCOMP, and every value is the safe one - no action, no change.
   action = ''
   script = ''
   arg    = ''
   rc     = 0
   yn     = ''
   report = ''
   both   = ''
   r.i    = 0
   rpt    = ''
   rpt.cp = 0

   parser = "!PARSER"
   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)   ;* Verb ssh.server
   call @parser(PARSER$GET.TOKEN, token.type, action, keyword)  ;* INSTALL | REMOVE

   action = upcase(trim(action))

*  NO KEYWORD REPORTS AND STOPS.  remove-ssh.ps1 -Show reads the capability
*  state, which is the same question for both directions, so one script answers
*  it whichever way the administrator is thinking of going.
   if token.type = PARSER$END or action = '' then
      script = '/remove-ssh.ps1'
      arg    = ' -Show'
      gosub run.report
      gosub print.report
      if rc # 0 then
         crt sysmsg(10143, 'SHOW', rc)  ;* Could not read the ssh server state
      end
      stop
   end

   begin case
      case action = 'INSTALL'
         script = '/install-ssh.ps1'
         arg    = ''
      case action = 'REMOVE'
         script = '/remove-ssh.ps1'
         arg    = ''
      case @true
         stop sysmsg(10141)  ;* ssh.server install | remove
   end case

*  ***BOTH ARE CONFIRMED NOW, FOR DIFFERENT REASONS.***  PRE_RELEASE_FIXES 126.
*  REMOVE strands every account that has only ssh, and its prompt names that.
*  INSTALL takes nothing away, but it starts a Windows Update download that can
*  run for up to about an hour with little on screen, so it confirms the time
*  cost and lets the administrator abort rather than be committed unawares.
*  Both default to N; an aborted verb changes nothing (10145).
   if action = 'INSTALL' then
      loop
         display sysmsg(10163) :   ;* Install downloads from WU, up to ~an hour; install now (y/<n>)?
         input yn
         yn = upcase(trim(yn))
         if yn = '' then yn = 'N'
         until yn = 'Y' or yn = 'N'
      repeat
      if yn = 'N' then
         stop sysmsg(10145)  ;* Nothing was changed
      end
   end

   if action = 'REMOVE' then
*     ***THE PROMPT SAYS WHICH ANSWER ENTER GIVES, AND ENTER GIVES IT.***
*     Owner's rule, 30 Aug 2026: "scripts need to indicate which is the default
*     using <y>/n or y/<n>".  N here, and it is the safe one - this is the
*     prompt standing between an administrator and every account's only way in.
      loop
         display sysmsg(10144) :   ;* SD accounts sign in over ssh only (y/<n>)?
         input yn
         yn = upcase(trim(yn))
         if yn = '' then yn = 'N'
         until yn = 'Y' or yn = 'N'
      repeat
      if yn = 'N' then
         stop sysmsg(10145)  ;* Nothing was changed
      end
   end

   gosub run.script

*  ***EXIT 2 IS "NOTHING TO DO", NOT A FAILURE, AND THE TWO READ DIFFERENTLY.***
*  remove-ssh.ps1 exits 2 when the capability is not installed, and
*  install-ssh.ps1 exits 2 when the capability was added but the service is not
*  registered yet - the restart case.  Reporting either as an error would send
*  an administrator looking for a fault that is not there.
   if rc = 2 then
      if action = 'REMOVE' then
         stop sysmsg(10146)  ;* There was no ssh server on this machine to remove
      end
      stop sysmsg(10142)     ;* Installed, and a restart is needed before it runs
   end

   if rc # 0 then
      stop sysmsg(10143, action, rc)  ;* Could not change the ssh server
   end

   if action = 'INSTALL' then
      crt sysmsg(10147)  ;* The OpenSSH server is installed
   end else
      crt sysmsg(10148)  ;* Removal accepted - it completes when Windows restarts
   end

   stop

* ===========================================================================

run.script:
   ps  =       '& ' : char(39) : kernel(K$WINPATH, script) : char(39) : arg
   ps := @fm : 'exit $LASTEXITCODE'
   rc = ps_script(ps)
   return

*  THE SAME CALL, KEEPING THE OUTPUT.  Field 1 is the status ps_script would
*  have returned; fields 2 onwards are what the script printed.
run.report:
   ps  =       '& ' : char(39) : kernel(K$WINPATH, script) : char(39) : arg
   ps := @fm : 'exit $LASTEXITCODE'
   both   = ps_script_out(ps, @true)
   rc     = field(both, @fm, 1)
   report = field(both, @fm, 2, 9999)
   return

*  FIELD BY FIELD.  !ps_script_out returns one line per FIELD, and crt of a
*  dynamic array prints the field marks themselves.
print.report:
*  STRIP THE HELPER SCRIPT'S OWN "name:" PREFIX.  PRE_RELEASE_FIXES 115: the
*  -Show scripts tag every line with their filename (remove-ssh:), which on a
*  read-only report leads with a word like "remove" that has nothing to do with
*  the question asked.  Strip a LEADING "token: " only - a colon-space with no
*  space before it - so a genuine "state : Installed" line is left untouched.
   if report # '' then
      for r.i = 1 to dcount(report, @fm)
         rpt    = report<r.i>
         rpt.cp = index(rpt, ': ', 1)
         if rpt.cp and index(rpt[1, rpt.cp], ' ', 1) = 0 then
            rpt = rpt[rpt.cp + 2, len(rpt)]
         end
         crt rpt
      next r.i
   end
   return

end

