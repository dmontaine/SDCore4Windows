* START-DESCRIPTION:
*
* CALL !ROOTIDX(result, file.name, index, scan.var)
*
* Makes the scan variable that the KEY statement uses: the file name and the name of the index, checked now.  RESULT is 1
* when the file opens and has the index (found in the case given, then in lower and upper case), otherwise 0 with STATUS()
* the error of the OPEN or ER$AKNF (3019).  openQM also takes an A-correlative expression for INDEX and looks for an index
* built from it; SD takes the name of an index only.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine rootidx(ret, fname, idx, scan)
$catalog !rootidx

$include err.h

   ret = 0
   open fname to f else
      set.status status()
      return
   end
   ak = indices(f)
   locate idx in ak<1> setting p else
      s = downcase(idx)
      locate s in ak<1> setting p else
         s = upcase(idx)
         locate s in ak<1> setting p else
            close f
            set.status ER$AKNF
            return
         end
      end
      idx = s
   end
   close f
   scan = fname : @fm : idx
   set.status 0
   ret = 1
   return
end

* END-CODE
