* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $sl_sgr(code, seq)
*
*     code  a style code from $sl_attr (sl.h)
*     seq   returned: the terminal's own strings (SD's @(-13) and friends, so terminfo decides), first
*           switching every attribute off and then setting the ones the style needs, so the result does
*           not depend on what the terminal was doing before.  An unknown code gives n's.
*
*   The sequences are made once, by $sl_theme, when a theme is set; this routine is a lookup.  Until
*   a program asks for a theme the theme is mono.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_sgr(code, seq)
$catalog $sl_sgr

$include sl.h

   common /slthm/ th.name, th.codes, th.defs, th.seqs, th.names, th.asked

   * ready: $sl_theme has set a theme (its block starts as 0 in every variable, not unassigned)
   ready = 0
   if not(unassigned(th.codes)) and not(unassigned(th.name)) then
      if th.codes = SL.CODES and th.name # '' then ready = 1
   end
   if not(ready) then call $sl_theme('set', 'mono', '', '', '', r)

   i = index(th.codes, code, 1)
   if len(code) # 1 or i = 0 then i = 1
   seq = th.seqs<i>

   return
end

* END-CODE
