*
* START-DESCRIPTION:
*
*   SCREEN COMBO f, id, items {AT x,y} {WIDTH n} {VALUE v} {COLOR fg,bg} {ACCEL key}
*
*   is compiled into
*
*   call !screen_combo(f, id, items, x, y, width, value, fg, bg, accel, ret, status)
*
*     f id     the form and the widget's name in it (as SCREEN LABEL)
*     items    the choices, as values (a field mark does as well)
*     x y      the place of the field from the form's top left corner, default 1,1
*     width    the width of the entry field (default 20); [v] follows it, three cells more
*     value    the text it starts with
*     status   0 added; 1 not (ELSE)
*
*   Typing edits the text as in an entry field; Down or F4 opens the list under it.  SCREEN GET f, id answers the text.
*
*   COLOR fg,bg gives the field and the [v] their own colours (see SCREEN ENTRY): kept while the combo box has the focus, underlined.
*
*   ACCEL key gives the combo box a key that reaches it wherever the focus is (see SCREEN ENTRY): f1 to f12, ctrl-a to ctrl-z, alt-a to alt-z or alt-0 to alt-9.
*   The combo box takes the focus.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_combo(f, id, items, ax, ay, width, value, fg, bg, accel, ret, status)
$catalog !screen_combo

   ret = ''
   status = 1
   w = collection()
   w{'id'} = id
   w{'items'} = convert(@fm, @vm, items)
   x = 1
   y = 1
   fw = 20
   if ax # '' then x = ax + 0
   if ay # '' then y = ay + 0
   if width # '' then fw = width + 0
   w{'x'} = x
   w{'y'} = y
   w{'fw'} = fw
   w{'value'} = value
   call $sl_combo('init', w, '', '', r)
   call $sl_color(w, fg, bg, cst)
   if cst # 0 then return
   call $sl_accel(w, accel, ast)
   if ast # 0 then return
   call $sl_wadd(f, w, ok)
   if ok then status = 0

   return
end

* END-CODE
