* START-CODE


$internal
program $delete.list
$catalog $dellist

$include err.h
$include parser.h

deffun edit_guard(f) calling '!edit_guard'   ;* 17 Oct 26 dm, S.64 part 2


   parser = "!PARSER"

   @system.return.code = -ER$ARGS      ;* Preset for command format errors

* ---------------  Step 1 -  Parse the command

   call @parser(parser$reset, 0, @sentence, 0)
   call @parser(parser$get.token, token.type, token, keyword) ;* Verb

   * Get list name

   call @parser(parser$get.token, token.type, list.name, keyword)
   if token.type = PARSER$END then stop 'List name required'
   if list.name = '' then stop sysmsg(3267) ;* Illegal null list name

   * Check no further information in command

   saved.name = '$savedlists'     ;* 12 Oct 26 dm - openQM 494: IN file names another file of saved lists
   call @parser(parser$get.token, token.type, token, keyword)
   if token.type # PARSER$END and upcase(token) = 'IN' then
      call @parser(parser$get.token, token.type, saved.name, keyword)
      if token.type = PARSER$END or saved.name = '' then stop sysmsg(12082) ;* Saved lists file name required after IN
      call @parser(parser$get.token, token.type, token, keyword)
   end
   if token.type # PARSER$END then
      stop sysmsg(2018, token) ;* Unexpected token (xx)
   end


* ---------------  Step 2 -  Open the save list file

   open saved.name to saved.lists.file else
      @system.return.code = -status()
      stop sysmsg(3248, status()) ;* Error xx opening $savedlists
   end

* 17 Oct 26 dm - S.64 part 2: IN names any file, and this program is $internal, so the kernel's own test lets its DELETE through.  It asks
*   about the file opened, before the record is read or locked.  The default $savedlists is none of the three guarded kinds.
   if not(edit_guard(saved.lists.file)) then
      @system.return.code = -ER$PERM
      stop
   end

* ---------------  Step 3 -  Delete the select list

   readvu list.rec from saved.lists.file, list.name, 0 else
      release saved.lists.file, list.name
      @system.return.code = -status()
      stop sysmsg(3268, list.name) ;* Saved select list 'xx' not found
   end

   delete saved.lists.file, list.name

   @system.return.code = 0
   display sysmsg(3269, list.name) ;* Deleted saved list 'xx'

   return

   * Avoid compiler warnings
   list.rec = list.rec
end

* END-CODE
