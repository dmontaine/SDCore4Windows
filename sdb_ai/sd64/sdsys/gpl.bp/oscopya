*
* START-DESCRIPTION:
*
*   OSCOPY source target {OVERWRITE | APPEND}
*
* Copies an operating system file.  Without an option it will not replace a
* target that exists; OVERWRITE replaces it and APPEND adds the source to the
* end of it.  A directory is not copied (see !IOSCOPY for that).
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $oscopy
$catalog $oscopya

$include err.h
$include keys.h
$include parser.h

   parser = "!PARSER"

   @system.return.code = -ER$ARGS      ;* Preset for command format errors

   mode = 0
   paths = ''

   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb

   loop
      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   until token.type = PARSER$END
      begin case
         case upcase(token) = 'OVERWRITE'
            mode = 1
         case upcase(token) = 'APPEND'
            mode = 2
         case 1
            paths<-1> = token
      end case
   repeat

   if dcount(paths, @fm) # 2 then stop sysmsg(2018, convert(@fm, ' ', paths)) ;* Unexpected token (xx)

   source = paths<1>
   target = paths<2>

   call !OSCOPY(source, target, mode, status)

   @system.return.code = status
   begin case
      case status = 0
         display sysmsg(12066, source, target) ;* xx copied to xx
      case status = -2
         display sysmsg(12069, source) ;* Source xx not found
      case status = -3
         display sysmsg(12068, target) ;* Target xx already exists: give OVERWRITE or APPEND
      case status = -4
         display sysmsg(12185, @who) ;* %1 has no OS access, so a file or directory outside its own account cannot be reached
      case 1
         display sysmsg(12067, source, target, status) ;* Cannot copy xx to xx (status xx)
   end case

   return
end

* END-CODE
