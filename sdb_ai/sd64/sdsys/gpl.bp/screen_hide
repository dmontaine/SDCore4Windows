*
* START-DESCRIPTION:
*
*   SCREEN HIDE f
*
*   is compiled into
*
*   call !screen_hide(f, ret, status)
*
*     f        the form
*     status   0; 1 if f is not a form (ELSE)
*
*   What was under the form when it was shown is put back.  A form that is not shown is left alone.  The values
*   in its widgets stay, so the form can be shown again.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_hide(f, ret, status)
$catalog !screen_hide

$include sl.h

   ret = ''
   status = 1
   if jtype(f) # 'collection' then return
   if system(25) then
      status = 0
      return
   end
   call $sl_scr('get', scr)
   call $sl_form('hide', f, scr, '', r)
   call $sl_scr('put', scr)
   status = 0

   return
end

* END-CODE
