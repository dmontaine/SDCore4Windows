*
* START-DESCRIPTION:
*
*   SCREEN LIST f, id, items {AT x,y} {SIZE w,h} {VALUE n} {MULTI} {COLOR fg,bg} {ACCEL key}
*
*   is compiled into
*
*   call !screen_list(f, id, items, x, y, w, h, value, multi, fg, bg, accel, ret, status)
*
*     f id     the form and the widget's name in it (as SCREEN LABEL)
*     items    the entries, as values (a field mark does as well)
*     x y      the top left cell of the list from the form's top left corner, default 1,1
*     w h      its width and the number of rows it shows (default: as wide as the longest entry needs, as
*              many rows as there are entries, at most 8).  With more entries than rows the right-hand
*              column is a scroll bar.
*     value    the entry the list starts on (default the first)
*     multi    several entries can be picked: the space bar picks or unpicks the current one
*     status   0 added; 1 not (ELSE)
*
*   SCREEN GET f, id answers the number of the current entry (with MULTI, the numbers picked, as values).
*
*   COLOR fg,bg gives the rows their own colours (see SCREEN ENTRY); the current row is still in the focus style while the list has the focus.
*
*   ACCEL key gives the list a key that reaches it wherever the focus is (see SCREEN ENTRY): f1 to f12, ctrl-a to ctrl-z, alt-a to alt-z or alt-0 to alt-9.  The list
*   takes the focus.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_list(f, id, items, ax, ay, sw, sh, value, multi, fg, bg, accel, ret, status)
$catalog !screen_list

   ret = ''
   status = 1
   list = convert(@fm, @vm, items)
   n = dcount(list, @vm)
   if list = '' then n = 0
   widest = 0
   for i = 1 to n
      if len(list<1, i, 1>) > widest then widest = len(list<1, i, 1>)
   next i
   lead = 1
   if multi # '' then lead = 4
   lh = n
   if lh > 8 then lh = 8
   if lh < 1 then lh = 1
   if sh # '' then lh = sh + 0
   lw = widest + lead
   if n > lh then lw += 1                         ;* the scroll bar
   if sw # '' then lw = sw + 0

   w = collection()
   w{'id'} = id
   x = 1
   y = 1
   if ax # '' then x = ax + 0
   if ay # '' then y = ay + 0
   w{'x'} = x
   w{'y'} = y
   w{'w'} = lw
   w{'h'} = lh
   w{'items'} = list
   w{'multi'} = (multi # '')
   w{'cur'} = value + 0
   call $sl_list('init', w, '', '', r)
   call $sl_color(w, fg, bg, cst)
   if cst # 0 then return
   call $sl_accel(w, accel, ast)
   if ast # 0 then return
   call $sl_wadd(f, w, ok)
   if ok then status = 0

   return
end

* END-CODE
