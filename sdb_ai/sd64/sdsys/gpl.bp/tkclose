*
* START-DESCRIPTION:
*
*   call !tkclose(ctx)
*
*   Gives the terminal back: the screen first, then the break setting !tkopen saved.  Call it on EVERY way out, the cursor lock's own key ('guardquit') and the end
*   of the input included.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine tkclose(ctx)
$catalog !tkclose

   call $tk_close(ctx)
   return
end

