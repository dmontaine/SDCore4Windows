* START-HISTORY:
* 17 Oct 26  dm  S.64 part 2 (the edit gates): COMO ON record IN dirfile (and APPEND, and the log of PHANTOM LOG dirfile, which the
*                phantom starts with this verb) writes terminal output into a record of the directory file, replacing it or
*                adding to it, and the statement asks nothing itself (op_tio.c como_open).  The full pathname of the record is
*                asked of K$EDIT.OS.OK before the statement, so a directory file that is a program file, a dictionary or the
*                VOC is refused unless the session has the gate; the reason is displayed.  The $COMO pointer and directory the
*                verb makes for itself are not asked: a log in $COMO is the verb's ordinary use.
* 19 Jan 04  0.6.1 SD launch. Earlier history details suppressed.
* 18 Oct 26 Windows port - from Linux f3a22e8 (12 Oct 26): openQM 8, 9, 361: APPEND, IN dirfile, and record names mapped as for a directory file.
* END-HISTORY
*
* START-DESCRIPTION:
*
*    COMO { ON record.name {APPEND} {IN dirfile} }
*         { OFF                     }
*
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $como
$catalog $COMO

$include keys.h
$include int$keys.h
$include err.h

$include parser.h
$include syscom.h

$define default.como.dir "$COMO"
$define como.dir.voc.name "$COMO"


   @system.return.code = -ER$ARGS

   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb

   * Parse action keyword

   call @parser(PARSER$GET.TOKEN, token.type, action, keyword) ;* First argument
   action = upcase(action)

   begin case
      case keyword = KW$ON           ;* Commence logging of terminal data
         call @parser(PARSER$GET.TOKEN, token.type, como.record.name, keyword)

         if como.record.name = "" then
            stop sysmsg(6410) ;* Record name required after ON keyword
         end

         * 18 Oct 26 Windows port - from Linux f3a22e8 (12 Oct 26): - openQM 8 and 361, SD's own syntax:  COMO ON record {APPEND} {IN dirfile}
         append = @false
         alt.dir = ''
         loop
            call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
         until token.type = PARSER$END
            begin case
               case upcase(token) = 'APPEND'
                  append = @true
               case upcase(token) = 'IN'
                  call @parser(PARSER$GET.TOKEN, token.type, alt.dir, keyword)
                  if alt.dir = '' then stop sysmsg(12079) ;* Directory file name required after IN
               case 1
                  stop sysmsg(2018, token) ;* Unexpected token (xx)
            end case
         repeat

         gosub como.on

      case keyword = KW$OFF          ;* Terminate logging of terminal data
         gosub como.off

      case 1
         stop sysmsg(6411) ;* Unrecognised COMO action
   end case

   @system.return.code = 0

   return

*****************************************************************************
* COMO.ON  -  Activate COMO

como.on:
   if fileinfo(como.file, FL$OPEN) then
      @system.return.code = -ER$IN.USE
      stop sysmsg(6412, como.record) ;* COMO file already active as xx
   end

   * Read any existing &COMO VOC record

   read como.rec from @voc,como.dir.voc.name then
      como.dir = como.rec<2>

      * Check if COMO directory exists
      
      open como.dir to como.file then
         * Check file type
         if fileinfo(como.file, FL$TYPE) # FL$TYPE.DIR then
            @system.return.code = -ER$NDIR
            stop sysmsg(1428, como.dir) ;* xx is not a directory file
         end
      end else
         if status() # ER$NVR then
            @system.return.code = -status()
            stop sysmsg(1430,status(), como.dir) ;* Error xx opening xx
         end
      end
   end else
      recordlocku @voc,como.dir.voc.name

      como.dir = default.como.dir

      * Create new COMO directory

      create.file como.dir directory on error
         release @voc,como.dir.voc.name
         @system.return.code = -status()
         stop sysmsg(1432, status(), os.error(), como.dir) ;* Error xx creating xx
      end

      como.rec = "File for COMO output" : @fm : como.dir

      write como.rec to voc, como.dir.voc.name

      open como.dir to como.file else
         @system.return.code = -status()
         stop sysmsg(1430,status(), como.dir) ;* Error xx opening xx
      end
   end

   * The directory: the $COMO one, or the file named after IN (openQM 361)
   target.dir = como.dir
   if alt.dir # '' then
      open alt.dir to alt.f else
         @system.return.code = -status()
         stop sysmsg(1430, status(), alt.dir) ;* Error xx opening xx
      end
      if fileinfo(alt.f, FL$TYPE) # FL$TYPE.DIR then
         @system.return.code = -ER$NDIR
         stop sysmsg(1428, alt.dir) ;* xx is not a directory file
      end
      target.dir = fileinfo(alt.f, FL$PATH)
      close alt.f
   end

   * Names with characters a directory file cannot hold are mapped as for any other record (openQM 9)
   mapped.name = ospath(como.record.name, OS$MAPPED.NAME)

* 17 Oct 26 dm - S.64.  The COMO statement replaces, or adds to, a record of the directory file, whichever file that is, and asks
*   nothing itself.  The pathname it will be given is asked here, before it is: a directory file that is a program file, a dictionary
*   or the VOC needs the gate for its kind (the administrator is never refused).  The record is a plain file, so no lock is held, and
*   the $COMO directory opened above is closed again so that a refusal does not leave this verb looking active.
   if not(kernel(K$EDIT.OS.OK, target.dir : @ds : mapped.name)) then
      @system.return.code = -ER$PERM
      eom.path = target.dir : @ds : mapped.name
      gosub edit.os.message
      if fileinfo(como.file, FL$OPEN) then close como.file
      stop eom.text
   end

   como (if append then '>>' else '') : target.dir : @ds : mapped.name
   como.record = como.record.name
   recordlocku como.file, como.record.name

   display sysmsg(6413, como.record.name) ;* COMO file activated to xx

   return

*****************************************************************************
* COMO.OFF  -  Deactivate COMO file

como.off:
   if not(fileinfo(como.file, FL$OPEN)) then
      @system.return.code = -ER$NCOMO
      stop sysmsg(6414) ;* No COMO file active
   end

   como ""
   close como.file

   display sysmsg(6415) ;* COMO file deactivated

   return

*****************************************************************************
* EDIT.OS.MESSAGE  -  S.64: why K$EDIT.OS.OK refused the OS pathname in eom.path; the text comes back in eom.text
*
* The kernel refuses when ANY component of the path below the account names a VOC, a dictionary or a program file that the session
* may not change, and K$EDIT.KIND looks only at the last one, so each component is asked and the first whose gate is off is the one
* named (12410 the VOC, 12411 a dictionary, 12412 a program file).  A path the kernel refused without finding one in the text that
* was typed (a symbolic link, one it could not resolve) gets 12415, the message edit_guard gives for a path it cannot read.

edit.os.message:
   eom.kind = 0
   for eom.i = 1 to dcount(eom.path, '/')
      eom.k = kernel(K$EDIT.KIND, field(eom.path, '/', eom.i))
      if eom.kind = 0 and eom.k >= 1 and eom.k <= 3 then
         begin case
            case eom.k = 1 ; eom.gate = kernel(K$VOC.EDIT, -1)
            case eom.k = 2 ; eom.gate = kernel(K$DICT.EDIT, -1)
            case 1         ; eom.gate = kernel(K$BP.EDIT, -1)
         end case
         if not(eom.gate) then eom.kind = eom.k
      end
   next eom.i
   eom.msg = 12415
   if eom.kind then eom.msg = 12409 + eom.kind
   eom.text = sysmsg(eom.msg)
   return
end

