$internal
$no.symbols
$no.xref
function py_dictgetkeys(dictname)
$catalog !py_dictgetkeys

$include KEYS.H
$include ERR.H
*
* Modified by Composer AI - 2026/06/10.
* Reject empty Python object name(s) before SDPYOBJ/SDEXT call.
if dictname = '' then
   set.status 1
   return ''
end
* --------------------
key_list = SDPYOBJ("","",dictname,SD_PyDictKeys)
*
return key_list

end
