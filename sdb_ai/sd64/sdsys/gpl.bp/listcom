* START-DESCRIPTION:
*
*    LIST.COMMON { ALL } { DETAIL }
*
*       ALL    Show system common blocks (internal mode only)
*       DETAIL Show the program that created each block
*
* END-DESCRIPTION
*
* START-CODE


$internal
program list.common
$catalog $listcom

$include parser.h
$include int$keys.h
$include err.h

   parser = "!PARSER"
   show.all = @false
   detail = @false

   internal = kernel(K$INTERNAL,-1)

   @system.return.code = -ER$ARGS      ;* Preset for command format errors

* ---------------  Step 1 -  Parse command

   call @parser(parser$reset, 0, @sentence, 0)
   call @parser(parser$get.token, token.type, token, keyword) ;* Verb

   loop
      call @parser(parser$get.token, token.type, token, keyword)
   until token.type = PARSER$END
      begin case
         case keyword = KW$ALL and internal
            show.all = @true
         case keyword = KW$DETAIL
            detail = @true
         case 1
            stop sysmsg(2018, token) ;* Unexpected token (xx) 
      end case
   repeat
   
   @system.return.code = 0

* ---------------  Step 2  -  Get list of commons

   * list.common() gives each block as name]creator (the program that made it); the names are sorted on their own

   raw = list.common()
   num.common = dcount(raw, @fm)
   names = ''
   for i = 1 to num.common
      names<-1> = raw<i,1>
   next i
   call !sort(names, commons, 'A')

* ---------------  Step 3  -  Report

   name.width = 0
   for i = 1 to num.common
      if len(commons<i>) > name.width then name.width = len(commons<i>)
   next i

   found = @false
   for i = 1 to num.common
      s = commons<i>
      if s[1,1] # '$' or show.all then
         if detail then
            locate s in names<0> setting pos else pos = 0
            * the object header holds the path of the object file; the program is its last part
            creator = raw<pos,2>
            creator = field(creator, @ds, dcount(creator, @ds))
            crt fmt(s, (name.width + 2) : 'L') : creator
         end else
            crt s
         end
         found = @true
      end
   next i

   if not(found) then crt sysmsg(3235) ;* No named common blocks present

   return
end

* END-CODE
