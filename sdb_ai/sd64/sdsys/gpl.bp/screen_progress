*
* START-DESCRIPTION:
*
*   SCREEN PROGRESS f, id {AT x,y} {WIDTH n} {VALUE v}
*
*   is compiled into
*
*   call !screen_progress(f, id, x, y, width, value, ret, status)
*
*     f id     the form and the widget's name in it (as SCREEN LABEL)
*     x y      the place of the bar from the form's top left corner, default 1,1
*     width    the whole width of the bar, "[#####     ] 60%" (default 20, at least 10)
*     value    the share done, 0 to 100 (default 0)
*     status   0 added; 1 not (ELSE)
*
*   The bar cannot take the focus.  Change it with SCREEN SET f, id VALUE v: the bar is redrawn at once if the
*   form is on the screen (a program that does a long job with a form shown by SCREEN WAIT).
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_progress(f, id, ax, ay, width, value, ret, status)
$catalog !screen_progress

   ret = ''
   status = 1
   w = collection()
   w{'id'} = id
   x = 1
   y = 1
   if ax # '' then x = ax + 0
   if ay # '' then y = ay + 0
   w{'x'} = x
   w{'y'} = y
   if width # '' then w{'w'} = width + 0
   w{'value'} = value + 0
   call $sl_progress('init', w, '', '', r)
   call $sl_wadd(f, w, ok)
   if ok then status = 0

   return
end

* END-CODE
