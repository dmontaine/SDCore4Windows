* TOOL_SESSIONS
* Sessions, locks and logout: the administrator's one screen for who is signed on, what they hold, and ending a session (S.75, plan .claude/plan-fullscreen-toolkit.md section 5, A4).
* Copyright (c) 2026, SD Core for Linux.  This program is free software; you can redistribute
* it and/or modify it under the terms of the GNU General Public License, version 3 or later.
*
* START-HISTORY:
* 24 Oct 26 dm  New.
* 26 Oct 26 dm  S.76 (the owner's decision of 26 Oct 2026): when SDSYS has more than one session on a terminal, each of those rows says "sdsys xN" in the State column, the counts line says
*               "SDSYS in N places" and the row under the cursor says so.  !SDSYSN is the one definition of such a session.
* 28 Oct 26 dm  S.88 L2: the three boxes are panes of the layout service ($tk_layout): at 140 by 43 exactly the boxes the page has always drawn, in a bigger window the two lists show more rows
*               and every box is wider, and the sentences about the row are wrapped at the width of their box.  The resize key makes the layout again.
* 1 Nov 26 dm  S.99 (look only): names its focus boxes (ctx<TK.C.FOCI>), so $tk_frame marks the one with the focus [*] and the other [-], as the IDE does.
* 1 Nov 26 dm  S.97 stage 2 (group B): the AI line ($tk_aipage), as tool.voc has it: F6 or AI > Ask the AI; the list switch, the output pane and refresh are offered; no logout,
*              unlock or inhibit.
* 3 Nov 26 dm  S.137: the login time was read as a lock time (UTC seconds since 1970), but it is the kernel's sdtime(), local seconds from SD's day 0: the zone offset and the
*              732 days were added to it again, and a session that signed on at 22:44 on 2 Nov showed "03 Nov 14:44" (two years on, the year not shown).  login.stamp.of
*              formats it as it is; both feed one routine, stamp.local.
* 8 Nov 26 dm  S.176: F6 / Shift-F6 are the box keys of every page ($tk_aipage 'ring', the AI line one of the stops); Tab and Shift-Tab no longer switch the lists.
*              AI > Ask the AI is a menu entry of its own.
* 8 Nov 26 dm  S.179: Ctrl-T the theme (View > Theme) and Ctrl-K the keys of the page (Help > Keys), through $tk_std as on every page.
* 9 Nov 26 dm  S.186: View > Mouse, the same on every page (the case act:std.mouse, through $tk_std); '/' finds a row of the list in focus by typing
*              ($tk_findrow; the owner: "Letters stay, '/' finds").
* END-HISTORY
*
* START-DESCRIPTION:
*
*   TOOL.SESSIONS      (SDSYS's VOC only; the audience is the administrator, asked of the kernel before anything is read)
*
*   A full-screen page, in the toolkit's frame (140 columns by 43 lines at least), with two lists and a box that explains the row under the cursor.  The top list is every session
*   (!LISTU: user number, process, login time, kind, login user, account, where it came from, and whether it is yours or a logout is pending); the lower list is every lock
*   (GETLOCKS: user, file number, path, type, record id, since when, and whether the holder is still signed on).  Both are read again every three seconds and on F5, and a refresh
*   keeps the cursor on the same user or the same lock, never on the same row number.  The state of INHIBIT.LOGIN is shown under the sessions.
*
*   THE PAGE CHANGES NOTHING ITSELF.  Three keys build a command from values the page has read and checked, show it in a box with what it does (Cancel is what Enter chooses) and run it
*   through $tk_run, which allows only these three commands: LOGOUT n (the number typed again to confirm), UNLOCK FILE f USER u id (or FILELOCK) and INHIBIT.LOGIN ON / OFF.  Each verb
*   asks for the administrator itself.  LOGOUT and UNLOCK write no audit line of their own, so the page writes one for every command it ran (tool run app=tool.sessions command=...), as well
*   as the line that says it was started.  It does not offer LOGOUT for the session it runs in.  LOGOUT of a session whose process is already gone clears the entry and releases every lock
*   it held (the kernel does that before it signals anything), so asking again for a session that shows (logout pending) is the cure for a dead one, and is offered.
*
*   Keys: Up, Down, PgUp, PgDn, Home, End move; Tab changes the list; L logs the session out; U releases the lock; I stops or allows new logins; F5 reads again; F1 or ? or a click on the
*   [?] explains the page; Ctrl-Q leaves.  A click on a row puts the cursor there.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $tool_sessions
$catalog $tool_sessions

$include keys.h
$include int$keys.h
$include err.h
$include sl.h
$include tk.h

   prompt ''

   allow = 'logout unlock inhibit.login'                        ;* the commands this page may run
   notyped = ''                                                 ;* the confirm box asks for no name to be typed

   call $tk_open('tool.sessions', 'admin', ctx, err)
   if err # '' then
      display err
      stop
   end
   void kernel(K$AUDIT, 'tool start app=tool.sessions')
   outopen = 0                                                  ;* the output pane (Ctrl-O): closed until asked for
   find.last = ''                                               ;* 9 Nov 26 (S.186): the text '/' asked for last
   gosub declare.layout

   keys = ''
   call $tk_keys('add', keys, 'f1', 'help', 'help', '', 1)
   call $tk_keys('add', keys, 'f6', 'box', 'switch', '', 1)               ;* S.176: F6 / Shift-F6 move between the boxes on every page (Tab does not)
   call $tk_keys('add', keys, 'l', 'logout', 'logout', 'Sessions', 1)
   call $tk_keys('add', keys, 'u', 'unlock', 'unlock', 'Locks', 1)
   call $tk_keys('add', keys, 'i', 'logins', 'inhibit', '', 1)
   call $tk_keys('add', keys, '/', 'find', 'find', '', 1)                  ;* 9 Nov 26 (S.186): '/' finds a row by typing (letters are this page's commands)
   call $tk_keys('add', keys, 'f5', 'refresh', 'refresh', '', 1)
   call $tk_keys('add', keys, 'ctrl-o', 'output', 'output', '', 1)
   call $tk_keys('add', keys, 'ctrl-q', 'quit', 'quit', '', 1)
   call $tk_keys('add', keys, 'esc', 'menu', 'menu', '', 1)                ;* S.88 U2: Esc opens the menu bar (this page holds nothing of its own that Esc closes first)
   call $tk_keys('menu', keys, 'quit', '&File', '&Quit', '', '')
   call $tk_keys('menu', keys, 'logout', '&Sessions', '&Log out the session', '', '')
   call $tk_keys('menu', keys, 'unlock', '&Sessions', '&Unlock the lock', '', '')
   call $tk_keys('menu', keys, 'inhibit', '&Sessions', '&Inhibit or allow logins', '', '')
   call $tk_keys('menu', keys, 'switch', '&View', '&Switch list', '', '')
   call $tk_keys('menu', keys, 'refresh', '&View', '&Refresh', '', '')
   call $tk_keys('menu', keys, 'find', '&View', '&Find a row', '', '')
   call $tk_keys('menu', keys, 'output', '&View', '&Output of the commands (Ctrl-PgUp, Ctrl-PgDn scroll)', '', '')
   call $tk_keys('menu', keys, 'help', '&Help', '&Help on this page', '', '')
   call $tk_std('keys', ctx, keys, '', '')                ;* S.179: Ctrl-T theme, Ctrl-K keys and their View and Help entries, as on every page
   panes = 'Sessions' : @fm : 'Locks'
   * S.97 stage 2 (group B): the AI line.  The page offers the AI only the switch between the lists, the output pane and refresh (logout, unlock and inhibiting logins are
   * NOT offered without the owner's word); a proposal is carried out by the page's own key.  This page laid itself out first, so a line that took a row has the panes
   * declared again.
   call $tk_keys('ai', keys, 'switch', '', '', '', '')
   call $tk_keys('ai', keys, 'output', '', '', '', '')
   call $tk_keys('ai', keys, 'refresh', '', '', '', '')
   call $tk_aipage('init', ctx, keys, '', '', aout)
   if aout then gosub declare.layout

   hs =fmt('', '2L') : fmt('User', '5R') : '  ' : fmt('Pid', '8R') : '  ' : fmt('Logged in', '12L') : ' ' : fmt('Kind', '8L') : fmt('Login user', '15L') : fmt('Account', '20L') : fmt('Where from', '26L') : 'State'
   hl = fmt('User', '5R') : '  ' : fmt('File', '5R') : '  ' : fmt('Path', '30L') : ' ' : fmt('Type', '5L') : fmt('Record id', '32L') : fmt('Since', '13L') : 'Holder'

   pane = 1                                                     ;* 1 the sessions, 2 the locks
   ns = 0 ; nl = 0
   cs = 1 ; ta1 = 0                                             ;* the cursor row and the rows scrolled off, sessions
   cl = 1 ; ta2 = 0                                             ;* the same, locks
   udata = '' ; locks = '' ; lhdr = '' ; inh = ''
   sig = ''
   gen = 0
   done = 0
   msg = ''

   gosub read.all
   gosub draw.all

   loop
      call $tk_menubar('draw', ctx, keys, panes<pane>, '', '', mr)          ;* the bar first: it writes row 0 whole, and the frame then writes the app name at its right end
      call $tk_frame(ctx, keys, panes<pane>, msg)
      call $sl_curat(0, ctx<TK.C.YSTAT>)
      nm = ''
      screen key timeout 3 returning nm
      mr = ''
      ao = ''
      if nm # '' then call $tk_aipage('key', ctx, keys, panes<pane>, nm, ao)         ;* S.97 stage 2: while the AI line has the focus it takes the keys, before the bar sees them
      if ao<1> = 'replay' then nm = ao<2>                                            ;* an action the AI proposed and the person accepted: this page's own key for it
      if ao<1> # '' then msg = ao<4>
      if nm # '' and ao<1> = '' then call $tk_menubar('key', ctx, keys, panes<pane>, nm, outopen, mr)       ;* F10, Alt and a letter, and Esc (the Esc rule: the output pane, when open, is closed first)
      if mr<1> # '' then nm = mr<4>
      begin case
         case ao<1> = 'taken'
            if ao<3> then
               gen += 1                                                               ;* the preview, the wait and the answer covered the page: all of it is drawn again
               ctx<TK.C.GEN> = gen
               gosub draw.all
            end
         case nm = ''
            if status() = ER$EOF then exit
            gosub timed.refresh
         case nm = 'guardquit'
            exit
         case nm = 'resize'
            call $tk_layout('refresh', ctx, '', lchg)
            gosub get.rects
            gosub keep.in.view
            gen += 1
            ctx<TK.C.GEN> = gen
            gosub draw.all
         case nm = 'mouse'
            gosub on.mouse
         case 1
            gosub on.key
      end case
      if done then exit
   repeat

   call $tk_close(ctx)
   stop

* ------------------------------------------------------------------------------------------------- what the system says

* Read the sessions, the locks and the login inhibit again, and put each cursor back on the user or the lock it was on
read.all:
   sel.u = ''
   if ns > 0 and cs >= 1 and cs <= ns then sel.u = udata<cs, 1>
   sel.l = ''
   if nl > 0 and cl >= 1 and cl <= nl then
      lk = cl
      gosub lock.key
      sel.l = lkey
   end
   call !listu(udata)
   call !sdsysn(nsd, sduids, sdmine, sdtty)                     ;* SDSYS on a terminal in more than one place: the rows say so
   ns = dcount(udata, @fm)
   locks = getlocks('', 0)
   lhdr = locks<1>
   del locks<1>
   nl = dcount(locks, @fm)
   call !login_inhibit('STATE', inh, ierr)
   if sel.u # '' then
      for i = 1 to ns
         if udata<i, 1> = sel.u then
            cs = i
            exit
         end
      next i
   end
   if sel.l # '' then
      for lk = 1 to nl
         gosub lock.key
         if lkey = sel.l then
            cl = lk
            exit
         end
      next lk
   end
   if cs > ns then cs = ns
   if cs < 1 then cs = 1
   if cl > nl then cl = nl
   if cl < 1 then cl = 1
   sig = udata : @fm : locks : @fm : inh
   return

* The thing that tells one lock from another: file, user, type and record id
lock.key:
   lkey = locks<lk, 1> : '|' : locks<lk, 3> : '|' : locks<lk, 4> : '|' : locks<lk, 5>
   return

* Every three seconds: read again, and write the lists only when something moved
timed.refresh:
   old.sig = sig
   gosub read.all
   if sig # old.sig then
      gosub draw.lists
      gosub draw.row
   end
   return

* The time a lock was taken (GETLOCKS: seconds since 1 Jan 1970 UTC): day, month, hh:mm in the administrator's zone (as LIST.READU DETAIL does)
stamp.of:
   sdsec = ''
   if tsec > 0 then sdsec = tsec + system(1019) + 732 * 86400
   gosub stamp.local
   return

* The login time of a session (!listu value 8, the kernel's sdtime(): seconds of LOCAL time from SD's day 0, 31 Dec 1967, as LISTU shows it): no zone or day offset to add
login.stamp.of:
   sdsec = tsec
   gosub stamp.local
   return

* sdsec, seconds of local time from SD's day 0, as day, month, hh:mm
stamp.local:
   stampout = ''
   if sdsec > 0 then
      d = int(sdsec / 86400)
      stampout = oconv(d, 'DD') : ' ' : oconv(oconv(d, 'DMA'), 'MCT')[1, 3] : ' ' : oconv(rem(sdsec, 86400), 'MT')
   end
   return

* ------------------------------------------------------------------------------------------------- drawing

* The layout (S.88 L2).  The three boxes are the panes of the layout service, declared in the sizes of the reference layout (140 by 43, the body 138 by 39): the two lists share the rows a
* bigger window gives, equally, and the box under them stays as high as it is.  The page never hands the terminal over, so the declaration is made once, after the open, and the
* rectangles are fetched again after each 'refresh'.
* Out: ssn (the sessions), lck (the locks), rwb (the row under the cursor), each .x .y .w .h; stw, ltw, rtw (the text width of each box); VS and VL (the session and lock rows on
* the screen) and VR (the lines about the row under the cursor).
declare.layout:
   ld = ''
   ld<1> = 'sessions' : @vm : 1 : @vm : 1 : @vm : 15 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   ld<2> = 'locks' : @vm : 2 : @vm : 1 : @vm : 14 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   ld<3> = 'row' : @vm : 3 : @vm : 1 : @vm : 10 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   if outopen then
      * the output pane is open: the sessions 2 rows and the locks 4 rows shorter, and the output pane, 6 rows, between the row box and the foot (rows named lo, not ld: the closed layout above is the page's own)
      lo = ''
      lo<1> = 'sessions' : @vm : 1 : @vm : 1 : @vm : 13 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
      lo<2> = 'locks' : @vm : 2 : @vm : 1 : @vm : 10 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
      lo<3> = 'row' : @vm : 3 : @vm : 1 : @vm : 10 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
      lo<4> = 'output' : @vm : 4 : @vm : 1 : @vm : 6 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
      ld = lo
   end
   ctx<TK.C.FOCI> = 'sessions' : @sm : 'Sessions' : @vm : 'locks' : @sm : 'Locks'        ;* S.99: the boxes that take the focus, for $tk_frame's [*] / [-]
   call $tk_layout('declare', ctx, ld, perr)
   if perr # '' then
      call $tk_close(ctx)
      display perr
      stop
   end
   gosub get.rects
   return

* Ctrl-O or View > Output, and Esc while it is open: the pane is shown or put away, the layout is declared again and all of it drawn
toggle.out:
   call $tk_out('toggle', ctx, '', '', oc)
   outopen = oc
   gosub declare.layout
   gosub keep.in.view
   gen += 1
   ctx<TK.C.GEN> = gen
   gosub draw.all
   return

get.rects:
   call $tk_layout('pane', ctx, 'sessions', lrc)
   ssn.x = lrc<1, 1> ; ssn.y = lrc<1, 2> ; ssn.w = lrc<1, 3> ; ssn.h = lrc<1, 4>
   call $tk_layout('pane', ctx, 'locks', lrc)
   lck.x = lrc<1, 1> ; lck.y = lrc<1, 2> ; lck.w = lrc<1, 3> ; lck.h = lrc<1, 4>
   call $tk_layout('pane', ctx, 'row', lrc)
   rwb.x = lrc<1, 1> ; rwb.y = lrc<1, 2> ; rwb.w = lrc<1, 3> ; rwb.h = lrc<1, 4>
   stw = ssn.w - 4
   ltw = lck.w - 4
   rtw = rwb.w - 4
   VS = ssn.h - 4                                               ;* the heading, the session rows, the line of counts and the border: 11 rows of 15
   VL = lck.h - 4                                               ;* the heading, the lock rows, the lock limit and the border: 10 rows of 14
   VR = rwb.h - 3                                               ;* the lines about the row, the hint and the border: 7 rows of 10
   return

* After a resize the rows scrolled off the top are not more than the rows listed less the rows that fit
keep.in.view:
   if ta1 > ns - VS then ta1 = ns - VS
   if ta1 < 0 then ta1 = 0
   if ta2 > nl - VL then ta2 = nl - VL
   if ta2 < 0 then ta2 = 0
   return

draw.all:
   cw2 = ctx<TK.C.W>
   chh = ctx<TK.C.H> - 5
   screen clear at 0,1 size cw2,chh
   screen box at ssn.x,ssn.y size ssn.w,ssn.h title 'Sessions'
   screen box at lck.x,lck.y size lck.w,lck.h title 'Locks'
   screen box at rwb.x,rwb.y size rwb.w,rwb.h title 'The row under the cursor'
   gosub draw.lists
   gosub draw.row
   if outopen then call $tk_out('draw', ctx, 'output', '', oc)   ;* the output pane, in the rectangle the open layout gives it
   return

draw.lists:
   gosub draw.sessions
   gosub draw.locks
   return

* One session as a line of text; i is its place in udata
session.line:
   v = udata<i>
   flg = v<1, 4>
   kind = 'user'
   begin case
      case bitand(flg, USR$SDNET)
         kind = 'sdnet'
      case bitand(flg, USR$SDVBSRVR)
         kind = 'api'
      case bitand(flg, USR$PHANTOM)
         kind = 'phantom'
   end case
   stt = ''
   if v<1, 1> = @userno then stt = 'you'
   if nsd > 1 and index(@fm : sduids : @fm, @fm : v<1, 1> : @fm, 1) > 0 then stt := (if stt = '' then '' else ' ') : 'sdsys x' : nsd
   if bitand(flg, USR$LOGOUT) then stt := (if stt = '' then '' else ' ') : '(logout pending)'
   tsec = v<1, 8>
   gosub login.stamp.of
   org = v<1, 3>
   if v<1, 7> # '' then org := (if org = '' then '' else ' ') : v<1, 7>
   sline = fmt((if v<1, 1> = @userno then '*' else ''), '2L') : fmt(v<1, 1>, '5R') : '  ' : fmt(v<1, 2>, '8R') : '  ' : fmt(stampout, '12L') : ' ' : fmt(kind, '8L')
   sline := fmt(v<1, 6>, '15L') : fmt(v<1, 9>, '20L') : fmt(org[1, 25], '26L') : stt
   return

draw.sessions:
   screen text hs at ssn.x + 2,ssn.y + 1 attr 'header' width stw
   if cs <= ta1 then ta1 = cs - 1
   if cs > ta1 + VS then ta1 = cs - VS
   if ta1 < 0 then ta1 = 0
   for r = 1 to VS
      kk = ta1 + r
      s = ''
      if kk <= ns then
         i = kk
         gosub session.line
         s = sline
      end
      rat = 'normal'
      if kk = cs and kk <= ns then rat = (if pane = 1 then 'highlight' else 'bold')
      screen text s at ssn.x + 2,ssn.y + 1 + r attr rat width stw
   next r
   n.usr = 0 ; n.ph = 0 ; n.api = 0
   for i = 1 to ns
      flg = udata<i, 4>
      begin case
         case bitand(flg, USR$SDNET) or bitand(flg, USR$SDVBSRVR)
            n.api += 1
         case bitand(flg, USR$PHANTOM)
            n.ph += 1
         case 1
            n.usr += 1
      end case
   next i
   s = ns : ' sessions: ' : n.usr : ' users, ' : n.ph : ' phantoms, ' : n.api : ' API.   '
   if nsd > 1 then s := 'SDSYS in ' : nsd : ' places.   '
   if inh = '' then
      s := sysmsg(12288)
   end else
      s := sysmsg(12289, inh<3>, inh<1>)
   end
   screen text s at ssn.x + 2,ssn.y + ssn.h - 2 attr 'bold' width stw
   call $tk_help('mark', ssn.x + ssn.w - 5, ssn.y + 1, 0, 0)
   return

draw.locks:
   screen text hl at lck.x + 2,lck.y + 1 attr 'header' width ltw
   if cl <= ta2 then ta2 = cl - 1
   if cl > ta2 + VL then ta2 = cl - VL
   if ta2 < 0 then ta2 = 0
   for r = 1 to VL
      kk = ta2 + r
      s = ''
      if kk <= nl then
         lk = kk
         gosub lock.line
         s = lline
      end
      rat = 'normal'
      if kk = cl and kk <= nl then rat = (if pane = 2 then 'highlight' else 'bold')
      screen text s at lck.x + 2,lck.y + 1 + r attr rat width ltw
   next r
   if nl = 0 then screen text 'There are no active file, read or update locks held by any user' at lck.x + 2,lck.y + 2 width ltw
   s = ''
   if lhdr # '' then s = sysmsg(6453, lhdr<1, 1>, lhdr<1, 2>, lhdr<1, 3>)
   screen text s at lck.x + 2,lck.y + lck.h - 2 attr 'bold' width ltw
   return

* One lock as a line of text; lk is its place in locks
lock.line:
   path = locks<lk, 2>
   if len(path) > 30 then path = '...' : path[len(path) - 26, 27]
   tsec = locks<lk, 7>
   gosub stamp.of
   uid = locks<lk, 3>
   gosub holder.of
   lline = fmt(uid, '5R') : '  ' : fmt(locks<lk, 1>, '5R') : '  ' : fmt(path, '30L') : ' ' : fmt(locks<lk, 4>, '5L') : fmt(locks<lk, 5>[1, 31], '32L') : fmt(stampout, '13L') : holder
   return

* Is the holder of a lock signed on?  holder is 'signed on', or 'no session' (no session has that user number)
holder.of:
   holder = 'no session'
   for hi = 1 to ns
      if udata<hi, 1> = uid then
         holder = 'signed on'
         exit
      end
   next hi
   return

* In plain sentences, for the row under the cursor
draw.row:
   lines = ''
   if pane = 1 then
      gosub row.session
   end else
      gosub row.lock
   end
   gosub wrap.lines
   for r = 1 to VR
      screen text lines<r> at rwb.x + 2,rwb.y + r width rtw
   next r
   if pane = 1 then
      s = 'L asks the selected session to end.  Tab changes to the locks.'
   end else
      s = 'U releases the selected lock.  Tab changes to the sessions.'
   end
   screen text s at rwb.x + 2,rwb.y + rwb.h - 2 attr 'bold' width rtw
   return

row.session:
   if ns = 0 or cs < 1 or cs > ns then
      lines<-1> = 'There is no session.'
      return
   end
   v = udata<cs>
   flg = v<1, 4>
   uid = v<1, 1>
   tsec = v<1, 8>
   gosub login.stamp.of
   lines<-1> = 'User ' : uid : ', process ' : v<1, 2> : ', login user ' : v<1, 6> : (if v<1, 9> = '' then ', not in an account yet' else ', in the account ' : v<1, 9>) : (if stampout = '' then '' else ', signed on ' : stampout) : '.'
   begin case
      case bitand(flg, USR$PHANTOM)
         lines<-1> = 'A phantom, started by user ' : v<1, 5> : '.  It has no terminal.'
      case bitand(flg, USR$SDNET)
         lines<-1> = 'An SDNet connection from another server.'
      case bitand(flg, USR$SDVBSRVR)
         lines<-1> = 'An API session' : (if v<1, 3> = '' then '' else ' from ' : v<1, 3>) : '.'
   end case
   if nsd > 1 and index(@fm : sduids : @fm, @fm : uid : @fm, 1) > 0 then lines<-1> = 'One of ' : nsd : ' sessions of SDSYS on a terminal.  The audit trail has a line "sdsys second session" for each one that signed on while another was there.'
   nlk = 0
   for lk = 1 to nl
      if locks<lk, 3> = uid and locks<lk, 4> # 'WAIT' then nlk += 1
   next lk
   lines<-1> = 'It holds ' : nlk : ' lock' : (if nlk = 1 then '' else 's') : ' (the list below shows them).'
   begin case
      case uid = @userno
         lines<-1> = 'This is the session you are in: the page does not offer to log it out.  Ctrl-Q leaves the page and quit ends the session.'
      case bitand(flg, USR$LOGOUT)
         lines<-1> = 'A logout was asked for and the session has not gone.  Asking again with L is safe: if its process is dead the entry is cleared and its locks are released; if it is only busy it is signalled once more.  pstat ' : uid : ' says (Not responding) for a dead one.'
      case 1
         lines<-1> = 'L asks it to end: SD signals the process.  Work that session has not saved is lost and the locks it holds are released.  The command is: logout ' : uid : '.  You type the number again to confirm.'
   end case
   return

row.lock:
   if nl = 0 or cl < 1 or cl > nl then
      lines<-1> = 'There are no locks.'
      return
   end
   lk = cl
   uid = locks<lk, 3>
   typ = locks<lk, 4>
   gosub holder.of
   tsec = locks<lk, 7>
   gosub stamp.of
   begin case
      case typ = 'WAIT'
         lines<-1> = 'User ' : uid : ' is WAITING for a lock on record ' : locks<lk, 5> : ' in file ' : locks<lk, 1> : ' (' : locks<lk, 2> : ')' : (if stampout = '' then '' else ' since ' : stampout) : '.'
         lines<-1> = 'A waiting row is not a lock: there is nothing to release.  The row below it or above it with the same record is the lock being waited for.'
      case typ = 'FX' or typ = 'SX'
         lines<-1> = 'User ' : uid : ' holds ' : (if typ = 'FX' then 'an exclusive' else 'a shared') : ' lock on the whole of file ' : locks<lk, 1> : ' (' : locks<lk, 2> : ')' : (if stampout = '' then '' else ', taken ' : stampout) : '.'
      case 1
         lines<-1> = 'User ' : uid : ' holds a ' : (if typ = 'RU' then 'read and update' else 'read') : ' lock on record ' : locks<lk, 5> : ' in file ' : locks<lk, 1> : ' (' : locks<lk, 2> : ')' : (if stampout = '' then '' else ', taken ' : stampout) : '.'
   end case
   if typ # 'WAIT' then
      if holder = 'no session' then
         lines<-1> = 'No session has the user number ' : uid : ' now, yet the lock is still in the table.  U releases it now.'
      end else
         lines<-1> = 'The holder is signed on.  Releasing its lock does not tell it: its next write to the record goes ahead without the lock.  If its process is dead, L on its row in the sessions list clears the entry and releases every lock it held; otherwise ask the person to finish, or log the session out with L, before you use U.'
      end
      gosub unlock.sentence
      if usent # '' then
         lines<-1> = 'The command is: ' : usent : '.'
      end else
         lines<-1> = uwhy
      end
   end
   return

* A long line is wrapped, not cut
wrap.lines:
   wrapped = ''
   for wi = 1 to dcount(lines, @fm)
      if lines<wi> = '' then
         wrapped<-1> = ''
      end else
         call $tk_wrap(lines<wi>, rtw, pieces)
         wrapped<-1> = pieces
      end
   next wi
   lines = wrapped
   return

* ------------------------------------------------------------------------------------------------- keys and mouse

on.key:
   msg = ''
   if len(nm) = 1 and nm >= 'A' and nm <= 'Z' then nm = downcase(nm)
   begin case
      case nm = 'up'
         if pane = 1 then
            if cs > 1 then cs -= 1
         end else
            if cl > 1 then cl -= 1
         end
         gosub redraw
      case nm = 'down'
         if pane = 1 then
            if cs < ns then cs += 1
         end else
            if cl < nl then cl += 1
         end
         gosub redraw
      case nm = '/'                         ;* S.186: the next session (or lock, in the locks) that holds the text typed ($tk_findrow)
         fr.rows = (if pane = 1 then udata else locks)
         fr.rows = convert(@vm : @sm, '  ', fr.rows)
         call $tk_findrow(fr.rows, (if pane = 1 then cs else cl), find.last, fpos)
         if fpos > 0 then
            if pane = 1 then cs = fpos else cl = fpos
         end
         if fpos < 0 then msg = sysmsg(15045, find.last)
         gosub redraw
      case nm = 'pgup'
         if pane = 1 then
            cs -= VS
            if cs < 1 then cs = 1
         end else
            cl -= VL
            if cl < 1 then cl = 1
         end
         gosub redraw
      case nm = 'pgdn'
         if pane = 1 then
            cs += VS
            if cs > ns then cs = ns
         end else
            cl += VL
            if cl > nl then cl = nl
         end
         gosub redraw
      case nm = 'home'
         if pane = 1 then cs = 1 else cl = 1
         gosub redraw
      case nm = 'end'
         if pane = 1 then
            if ns > 0 then cs = ns
         end else
            if nl > 0 then cl = nl
         end
         gosub redraw
      case nm = 'l' and pane = 1
         gosub do.logout
      case nm = 'u' and pane = 2
         gosub do.unlock
      case nm = 'i'
         gosub do.inhibit
      case nm = 'f1' or nm = '?'
         call $tk_help('box', 'tool.sessions.page', hm, 0, 0)
         if hm # '' then msg = hm
      case nm = 'ctrl-t'                    ;* S.179: the theme, kept for the person - the same on every page ($tk_std)
         call $tk_std('theme', ctx, keys, '', std.r)
         if std.r<1> then gosub draw.all
         msg = std.r<2>
      case nm = 'act:std.mouse'             ;* S.186: View > Mouse, the same on every page ($tk_std)
         call $tk_std('mouse', ctx, keys, '', std.r)
         msg = std.r<2>
      case nm = 'ctrl-k'                    ;* S.179: the keys of this page, in a box
         call $tk_std('keylist', ctx, keys, panes<pane>, std.r)
      case nm = 'f5'
         gosub read.all
         gosub draw.all
         msg = 'asked the system again'
      case nm = 'f6' or nm = 'shift-f6' or nm = 'act:ai'
         call $tk_aipage('ring', ctx, keys, pane, nm : @fm : 2, ap)         ;* S.176: F6 / Shift-F6 go round the two lists and the AI line (Tab no longer switches); AI > Ask the AI goes to the line
         if ap<1> > 0 and ap<1> # pane then
            pane = ap<1>
            gosub redraw
         end
         msg = ap<2>
      case nm = 'ctrl-q'
         done = 1
      case nm = 'ctrl-o'
         gosub toggle.out
      case nm = 'esc'
         if outopen then gosub toggle.out                       ;* the Esc rule: what the page has open is closed first; with nothing open the bar took the key
      case (nm = 'ctrl-pgup' or nm = 'ctrl-pgdn') and outopen
         okey = nm[6, 4]
         call $tk_out('key', ctx, okey, '', oc)                 ;* the output pane scrolls (pgup / pgdn)
         call $tk_out('draw', ctx, 'output', '', oc)
   end case
   return

redraw:
   gosub draw.lists
   gosub draw.row
   return

on.mouse:
   screen mouse returning mev else mev = ''
   if mev = '' then return
   mr = ''
   call $tk_menubar('click', ctx, keys, panes<pane>, mev, '', mr)                 ;* a click on the bar on row 0
   if mr<1> # '' then
      nm = mr<4>
      if nm # '' then gosub on.key                          ;* a bar left with nothing chosen has no name: the status message stays
      return
   end
   call $tk_aipage('mouse', ctx, keys, panes<pane>, mev, ap)                        ;* S.97 stage 2: a click on the AI line gives it the focus
   if ap # '' then
      msg = ap
      return
   end
   call $tk_help('hit', mev, ssn.x + ssn.w - 5, ssn.y + 1, hit.m)
   if hit.m then
      call $tk_help('box', 'tool.sessions.page', hm, 0, 0)
      if hm # '' then msg = hm
      return
   end
   if outopen then
      call $tk_out('mouse', ctx, mev, '', oc)                  ;* the wheel over the output pane scrolls it
      if oc = 'handled' then
         call $tk_out('draw', ctx, 'output', '', oc)
         return
      end
   end
   if mev<1> = 'press' and mev<2> = 1 then
      mx = mev<3>
      my = mev<4>
      if mx >= ssn.x + 2 and mx <= ssn.x + ssn.w - 3 then
         begin case
            case my >= ssn.y + 2 and my <= ssn.y + 1 + VS
               pane = 1
               if ta1 + my - ssn.y - 1 <= ns then cs = ta1 + my - ssn.y - 1
               gosub redraw
            case my >= lck.y + 2 and my <= lck.y + 1 + VL
               pane = 2
               if ta2 + my - lck.y - 1 <= nl then cl = ta2 + my - lck.y - 1
               gosub redraw
         end case
      end
   end
   return

* ------------------------------------------------------------------------------------------------- the three things the page can run

* One audit line for a command the page ran: LOGOUT and UNLOCK write none of their own, and the words of the command are only letters, digits, dots, dashes and underscores ($tk_run saw to that)
audit.run:
   void kernel(K$AUDIT, 'tool run app=tool.sessions command=' : sent : ' status=' : stat)
   return

* The first non-empty line the command printed, for the status line (the one that matters: LOGOUT of a session that was not running prints a long message that starts with it)
first.line:
   said = ''
   for oi = 1 to dcount(out, @fm)
      if trim(out<oi>) # '' then
         said = trim(out<oi>)
         exit
      end
   next oi
   return

* LOGOUT n: the number is typed again to confirm
do.logout:
   if ns = 0 or cs < 1 or cs > ns then
      msg = 'there is no session'
      return
   end
   v = udata<cs>
   uid = v<1, 1>
   if uid = @userno then
      msg = 'that is the session you are in; Ctrl-Q leaves the page'
      return
   end
   sent = 'logout ' : uid
   el = ''
   el<-1> = 'User ' : uid : ' (login user ' : v<1, 6> : (if v<1, 9> = '' then '' else ', account ' : v<1, 9>) : ') is asked to end.  SD signals the process.'
   el<-1> = 'Work that session has not saved is lost, and the record locks it holds are released.'
   el<-1> = 'If its process is already gone, the entry is cleared instead and the locks it held are released.'
   el<-1> = 'Type the number ' : uid : ' to be sure it is this session you mean.'
   typed = uid
   call $tk_confirm(sent, el, typed, res, cmsg)
   if res = 'run' then
      call $tk_run(allow, sent, out, stat, err)
      if err # '' then
         msg = err
         call $tk_out('add', ctx, 'refuse', sent : '  ' : err, '')           ;* what the command answered stays in the output pane, whether or not it is open
      end else
         gosub audit.run
         gosub first.line
         otext = said
         if otext = '' then otext = 'ran'
         call $tk_out('add', ctx, 'ok', sent : '  ' : otext, '')
         msg = (if said # '' then said[1, 130] else 'asked user ' : uid : ' to end; the list is read again every three seconds')
      end
      gosub read.all
      gosub draw.all
   end else
      msg = cmsg
   end
   return

* The UNLOCK command for the lock at lk, or null and the reason in uwhy
unlock.sentence:
   usent = '' ; uwhy = ''
   ufile = locks<lk, 1>
   uuser = locks<lk, 3>
   utyp = locks<lk, 4>
   uid2 = downcase(locks<lk, 5>)                                ;* the lock table keeps record ids in upper case; the verb folds case and $tk_run lets only lower case through
   begin case
      case utyp = 'WAIT'
         uwhy = 'A waiting row is not a lock.'
      case not(ufile matches '1-4N') or not(uuser matches '1-5N')
         uwhy = 'This lock has no file number or user number the unlock verb takes.'
      case utyp = 'FX' or utyp = 'SX'
         usent = 'unlock file ' : ufile : ' user ' : uuser : ' filelock'
      case 1
         word = uid2
         gosub plain.word
         if plain then
            usent = 'unlock file ' : ufile : ' user ' : uuser : ' ' : uid2
         end else
            uwhy = 'This record id has characters (or is a word) that this page will not put in a command; release it at the prompt with unlock.'
         end
   end case
   return

* Is word a safe single word for $tk_run and not a keyword of UNLOCK?  plain is 1 or 0
plain.word:
   plain = (word # '')
   for pi = 1 to len(word)
      if index('abcdefghijklmnopqrstuvwxyz0123456789.-_', word[pi, 1], 1) = 0 then plain = 0
   next pi
   if word = 'all' or word = 'file' or word = 'user' or word = 'filelock' or word = 'tasklock' then plain = 0
   return

do.unlock:
   if nl = 0 or cl < 1 or cl > nl then
      msg = 'there is no lock'
      return
   end
   lk = cl
   uid = locks<lk, 3>
   gosub holder.of
   gosub unlock.sentence
   if usent = '' then
      msg = uwhy
      return
   end
   sent = usent
   el = ''
   el<-1> = 'The lock of user ' : uid : ' on ' : (if locks<lk, 4> = 'FX' or locks<lk, 4> = 'SX' then 'file ' : locks<lk, 1> else 'record ' : locks<lk, 5> : ' in file ' : locks<lk, 1>) : ' is taken out of the lock table now.'
   if holder = 'no session' then
      el<-1> = 'No session has that user number: the lock was left behind by a session that has gone.'
   end else
      el<-1> = 'The holder is signed on and is not told.  Its next write to the record goes ahead without the lock.'
   end
   call $tk_confirm(sent, el, notyped, res, cmsg)
   if res = 'run' then
      call $tk_run(allow, sent, out, stat, err)
      if err # '' then
         msg = err
         call $tk_out('add', ctx, 'refuse', sent : '  ' : err, '')           ;* what the command answered stays in the output pane, whether or not it is open
      end else
         gosub audit.run
         gosub first.line
         otext = said
         if otext = '' then otext = 'ran'
         call $tk_out('add', ctx, 'ok', sent : '  ' : otext, '')
         msg = (if said # '' then said[1, 130] else 'released')
      end
      gosub read.all
      gosub draw.all
   end else
      msg = cmsg
   end
   return

* INHIBIT.LOGIN ON when logins are allowed, OFF when they are inhibited
do.inhibit:
   if inh = '' then
      sent = 'inhibit.login on'
      el = ''
      el<-1> = 'No new session can sign in, here or through the API, until this is switched off or this session ends.'
      el<-1> = 'Sessions already running are not touched, and neither are the phantoms this session starts.  You can always sign in as SDSYS to switch it off.'
   end else
      sent = 'inhibit.login off'
      el = ''
      el<-1> = 'New sessions may sign in again.  Logins were inhibited by ' : inh<3> : ' (user ' : inh<1> : ').'
   end
   call $tk_confirm(sent, el, notyped, res, cmsg)
   if res = 'run' then
      call $tk_run(allow, sent, out, stat, err)
      if err # '' then
         msg = err
         call $tk_out('add', ctx, 'refuse', sent : '  ' : err, '')           ;* what the command answered stays in the output pane, whether or not it is open
      end else
         gosub audit.run
         gosub first.line
         otext = said
         if otext = '' then otext = 'ran'
         call $tk_out('add', ctx, 'ok', sent : '  ' : otext, '')
         msg = (if said # '' then said[1, 130] else 'done')
      end
      gosub read.all
      gosub draw.all
   end else
      msg = cmsg
   end
   return

end

