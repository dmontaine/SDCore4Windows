*
* START-DESCRIPTION:
*
*   SCREEN RADIO f, id, items {AT x,y} {VALUE n} {ACROSS} {COLOR fg,bg} {ACCEL key}
*
*   is compiled into
*
*   call !screen_radio(f, id, items, x, y, value, across, fg, bg, accel, ret, status)
*
*     f id     the form and the widget's name in it (as SCREEN LABEL)
*     items    the choices, as values (a field mark does as well)
*     x y      the place of the first from the form's top left corner, default 1,1
*     value    the number of the choice selected to start with (default 1)
*     across   the choices side by side on one row (default: one to a row)
*
*   Up and down (left and right when across) move among the choices and select as they go, the space bar
*   selects the one the cursor is on; SCREEN GET f, id answers the number of the selected one.
*
*   COLOR fg,bg gives the choices their own colours (see SCREEN ENTRY); the choice the cursor is on is still in the focus style while the group has the focus.
*
*   ACCEL key gives the group a key that reaches it wherever the focus is (see SCREEN ENTRY): f1 to f12, ctrl-a to ctrl-z, alt-a to alt-z or alt-0 to alt-9.  The group
*   takes the focus.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_radio(f, id, items, ax, ay, value, across, fg, bg, accel, ret, status)
$catalog !screen_radio

   ret = ''
   status = 1
   w = collection()
   w{'id'} = id
   w{'items'} = convert(@fm, @vm, items)
   x = 1
   y = 1
   if ax # '' then x = ax + 0
   if ay # '' then y = ay + 0
   w{'x'} = x
   w{'y'} = y
   w{'value'} = value
   if across # '' then w{'across'} = 1
   call $sl_radio('init', w, '', '', r)
   call $sl_color(w, fg, bg, cst)
   if cst # 0 then return
   call $sl_accel(w, accel, ast)
   if ast # 0 then return
   call $sl_wadd(f, w, ok)
   if ok then status = 0

   return
end

* END-CODE
