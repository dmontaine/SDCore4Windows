* START-HISTORY:
* 18 Oct 26 Windows port - from Linux 1e23a00 (12 Oct 26): New.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   SCREEN RADIO f, id, items {AT x,y} {VALUE n} {ACROSS}
*
*   is compiled into
*
*   call !screen_radio(f, id, items, x, y, value, across, ret, status)
*
*     f id     the form and the widget's name in it (as SCREEN LABEL)
*     items    the choices, as values (a field mark does as well)
*     x y      the place of the first from the form's top left corner, default 1,1
*     value    the number of the choice selected to start with (default 1)
*     across   the choices side by side on one row (default: one to a row)
*
*   Up and down (left and right when across) move among the choices and select as they go, the space bar
*   selects the one the cursor is on; SCREEN GET f, id answers the number of the selected one.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_radio(f, id, items, ax, ay, value, across, ret, status)
$catalog !screen_radio

   ret = ''
   status = 1
   w = collection()
   w{'id'} = id
   w{'items'} = convert(@fm, @vm, items)
   x = 1
   y = 1
   if ax # '' then x = ax + 0
   if ay # '' then y = ay + 0
   w{'x'} = x
   w{'y'} = y
   w{'value'} = value
   if across # '' then w{'across'} = 1
   call $sl_radio('init', w, '', '', r)
   call $sl_wadd(f, w, ok)
   if ok then status = 0

   return
end

* END-CODE
