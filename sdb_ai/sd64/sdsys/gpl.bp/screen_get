*
* START-DESCRIPTION:
*
*   SCREEN GET f, id RETURNING v {THEN ... ELSE ...}
*
*   is compiled into
*
*   call !screen_get(f, id, ret, status)
*
*     f id     the form and the widget's name in it
*     ret      entry: the text.  check: 1 or 0.  radio: the number of the choice selected.  list: the number
*              of the current item (with MULTI the numbers of those picked, as values).  combo: the text.
*              tabs: the number of the chosen tab.  table: the number of the current row.  memo: the text,
*              one line to a field.  label: its text.  viewport: the first column and row of the sheet shown, from 0,
*              with a value mark between.
*     status   0; 1 if f is not a form or has no widget of that id (ELSE)
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_get(f, id, ret, status)
$catalog !screen_get

   ret = ''
   status = 1
   if jtype(f) # 'collection' then return
   call $sl_form('find', f, '', id, n)
   if n = 0 then return

   w = f{'widgets', n}
   begin case
      case w{'type'} = 'label'
         ret = w{'text'}
      case w{'type'} = 'viewport'
         call $sl_viewport('geom', w, '', '', r)         ;* the first column and row of the sheet shown, from 0
         ret = w{'sx'} : @vm : w{'sy'}
      case 1
         ret = w{'value'}
   end case
   status = 0

   return
end

* END-CODE
