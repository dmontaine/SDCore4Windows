*
* START-DESCRIPTION:
*
* CALL !WRITELIST(ids, list.name)
*
* Writes the field mark delimited dynamic array ids to the saved lists file, $savedlists, as the item list.name, replacing any
* that was there, as the manual says: "equivalent to opening the $SAVEDLISTS file and writing the ids variable to a record
* named list.name" in non-transactional mode, so that the write does not wait for a COMMIT.  If the file cannot be opened the
* program is aborted.
*
* END-DESCRIPTION
*
* START-CODE

subroutine !writelist(ids, list.name)
$catalog !writelist

$include err.h

   open '$savedlists' non.transactional to sl.f else
      * The file is made the first time, as SAVE.LIST makes it ($svlists on the disk, $savedlists the VOC entry for it)
      if status() # ER$NVR then abort sysmsg(2019)    ;* File not found
      create.file '$svlists' dynamic on error
         abort sysmsg(3249, status())                ;* Error xx creating $savedlists
      end
      recordlocku @voc, '$savedlists'
      write 'F' : @fm : '$svlists' to @voc, '$savedlists'
      open '$savedlists' non.transactional to sl.f else abort sysmsg(3248, status())   ;* Error xx opening $savedlists
   end
   write ids to sl.f, list.name
   return
end

* END-CODE
