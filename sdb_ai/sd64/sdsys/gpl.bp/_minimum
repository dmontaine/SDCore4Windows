$internal
$no.symbols
$no.xref
$recursive

subroutine minimum(str)

$include int$keys.h

   s = str                   ;* Copy to avoid REMOVE interactions
   result = ''
   pos = ''                  ;* 15 Oct 26: where the first least element was, for SYSTEM(1088): field, value, subvalue
   fn = 1 ; vn = 1 ; sn = 1  ;* the field, value and subvalue the next element is in
   found = @false

   if s # '' then
      loop
         remove v from s setting delim
         if v # '' then
            if num(v) then
               if not(found) or v < result then
                  found = @true
                  result = v
                  pos = fn : @vm : vn : @vm : sn
               end
            end
         end
      while delim
         begin case
            case delim = 2
               fn += 1
               vn = 1
               sn = 1
            case delim = 3
               vn += 1
               sn = 1
            case delim = 4
               sn += 1
         end case
      repeat
   end

   x = kernel(K$MAXMIN.POS.SET, pos)     ;* (not VOID: the bootstrap compiler, gplbld/bbcmp.py, does not code it)
   return value result
end

* END-CODE
