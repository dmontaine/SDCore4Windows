program config
$internal
$catalog $config

$include syscom.h
$include int$keys.h
$include err.h
$include parser.h


   @system.return.code = -ER$ARGS      ;* Preset for command format errors

   lptr = @false

   call @parser(parser$reset, 0, @sentence, 0)
   call @parser(parser$get.token, token.type, token, keyword)  ;* Verb

   call @parser(parser$get.token, token.type, param, keyword)

* 19 Nov 26 Windows port - RELEASE_1.1 353 (Linux S.273, c9de4dbf): CONFIG is in every account's VOC now (newvoc),
*    because the sign-on banner tells every session to type CONFIG GPL and CONFIG CONTRIB, and it was in SDSYS's VOC
*    alone.  Those two read-only displays are open to everyone; every other form - the listing, LPTR, setting a
*    parameter - needs the administrator, as it did when only SDSYS had the verb.  SD Core Solo's rule.
   if upcase(param) # 'GPL' and upcase(param) # 'CONTRIB' then
      if not(kernel(K$ADMINISTRATOR, -1)) then stop sysmsg(2001) ;* Command requires administrator privileges
   end

   begin case
      case upcase(param) = 'GPL' 		; gosub show.gpl
      case upcase(param) = 'CONTRIB' 	; gosub show.contrib
      case token.type = PARSER$END 		; gosub report.params
      case keyword = KW$LPTR       		; gosub print.params
      case 1 							; gosub set.param
   end case

   @system.return.code = 0

   return

