* START-DESCRIPTION:
*
*   call $tk_aidocs('find', request, res)     the passages for a typed request
*   call $tk_aidocs('tokens', request, res)   the words it would look for (for the tests)
*   call $tk_aidocs('info', '', res)          res<1> the user pages found, <2> the administrator pages found (0 unless the caller is the administrator)
*
*   find: res<1> is the number of passages (0 to 4, usually 0); then res<2, i> the id (`user/name.md#heading` or `admin/name.md#heading`), res<3, i> the heading and res<4, i> the text,
*   its lines separated by a line feed, at most 2,400 bytes a passage and 6,000 in all, a byte that is not plain ASCII shown as ?.  Nothing is chosen for a request with no word of three
*   letters that is not a common word, nor for a request whose best section matches fewer than half of its words.
*
*   WHAT IT READS.  The files of two directories under the system directory, docs/user and docs/admin, put there by the installer from the documentation (owner sdsys; docs/user 755 with
*   644 files, docs/admin 700 with 600 files, so that the operating system itself keeps the administrator pages from an account holder's session).  It asks the kernel for the administrator
*   BEFORE it looks at docs/admin, and reads no other directory and no other name: a file name is lower case letters, digits and . _ - and ends in .md.  It is $internal because the
*   kernel trusts an internal program with an OPENSEQ by pathname, and that is the only reason: nothing is written, nothing is run, and what it returns is shown in the preview before any
*   of it is sent.  A directory that is not there, a file that cannot be read or is over 120,000 bytes, a byte of 248 or more in a file: that file is left out, silently, and the request
*   goes without passages.
*
*   HOW IT CHOOSES.  A file is cut into sections at its headings of one to three # (a # inside a fenced block is not a heading); a section is scored on how often each word of the request is in
*   it, a word in its heading counting as three more, each word weighted by how few sections hold it, and the score is divided for length.  The words need to be at least half of the
*   request's, so one common word never picks a page.  The measure is crude on purpose; the person reads what was chosen.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine tk_aidocs(op, a, res)
$catalog $tk_aidocs

$include keys.h
$include int$keys.h
$include err.h

   TD.MAXFILE = 120000                                    ;* the largest page read
   TD.MAXSEC = 4000                                       ;* sections kept across all files
   TD.MAXFILES = 160                                      ;* pages read in all
   TD.MAXTOK = 8
   TD.PASSAGES = 4
   TD.EACH = 2400                                         ;* bytes of one passage
   TD.TOTAL = 6000                                        ;* bytes of all of them
   lf.c = char(10)
   odd.bytes = ''                                         ;* every byte that is not plain ASCII, the line feed excepted
   for q = 1 to 255
      if q # 10 and (q < 32 or q > 126) then odd.bytes := char(q)
   next q
   res = ''

   begin case
      case op = 'tokens'
         req = a
         gosub tokenize
         res = toks
      case op = 'info'
         adm = kernel(K$ADMINISTRATOR, -1) + 0
         dkind = 'user'
         gosub list.dir
         res<1> = dn
         res<2> = 0
         if adm then
            dkind = 'admin'
            gosub list.dir
            res<2> = dn
         end
      case op = 'find'
         req = a
         gosub find.passages
   end case
   return

* In: dkind ('user' or 'admin').  Out: dfiles, the file names; dn, how many.  The administrator is asked BEFORE docs/admin is looked at.
list.dir:
   dfiles = ''
   dn = 0
   if dkind # 'user' and dkind # 'admin' then return
   if dkind = 'admin' then
      if not(kernel(K$ADMINISTRATOR, -1)) then return
   end
   ent = dir(@sdsys : @ds : 'docs' : @ds : dkind)
   okn = 'abcdefghijklmnopqrstuvwxyz0123456789._-'
   for i = 1 to dcount(ent, @fm)
      nm = ent<i, 1>
      if len(nm) > 3 and len(nm) <= 80 and nm[len(nm) - 2, 3] = '.md' then
         if nm[1, 1] # '.' and convert('x', '', convert(okn, str('x', len(okn)), nm)) = '' and index(nm, '..', 1) = 0 then
            dn += 1
            dfiles<dn> = nm
         end
      end
   next i
   return

* In: req.  Out: toks, the words to look for (up to TD.MAXTOK, each three characters or more, none of the common ones).
tokenize:
   toks = ''
   w = downcase(req)
   okn = 'abcdefghijklmnopqrstuvwxyz0123456789._-'
   bad = ''
   for i = 1 to len(w)
      c = w[i, 1]
      if index(okn, c, 1) = 0 then bad := c
   next i
   if bad # '' then w = convert(bad, space(len(bad)), w)
   stop.words = ' the and for how what can does with from this that you are use using want need please show tell about would should not into when where which there have has was were make get way'
   stop.words := ' any all one any its our out too but who why how may might will just like some more than then them they their your mine also such each other here very been being is it to of in on at as be do if or an a '
   n = dcount(trim(w), ' ')
   for i = 1 to n
      t = field(trim(w), ' ', i)
      loop
         while t[1, 1] = '.' or t[1, 1] = '-' or t[1, 1] = '_'
         t = t[2, 99]
      repeat
      loop
         while t[len(t), 1] = '.' or t[len(t), 1] = '-' or t[len(t), 1] = '_'
         t = t[1, len(t) - 1]
      repeat
      if len(t) >= 3 and index(stop.words, ' ' : t : ' ', 1) = 0 then
         if index(@fm : toks : @fm, @fm : t : @fm, 1) = 0 and dcount(toks, @fm) < TD.MAXTOK then toks<-1> = t
      end
   next i
   return

find.passages:
   gosub tokenize
   ntok = dcount(toks, @fm)
   if ntok = 0 then return

   dim s.file(TD.MAXSEC), s.pos(TD.MAXSEC), s.len(TD.MAXSEC), s.title(TD.MAXSEC), s.hits(TD.MAXSEC)
   dim fraw(TD.MAXFILES)
   fnames = ''
   nfile = 0
   nsec = 0
   for pass = 1 to 2
      dkind = (if pass = 1 then 'user' else 'admin')
      gosub list.dir
      for fi = 1 to dn
         if nfile < TD.MAXFILES then
            nm = dfiles<fi>
            gosub read.page
            if raw # '' then
               nfile += 1
               fraw(nfile) = raw
               fnames<nfile> = dkind : '/' : nm
               gosub split.sections
            end
         end
      next fi
   next pass
   if nsec = 0 then return

   * how few sections hold each word
   df = ''
   for t = 1 to ntok
      d = 0
      for i = 1 to nsec
         if field(s.hits(i), ' ', t) + 0 > 0 then d += 1
      next i
      df<t> = d
   next t

   * the scores
   need = int((ntok + 1) / 2)
   best = 0
   dim s.score(TD.MAXSEC)
   for i = 1 to nsec
      sc = 0
      got = 0
      for t = 1 to ntok
         h = field(s.hits(i), ' ', t) + 0
         if h > 0 then
            got += 1
            wt = int(10 * (1 + ln(nsec / df<t>)))
            sc += wt * ((if h > 4 then 4 else h) + (if s.title(i) # '' and index(downcase(s.title(i)), toks<t>, 1) > 0 then 3 else 0))
         end
      next t
      if got < need then sc = 0
      if sc > 0 then sc = int(sc * 1000 / (int(sqrt(s.len(i))) + 20))
      s.score(i) = sc
      if sc > best then best = sc
   next i
   if best = 0 then return

   * the best few, in score order; a section scoring under a third of the best is not a passage
   total = 0
   np = 0
   for k = 1 to TD.PASSAGES
      bi = 0
      bs = 0
      for i = 1 to nsec
         if s.score(i) > bs then
            bs = s.score(i)
            bi = i
         end
      next i
      if bi = 0 or bs * 3 < best or total >= TD.TOTAL then exit
      s.score(bi) = 0
      txt = fraw(s.file(bi))[s.pos(bi), s.len(bi)]
      lim = TD.EACH
      if TD.TOTAL - total < lim then lim = TD.TOTAL - total
      if len(txt) > lim then
         txt = txt[1, lim]
         p = 0
         for q = lim to 1 step -1
            if txt[q, 1] = lf.c then
               p = q
               exit
            end
         next q
         if p > 1 then txt = txt[1, p - 1]
      end
      txt = trim(txt, lf.c, 'T')
      * the bytes that are not plain ASCII (line feed excepted) become ?, one for one
      txt = convert(odd.bytes, str('?', len(odd.bytes)), txt)
      ttl = convert(odd.bytes, str('?', len(odd.bytes)), s.title(bi))
      slug = downcase(ttl)
      for q = 1 to len(slug)
         if index('abcdefghijklmnopqrstuvwxyz0123456789', slug[q, 1], 1) = 0 then slug[q, 1] = '-'
      next q
      np += 1
      res<2, np> = fnames<s.file(bi)> : '#' : slug
      res<3, np> = ttl
      res<4, np> = txt
      total += len(txt)
   next k
   res<1> = np
   return

* In: dkind, nm.  Out: raw ('' when the page cannot be used).
read.page:
   raw = ''
   path = @sdsys : @ds : 'docs' : @ds : dkind : @ds : nm
   openseq path readonly to f then
      seek f, 0, 2 else
         close f
         return
      end
      fsize = fileinfo(f, FL$SEQPOS) + 0
      if fsize > 0 and fsize <= TD.MAXFILE then
         seek f, 0, 0 else
            close f
            return
         end
         buf = ''
         loop
            readblk blk from f, 32768 else exit
            buf := blk
         repeat
         if len(buf) = fsize and convert(char(0) : char(248) : char(249) : char(250) : char(251) : char(252) : char(253) : char(254) : char(255), '', buf) = buf then raw = buf
      end
      close f
   end else
      if not(unassigned(f)) then close f
   end
   return

* In: raw, nfile, dkind.  Adds the sections of this page to s.*; the hit counts of each word of toks are a string of numbers in s.hits.
split.sections:
   low = downcase(raw)
   segs = change(raw, lf.c : '#', @fm : '#')
   inside = 0
   pos = 1
   cur.title = ''
   cur.pos = 1
   cur.len = 0
   have = 0
   nseg = dcount(segs, @fm)
   for sg = 1 to nseg
      seg = segs<sg>
      slen = len(seg)
      * pos is where this piece begins in raw; the line feed the split took out is between one piece and the next
      sstart = pos
      send = pos + slen - 1
      is.head = 0
      if not(inside) then
         if seg[1, 2] = '# ' or seg[1, 3] = '## ' or seg[1, 4] = '### ' then is.head = 1
      end
      if is.head then
         if have then gosub close.section
         cur.pos = sstart
         cur.title = trim(seg[index(seg, ' ', 1) + 1, 80])
         cur.title = field(cur.title, lf.c, 1)
         have = 1
      end else
         if sg = 1 then
            cur.pos = 1
            cur.title = ''
            have = 1
         end
      end
      if mod(count(seg, '```'), 2) = 1 then inside = 1 - inside
      cur.len = send - cur.pos + 1
      pos = send + 2
   next sg
   if have then gosub close.section
   return

* In: cur.pos, cur.len, cur.title, nfile.  Adds one section.
close.section:
   if cur.len > 30 and nsec < TD.MAXSEC then
      nsec += 1
      s.file(nsec) = nfile
      s.pos(nsec) = cur.pos
      s.len(nsec) = cur.len
      s.title(nsec) = cur.title
      txt = low[cur.pos, cur.len]
      ttl = downcase(cur.title)
      hs = ''
      for t = 1 to ntok
         h = count(txt, toks<t>)
         hs := (if t > 1 then ' ' else '') : h
      next t
      s.hits(nsec) = hs
   end
   return

end

* END-CODE
