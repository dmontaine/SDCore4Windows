* START-HISTORY:
* 14 Sep 26 Windows port - RELEASE_1.1 5 stage 2a: the dictionary's @ID record
*           is updated whether it is @ID or @id.
* 14 Sep 26 Windows port - RELEASE_1.1 5.  Renaming a file: the old name folds,
*           the new name is stored lower case and refused if it exists in any
*           case other than the record being renamed, and the two default-path
*           tests ignore case so the OS files follow the rename.
* 04 Sep 26 Windows port - PRE_RELEASE_FIXES 16.  Both exclusive-access
*           refusals now name the file and the session holding it
*           (10168/10169).  The data file and its DICT are separate files and
*           can be held by different sessions, so each names its own.
* 19 Aug 26 Windows port - the F/Q file-pointer VOC ids are lower case:
*            voc, newvoc, accounts, messages, syscom, qfile, dict.dict, md,
*            sd.accounts, os.users.  PROJECT_STATUS.md 5.12 (b).
* 19 Jan 04  0.6.1 SD launch. Earlier history details suppressed.
* END-HISTORY
*
* START-DESCRIPTION:
*
* To rename a file
*    CNAME old.file.name TO new.file.name
*    CNAME old.file.name, new.file.name
*
* To rename a record
*    CNAME [DICT] file.name old.record.name TO new.record.name
*    CNAME [DICT] file.name old.record.name, new.record.name
*
* @SYSTEM.RETURN.CODE
*     0  Successful
*    -1  Command arguments incorrect or missing
*
* END-DESCRIPTION
*
* START-CODE


$internal
program $cname
$catalog $CNAME

$include err.h
$include keys.h
$include int$keys.h
$include parser.h
$include dictdict.h


   parser = "!PARSER"

   @system.return.code = -ER$ARGS      ;* Preset for command format errors


   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)  ;* Verb

   * Get file name and possible DICT flag

   call @parser(PARSER$MFILE, token.type, old.file.name, keyword)
   if keyword = KW$DICT then
      dict.token = old.file.name  ;* Allow for words other than DICT
      dict.flag = 'DICT'
      call @parser(PARSER$MFILE, token.type, old.file.name, keyword)
      full.name = 'DICT ' : old.file.name
   end else
      dict.flag = ''
      full.name = old.file.name
   end

   if token.type = PARSER$END then stop sysmsg(2102) ;* File name required

   call @parser(parser$get.token, token.type, old.name, keyword)
   if token.type = PARSER$COMMA or keyword = KW$TO then  ;* Renaming file
      gosub rename.file
   end else
      gosub rename.records
   end

   @system.return.code = 0

   return

* ======================================================================

rename.file:
   * Open VOC here rather than using @VOC so that it will be closed on
   * exit avoiding the need for explicit releases on locks in error paths.

   open 'voc' to voc.f else stop sysmsg(2026) ;* Cannot open VOC

   if dict.flag # '' then
      stop sysmsg(6147, dict.token) ;* xx not valid when renaming a file
   end

   if index(old.file.name, ',', 1) then
      stop sysmsg(6148) ;* Renaming of multifiles is not supported at this release
   end

   call @parser(parser$get.token, token.type, new.file.name, keyword)
   if token.type = PARSER$END then stop sysmsg(6149) ;* New file name required

   call @parser(parser$get.token, token.type, token, keyword)
   if token.type # PARSER$END then stop sysmsg(2018, token) ;* Unexpected token (xx)

   if old.file.name = '' or new.file.name = '' then
      stop sysmsg(2027) ;* Null file name not allowed
   end

* 14 Sep 26 Windows port - RELEASE_1.1 5.  THE OLD NAME FOLDS.  This read was
*   exact, so once CREATE.FILE stores new ids lower case "CNAME ZZX TO ZZY"
*   answered 2014 for a file that exists.  As typed, then down, then up.
   readu rec from voc.f, old.file.name else
      release voc.f, old.file.name
      readu rec from voc.f, downcase(old.file.name) then
         old.file.name = downcase(old.file.name)
      end else
         release voc.f, downcase(old.file.name)
         readu rec from voc.f, upcase(old.file.name) then
            old.file.name = upcase(old.file.name)
         end else
            @system.return.code = -status()
            if status() = ER$RNF then
               stop sysmsg(2014, old.file.name) ;* xx is not defined in your VOC
            end else

            end
         end
      end
   end

   type = upcase(rec[1, 1])
   if type # 'F' and type # 'Q' then
      @system.return.code = -ER$VNF
      stop sysmsg(6150, old.file.name) ;* VOC entry for 'xx' is not a file description
   end

* 14 Sep 26 Windows port - RELEASE_1.1 5.  THE NEW NAME IS LOWER CASE, AND IS
*   REFUSED IF IT EXISTS IN ANY CASE.  Owner's ruling, 13 Sep 2026: ids in SD
*   system files are lower case; 14 Sep 2026: an existing id in another case is
*   "the same id".  VOC is a DYNAMIC file, so the exact test alone let a rename
*   land beside a differently cased twin.  The one hit that is NOT a clash is
*   the record being renamed, which is what lets "CNAME MYFILE TO myfile" bring
*   an old upper-case id into line.
   new.typed = new.file.name
   new.file.name = downcase(new.typed)

*  AND A NEW NAME THAT FOLDS TO THE OLD ONE IS REFUSED, OR THE RECORD IS LOST.
*  "CNAME myfile TO MYFILE" gives new.file.name = old.file.name, the write below
*  lands on the old record, and the delete after it removes the only copy.
   if new.file.name = old.file.name then
      stop sysmsg(6151, new.file.name) ;* xx is already defined in your VOC
   end

   clash.ids = new.typed : @fm : new.file.name : @fm : upcase(new.typed)
   for clash.i = 1 to 3
      if clash.ids<clash.i> # old.file.name then
         readvu s from voc.f, clash.ids<clash.i>, 0 then
            stop sysmsg(6151, clash.ids<clash.i>) ;* xx is already defined in your VOC
         end
      end
   next clash.i

   if type = 'Q' then
      display sysmsg(6152) ;* This is a Q-pointer. The operating system files will not be renamed.
   end else
      * 0459 We need to be certain that this file is not open to any process
      * (including ourself). As a close approximation to this test, set
      * exclusive access on both file parts and then close them. There is
      * a small window of opportunity for another user to open the file
      * before the rename it but we must live with this.

      open old.file.name to data.f then
         if not(fileinfo(data.f, FL$EXCLUSIVE)) then
*           PRE_RELEASE_FIXES 16 - name the file and whoever holds it.
            excl.holders = fileinfo(data.f, FL$HOLDERS)
            excl.name    = fileinfo(data.f, FL$VOCNAME)
            if excl.holders = '' then
               stop sysmsg(10169, excl.name)
            end else
               stop sysmsg(10168, excl.name, excl.holders)
            end
         end
         close data.f
      end

      open 'DICT', old.file.name to dict.f then
         if not(fileinfo(dict.f, FL$EXCLUSIVE)) then
*           PRE_RELEASE_FIXES 16 - name the file and whoever holds it.  The
*           DICT half, and it names the DICT rather than the data file: they
*           are separate files and can be held by different sessions.
            excl.holders = fileinfo(dict.f, FL$HOLDERS)
            excl.name    = fileinfo(dict.f, FL$VOCNAME)
            if excl.holders = '' then
               stop sysmsg(10169, excl.name)
            end else
               stop sysmsg(10168, excl.name, excl.holders)
            end
         end
         close dict.f
      end

      * Try to rename at operating system level if paths are default names
      * and the new name is an acceptable operating system name.

* 14 Sep 26 Windows port - RELEASE_1.1 5.  BOTH "IS THIS THE DEFAULT PATH"
*   TESTS COMPARE WITHOUT CASE.  The data test was exact and the dictionary
*   test upcased only the path, so a lower-case file (whose dictionary is
*   "zzx.DIC") never matched the second, and a file typed lower before
*   CREATE.FILE stored ids lower (VOC id myfile, directory MYFILE) never matched
*   the first.  Either way the OS files kept the old name.  NTFS is case
*   insensitive, so upcase on both sides is the test it applies itself.
		default.file.name = old.file.name
		old.file.path = rec<2>

      if upcase(old.file.path) = upcase(default.file.name) and ospath(new.file.name, OS$FILENAME) then
         if osrename(old.file.path, new.file.name) then
            display sysmsg(6153) ;* Renamed data file at operating system level
            rec<2> = new.file.name
         end else
            display sysmsg(6154, status()) ;* Unable to rename data file at operating system level. Error xx
         end
      end

		default.file.name = old.file.name:'.DIC'
		old.file.path = rec<3>
		s = new.file.name:'.DIC'

      if upcase(old.file.path) = upcase(default.file.name) and ospath(s, OS$FILENAME) then
         if osrename(old.file.path, s) then
            display sysmsg(6155) ;* Renamed dictionary at operating system level
            rec<3> = s
         end else
            display sysmsg(6156, status()) ;* Unable to rename dictionary at operating system level. Error xx
         end
      end
   end

   * Write new VOC entry

   write rec to voc.f, new.file.name on error
      @system.return.code = -status()
      stop sysmsg(6157, status(), new.file.name)  ;* Error xx writing VOC record 'xx'
   end

   delete voc.f, old.file.name

   * Modify the @ID dictionary entry display name if it was defaulted to the
   * old file name.

   open 'DICT', new.file.name to dict.f then
*     14 Sep 26 - RELEASE_1.1 5 stage 2a: the record is @ID in a dictionary
*     made before stage 2b and @id after it; either is updated under its own id.
      id.rec.id = '@ID'
      readu dict.rec from dict.f, id.rec.id else
         release dict.f, id.rec.id
         id.rec.id = '@id'
         readu dict.rec from dict.f, id.rec.id else
            release dict.f, id.rec.id
            id.rec.id = ''
         end
      end
      if id.rec.id # '' then
         if dict.rec<DICT.DISPLAY.NAME> = old.file.name then
            dict.rec<DICT.DISPLAY.NAME> = new.file.name
            write dict.rec to dict.f, id.rec.id
         end
      end
      close dict.f
   end

   display sysmsg(6158, old.file.name, new.file.name) ;* 'xx' renamed to 'xx'

   return

* ======================================================================

rename.records:
   open dict.flag, old.file.name to file else
      open dict.flag, downcase(old.file.name) to file then
         old.file.name = downcase(old.file.name)
      end else
         open dict.flag, upcase(old.file.name) to file else
            @system.return.code = -ER$FNF
            stop sysmsg(2019) ;* File not found
         end
         old.file.name = upcase(old.file.name)
      end
      full.name = upcase(full.name)
   end

   if fileinfo(file, FL$READONLY) then
      @system.return.code = -ER$RDONLY
      stop sysmsg(1431) ;* File is read-only
   end

   if token.type = PARSER$END then stop sysmsg(2109) ;* Record name required

   mark.mapping file, off
   loop
      call @parser(parser$get.token, token.type, token, keyword)
      if token.type # PARSER$COMMA and keyword # KW$TO then
         stop sysmsg(6159) ;* Expected comma or TO
      end

      call @parser(parser$get.token, token.type, new.name, keyword)
      if token.type = PARSER$END then stop sysmsg(6160) ;* New record name required

      if old.name = '' or new.name = '' then
         stop sysmsg(2111) ;* Null new record name not allowed
      end

      readu rec from file, old.name else
         release file, old.name
         @system.return.code = -status()
         stop sysmsg(6161, old.name) ;* Cannot read 'xx'
      end

      readvu s from file, new.name, 0 locked
         stop sysmsg(1433, new.name, status()) ;* 'xx' is locked by user xx
      end then
         release file, new.name
         stop sysmsg(6163, new.name) ;* Record 'xx' already exists
      end

      write rec to file, new.name on error
         crt sysmsg(6164, status(), new.name) ;* Error xx writing record 'xx'
         if status() = ER$TRIGGER then
            crt sysmsg(3007, @trigger.return.code) ;* Data validation error: xx
         end
         @system.return.code = -status()
         stop
      end

      delete file, old.name on error
         crt sysmsg(6165, status(), old.name) ;* Error xx deleting record 'xx'
         if status() = ER$TRIGGER then
            crt sysmsg(3007, @trigger.return.code) ;* Data validation error: xx
         end
         @system.return.code = -status()
         stop
      end

      display sysmsg(6158, old.name, new.name) ;* 'xx' renamed to 'xx'

      call @parser(parser$get.token, token.type, old.name, keyword)
   until token.type = PARSER$END
   repeat

   return
end

* END-CODE
