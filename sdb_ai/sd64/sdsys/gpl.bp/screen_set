*
* START-HISTORY:
* 25 Oct 26 Windows port - from Linux 04f1eaa - the screen library as of S.75 TK-0.13 (containers and viewports, slider, selector, colour, accelerators, table styles)
* 12 Oct 26 dm  New.
* 18 Oct 26 dm  f{'quiet'} = 1 stops the redraw of the whole form after a set (for a program that draws the widget itself).
* 22 Oct 26 dm  VALUE on a selector is brought into range (1 to the number of words).
* 29 Oct 26 dm  S.88 3.5: the 10th argument is the compiler's presence mask; a written VALUE / TEXT / ITEMS '' now sets.
* 30 Oct 26 dm  S.88 p3.6: a quiet form is told to 'recheck' its focus after ENABLED, VISIBLE or a tab strip's VALUE (the form that is not quiet does it in 'redraw').
* END-HISTORY
*
* START-DESCRIPTION:
*
*   SCREEN SET f, id {VALUE v} {TEXT t} {ITEMS i} {ENABLED e} {WRAP b} {READONLY b} {VISIBLE b}
*
*   is compiled into
*
*   call !screen_set(f, id, value, text, items, enabled, wrap, readonly, visible, given, ret, status)
*
*     f id     the form and the widget's name in it
*     value    entry: the text (the cursor goes to its end).  check: 1 or 0.  radio: the choice.  list: the
*              current item.  tabs: the tab (the form shows its page).  memo: the text, one line to a field
*              (the cursor goes back to its start)
*     text     label, button, check: the caption
*     items    radio, list: the choices, as values (a field mark does as well); table: the rows, one row to a
*              field and one cell to a value; the selection goes back to the first
*     enabled  0 takes the widget out of the focus ring and stops it taking keys; 1 puts it back
*     wrap     memo: 1 wraps long lines at a blank, 0 pans sideways
*     readonly memo: 1 makes it a viewer, 0 an editor again
*     visible  0 hides the widget (it is not drawn and takes no focus), 1 shows it again
*     status   0; 1 if f is not a form or has no widget of that id (ELSE)
*
*     given    the compiler's presence mask: VALUE 1, TEXT 2, ITEMS 4, ENABLED 8, WRAP 16, READONLY 32, VISIBLE 64
*
*   A clause left out changes nothing.  A VALUE, TEXT or ITEMS clause that is WRITTEN sets the property even
*   to '' (VALUE '' empties an entry or memo, and counts as 0 on a check, slider, radio or list; TEXT '' empties
*   a label; ITEMS '' empties a list, radio or table).  A written '' on ENABLED, WRAP, READONLY or VISIBLE
*   changes nothing, as before (READONLY '' must not make a viewer writable).  Programs compiled before 29 Oct 26
*   pass 11 arguments and must be recompiled.  The change is made in the form; if the form is on the screen (SCREEN
*   WAIT put it there) the form is redrawn at once, else it shows the next time the form is run or waited for.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_set(f, id, value, text, items, enabled, wrap, readonly, visible, given, ret, status)
$catalog !screen_set

   ret = ''
   status = 1
   if jtype(f) # 'collection' then return
   call $sl_form('find', f, '', id, n)
   if n = 0 then return

   w = f{'widgets', n}
   wt = w{'type'}
   if bitand(given, 1) then
      begin case
         case wt = 'entry'
            w{'value'} = value
            w{'pos'} = len(value) + 1
            w{'pan'} = 1
         case wt = 'check' or wt = 'slider'
            v = 0
            if value + 0 # 0 then v = 1
            w{'value'} = v
         case wt = 'selector'
            sv = value + 0
            if sv > dcount(w{'items'}, @vm) then sv = dcount(w{'items'}, @vm)
            if sv < 1 then sv = 1
            w{'value'} = sv
         case wt = 'radio'
            w{'value'} = value + 0
            w{'cur'} = value + 0
         case wt = 'list'
            w{'cur'} = value + 0
            w{'value'} = value + 0
         case wt = 'memo'
            w{'value'} = value                  ;* the new text: the cursor goes back to its start
            call $sl_widget_init(w)
         case wt = 'tabs'
            nt = dcount(w{'items'}, @vm)
            tv = value + 0
            if tv < 1 then tv = 1
            if tv > nt then tv = nt
            w{'value'} = tv
         case 1
            w{'value'} = value
      end case
   end
   if bitand(given, 2) then
      w{'text'} = text
      if wt = 'label' then w{'apos'} = 0       ;* a label's marked letter was a place in its old text: not drawn in the new (the Alt-letter stays)
      call $sl_widget_init(w)
   end
   if bitand(given, 4) then
      if wt = 'table' and w{'keycol'} + 0 > 0 then
         * 22 Oct 26, S.75 G3: a table with a key column keeps its current row, its marks, its sort and its filter across new rows, by the key
         w{'newrows'} = items
         w{'nopaint'} = 1                       ;* the form is drawn below, when it is on the screen
         call $sl_table('refresh', w, '', '', r0)
         w{'nopaint'} = 0
      end else
         if wt = 'table' then
            w{'rows'} = items                   ;* a table's rows are fields, their cells values: nothing is converted
         end else
            w{'items'} = convert(@fm, @vm, items)
         end
         w{'picked'} = ''
         w{'top'} = 1
         w{'cur'} = 1
         w{'value'} = 1
         call $sl_widget_init(w)
      end
   end
   if bitand(given, 8) and enabled # '' then      ;* a written '' on the four flags changes nothing (owner, 29 Oct 26)
      if enabled + 0 = 0 then
         w{'disabled'} = 1
      end else
         w{'disabled'} = 0
      end
   end
   if bitand(given, 16) and wrap # '' and wt = 'memo' then
      w{'wrap'} = if wrap + 0 # 0 then 1 else 0
      w{'left'} = 1
   end
   if bitand(given, 32) and readonly # '' and wt = 'memo' then w{'readonly'} = if readonly + 0 # 0 then 1 else 0
   if bitand(given, 64) and visible # '' then
      * a hidden widget is not drawn and takes no focus; the form is redrawn without it (or with it again)
      w{'hidden'} = if visible + 0 = 0 then 1 else 0
   end
   * 18 Oct 26: a program that sets f{'quiet'} to 1 draws what it changed itself (SCREEN SET drew the whole form each time, which the IDE saw as
   *   a flash; two SETs for one record change were two whole screens)
   if f{'shown'} and not(system(25)) and not(f{'quiet'} + 0) then       ;* the form is on the screen (SCREEN WAIT): show the change
      call $sl_scr('get', scr)
      call $sl_form('redraw', f, scr, '', r)
      call $sl_scr('put', scr)
   end
   * 30 Oct 26 (S.88 p3.6): a quiet form is not drawn here, but a change that can take the focus from its widget (ENABLED, VISIBLE, the tab strip's VALUE) must still
   *   move it to one that can have it; the form draws the two widgets it moves between and nothing else ('recheck').  The redraw above does the same for a form that is not quiet.
   if f{'shown'} and not(system(25)) and f{'quiet'} + 0 and (bitand(given, 72) or (wt = 'tabs' and bitand(given, 1))) then
      call $sl_scr('get', scr)
      call $sl_form('recheck', f, scr, '', r)
      call $sl_scr('put', scr)
   end
   status = 0

   return
end

* END-CODE
