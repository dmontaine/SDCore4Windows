*
* START-DESCRIPTION:
*
*   SCREEN SET f, id {VALUE v} {TEXT t} {ITEMS i} {ENABLED e}
*
*   is compiled into
*
*   call !screen_set(f, id, value, text, items, enabled, ret, status)
*
*     f id     the form and the widget's name in it
*     value    entry: the text (the cursor goes to its end).  check: 1 or 0.  radio: the choice.  list: the
*              current item.
*     text     label, button, check: the caption
*     items    radio, list: the choices, as values (a field mark does as well); the selection goes back to
*              the first
*     enabled  0 takes the widget out of the focus ring and stops it taking keys; 1 puts it back
*     status   0; 1 if f is not a form or has no widget of that id (ELSE)
*
*   A clause left out changes nothing.  The change is made in the form; if the form is on the screen (SCREEN
*   WAIT put it there) the form is redrawn at once, else it shows the next time the form is run or waited for.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_set(f, id, value, text, items, enabled, ret, status)
$catalog !screen_set

   ret = ''
   status = 1
   if jtype(f) # 'collection' then return
   call $sl_form('find', f, '', id, n)
   if n = 0 then return

   w = f{'widgets', n}
   wt = w{'type'}
   if value # '' then
      begin case
         case wt = 'entry'
            w{'value'} = value
            w{'pos'} = len(value) + 1
            w{'pan'} = 1
         case wt = 'check'
            v = 0
            if value + 0 # 0 then v = 1
            w{'value'} = v
         case wt = 'radio'
            w{'value'} = value + 0
            w{'cur'} = value + 0
         case wt = 'list'
            w{'cur'} = value + 0
            w{'value'} = value + 0
         case 1
            w{'value'} = value
      end case
   end
   if text # '' then
      w{'text'} = text
      call $sl_widget_init(w)
   end
   if items # '' then
      w{'items'} = convert(@fm, @vm, items)
      w{'picked'} = ''
      w{'top'} = 1
      w{'cur'} = 1
      w{'value'} = 1
      call $sl_widget_init(w)
   end
   if enabled # '' then
      if enabled + 0 = 0 then
         w{'disabled'} = 1
      end else
         w{'disabled'} = 0
      end
   end
   if f{'shown'} and not(system(25)) then       ;* the form is on the screen (SCREEN WAIT): show the change
      call $sl_scr('get', scr)
      call $sl_form('redraw', f, scr, '', r)
      call $sl_scr('put', scr)
   end
   status = 0

   return
end

* END-CODE
