* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $sl_key(timeout, name)
*
*     timeout  seconds to wait, or null to wait for ever
*     name     returned: null if the timeout ran out or the input has ended, else
*                up down left right home end pgup pgdn ins del bs tab btab enter esc
*                f1 ... f12, ctrl-a ... ctrl-z (those with no name of their own),
*                alt-a ... alt-z, alt-0 ... alt-9 (and the other printable characters: a terminal sends Alt+x as Esc and x; the letter
*                is lower case whichever case was typed),
*                or the character itself for a printable character
*                guardquit  (only for a program that asked for the cursor lock, $sl_guardmode) the user has chosen to leave from the
*                           lock; it is returned by every later call, and the program leaves without saving
*
*   The decoding is KEYCODE()'s, i.e. the terminal's terminfo entry; a lone Esc is told from
*   the start of a key sequence by KEYCODE()'s own short wait.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_key(timeout, name)
$catalog $sl_key

$include keyin.h
$include err.h

   common /slsz/ sz.last, sz.has, sz.held
   common /slguard/ g.on, g.name, g.minw, g.minh, g.quit
   common /slcur/ cu.has, cu.x, cu.y, cu.hid

   name = ''
   if system(25) then return              ;* a phantom has no keyboard: asking for a key would abort it

   * The cursor lock of a program that asked for it ($sl_guardmode): where the cursor is, it is the window that decides whether
   * the user can see what they type.  Once the user has chosen to leave, every call says so.
   if g.on then
      if not(g.quit) then gosub guard.cursor
      if g.quit then
         name = 'guardquit'
         return
      end
   end

   * The terminal's size is checked on the way in and between one-second slices of the wait: a resize (SIGWINCH makes the
   * kernel change @crtwide and @crthigh; so does TERM w,h) is the key 'resize'.  A block starts as 0, so the first call only
   * notes the size.
   size.now = @crtwide : ',' : @crthigh
   if unassigned(sz.last) then sz.last = size.now
   if sz.last = 0 then sz.last = size.now
   if sz.last # size.now then
      gosub resized
      return
   end

   * KEYCODE TAKES WHOLE SECONDS ONLY (op_keycodet converts its argument with GetInt, so 0.5 is 0 and 0 is "for ever": measured
   * 13 Oct 26), so the slice is one second.  A timeout of 0 or null is for ever, as it always was; one under a second waits
   * the second out.
   * A key that arrived just as the size changed was kept back so that 'resize' could come first: it is the key now
   k = ''
   if sz.has then
      sz.has = 0
      k = sz.held
   end

   remain = timeout                       ;* seconds still to wait, null for ever
   if remain = 0 then remain = ''
   loop
   until k # '' do
      alt.was = bindkey('', -7)           ;* an Alt-letter comes back as Esc and the letter, for this read only
      k = keycode(1)
      kst = status()                      ;* BINDKEY clears STATUS(), and the loop below tells a timeout from an input that ended by it
      if alt.was then x = bindkey('', -7) else x = bindkey('', -8)
      set.status kst
      if k # '' then
         size.now = @crtwide : ',' : @crthigh
         if sz.last # size.now then          ;* the window was resized as this key came: 'resize' first, the key next time
            sz.held = k
            sz.has = 1
            gosub resized
            return
         end
      end
      if k = '' then
         if status() # ER$TIMEOUT then return   ;* the input has ended
         size.now = @crtwide : ',' : @crthigh
         if sz.last # size.now then
            gosub resized
            return
         end
         if remain # '' then
            remain -= 1
            if remain <= 0 then return          ;* the time asked for has passed
         end
      end
   repeat
   name = ''
   n = seq(k[1, 1])

   begin case
      case len(k) = 2 and k[1,1] = char(27)
         name = 'alt-' : downcase(k[2,1])      ;* an Alt-letter (or Alt-digit or Alt-sign): Alt+S and Alt+s are both alt-s
      case len(k) > 1
         name = k                     ;* A string a binding gave: handed back as it is
      case n = K$MOUSE
         gosub read.mouse
      case n = K$UP ; name = 'up'
      case n = K$DOWN ; name = 'down'
      case n = K$LEFT ; name = 'left'
      case n = K$RIGHT ; name = 'right'
      case n = K$HOME ; name = 'home'
      case n = K$END ; name = 'end'
      case n = K$PAGE.UP ; name = 'pgup'
      case n = K$PAGE.DOWN ; name = 'pgdn'
      case n = K$INSERT ; name = 'ins'
      case n = K$DELETE ; name = 'del'
      case n = K$BACKSPACE or n = 127 ; name = 'bs'
      case n = K$TAB ; name = 'tab'
      case n = K$CTRL.TAB ; name = 'btab'
      case n = K$RETURN or n = 10 ; name = 'enter'
      case n = K$ESC ; name = 'esc'
      case n >= K$F1 and n <= K$F12 ; name = 'f' : (n - K$F1 + 1)
      case n >= 1 and n <= 26 ; name = 'ctrl-' : downcase(char(n + 64))
      case n < 32 or n = 127 ; name = 'ctrl-?'
      case 1 ; name = k
   end case

   return

* The program asked for the lock, and its cursor ($sl_curat) is off the screen: $sl_guard takes the keyboard.  It returns when the
* window is big enough (the screen is then the guard's, not the program's: the size that was kept is forgotten, so that this call
* goes on to report 'resize' and the program draws everything again) or when the user chose to leave.
guard.cursor:
   if not(cu.has) or cu.hid then return
   call $sl_window(gw, gh)
   if cu.x < gw and cu.y < gh then return
   call $sl_guard(g.name, g.minw, g.minh, cu.x, cu.y, gres)
   if gres = 'quit' then
      g.quit = 1
   end else
      sz.last = 'x'
      sz.has = 0
   end
   return

* The size of the terminal is not what it was: the key is 'resize'.  This routine does NOT draw anything: the live screen context
* is the caller's (a dialogue draws into its own copy, which becomes the kept one only when the statement ends), so the caller
* calls $sl_resize on it.  SCREEN KEY, which has no dialogue, asks $sl_scr, which does it for the kept context.
resized:
   sz.last = size.now
   name = 'resize'
   return

* KEYCODE gave K$MOUSE: an xterm mouse report started (ESC [ <).  The rest is b;x;y and M (pressed or moved) or m
* (released), which the terminal sent in one piece.  name is 'mouse' and $sl_mouse holds the details; a report that
* is cut short or not what was expected gives no key at all.
read.mouse:
   name = ''
   rep = ''
   fin = ''
   loop
      c = keyin(0.2)
      set.status 0
   until c = '' or c = 'M' or c = 'm' or len(rep) > 20 do
      rep := c
   repeat
   if c = 'M' or c = 'm' then fin = c
   if fin = '' then return
   b = field(rep, ';', 1)
   mx = field(rep, ';', 2)
   my = field(rep, ';', 3)
   if not(num(b)) or not(num(mx)) or not(num(my)) or b = '' or mx = '' or my = '' then return
   b += 0
   mods = ''
   if bitand(b, 4) then mods := 's'
   if bitand(b, 8) then mods := mods : 'a'
   if bitand(b, 16) then mods := mods : 'c'
   base = bitand(b, 3)
   begin case
      case bitand(b, 64)
         kind = 'wheel'
         btn = if base = 0 then 'up' else 'down'
      case fin = 'm'
         kind = 'release'
         btn = base + 1
      case bitand(b, 32)
         kind = 'drag'
         btn = if base = 3 then 4 else base + 1
      case 1
         kind = 'press'
         btn = base + 1
   end case
   call $sl_mouse('set', kind : @fm : btn : @fm : (mx - 1) : @fm : (my - 1) : @fm : mods)
   name = 'mouse'
   return
end

* END-CODE
