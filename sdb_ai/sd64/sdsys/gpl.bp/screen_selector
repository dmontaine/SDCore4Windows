* END-HISTORY
*
* START-DESCRIPTION:
*
*   SCREEN SELECTOR f, id, text, words {AT x,y} {VALUE n} {ATTR style} {PLACE where} {COLOR fg,bg} {ACCEL key}
*
*   is compiled into
*
*   call !screen_selector(f, id, text, words, x, y, value, attr, place, fg, bg, accel, ret, status)
*
*     f id     the form and the widget's name in it (as SCREEN LABEL)
*     text     the label, put where place says (null: no label)
*     words    the choices, as values (a field mark does as well); at least one, otherwise the statement takes its ELSE
*     x y      the place of the control from the form's top left corner, default 1,1
*     value    the number of the word to start with (default 1; brought into range)
*     attr     the style of the word in force, any style of $sl_theme (bold, highlight, header, error, underline ...); default bold; window draws it as the form's
*              own, so that only the capitals show the choice
*     place    where the label is: left (the default), right, above or below (two rows)
*     status   0 added; 1 not (ELSE)
*
*   The control is drawn [blue | green | RED | black] with the word in force in capitals and in the style ATTR names.  Left and Right choose the previous and
*   the next word, Home and End the first and the last, the space bar the next word (the first after the last), a click on a word chooses it.
*   SCREEN GET f, id answers the number of the word in force (3 for RED); SCREEN SET f, id VALUE n chooses it, ITEMS gives it other words (the first is
*   chosen); a choice that changes is a change event of SCREEN WAIT, as for a radio group.
*
*   COLOR fg,bg gives the control and its label their own colours (see SCREEN ENTRY) until the control has the focus; the word in force is still in the style ATTR names.
*
*   ACCEL key gives the control a key that reaches it wherever the focus is (see SCREEN ENTRY): f1 to f12, ctrl-a to ctrl-z, alt-a to alt-z or alt-0 to alt-9.  The key
*   takes the focus to the control and chooses its next word (a change event).  A letter marked with & in the text is also its Alt-letter.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_selector(f, id, text, words, ax, ay, value, attr, place, fg, bg, accel, ret, status)
$catalog !screen_selector

   ret = ''
   status = 1
   if words = '' then return
   w = collection()
   w{'id'} = id
   w{'text'} = text
   w{'items'} = convert(@fm, @vm, words)
   x = 1
   y = 1
   if ax # '' then x = ax + 0
   if ay # '' then y = ay + 0
   w{'x'} = x
   w{'y'} = y
   w{'value'} = value
   w{'attr'} = attr
   w{'place'} = place
   call $sl_selector('init', w, '', '', r)
   call $sl_color(w, fg, bg, cst)
   if cst # 0 then return
   call $sl_accel(w, accel, ast)
   if ast # 0 then return
   call $sl_wadd(f, w, ok)
   if ok then status = 0

   return
end

* END-CODE
