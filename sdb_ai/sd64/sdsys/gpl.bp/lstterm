* START-DESCRIPTION:
*
*   LIST.TERM.TYPES {LPTR {n}}
*
* Lists the terminal types for which SD has a terminfo definition: the names
* of the entries under TERMINFO in the SD system directory, which is what the
* TERM command's type argument is looked up in.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $list.term.types
$catalog $lstterm

$include err.h
$include keys.h
$include parser.h
$include syscom.h

   parser = "!PARSER"

   @system.return.code = -ER$ARGS      ;* Preset for command format errors
   lptr = -1

   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb

   loop
      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   until token.type = PARSER$END
      begin case
         case keyword = KW$LPTR
            lptr = 0
            call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
            if token matches "1N0N" then
               lptr = token + 0
               if lptr > LPTR$HIGH.PRINT.UNIT then stop sysmsg(2053) ;* Invalid print unit number
            end else
               continue
            end

         case keyword = KW$NO.PAGE
            null

         case 1
            stop sysmsg(2018, token) ;* Unexpected token (xx)
      end case
   repeat

   @system.return.code = 0

   base = @sdsys : @ds : 'terminfo'
   top = dir(base)
   if top = '' then
      @system.return.code = -1
      stop sysmsg(12064, base) ;* No terminal definitions found in xx
   end

   names = ''
   for i = 1 to dcount(top, @fm)
      if top<i,2> = 'D' then
         sub.entries = dir(base : @ds : top<i,1>)
         for j = 1 to dcount(sub.entries, @fm)
            if sub.entries<j,2> = 'F' then
               n = sub.entries<j,1>
               locate n in names<1> by 'AL' setting pos else null
               ins n before names<pos>
            end
         next j
      end
   next i

   if lptr = 0 then printer on

   if lptr >= 0 then width = getpu(PU$WIDTH, lptr) else width = @crtwide
   col.width = 26
   per.line = int((width - 1) / col.width)
   if per.line < 1 then per.line = 1

   total = dcount(names, @fm)
   if names = '' then total = 0
   line = ''
   count = 0
   for i = 1 to total
      line := fmt(names<i>, col.width : 'L')
      count += 1
      if count = per.line then
         print on lptr trimb(line)
         line = ''
         count = 0
      end
   next i
   if line # '' then print on lptr trimb(line)

   print on lptr
   print on lptr sysmsg(12065, total) ;* %1 terminal type(s)

   if lptr = 0 then printer off

   @system.return.code = total

   return
end

* END-CODE
