subroutine errtext(expansion, errno)
$catalogue !errtext
* 13 Aug 26 Windows port - ERRGEN is a build tool.  It reads ./gplsrc/err.h and
*   regenerates both GPL.BP/ERRTEXT.H and SYSCOM/ERR.H, so running it here made
*   every compile of this program need C source in the data tree.  Worse, it
*   truncates both outputs before it opens its input, so with gplsrc absent it
*   destroyed them and left every ER$ constant undefined system wide.  Both
*   generated files are tracked; regenerate them with gplbld/gen_includes.py,
*   not from a compile.  Same treatment as REVSTAMP in CPROC 139-140 and in
*   APISRVR.
*$execute 'RUN GPL.BP ERRGEN'

   err = ''
   text = ''
$include errtext.h

   locate errno in err<1> setting pos then
      expansion = text<pos>
      if expansion[10] = '(os.error)' then
         expansion = expansion[1, len(expansion)-1] : ' ' : os.error() : ')'
      end
   end else
      expansion = errno
   end

   return
end

* END-CODE
