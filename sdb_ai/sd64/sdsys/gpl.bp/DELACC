*
* START-DESCRIPTION:
*
* DELETE.ACCOUNT account.name
*
* Removes the account directory, the sdu_ or sdg_ group, the ACCOUNTS record
* and - for a USER account SD created - the Windows account and its profile.
* One confirmation covers all of it.
*
* WHAT IT WILL NOT DO IS DELETE A WINDOWS ACCOUNT SD DID NOT CREATE.
* !is_sd_user reads back the description CREATE_USER stamps, the account is
* left in place and message 10036 says so.  The confirmation uses the shorter
* wording in that case, so it never promises what it will not do.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $delete.account
$catalog $DELACC

$include keys.h
$include int$keys.h
$include parser.h
$include err.h
* REV 0.9.0
deffun is_group(group) calling '!is_group'
deffun os_group(action,group,member) calling '!os_group'
deffun delete_user(username) calling '!delete_user'
deffun valid_os_name(name) calling '!valid_os_name'
* 14 Aug 26 Windows port - did SD create the OS account behind this account?
deffun is_sd_user(username) calling '!is_sd_user'
   prompt ''

   parser = "!PARSER"

* rev 0.9.0 delete-account requires admin priv, are we admin?
   if not(kernel(K$ADMINISTRATOR, -1)) then
     stop sysmsg(2001)  ;* Command requires administrator privileges
   end   

   @system.return.code = -ER$ARGS            ;* Preset for argument errors


   call @parser(parser$reset, 0, @sentence, 0)
   call @parser(parser$get.token, token.type, token, keyword) ;* Verb

   * Get and process account name

   call @parser(parser$get.token, token.type, acc.name, keyword)
   if token.type = PARSER$END then
      display sysmsg(6001) :  ;* Account name:
      input acc.name
      acc.name = trim(acc.name)
      if acc.name = '' then stop
   end

   * Validate account name

   acc.name = upcase(acc.name)

   * Check no further command arguments

   call @parser(parser$get.token, token.type, token, keyword)
   if token.type # PARSER$END then
      stop sysmsg(2018, token) ;* Unexpected token (xx)
   end

   if acc.name = 'SDSYS' then
      stop sysmsg(6025) ;* Cannot delete SDSYS account
   end

   if acc.name = @who then
      stop sysmsg(6026) ;* Cannot delete own account
   end

   * Check account exists in ACCOUNTS file

   openpath @sdsys:@ds:'accounts' to acc.f else
      stop sysmsg(6000) ;* Cannot open ACCOUNTS file in SDSYS account
   end

   readu acc.rec from acc.f, acc.name locked
      stop sysmsg(6006, status()) ;* ACCOUNTS file record locked by user xx
   end else
      @system.return.code = -status()
      stop sysmsg(6027) ;* Account not registered in ACCOUNTS file
   end
* rev 0.9.0   
   group_name = acc.rec<ACC$GROUP>

   pathname = parse.pathname.tokens(acc.rec<ACC$PATH>)

* 21 Aug 26 Windows port - WORK OUT WHAT WILL GO BEFORE ASKING ABOUT IT.
*   These three lines used to live in the deletion block at the bottom, which
*   was fine while the prompt only asked about the directory.  The single
*   confirmation names the Windows account, so it has to know whether there is
*   one to name - and the answer is not "does the account have a Windows user"
*   but "may SD delete it", which is !is_sd_user's question.
*
*   del.user IS THE ANSWER TO THE WHOLE QUESTION, in one variable: the name of
*   the Windows account this verb will remove, or empty for every case where it
*   will not - a GROUP account, an account whose Windows user is gone already,
*   and one SD did not create.  Everything downstream reads it rather than
*   re-deriving it, so the prompt and the deletion cannot disagree.
*
*   os.user IS KEPT SEPARATELY because the "SD did not create this" message
*   (10036) has to name the account it is declining to touch, and del.user is
*   empty in exactly that case.
   del.user = ''
   os.user = ''
   sd.made.it = @false
   lookup.stat = 0

   findstr 'sdu_' in group_name setting yn then
      os.user = change(group_name, 'sdu_', '')
      if valid_os_name(os.user) then
         sd.made.it = is_sd_user(os.user)
         lookup.stat = status()
         if lookup.stat = 0 and sd.made.it then
            del.user = os.user
         end
      end
   end

   * Check  account directory exists

   dir.exists = ospath(pathname, OS$EXISTS)
   if not(dir.exists) then
      display sysmsg(6028) ;* WARNING: Account directory does not exist
   end else
      * Check for cross-references from other accounts
      * ie Files in this account are referenced from other accounts

      xref.found = @false
      select acc.f to 11
      loop
         readnext xacc from 11 else exit
         if xacc # acc.name then
            read xacc.rec from acc.f, xacc then
               xacc.path = parse.pathname.tokens(xacc.rec<ACC$PATH>)
               openpath xacc.path:@ds:'voc' to xvoc.f then
                  select xvoc.f to 12
                  loop
                     readnext xid from 12 else exit
                     read xvoc.rec from xvoc.f, xid then
                        xvoc.rec = upcase(xvoc.rec)
                        type = upcase(xvoc.rec[1,1])
                        begin case
                           case type = 'F'
                              num.components = dcount(xvoc.rec<2>, @vm)
                              for comp = 1 to num.components
                                 fpath = ospath(xvoc.rec<2,comp>, OS$FULLPATH)
                                 if field(fpath, @ds, 1, dcount(fpath, @ds) - 1) = pathname then
                                    gosub report.xref
                                 end
                              next comp

                              fpath = ospath(xvoc.rec<3>, OS$FULLPATH)
                              if field(fpath, @ds, 1, dcount(fpath, @ds) - 1) = pathname then
                                 gosub report.xref
                              end

                           case type = 'Q'
                              if xvoc.rec<2> = acc.name or xvoc.rec<2> = pathname then
                                 gosub report.xref
                              end
                        end case
                     end
                  repeat
               end
            end
         end
      repeat

* 21 Aug 26 Windows port - THE CROSS-REFERENCE QUESTION IS NOW A STATEMENT.
*   It used to be its own Y/N (6029), which made two prompts on the one path
*   where it fired.  Owner's decision, 21 Aug 2026: ONE confirmation before
*   deleting.  The cross-references are still reported - report.xref has
*   already printed them above - and they are now something the caller reads
*   before the single question rather than something they answer twice.
   end                                  ;* account directory exists

* 21 Aug 26 Windows port - ONE CONFIRMATION, AND IT NAMES WHAT WILL ACTUALLY GO.
*   Owner's decision, 21 Aug 2026: DELETE.ACCOUNT deletes the directory and the
*   account, with a confirmation required first.  It replaces "Delete directory
*   xx (Y/N)?", which asked about the DATA only and left the caller to discover
*   what else went by watching the messages afterwards.
*
*   THE WORDING IS DECIDED BEFORE THE QUESTION IS ASKED, which is why
*   is_sd_user runs above rather than in the deletion block below where it used
*   to.  A prompt that promised to remove a Windows account SD had not created,
*   or one a GROUP account never had, would be asking the caller to confirm
*   something that is not going to happen - and this is the prompt that stands
*   between somebody and their data.
   loop
      if del.user # '' then
         display sysmsg(10084, acc.name, del.user) : ;* account, directory and Windows account
      end else
         display sysmsg(10085, acc.name) :           ;* account and its directory
      end
      input yn
      yn = upcase(yn)
* 30 Aug 26 Windows port - ENTER TAKES THE DEFAULT THE PROMPT ADVERTISES.
*   Owner's rule, 30 Aug 2026: "scripts need to indicate which is the default
*   using <y>/n or y/<n>".  N here, and it is the conservative answer - this is
*   the prompt standing between somebody and their data, which the comment
*   above already says.  Before this, an empty answer simply re-asked.
      if yn = '' then yn = 'N'
      until yn = 'Y' or yn = 'N'
   repeat

   if yn = 'N' then
      @system.return.code = -ER$STOPPED
      stop sysmsg(6030) ;* Account deletion abandoned
   end

   if dir.exists then
      yn = ospath(pathname, OS$DELETE)
   end

* 14 Aug 26 Windows port - THE ACCOUNTS RECORD IS NOW DELETED LAST, not here.
*   It used to go first, so anything that failed afterwards - the group, the OS
*   account - left leftovers with no register entry pointing at them, and
*   DELETE.ACCOUNT could not be re-run against them because it starts by
*   reading that record.  Deleting it last means a failure leaves the account
*   still registered and the verb still able to finish the job.  The record is
*   held with READU throughout, so nothing else can touch it in between.

   * rev 0.9.0 remove group. os user?
   if is_group(group_name) then
      * Modified by Composer AI - 2026/06/10.
      * Use shared !valid_os_name before OS.EXECUTE (phase 2).
      * os.name.chars = '...'
      * if convert(os.name.chars, '', group_name) # '' or len(group_name) > 32 then
      if not(valid_os_name(group_name)) then
         crt sysmsg(10026,group_name, 2) ;* Warning unable to delete group: %1 error: %2
      end else
* 14 Aug 26 Windows port - was: OS.EXECUTE "sudo groupdel ": group_name
      stat = os_group("DEL", group_name, "")
      if stat = 0 then
         crt sysmsg(10025,group_name) ;* group: %1 Deleted
      end else
         crt sysmsg(10026,group_name, stat) ;* Warning unable to delete group: %1 error: %2
      end
      end
      * --------------------
   end
   
* 14 Aug 26 Windows port - THE config('CREATUSR') GATE IS GONE, matching
*   CREATEA, which lost it when creating an account became creating the OS
*   account.  Asking a configuration parameter for permission to undo the only
*   thing the verb does made no sense on the creating side and makes none here.
*
*   WHAT REPLACES IT IS THE QUESTION THAT ACTUALLY MATTERS: did SD create this
*   OS account?  CREATEA creates one for every account it makes, but the
*   install adopts the installer's pre-existing account (CREATEA, ADOPT), and
*   an administrator can register an account by hand.  Deleting unconditionally
*   would eventually delete a login SD never made - an administrator's, in the
*   case the access model makes ordinary.  !is_sd_user reads back the
*   description CREATE_USER stamps on the accounts it creates.
*
*   Owner's decision, 14 Aug 2026: offer only the ones SD made.  The three
*   answers are all different and all wanted - see !is_sd_user.
   * is this a user account ?
*
* 21 Aug 26 Windows port - THIS BLOCK NO LONGER ASKS THE QUESTION, IT ACTS ON
*   THE ANSWER.  os.user, sd.made.it, lookup.stat and del.user were all worked
*   out near the top, before the confirmation, because the confirmation has to
*   name the Windows account it is about to remove.  Re-deriving them here
*   would be a second opinion that could differ from the one the caller agreed
*   to - a Windows account created in the seconds between the two calls would
*   be deleted having never been named.
   if os.user # '' then
      if not(valid_os_name(os.user)) then
         crt sysmsg(10029,os.user, 2) ;* Warning unable to delete OS User: %1 error: %2
      end else
         begin case
            case lookup.stat # 0
               * Not there at all.  This is the half-removed account - the SD
               * side outliving the OS side - and it is the state a failed
               * creation reaches too, so it is reported rather than warned
               * about: there is nothing wrong and nothing to do.
               *
               * 30 Aug 26 Windows port - EXCEPT THE os.users RECORD, WHICH IS
               *   THE ONE THING THERE IS TO DO HERE.  PRE_RELEASE_FIXES.md 65.
               *   This is the arm every "remove it with DELETE.ACCOUNT" note in
               *   the harness lands in - verify-tierapi.ps1 and verify-routes.ps1
               *   both Remove-LocalUser and leave the SD side - so the documented
               *   recovery for the leak did not clear the leak.
               *
               *   THE CAUTION IN drop.os.access IS SATISFIED BY MEASUREMENT
               *   HERE, not by assumption: is_sd_user has just reported that no
               *   Windows login of this name exists, so there is nobody to take
               *   a permission away from - and a yes|yes keyed on a name Windows
               *   may one day reissue is the reason to take it away now.
               crt sysmsg(10037,os.user) ;* Windows account %1 does not exist
               gosub drop.os.access

            case sd.made.it
* 21 Aug 26 Windows port - THE Y/N PROMPT IS GONE.  Owner's decision, 21 Aug
*   2026: DELETE.ACCOUNT deletes the associated Windows account.  It is part of
*   what the verb does, not an extra it stops to ask about, and that settles
*   the open question in PROJECT_STATUS.md 7 step 1c.
*
*   AND SINCE LATER THE SAME DAY THERE IS ONE CONFIRMATION COVERING ALL OF IT,
*   above, which names this account.  So the caller has agreed to exactly this
*   before control reaches here.
*
*   WHAT STILL PROTECTS A BORROWED ACCOUNT IS !is_sd_user, NOT THE PROMPT, and
*   it is untouched - it now runs at the top rather than here.  This branch is
*   only reached for an account SD created, and the "somebody else made it"
*   case below is still refused outright.  Under the access model an SD account
*   is usually named after a Windows user who already exists, so borrowing is
*   the ORDINARY case - which is exactly why the gate has to be a test and not
*   a question.
* 14 Aug 26 Windows port - was: OS.EXECUTE "sudo userdel ":username
*
* 27 Aug 26 Windows port - AND THE OS.USERS RECORD GOES WITH THE WINDOWS USER.
*   CREATEA grants one to every ADMINISTRATOR-tier USER account it makes (27
*   Aug 2026, grant.os.access), so without this a deleted account leaves a
*   person still listed as permitted to reach the operating system - and the
*   verify suite, which makes an ADMINISTRATOR account every run, would leave
*   one behind each time.
*
* 30 Aug 26 Windows port - AND IT LEFT ONE BEHIND EVERY RUN ANYWAY, BECAUSE THE
*   REMOVAL SAT IN THE WRONG ARM.  PRE_RELEASE_FIXES.md 65.  It was inside
*   "case stat = 0", and !delete_user returns TRUE for 0, 6, 7 AND 8: the login
*   is gone in all four and only the PROFILE differs.  6, 7 and 8 are the
*   ORDINARY outcome for an account somebody has just used, because a loaded
*   hive is what makes a profile unremovable - so the case that was covered was
*   the rarer one.
*
*   IT WAS "void delete_user(...)" AND THE void WAS AGAIN THE DEFECT, exactly as
*   at CREATEA:643 (PRE_RELEASE_FIXES.md 72).  The function already answers the
*   question this code needs - is the login gone - and the answer was discarded,
*   so the caller re-derived it from a status and got it wrong.
*
*   IT KEYS ON THE FUNCTION'S ANSWER AND NOT ON A LIST OF STATUSES.  Writing
*   "0, 6, 7 or 8" here would be a second opinion about what !delete_user did,
*   and one of the two would go stale the next time a status is added - which is
*   how 8 came to exist in the first place.
               login.gone = delete_user(del.user)
               stat = status()
               begin case
                  case stat = 0
                     crt sysmsg(10028,del.user) ;* OS User: %1 Deleted

                  * The account went and the profile did not.  Said plainly
                  * rather than as a deletion failure, because the account
                  * really is gone and re-running cannot retry the profile -
                  * the name no longer resolves to a SID.
                  *
                  * 27 Aug 26 Windows port - TWO CASES NOW, AND BOTH MATTER.
                  *   PRE_RELEASE_FIXES.md 32 and 35.  6 is the profile
                  *   DIRECTORY left behind, 7 the ProfileList REGISTRY ENTRY.
                  *   ***EITHER ONE pushes the next account of this name to a
                  *   suffixed home directory***, which is how an account
                  *   recreated under its old name loses its ssh keys - so the
                  *   two warnings differ in what has to be cleaned up, not in
                  *   whether anything does.  An earlier version of this
                  *   comment called 6 harmless; that was measured false on the
                  *   very install that fixed 7.
                  *
                  * 28 Aug 26 Windows port - THREE NOW, AND THE QUESTION THE
                  *   USER IS ACTUALLY ASKING HAS CHANGED.  PRE_RELEASE_FIXES.md
                  *   36: !delete_user keeps the two halves TOGETHER when the
                  *   directory cannot go and records the pair for the sweep
                  *   that runs at every SD service start.  So 6 is no longer
                  *   "here is a mess, go and clear it" - it is "this will clear
                  *   itself at the next restart", and 10075 says so.
                  *
                  *   8 IS THE ONE THAT STILL NEEDS A PERSON, and it exists
                  *   precisely so that the reassurance in 10075 is never
                  *   printed about a pair nothing is coming back for.  A single
                  *   status covering both would have made the common message a
                  *   promise the uncommon case cannot keep.
                  case stat = 6
                     crt sysmsg(10028,del.user) ;* OS User: %1 Deleted
                     crt sysmsg(10075,del.user) ;* Warning: profile kept, reclaimed at the next restart

                  case stat = 7
                     crt sysmsg(10028,del.user) ;* OS User: %1 Deleted
                     crt sysmsg(10116,del.user) ;* Warning: the profile registry entry for %1 was left behind

                  case stat = 8
                     crt sysmsg(10028,del.user) ;* OS User: %1 Deleted
                     crt sysmsg(10123,del.user) ;* Warning: profile left behind and NOT recorded

                  case 1
                     crt sysmsg(10029,del.user, stat) ;* Warning unable to delete OS User: %1 error: %2
               end case

               * 30 Aug 26 Windows port - AFTER the case and not inside any arm
               *   of it, because the arms are about the PROFILE and this is
               *   about the LOGIN.  login.gone is false only for status 1 and
               *   2, where the login is still there and its grant still has an
               *   owner.  PRE_RELEASE_FIXES.md 65.
               if login.gone then gosub drop.os.access

            case 1
               * It exists and SD did not make it.  Not offered, not asked
               * about - said plainly, so whoever wants it gone knows they are
               * removing something SD never created.  The confirmation above
               * did not promise to remove it either: del.user is empty in
               * exactly this case, so the shorter wording was used.
               crt sysmsg(10036,os.user) ;* %1 was not created by SD
         end case
      end
      * --------------------
   end

   * Delete ACCOUNTS entry.  Last, so that anything failing above leaves the
   * account registered and this verb able to be run again - see the note
   * where this used to be.

   delete acc.f, acc.name

   @system.return.code = 0
   return

* ======================================================================
* drop.os.access  -  take away this person's operating-system grant
*
* 30 Aug 26 Windows port - PRE_RELEASE_FIXES.md 65.  Lifted out of the
*   "case stat = 0" arm so that both callers reach it: the login SD has just
*   deleted, and the login that had already gone before the verb ran.  One
*   place and two callers, which is the shape entry 11 settled on after the
*   opposite arrangement lost a transaction.
*
* THE RECORD IS KEYED BY THE PERSON AND NOT BY THE ACCOUNT, so this may only
*   run where the Windows login itself is gone.  Both callers establish that
*   before the gosub - one from !delete_user's own answer, one from
*   !is_sd_user's lookup - and nothing here re-derives it.  Deleting the
*   record for a login that still exists would take a permission away from
*   somebody who still has a reason to hold it.
*
* A MISSING RECORD IS THE ORDINARY CASE, not an error: only an
*   ADMINISTRATOR-tier USER account is ever given one (CREATEA,
*   grant.os.access), and most accounts are not administrators.  Hence
*   "on error null", and no message on either outcome.
* ======================================================================

drop.os.access:
   openpath @sdsys : @ds : 'os.users' to osu.f then
      delete osu.f, os.user on error null
      close osu.f
   end
   return

* ======================================================================

report.xref:
   if not(xref.found) then
      crt sysmsg(6032) ;* Files in this account are referenced from other accounts
      crt sysmsg(6033) ;* Account           VOC entry
      xref.found = @true
   end

   crt fmt(xacc, '16L') : '  ' : xid
   return
end

* END-CODE
