* START-HISTORY:
* 25 Oct 26 Windows port - from Linux fc4030a (S.66): the manifest keys shared.read (1 unless ACC$SHARED.READ says no: a blank field means on) and
*               shared.write (1 only if yes), USER arm only.
* 23 Oct 26 Windows port - from Linux 215ce2c (S.63): os.sh and os.execute come from the register fields ACC$SH and ACC$OS.EXEC;
*           the OS.USERS record is no longer read.  RELEASE_1.1 170.
* 01 Oct 26 Windows port - written for RELEASE_1.1 116.
* 01 Oct 26 Windows port - USRDIR's backslashes are made @ds (which is "/")
*           before the separators are counted; the count was always zero.
* END-HISTORY
*
* START-DESCRIPTION:
*
*    call !acc_os_info(acc.name, acc.rec, info, err)
*
* A per-OS helper of BACKUP.ACCOUNT (see !acc_archive).  info is one manifest
* line per field, "key: value".
*
* FOR AN ACCOUNT (acc.rec its ACCOUNTS record):
*    type        USER for an sdu_ group, GROUP for sdg_, otherwise OTHER -
*                derived from the register, as Linux does
*    os.user     the Windows user (USER only; the group is sdu_<user>,
*                CREATE.ACCOUNT)
*    os.group    ACC$GROUP
*    route.ssh   1 when the user is in sdssh, else 0 (USER only)
*    route.api   1 when the user is in sdapi, else 0 (USER only)
*    members     the sdg_ group's members, comma separated (GROUP only)
*    os.sh       the register's ACC$SH "yes" -> 1, else 0   } USER only (S.63;
*    os.execute  the register's ACC$OS.EXEC "yes" -> 1, else 0  } os.users is retired)
*
* WITH acc.name EMPTY, the system keys: product, host, accounts.root (the
* directory holding user_accounts, from USRDIR as CREATE.ACCOUNT reads it)
* and sd.version.
*
* A QUESTION WINDOWS COULD NOT ANSWER IS AN ERROR, NOT A 0.  A backup that
* recorded "no ssh" because the group lookup failed would restore an account
* with its access silently taken away.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine acc_os_info(acc.name, acc.rec, info, err)
$catalog !acc_os_info

$include keys.h

deffun is_grp_member(user, group) calling '!is_grp_member'
deffun os_group(action, group, member) calling '!os_group'

   info = ''
   err  = ''

   if acc.name = '' then
      usr.dir = config('USRDIR')
      if usr.dir = '' then usr.dir = 'C:\ProgramData\SD\user_accounts'
*     01 Oct 26 - @DS IS "/" IN THIS PORT (gplsrc/sddefs.h, DS) AND USRDIR IS A
*     NATIVE WINDOWS PATH WITH BACKSLASHES, as is the default above.  Counting
*     @ds in it as it stood always answered 0 and refused with 12005 - found when
*     the Solo copy of this routine did exactly that on its first BACKUP.ACCOUNT.
*     Make it the same separator the rest of the verbs build with (dest:@ds:name).
      usr.dir = convert('\', @ds, usr.dir)
      loop while usr.dir[len(usr.dir), 1] = @ds and len(usr.dir) > 3
         usr.dir = usr.dir[1, len(usr.dir) - 1]
      repeat
      n = count(usr.dir, @ds)
      if n = 0 then
         err = 12005 : @vm : 'USRDIR' : @vm : usr.dir
         return
      end
      info<1> = 'product: windows-full'
      info<2> = 'host: ' : downcase(field(@hostname, '.', 1))
      info<3> = 'accounts.root: ' : usr.dir[1, index(usr.dir, @ds, n) - 1]
      info<4> = 'sd.version: ' : system(1012)
      return
   end

   grp = trim(acc.rec<ACC$GROUP>)
   begin case
      case downcase(grp[1, 4]) = 'sdu_' ; typ = 'USER'
      case downcase(grp[1, 4]) = 'sdg_' ; typ = 'GROUP'
      case 1                            ; typ = 'OTHER'
   end case

   uname = ''
   if typ = 'USER' then uname = grp[5, len(grp)]

   info<-1> = 'type: ' : typ
   info<-1> = 'os.user: ' : uname
   info<-1> = 'os.group: ' : grp

   ssh = 0
   api = 0
   if typ = 'USER' then
      m = is_grp_member(uname, 'sdssh')
      if status() then
         err = 12005 : @vm : acc.name : @vm : 'sdssh'
         return
      end
      if m then ssh = 1
      m = is_grp_member(uname, 'sdapi')
      if status() then
         err = 12005 : @vm : acc.name : @vm : 'sdapi'
         return
      end
      if m then api = 1
   end
   info<-1> = 'route.ssh: ' : ssh
   info<-1> = 'route.api: ' : api

   if typ = 'GROUP' then
      members = ''
      rc = os_group('LISTMEM', grp, members)
      if rc # 0 then
         err = 12005 : @vm : acc.name : @vm : grp
         return
      end
      info<-1> = 'members: ' : convert(@fm, ',', members)
   end

*  23 Oct 26 Windows port - from Linux 215ce2c (S.63): the two gates are the register's own fields now, as on Linux; the OS.USERS
*  record is retired.  1 only if the field says yes.
   if typ = 'USER' then
      info<-1> = 'os.sh: ' : (if upcase(trim(acc.rec<ACC$SH>)) = 'YES' then 1 else 0)
      info<-1> = 'os.execute: ' : (if upcase(trim(acc.rec<ACC$OS.EXEC>)) = 'YES' then 1 else 0)
      info<-1> = 'edit.voc: ' : (if upcase(trim(acc.rec<ACC$VOC.EDIT>)) = 'YES' then 1 else 0)     ;* 17 Oct 26, S.64 (Linux d7cda81)
      info<-1> = 'edit.bp: ' : (if upcase(trim(acc.rec<ACC$BP.EDIT>)) = 'YES' then 1 else 0)
      info<-1> = 'edit.dict: ' : (if upcase(trim(acc.rec<ACC$DICT.EDIT>)) = 'YES' then 1 else 0)
      info<-1> = 'shared.read: ':(if upcase(trim(acc.rec<ACC$SHARED.READ>)) # 'NO' then 1 else 0)     ;* 18 Oct 26, S.66: BLANK MEANS ON, so only the word no gives 0
      info<-1> = 'shared.write: ':(if upcase(trim(acc.rec<ACC$SHARED.WRITE>)) = 'YES' then 1 else 0)
   end

   return
end
