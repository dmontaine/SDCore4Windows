* ------------------------------------------------------------------------------------------------- running a test

* In: ri.  Runs the test: the command is  run FILE ID  through $tk_run, which refuses any other word.  What it printed and the verdict are kept and the screen is drawn again.  Out: ran.ok
run.test:
   ran.ok = @false
   cur.ri = ri                                                  ;* the drawing below uses ri, rp and zr for other things
   zfl = tfile<ri> ; zid = tid<ri>
   sent = 'run ' : zfl : ' ' : zid
   running.ri = ri
   msg = mrun : 'running ' : sent : ' - Ctrl-C then Q stops a test that does not end'
   call $tk_frame(ctx, keys, pn, msg)
   gosub draw.list
   call $sl_curat(0, ctx<TK.C.YSTAT>)
   gosub set.sentinel
   for za = 1 to ANSWERS
      data ''
   next za
   bc0 = break.count()
   void pterm(PT$BREAK, @true)
   break on
   t0 = time()
   call $tk_run(allow, sent, out, stat, rerr)
   t1 = time()
   break off
   void pterm(PT$BREAK, @false)
   zbn = 0
   loop while break.count() < bc0 and zbn < 5 do
      break off
      zbn += 1
   repeat
   loop while break.count() > bc0 and zbn < 10 do
      break on
      zbn += 1
   repeat
   zleft = len(@data.pending)
   cleardata
   running.ri = 0
   ri = cur.ri
   if rerr # '' then
      msg = mrun : rerr
      otext = sent : '  ' : rerr
      call $tk_out('add', ctx, 'refuse', otext, '')
   end else
      used = ANSWERS - zleft
      if used < 0 then used = 0
      gosub judge
      zs = abm ; gosub clean.line ; abm = zs[1, 200]            ;* the abort message can be a test's own text
      gosub store.output
      secs = t1 - t0
      if secs < 0 then secs += 86400
      gosub make.result
      oz(rp) = kept
      zs = lastl
      gosub clean.line
      rz(rp) = zstate : @fm : np : @fm : nf : @fm : secs : @fm : oconv(t1, 'MTS') : @fm : nl : @fm : cutn : @fm : abm : @fm : used : @fm : 'run' : @fm : zs[1, 200] : @fm : sent
      ran.ok = @true
      okind = 'ok'
      if zstate # 'pass' then okind = 'refuse'
      otext = sent : '  ' : zstate : ', ' : np : ' passed, ' : nf : ' failed, ' : secs : ' s'
      call $tk_out('add', ctx, okind, otext, '')                 ;* what the run answered stays in the output pane (Ctrl-O), whether or not it is open
      zr = rz(rp)
      lines = ''
      gosub describe.result
      msg = mrun : zid : ': ' : lines<1>
      lines = ''
   end
   gen += 1
   ctx<TK.C.GEN> = gen
   gosub draw.all
   return

* The system keeps the message of the last abort (and of an exception that was caught), which a test that ends normally does not touch: the page sets a message of its own first, and a test
* that aborted is one whose message is no longer that one and whose output was thrown away by the system (an aborted run captures nothing)
set.sentinel:
   zero = 0
   sentv = 0
   try
      sentv = 1 / zero
   catch sys.program.div_zero
      sentinel = @abort.message
   end
   if sentv # 0 then sentinel = ''
   return

* In: out (everything the test printed), sentinel.  Out: zstate (pass, fail or noverdict), np, nf, abm (the abort message, or null), lastl (the last non-empty line), nl (the lines printed)
judge:
   zstate = 'noverdict'
   np = '' ; nf = '' ; abm = '' ; lastl = ''
   nl = dcount(out, @fm)
   if out = '' then nl = 0
   if out = '' then
      if @abort.message # sentinel then
         zstate = 'fail'
         abm = @abort.message
         abm = change(abm, @fm, '|')
         if abm[9, 2] = ': ' then abm = abm[11, 999]
         if abm = '' then abm = 'the run aborted'
      end
   end else
      zt = field(out, @fm, (if nl > 50 then nl - 49 else 1), 50)
      zt.n = dcount(zt, @fm)
      for zq = zt.n to 1 step -1
         zl = trim(convert(char(13), '', zt<zq>))
         if zl # '' then
            lastl = zl
            exit
         end
      next zq
      if lastl # '' then
         v = lastl
         gosub parse.verdict
         if vok then
            begin case
               case nf > 0
                  zstate = 'fail'
               case np > 0
                  zstate = 'pass'
            end case
         end
      end
   end
   return

* In: v, a line.  Out: vok, np, nf.  The line is  N passed, M failed  (anything may follow M failed after a comma, a full stop, a semicolon, a bracket or a space), with  name:  in front if
* wanted: the verdict line of the project's own suites
parse.verdict:
   vok = @false
   zp1 = index(v, ' passed, ', 1)
   if zp1 = 0 then return
   v.lef = v[1, zp1 - 1]
   v.rig = v[zp1 + 9, 9999]
   w1 = field(v.lef, ' ', dcount(v.lef, ' '))
   if not(w1 matches '1N0N') then return
   v.pre = v.lef[1, len(v.lef) - len(w1)]
   if v.pre # '' then
      if v.pre[len(v.pre) - 1, 2] # ': ' then return
   end
   w2 = field(v.rig, ' ', 1)
   if not(w2 matches '1N0N') then return
   w3 = field(v.rig, ' ', 2)
   if w3[1, 6] # 'failed' then return
   w4 = w3[7, 1]
   if w4 # '' then
      if index(',.;)', w4, 1) = 0 then return
   end
   np = w1 + 0
   nf = w2 + 0
   vok = @true
   return

* In: out, nl.  Out: kept (the lines to keep, one to a field, each cut and made safe to show), cutn (how many lines were left out).  A short output is kept whole; a long one by its
* first HEADN lines, a marker line and its last TAILN, so that the end of it (the verdict) is always there
store.output:
   cutn = 0
   if nl > KEEP then
      zhead = field(out, @fm, 1, HEADN)
      ztail = field(out, @fm, nl - TAILN + 1, TAILN)
      cutn = nl - HEADN - TAILN
      zbody = zhead : @fm : '... ' : cutn : ' lines left out ...' : @fm : ztail
   end else
      zbody = out
   end
   kept = ''
   if nl > 0 then
      loop
         zs = remove(zbody, zdel2)
         zs = zs[1, LINEW]
         gosub clean.line
         kept<-1> = zs
      while zdel2 repeat
   end
   return

* In: zs.  Out: zs with the carriage returns taken out, a tab as four spaces and every other control character and mark as a dot
clean.line:
   zs = convert(char(13), '', zs)
   zs = change(zs, char(9), '    ')
   zs = convert(ctl, dots, zs)
   return

* R: the test under the cursor
do.run:
   if ns < 1 then return
   ri = shown<ci>
   zfl = tfile<ri> ; zid = tid<ri>
   begin case
      case tok<ri> = 0
         msg = 'this name has a character the page does not give to a command: type run ' : zfl : ' ' : zid : ' at the prompt'
      case tobj<ri> = 0
         msg = 'no object code for ' : zid : ': B compiles it first (basic ' : zfl : ' ' : zid : ')'
      case 1
         mrun = ''
         gosub run.test
         clearinput                                              ;* keys typed while it ran are not the page's
   end case
   return

* A (zmode all): every test shown that can be run, in the order shown; F (zmode failed): the ones that failed.  The screen shows which is running; Esc stops after the current one
do.many:
   queue = ''
   skipo = 0 ; skipn = 0
   for zk = 1 to ns
      ri = shown<zk>
      begin case
         case tobj<ri> = 0
            if zmode = 'all' then skipo += 1
         case tok<ri> = 0
            if zmode = 'all' then skipn += 1
         case 1
            if zmode = 'all' then
               queue<-1> = zk
            end else
               gosub find.result
               if rp > 0 then
                  if rz(rp)<1> = 'fail' then queue<-1> = zk
               end
            end
      end case
   next zk
   nq = dcount(queue, @fm)
   if queue = '' then nq = 0
   if nq = 0 then
      if zmode = 'all' then
         msg = 'nothing to run: no test shown has object code the page can run'
      end else
         msg = 'no test shown has failed'
      end
      return
   end
   * one keystroke would start up to MAXT programs of the account, some of which another member of a group account may have put in a shared program file: a box first, with the count and the first
   * commands, and Cancel is what Enter chooses.  R, one test, stays unboxed: it is the same as typing  run FILE ID
   sent = 'run (' : nq : (if nq = 1 then ' test)' else ' tests, one after the other)')
   lines = 'Runs these programs of your account, each as the command  run FILE ID , in the order shown.  A test can do anything this account can.'
   shw = nq
   if shw > 6 then shw = 6
   for zk2 = 1 to shw
      zri2 = shown<queue<zk2>>
      lines<-1> = '  run ' : tfile<zri2> : ' ' : tid<zri2>
   next zk2
   if nq > shw then lines<-1> = '  ... and ' : nq - shw : ' more'
   lines<-1> = 'Esc stops the run after the test that is running.'
   call $tk_confirm(sent, lines, '', cres, cmsg)
   if cres # 'run' then
      msg = cmsg
      return
   end
   m.pass = 0 ; m.fail = 0 ; m.nov = 0 ; m.ran = 0
   stopped = 0
   for zj = 1 to nq
      ci = queue<zj>
      ri = shown<ci>
      mrun = 'test ' : zj : ' of ' : nq : ': '
      gosub run.test
      if ran.ok then
         m.ran += 1
         begin case
            case zstate = 'pass'
               m.pass += 1
            case zstate = 'fail'
               m.fail += 1
            case 1
               m.nov += 1
         end case
      end
      if zj < nq then
         call $tk_frame(ctx, keys, pn, msg)
         if keyready() then
            zkey = ''
            screen key timeout 1 returning zkey else zkey = ''
            if zkey = 'esc' then
               stopped = zj
               exit
            end
            if zkey = '' and status() = ER$EOF then
               stopped = zj
               done = 1
               exit
            end
         end
      end
   next zj
   mrun = ''
   msg = 'ran ' : m.ran : ' of ' : nq : ': ' : m.pass : ' pass, ' : m.fail : ' fail, ' : m.nov : ' no verdict'
   if stopped > 0 then msg := '; stopped with Esc after test ' : stopped
   if skipo > 0 then msg := '; ' : skipo : ' without object code left out'
   if skipn > 0 then msg := '; ' : skipn : ' with a name the page does not run left out'
   clearinput
   return

* B: compile the test under the cursor when it has no object code (basic FILE ID, through $tk_run, after a box that shows the command)
do.compile:
   if ns < 1 then return
   ri = shown<ci>
   zfl = tfile<ri> ; zid = tid<ri>
   begin case
      case tok<ri> = 0
         msg = 'this name has a character the page does not give to a command: type basic ' : zfl : ' ' : zid : ' at the prompt'
         return
      case tobj<ri> = 1
         msg = 'the object code is there already; to compile it again type basic ' : zfl : ' ' : zid : ' at the prompt'
         return
   end case
   sent = 'basic ' : zfl : ' ' : zid
   lines = 'Compiles the program ' : zid : ' in the program file ' : zfl : ' and writes its object code to ' : zfl : '.out.  It does not run it.'
   lines<-1> = 'Compiling needs the bp-edit gate, and yours is ' : (if kernel(K$BP.EDIT, -1) then 'on' else 'off') : "; the compiler's own refusal is shown on the status line if it is off."
   call $tk_confirm(sent, lines, '', cres, cmsg)
   if cres # 'run' then
      msg = cmsg
      return
   end
   gosub make.result
   call $tk_run(allow, sent, out, stat, rerr)
   if rerr # '' then
      msg = rerr
      return
   end
   nl = dcount(out, @fm)
   if out = '' then nl = 0
   gosub store.output
   oz(rp) = kept
   zr = rz(rp)
   zr<10> = 'compile'
   rz(rp) = zr
   zlast = ''
   for zq = nl to 1 step -1
      zs = out<zq>
      gosub clean.line                                          ;* the compiler can echo source text: no carriage return or escape reaches the status line
      if trim(zs) # '' then
         zlast = trim(zs)[1, 120]
         exit
      end
   next zq
   gosub read.all
   gen += 1
   ctx<TK.C.GEN> = gen
   gosub draw.all
   msg = sent : ': ' : (if zlast # '' then zlast else 'it printed nothing')
   return

* Enter: what the test under the cursor printed (or the compiler printed), in the lower box, scrolling
show.output:
   if ns < 1 then return
   ri = shown<ci>
   gosub find.result
   if rp = 0 then
      msg = 'nothing to show: this test has not been run (R runs it)'
      return
   end
   vlines = oz(rp)
   nv = dcount(vlines, @fm)
   if vlines = '' then nv = 0
   if nv = 0 then
      msg = 'it printed nothing, so there is nothing to show'
      return
   end
   otitle = tid<ri>
   ot = 0
   pn = 'Output'
   gosub draw.all
   return

do.filter:
   screen ask 'Part of a test or program file name (empty shows every test)' width 40 title 'Filter' returning ft then got = 1 else got = 0
   if not(got) then return
   filt = trim(ft)
   gosub apply.filter
   ci = 1 ; ta = 0
   gosub draw.all
   msg = (if filt = '' then 'every test' else ns : ' with "' : filt : '"')
   return

end

