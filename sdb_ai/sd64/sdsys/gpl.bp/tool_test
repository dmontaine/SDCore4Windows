*
* START-DESCRIPTION:
*
*   TOOL.TEST       (in every account's VOC)
*
*   A full-screen page, in the toolkit's frame (140 columns by 43 lines at least), for the tests of the account the session is in.  THE CONVENTION: a test is a BASIC program whose record
*   id starts with test. (test.sort, test.invoice.totals) in one of the account's program files, which prints its results and whose LAST NON-EMPTY output line says  N passed, M failed
*   (the project's own suites end this way; a name and a colon may come first, as in  sandbox-x: 12 passed, 0 failed).  The page runs it with  run FILE ID  and judges: PASS when the
*   line says M is 0 and N is above 0; FAIL when M is above 0, or when the run aborted; NO VERDICT for anything else (no such line, no output at all, N and M both 0).
*
*   WHICH FILES.  The program files of the account are the directory files its VOC points at that are called bp, or end in .bp, or have a file of the same name with .out added beside
*   them (where the compiler puts the object code).  A test with no record of its own name in that .out file has no object and cannot be run until B has compiled it.
*
*   WHAT IT CAN DO.  R runs the test under the cursor, A runs every test shown (the filter applies), F runs again the ones that failed; each is  run FILE ID  through $tk_run, which lets
*   through only the words run and basic and the characters a-z, digits, dot, dash and underscore.  A run needs no sh and no os gate: it runs the account's own object code, as typing the
*   command would.  B compiles a test whose object is missing (basic FILE ID) after a box that shows the command.  Enter shows what the test printed, scrolling; Esc comes back.  The
*   results are kept in memory for the session and written nowhere.
*
*   WHAT THE RUN DOES FOR A TEST.  EXECUTE ... CAPTURING collects what it prints (an aborted test's output is discarded by the system, so an abort is told by the abort message the system
*   keeps: the page sets a message of its own first and the test aborted when the message changed and nothing was captured).  A test that asks for input is given ANSWERS empty answers
*   (the data stack) and the leftovers are discarded; the result says how many it used.  The break key is turned on for the run: a test that does not end is stopped with Ctrl-C and Q.
*   BASIC has no time limit for a program and neither has the page.  Only the first and last lines of a very long output are kept (the result says so); the verdict is judged on all of it.
*
*   Keys: Up and Down, PgUp and PgDn, Home and End move; R, A, F, B and Enter as above; / filters the names (a part of a test or file name; empty shows all); Esc clears the
*   filter; F5 reads the program files again (the results stay); F1 or ? or a click on [?] explains the page; Ctrl-Q leaves.  A name with a character the page does not give to a
*   command (a capital, an ampersand, a dollar) is listed, and the page says which command to type at the prompt.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $tool_test
$catalog $tool_test

$include keys.h
$include int$keys.h
$include err.h
$include sl.h
$include tk.h

   prompt ''

   allow = 'run basic'                                          ;* the commands this page may run, through $tk_run
   MAXT = 500                                                   ;* tests listed, and results kept
   ANSWERS = 50                                                 ;* empty answers stacked for a test that asks for input
   KEEP = 400 ; HEADN = 360 ; TAILN = 39 ; LINEW = 250          ;* the output kept: all of it up to KEEP lines, else the first HEADN, a marker line and the last TAILN
   VIS = 16 ; VISO = 15                                         ;* test rows on the screen, output rows in the lower box (both set by get.rects from the panes)

   call $tk_open('tool.test', '', ctx, err)
   if err # '' then
      display err
      stop
   end

   perr = ''
   outopen = 0                                                  ;* the output pane of the runs (Ctrl-O): closed until asked for
   gosub declare.layout

   keys = ''
   call $tk_keys('add', keys, 'f1', 'help', 'help', '', 1)
   call $tk_keys('add', keys, 'r', 'run', 'run', 'Tests', 1)
   call $tk_keys('add', keys, 'a', 'run all', 'runall', 'Tests', 1)
   call $tk_keys('add', keys, 'f', 'run failed', 'runfailed', 'Tests', 1)
   call $tk_keys('add', keys, 'b', 'compile', 'compile', 'Tests', 1)
   call $tk_keys('add', keys, 'enter', 'output', 'output', 'Tests', 1)
   call $tk_keys('add', keys, '/', 'filter', 'filter', 'Tests', 1)
   call $tk_keys('add', keys, 'esc', 'tests', 'back', 'Output', 1)
   call $tk_keys('add', keys, 'f5', 'refresh', 'refresh', '', 1)
   call $tk_keys('add', keys, 'ctrl-o', 'runs', 'runspane', '', 1)
   call $tk_keys('add', keys, 'ctrl-q', 'quit', 'quit', '', 1)
   call $tk_keys('add', keys, 'f6', 'box', 'pane', '', 1)                  ;* S.176: F6 / Shift-F6 the other box and the AI line, as on every page (Tab does not); last on the row, so the rows of each pane begin as they did
   call $tk_keys('add', keys, 'esc', 'menu', 'menu', 'Tests', 1)           ;* S.88 U7: in the Tests pane Esc takes the name filter off first, else opens the menu bar (in Output it is 'back')
   call $tk_keys('menu', keys, 'quit', '&File', '&Quit', '', '')
   call $tk_keys('menu', keys, 'run', '&Tests', '&Run this test', '', '')
   call $tk_keys('menu', keys, 'runall', '&Tests', 'Run &all', '', '')
   call $tk_keys('menu', keys, 'runfailed', '&Tests', 'Run &failed', '', '')
   call $tk_keys('menu', keys, 'compile', '&Tests', '&Build (compile)', '', '')
   call $tk_keys('menu', keys, 'output', '&Tests', 'Show the &output', '', '')
   call $tk_keys('menu', keys, 'filter', '&View', '&Filter the names', '', '')
   call $tk_keys('menu', keys, 'refresh', '&View', '&Refresh', '', '')
   call $tk_keys('menu', keys, 'pane', '&View', '&Switch box', '', '')       ;* S.180: every key's action is on a menu (F6)
   call $tk_keys('menu', keys, 'runspane', '&View', '&Output of the runs (Ctrl-PgUp, Ctrl-PgDn scroll)', '', '')
   call $tk_keys('menu', keys, 'help', '&Help', '&Help on this page', '', '')
   call $tk_std('keys', ctx, keys, '', '')                ;* S.179: Ctrl-T theme, Ctrl-K keys and their View and Help entries, as on every page
   * S.97 stage 2: the AI line.  The page offers the AI only the actions that change what is shown - the filter, refresh and the output pane of the runs (the owner: opt-in, off
   * by default; running a test is not offered); a proposal is carried out by the page's own key.  Where the AI is not usable for the account nothing here adds a key, a row or a
   * line.  This page lays itself out before its key table, so a line that took a row has the panes declared again.
   call $tk_keys('ai', keys, 'filter', '', '', '', '')
   call $tk_keys('ai', keys, 'refresh', '', '', '', '')
   call $tk_keys('ai', keys, 'runspane', '', '', '', '')
   call $tk_aipage('init', ctx, keys, '', '', aout)
   if aout then gosub declare.layout

   dim rz(500)                                                  ;* the result of a test: state, passed, failed, seconds, time, lines, lines left out, abort message, answers used, what the output is, last line, command
   dim oz(500)                                                  ;* what it printed (the kept lines, one to a field)
   mat rz = ''
   mat oz = ''
   rkeys = ''                                                   ;* file/id of each result, in the order they were made

   ctl = '' ; dots = ''                                         ;* the characters that are shown as a dot
   for zc = 1 to 31
      if zc # 9 then
         ctl := char(zc)
         dots := '.'
      end
   next zc
   ctl := char(127) : char(251) : char(252) : char(253) : char(254) : char(255)
   dots := '......'

   hl = fmt('Test', '30L') : fmt('Program file', '14L') : fmt('Object', '8L') : fmt('Result', '13L') : fmt('Passed', '7R') : fmt('Failed', '7R') : fmt('Secs', '6R') : '  ' : fmt('Ran', '9L') : fmt('Lines', '7R')

   tfile = '' ; tid = '' ; tobj = '' ; tok = '' ; nt = 0         ;* every test found, one to a field
   pfiles = ''
   shown = '' ; ns = 0                                          ;* the rows shown (filter applied): the numbers of rows in the lists above
   filt = ''
   ci = 1 ; ta = 0
   gen = 0
   done = 0
   pn = 'Tests'                                                 ;* the pane with the focus: Tests, or Output (scrolling what one test printed)
   running.ri = 0
   mrun = ''
   capped = 0
   vlines = '' ; nv = 0 ; ot = 0
   sentinel = ''
   msg = ''                                                     ;* S.88 U7: no key hint in the status line (F1 lists the keys)

   gosub read.all
   gosub draw.all

   loop
      call $tk_menubar('draw', ctx, keys, pn, '', '', mr)                   ;* the bar first: it writes row 0 whole, and the frame then writes the app name at its right end
      call $tk_frame(ctx, keys, pn, msg)
      call $sl_curat(0, ctx<TK.C.YSTAT>)
      nm = ''
      screen key returning nm
      mr = ''
      ao = ''
      if nm # '' then call $tk_aipage('key', ctx, keys, pn, nm, ao)                  ;* S.97 stage 2: while the AI line has the focus it takes the keys, before the bar sees them
      if ao<1> = 'replay' then nm = ao<2>                                            ;* an action the AI proposed and the person accepted: this page's own key for it
      if ao<1> # '' then msg = ao<4>
      busy = (if filt # '' or outopen then 1 else 0)
      if nm # '' and ao<1> = '' then call $tk_menubar('key', ctx, keys, pn, nm, busy, mr)       ;* the Esc rule: a name filter is taken off before the bar opens (in Output Esc is the page's own 'back')
      if mr<1> # '' then nm = mr<4>
      begin case
         case ao<1> = 'taken'
            if ao<3> then
               gen += 1                                                               ;* the preview, the wait and the answer covered the page: all of it is drawn again
               ctx<TK.C.GEN> = gen
               gosub draw.all
            end
         case nm = ''
            if status() = ER$EOF then exit
         case nm = 'guardquit'
            exit
         case nm = 'resize'
            call $tk_layout('refresh', ctx, '', chg)
            gosub get.rects
            if ta > ns - VIS then ta = ns - VIS
            if ta < 0 then ta = 0
            if ot > nv - VISO then ot = nv - VISO
            if ot < 0 then ot = 0
            gen += 1
            ctx<TK.C.GEN> = gen
            gosub draw.all
         case nm = 'mouse'
            gosub on.mouse
         case 1
            gosub on.key
      end case
      if done then exit
   repeat

   call $tk_close(ctx)
   stop

* ------------------------------------------------------------------------------------------------- what the system says

* Every test of the account: the test.* records of its program files; the cursor goes back to the test it was on
read.all:
   keep.k = ''
   if ns > 0 and ci >= 1 and ci <= ns then keep.k = tfile<shown<ci>> : '/' : tid<shown<ci>>
   tfile = '' ; tid = '' ; tobj = '' ; tok = '' ; nt = 0
   pfiles = ''
   capped = 0
   fids = ''
   open 'VOC' to vocf then
      sselect vocf to 9
      readlist ids from 9 else ids = ''
      n = dcount(ids, @fm)
      if ids = '' then n = 0
      for i = 1 to n
         read r from vocf, ids<i> then
            * the first field is F, or a description that starts "File" (a file's description is kept there)
            t1 = upcase(r<1>)
            if t1 = 'F' or t1[1, 5] = 'FILE ' then fids<-1> = ids<i>
         end
      next i
   end
   nfv = dcount(fids, @fm)
   if fids = '' then nfv = 0
   for i = 1 to nfv
      fn = fids<i>
      gosub scan.file
   next i
   gosub apply.filter
   ci = 1 ; ta = 0
   if keep.k # '' then
      for zi = 1 to ns
         if tfile<shown<zi>> : '/' : tid<shown<zi>> = keep.k then ci = zi
      next zi
   end
   if ci > ns then ci = ns
   if ci < 1 then ci = 1
   return

* In: fn, a VOC entry that points at a file.  A program file is a directory file called bp, or ending .bp, or with a file of the same name and .out added beside it (the compiler's);
* its records that start with test. are added to the list, each with whether its object code is in the .out file
scan.file:
   lfn = downcase(fn)
   sfx = ''
   if len(lfn) >= 4 then sfx = lfn[len(lfn) - 3, 4]
   cand = @false
   if sfx # '.out' then
      if lfn = 'bp' then cand = @true
      if sfx = '.bp' then cand = @true
      locate fn : '.out' in fids<1> setting zp then
         if zp > 0 then cand = @true
      end
   end
   if cand then
      open fn to zf then
         if fileinfo(zf, FL$TYPE) = FL$TYPE.DIR then
            sselect zf to 8
            readlist zids from 8 else zids = ''
            ztests = ''
            loop
               zid = remove(zids, zdel)
               if downcase(zid[1, 5]) = 'test.' then ztests<-1> = zid
            while zdel repeat
            if ztests # '' then
               pfiles<-1> = fn
               zobj = ''
               open fn : '.out' to zof then
                  sselect zof to 7
                  readlist zobj from 7 else zobj = ''
                  close zof
               end
               zt = dcount(ztests, @fm)
               for zi = 1 to zt
                  if nt < MAXT then
                     nt += 1
                     zid = ztests<zi>
                     tfile<nt> = fn
                     tid<nt> = zid
                     zob = @false
                     locate downcase(zid) in zobj<1> setting zp then
                        if zp > 0 then zob = @true
                     end
                     tobj<nt> = (if zob then 1 else 0)
                     zfl = fn
                     gosub check.names
                     tok<nt> = (if okname then 1 else 0)
                  end else
                     capped = 1
                  end
               next zi
            end
         end
         close zf
      end
   end
   return

* The rows that hold the filter's text (any case) in the test name or the program file
apply.filter:
   shown = ''
   ns = 0
   for zi = 1 to nt
      if filt = '' or index(upcase(tid<zi> : ' ' : tfile<zi>), upcase(filt), 1) > 0 then shown<-1> = zi
   next zi
   ns = dcount(shown, @fm)
   if shown = '' then ns = 0
   return

* In: ri, a row.  Out: rp, the place of that test's result (0 when it has none), and fkey, its key
find.result:
   rp = 0
   fkey = tfile<ri> : '/' : tid<ri>
   locate fkey in rkeys<1> setting fzp then rp = fzp
   return

* The same, and the place is made when the test has none yet
make.result:
   gosub find.result
   if rp = 0 then
      if dcount(rkeys, @fm) >= 500 then
         rkeys = ''
         mat rz = ''
         mat oz = ''
      end
      rkeys<-1> = fkey
      rp = dcount(rkeys, @fm)
      rz(rp) = ''
      oz(rp) = ''
   end
   return

* A name the page may give to a command: letters a-z, digits, dot, dash and underscore only (what $tk_run lets through).  In: zfl (the program file) and zid (the test).  Out: okname
check.names:
   okname = (len(zfl) > 0 and len(zid) > 0 and len(zfl) <= 63 and len(zid) <= 63)
   good = 'abcdefghijklmnopqrstuvwxyz0123456789._-'
   zz = zfl : zid
   for zq = 1 to len(zz)
      if index(good, zz[zq, 1], 1) = 0 then okname = @false
   next zq
   return

* ------------------------------------------------------------------------------------------------- drawing

* The layout (S.88 L2).  The two boxes are the panes of the layout service, declared in the sizes of the reference layout (140 by 43, the body 138 by 39): the list stretches (a bigger
* window shows more tests), the lower box (the description, or the output of one test) takes what the layout gives it by its own weight of columns and rows.
* Out: lx ly lw lh (the list), dx dy dw dh (the lower box), tw (the text width of both), VIS (the test rows), VISO (the output rows).
declare.layout:
   d = ''
   d<1> = 'list' : @vm : 1 : @vm : 1 : @vm : 22 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<2> = 'detail' : @vm : 2 : @vm : 1 : @vm : 17 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   if outopen then
      * the output pane is open (Ctrl-O): the list 6 rows shorter and the output pane, 6 rows, between the list and the lower box (rows named lo, not d: the closed layout above is the page's own)
      lo = ''
      lo<1> = d<1> ; lo<1, 4> = 16                              ;* the list: 6 rows shorter (value 4 is the height)
      lo<2> = d<2> ; lo<2, 1> = 'output' ; lo<2, 2> = 2 ; lo<2, 4> = 6
      lo<3> = d<2> ; lo<3, 2> = 3                              ;* the lower box as it was, one band lower
      d = lo
   end
   ctx<TK.C.FOCI> = 'list' : @sm : 'Tests' : @vm : 'detail' : @sm : 'Output'        ;* S.99: the boxes that take the focus (Output scrolls in the lower box), for $tk_frame's [*] / [-]
   call $tk_layout('declare', ctx, d, perr)
   gosub get.rects
   return

get.rects:
   call $tk_layout('pane', ctx, 'list', rc)
   lx = rc<1, 1> ; ly = rc<1, 2> ; lw = rc<1, 3> ; lh = rc<1, 4>
   call $tk_layout('pane', ctx, 'detail', rc)
   dx = rc<1, 1> ; dy = rc<1, 2> ; dw = rc<1, 3> ; dh = rc<1, 4>
   tw = lw - 4
   VIS = lh - 6                                                 ;* the header row, the test rows, the two summary lines, a blank row and the border: 16 rows of 22
   VISO = dh - 2
   return

* In: lines.  Out: dlines, what the description shows.  A line longer than the box is wrapped at its width (S.138).
fit.lines:
   dlines = lines
   if lines # '' then
      dlines = ''
      nd = 0
      for q = 1 to dcount(lines, @fm)
         nd += 1
         dlines<nd> = ''
         if lines<q> # '' then
            call $tk_wrap(lines<q>, tw, wpieces)
            for pj = 1 to dcount(wpieces, @fm)
               dlines<nd> = wpieces<pj>
               nd += 1
            next pj
            nd -= 1
         end
      next q
   end
   return

draw.all:
   cw2 = ctx<TK.C.W>
   chh = ctx<TK.C.H> - 5
   screen clear at 0,1 size cw2,chh
   ttl = 'Tests in ' : @who
   screen box at lx,ly size lw,lh title ttl
   gosub draw.lower
   gosub draw.list
   if outopen then call $tk_out('draw', ctx, 'output', '', oc)   ;* the output pane, in the rectangle the open layout gives it
   return

* Ctrl-O or Tests > Output of the runs, and Esc while it is open: the pane is shown or put away, the layout is declared again and all of it drawn
toggle.out:
   call $tk_out('toggle', ctx, '', '', oc)
   outopen = oc
   gosub declare.layout                                         ;* draw.list keeps the cursor row in view for the new VIS
   gen += 1
   ctx<TK.C.GEN> = gen
   gosub draw.all
   return

draw.lower:
   if pn = 'Output' then
      gosub draw.output
   end else
      screen box at dx,dy size dw,dh title 'The test under the cursor'
      gosub draw.detail
   end
   return

draw.list:
   screen text hl at lx + 2,ly + 1 attr 'header' width tw
   if ci <= ta then ta = ci - 1
   if ci > ta + VIS then ta = ci - VIS
   if ta < 0 then ta = 0
   for r = 1 to VIS
      kk = ta + r
      s = ''
      if kk <= ns then gosub row.text
      screen text s at lx + 2,ly + 1 + r attr (if kk = ci and kk <= ns then 'highlight' else 'normal') width tw
   next r
   gosub draw.foot
   call $tk_help('mark', lx + lw - 5, ly + 1, 0, 0)
   return

* In: kk, a place in the rows shown.  Out: s, the line of the list for that test
row.text:
   ri = shown<kk>
   gosub find.result
   zr = ''
   if rp > 0 then zr = rz(rp)
   rtx = ''
   begin case
      case ri = running.ri
         rtx = 'running'
      case tok<ri> = 0
         rtx = 'by hand'
      case tobj<ri> = 0
         rtx = 'no object'
      case zr<1> = ''
         rtx = 'not run'
      case zr<1> = 'pass'
         rtx = 'pass'
      case zr<1> = 'fail' and zr<8> # ''
         rtx = 'fail: abort'
      case zr<1> = 'fail'
         rtx = 'fail'
      case 1
         rtx = 'no verdict'
   end case
   s = fmt(tid<ri>[1, 29], '30L') : fmt(tfile<ri>[1, 13], '14L') : fmt((if tobj<ri> then 'yes' else 'no'), '8L') : fmt(rtx, '13L') : fmt(zr<2>, '7R') : fmt(zr<3>, '7R') : fmt(zr<4>, '6R') : '  ' : fmt(zr<5>, '9L') : fmt(zr<6>, '7R')
   return

* The summary under the list, and the gate the page shows (asked of the kernel, never tried)
draw.foot:
   c.pass = 0 ; c.fail = 0 ; c.nov = 0 ; c.not = 0
   for zi = 1 to nt
      ri = zi
      gosub find.result
      zs8 = ''
      if rp > 0 then zs8 = rz(rp)<1>
      begin case
         case zs8 = 'pass'
            c.pass += 1
         case zs8 = 'fail'
            c.fail += 1
         case zs8 = 'noverdict'
            c.nov += 1
         case 1
            c.not += 1
      end case
   next zi
   npf = dcount(pfiles, @fm)
   if pfiles = '' then npf = 0
   s = nt : (if nt = 1 then ' test' else ' tests') : ' in ' : npf : (if npf = 1 then ' program file' else ' program files')
   s := ':  ' : c.pass : ' pass, ' : c.fail : ' fail, ' : c.nov : ' no verdict, ' : c.not : ' not run'
   if filt # '' then s := ';  ' : ns : ' with "' : filt : '" in the name'
   if capped then s := ';  only the first ' : MAXT : ' are listed'
   s := '.   Your gate:  bp-edit ' : (if kernel(K$BP.EDIT, -1) then 'on' else 'off') : ' (B compiles)'
   screen text fmt(s, tw : 'L') at lx + 2,ly + lh - 4 attr 'bold' width tw
   note = "A test prints its result, and its last line says N passed, 0 failed.  A run needs no gate.  Ctrl-C then Q stops one that does not end."
   wpieces = note
   call $tk_wrap(note, tw, wpieces)
   screen text fmt(wpieces<1>, tw : 'L') at lx + 2,ly + lh - 3 width tw
   if wpieces<2> # '' then screen text fmt(wpieces<2>, tw : 'L') at lx + 2,ly + lh - 2 width tw
   return

* The test under the cursor in plain words
draw.detail:
   lines = ''
   if ns >= 1 and ci >= 1 and ci <= ns then
      ri = shown<ci>
      gosub describe
   end else
      if nt = 0 then
         lines<-1> = 'This account has no tests yet.'
         lines<-1> = ''
         lines<-1> = 'A test is a BASIC program whose record id starts with test. (test.sort, test.invoice.totals) in a program file: bp, a file whose name ends .bp, or one'
         lines<-1> = 'with a file of the same name and .out beside it.  It prints what it checks, and its LAST line says how it went:  3 passed, 0 failed'
         lines<-1> = '(a name and a colon may come first, as in  sandbox-x: 12 passed, 0 failed).  It is a PASS when failed is 0 and passed is above 0, a FAIL when failed is above 0'
         lines<-1> = 'or the run aborted, and NO VERDICT for anything else.  Compile it (B, or basic bp test.name) and R runs it.'
      end else
         lines<-1> = 'No test name holds "' : filt : '".  Esc shows all of them.'
      end
   end
   gosub fit.lines
   for r = 1 to dh - 2
      screen text fmt(dlines<r>[1, tw], tw : 'L') at dx + 2,dy + r width tw
   next r
   return

* In: ri.  Out: lines, the test in sentences
describe:
   zfl = tfile<ri> ; zid = tid<ri>
   gosub find.result
   zr = ''
   if rp > 0 then zr = rz(rp)
   zo = ''
   if rp > 0 then zo = oz(rp)
   lines<-1> = zid : '  -  in the program file ' : zfl : (if tobj<ri> then ' (its object code is in ' : zfl : '.out)' else ' (there is no object code for it in ' : zfl : '.out)')
   begin case
      case zr<1> = ''
         if tok<ri> = 0 then
            lines<-1> = 'The page does not give this name to a command: type  run ' : zfl : ' ' : zid : '  at the prompt (and basic ' : zfl : ' ' : zid : ' first if it has no object code).'
         end else
            if tobj<ri> = 0 then
               lines<-1> = 'It cannot be run yet: B compiles it (basic ' : zfl : ' ' : zid : '), then R runs it.'
            end else
               lines<-1> = 'Not run in this session.  R runs it  (run ' : zfl : ' ' : zid : ').'
            end
         end
      case 1
         gosub describe.result
   end case
   if zo # '' then
      lines<-1> = ''
      gosub describe.tail
   end
   return

* In: zr (the result), zid.  The sentences about a test that has been run
describe.result:
   begin case
      case zr<1> = 'pass'
         zw = 'PASS - ' : zr<2> : ' passed, ' : zr<3> : ' failed.'
      case zr<1> = 'fail' and zr<8> # ''
         zw = 'FAIL - the run aborted: ' : zr<8>
      case zr<1> = 'fail'
         zw = 'FAIL - ' : zr<2> : ' passed, ' : zr<3> : ' failed.'
      case zr<6> = 0
         zw = 'NO VERDICT - it printed nothing.'
      case 1
         zw = 'NO VERDICT - the last line is not  N passed, M failed  with N above 0.  The last line was: ' : zr<11>
   end case
   lines<-1> = zw
   lines<-1> = 'Took ' : zr<4> : ' s, finished at ' : zr<5> : '; ' : zr<6> : (if zr<6> = 1 then ' line' else ' lines') : ' of output.   Command: ' : zr<12>
   if zr<9> > 0 then lines<-1> = 'It asked for input ' : zr<9> : (if zr<9> = 1 then ' time' else ' times') : ' and was given an empty answer each time.'
   if zr<7> > 0 then lines<-1> = 'The output is cut: the first ' : HEADN : ' and the last ' : TAILN : ' of its ' : zr<6> : ' lines are kept (the verdict was judged on all of them).'
   if zr<10> = 'compile' then lines<-1> = "What Enter shows now is the compiler's output, from B; the numbers above are from the last run."
   return

describe.tail:
   zn = dcount(zo, @fm)
   if zo = '' then zn = 0
   if zn = 0 then
      lines<-1> = 'It printed nothing.'
   end else
      lines<-1> = (if zr<10> = 'compile' then "The end of the compiler's output (Enter shows all of it):" else 'The end of what it printed (Enter shows all of it):')
      zfirst = zn - 5
      if zfirst < 1 then zfirst = 1
      for zq = zfirst to zn
         lines<-1> = '  ' : zo<zq>
      next zq
   end
   return

* The lower box as a window on what one test printed: lines ot + 1 to ot + VISO of vlines
draw.output:
   a1 = ot + 1
   a2 = ot + VISO
   if a2 > nv then a2 = nv
   ottl = 'Output of ' : otitle : '  (lines ' : a1 : ' to ' : a2 : ' of ' : nv : ' kept;  Up, Down, PgUp, PgDn, Home, End scroll;  Esc goes back)'
   screen box at dx,dy size dw,dh title ottl
   for r = 1 to VISO
      kk = ot + r
      s = ''
      if kk <= nv then s = fmt(kk, '5R') : '  ' : vlines<kk>[1, tw - 8]
      screen text fmt(s, tw : 'L') at dx + 2,dy + r width tw
   next r
