      case nm = 'ctrl-t'                    ;* S.179: the theme, as in the page's other pane ($tk_std)
         call $tk_std('theme', ctx, keys, '', std.r)
         if std.r<1> then gosub draw.all
         msg = std.r<2>
      case nm = 'act:std.mouse'             ;* S.186: View > Mouse, the same on every page ($tk_std)
         call $tk_std('mouse', ctx, keys, '', std.r)
         msg = std.r<2>
      case nm = 'ctrl-k'                    ;* S.179: the keys of this page, in a box
         call $tk_std('keylist', ctx, keys, pn, std.r)
      case nm = 'f5'
         gosub read.all
         pn = 'Tests'
         gosub draw.all
         msg = 'read the program files again; the results are kept'
      case nm = 'f6' or nm = 'shift-f6' or nm = 'act:ai'
         gosub box.ring                                          ;* S.176: from the Output box too
      case nm = 'ctrl-q'
