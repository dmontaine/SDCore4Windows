* ------------------------------------------------------------------------------------------------- keys and mouse

on.key:
   msg = ''
   if len(nm) = 1 then nm = downcase(nm)                         ;* R and r are one key
   begin case
      case nm = 'ctrl-o'
         gosub toggle.out
         return
      case nm = 'esc' and outopen
         gosub toggle.out                                        ;* the Esc rule: what the page has open is closed first, in either pane
         return
      case (nm = 'ctrl-pgup' or nm = 'ctrl-pgdn') and outopen
         okey = nm[6, 4]
         call $tk_out('key', ctx, okey, '', oc)                  ;* the output pane scrolls (pgup / pgdn)
         call $tk_out('draw', ctx, 'output', '', oc)
         return
   end case
   if pn = 'Output' then
      gosub out.key
      return
   end
   begin case
      case nm = 'esc'
         if filt # '' then
            filt = ''
            gosub apply.filter
            ci = 1 ; ta = 0
            gosub draw.all
         end
      case nm = 'up'
         if ci > 1 then
            ci -= 1
            gosub redraw
         end
      case nm = 'down'
         if ci < ns then
            ci += 1
            gosub redraw
         end
      case nm = 'pgup'
         ci -= VIS
         if ci < 1 then ci = 1
         gosub redraw
      case nm = 'pgdn'
         ci += VIS
         if ci > ns then ci = ns
         gosub redraw
      case nm = 'home'
         ci = 1
         gosub redraw
      case nm = 'end'
         if ns > 0 then ci = ns
         gosub redraw
      case nm = 'r'
         gosub do.run
      case nm = 'a'
         zmode = 'all'
         gosub do.many
      case nm = 'f'
         zmode = 'failed'
         gosub do.many
      case nm = 'b'
         gosub do.compile
      case nm = 'enter'
         gosub show.output
      case nm = '/'
         gosub do.filter
      case nm = 'f1' or nm = '?'
         call $tk_help('box', 'tool.test.page', hm, 0, 0)
         if hm # '' then msg = hm
      case nm = 'ctrl-t'                    ;* S.179: the theme, kept for the person - the same on every page ($tk_std)
         call $tk_std('theme', ctx, keys, '', std.r)
         if std.r<1> then gosub draw.all
         msg = std.r<2>
      case nm = 'act:std.mouse'             ;* S.186: View > Mouse, the same on every page ($tk_std)
         call $tk_std('mouse', ctx, keys, '', std.r)
         msg = std.r<2>
      case nm = 'ctrl-k'                    ;* S.179: the keys of this page, in a box
         call $tk_std('keylist', ctx, keys, pn, std.r)
      case nm = 'f5'
         gosub read.all
         gosub draw.all
         msg = 'read the program files again; the results are kept'
      case nm = 'f6' or nm = 'shift-f6' or nm = 'act:ai'
         gosub box.ring
      case nm = 'ctrl-q'
         done = 1
   end case
   return

* S.176: F6 / Shift-F6 go round the boxes (Tests, Output) and the AI line, from either box; AI > Ask the AI goes to the line.  The Output box opens only for a test that has
*   been run (show.output says so): then the ring goes on past it.
box.ring:
   rg.at = (if pn = 'Output' then 2 else 1)
   call $tk_aipage('ring', ctx, keys, rg.at, nm : @fm : 2, ap)
   msg = ap<2>
   begin case
      case ap<1> = 2 and pn # 'Output'
         gosub show.output
         if pn # 'Output' then
            rg.msg = msg
            call $tk_aipage('ring', ctx, keys, 2, nm : @fm : 2, ap)          ;* nothing to show: on to the next stop
            msg = (if ap<2> # '' then ap<2> else rg.msg)
            if ap<1> = 1 then gosub draw.all
         end
      case ap<1> = 1 and pn = 'Output'
         pn = 'Tests'
         gosub draw.all
   end case
   return

redraw:
   gosub draw.all
   return

* The keys of the Output pane: the lines of one test's output scroll
out.key:
   ozmax = nv - VISO
   if ozmax < 0 then ozmax = 0
   begin case
      case nm = 'esc'
