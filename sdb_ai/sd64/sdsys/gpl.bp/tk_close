*
* START-DESCRIPTION:
*
*   call $tk_close(ctx)
*
*   Gives the terminal back: the screen first, then the break setting $tk_open saved, then the break key.  An app calls it on EVERY way out,
*   the cursor lock's own (the key 'guardquit') and the end of its input included.  The frame cache's epoch is cleared last: what $tk_frame
*   wrote is gone with the screen.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine tk_close(ctx)
$catalog $tk_close

$include keys.h
$include int$keys.h
$include tk.h

   common /tkepoch/ ep.next, ep.drawn             ;* the frame cache's epoch ($tk_open counts, $tk_frame compares)
   common /tkreg/ reg.keys, reg.pane, reg.epoch   ;* the key table of the app that was drawing ($tk_frame keeps it for $tk_help)

   screen close
   call $tk_brk('close', ctx<TK.C.TRAP>)          ;* the break setting back (the one kept at the start of the first app, if an earlier one was aborted), and BREAK ON
   ep.drawn = ''                                  ;* F1: nothing of the frame is on a screen any more
   reg.keys = ''                                  ;* F0a: and no app has keys to list
   reg.pane = ''
   reg.epoch = ''
   ctx<TK.C.EPOCH> = ''

   return
end

* END-CODE
