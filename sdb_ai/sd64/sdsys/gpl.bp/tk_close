* START-DESCRIPTION:
*
*   call $tk_close(ctx)
*
*   Gives the terminal back: the screen first, then the break setting $tk_open saved, then the break key.  An app calls it on EVERY way out,
*   the cursor lock's own (the key 'guardquit') and the end of its input included.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine tk_close(ctx)
$catalog $tk_close

$include keys.h
$include int$keys.h
$include tk.h

   screen close
   void pterm(PT$BREAK, ctx<TK.C.TRAP>)
   break on

   return
end

