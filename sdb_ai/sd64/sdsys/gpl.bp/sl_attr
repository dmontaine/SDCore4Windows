* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $sl_attr(name, code)
*
*     name  normal, highlight (the selected item, a focused button), bar (the menu bar and a
*           menu's body), barsel (the selected item of a bar), hotkey (the mnemonic letter),
*           hotkey.bar (the mnemonic on a bar), field (an entry field), frame, disabled, or
*           reverse, underline; a code itself (n r u x) is taken as it is
*     code  returned: n normal, r reverse, u underline, x reverse and underline
*
*   Only reverse video and underline are used, so every style reads on a monochrome terminal.
*   A colour theme changes this table and $sl_sgr, nothing else.  'disabled' is the same as
*   'normal' for now (a monochrome terminal has no dim); a widget shows a disabled item with its
*   label in brackets.  An unknown name gives n.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_attr(name, code)
$catalog $sl_attr

   begin case
      case name = 'highlight' ; code = 'r'
      case name = 'bar' ; code = 'r'
      case name = 'barsel' ; code = 'n'
      case name = 'hotkey' ; code = 'u'
      case name = 'hotkey.bar' ; code = 'x'
      case name = 'field' ; code = 'u'
      case name = 'reverse' ; code = 'r'
      case name = 'underline' ; code = 'u'
      case len(name) = 1 and index('nrux', name, 1) ; code = name
      case 1 ; code = 'n'
   end case

   return
end

* END-CODE
