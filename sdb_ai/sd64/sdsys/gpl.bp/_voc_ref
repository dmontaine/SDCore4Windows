$internal
$no.symbols
$no.xref
$recursive

subroutine voc_ref(filename, is.dict, pathname, vflags)

$include syscom.h
$include err.h
$include int$keys.h
$include keys.h

   deffun is_grp_member(user,group) calling '!is_grp_member'

* 13 Oct 26 dm - S.63, second sitting (owner: "try to make tighter ... q pointers should only be allowed into an
*   account the user can logto in any case").  A VOC pointer is a way to name a file, and the first S.63 left
*   it open: an account without OS.EXECUTE could write an F-pointer in its own VOC, or make one with
*   CREATE.FILE ... PATHNAME, naming any directory the Linux user may read, and open it as an SD file.
*   Two rules now, for everybody but the administrator:
*     1. A Q-pointer into a REGISTERED account is followed only if the user could LOGTO that account (a member
*        of its group, not suspended - LOGTO's own test), whether or not the account holds OS.EXECUTE.  A Q-
*        pointer that names a path is an OS path, and the OS gate asks (inside the account, or os-on).
*     2. The file an F-pointer finally names must be inside the account's own directory, or inside the
*        directory of an account a Q-pointer was followed into (rule 1), or hold os-on, or be what the
*        STOCK VOC says: the record of the same id in SDSYS's NEWVOC names the same path.  The stock
*        pointers ($map, syscom, sd.voclib, dict.dict, voc, newvoc, $acc) and the stock Q-pointers
*        (sd.accounts, which leads into SDSYS - an account nobody may LOGTO - and md) need this last clause.
*   Refusal is ER$PERM, 3035, as for OPENSEQ.
   vr.admin = kernel(K$ADMINISTRATOR, -1)
   vr.free = vr.admin or kernel(K$OS.EXEC, -1)      ;* SDSYS, or an account that holds os-on
   qroot = ''                                       ;* the directory of an account a Q-pointer was followed into
   cur.id = ''
   f.raw = ''

   vflags = ''     ;* Field 6 of the F-type entry that names the file, upper case (open_file() in op_dio1.c)
   voc.id = field(filename, ',', 1)
   component = field(filename, ',', 2)

   if is.dict then
      fno = 3
   end else if voc.id[1,5] = 'DICT ' then
      voc.id = voc.id[6,9999]
      component = ''            ;* 0517
      fno = 3
   end else
      fno = 2
   end

   pathname = ""
   dir = @path
   qpath = ''

   * If we end up following Q-pointer A that turns out to be a link to a
   * multifile B, a file name of the form A,X must open part X whereas a
   * filename that is simply A must open A,B (not A,A). To do this, set
   * qfile to be the initial VOC name (in this example A) so that the
   * multifile name is in the same variable as it will be if we go round
   * the Q-pointer path.

   qfile = voc.id

* 18 Aug 26 Windows port - THE NAME FOLD REACHES THE BASIC OPEN STATEMENT HERE,
*   AND NOWHERE ELSE.  PROJECT_STATUS.md 5.12.  This subroutine is pcode_voc_ref,
*   which get_voc_file_reference (op_dio1.c:481) recurses into, so it resolves the
*   name for every OPEN (op_dio1.c:624) and for op_seqio.c:193 and :453.  It was
*   not among the 36 files the 74-site fold changed, and it had no fold at all -
*   one exact-match read, then the special syntax below.
*
*   THAT IS WHY THE 74 SITES WORK: they try the string in three cases and pass
*   each one down to an exact-match read HERE.  Anything opening a HARD-CODED
*   LITERAL got no fold, so renaming a VOC id would have broken every
*   open "$SAVEDLISTS" in SAVELST, GETLIST, DELLIST, LSTMRG, COPYLST, SAVESTK,
*   CLEANAC, UPDREC and the three _ recursives.
*
*   MEASURED BEFORE THE CHANGE, on the 18:54:10 install: a file whose VOC id is
*   'zzprobe1' could not be opened as 'ZZPROBE1' from BASIC, while COUNT ZZPROBE1
*   found it.  Additive, for the same reason the original fold was - every id on
*   today's tree is upper case, so the downcase attempt cannot hit, and the
*   upcase attempt only turns a lookup that fails today into one that succeeds.
*
*   A FLAG AND A GOTO, NOT A NESTED BLOCK, so the special syntax below keeps its
*   indentation and its meaning.  PARSER's keyword read was converted the same way
*   for the same reason (5.12, "BY HAND").  The goto goes to the label the
*   successful read falls into anyway, and this file already jumps to it from
*   inside the case statement below.
*
*   AS TYPED KEEPS ITS PRIORITY.  The fold is INSIDE the else, so a VOC record
*   that matches exactly still wins, and the PATH: / Account:File syntax is still
*   reached only when no VOC record answers in any case.
   read voc.rec from voc,voc.id else
      fold.found = @false

      read voc.rec from voc,downcase(voc.id) then
         voc.id = downcase(voc.id)
         fold.found = @true
      end else
         read voc.rec from voc,upcase(voc.id) then
            voc.id = upcase(voc.id)
            fold.found = @true
         end
      end

      if fold.found then
         * qfile is the multifile component default (see below) and was set from
         * the name as typed, so it has to move to the name that actually matched.
         qfile = voc.id
         goto parse.as.q.pointer
      end

      * We haven't found the item as a VOC entry. Is it a special syntax for
      * a remote file or a pathname

      n = dcount(voc.id, ':')
      if n > 1 then
         rules = config('FILERULE')
         x1 = field(voc.id, ':', 1)
         begin case
            case upcase(x1) = 'PATH'   ;* Could be a pathname
               if bitand(rules, 4) then
                  pathname = field(voc.id, ':', 2, 99) ;* Must allow PATH:C:/a/b
* 13 Oct 26 dm - the administrator who turned this form on (FILERULE) did not turn off the OS gate: a path
*   outside the account is still os-on's.
                  if not(vr.free) and not(kernel(K$PATH.OK, pathname)) then
                     pathname = ''
                     set.status ER$PERM
                     return
                  end
                  set.status 0
                  return
               end
            case n = 2                 ;* Account:File
               if bitand(rules, 1) then
                  voc.rec = 'Q':@fm:x1:@fm:field(voc.id, ':', 2)
                  goto parse.as.q.pointer
               end
            case n = 3                 ;* System:Account:File
               if bitand(rules, 2) then
                  voc.rec = 'Q':@fm:field(voc.id, ':', 2):@fm:field(voc.id, ':', 3):@fm:x1
                  goto parse.as.q.pointer
               end
         end case
      end

      set.status ER$NVR
      return
   end

parse.as.q.pointer:
   for depth = 1 to 10
      type = upcase(voc.rec[1,1])
      cur.id = if depth = 1 then voc.id else qfile        ;* the id of the VOC record being read, for the stock test
      begin case
         case type = "F"
            pathname = voc.rec<fno>
            f.raw = pathname                                ;* as written, before @SDSYS and the like are expanded
            vflags = upcase(voc.rec<6>)

            if fno = 2 then
               if voc.rec<4> # '' then   ;* It's a multifile
                  * If the filename does not include a component subfile
                  * name, use the filename as the default.

                  if component = '' then component = qfile

                  * Try to find this component

                  locate component in voc.rec<4,1> setting pos else
                     set.status ER$CNF  ;* No reference to this component
                     return
                  end
                  pathname = pathname<1,pos>
               end else                    ;* It's a simple file
                  if component # '' then   ;* 0376 Fail open if subfile given
                     set.status ER$VNF
                     return
                  end
               end
            end

            if pathname = "" then
               set.status ER$NPN  ;* No pathname
               return
            end

            if pathname[1,1] = '@' then pathname = parse.pathname.tokens(pathname)

            * Make pathname absolute
* 20240121 mab use @VM not hard coded hex fd 
            if not(pathname matches "'":@ds:"'0X":@VM:"1A':\'0X") then
               pathname = dir : @ds : pathname
            end

            * If we got here by following a Q-pointer, we need to convert a
            * relative pathname to absolute form.

            if qpath # '' then
               qfile = voc.rec<fno>
						if qfile[1,1] # @ds then
							* Convert voc item to absolute path
							qfile = qpath : @ds : qfile
						end
            end

* 13 Oct 26 dm - second sitting: where the file finally is.  See the note at the top.
            if not(vr.free) then
               gosub check.f.path
               if not(path.ok) then
                  pathname = ''
                  set.status ER$PERM
                  return
               end
            end

            set.status 0
            return

         case type = "Q"
            if index(voc.rec<3>, ',', 1) and component = '' then
               component = field(voc.rec<3>, ',', 2)
               voc.rec<3> = field(voc.rec<3>, ',', 1)
            end

            pathname = voc.rec<4>
            if pathname # '' then       ;* Networked file definition
               pathname := ';':voc.rec<2>:';'
               if fno = 3 then pathname := 'DICT '
               pathname := voc.rec<3>
               set.status 0
               return
            end

            qpath = voc.rec<2>
            q.named = qpath                    ;* as the pointer wrote it
            q.registered = @false
            q.group = ''
            q.susp = ''
            if qpath = '' then
               * A null account name means use the current account.
               * If this is the entry in a chain of Q-pointers, use the
               * originating account's VOC. If we are part way down the
               * chain, we need to use the last VOC we accessed.

               if unassigned(qvoc) then qvoc = voc
            end else
               if index(qpath, @ds, 1) = 0 then  ;* Try lookup in ACCOUNTS file
                  if len(qpath) < 64 then
                     openpath @sdsys:@ds:'accounts' to acc.f then
                        read acc.rec from acc.f, qpath then
                           qpath = acc.rec<ACC$PATH>
                           q.registered = @true
                           q.group = acc.rec<ACC$GROUP>
                           q.susp = acc.rec<ACC$SUSPENDED>
                        end
                     end
                  end
               end

               if qpath[1,1] = '@' then qpath = parse.pathname.tokens(qpath)

               if len(qpath) = 0 then
                  set.status ER$NPN
                  return
               end

* 13 Oct 26 dm - second sitting: only into an account the user could LOGTO (see the note at the top).
               if not(vr.admin) then
                  gosub check.q.hop
                  if not(q.ok) then
                     set.status ER$PERM
                     return
                  end
               end
               if qpath[1,1] = @ds then qroot = qpath

               * Open target VOC file

               dir = qpath
               openpath qpath:@ds:'voc' to qvoc else
                  set.status ER$VNF
                  return
               end
            end
   
            qfile = voc.rec<3>

            * 18 Oct 26 Windows port - from Linux 778b4d9 (12 Oct 26): - openQM 435: a Q-pointer with no file name points at the VOC of that account
            if len(qfile) = 0 then qfile = 'VOC'

            if len(qfile) = 0 then
               set.status ER$NPN
               return
            end

            * Read the target record

* 18 Aug 26 Windows port - the same fold on the Q-pointer target, so a Q-pointer
*   naming a file that has since been renamed to lower case still resolves.
            read voc.rec from qvoc, qfile else
               read voc.rec from qvoc, downcase(qfile) then
                  qfile = downcase(qfile)
               end else
                  read voc.rec from qvoc, upcase(qfile) then
                     qfile = upcase(qfile)
                  end else
                     set.status ER$NVR
                     return
                  end
               end
            end

            * Do not close the remote VOC as we may need it for a subsequent
            * chained Q-pointer that has field 2 null.

         case 1
            set.status ER$VNF
            return
      end case
   next depth

   set.status ER$VNF

   return

* ----------------------------------------------------------------------------------------------------------
* 13 Oct 26 dm - second sitting.  The stock VOC is the allow-list: the record of the same id in SDSYS's NEWVOC.
* Read each time it is needed, which is only for a pointer that leads outside the account.
stock.record:
   stock.found = @false
   stock.rec = ''
   if cur.id # '' then
      openpath @sdsys:@ds:'newvoc' to stock.f then
         read stock.rec from stock.f, downcase(cur.id) then
            stock.found = @true
         end
         close stock.f
      end
   end
   return

* May a restricted account use the file this F-pointer names (pathname, absolute; f.raw as written)?
check.f.path:
   path.ok = kernel(K$PATH.OK, pathname)            ;* inside the account's own directory
   if not(path.ok) and qroot # '' then
      path.ok = kernel(K$PATH.IN, qroot : @fm : pathname)   ;* inside the directory of an account it may enter
   end
   if not(path.ok) then
      gosub stock.record
      if stock.found then
         if upcase(stock.rec[1,1]) = 'F' and stock.rec<fno> = f.raw then
            path.ok = @true
         end
      end
   end
   return

* May a restricted account follow this Q-pointer?  q.named is what the pointer wrote, qpath where it leads.
check.q.hop:
   q.ok = @false
   gosub stock.record
   if stock.found and upcase(stock.rec[1,1]) = 'Q' and stock.rec<2> = q.named and stock.rec<3> = voc.rec<3> then
      q.ok = @true                                  ;* a stock pointer: sd.accounts into SDSYS, md
   end else
      if q.registered then
         * LOGTO's own test: not suspended, and a member of the account's group.  This is asked of an account that
         * holds os-on too: a Q-pointer is not an OS path, it is a way into an account.
         if upcase(trim(q.susp)) # 'SUSPENDED' then
            q.ok = is_grp_member(@logname, q.group)
         end
      end else
         * not an account: a path, or a name that is no account (taken relative to the account's own directory).
         * That is an OS path, and the OS gate's question.
         q.ok = vr.free or kernel(K$PATH.OK, qpath)
      end
   end
   return
end

* END-CODE
