* START-DESCRIPTION:
*
*   SELECT.DIR pathname {TO n}
*
* Builds a select list (0 unless TO gives another) of the names of the files
* and subdirectories in an operating system directory.  The names are as the
* operating system has them, in the order it returns them.  The directory
* is read at the access of the user, like any other file.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $select.dir
$catalog $seldir

$include err.h
$include keys.h
$include int$keys.h
$include parser.h
$include syscom.h

   parser = "!PARSER"

   @system.return.code = -ER$ARGS      ;* Preset for command format errors

   list.no = 0

   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb

   * The directory pathname

   call @parser(PARSER$GET.TOKEN, token.type, path, keyword)
   if token.type = PARSER$END or path = '' then
      stop sysmsg(12055) ;* Directory pathname required
   end

   * TO n

   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   if keyword = KW$TO then
      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
      if (token.type = PARSER$END) or not(num(token)) then
         stop sysmsg(3271) ;* Select list number missing or invalid
      end
      list.no = token + 0
      if list.no > HIGH.USER.SELECT then
         stop sysmsg(3271) ;* Select list number missing or invalid
      end
      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   end

   if token.type # PARSER$END then
      stop sysmsg(2018, token) ;* Unexpected token (xx)
   end

   * 13 Oct 26 dm - S.63.  A directory outside the account is an OS directory the account has not been given.
   *   The administrator and an account SDSYS gave OS-ON pass; anyone else lists only its own directory.

   if not(kernel(K$PATH.OK, path)) then
      @system.return.code = -ER$PERM
      stop sysmsg(12185, @who) ;* %1 has no OS access, so a file or directory outside its own account cannot be reached
   end

   * DIR() returns one field for each entry: the name, then a value mark and
   * F or D for a file or a directory.

   entries = dir(path)
   if entries = '' and status() # 0 then
      @system.return.code = -status()
      stop sysmsg(12056, path) ;* Cannot read directory xx
   end

   names = ''
   n = 0
   if entries # '' then
      for i = 1 to dcount(entries, @fm)
         names<-1> = entries<i,1>
         n += 1
      next i
   end

   formlist names to list.no
   @system.return.code = n
   display sysmsg(3261, n, list.no) ;* xx records selected to select list xx

   return
end

* END-CODE
