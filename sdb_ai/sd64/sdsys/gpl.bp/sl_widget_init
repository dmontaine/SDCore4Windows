* 22 Oct 26 dm  selector (S.75, TK-0.10).
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $sl_widget_init(w)
*
*   w is a widget collection of a form.  Its size, mnemonic and the like are worked out again from its
*   text and items by the widget's own init, which keeps the values the program or the user set.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_widget_init(w)
$catalog $sl_widget_init

   wt = w{'type'}
   begin case
      case wt = 'entry' ; call $sl_entry('init', w, '', '', r)
      case wt = 'list' ; call $sl_list('init', w, '', '', r)
      case wt = 'check' ; call $sl_check('init', w, '', '', r)
      case wt = 'slider' ; call $sl_slider('init', w, '', '', r)
      case wt = 'selector' ; call $sl_selector('init', w, '', '', r)
      case wt = 'radio' ; call $sl_radio('init', w, '', '', r)
      case wt = 'button' ; call $sl_button('init', w, '', '', r)
      case wt = 'label' ; call $sl_label('init', w, '', '', r)
      case wt = 'combo' ; call $sl_combo('init', w, '', '', r)
      case wt = 'progress' ; call $sl_progress('init', w, '', '', r)
      case wt = 'tabs' ; call $sl_tabs('init', w, '', '', r)
      case wt = 'memo' ; call $sl_memo('init', w, '', '', r)
      case wt = 'table' ; call $sl_table('init', w, '', '', r)
      case wt = 'tree' ; call $sl_tree('init', w, '', '', r)
      case wt = 'scroll' ; call $sl_scroll('init', w, '', '', r)
      case wt = 'container' or wt = 'viewport' ; call $sl_viewport('init', w, '', '', r)
   end case

   return
end

* END-CODE
