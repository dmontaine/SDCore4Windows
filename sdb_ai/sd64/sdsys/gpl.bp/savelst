*
*
* START-DESCRIPTION:
*
*    SAVE.LIST [list.name] [FROM list.number]
*
* list.name   = name under which to save. Defaults to list.number
*
* list.number = list to save. Defaults to 0.
*
* @SYSTEM.RETURN.CODE
*    +ve Successful - number of items saved
*    -ve Error code
*
* END-DESCRIPTION
*
* START-CODE


$internal
program $savelist
$catalog $SAVELST

$include err.h
$include keys.h

$include syscom.h
$include parser.h

deffun edit_guard(f) calling '!edit_guard'   ;* 17 Oct 26 dm, S.64 part 2


   parser = "!PARSER"

   @system.return.code = -ER$ARGS   ;* Preset for command format errors

* ---------------  Step 1 -  Parse the command

   list.no = 0
   list.name = ""

   call @parser(parser$reset, 0, @sentence, 0)
   call @parser(parser$get.token, token.type, token, keyword) ;* Verb

   * Get list name.  It may be left out (10 Oct 26 dm, openQM ref 401): the
   * list is then saved under its list number.

   keep = @false
   count.sup = @false
   list.name = ''

   call @parser(parser$get.token, token.type, token, keyword)
   saved.name = '$savedlists'     ;* 12 Oct 26 dm - openQM 494: IN file names another file of saved lists
   if token.type # PARSER$END and keyword # KW$FROM and keyword # KW$KEEP and keyword # KW$COUNT.SUP and upcase(token) # 'IN' then
      list.name = token
      call @parser(parser$get.token, token.type, token, keyword)
   end

   * Then FROM n, KEEP and COUNT.SUP in any order

   loop
   until token.type = PARSER$END
      begin case
         case keyword = KW$FROM
            call @parser(parser$get.token, token.type, token, keyword)
            if (token.type = PARSER$END) or not(num(token)) then
               stop sysmsg(3271) ;* Select list number missing or invalid
            end

            list.no = token + 0
            if list.no > HIGH.USER.SELECT then
               stop sysmsg(3271) ;* Select list number missing or invalid
            end

         case keyword = KW$KEEP        ;* Leave the active list as it is (ref 387)
            keep = @true

         case upcase(token) = 'IN'     ;* 12 Oct 26 dm - openQM 494
            call @parser(parser$get.token, token.type, saved.name, keyword)
            if token.type = PARSER$END or saved.name = '' then stop sysmsg(12082) ;* Saved lists file name required after IN

         case keyword = KW$COUNT.SUP   ;* No count of the records (ref 2)
            count.sup = @true

         case 1
            stop sysmsg(2018, token) ;* Unexpected token (xx)
      end case
      call @parser(parser$get.token, token.type, token, keyword)
   repeat

   * Use default list name if not supplied

   if list.name = '' then list.name = list.no :  ""

   if not(selectinfo(list.no, SL$ACTIVE)) then
      stop sysmsg(3260, list.no) ;* Select list xx is not active
   end

* ---------------  Step 2 -  Create the save list file if necessary

   open saved.name to saved.lists.file else
      @system.return.code = -status()

      if saved.name # '$savedlists' then stop sysmsg(3248, status()) ;* Error xx opening the file named by IN

      if status() # ER$NVR then
         stop sysmsg(3248, status()) ;* Error xx opening $savedlists
      end

*  18 Aug 26 Windows port - $svlists lower case on disk, PROJECT_STATUS.md
*  5.12 (a), and the VOC id is $savedlists as of 5.12 (b).  This is the
*  fallback that runs when the account has no $savedlists VOC entry; CREATEA
*  names it the same way.  NO MIGRATION: an account created before the rename
*  holds $SAVEDLISTS and the open above still finds it, because _VOC_REF folds
*  UP as well as down.
      create.file "$svlists" dynamic on error
         stop sysmsg(3249, status()) ;* Error xx creating $savedlists
      end

      voc.rec = "F" : @fm : "$svlists"
      recordlocku @voc, "$savedlists"
      write voc.rec to @voc, "$savedlists"

      display sysmsg(3250) ;* Created $savedlists

      open "$savedlists" to saved.lists.file else
         stop sysmsg(3248, status()) ;* Error xx opening $savedlists
      end
   end

* 17 Oct 26 dm - S.64 part 2: IN names any file, and this program is $internal, so the kernel's own test lets its WRITE through.  It asks
*   about the file opened, before READLIST takes the list, so a refusal leaves the active select list as it was.  The default $savedlists
*   (and the pointer made for it above, which is the sanctioned side effect) is none of the three guarded kinds.
   if not(edit_guard(saved.lists.file)) then
      @system.return.code = -ER$PERM
      stop
   end

* ---------------  Step 3 -  Save the select list

   readlist list.rec from list.no else null

   recordlocku saved.lists.file, list.name
   write list.rec to saved.lists.file, list.name on error
      @system.return.code = -status()
      stop sysmsg(3272, status()) ;* Error xx writing saved list record
   end

   * KEEP: READLIST emptied the active list, so put it back

   if keep then formlist list.rec to list.no

   num.items = dcount(list.rec, @fm)
   if not(count.sup) then display sysmsg(3266, num.items, list.name) ;* xx records saved to select list 'xx'

   @system.return.code = num.items

   return
end

* END-CODE
