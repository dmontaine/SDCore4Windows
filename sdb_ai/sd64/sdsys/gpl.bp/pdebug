* START-CODE

$internal
program pdebug
$catalog $pdebug

$include syscom.h
$include debug.h
$include int$keys.h

   if @tty = 'phantom' or @tty = 'vbsrvr' then
      stop sysmsg(1306) ;* Phantom debugger can only be executed from an interactive session
   end

   * The conversation with the phantom is kept in this user's private store, not in $IPC (W.11 F10b)

   call !pdbg_store(dbg.store, store.why)
   if store.why # '' then stop sysmsg(12953, store.why)

   break off

   in.id = 'D.':@userno
   out.id = 'DR.':@userno

   * The store outlives an SD restart: a record left under this user number by an earlier PDEBUG that was killed must not be taken for the phantom's first message

   recordlocku dbg.store, in.id
   delete dbg.store, in.id
   recordlocku dbg.store, out.id
   delete dbg.store, out.id

   start.id = 'DR.':@who:'!':@logname
   recordlocku dbg.store, start.id
   out.msg = 'START'
   out.msg<2> = @userno
   write out.msg to dbg.store, start.id

   * If the user has supplied anything more than just the verb, treat this
   * as a PHANTOM command.

   if index(trim(@sentence), ' ', 1) then
      execute 'PHANTOM ' : trimf(field(@sentence, ' ', 2, 99999))
      if @system.return.code < 0 then goto abort.pdebug.startup
   end

   display sysmsg(1303) ;* Waiting for phantom process to activate debugger (Q to quit)
   loop
      read in.msg from dbg.store, in.id then exit
      pause 1
      if keyready() then
         if upcase(keyin()) = 'Q' then
            msg = sysmsg(1304) ;* Phantom debugger terminated
            goto abort.pdebug.startup
         end
      end
   repeat

   display @(-1) :

   debugger.uid = 0
   loop
      * Read incoming message from process being debugged

      loop
         readu in.msg from dbg.store, in.id then exit
         release dbg.store, in.id
         pause 2
         if debugger.uid then
            if kernel(K$USERS, debugger.uid) = '' then
               msg = sysmsg(1305) ;* Debugged process has terminated
               goto exit.pdebug
            end
         end
      repeat
      delete dbg.store, in.id

      prog.id = in.msg<2>
      dtm = in.msg<3>
      line = in.msg<4>
      sub.ref = in.msg<5>
      event = bitor(in.msg<6>, 0x80000000)
      debugger.uid = in.msg<7>
      call $debug(prog.id, dtm, line, sub.ref, event)

      * Send response back to debugged process

      recordlocku dbg.store, out.id
      write 'DBG' to dbg.store, out.id
      wake debugger.uid
   repeat


abort.pdebug.startup:
   recordlocku dbg.store, start.id
   delete dbg.store, start.id

exit.pdebug:
   break on
   stop msg
end

* END-CODE
