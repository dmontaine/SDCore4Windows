* UPGRADE_NOCASE
* RELEASE_1.1 5 D2.  Convert an upgraded machine's existing hashed files to
* case insensitive ids, so the owner's ruling - no two record ids may differ
* only by case, anywhere - holds on a machine that predates the change.
*
* A FRESH install already makes every file NOCASE (gplsrc/op_dio1.c), so this
* is the UPGRADE path only.  An upgrade preserves each account's data files,
* which were built case sensitive, so each must be converted with the same
* rebuild CONFIGURE.FILE uses.
*
* ***SAFETY: A SCAN PHASE FIRST.  NOTHING IS REBUILT UNTIL IT IS PROVEN CLEAN.***
* Owner's instruction, 14 Sep 2026: pre-check and warn if potential duplicates
* are found.  Phase 1 opens every file read only and looks for a fold-pair -
* two ids differing only by case.  A file that HOLDS such a pair is NOT
* converted (a rebuild to NOCASE would keep only one - the loss this whole
* change exists to prevent); it is named in a warning for the administrator to
* resolve by hand and convert with CONFIGURE.FILE.  Only files proven to hold
* no pair are rebuilt in phase 2, so a conversion can never lose a record.
*
* RUN gpl.bp UPGRADE_NOCASE          scan and convert the clean files
* RUN gpl.bp UPGRADE_NOCASE CHECK    scan and report only; convert nothing
*
* It runs as sd -internal in SDSYS (upgrade-nocase.ps1), walking the account
* register by path.  It never LOGTOs another account: a file is opened by its
* pathname, converted, and swapped, exactly as CONFIGURE.FILE's convert.file
* does - which is why converting a VOC nobody is logged into is safe, and why
* SDSYS's OWN live VOC is deliberately left (converting the VOC this session is
* running from is not safe; it holds only shipped lower-case ids, so it has no
* pair, and the lookup fold serves it).
*
* START-HISTORY:
* 14 Sep 26 Windows port - three defects its first measuring run and a reading
*           found: select lists 13-15 are out of range (0-12), so the walk
*           stopped on its first file; old.path was read in phase 1 before
*           phase 2 set it; and SDSYS's live VOC was queued through its own
*           'voc' F-record.  verify-nocaseupgrade.ps1 is the witness.
* 14 Sep 26 Windows port - RELEASE_1.1 5 D2, new program.
* END-HISTORY

program UPGRADE_NOCASE
$internal
$include int$keys.h
$include keys.h
$include err.h
* parse.pathname.tokens is declared by keys.h; do not redeclare it.

   twin.list.cap = 200             ;* cap the warning list; the count stays exact

   * CHECK anywhere on the command line means scan and report only, convert
   * nothing.  @sentence is the whole line ("RUN gpl.bp UPGRADE_NOCASE ..."),
   * so a token test, not a fixed field position.  The installer's driver runs
   * it without CHECK, so it converts; CHECK is for a dry run by hand.
   check.only = @false
   if index(' ' : upcase(@sentence) : ' ', ' CHECK ', 1) then check.only = @true

   crt sysmsg(10180)               ;* Checking every file for ids that differ only by case...

   scanned = 0                     ;* DH files examined
   converted = 0                   ;* rebuilt to NOCASE
   already = 0                     ;* already NOCASE, left as they are
   twin.count = 0                  ;* files holding a fold-pair, NOT converted
   dup.total = 0                   ;* duplicate record ids across all those files
   twin.files = ''                 ;* @fm: one path per file that has a pair
   twin.dups  = ''                 ;* @fm parallel: that file's pairs, @vm joined
   ak.skipped = 0                  ;* AK files left for manual CONFIGURE.FILE
   err.count = 0                   ;* files that could not be read or rebuilt

   * SDSYS's own data files (its VOC's F-records), but NOT its live VOC.
   gosub do.account

   openpath @sdsys:@ds:'accounts' to acc.f then
      select acc.f to 12
      loop
         readnext reg.name from 12 else exit
         read acc.rec from acc.f, reg.name then
            acc.path = parse.pathname.tokens(acc.rec<ACC$PATH>)
            if acc.path # '' then
               * SDSYS is detected by its register NAME, not by comparing
               * paths - a path spelling that did not match would send the
               * walk into converting SDSYS's OWN live VOC, which is the one
               * file this must never rebuild.  SDSYS's data files were already
               * done by the explicit gosub do.account above, so its register
               * entry is skipped entirely here.
               if upcase(reg.name) # 'SDSYS' then
                  this.acct = acc.path
                  this.is.sdsys = @false
                  gosub do.account.at
               end
            end
         end
      repeat
      close acc.f
   end else
      crt sysmsg(2200)             ;* Cannot open accounts register
   end

   * ---- report -----------------------------------------------------------
   * File name, then every duplicate record id in it, so an administrator can
   * find and resolve each one.  This is the "report" the pre-check produces;
   * upgrade-nocase.ps1 captures it to a log the installer leaves behind.
   crt
   if twin.count then
      crt sysmsg(10178, twin.count, dup.total)   ;* WARNING: %1 file(s) hold %2 record id(s) that differ only by case. They were NOT converted:
      nfiles = dcount(twin.files, @fm)
      for i = 1 to nfiles
         crt sysmsg(10184, twin.files<i>)        ;* File: %1
         pairs = twin.dups<i>
         np = dcount(pairs, @vm)
         for j = 1 to np
            crt '      ' : pairs<1, j>           ;* "id-one / id-other"
         next j
      next i
      crt sysmsg(10181)            ;* Rename or delete one id of each pair, then convert that file with CONFIGURE.FILE NO.CASE.
   end
   if check.only then
      crt sysmsg(10182, scanned, twin.count)   ;* Checked %1 file(s); %2 hold a case-only duplicate record id.
   end else
      crt sysmsg(10179, converted, scanned)    ;* Converted %1 of %2 file(s) to case insensitive ids.
   end
   if ak.skipped then crt sysmsg(10186, ak.skipped)  ;* %1 indexed file(s) were left for manual CONFIGURE.FILE; see above.
   if err.count then crt sysmsg(10183, err.count)  ;* %1 file(s) could not be read or rebuilt; see above.
   crt 'COMPLETE'
   stop

* ==========================================================================
* do.account - SDSYS's own files.  @sdsys is the current account, so its live
*   VOC is left; its data files (dictionaries and the register files named as
*   F-records in its VOC) are converted by path like any other.
do.account:
   this.acct = @sdsys
   this.is.sdsys = @true
   gosub do.account.at
   return

* do.account.at - convert every data/dict file named by this.acct's VOC, then
*   (unless this.acct is SDSYS) the VOC itself.  this.acct is the account path;
*   this.is.sdsys says whether its VOC is the live one.
do.account.at:
   file.list = ''
   openpath this.acct:@ds:'voc' to acct.voc then
* 14 Sep 26 - LIST 11, NOT 13.  Select lists run 0 to 12 (HIGH_SELECT,
*   gplsrc/sd.h:43), and 11-12 only in an $internal program; 13, 14 and 15
*   stopped the walk with 1118 "Select list number out of range" on its first
*   file (verify-nocaseupgrade, its first measuring run).  The register walk
*   holds 12 for its whole loop, so every inner list here is 11, used one after
*   another: this one is exhausted before any file is converted.
      select acct.voc to 11
      loop
         readnext vid from 11 else exit
         read vrec from acct.voc, vid then
            if upcase(vrec[1,1]) = 'F' then
               gosub add.file
               if vrec<3> # '' and vrec<3> # vrec<2> then gosub add.file.dict
            end
         end
      repeat
      close acct.voc
   end else
      return                       ;* no VOC at this path; nothing to do
   end

   nf = dcount(file.list, @fm)
   for fi = 1 to nf
      one.path = file.list<fi>
      gosub convert.one
   next fi

   * the VOC last, and only when it is not the session's own
   if not(this.is.sdsys) then
      one.path = this.acct:@ds:'voc'
      gosub convert.one
   end
   return

* add.file / add.file.dict - resolve an F-record path (field 2 / field 3) to an
*   absolute pathname and add it to file.list.  A bare name is relative to the
*   account; @SDSYS and the like are expanded by parse.pathname.tokens.
add.file:
   raw = vrec<2>
   gosub resolve.path
   if resolved # '' then file.list<-1> = resolved
   return
add.file.dict:
   raw = vrec<3>
   gosub resolve.path
   if resolved # '' then file.list<-1> = resolved
   return

resolve.path:
   resolved = ''
   if raw = '' then return
   if index(raw, '@', 1) then
      resolved = parse.pathname.tokens(raw)
   end else if raw[1,1] = @ds or index(raw, ':', 1) = 2 then
      resolved = raw               ;* already absolute
   end else
      resolved = this.acct:@ds:raw ;* relative to the account
   end
   return

* ==========================================================================
* convert.one - convert the DH file at one.path to NOCASE, if it needs it and
*   is safe.  Scans for a fold-pair first (phase 1); converts only when clean
*   (phase 2, unless check.only).  Never loses a record: the original is
*   deleted only after a full copy and rename succeed.
convert.one:
   openpath one.path to old.fu else return    ;* not a file we can open; skip
   ftype = fileinfo(old.fu, FL$TYPE)
   if ftype # FL$TYPE.DH then
      close old.fu
      return                       ;* directory files fold on NTFS already
   end
* 14 Sep 26 - old.path IS SET HERE, BEFORE PHASE 1 USES IT.  It was first
*   assigned in phase 2, so phase 1's probe path read an unassigned variable
*   on the first file and the previous file's path on every later one.
   old.path = fileinfo(old.fu, FL$PATH)
* 14 Sep 26 - AND THE SESSION'S OWN LIVE VOC IS NEVER REBUILT, however it was
*   queued.  do.account skips it by design, but SDSYS's VOC holds an F-record
*   'voc' naming itself (voc_template/voc), so add.file queued it anyway.  The
*   test is on the opened file's path, not on how the path was spelled.
   if upcase(old.path) = upcase(fileinfo(@voc, FL$PATH)) then
      close old.fu
      return
   end
   scanned += 1

   if bitand(fileinfo(old.fu, FL$FLAGS), FL$FLAGS.NOCASE) then
      already += 1
      close old.fu
      return
   end

   * ---- phase 1: scan for EVERY fold-pair, read only ----------------------
   * A temporary case-INSENSITIVE probe file does the duplicate detection with
   * the hash, so this is O(records), not O(records squared): each id is read
   * from the probe (which folds), and a hit whose stored spelling differs is a
   * duplicate.  Every duplicate is recorded, so the report names each one, not
   * only the first.  Record ids only - readnext returns keys, never field
   * data.  The probe holds one record per distinct id and is deleted here.
   dups = ''                       ;* @vm: "spelling-one / spelling-other"
   scan.dir = field(old.path, @ds, 1, dcount(old.path, @ds) - 1)
   scan.path = scan.dir : @ds : '~SDSCAN.' : @userno
   openpath scan.path to scan.fu then
      close scan.fu
      void ospath(scan.path, OS$DELETE)
   end
   create.file scan.path dynamic flags FL$FLAGS.NOCASE on error null
   openpath scan.path to scan.fu else
      crt sysmsg(6170) : ' (' : scan.path : ')'
      close old.fu
      err.count += 1
      return
   end
   select old.fu to 11             ;* 11, not 14 - see do.account.at
   loop
      readnext sid from 11 else exit
      read prev.spelling from scan.fu, sid then
         if prev.spelling # sid then
            dups<1, -1> = prev.spelling : ' / ' : sid
            dup.total += 1
         end
      end else
         write sid to scan.fu, sid   ;* store the first spelling under its folded key
      end
   repeat
   clearselect 11
   close scan.fu
   void ospath(scan.path, OS$DELETE)

   if dups # '' then
      twin.count += 1
      if dcount(twin.files, @fm) < twin.list.cap then
         twin.files<-1> = one.path
         twin.dups<-1>  = dups
      end
      close old.fu
      return                       ;* leave it exactly as it is
   end

   * A file with alternate key indices is NOT rebuilt here.  Recreating an AK
   * by path needs a BUILD.INDEX that resolves the file in the current
   * account's VOC, which this by-path walk cannot do; a half-built index is
   * worse than none.  So it is reported for the administrator to convert with
   * CONFIGURE.FILE (which rebuilds AKs correctly), and left case sensitive -
   * the lookup fold still serves it, and its ids were proven clean above.
   if fileinfo(old.fu, FL$AK) then
      ak.skipped += 1
      crt sysmsg(10185, one.path)   ;* File has indices; convert it with CONFIGURE.FILE NO.CASE: %1
      close old.fu
      return
   end

   if check.only then
      close old.fu
      return
   end

   * ---- phase 2: rebuild NOCASE by path (mirrors CONFIGF convert.file) -----
   * Exclusive access, so nothing else is mid-write.  A file in use is left.
   if not(fileinfo(old.fu, FL$EXCLUSIVE)) then
      crt sysmsg(10168, one.path, fileinfo(old.fu, FL$HOLDERS))
      close old.fu
      err.count += 1
      return
   end

   * old.path was set at the top of convert.one (14 Sep 26).
   new.path = field(old.path, @ds, 1, dcount(old.path, @ds) - 1) : @ds : '~SDNOCASE.' : @userno

   openpath new.path to new.fu then
      close new.fu
      if not(ospath(new.path, OS$DELETE)) then
         crt sysmsg(6168) : ' (' : new.path : ')'
         close old.fu
         err.count += 1
         return
      end
   end

   create.file new.path dynamic flags FL$FLAGS.NOCASE on error null
   openpath new.path to new.fu else
      crt sysmsg(6170) : ' (' : new.path : ')'
      close old.fu
      err.count += 1
      return
   end
   filelock new.fu

   copy.failed = @false
   select old.fu to 11             ;* 11, not 15 - see do.account.at
   loop
      readnext cid from 11 else exit
      read crec from old.fu, cid then
         write crec to new.fu, cid
      end else
         copy.failed = @true
         exit
      end
   repeat
   clearselect 11

   if copy.failed then
      close new.fu
      void ospath(new.path, OS$DELETE)
      close old.fu
      crt sysmsg(6171) : ' (' : one.path : ')'
      err.count += 1
      return
   end

   * Carry the trigger across (AK files never reach here - they were reported
   * and skipped above).
   trigger = fileinfo(old.fu, FL$TRIGGER)
   if trigger # '' then
      set.trigger new.fu, trigger, fileinfo(old.fu, FL$TRG.MODES)
   end
   close new.fu
   void ospath('', OS$FLUSH.CACHE)

   close old.fu
   void ospath('', OS$FLUSH.CACHE)

   if not(ospath(old.path, OS$DELETE)) then
      crt sysmsg(6178, status(), os.error()) : ' (' : old.path : ')'
      err.count += 1
      return                       ;* original still in place; new left beside it
   end
   if not(osrename(new.path, old.path)) then
      crt sysmsg(6179, status(), os.error()) : ' (' : new.path : ' -> ' : old.path : ')'
      err.count += 1
      return
   end
   converted += 1
   return

end
