* START-DESCRIPTION:
*
*   call $sl_syndef(op, a, b, ret)
*
*   op 'names'  ret = the names of the languages, field by field
*      'rules'  a = a name; ret = its rules, a line to a field ($sl_syntax says what the rules are)
*
*   The SD BASIC keywords are the compiler's own tables (bcomp: statements, and the intrinsic functions),
*   so a new statement is added in two places.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_syndef(op, a, b, ret)
$catalog $sl_syndef

   ret = ''
   r = ''
   begin case
      case op = 'names'
         ret = 'sd.basic' : @fm : 'c' : @fm : 'json' : @fm : 'markdown' : @fm : 'sh' : @fm : 'python'
      case op = 'rules'
         nm = downcase(trim(a))
         begin case
            case nm = 'sd.basic'
               gosub rules.sd.basic
            case nm = 'c'
               gosub rules.c
            case nm = 'json'
               gosub rules.json
            case nm = 'markdown'
               gosub rules.markdown
            case nm = 'sh'
               gosub rules.sh
            case nm = 'python'
               gosub rules.python
         end case
         ret = r
   end case

   return

rules.sd.basic:
   r<-1> = 'file bp *.bp bp.* *bp syscom'
   r<-1> = 'record *.bp *.bas *.b'
   r<-1> = 'nocase'
   r<-1> = 'ident ._$@'
   r<-1> = 'line comment * bol'
   r<-1> = 'line comment ! bol'
   r<-1> = 'line comment ;*'
   r<-1> = 'line comment ;!'
   r<-1> = 'line comment rem bol whole'
   r<-1> = 'line comment remark bol whole'
   r<-1> = 'line preproc $ bol'
   r<-1> = 'region string " "'
   r<-1> = "region string ' '"
   r<-1> = 'label special'
   r<-1> = 'number constant'
   * the statements (bcomp: statements and non.debug.statements)
   r<-1> = 'words keyword abort begin break call case catch chain clear clearcommon cleardata clearfile clearinput clearselect close'
   r<-1> = 'words keyword closeseq close.socket commit continue convert create create.file crt data debug del delete deletelist'
   r<-1> = 'words keyword deleteseq deleteu dim dimension disinherit display do dparse dparse.csv echo else end enter execute exit'
   r<-1> = 'words keyword file filelock fileunlock find findstr flush footing for formlist getlist go gosub goto heading hush if in'
   r<-1> = 'words keyword include inherit input inputclear inputcsv inputerr inputfield ins keyedit keyexit keytrap local locate'
   r<-1> = 'words keyword lock logmsg loop mark.mapping mat matbuild matparse matread matreadcsv matreadl matreadu matwrite'
   r<-1> = 'words keyword matwriteu nap next nobuf null on open openpath openseq os.execute page pause pdump perform phantom'
   r<-1> = 'words keyword precision print printer printcsv printerr procread procwrite prompt randomize read readblk readcsv readl'
   r<-1> = 'words keyword readlist readnext readseq readu readv readvl readvu recordlockl recordlocku redim redimension release'
   r<-1> = 'words keyword rem remark remove remove.break.handler repeat restore.screen return rollback rqm savelist screen seek'
   r<-1> = 'words keyword select selecte selectindex selectleft selectn selectright selectv sendmail set.arg set.break.handler'
   r<-1> = 'words keyword set.exit.status setleft setnls setpu setright setrem sleep sselect sselectn status stop tclread throw'
   r<-1> = 'words keyword timeout transaction try unlock until void wake weofseq while write writeblk writecsv writeseq writeseqf'
   r<-1> = 'words keyword writeu writev writevu class com common deffun equ equate function get private program public set sub'
   r<-1> = 'words keyword subroutine'
   * the words of the language that are not statements
   r<-1> = 'words keyword then else and or not eq ne lt gt le ge matches match by step to setting from using returning locked'
   r<-1> = 'words keyword error each before after repeat while until do'
   * the intrinsic functions (bcomp: intrinsics)
   r<-1> = 'words type abs abss accept.socket.connection acos adds akmap alpha analyse ands arg arg.count ascii asin assigned atan'
   r<-1> = 'words type bindkey bitand bitnot bitor bitreset bitset bittest bitxor break.count btree catalogued cats caught ccall'
   r<-1> = 'words type change changed char checksum chgphant col1 col2 collection compare config convert cos count counts'
   r<-1> = 'words type create.server.socket crop csvdq date dcount debug.info delete dir div divs downcase dquote dquotes dtx ebcdic'
   r<-1> = 'words type element.exists enumerate env eqs ereplace events exp expand expand.hf extract fcontrol field fields fieldstore'
   r<-1> = 'words type fileinfo find fix fmt fmts fold folds formcsv ges getlocks get.messages getnls get.port.params getpu getrem'
   r<-1> = 'words type grpstat gts iconv iconvs idiv ifs index indexs indices inmat inputblk insert int ismv is.subr itype jboolean'
   r<-1> = 'words type jbuild jnull jparse jtype kernel keycode keyin keyinc keyinr keyready len lens les list.common listindex ln'
   r<-1> = 'words type loaded load.object locate login login.port logout lower lts mat matchfield matstr max maximum md5 min'
   r<-1> = 'words type minimum mod mods muls neg negs nes not nots num nums object objinfo oconv oconvs open.socket option ors'
   r<-1> = 'words type os.error ospath osrename outerjoin pconfig phantom printer.setting prompt pterm pwcrypt pwr quote quotes'
   r<-1> = 'words type raise rdiv readpkt read.socket recordlocked regex rem remove removef replace reuse rnd rtrans sadd save.screen'
   r<-1> = 'words type scan scmp sddecrypt sdencrypt sdext sdiv sdkey sdpyobj sdrandkey sdsalt selectinfo sentence seq server.addr set.port.params'
   r<-1> = 'words type set.socket.mode shift sin smul socket.info sortdata sortnext soundex soundexs space spaces splice sqrt squote'
   r<-1> = 'words type ssub status str strs subr subs substitute substrings sum summation swap swapcase sysmsg system tan terminfo'
   r<-1> = 'words type testlock time timedate trans trim trimb trimbs trimf trimfs trims trimw umask unassigned upcase vartype'
   r<-1> = 'words type vslice write.socket xlate xtd'
   * the @ variables
   r<-1> = 'words constant @fm @vm @sm @tm @im @svm @true @false @id @record @data @date @time @day @month @year @user @userno'
   r<-1> = 'words constant @logname @account @path @sentence @parasentence @command @option @selected @who @tty @term.type'
   r<-1> = 'words constant @crthigh @crtwide @level @nv @ns @nd @ni @ans @lpv @file.name @filename @ds @conv @itype.mode'
   r<-1> = 'words constant @abort.code @abort.message @command.stack @data.pending @pib @sib @pob @sob @transaction.id @system.return.code'
   return

rules.c:
   r<-1> = 'record *.c *.h *.cc *.cpp *.cxx *.hpp *.hh'
   r<-1> = 'line preproc # bol'
   r<-1> = 'line comment //'
   r<-1> = 'region comment /* */ span'
   r<-1> = 'region string " " esc=\'
   r<-1> = "region string ' ' esc=\"
   r<-1> = 'number constant'
   r<-1> = 'words keyword if else for while do switch case default break continue return goto sizeof typedef struct union enum'
   r<-1> = 'words keyword new delete class public private protected namespace template typename using this operator try catch throw'
   r<-1> = 'words type int char short long float double void unsigned signed const static extern volatile register inline auto'
   r<-1> = 'words type size_t ssize_t bool uint8_t uint16_t uint32_t uint64_t int8_t int16_t int32_t int64_t u_int8_t u_int16_t'
   r<-1> = 'words type u_int32_t u_int64_t off_t time_t FILE Public Private'
   r<-1> = 'words constant NULL true false TRUE FALSE EOF'
   return

rules.json:
   r<-1> = 'file *.json'
   r<-1> = 'record *.json'
   r<-1> = 'region string " " esc=\'
   r<-1> = 'number constant'
   r<-1> = 'words constant true false null'
   return

rules.markdown:
   r<-1> = 'record *.md *.markdown readme*'
   r<-1> = 'region string ``` ``` bol span'
   r<-1> = 'region string ` `'
   r<-1> = 'line keyword # bol'
   r<-1> = 'line comment > bol'
   r<-1> = 'mark special - bol blank'
   r<-1> = 'mark special * bol blank'
   r<-1> = 'mark special + bol blank'
   return

rules.sh:
   r<-1> = 'record *.sh *.bash *.bashrc *.profile'
   r<-1> = 'first #!*sh* #!*bash*'
   r<-1> = 'ident _'
   r<-1> = 'line preproc #! bol'
   r<-1> = 'line comment # word'
   r<-1> = 'region string " " esc=\ span'
   r<-1> = "region string ' ' span"
   r<-1> = 'number constant'
   r<-1> = 'words keyword if then else elif fi for while until do done case esac in function select time'
   r<-1> = 'words type echo cd ls cat grep sed awk test export local readonly return exit shift set unset eval exec source alias'
   r<-1> = 'words type unalias trap wait read printf declare typeset let mkdir rm cp mv chmod chown sudo'
   r<-1> = 'words constant true false'
   return

rules.python:
   r<-1> = 'record *.py *.pyw'
   r<-1> = 'first #!*python*'
   r<-1> = 'ident _'
   r<-1> = 'line preproc #! bol'
   r<-1> = 'line comment #'
   r<-1> = 'region string """ """ span'
   r<-1> = "region string ''' ''' span"
   r<-1> = 'region string " " esc=\'
   r<-1> = "region string ' ' esc=\"
   r<-1> = 'number constant'
   r<-1> = 'words keyword and as assert async await break class continue def del elif else except finally for from global if import'
   r<-1> = 'words keyword in is lambda nonlocal not or pass raise return try while with yield match case'
   r<-1> = 'words type int str float bool list dict set tuple bytes object print len range type isinstance open super self cls'
   r<-1> = 'words constant True False None'
   return

end

