* 19 Oct 26 Windows port - from Linux e4bc454-70aca05 - Writes every row whatever SL.S.DIFF says, and sets SL.S.SYNC: the terminal matches the shadow when it has run.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $sl_repaint(scr)
*
*     scr   the screen context (sl.h) of a screen the library owns.  The terminal is cleared and every
*           row that holds text, or any style but the plain one, is drawn again from SL.S.SHADOW and
*           SL.S.ATTRS in the theme now in force.  The shadow is not changed.
*
*   Text the program wrote with PRINT or CRT is not in the shadow and is lost: the library cannot ask
*   the terminal what it shows.  The bottom right cell is not drawn on a terminal that scrolls when it
*   is written (no xenl).
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_repaint(scr)
$catalog $sl_repaint

$include sl.h

   call $sl_sgr('n', sq)
   display sq : @(-1) :

   diff.was = scr<SL.S.DIFF>
   scr<SL.S.DIFF> = 0                                ;* the terminal was just cleared: every row of the shadow is to be written, not left out
   shadow = scr<SL.S.SHADOW>
   attrs = scr<SL.S.ATTRS>
   sw = scr<SL.S.W> + 0
   blank.row = str('n', sw)
   last = scr<SL.S.H> - 1
   for r = 0 to last
      t = shadow<1, r + 1>
      a = attrs<1, r + 1>
      if trim(t) # '' or a # blank.row then
         if r = last and not(terminfo('xenl')) then
            t = t[1, sw - 1]                      ;* the corner cell would scroll the terminal
            a = a[1, sw - 1]
         end
         call $sl_put(scr, 0, r, t, a)
      end
   next r

   scr<SL.S.DIFF> = diff.was
   scr<SL.S.SYNC> = 1                                ;* the terminal shows the shadow now (19 Oct 26): a form may leave out what is there already

   return
end

* END-CODE
