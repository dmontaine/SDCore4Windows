*
*
* START-DESCRIPTION:
*
*   CALL !OPTION(number, state)
*
* NUMBER is the option's number, OPT.xxx in INT$KEYS.H (include it with
* $INCLUDE GPL.BP INT$KEYS.H).  If STATE is null on entry the option is only
* read and STATE comes back 0 or 1.  If STATE is 0 or 1 on entry the option
* is set (1) or cleared (0) and STATE comes back as it now is.  Any other
* STATE, or a number that is not an option, comes back as -1.
*
* END-DESCRIPTION
*
* START-CODE

$internal
$no.xref
subroutine option(number, state)
$catalog !OPTION

$include syscom.h
$include keys.h
$include int$keys.h

   if not(number matches '1N0N') then
      state = -1
      return
   end

   flags = kernel(K$GET.OPTIONS, 0)
   if number + 0 >= len(flags) then
      state = -1
      return
   end

   if state = '' then
      state = flags[number + 1, 1]
      return
   end

   if state # 0 and state # 1 then
      state = -1
      return
   end

   flags[number + 1, 1] = state
   void kernel(K$SET.OPTIONS, flags)
   state = kernel(K$GET.OPTIONS, 0)[number + 1, 1]

   return
end

* END-CODE
