* START-CODE

$internal
$no.symbols
$no.xref
function py_listcrte(listname)
$catalog !py_listcrte

$include keys.h
$include err.h

* Reject an empty Python object name before the SDPYOBJ call, as the other
* PY_* programs do.
if listname = '' then
   set.status 1
   return 1
end
rtn_status = SDPYOBJ("","",listname,SD_PyListCrte)
*
return rtn_status

end
