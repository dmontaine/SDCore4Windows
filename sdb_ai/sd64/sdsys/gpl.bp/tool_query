            gosub get.rects
            gosub clamp.tops
            gen += 1
            ctx<TK.C.GEN> = gen
            gosub draw.all
         case nm = 'mouse'
            gosub on.mouse
            gosub draw.all
         case 1
            gosub on.key
            if not(done) then gosub draw.all
      end case
      if done then exit
