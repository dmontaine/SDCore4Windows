* In: ra.cur (1 on the cursor row), ra.foc (1 when the box has the focus), ra.dim (1 for a row the page does not use).  Out: ra, the style.
row.attr:
   begin case
      case ra.dim and not(ra.cur)
         ra = 'disabled'
      case ra.cur and ra.foc
         ra = 'highlight'
      case ra.cur
         ra = 'bold'
      case 1
         ra = 'normal'
   end case
   return

draw.files:
   if fc <= ft then ft = fc - 1
   if fc > ft + VISF then ft = fc - VISF
   if ft < 0 then ft = 0
   for dr = 1 to VISF
      kk = ft + dr
      s = ''
      ra.dim = 0
      if kk <= nfs then
         dn = fshown<kk>
         s = (if dn = fname then '*' else ' ') : fmt(convert(ctl, dots, dn)[1, 20], '20L') : ' ' : fmt(fshown.k<kk>, '4L')
         fn = dn
         gosub check.name
         ra.dim = (if okname then 0 else 1)
      end
      ra.cur = (if kk = fc and kk <= nfs then 1 else 0)
      ra.foc = (if focus = 1 then 1 else 0)
      gosub row.attr
      screen text fmt(s, (fb.w - 2) : 'L') at fb.x + 1,fb.y + dr attr ra width fb.w - 2
   next dr
   s = nfl : (if nfl = 1 then ' file' else ' files')
   if filt # '' then s = nfs : ' with "' : convert(ctl, dots, filt)[1, 8] : '"'
   if nfl = 0 then s = 'no file with a dictionary'
   screen text fmt(s, (fb.w - 2) : 'L') at fb.x + 1,fb.y + fb.h - 2 attr 'bold' width fb.w - 2
   return

draw.columns:
   screen text fmt('Nr', '3L') : fmt('', '2L') : fmt('Item', '22L') : fmt('Type', '5L') : 'Heading' at cb.x + 1,cb.y + 1 attr 'header' width cb.w - 2
   if cc <= ct then ct = cc - 1
   if cc > ct + VISC then ct = cc - VISC
   if ct < 0 then ct = 0
   for dr = 1 to VISC
      kk = ct + dr
      s = ''
      ra.dim = 0
      if kk <= nd then
         mk = 0
         locate ditem<kk> in cols<1> setting mp then
            mk = mp
         end else
