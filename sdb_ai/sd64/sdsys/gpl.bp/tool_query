* START-DESCRIPTION:
*
*   TOOL.QUERY {file}      (in every account's VOC)
*
*   A full-screen page, in the toolkit's frame (140 columns by 43 lines at least), that builds a query on one file of the account in five boxes and shows the sentence they make: 1 File
*   (the account's data files that have a dictionary), 2 Columns (the dictionary items of the file; Space marks one, the order marked is the order printed; B breaks on a column, T totals
*   it), 3 Conditions (up to six rows of item, operator and value joined by and / or), 4 Sort (up to four levels, ascending or descending) and 5 Options (list, count or sum; the heading
*   and footing; leave out the record id or the detail lines; no pause between screens; only the first n records).  Tab moves between the boxes.
*
*   THE SENTENCE is always on the screen, in a box of its own.  R runs it and shows what it printed in a box of its own (the output goes nowhere else; 2000 lines are kept, and the box says
*   how many there were); E edits it as text; S saves the query in the file &QUERIES& of the account (made when the first query is saved, after a box that shows the command); L shows the
*   saved queries in the pick window (typing narrows it), Enter loads one, Del deletes one (with its name typed).  The page changes nothing but that one file.
*
*   INJECTION SAFETY is the core of the page.  A sentence it runs is made of: a first word that is one of LIST, SORT, COUNT or SUM; the chosen file's name; words from a fixed list (with and or
*   by by.dsnd break.on total id.sup det.sup heading footing no.page sample and a few more); operators from a fixed list; the item names of the file's dictionary; numbers; and values in
*   double quotes.  A value is quoted by ONE routine (q.value) that refuses every control character, any character that is not plain ASCII, the single quote, the double quote, the backslash,
*   the backquote and the semicolon.  EVERY sentence is read again by ONE routine (check.sentence) before it can run: the one the boxes made, the one the person edited and the one a loaded
*   query held; a word that sends the output somewhere else or writes (TO, SAVING, ON.TO, LPTR, FILE, AS, CSV, DELIMITER, XML, JSON, STYLE ...) is refused even when it is also the name
*   of a dictionary item.  A saved query is data: when it is loaded every part is checked against the file's dictionary, the operator table and q.value, and what does not pass is dropped.
*
*   NO GATE IS NEEDED and none is asked for: the sentence only reads, and the page itself writes only the one file &QUERIES& - after $tk_ownfile has said that the VOC name &queries& leads
*   to a file it may write (a dynamic file in the account's own directory, of no guarded kind, which the kernel's edit rules let this session change: the page is $internal, which those
*   rules let through, so a name pointed at the program file would otherwise be written), and a record it deletes or writes over must be a saved query (field 1 is query1) - (a dictionary item that calls a program of the account runs it, as the same query would
*   at the prompt; the save, the delete and the creation of &QUERIES& leave no audit line of their own).  The shared account is not in the account's VOC as a file, so its files are not offered.  A dictionary can hold a phrase
*   (PH) or a defaults record ($QUERY.DEFAULTS) whose words the query processor adds to a sentence; the page does not list a phrase and cannot see the defaults, which are the account's own.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $tool_query
$catalog $tool_query

$include keys.h
$include int$keys.h
$include err.h
$include sl.h
$include tk.h

   prompt ''

* ------------------------------------------------------------------------------------------------- the words the page knows (no file is read for any of them)

   QDQ = char(34) ; QSQ = char(39) ; QBS = char(92) ; QBQ = char(96) ; QSEMI = char(59)       ;* the double quote, single quote, backslash, backquote and semicolon

   verbs = 'list sort count sum'                                 ;* the first word of a sentence the page will run
   redirect = 'to saving on.to lptr file as csv delimiter xml json json.lines elements with.dtd dtd.only with.schema schema.only appending no.query style overlay reporting from using strings display crt pathname'
   keepwords = 'with and or by by.dsnd break.on total id.sup det.sup heading footing no.page sample sampled col.hdg col.sup col.hdr.sup hdr.sup count.sup dbl.spc vertically average max min median mode range enumerate percentage break.sup grand.total rpt fmt col.spaces'
   opwords = '= < > <= >= eq ne lt le gt ge not like unlike'
   qwords = verbs : ' ' : redirect : ' ' : keepwords : ' ' : opwords       ;* a dictionary item with one of these names is never put in a sentence
   ops = '=' : @fm : 'ne' : @fm : '<' : @fm : '>' : @fm : '<=' : @fm : '>=' : @fm : 'like' : @fm : 'unlike'
   opdesc = 'equal to' : @fm : 'not equal to' : @fm : 'less than' : @fm : 'greater than' : @fm : 'less than or equal to' : @fm : 'greater than or equal to' : @fm : 'matches the pattern' : @fm : 'does not match the pattern'
   pane.names = 'File' : @fm : 'Columns' : @fm : 'Conditions' : @fm : 'Sort' : @fm : 'Options'
   qsent = 'create.file &queries& dynamic'                       ;* the one command the page runs besides the query itself; $tk_run refuses the ampersands, so it is run here, after its box

   VISF = 16 ; VISC = 16 ; RVIS = 33                             ;* rows of files, of columns and of results on the screen (set from the panes by get.rects)
   perr = '' ; lay.view = ''
   MAXCOND = 6 ; MAXSORT = 4 ; MAXC = 20 ; MAXSENT = 600 ; MAXVAL = 200 ; MAXLINES = 2000 ; MAXSAVED = 100 ; MAXITEMS = 500

   ctl = ''                                                      ;* every character the page will not write to the screen: controls, DEL and all of 128 to 255
   for k0 = 1 to 31
      ctl := char(k0)
   next k0
   for k0 = 127 to 255
      ctl := char(k0)
   next k0
   dots = str('.', len(ctl))

   call $tk_open('tool.query', '', ctx, err)
   if err # '' then
      display err
      stop
   end

   panes = 'File' : @sm : 'Columns' : @sm : 'Conditions' : @sm : 'Sort' : @sm : 'Options'
   keys = ''
   call $tk_keys('add', keys, 'f1', 'help', 'help', '', 1)
   call $tk_keys('add', keys, 'f6', 'box', 'next', panes, 1)                ;* S.176: F6 / Shift-F6 move between the boxes on every page (Tab does not)
