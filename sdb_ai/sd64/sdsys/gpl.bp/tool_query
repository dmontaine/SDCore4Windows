   call $tk_keys('add', keys, 'd', 'clear row', 'clearrow', 'Conditions' : @sm : 'Sort', 1)
   call $tk_keys('add', keys, 'enter', 'item', 'sortitem', 'Sort', 1)
   call $tk_keys('add', keys, 'space', 'order', 'sortdir', 'Sort', 1)
