   call $tk_keys('menu', keys, 'mark', 'Co&lumns', '&Mark the column', '', '')
   call $tk_keys('menu', keys, 'break', 'Co&lumns', '&Break on it', '', '')
   call $tk_keys('menu', keys, 'total', 'Co&lumns', '&Total it', '', '')
   call $tk_keys('menu', keys, 'clear', 'Co&lumns', '&Clear the marks', '', '')
   call $tk_keys('menu', keys, 'editrow', 'Con&ditions', '&Edit the row', '', '')
   call $tk_keys('menu', keys, 'join', 'Con&ditions', '&And / or', '', '')
   call $tk_keys('menu', keys, 'clearrow', 'Con&ditions', '&Clear the row', '', '')
