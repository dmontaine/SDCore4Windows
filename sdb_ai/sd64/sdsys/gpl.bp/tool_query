   call $tk_keys('menu', keys, 'next', '&View', '&Next box', '', '')         ;* S.180: every key's action is on a menu (F6)
   call $tk_keys('menu', keys, 'help', '&Help', '&Help on this page', '', '')
   call $tk_std('keys', ctx, keys, '', '')                ;* S.179: Ctrl-T theme, Ctrl-K keys and their View and Help entries, as on every page
   * S.97 stage 2: the AI line.  The page offers the AI only the actions that change what is shown - the file filter and reading the files again (the owner: opt-in, off by
   * default; running, saving, loading and editing the query are not offered); a proposal is carried out by the page's own key.  Where the AI is not usable for the account
   * nothing here adds a key, a row or a line.
