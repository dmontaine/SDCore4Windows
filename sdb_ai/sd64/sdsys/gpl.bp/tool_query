   nt.ref<2> = 'J switches and / or.  D clears the row.'
   nt.ref<3> = 'A value is plain text, typed as the query processor'
   nt.ref<4> = 'reads it for the item (see the query documentation).'
   nt.ref<5> = 'like / unlike take a pattern: 0X any text, 1A a letter,'
   nt.ref<6> = '3N three digits.  0X on both sides finds text inside.'
