* ------------------------------------------------------------------------------------------------- a new query

reset.query:
   cols = '' ; cflag = ''
   cnd.join = str(@fm, MAXCOND - 1) ; cnd.item = str(@fm, MAXCOND - 1) ; cnd.op = str(@fm, MAXCOND - 1) ; cnd.val = str(@fm, MAXCOND - 1)
   srt.item = str(@fm, MAXSORT - 1) ; srt.dir = str(@fm, MAXSORT - 1)
   opt.kind = 'list' ; opt.head = '' ; opt.foot = '' ; opt.idsup = 0 ; opt.detsup = 0 ; opt.nopage = 0 ; opt.sample = ''
   edited = 0 ; sent = '' ; senterr = ''
   cc = 1 ; ct = 0 ; kc = 1 ; sc = 1 ; oc = 1
   return

set.pane:
   begin case
      case view = 'results'
         cur.pane = 'Results'
      case 1
         cur.pane = pane.names<focus>
   end case
   return

* ------------------------------------------------------------------------------------------------- what the system says: the files and the dictionary

* The VOC entries of type F that open and have a dictionary, in name order: fnames, and fkinds (dyn or dir).  A sequential file, a file on another server and a file with no dictionary cannot be queried here.
read.files:
   fnames = '' ; fkinds = ''
   open 'VOC' to vocf then
      sselect vocf to 9
      readlist vids from 9 else vids = ''
      nv = dcount(vids, @fm)
      if vids = '' then nv = 0
      for rf = 1 to nv
         read vr from vocf, vids<rf> then
            t1 = upcase(vr<1>)
            if t1 = 'F' or t1[1, 5] = 'FILE ' then
               pfn = vids<rf>
               gosub probe.file
               if pf.kind # '' then
                  fnames<-1> = pfn
                  fkinds<-1> = pf.kind
               end
            end
         end
      next rf
      close vocf
   end
   nfl = dcount(fnames, @fm)
   if fnames = '' then nfl = 0
   return

* In: pfn.  Out: pf.kind, dyn or dir when the file opens and has a dictionary, else null
probe.file:
   pf.kind = ''
   pf.t = ''
   open pfn to pfv then
      pft = fileinfo(pfv, FL$TYPE)
      if pft = FL$TYPE.DH then pf.t = 'dyn'
      if pft = FL$TYPE.DIR then pf.t = 'dir'
      close pfv
      if pf.t # '' then
         open 'DICT', pfn to pdv then
            pf.kind = pf.t
            close pdv
         end
      end
   end
   return

* The names that hold the filter's text (any case), in name order
apply.filter:
   fshown = '' ; fshown.k = ''
   for af = 1 to nfl
      if filt = '' or index(upcase(fnames<af>), upcase(filt), 1) > 0 then
         fshown<-1> = fnames<af>
         fshown.k<-1> = fkinds<af>
      end
   next af
   nfs = dcount(fshown, @fm)
   if fshown = '' then nfs = 0
   if fc > nfs then fc = nfs
   if fc < 1 then fc = 1
   return

* The dictionary of fname: ditem (the ids, @id first, then the rest in name order), dtype, dhead and dok (1 when the page will put the item in a sentence).  Phrases (PH), links, text records
* and records whose id starts with a dollar are not listed.  Out: nd.
read.dict:
   ditem = '' ; dtype = '' ; dhead = '' ; dok = '' ; nd = 0
   dict.ok = 0
   if fname = '' then return
   have.voc = 0
   open 'VOC' to dvoc then have.voc = 1
   id.t = 'D' ; id.h = '@id'
   ndi = 1                                                       ;* @id is item 1 whether the dictionary has it or not
   open 'DICT', fname to ddv then
      dict.ok = 1
      sselect ddv to 9
      readlist dids from 9 else dids = ''
      nds = dcount(dids, @fm)
      if dids = '' then nds = 0
      if nds > MAXITEMS then nds = MAXITEMS
      for rd = 1 to nds
         did = dids<rd>
         read drec from ddv, did then
            t2 = upcase(drec<1>)
            tc = t2[1, 1]
            if t2[1, 2] = 'PH' then tc = ''
            if index('DEI', tc, 1) = 0 then tc = ''      ;* 31 Oct 26: the A and S types (and C) are gone
            if did[1, 1] = '$' then tc = ''
            if tc # '' then
               hd = drec<4>
               hd = convert(ctl, dots, hd)[1, 30]
               if did = '@id' then
                  id.t = tc
                  id.h = hd
               end else
                  ndi += 1
                  ditem<ndi> = did                                ;* by position: a heading may be empty
                  dtype<ndi> = tc
                  dhead<ndi> = hd
               end
            end
         end
      next rd
      close ddv
   end
   * @id is first; a dictionary made by CREATE.FILE has it, and the query processor makes one up when it is missing
   ditem<1> = '@id'
   dtype<1> = id.t
   dhead<1> = id.h
   nd = ndi
   dok = ''
   for rd = 1 to nd
      ck.id = ditem<rd>
      gosub item.check
      if ck.ok and have.voc then
         read dkr from dvoc, ck.id then
            if upcase(dkr<1>)[1, 1] = 'K' then ck.ok = 0                  ;* a VOC keyword of the query processor: never an item in a sentence
         end
      end
      dok<rd> = (if ck.ok then 1 else 0)
   next rd
   if have.voc then close dvoc
   return

* In: ck.id.  Out: ck.ok, 1 when the name is made of a-z, 0-9, dot, dash and underscore (@ as the first character: @id), at most 63, and is not a word of the query language the page knows
item.check:
   ck.ok = (len(ck.id) > 0 and len(ck.id) <= 63)
   okc = 'abcdefghijklmnopqrstuvwxyz0123456789._-'
   for ck.q = 1 to len(ck.id)
      ck.c = ck.id[ck.q, 1]
      if index(okc, ck.c, 1) = 0 then
         if not(ck.q = 1 and ck.c = '@') then ck.ok = 0
      end
   next ck.q
   if ck.ok then
      if index(' ' : qwords : ' ', ' ' : ck.id : ' ', 1) > 0 then ck.ok = 0
   end
   return

* In: vid.  Out: vdp, the place of the item in the dictionary list, or 0
find.item:
   vdp = 0
   locate vid in ditem<1> setting vdp else vdp = 0
   return

* A name the page may give to a command: letters a-z, digits, dot, dash and underscore only, at most 63 (what $tk_run lets through)
check.name:
   okname = (len(fn) > 0 and len(fn) <= 63)
   good = 'abcdefghijklmnopqrstuvwxyz0123456789._-'
   for q = 1 to len(fn)
      if index(good, fn[q, 1], 1) = 0 then okname = @false
   next q
   if fn = '.' or fn = '..' then okname = @false                 ;* 26 Oct 26 (review, low): the two names of a directory are no name of a file or of a saved query
   return

* ------------------------------------------------------------------------------------------------- the quoting and the checking: the whole of the page's injection safety

* In: qv.in.  Out: qv.out, the value in double quotes, and qv.err (null when it is fine).  ONE routine quotes every value that goes into a sentence.
q.value:
   qv.err = ''
   qv.out = ''
   if len(qv.in) > MAXVAL then
      qv.err = 'a value is at most ' : MAXVAL : ' characters'
   end
   for qi = 1 to len(qv.in)
      qc = qv.in[qi, 1]
      qn = seq(qc)
      begin case
         case qn < 32 or qn > 126
            qv.err = 'a value holds a control character or a character that is not plain ASCII'
         case qc = QDQ or qc = QSQ or qc = QBS or qc = QBQ or qc = QSEMI
            qv.err = 'a value cannot hold a quote, a backslash, a backquote or a semicolon'
      end case
      if qv.err # '' then exit
   next qi
   if qv.err = '' then qv.out = QDQ : qv.in : QDQ
   return

* In: chk.s.  Out: chk.err (null when the page will run it) and chk.out, the sentence with every word that is not in quotes in lower case.  The sentence must be: one of the four first words, the
* chosen file, and then only words from the fixed lists, numbers, the usable items of the file's dictionary and values in double quotes.  No other quote character, no semicolon, no character that is not plain ASCII.
check.sentence:
   chk.err = ''
   chk.out = ''
   cs = chk.s
   if cs = '' then
      chk.err = 'there is no sentence'
      return
   end
   if len(cs) > MAXSENT then
      chk.err = 'it is longer than ' : MAXSENT : ' characters'
      return
   end
   for cq = 1 to len(cs)
      cn = seq(cs[cq, 1])
      begin case
         case cn < 32 or cn > 126
            chk.err = 'it holds a control character or a character that is not plain ASCII'
         case cn = 39 or cn = 92 or cn = 96 or cn = 59
            chk.err = 'it holds a single quote, a backslash, a backquote or a semicolon'
      end case
      if chk.err # '' then exit
   next cq
   if chk.err # '' then return
   * the words and the quoted values
   toks = '' ; cur = '' ; inq = @false
   for cq = 1 to len(cs)
      ch = cs[cq, 1]
      if inq then
         if ch = QDQ then
            toks<-1> = QDQ : cur : QDQ
            cur = ''
            inq = @false
            nxt = cs[cq + 1, 1]
            if nxt # '' and nxt # ' ' then chk.err = 'a closing quote must be followed by a space'
         end else
            cur := ch
         end
      end else
         begin case
            case ch = QDQ
               if cur # '' then chk.err = 'a quote must come after a space, not inside a word'
               inq = @true
            case ch = ' '
               if cur # '' then
                  toks<-1> = downcase(cur)
                  cur = ''
               end
            case 1
               cur := ch
         end case
      end
      if chk.err # '' then exit
   next cq
   if chk.err # '' then return
   if inq then
      chk.err = 'a quote is not closed'
      return
   end
   if cur # '' then toks<-1> = downcase(cur)
   nt = dcount(toks, @fm)
   if index(' ' : verbs : ' ', ' ' : toks<1> : ' ', 1) = 0 then
      chk.err = 'the first word must be list, sort, count or sum'
      return
   end
   if nt < 2 then
      chk.err = 'there is no file name'
      return
   end
   if fname = '' or toks<2> # fname then
      chk.err = 'the file must be the one chosen in the File box (' : fname : ')'
      return
   end
   for ck = 3 to nt
      tk = toks<ck>
      begin case
         case tk[1, 1] = QDQ
            null
         case index(' ' : redirect : ' ', ' ' : tk : ' ', 1) > 0
            chk.err = tk : ' sends the output somewhere else or writes: the page does not run it'
         case index(' ' : keepwords : ' ' : opwords : ' ', ' ' : tk : ' ', 1) > 0
            null
         case tk matches "1N0N" or tk matches "1N0N'.'1N0N"
            null
         case 1
            vid = tk
            gosub find.item
            if vdp = 0 then
               chk.err = tk : ' is not a word the page knows, nor an item of the dictionary of ' : fname : ' (a value goes in double quotes)'
            end else
               if dok<vdp> # 1 then chk.err = tk : ' is a dictionary item the page does not put in a sentence'
            end
      end case
      if chk.err # '' then exit
   next ck
   if chk.err # '' then return
   chk.out = change(toks, @fm, ' ')
   return

* ------------------------------------------------------------------------------------------------- the sentence the boxes make

* Out: sent (null when the boxes cannot make one) and senterr.  The sentence is read again by check.sentence before it is kept: a sentence the page would not run is not shown as one.
gen.sentence:
   sent = ''
   senterr = ''
   if fname = '' then
      senterr = 'Choose a file first: Enter in the File box.'
      return
   end
   body = ''
   nco = 0
   for gi = 1 to MAXCOND
      if cnd.item<gi> # '' then
         qv.in = cnd.val<gi>
         gosub q.value
         if qv.err # '' then
            senterr = 'condition ' : gi : ': ' : qv.err
            exit
         end
         piece = 'with ' : cnd.item<gi> : ' ' : cnd.op<gi> : ' ' : qv.out
         if nco = 0 then
            body := ' ' : piece
         end else
            body := ' ' : (if cnd.join<gi> = 'or' then 'or' else 'and') : ' ' : piece
         end
         nco += 1
      end
   next gi
   if senterr # '' then return
   verb = opt.kind
   ncl = dcount(cols, @fm)
   if cols = '' then ncl = 0
   if verb = 'list' then
      nso = 0
      for gi = 1 to MAXSORT
         if srt.item<gi> # '' then
            body := ' ' : (if srt.dir<gi> = 'd' then 'by.dsnd' else 'by') : ' ' : srt.item<gi>
            nso += 1
         end
      next gi
      if nso > 0 then verb = 'sort'
      for gi = 1 to ncl
         begin case
            case cflag<gi> = 'b'
               body := ' break.on ' : cols<gi>
            case cflag<gi> = 't'
               body := ' total ' : cols<gi>
            case 1
               body := ' ' : cols<gi>
         end case
      next gi
      if opt.idsup then body := ' id.sup'
      if opt.detsup then body := ' det.sup'
      if opt.head # '' then
         qv.in = opt.head
         gosub q.value
         if qv.err # '' then
            senterr = 'heading: ' : qv.err
         end else
            body := ' heading ' : qv.out
         end
      end
      if opt.foot # '' and senterr = '' then
         qv.in = opt.foot
         gosub q.value
         if qv.err # '' then
            senterr = 'footing: ' : qv.err
         end else
            body := ' footing ' : qv.out
         end
      end
   end
   if verb = 'sum' then
      if ncl = 0 then senterr = 'A sum needs at least one column: mark one in the Columns box (Space).'
      for gi = 1 to ncl
         body := ' ' : cols<gi>
      next gi
   end
   if senterr # '' then return
   if opt.nopage then body := ' no.page'
   if opt.sample # '' then body := ' sample ' : opt.sample
   chk.s = verb : ' ' : fname : body
   gosub check.sentence
   if chk.err # '' then
      senterr = 'The boxes made a sentence the page will not run: ' : chk.err
      return
   end
   sent = chk.out
   return

* After any change in a box: the sentence is written again from the boxes (a sentence edited by hand is given up)
changed:
   if edited then
      edited = 0
      msg = 'the sentence was written again from the boxes'
   end
   gosub gen.sentence
   return

* ------------------------------------------------------------------------------------------------- drawing

* The layout (S.88 L2).  Two declarations, one for each kind of view, in the sizes of the reference layout (140 by 43, the body 138 by 39); the layout service holds the one the view needs:
*   build    band 1: File (28 wide), Columns (44) and Conditions (the rest), 19 rows, all three stretch in height, Conditions in width;
*            band 2: Sort (46 wide, fixed) and Options (the rest), 11 rows, fixed in height; band 3: The sentence, 9 rows.  A taller window gives every row to band 1.
*   whole    the Results box: one pane, the whole body (the saved queries are the toolkit's pick window since 3 Nov 26, no view of the page's).
* Out: fb.* (File), cb.* (Columns), nb.* (Conditions), sb.* (Sort), ob.* (Options), tb.* (The sentence) or wb.* (whole), each x y w h; VISF VISC RVIS.
declare.layout:
   lay.view = want.view
   dcl = ''
   if lay.view = 'build' then
      dcl<1> = 'files' : @vm : 1 : @vm : 1 : @vm : 19 : @vm : 28 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : '' : @vm : ''
      dcl<2> = 'columns' : @vm : 1 : @vm : 2 : @vm : 19 : @vm : 44 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : '' : @vm : ''
      dcl<3> = 'conds' : @vm : 1 : @vm : 3 : @vm : 19 : @vm : 66 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
      dcl<4> = 'sorts' : @vm : 2 : @vm : 1 : @vm : 11 : @vm : 46 : @vm : '' : @vm : '' : @vm : '' : @vm : '' : @vm : ''
      dcl<5> = 'options' : @vm : 2 : @vm : 2 : @vm : 11 : @vm : 92 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
      dcl<6> = 'sentence' : @vm : 3 : @vm : 1 : @vm : 9 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   end else
      dcl<1> = 'whole' : @vm : 1 : @vm : 1 : @vm : 39 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   end
   * S.99: the boxes that take the focus, for $tk_frame's [*] / [-]; the whole view (Results) has one box and so no marks
   ctx<TK.C.FOCI> = 'files' : @sm : 'File' : @vm : 'columns' : @sm : 'Columns' : @vm : 'conds' : @sm : 'Conditions' : @vm : 'sorts' : @sm : 'Sort' : @vm : 'options' : @sm : 'Options'
   call $tk_layout('declare', ctx, dcl, perr)
   gosub get.rects
   return

get.rects:
   if lay.view = 'build' then
      call $tk_layout('pane', ctx, 'files', rc)
      fb.x = rc<1, 1> ; fb.y = rc<1, 2> ; fb.w = rc<1, 3> ; fb.h = rc<1, 4>
      call $tk_layout('pane', ctx, 'columns', rc)
      cb.x = rc<1, 1> ; cb.y = rc<1, 2> ; cb.w = rc<1, 3> ; cb.h = rc<1, 4>
      call $tk_layout('pane', ctx, 'conds', rc)
      nb.x = rc<1, 1> ; nb.y = rc<1, 2> ; nb.w = rc<1, 3> ; nb.h = rc<1, 4>
      call $tk_layout('pane', ctx, 'sorts', rc)
      sb.x = rc<1, 1> ; sb.y = rc<1, 2> ; sb.w = rc<1, 3> ; sb.h = rc<1, 4>
      call $tk_layout('pane', ctx, 'options', rc)
      ob.x = rc<1, 1> ; ob.y = rc<1, 2> ; ob.w = rc<1, 3> ; ob.h = rc<1, 4>
      call $tk_layout('pane', ctx, 'sentence', rc)
      tb.x = rc<1, 1> ; tb.y = rc<1, 2> ; tb.w = rc<1, 3> ; tb.h = rc<1, 4>
      VISF = fb.h - 3                                            ;* the file rows: a row under the border, the summary row and the border: 16 of 19
      VISC = cb.h - 3                                            ;* the header row and the border: 16 of 19
   end else
      call $tk_layout('pane', ctx, 'whole', rc)
      wb.x = rc<1, 1> ; wb.y = rc<1, 2> ; wb.w = rc<1, 3> ; wb.h = rc<1, 4>
      RVIS = wb.h - 6                                            ;* the border, the three lines of the sentence, the header row and the border: 33 of 39
   end
   return

* The views are drawn from the panes of their own declaration: the one the layout holds is changed when the view changes between the boxes and the two full-body boxes
sync.layout:
   want.view = (if view = 'build' then 'build' else 'whole')
   if want.view # lay.view then gosub declare.layout
   return

* After a resize the tops of the lists may lie past the end of what they list now that more rows are shown
clamp.tops:
   if ft > nfs - VISF then ft = nfs - VISF
   if ft < 0 then ft = 0
   if ct > nd - VISC then ct = nd - VISC
   if ct < 0 then ct = 0
   if rtop > rl.cnt - RVIS then rtop = rl.cnt - RVIS
   if rtop < 0 then rtop = 0
   return

* In: nt.par, the paragraphs of a note (one to a field), nt.ref, the same note in the lines it has always been broken into for the reference width; nt.w the width of the box.
* Out: nt.lines, the lines.  At the reference width (nt.rw) the note keeps its own lines; in a wider box the paragraphs are wrapped to the box
wrap.note:
   nt.lines = nt.ref
   if nt.w > nt.rw then
      nt.lines = ''
      for nt.i = 1 to dcount(nt.par, @fm)
         call $tk_wrap(nt.par<nt.i>, nt.w, nt.pieces)
         nt.lines<-1> = nt.pieces
      next nt.i
   end
   return

draw.all:
