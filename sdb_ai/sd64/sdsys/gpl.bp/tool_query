         if mk > 0 then fl = (if cflag<mk> = 'b' then 'B' else (if cflag<mk> = 't' then 'T' else ''))
         s = fmt((if mk > 0 then mk else ''), '2R') : ' ' : fmt(fl, '2L') : fmt(convert(ctl, dots, ditem<kk>)[1, 21], '22L') : fmt(dtype<kk>, '5L') : dhead<kk>[1, 10]
         ra.dim = (if dok<kk> = 1 then 0 else 1)
      end
      ra.cur = (if kk = cc and kk <= nd then 1 else 0)
      ra.foc = (if focus = 2 then 1 else 0)
      gosub row.attr
      screen text fmt(s, (cb.w - 2) : 'L') at cb.x + 1,cb.y + 1 + dr attr ra width cb.w - 2
   next dr
   return

draw.conds:
   screen text 'Row ' : 'Join ' : fmt('Item', '23L') : fmt('Op', '8L') : 'Value' at nb.x + 1,nb.y + 1 attr 'header' width nb.w - 8
