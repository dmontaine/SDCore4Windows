   call $tk_keys('add', keys, 'r', 'run', 'run', panes, 1)
   call $tk_keys('add', keys, 'e', 'edit', 'edit', panes, 1)
   call $tk_keys('add', keys, 's', 'save', 'save', panes, 1)
   call $tk_keys('add', keys, 'l', 'load', 'load', panes, 1)
   call $tk_keys('add', keys, 'f5', 'read', 'reread', panes, 1)
   call $tk_keys('add', keys, 'up', 'scroll', 'scroll', 'Results', 1)
   call $tk_keys('add', keys, 'r', 'again', 'again', 'Results', 1)
   call $tk_keys('add', keys, 'esc', 'back', 'back', 'Results', 1)
   call $tk_keys('add', keys, 'ctrl-q', 'quit', 'quit', '', 1)
   call $tk_keys('add', keys, 'esc', 'menu', 'menu', panes, 1)             ;* S.88 U6: in the editing panes Esc takes the name filter off first, else opens the menu bar (in Results it is 'back')
   call $tk_keys('menu', keys, 'quit', '&File', '&Quit', '', '')
