      s = ''
      if kk <= rl.cnt then s = rl<kk>[rx + 1, tw]
      screen text fmt(s, tw : 'L') at wb.x + 2,wb.y + 4 + dr width tw
   next dr
   hx = wb.x + wb.w - 7 ; hy = wb.y + 4
   call $tk_help('mark', hx, hy, 0, 0)
   return


* ------------------------------------------------------------------------------------------------- keys and mouse

on.key:
   msg = ''
   if len(nm) = 1 then nm = downcase(nm)                         ;* R and r are one key
   if nm = ' ' then nm = 'space'
   if nm = 'ctrl-q' then
      done = 1
      return
   end
   if nm = 'f1' or nm = '?' then
      call $tk_help('box', 'tool.query.page', hm, 0, 0)
      if hm # '' then msg = hm
      return
   end
   if nm = 'f6' or nm = 'shift-f6' or nm = 'act:ai' then
      * S.176: F6 / Shift-F6 go round the boxes and the AI line, from every view (the builder's five boxes; the results are one); AI > Ask the AI goes to the line
      if view = 'results' then
         call $tk_aipage('ring', ctx, keys, 1, nm : @fm : 1, ap)
      end else
         call $tk_aipage('ring', ctx, keys, focus, nm : @fm : 5, ap)
         if ap<1> > 0 then focus = ap<1>
      end
      msg = ap<2>
      return
   end
   begin case
      case view = 'results'
         gosub keys.results
      case 1
         gosub keys.build
   end case
   return

keys.build:
   begin case
      case nm = 'r'
         gosub do.run
      case nm = 'e'
         gosub do.edit
      case nm = 's'
         gosub do.save
      case nm = 'l'
         gosub do.list.saved
      case nm = 'ctrl-t'                    ;* S.179: the theme, kept for the person - the same on every page ($tk_std)
         call $tk_std('theme', ctx, keys, '', std.r)
         if std.r<1> then gosub draw.all
         msg = std.r<2>
      case nm = 'act:std.mouse'             ;* S.186: View > Mouse, the same on every page ($tk_std)
         call $tk_std('mouse', ctx, keys, '', std.r)
         msg = std.r<2>
      case nm = 'ctrl-o'                    ;* S.186: the log of the commands this page ran (View > Output; $tk_std)
         call $tk_std('output', ctx, keys, '', std.r)
      case nm = 'ctrl-k'                    ;* S.179: the keys of this page, in a box
         call $tk_std('keylist', ctx, keys, cur.pane, std.r)
      case nm = 'f5'
         gosub do.reread
      case focus = 1
         gosub keys.files
      case focus = 2
         gosub keys.columns
      case focus = 3
         gosub keys.conds
      case focus = 4
         gosub keys.sorts
      case focus = 5
         gosub keys.options
   end case
   return

keys.files:
   begin case
      case nm = 'up'
         if fc > 1 then fc -= 1
      case nm = 'down'
         if fc < nfs then fc += 1
      case nm = 'pgup'
         fc -= VISF
         if fc < 1 then fc = 1
      case nm = 'pgdn'
         fc += VISF
         if fc > nfs then fc = nfs
      case nm = 'home'
         fc = 1
      case nm = 'end'
         if nfs > 0 then fc = nfs
      case nm = 'enter'
         gosub choose.file
      case nm = '/'
         gosub do.filter
      case nm = 'esc'
         if filt # '' then
            filt = ''
            gosub apply.filter
            fc = 1 ; ft = 0
         end
   end case
   return

keys.columns:
   begin case
      case nm = 'up'
         if cc > 1 then cc -= 1
      case nm = 'down'
         if cc < nd then cc += 1
      case nm = 'pgup'
         cc -= VISC
         if cc < 1 then cc = 1
      case nm = 'pgdn'
         cc += VISC
         if cc > nd then cc = nd
      case nm = 'home'
         cc = 1
      case nm = 'end'
         if nd > 0 then cc = nd
      case nm = 'space'
         gosub mark.column
      case nm = 'b'
         fl.set = 'b'
         gosub flag.column
      case nm = 't'
         fl.set = 't'
         gosub flag.column
      case nm = 'x'
         if cols # '' then
            cols = '' ; cflag = ''
            gosub changed
            msg = 'every mark is cleared'
         end
   end case
   return

keys.conds:
   begin case
      case nm = 'up'
         if kc > 1 then kc -= 1
      case nm = 'down'
         if kc < MAXCOND then kc += 1
      case nm = 'home'
         kc = 1
      case nm = 'end'
         kc = MAXCOND
      case nm = 'enter'
         gosub edit.cond
      case nm = 'j'
         if kc > 1 and cnd.item<kc> # '' then
            cnd.join<kc> = (if cnd.join<kc> = 'or' then 'and' else 'or')
            gosub changed
         end
      case nm = 'd' or nm = 'del'
         if cnd.item<kc> # '' then
            cnd.item<kc> = '' ; cnd.op<kc> = '' ; cnd.val<kc> = '' ; cnd.join<kc> = ''
            gosub changed
         end
   end case
   return

keys.sorts:
   begin case
      case nm = 'up'
         if sc > 1 then sc -= 1
      case nm = 'down'
         if sc < MAXSORT then sc += 1
      case nm = 'home'
         sc = 1
      case nm = 'end'
         sc = MAXSORT
      case nm = 'enter'
         gosub edit.sort
      case nm = 'space'
         if srt.item<sc> # '' then
            srt.dir<sc> = (if srt.dir<sc> = 'd' then 'a' else 'd')
            gosub changed
         end
      case nm = 'd' or nm = 'del'
         if srt.item<sc> # '' then
            srt.item<sc> = '' ; srt.dir<sc> = ''
            gosub changed
         end
   end case
   return

keys.options:
   begin case
      case nm = 'up'
         if oc > 1 then oc -= 1
      case nm = 'down'
         if oc < 7 then oc += 1
      case nm = 'home'
         oc = 1
      case nm = 'end'
         oc = 7
      case nm = 'enter' or nm = 'space'
         gosub edit.option
   end case
   return

keys.results:
   begin case
      case nm = 'esc'
         view = 'build'
      case nm = 'up'
         if rtop > 0 then rtop -= 1
      case nm = 'down'
         if rtop + RVIS < rl.cnt then rtop += 1
      case nm = 'pgup'
         rtop -= RVIS
         if rtop < 0 then rtop = 0
      case nm = 'pgdn'
         rtop += RVIS
         if rtop + RVIS > rl.cnt then rtop = rl.cnt - RVIS
         if rtop < 0 then rtop = 0
      case nm = 'home'
         rtop = 0 ; rx = 0
      case nm = 'end'
         rtop = rl.cnt - RVIS
         if rtop < 0 then rtop = 0
      case nm = 'left'
         rx -= 20
         if rx < 0 then rx = 0
      case nm = 'right'
         if rx < 300 then rx += 20
      case nm = 'r'
         gosub do.run
   end case
   return

on.mouse:
   screen mouse returning mev else mev = ''
   if mev = '' then return
   mr = ''
   call $tk_menubar('click', ctx, keys, cur.pane, mev, '', mr)                    ;* a click on the bar on row 0
   if mr<1> # '' then
      nm = mr<4>
      if nm # '' then gosub on.key                          ;* a bar left with nothing chosen has no name: the status message stays
      return
   end
   call $tk_aipage('mouse', ctx, keys, cur.pane, mev, ap)                           ;* S.97 stage 2: a click on the AI line gives it the focus
   if ap # '' then
      msg = ap
      return
   end
   call $tk_help('hit', mev, hx, hy, hit.m)
   if hit.m then
      call $tk_help('box', 'tool.query.page', hm, 0, 0)
      if hm # '' then msg = hm
      return
   end
   if mev<1> # 'press' or mev<2> # 1 then return
   mx = mev<3>
   my = mev<4>
   if view # 'build' then return
   begin case
      case mx >= fb.x and mx <= fb.x + fb.w - 1 and my >= fb.y and my <= fb.y + fb.h - 1
         focus = 1
         if my >= fb.y + 1 and my <= fb.y + VISF and ft + my - fb.y <= nfs then fc = ft + my - fb.y
      case mx >= cb.x and mx <= cb.x + cb.w - 1 and my >= cb.y and my <= cb.y + cb.h - 1
         focus = 2
         if my >= cb.y + 2 and my <= cb.y + 1 + VISC and ct + my - (cb.y + 1) <= nd then cc = ct + my - (cb.y + 1)
      case mx >= nb.x and mx <= nb.x + nb.w - 1 and my >= nb.y and my <= nb.y + nb.h - 1
         focus = 3
         if my >= nb.y + 2 and my <= nb.y + 1 + MAXCOND then kc = my - (nb.y + 1)
      case mx >= sb.x and mx <= sb.x + sb.w - 1 and my >= sb.y and my <= sb.y + sb.h - 1
         focus = 4
         if my >= sb.y + 2 and my <= sb.y + 1 + MAXSORT then sc = my - (sb.y + 1)
      case mx >= ob.x and mx <= ob.x + ob.w - 1 and my >= ob.y and my <= ob.y + ob.h - 1
         focus = 5
         if my >= ob.y + 1 and my <= ob.y + 7 then oc = my - ob.y
   end case
   return

* ------------------------------------------------------------------------------------------------- the boxes

* Enter in the File box: the file under the cursor becomes the file of the query; the other boxes are cleared, since they name its items
choose.file:
   if nfs < 1 then return
   fn = fshown<fc>
   gosub check.name
   if not(okname) then
      msg = 'this file name has a character the page does not give to a command: type the query at the prompt'
      return
   end
   fname = fn
   gosub reset.query
   gosub read.dict
   if not(dict.ok) then
      fname = ''
      msg = 'the dictionary of ' : fn : ' could not be opened'
      return
   end
   focus = 2
   gosub gen.sentence
   msg = fname : ': ' : nd : (if nd = 1 then ' item' else ' items') : ' in its dictionary.  Space marks a column.'
   return

do.filter:
   af.kind = 'filter' ; af.ttl = 'Filter' ; af.lab = 'File name has' ; af.btn = '&Filter' ; af.val = '' ; af.w = 40 ; af.max = 100
   af.note = 'Part of a file name: the File box lists the files whose name holds it.  Empty shows every file.'
   gosub ask.form
   if af.why # '' then msg = af.why
   if not(af.ok) then return
   filt = af.out
   gosub apply.filter
   fc = 1 ; ft = 0
   msg = (if filt = '' then 'every file' else nfs : ' with "' : convert(ctl, dots, filt)[1, 30] : '"')
   return

* F5: the files and the dictionary are read again; what the boxes name and the dictionary no longer has is dropped
do.reread:
   dropped = 0
   keep.f = fname
   gosub read.files
   gosub apply.filter
   if keep.f # '' then
      still = 0
      for kx = 1 to nfl
         if fnames<kx> = keep.f then still = 1
      next kx
      if still then
         gosub read.dict
         gosub validate.panes
         gosub changed
      end else
         fname = ''
         gosub reset.query
         ditem = '' ; dtype = '' ; dhead = '' ; dok = '' ; nd = 0
         gosub gen.sentence
         msg = keep.f : ' is not one of your files with a dictionary now'
         return
      end
   end
   msg = 'read the files and the dictionary again'
   if dropped > 0 then msg := ': ' : dropped : ' part(s) of the query no longer fit and were dropped'
   return

mark.column:
   if nd < 1 then return
   mcol = ditem<cc>
   locate mcol in cols<1> setting mp then
      del cols<mp>
      del cflag<mp>
   end else
      if dok<cc> # 1 then
         msg = 'the page does not put this name in a sentence (it has a character the page does not use, or it is also a word of the query language)'
         return
      end
      ncm = dcount(cols, @fm)
      if cols = '' then ncm = 0
      if ncm >= MAXC then
         msg = 'at most ' : MAXC : ' columns'
         return
      end
      cols<-1> = mcol
   end
   gosub changed
   return

* In: fl.set, b or t.  Break or total on the column under the cursor, which must be marked; the same key again takes it off
flag.column:
   if nd < 1 then return
   mcol = ditem<cc>
   locate mcol in cols<1> setting mp then
      cflag<mp> = (if cflag<mp> = fl.set then '' else fl.set)
      gosub changed
   end else
      msg = 'mark the column first (Space)'
   end
   return

* Enter in the Conditions box: the item, the operator and the value of the row under the cursor
edit.cond:
   if fname = '' then
      msg = 'choose a file first'
      return
   end
   pk.none = 0
   pk.title = 'Condition ' : kc : ' - item'
   gosub pick.item
   if pk = 0 then return
   cit = pk.id
   ttl = 'Condition ' : kc : ' - operator'
   screen pick ops title ttl returning pko else pko = 0
   if pko = 0 then return
   cur.v = (if cnd.item<kc> = cit and cnd.op<kc> = ops<pko> then cnd.val<kc> else '')
   af.kind = 'value' ; af.ttl = 'Condition ' : kc ; af.lab = 'Value' ; af.btn = '&Set' ; af.val = cur.v ; af.w = '' ; af.max = MAXVAL
   af.note = 'The value for ' : cit : ' ' : ops<pko> : ' (' : opdesc<pko> : ').  Plain text: no quote, backslash, backquote or semicolon.'
   gosub ask.form
   if af.why # '' then msg = af.why
   if not(af.ok) then return
   cnd.item<kc> = cit
   cnd.op<kc> = ops<pko>
   cnd.val<kc> = af.out
   if kc > 1 and cnd.join<kc> = '' then cnd.join<kc> = 'and'
   gosub changed
   return

* Enter in the Sort box: the item of the level under the cursor, or none to clear it
edit.sort:
   if fname = '' then
      msg = 'choose a file first'
      return
   end
   pk.none = 1
   pk.title = 'Sort level ' : sc
   gosub pick.item
   if pk = 0 then return
   srt.item<sc> = pk.id
   srt.dir<sc> = (if pk.id = '' then '' else (if srt.dir<sc> = '' then 'a' else srt.dir<sc>))
   gosub changed
   return

* In: pk.title, pk.none (1 to offer "(none)" first).  Out: pk (0 when cancelled) and pk.id (null for none).  Only the items the page puts in a sentence are offered.
pick.item:
   pitems = '' ; pids = '' ; pn = 0
   if pk.none then
      pn = 1
      pitems<1> = '(none)'
      pids<1> = ''
   end
   for pj = 1 to nd
      if dok<pj> = 1 then
         pn += 1
         pitems<pn> = fmt(ditem<pj>[1, 24], '24L') : ' ' : fmt(dtype<pj>, '4L') : ' ' : dhead<pj>        ;* by position: pids keeps the place of "(none)"
         pids<pn> = ditem<pj>
      end
   next pj
   pk = 0
   ttl = pk.title
   screen pick pitems title ttl size 70,22 returning pk else pk = 0
   pk.id = ''
   if pk > 0 then pk.id = pids<pk>
   return

edit.option:
   begin case
      case oc = 1
         opt.kind = (if opt.kind = 'list' then 'count' else (if opt.kind = 'count' then 'sum' else 'list'))
         gosub changed
      case oc = 2
         af.kind = 'value' ; af.ttl = 'Heading' ; af.lab = 'Heading' ; af.btn = '&Set' ; af.val = opt.head ; af.w = '' ; af.max = MAXVAL
         af.note = 'The heading printed at the top of each page.  Plain text; empty for the default.'
         gosub ask.form
         if af.why # '' then msg = af.why
         if af.ok then
            opt.head = af.out
            gosub changed
         end
      case oc = 3
         af.kind = 'value' ; af.ttl = 'Footing' ; af.lab = 'Footing' ; af.btn = '&Set' ; af.val = opt.foot ; af.w = '' ; af.max = MAXVAL
         af.note = 'The footing printed at the foot of each page.  Plain text; empty for none.'
         gosub ask.form
         if af.why # '' then msg = af.why
         if af.ok then
            opt.foot = af.out
            gosub changed
         end
      case oc = 4
         opt.idsup = (if opt.idsup then 0 else 1)
         gosub changed
      case oc = 5
         opt.detsup = (if opt.detsup then 0 else 1)
         gosub changed
      case oc = 6
         opt.nopage = (if opt.nopage then 0 else 1)
         gosub changed
      case oc = 7
         af.kind = 'sample' ; af.ttl = 'Sample' ; af.lab = 'Records' ; af.btn = '&Set' ; af.val = opt.sample ; af.w = 10 ; af.max = 10
         af.note = 'Only the first n records: a whole number from 1 to 99999.  Empty for all.'
         gosub ask.form
         if af.why # '' then msg = af.why
         if af.ok then
            opt.sample = af.out
            gosub changed
         end
   end case
   return

* ------------------------------------------------------------------------------------------------- the questions (S.88 U6, 2 Nov 26)

* One question of the page, on the toolkit's form ($tk_form): the explanation in the form's message rows, the answer checked by af.check, and a refusal said IN the form, which stays
* with what was typed until it passes or the person leaves it (Esc or Cancel).  THE FORM CHECKS NOTHING: af.check does, with the page's own routines.
* In: af.kind (filter, value, sample, sentence, name), af.ttl, af.lab, af.btn (the default button, with its & mark), af.val (the starting text), af.w (the entry's width; null as wide as
* the form allows), af.max (the longest text), af.note.  Out: af.ok (1 when an answer passed), af.out (the answer as the page keeps it), af.why (null, or why no form was drawn).
ask.form:
   af.ok = 0
   af.out = ''
   af.why = ''
   spec = af.ttl : @fm : af.btn : @fm : ''
   spec<-1> = 'answer' : @vm : af.lab : @vm : af.w : @vm : af.max
   fv = af.val
   call $tk_form('open', ctx, spec, fv, fo)
   if fo = 'no' then
      af.why = 'the form does not fit this window: nothing was changed'
      return
   end
   call $tk_form('say', ctx, af.note, '', '')
   loop
      call $tk_form('run', ctx, fans, fv, fid)
      if fans # 'ok' then
         call $tk_form('close', ctx, '', '', '')
         return
      end
      af.in = fv<1>
      gosub af.check
      if af.err = '' then exit
      call $tk_form('say', ctx, af.err : @fm : af.note, 'answer', '')   ;* 2 Nov 26 (review): the explanation stays under the reason, when it is most needed
   repeat
   call $tk_form('close', ctx, '', '', '')
   af.ok = 1
   return

* In: af.kind, af.in (the text as typed).  Out: af.err (null when it passes, else what to say in the form), af.out.  The same checks the page has always made, in one place.
af.check:
   af.err = ''
   af.out = ''
   begin case
      case af.kind = 'filter'
         af.out = trim(af.in)
      case af.kind = 'value'
         qv.in = trimf(trimb(af.in))
         gosub q.value
         if qv.err # '' then af.err = 'not accepted: ' : qv.err else af.out = qv.in
      case af.kind = 'sample'
         smp.in = trim(af.in)
         if smp.in # '' then
            gosub check.sample
            if smp.ok then af.out = smp.out else af.err = 'a whole number from 1 to 99999 (empty for all)'
         end
      case af.kind = 'sentence'
         chk.s = trimf(trimb(af.in))
         gosub check.sentence
         if chk.err # '' then af.err = 'not accepted: ' : chk.err else af.out = chk.out
      case af.kind = 'name'
         fn = downcase(trim(af.in))
         gosub check.name
         if not(okname) or len(fn) > 40 then af.err = 'a name of letters a-z, digits, dot, dash and underscore only, at most 40' else af.out = fn
   end case
   return

* ------------------------------------------------------------------------------------------------- edit and run

* E: the sentence as text.  What comes back is read by check.sentence like any other.
do.edit:
   if sent = '' then
      msg = (if senterr # '' then senterr else 'there is no sentence yet')
      return
   end
   af.kind = 'sentence' ; af.ttl = 'Edit the sentence' ; af.lab = 'Sentence' ; af.btn = '&Use it' ; af.val = sent ; af.w = '' ; af.max = MAXSENT
   af.note = 'The sentence as text.  It is checked now, and again before it can run.'
   gosub ask.form
   if not(af.ok) then
      msg = (if af.why # '' then af.why else 'the sentence was not changed')
      return
   end
   sent = af.out
   edited = 1
   senterr = ''
   msg = 'the sentence is edited by hand; a change in any box writes it again from the boxes'
   return

* R: the sentence is checked once more, run with its output captured, and the output is read in the Results box.  Nothing else sees it.
do.run:
   if sent = '' then
      msg = (if senterr # '' then senterr else 'there is no sentence yet')
      return
   end
   chk.s = sent
   gosub check.sentence
   if chk.err # '' then
      msg = 'not run: ' : chk.err
      return
   end
   run.s = chk.out
   sel.was = selectinfo(0, SL$ACTIVE)
   out = ''
   execute run.s trapping aborts capturing out
   out = change(change(change(out, char(13) : char(10), @fm), char(10), @fm), char(13), '')
   if out[len(out), 1] = @fm then out = out[1, len(out) - 1]      ;* 26 Oct 26 (review, low): the last line ends with its own line break, which made an empty line after it and one line too many in the count
   rl.n = dcount(out, @fm)
   if out = '' then rl.n = 0
   rl.cnt = rl.n
   if rl.cnt > MAXLINES then rl.cnt = MAXLINES
   rl = ''
   for ri = 1 to rl.cnt
      ln = out<ri>
      gosub strip.esc
      rl<ri> = convert(ctl, dots, ln)[1, 400]                      ;* by position: a blank line must keep its place
   next ri
   out = ''
   rl.sent = run.s
   rl.note = (if sel.was then 'A select list was active: the query used it instead of the whole file.' else '')
   if rl.n = 0 then rl.note = 'The command printed nothing.  ' : rl.note
   rtop = 0 ; rx = 0
   view = 'results'
   return

* In/out: ln.  A captured listing starts with the terminal's clear-screen sequence and a value may hold others: every escape sequence is taken out
strip.esc:
   if index(ln, char(27), 1) = 0 then return
   outl = ''
   sk = 0
   for si = 1 to len(ln)
      sch = ln[si, 1]
      begin case
         case sk = 2
            if sch matches "1A" or sch = '~' then sk = 0
         case sk = 1
            if sch = '[' then sk = 2 else sk = 0
         case sch = char(27)
            sk = 1
         case 1
            outl := sch
      end case
   next si
   ln = outl
   return

* ------------------------------------------------------------------------------------------------- saved queries: the file &queries& of the account, and nothing else

* L: the saved queries (up to 100, in name order) in the toolkit's pick window (3 Nov 26, "Extend the picker"): the columns file, report and the sentence when it was saved; typing
* narrows the list.  Enter loads the query (load.selected, every part checked as before); Del names one for delete.selected, which asks its own box with the name typed.  THE WINDOW
* CHANGES NOTHING.  After either, or Esc, the page is shown again with what happened on the status line (L opens the list again).
do.list.saved:
   gosub read.saved
   if sv.have = 0 or nsv = 0 then
      msg = 'no query has been saved yet: S saves the one on the screen'
      if sv.note # '' then msg = trim(sv.note)
      return
   end
   pk.items = ''
   for rq = 1 to nsv
      pk.items<rq, 1> = sv.ids<rq>
      pk.items<rq, 2> = sv.info<rq, 1> : @sm : sv.info<rq, 2> : @sm : sv.info<rq, 3>
      pk.items<rq, 3> = sv.info<rq, 3>
   next rq
   pk.mode = 'list'
   pk.mode<2> = 'Name' : @vm : 'File' : @vm : 'Report' : @vm : 'The sentence when it was saved'
   pk.mode<3> = 30 : @vm : 26 : @vm : 8 : @vm : 70
   pk.mode<4> = 'delete'
   pk.id = 'Saved queries: Enter loads, Del deletes'
   pk.start = 1
   call $tk_pickrec(ctx, pk.mode, pk.items, pk.id, pk.res, pk.start)
   begin case
      case pk.res = 'ok' and pk.id >= 1 and pk.id <= nsv
         svc = pk.id
         gosub load.selected
      case pk.res = 'delete' and pk.id >= 1 and pk.id <= nsv
         svc = pk.id
         gosub delete.selected
      case 1
         if sv.note # '' then msg = trim(sv.note)
   end case
   return

read.saved:
   sv.ids = '' ; sv.info = '' ; nsv = 0 ; sv.note = '' ; sv.have = 0
   open '&queries&' to qf then
      sv.have = 1
      select qf to 9
      readlist qids from 9 else qids = ''
      nq = dcount(qids, @fm)
      if qids = '' then nq = 0
      sorted = ''
      skipped = 0
      for rq = 1 to nq
         fn = qids<rq>
         gosub check.name
         if okname then
            locate fn in sorted<1> by 'AL' setting sp else
               ins fn before sorted<sp>
            end
         end else
            skipped += 1
         end
      next rq
      nsv = dcount(sorted, @fm)
      if sorted = '' then nsv = 0
      if nsv > MAXSAVED then
         nsv = MAXSAVED
         sv.note = 'The first ' : MAXSAVED : ' of ' : nq : ' records are listed.  '
      end
      for rq = 1 to nsv
         sv.ids<-1> = sorted<rq>
         read qr from qf, sorted<rq> then
            sv.info<rq> = convert(ctl, dots, qr<2>)[1, 24] : @vm : convert(ctl, dots, qr<3>)[1, 6] : @vm : convert(ctl, dots, qr<19>)[1, 70]
         end else
            sv.info<rq> = ''
         end
      next rq
      if skipped > 0 then sv.note := skipped : ' record(s) with other names are not listed.'
      close qf
   end
   return

* Enter in the list: the record is read, and EVERYTHING in it is checked against the file's dictionary, the operator table and q.value before it is used; what does not pass is dropped
load.selected:
   if nsv < 1 then return
   lname = sv.ids<svc>
   lrec = ''
   open '&queries&' to qf then
      read lrec from qf, lname else lrec = ''
      close qf
   end
   if lrec = '' then
      msg = lname : ' could not be read'
      return
   end
   if lrec<1> # 'query1' then
      msg = lname : ' is not a query this page saved'
      return
   end
   lfile = lrec<2>
   known = 0
   for lx = 1 to nfl
      if fnames<lx> = lfile then known = 1
   next lx
   if not(known) then
      msg = 'the file ' : convert(ctl, dots, lfile)[1, 40] : ' is not one of your files with a dictionary: nothing was loaded'
      return
   end
   fn = lfile
   gosub check.name
   if not(okname) then
      msg = 'the file name in the record is not one the page gives to a command: nothing was loaded'
      return
   end
   fname = lfile
   gosub reset.query
   gosub read.dict
   if not(dict.ok) then
      fname = ''
      msg = 'the dictionary of the file could not be opened: nothing was loaded'
      return
   end
   lk = lrec<3>
   opt.kind = (if lk = 'count' or lk = 'sum' then lk else 'list')
   cols = convert(@vm, @fm, lrec<4>)
   cflag = convert(@vm, @fm, lrec<5>)
   cnd.join = convert(@vm, @fm, lrec<6>)
   cnd.item = convert(@vm, @fm, lrec<7>)
   cnd.op = convert(@vm, @fm, lrec<8>)
   cnd.val = convert(@vm, @fm, lrec<9>)
   srt.item = convert(@vm, @fm, lrec<10>)
   srt.dir = convert(@vm, @fm, lrec<11>)
   opt.head = lrec<12>
   opt.foot = lrec<13>
   opt.idsup = (if lrec<14> = 1 then 1 else 0)
   opt.detsup = (if lrec<15> = 1 then 1 else 0)
   opt.nopage = (if lrec<16> = 1 then 1 else 0)
   opt.sample = lrec<17>
   gosub validate.panes
   gosub gen.sentence
   * a sentence that was edited by hand is kept only when it passes the same check as any other
   if lrec<18> = 1 and lrec<19> # '' and sent # '' then
      chk.s = lrec<19>
      gosub check.sentence
      if chk.err = '' then
         sent = chk.out
         edited = 1
      end else
         dropped += 1
      end
   end
   view = 'build'
   focus = 2
   msg = 'loaded ' : lname
   if dropped > 0 then msg := ': ' : dropped : ' part(s) did not pass the checks and were dropped'
   return

* The boxes hold what a record or a dictionary gave them: keep only what passes.  Out: dropped.
validate.panes:
   dropped = 0
   * columns
   ncv = dcount(cols, @fm)
   if cols = '' then ncv = 0
   nl = '' ; nfg = '' ; vn = 0
   for vi = 1 to ncv
      vid = cols<vi>
      gosub find.item
      dupe = 0
      if vn > 0 then
         locate vid in nl<1> setting vp then dupe = vp else dupe = 0
      end
      if vdp > 0 and not(dupe) and vn < MAXC then
         if dok<vdp> = 1 then
            vn += 1
            nl<vn> = vid
            vfl = cflag<vi>
            nfg<vn> = (if vfl = 'b' or vfl = 't' then vfl else '')
         end else
            dropped += 1
         end
      end else
         dropped += 1
      end
   next vi
   cols = nl ; cflag = nfg
   * conditions
   nj = str(@fm, MAXCOND - 1) ; ni = str(@fm, MAXCOND - 1) ; nop = str(@fm, MAXCOND - 1) ; nvl = str(@fm, MAXCOND - 1)
   for vi = 1 to MAXCOND
      vid = cnd.item<vi>
      if vid # '' then
         gosub find.item
         vop = cnd.op<vi>
         locate vop in ops<1> setting vpo else vpo = 0
         qv.in = cnd.val<vi>
         gosub q.value
         if vdp > 0 and vpo > 0 and qv.err = '' then
            if dok<vdp> = 1 then
               ni<vi> = vid
               nop<vi> = vop
               nvl<vi> = cnd.val<vi>
               if vi > 1 then nj<vi> = (if cnd.join<vi> = 'or' then 'or' else 'and')
            end else
               dropped += 1
            end
         end else
            dropped += 1
         end
      end
   next vi
   cnd.join = nj ; cnd.item = ni ; cnd.op = nop ; cnd.val = nvl
   * sorts
   ns2 = str(@fm, MAXSORT - 1) ; nd2 = str(@fm, MAXSORT - 1)
   for vi = 1 to MAXSORT
      vid = srt.item<vi>
      if vid # '' then
         gosub find.item
         if vdp > 0 then
            if dok<vdp> = 1 then
               ns2<vi> = vid
               nd2<vi> = (if srt.dir<vi> = 'd' then 'd' else 'a')
            end else
               dropped += 1
            end
         end else
            dropped += 1
         end
      end
   next vi
   srt.item = ns2 ; srt.dir = nd2
   * options
   if opt.head # '' then
      qv.in = opt.head
      gosub q.value
      if qv.err # '' then
         opt.head = ''
         dropped += 1
      end
   end
   if opt.foot # '' then
      qv.in = opt.foot
      gosub q.value
      if qv.err # '' then
         opt.foot = ''
         dropped += 1
      end
   end
   if opt.sample # '' then
      smp.in = opt.sample
      gosub check.sample
      if smp.ok then
         opt.sample = smp.out
      end else
         opt.sample = ''
         dropped += 1
      end
   end
   return

* In: smp.in.  Out: smp.ok (1 when it is a whole number from 1 to 99999) and smp.out, the number without leading zeros.  BASIC does not short-circuit: the number is added to only once it is known to be digits.
check.sample:
   smp.ok = 0
   smp.out = ''
   if smp.in matches "1N0N" then
      if len(smp.in) <= 5 then
         smp.out = smp.in + 0
         if smp.out >= 1 then smp.ok = 1
      end
   end
   return

* S: the query on the screen is saved as a record of &queries&.  The file is made first, when there is none, after a box that shows the command.
do.save:
   if fname = '' then
      msg = 'choose a file first'
      return
   end
   if sent = '' then
      msg = 'nothing to save: ' : (if senterr # '' then senterr else 'there is no sentence')
      return
   end
   af.kind = 'name' ; af.ttl = 'Save the query' ; af.lab = 'Name' ; af.btn = '&Save' ; af.val = '' ; af.w = 44 ; af.max = 60
   af.note = 'The name the query is saved under: a-z, 0-9, dot, dash and underscore; at most 40 characters.'
   gosub ask.form
   if not(af.ok) then
      msg = (if af.why # '' then af.why else 'nothing was saved')
      return
   end
   qname = af.out
   have.q = 0
   open '&queries&' to qf then have.q = 1
   if not(have.q) then
      lines = 'Makes the file &queries& in the account ' : @who : ', where saved queries are kept.  The page writes records of that one file and no other.'
      call $tk_confirm(qsent, lines, '', res, cmsg)
      if res # 'run' then
         msg = cmsg
         return
      end
      execute qsent trapping aborts capturing mk
      open '&queries&' to qf then have.q = 1
      if not(have.q) then
         msg = 'the file &queries& could not be made: nothing was saved'
         return
      end
   end
   * 28 Oct 26 (S.88 phase 2, S2): this page is $internal, which the kernel's edit gates let through, so it asks for itself whether &queries& is a file it may write: a dynamic file standing
   * in this account's own directory under that name, of no guarded kind, which the kernel's edit rules allow this session to change.  A VOC entry &queries& that points at bp is refused.
   gosub check.qfile
   if not(qok) then
      msg = qwhy : ': nothing was saved'
      close qf
      return
   end
   exists = 0
   old.file = ''
   read xrec from qf, qname then
      exists = 1
      old.file = convert(ctl, dots, xrec<2>)[1, 40]
      if xrec<1> # 'query1' then
         msg = sysmsg(12765, qname) : ': nothing was saved'          ;* a record of that name that is not a saved query is never written over
         close qf
         return
      end
   end
   if not(exists) then
      select qf to 9
      readlist allq from 9 else allq = ''
      naq = dcount(allq, @fm)
      if allq = '' then naq = 0
      if naq >= MAXSAVED then
         msg = 'a file of saved queries holds ' : MAXSAVED : ' at most: delete one first (L, then X)'
         close qf
         return
      end
   end
   wsent = 'write ' : qname : ' to &queries&'
   if exists then
      lines = 'Replaces the saved query ' : qname : ' (on the file ' : old.file : ') with the one on the screen.  This is not a command: the page writes that one record of your file &queries& itself, and nothing else.'
*     26 Oct 26: the box is about a record, not a command: "Write this record?" (12957)
      call $tk_confirm(wsent, lines, qname, res, cmsg, sysmsg(12957))
   end else
      lines = 'Saves the query on the screen as the record ' : qname : ' of your file &queries&.  This is not a command: the page writes that one record itself, and nothing else.'
      call $tk_confirm(wsent, lines, '', res, cmsg, sysmsg(12957))
   end
   if res # 'run' then
      msg = cmsg
      close qf
      return
   end
   gosub check.qfile                                           ;* again, after the box: the gates or the account's files may have changed while it was on the screen
   if not(qok) then
      msg = qwhy : ': nothing was saved'
      close qf
      return
   end
   gosub pack.record
   writeok = @true
   write wrec to qf, qname on error writeok = @false
   close qf
   if writeok then
      msg = 'saved ' : qname
   end else
      msg = 'the query could not be saved'
   end
   return

* Out: wrec, the record: field 1 query1, 2 file, 3 report, 4 columns, 5 their break / total letters, 6 to 9 the conditions, 10 and 11 the sorts, 12 heading, 13 footing, 14 to 16 id.sup, det.sup, no.page, 17 sample,
* 18 edited by hand, 19 the sentence
pack.record:
   wrec = 'query1' : @fm : fname : @fm : opt.kind
   wrec<4> = convert(@fm, @vm, cols)
   wrec<5> = convert(@fm, @vm, cflag)
   wrec<6> = convert(@fm, @vm, cnd.join)
   wrec<7> = convert(@fm, @vm, cnd.item)
   wrec<8> = convert(@fm, @vm, cnd.op)
   wrec<9> = convert(@fm, @vm, cnd.val)
   wrec<10> = convert(@fm, @vm, srt.item)
   wrec<11> = convert(@fm, @vm, srt.dir)
   wrec<12> = opt.head
   wrec<13> = opt.foot
   wrec<14> = (if opt.idsup then 1 else 0)
   wrec<15> = (if opt.detsup then 1 else 0)
   wrec<16> = (if opt.nopage then 1 else 0)
   wrec<17> = opt.sample
   wrec<18> = (if edited then 1 else 0)
   wrec<19> = sent
   return

* May this page write and delete records of the file it has open as qf (&queries&)?  $tk_ownfile asks: a dynamic file, not read only, directly in this account's own directory under the
* name &queries&, of no guarded kind (K$EDIT.KIND 0), and one the kernel's edit rules (K$EDIT.OK) allow this session to change.  Out: qok, qwhy
check.qfile:
   qok = 0
   qwhy = ''
   call $tk_ownfile(qf, '&queries&', qok, qwhy)
   return

* Out: dwhy is null and qf is OPEN when the record lname may be deleted; else dwhy says why not and qf is closed.  The record must be a saved query: field 1 is query1.
check.delete:
   dwhy = ''
   open '&queries&' to qf else
      dwhy = 'the file &queries& could not be opened: nothing was deleted'
      return
   end
   gosub check.qfile
   if not(qok) then
      dwhy = qwhy : ': nothing was deleted'
      close qf
      return
   end
   read qdrec from qf, lname else qdrec = ''
   if qdrec<1> # 'query1' then
      dwhy = sysmsg(12765, lname)
      close qf
   end
   return

* Del in the list (the pick window): the record is deleted from &queries& after a box, with its name typed
delete.selected:
   if nsv < 1 then return
   lname = sv.ids<svc>
   * 28 Oct 26 (S.88 phase 2, S2): refused BEFORE the box when the file is not one this page may write, or the record is not a saved query (field 1 query1)
   gosub check.delete
   if dwhy # '' then
      msg = dwhy
      return
   end
   close qf
   dsent = 'delete ' : lname : ' from &queries&'
   lines = 'Deletes the saved query ' : lname : ' from your file &queries&.  This is not a command: the page deletes that one record itself.  The query on the screen is not touched.'
*  26 Oct 26: "Delete this record?" (12958)
   call $tk_confirm(dsent, lines, lname, res, cmsg, sysmsg(12958))
   if res # 'run' then
      msg = cmsg
      return
   end
   gosub check.delete                                          ;* again, with the file open for the delete: nothing between this test and the delete
   if dwhy # '' then
      msg = dwhy
      return
   end
   delok = @true
   delete qf, lname on error delok = @false
   close qf
   msg = (if delok then 'deleted ' : lname else 'could not delete ' : lname)
   return

end

