* START-DESCRIPTION:
*
*   call !tklayout(op, ctx, arg, ret)         ALWAYS FOUR ARGUMENTS: a call with fewer stops with "Argument count mismatch" (pad with '')
*
*   The ops are $tk_layout's: refresh (after the key 'resize'), declare, pane and body.  The slots of the context that belong to the AI line are cleared first, so that
*   the body is never shortened by a row for it.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine tklayout(op, ctx, arg, ret)
$catalog !tklayout

$include tk.h

   ctx<TK.C.AI> = ''
   ctx<TK.C.AIROW> = ''
   call $tk_layout(op, ctx, arg, ret)
   return
end

* END-CODE
