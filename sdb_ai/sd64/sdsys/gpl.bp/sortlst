* START-DESCRIPTION:
*
*   SORT.LIST list.name {FROM file.name}
*
* Sorts a saved select list into ascending order, as strings, in place.
* The list is in $SAVEDLISTS unless FROM names another file.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $sort.list
$catalog $sortlst

$include err.h
$include keys.h
$include parser.h

   parser = "!PARSER"

   @system.return.code = -ER$ARGS      ;* Preset for command format errors

   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb

   * Get list name

   call @parser(PARSER$GET.TOKEN, token.type, list.name, keyword)
   if token.type = PARSER$END then stop sysmsg(3240) ;* List name required
   if list.name = '' then stop sysmsg(3267) ;* Illegal null list name

   * Get list file if present

   file.name = '$savedlists'
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   if keyword = KW$FROM then
      call @parser(PARSER$MFILE, token.type, file.name, keyword)
      if token.type = PARSER$END then
         stop sysmsg(3242) ;* Source list file name not found where expected
      end
      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   end

   if token.type # PARSER$END then
      stop sysmsg(2018, token) ;* Unexpected token (xx)
   end

   open file.name to list.f else
      @system.return.code = -status()
      stop sysmsg(3248, status()) ;* Error xx opening the list file
   end

   readu list.rec from list.f, list.name else
      release list.f, list.name
      @system.return.code = -status()
      stop sysmsg(3268, list.name) ;* Saved select list 'xx' not found
   end

   sorted = ''
   num.items = dcount(list.rec, @fm)
   for i = 1 to num.items
      item = list.rec<i>
      locate item in sorted<1> by 'AL' setting pos else null
      ins item before sorted<pos>
   next i

   write sorted to list.f, list.name on error
      @system.return.code = -status()
      stop sysmsg(3272, status()) ;* Error xx writing saved list record
   end

   @system.return.code = num.items
   display sysmsg(3266, num.items, list.name) ;* xx records saved to select list 'xx'

   return
end

* END-CODE
