*
* START-DESCRIPTION:
*
*   SCREEN CLOSE
*
*   is compiled into
*
*   call !screen_close(ret, status)
*
*   The shadow is forgotten, the cursor is shown, the terminal is put back to the normal style and the
*   cursor is moved to the first column of the last line, where the next prompt will be.  The screen
*   is not cleared: SCREEN CLEAR first if that is wanted.  Doing it twice, or without SCREEN OPEN, does
*   nothing but the last part.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_close(ret, status)
$catalog !screen_close

$include sl.h

   ret = ''
   status = 0
   call $sl_sgr('n', sq)
   display @(-31) : sq : @(0, @crthigh - 1) :
   scr = ''
   call $sl_scr('close', scr)

   return
end

* END-CODE
