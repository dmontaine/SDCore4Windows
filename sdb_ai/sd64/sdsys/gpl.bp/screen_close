*
* START-DESCRIPTION:
*
*   SCREEN CLOSE
*
*   is compiled into
*
*   call !screen_close(ret, status)
*
*   The shadow is forgotten, the cursor is shown, the terminal is put back to the normal style and the
*   cursor is moved to the first column of the last line, where the next prompt will be.  The screen
*   is not cleared: SCREEN CLEAR first if that is wanted.  Doing it twice, or without SCREEN OPEN, does
*   nothing but the last part.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_close(ret, status)
$catalog !screen_close

$include sl.h

   ret = ''
   status = 0
   if system(25) then return                  ;* a phantom has no terminal: nothing was drawn, nothing to give back
   call $sl_scr('get', scr)
   if scr<SL.S.OWNED> and scr<SL.S.MOUSE> then
      call $sl_mouse('off', mseq)
      display mseq :                                  ;* the terminal stops reporting the mouse
   end
   call $sl_attr('desktop', dc)
   call $sl_sgr('n', sq)
   display @(-31) : sq :
   if dc # 'n' then display @(-1) :                   ;* a coloured desktop is not left behind
   display @(0, @crthigh - 1) :
   scr = ''
   call $sl_scr('close', scr)
   call $sl_guardmode('', 0, 0)                       ;* the cursor lock belongs to the program that asked for it
   call $sl_theme('reset', '', '', '', '', r)         ;* the next program starts from mono, having asked for nothing
   call $sl_line('on', 0, r)                          ;* and from plain borders

   return
end

* END-CODE
