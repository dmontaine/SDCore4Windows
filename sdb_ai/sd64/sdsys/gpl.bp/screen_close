$internal
subroutine screen_close(ret, status)
$catalog !screen_close

$include sl.h

   common /slalt/ alt.on                               ;* 16 Nov 26 Windows port (305): 1 while a page is in the console's alternate buffer

   ret = ''
   status = 0
   if system(25) then return                  ;* a phantom has no terminal: nothing was drawn, nothing to give back
   call $sl_scr('peek', scr)                  ;* S.113: not get, which would bring the terminal up to a screen that is being given back
   if scr<SL.S.OWNED> and scr<SL.S.MOUSE> then
      call $sl_mouse('off', mseq)
      display mseq :                                  ;* the terminal stops reporting the mouse
   end
   call $sl_attr('desktop', dc)                       ;* asked of the program's theme, before it is put back
   call $sl_theme('reset', '', '', '', '', r)         ;* the next program starts from mono, having asked for nothing - and this FIRST: see below
   call $sl_line('on', 0, r)                          ;* and from plain borders
   call $sl_sgr('n', sq)                              ;* mono's normal: the terminal's own colours
   display @(-31) : sq :
   if dc # 'n' then display @(-1) :                   ;* a coloured desktop is not left behind
   display @(0, @crthigh - 1) :
   if not(unassigned(alt.on)) then
      if alt.on then
         display char(27) : '[?1049l' :                ;* 16 Nov 26 Windows port (305): back to the main buffer, its lines and cursor as the page found them
         alt.on = 0
      end
   end
   scr = ''
   call $sl_scr('close', scr)
   call $sl_guardmode('', 0, 0)                       ;* the cursor lock belongs to the program that asked for it

   return
end

* END-CODE
