* the colour pool: sixteen different pairs are taken, the first pair again (shared, taken), a seventeenth different pair (refused) and a name that is no colour (refused)
cf.run:
   call $tk_frame(ctx, keys, pane, msg)
   screen form title 'Pool' at 10,3 size 60,6 returning sf
   cl = 'black':@fm:'blue':@fm:'green':@fm:'cyan':@fm:'red':@fm:'magenta':@fm:'brown':@fm:'white'
   o = ''
   for i = 1 to 16
      fgv = cl<mod(i, 8) + 1>
      bgv = cl<int(i / 8) + 1>
      o := 'a'
      screen label sf, 'c' : i, 'x' at 2,2 color fgv,bgv else o[len(o), 1] = 'r'
   next i
   o := 'a'
   screen label sf, 'cdup', 'x' at 2,3 color 'blue','black' else o[len(o), 1] = 'r'
   o := 'a'
   screen label sf, 'cfull', 'x' at 2,3 color 'blue','green' else o[len(o), 1] = 'r'
   o := 'a'
   screen label sf, 'cbad', 'x' at 2,3 color 'chartreuse','red' else o[len(o), 1] = 'r'
   screen hide sf
   msg = 'colours ' : o
   return

