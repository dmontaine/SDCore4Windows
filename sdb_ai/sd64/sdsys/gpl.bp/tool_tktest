* the entries of the pick window: twelve commands with a description and a help, then item00013 and so on up to pn
p.build:
   pv = 'list,sort,count,copy,delete.file,create.file,modify.account,who,listu,logto,catalog,basic'
   pd = 'show records of a file,show records in order,count the records,copy records to a file,remove a file,make a file,change an account,who is signed on,list the users,enter another account,make a program a command,compile a program'
   ph = 'LIST shows the records of a file on the screen,SORT is LIST in the order of an attribute,COUNT says how many records match,COPY puts records into another file,DELETE.FILE removes a file and its dictionary,'
   ph := 'CREATE.FILE makes a file and a dictionary for it,MODIFY.ACCOUNT changes the gates of an account,WHO says who is signed on and as whom,LISTU lists the users signed on,LOGTO enters another account,'
   ph := 'CATALOG makes a program a command,BASIC compiles a program'
   pitems = ''
   for q = 1 to pn
      if q <= 12 then
         pitems<q> = field(pv, ',', q) : @vm : field(pd, ',', q) : @vm : field(ph, ',', q)
      end else
         pitems<q> = 'item' : str('0', 5 - len(q)) : q : @vm : 'the ' : q : 'th entry' : @vm : 'help for item ' : q
      end
   next q
   return

* the data: names, a quantity, a check, a city; a row in Elgin is drawn 'disabled' and one over 90 'error'
t.build:
   names = 'delta,alpha,echo,charlie,bravo,foxtrot,golf,hotel,india,juliet,kilo,lima'
   cities = 'Albany,Boston,Chicago,Denver,Elgin,Fresno'
   trows = ''
   for r = 1 to tn
      nm = 'row' : str('0', 5 - len(r)) : r
      if r <= 12 then nm = field(names, ',', r)
      trows<r> = nm : @vm : mod(r * 7, 100) : @vm : mod(r, 2) : @vm : field(cities, ',', mod(r, 6) + 1)
   next r
   gosub t.styles
   return

t.styles:
   tstyle = ''
   m = dcount(trows, @fm)
   for r = 1 to m
      sty = ''
      if trows<r, 4> = 'Elgin' then
         sty = 'disabled'
      end else
         if trows<r, 2> + 0 > 90 then sty = 'error'
      end
      tstyle<1, r> = sty
   next r
   return

* new rows: bravo is gone, echo has a new quantity, mike is new, and the order of the old rows is reversed
t.refresh:
   nrw = 'mike' : @vm : '55' : @vm : '1' : @vm : 'Boston'
   m = dcount(trows, @fm)
   for r = m to 1 step -1
      if trows<r, 1> # 'bravo' then
         one = trows<r>
         if one<1, 1> = 'echo' then one<1, 2> = 99
         nrw<-1> = one
      end
   next r
   trows = nrw
   gosub t.styles
   w{'newrows'} = trows
   w{'rowstyle'} = tstyle
   call $sl_table('refresh', w, scr, '', tr)
   return

