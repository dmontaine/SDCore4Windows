* END-HISTORY
*
* START-DESCRIPTION:
*
*   SCREEN MENUBAR menus {ROW r} {DRAW} {CLICK x} {RETURNING v} {THEN ... ELSE ...}
*
*   is compiled into
*
*   call !screen_menubar(menus, row, draw, click, ret, status)
*
*     menus    one FIELD for each menu: its title (an & puts the letter after it first as the key
*              that opens it), then its entries as values, each as for SCREEN MENU (label, shortcut,
*              code as subvalues; - is a line).  An entry without a code gives its number in its menu.
*              A fourth subvalue holds flags: D (disabled) and C (checked), as for SCREEN MENU.  A menu
*              whose title begins with > is a submenu: it is not on the bar, and an entry whose code is
*              that title opens it beside the entry (Right or Return opens, Esc or Left closes).
*     row      the row of the bar, from 0 (default 0)
*     draw     only draw the bar and return; the program calls again without DRAW to use it
*     click    a column of the bar's row where the mouse was pressed (SCREEN MOUSE says where): the menu whose title is
*              there opens instead of the first.  A column with no title over it (the space to the right of the titles)
*              opens nothing and the statement takes ELSE.  Left out, the first menu opens, as for F10.
*     ret      the code of the entry chosen
*     status   0 an entry was chosen; 1 Esc or the input ended, or DRAW was given, or CLICK found no title (ELSE)
*
*   Without DRAW the first menu opens at once; left and right move to the next menu, up and down
*   among the entries, Return chooses, Esc leaves, a letter chooses the entry that has it.  The bar
*   stays on the screen afterwards (and in the library's shadow); what was under the drop-downs is
*   put back when they close.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_menubar(menus, brow, draw, click, ret, status)
$catalog !screen_menubar

$include sl.h

   ret = ''
   status = 1
   if system(25) then return                  ;* a phantom has no terminal: nothing is drawn, nobody is waited for
   nm = dcount(menus, @fm)
   if menus = '' then nm = 0
   if nm = 0 then return
   call $sl_scr('get', scr)

   w = ''
   w<SL.W.Y> = brow + 0
   w<SL.W.W> = scr<SL.S.W>
   for k = 1 to nm
      m = menus<k>
      ni = dcount(m, @vm) - 1
      for i = 1 to ni
         if m<1, i + 1, 3> = '' then m<1, i + 1, 3> = i
      next i
      w<19 + k> = m
   next k

   call $sl_menu('init', w, scr, '', r)
   call $sl_menu('draw', w, scr, '', r)
   if draw = '' and click # '' then
      call $sl_menu('hit', w, scr, click + 0, hm)      ;* the menu under the click
      if hm = 0 then
         call $sl_scr('put', scr)
         return
      end
      w<SL.W.S1> = hm
   end
   if draw = '' then
      call $sl_menu('run', w, scr, '', r)
      if r # '' then
         ret = r
         status = 0
      end
   end
   call $sl_scr('put', scr)

   return
end

* END-CODE
