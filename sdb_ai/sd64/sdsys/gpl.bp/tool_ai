         el<-1> = an.name : ' will be able to send text to ' : (if pnm<k> = '' then 'Custom' else pnm<k>) : ' with the ai verb and the programs that ask the AI.  The text leaves this machine.'
      end else
         el<-1> = an.name : ' will be able to use the AI as soon as you choose a provider.  What it sends leaves this machine for that provider.'
      end
   end
   el<-1> = "It takes effect at the person's next request to the AI: the helper looks at the group each time."
   use.x = 0
   gosub confirm.and.run
   return

* S (S.170; the owner, 8 Nov 26: first "a single dialog with the key field displaying asterisks", then, when K and M had been built as two different things: "There should be
* only S for a setup dialog that looks the same no matter if the model and key has been selected previously.  If there are already values they should be displayed.  The model
* should be selected from a list.  The key in a password type field."  Warned that the key then passes through SD, he chose this over the helper's own prompt.)
* ONE DIALOG, ALWAYS THE SAME: the Key (a password entry: a key already set shows as SU.KEEP, the stars that mean "keep it"), the Model (a LIST of the provider's own model
* names, the one in use chosen), Other name (an entry for a model no list holds: a Custom server that gives no list), three message rows, Save and Cancel.  The list is asked for
* when the dialog opens if a key is set, and again as soon as a new key is taken (leaving the Key entry, or Enter in it): the key goes to the helper first (SET.AI KEY p HANDOVER,
* through a file only sdsys may reach, removed at once; never a command line or the audit trail), then the list is asked WITH it.  Save sets the model chosen when it differs from
* the one in use.  The model now set that the list does not hold (the owner's Deepseek-V4-Pro) is said, and the listed one that differs only in case is chosen for him.
do.setup:
   p = provs<pi>
   if index(' anthropic openai google deepseek custom ', ' ' : p : ' ', 1) = 0 then return
   nm.s = pnm<pi>
   if nm.s = '' then nm.s = 'Custom'
   cur = pmod<pi>
   if cur = '' then cur = pdef<pi>
   host = field(purl<pi>, '/', 3)
   if host = '' then
      msg = nm.s : ' has no address yet: fill it in first (press C)'
      return
   end
   su.keep = '************'
   call $sl_scr('get', scr)
   su.sw = scr<SL.S.W> + 0
   su.sh = scr<SL.S.H> + 0
   su.bw = 100
   su.bh = 28
   if su.sw < su.bw + 2 or su.sh < su.bh + 2 then
      msg = 'the window is too small for the setup dialog: nothing was changed'
      return
   end
   su.bx = int((su.sw - su.bw) / 2)
   su.by = int((su.sh - su.bh) / 2)
   su.lw = 14
   su.mw = su.bw - 4
   key.done = 0
   lm.ok = 0 ; lm.n = 0 ; lm.list = '' ; lm.why = ''
   if pkey<pi> then gosub fetch.models
   gosub setup.items
   su.title = 'AI setup: ' : nm.s
   if pkey<pi> then
      su.kini = su.keep
      su.khint = 'A key is set.  Leave the stars to keep it, or replace them with a new key.'
   end else
      su.kini = ''
      su.khint = 'Type or paste the key, then press Tab: the list of models is fetched with it.'
   end
   su.hint = ('The key is sent only to ' : host : ' over https.  Tab moves, Enter saves, Esc cancels.')[1, su.mw]
   su.tw = su.bw - su.lw - 4
   screen form title su.title at su.bx,su.by size su.bw,su.bh returning sf
   screen label sf, 'lk', 'Key' at 2,2 width su.lw - 2
   screen entry sf, 'key' at 2 + su.lw,2 width 70 value su.kini mask maxlen 600
   screen label sf, 'lk2', su.khint at 2 + su.lw,3 width su.tw
   screen label sf, 'lm', 'Model' at 2,5 width su.lw - 2
   screen list sf, 'model', su.items at 2 + su.lw,5 size 70,12 value su.val
   screen label sf, 'lo', 'Other name' at 2,18 width su.lw - 2
   screen entry sf, 'other' at 2 + su.lw,18 width 50 value '' maxlen 80
   screen label sf, 'lo2', 'Only for a model the list does not hold (a Custom server that gives no list).' at 2 + su.lw,19 width su.tw
   for j = 1 to 3
      screen label sf, 'm' : j, '' at 2,20 + j width su.mw
   next j
   screen button sf, 'ok', '&Save' at 2,su.bh - 3 default
   screen button sf, 'cancel', sysmsg(12254) at 14,su.bh - 3 cancel
   screen label sf, 'hint', su.hint at 2,su.bh - 2 width su.mw
   su.say = su.note
   gosub setup.say
   su.done = 0
   loop
      screen wait sf returning su.ev then                     ;* su.ev, NOT ev: names fold case, and EV is the page's explanation rows
         begin case
            case su.ev<1> = 'resize'                          ;* S.209: the box goes, the page follows the window, and the next wait shows the box over it
               screen hide sf
               gosub box.resized
            case su.ev<1> = 'focus'
               if su.ev<3> = 'key' then gosub setup.takekey   ;* the Key entry was left: a new key in it goes to the helper and the list is asked with it
            case su.ev<1> = 'button' and su.ev<2> = 'ok'
               gosub setup.takekey                            ;* Enter in the Key entry presses Save: take a new key first
               if not(su.fetched) then gosub setup.save        ;* a list that has only just come is shown to choose from, not saved over
            case su.ev<1> = 'button'
               exit
         end case
      end else
         exit                                                 ;* Esc, Cancel, an input that ended
      end
      if su.done then exit
   repeat
   kv = ''
   screen hide sf
   gosub after.box
   if su.done then
      msg = (if key.done then 'The key for ' : nm.s : ' is set' else 'The key is unchanged')
      if mv # cur then                                         ;* cur is the model in use (the administrator's, else the default)
         call $tk_runx(allow.set, 'set.ai model ' : p : ' ' : mv, out, st, err)
         if err # '' then
            msg := '; the model was not set: ' : err
         end else
            msg := '; ' : trim(change(out, @fm, ' '))[1, 100]
         end
      end else
         msg := '; the model stays ' : mv
      end
   end else
      msg = (if key.done then 'the key is set; the model was not changed' else 'nothing was changed')
   end
   gosub read.all
   gosub draw.all
   return

* The dialog's model list from lm.* (su.items, values), the entry to start on (su.val) and what the message rows say (su.note): the model in use chosen; one the list does not hold
* said, with the listed one that differs only in case chosen; no list yet (no key) or none from the provider said in the list's one row.
setup.items:
   su.items = ''
   su.val = 1
   su.note = ''
   if lm.ok and lm.n > 0 then
      su.items = change(lm.list, @fm, @vm)
      found = 0
      near = 0
      for i = 1 to lm.n
         if lm.list<i> = cur then
            su.val = i
            found = 1
         end
         if near = 0 and downcase(lm.list<i>) = downcase(cur) then near = i
      next i
      begin case
         case found
            su.note = nm.s : ' lists ' : lm.n : ' models; the one in use, ' : cur : ', is chosen.'
         case near
            su.val = near
            su.note = 'The model now set, ' : cur : ', is not in ' : nm.s : "'s list (model names are case-sensitive).  " : lm.list<near> : ' is chosen: Save to use it.'
         case cur # ''
            su.note = 'The model now set, ' : cur : ', is not in ' : nm.s : "'s list.  Choose one and Save."
         case 1
            su.note = nm.s : ' lists ' : lm.n : ' models.  Choose one and Save.'
      end case
   end else
      if pkey<pi> or key.done then
         su.items = '(no list from ' : nm.s : ')'
         su.note = nm.s : ' gave no list of models' : (if lm.why # '' then ': ' : lm.why else '') : '.  Type the model under Other name.'
      end else
         su.items = '(set the key first: the list comes from ' : nm.s : ')'
         su.note = 'No key is set for ' : nm.s : ' yet.  Type or paste it, then press Tab.'
      end
   end
   return

* The message rows of the dialog: su.say, wrapped
setup.say:
   call $tk_wrap(su.say, su.mw, pieces)
   for j = 1 to 3
      screen set sf, 'm' : j text pieces<j>[1, su.mw]
   next j
   return

* A new key in the Key entry (anything but the keep-stars or nothing) goes to the helper, then the list is asked with it and shown.  su.fetched is 1 when that happened.  The
* entry shows the keep-stars again afterwards; kv is cleared on every path.
setup.takekey:
   su.fetched = 0
   screen get sf, 'key' returning kv
   kv = trim(kv)
   if kv = su.keep or kv = '' then
      kv = ''
      return
   end
   if kv[1, len(su.keep)] = su.keep then kv = kv[len(su.keep) + 1, 9999]    ;* typed after the stars without clearing them
   gosub key.word
   if not(kw.ok) then
      kv = ''
      su.say = 'A key is 8 to 512 characters with no space and nothing outside plain ASCII.  Nothing was set.'
      gosub setup.say
      screen focus sf, 'key' else null
      return
   end
   gosub hand.key                                             ;* kv is cleared there, whatever happens
   if hk.err # '' then
      su.say = 'The key was not set: ' : hk.err
      gosub setup.say
      screen focus sf, 'key' else null
      return
   end
   key.done = 1
   screen set sf, 'key' value su.keep
   gosub fetch.models
   gosub setup.items
   screen set sf, 'model' items su.items
   screen set sf, 'model' value su.val
   su.say = 'The key for ' : nm.s : ' is set.  ' : su.note
   gosub setup.say
   if lm.ok and lm.n > 0 then
      screen focus sf, 'model' else null
   end
   su.fetched = 1
   return

* Save: the model from Other name when it is filled in (checked against the list when there is one), else the one chosen in the list.  su.done 1 and mv when it may be set.
setup.save:
   su.done = 0
   if not(pkey<pi>) and not(key.done) then
      su.say = 'No key is set for ' : nm.s : ': type or paste it first.'
      gosub setup.say
      screen focus sf, 'key' else null
      return
   end
   screen get sf, 'other' returning ov
   ov = trim(ov)
   if ov # '' then
      vw = ov
      vmax = 80
      gosub valid.word
      if not(vw.ok) then
         su.say = 'A model name has 1 to 80 letters, digits and . _ : / @ + , - and nothing else.'
         gosub setup.say
         screen focus sf, 'other' else null
         return
      end
      if lm.ok and lm.n > 0 then
         found = 0
         near = ''
         for i = 1 to lm.n
            if lm.list<i> = ov then found = 1
            if near = '' and downcase(lm.list<i>) = downcase(ov) then near = lm.list<i>
         next i
         if not(found) then
            su.say = nm.s : ' does not list a model named ' : ov : '.' : (if near # '' then '  It lists ' : near : ' (model names are case-sensitive).' else '  Choose one from the list.')
            gosub setup.say
            screen focus sf, 'other' else null
            return
         end
      end
      mv = ov
   end else
      if not(lm.ok and lm.n > 0) then
         su.say = 'There is no list to choose from: type the model under Other name.'
         gosub setup.say
         screen focus sf, 'other' else null
         return
      end
      screen get sf, 'model' returning li
      li = li + 0
      if li < 1 or li > lm.n then li = 1
      mv = lm.list<li>
   end
   su.done = 1
   return

* kw.ok 1 when kv is a word the helper takes as a key: 8 to 512 characters from ! to ~
key.word:
   kw.ok = (len(kv) >= 8 and len(kv) <= 512)
   if kw.ok then
      for kw.i = 1 to len(kv)
         kw.c = seq(kv[kw.i, 1])
         if kw.c < 33 or kw.c > 126 then
            kw.ok = 0
            exit
         end
      next kw.i
   end
   return

* The key in kv to the helper, through the hand-over file SET.AI KEY p HANDOVER reads and removes.  The directory is made SDSYS's and SYSTEM's alone (icacls: inheritance
* removed, full control to those two and nobody else - the Windows form of Linux's 0700) before the file is written in it, and the file is removed here as well, whatever
* SET.AI did.  kv is cleared.  hk.err is null when the helper has the key, otherwise what went wrong.  The paths go in single quotes, so the $ of $aikey is not a
* PowerShell variable; -LiteralPath, so no character in them is a wildcard.
hand.key:
   hk.err = ''
   hdir = @sdsys : @ds : '$aikey'
   hf = hdir : @ds : 'key'
   os.execute "$d = '" : hdir : "'; New-Item -ItemType Directory -Force -Path $d | Out-Null; icacls $d /inheritance:r /grant:r 'SDSYS:(OI)(CI)F' 'SYSTEM:(OI)(CI)F' | Out-Null; Remove-Item -LiteralPath (Join-Path $d 'key') -Force -ErrorAction SilentlyContinue"
   openseq hf to kf else
      if status() then
         hk.err = 'the hand-over file could not be made'
         kv = ''
         if not(unassigned(kf)) then close kf
         return
      end
   end
   writeseq kv to kf else hk.err = 'the hand-over file could not be written'
   close kf
   kv = ''
   if hk.err = '' then
      call $tk_runx(allow.set, 'set.ai key ' : p : ' handover', out, st, err)
      if err # '' then
         hk.err = err
      end else
         if st # 0 then hk.err = trim(change(out, @fm, ' '))[1, 100]
      end
   end
   os.execute "Remove-Item -LiteralPath '" : hf : "' -Force -ErrorAction SilentlyContinue"
   return

* The provider's list of model names (p), asked through SET.AI MODELS: lm.ok 1 with lm.list (one to a field) and lm.n; lm.ok 0 when there is none (lm.why says why)
fetch.models:
   lm.ok = 0 ; lm.list = '' ; lm.n = 0 ; lm.why = ''
   call $tk_runx(allow.set, 'set.ai models ' : p, out, st, err)
   if err # '' then
      lm.why = err
      return
   end
   if st # 0 then
      lm.why = trim(change(out, @fm, ' '))[1, 120]
      return
   end
   lm.ok = 1
   for i = 1 to dcount(out, @fm)
      if out<i>[1, 2] = '  ' and trim(out<i>) # '' then
         lm.n += 1
         lm.list<lm.n> = trim(out<i>)
      end
   next i
   return

* T (S.160; the owner, 7 Nov 26: "a standard text that will be included with every AI query describing where the default agent help text is located along any other
* information that will help the AI.  It can be accessed in a popup using a shortcut key on the AI selection pane.  It should be editable but supplied with the default
* text").  The text the helper keeps is shown in a box with an editor; Save puts it in place of the one in use, Shipped default takes the administrator's text away so that
* the default beside the helper is sent again.  The page checks the text as the helper and SET.AI will (printable ASCII and line feeds, 4000 characters) only to say so
* in the box; SET.AI CONTEXT decides, and puts it to the wall's screen.  THE SENTENCE IS RUN HERE, NOT BY $tk_runx: its one word is the text in hexadecimal, up to 8000
* characters, and $tk_runx takes 500.  The verb is fixed and the word is checked to be hexadecimal before it is run, so the sentence can hold nothing else.  The Run / Cancel
* box names the sentence with the word described, since the text itself was on the screen a moment before.
do.context:
   cx.cur = hj{'context'}
   cx.from = hj{'context-from'}
   call $sl_window(cx.scrw, cx.scrh)
   cx.w = cx.scrw - 8
   if cx.w > 120 then cx.w = 120
   cx.h = cx.scrh - 6
   if cx.h > 36 then cx.h = 36
   cx.x = int((cx.scrw - cx.w) / 2)
   cx.y = int((cx.scrh - cx.h) / 2)
   begin case
      case cx.from = 'own'
         cx.whose = "the administrator's own"
      case cx.from = 'default'
         cx.whose = 'the shipped default'
      case cx.from = 'bad'
         cx.whose = 'the kept text cannot be used, so none is sent'
      case 1
         cx.whose = 'none'
   end case
   screen form title 'Standing text sent with every AI request' at cx.x,cx.y size cx.w,cx.h returning cf
   screen label cf, 'l1', 'Sent first with every AI request; the person asking never sees it.  Now: ' : cx.whose : '.' at 2,1 width cx.w - 6
   screen label cf, 'l2', 'Plain English, 4000 characters at most.  Enter: new line.  Tab: the buttons.  Kept only after Save and Run.' at 2,2 width cx.w - 6
   screen memo cf, 'txt', convert(char(10), @fm, cx.cur) at 2,4 size cx.w - 6,cx.h - 10
   screen set cf, 'txt' wrap 1                                 ;* a long line is SHOWN on several rows; the text is not changed
   screen label cf, 'note', ' ' at 2,cx.h - 5 width cx.w - 6
   screen button cf, 'save', '&Save' at 2,cx.h - 3 default
   screen button cf, 'dflt', 'Shipped &default' at 14,cx.h - 3
   screen button cf, 'cancel', '&Cancel' at 36,cx.h - 3 cancel
   cx.act = ''
   loop
      screen wait cf returning cx.ev then                     ;* cx.ev, NOT ev: names fold case, and EV is the page's explanation rows
         if cx.ev<1> = 'resize' then                          ;* S.209: the box goes, the page follows the window, and the next wait shows the box over it
            screen hide cf
            gosub box.resized
         end
         if cx.ev<1> = 'button' then
            begin case
               case cx.ev<2> = 'cancel'
                  cx.act = 'cancel'
               case cx.ev<2> = 'dflt'
                  cx.act = 'default'
               case cx.ev<2> = 'save'
                  screen get cf, 'txt' returning cx.new
                  cx.new = trimb(convert(@fm, char(10), cx.new))
                  loop
                  while len(cx.new) > 0 and cx.new[len(cx.new), 1] = char(10) do
                     cx.new = cx.new[1, len(cx.new) - 1]
                  repeat
                  gosub context.check
                  if cx.bad # '' then
                     screen set cf, 'note' text cx.bad
                  end else
                     cx.act = 'save'
                  end
            end case
         end
      end else
         cx.act = 'cancel'                                     ;* Esc, or an input that ended
      end
   until cx.act # ''
   repeat
   screen hide cf
   gosub after.box
   gen += 1
   ctx<TK.C.GEN> = gen
   gosub draw.all
   begin case
      case cx.act = 'cancel'
         msg = 'the standing text is unchanged'
         return
      case cx.act = 'default'
         if cx.from = 'default' then
            msg = 'the standing text is already the shipped default'
            return
         end
         cx.sent = 'set.ai context -'
         cx.show = cx.sent
         el = ''
         el<-1> = "The administrator's standing text is removed, and the default shipped with SD is sent with every AI request from now on."
      case 1
         if cx.new = cx.cur and cx.from # 'bad' then
            msg = 'the standing text is unchanged'
            return
         end
         cx.sent = 'set.ai context ' : oconv(cx.new, 'MX0C')
         cx.show = 'set.ai context <the text above, ' : len(cx.new) : ' characters, as hexadecimal>'
         el = ''
         el<-1> = 'Every AI request from every account will begin with this text (' : len(cx.new) : ' characters); it is not shown in the preview.'
         el<-1> = 'A text that names SD' : "'" : 's own code or build is refused.'
   end case
   call $tk_confirm(cx.show, el, '', res, cmsg)
   if res # 'run' then
      msg = cmsg
      return
   end
   if downcase(field(cx.sent, ' ', 1)) # 'set.ai' or field(cx.sent, ' ', 2) # 'context' or dcount(cx.sent, ' ') # 3 then return
   cx.word = field(cx.sent, ' ', 3)
   if cx.word # '-' and convert('0123456789ABCDEFabcdef', '', cx.word) # '' then return       ;* the one word is hexadecimal (or -) and nothing else
   execute cx.sent trapping aborts capturing out
   said = trim(change(out, @fm, ' '))
   msg = (if said # '' then said[1, 130] else 'ran, status ' : @system.return.code)
   gosub read.all
   gosub draw.all
   return

* S.209: the page's own boxes (the key box and the standing text) run their own SCREEN WAIT, and a resize that comes while one is open is taken by the box: the
*   page never saw it and was drawn again at its old size.  So when a box closes the layout is asked again, which is the main loop's own resize step.
after.box:
   call $tk_layout('refresh', ctx, '', lay.chg)
   gosub lay.get
   gen += 1
   ctx<TK.C.GEN> = gen
   return

* A resize while a box is open: the page is laid out and drawn at the new size behind it (the box was hidden first; its next SCREEN WAIT shows it again on top)
box.resized:
   gosub after.box
   gosub draw.all
   call $tk_menubar('draw', ctx, keys, pnames<pane>, '', '', mr)      ;* the bar and the foot too: the main loop that draws them is waiting for the box
   call $tk_frame(ctx, keys, pnames<pane>, msg)
   return

* In: cx.new.  Out: cx.bad, null when the helper would take it, else what is wrong (said in the box)
context.check:
   cx.bad = ''
   if cx.new = '' then
      cx.bad = 'The text is empty.  To send the default again, choose Shipped default.'
      return
   end
   if len(cx.new) > 4000 then
      cx.bad = 'The text has ' : len(cx.new) : ' characters; at most 4000 are kept.'
      return
   end
   for cx.i = 1 to len(cx.new)
      cx.c = seq(cx.new[cx.i, 1])
      if cx.c # 10 and (cx.c < 32 or cx.c > 126) then
         cx.bad = 'Character ' : cx.i : ' is not plain text (only printable ASCII and new lines are kept).'
         return
      end
   next cx.i
   return

* Take the screen again after the terminal was given away; the window may have changed
reopen:
   call $tk_open('tool.ai', 'admin', ctx, err)
   if err # '' then
      display err
      done = 1
      return
   end
   call $tk_aipage('again', ctx, keys, '', '', aout)            ;* S.97 stage 2: the new context has no AI line yet; the settings may have changed in the command
   gosub lay.declare                                           ;* the new context holds no panes; the window may be another size
   gen += 1
   ctx<TK.C.GEN> = gen
   gosub read.all
   gosub draw.all
   msg = 'back from the key prompt: the key shows as set when it was accepted'
   return

* X: remove the key of the provider under the cursor
do.clearkey:
   p = provs<pi>
   nm.s = pnm<pi>
   if nm.s = '' then nm.s = 'Custom'
   if not(pkey<pi>) then
      msg = 'No key is set for ' : nm.s
      return
   end
   sent = 'set.ai key ' : p : ' clear'
   typed = ''
   el = ''
   el<-1> = 'The key for ' : nm.s : ' will be removed from the AI helper.  The AI cannot be used with it until a key is set again (press S).'
   use.x = 1
   gosub confirm.and.run
   return

* C: the Custom row, every field the administrator's
do.custom:
   if provs<pi> # 'custom' then
      msg = 'C fills in the Custom row: move the cursor to it first'
      return
   end
   v1 = (if purl<nprov> = '' then '' else pnm<nprov>)
   v2 = purl<nprov>
   v3 = pfmt<nprov>
   v4 = paut<nprov>
   v5 = pver<nprov>
   v6 = pmax<nprov>
   * S.88: one form with the six answers in view; a refusal names the field and the form stays
   spec = 'Custom AI connection' : @fm : '&Continue' : @fm : ''
   spec<-1> = 'name' : @vm : 'Name' : @vm : 40 : @vm : 40
   spec<-1> = 'url' : @vm : 'Address (https only)' : @vm : 100 : @vm : 300
   spec<-1> = 'layout' : @vm : 'Layout: anthropic, openai' : @vm : 12 : @vm : 12
   spec<-1> = 'auth' : @vm : 'Auth: bearer, x-api-key' : @vm : 12 : @vm : 12
   spec<-1> = 'version' : @vm : 'Version header (- none)' : @vm : 24 : @vm : 40
   spec<-1> = 'maxfield' : @vm : 'Length field' : @vm : 30 : @vm : 60
   fv = v1 : @fm : v2 : @fm : v3 : @fm : v4 : @fm : v5 : @fm : v6
   call $tk_form('open', ctx, spec, fv, fo)
   if fo = 'no' then
      msg = 'the form does not fit this window: nothing was changed'
      return
   end
   loop
      call $tk_form('run', ctx, fans, fv, fid)
      if fans # 'ok' then
         call $tk_form('close', ctx, '', '', '')
         return
      end
      v1 = trim(fv<1>) ; v2 = trim(fv<2>) ; v3 = downcase(trim(fv<3>)) ; v4 = downcase(trim(fv<4>)) ; v5 = trim(fv<5>) ; v6 = trim(fv<6>)
      if v5 = '' then v5 = '-'
      bad = '' ; fid = ''
      vmax = 40 ; vw = v1 ; gosub valid.word
      if not(vw.ok) then
         bad = 'the name (letters, digits and . _ : / @ + , -)' ; fid = 'name'
      end
      vmax = 300 ; vw = v2 ; gosub valid.word
      if bad = '' and (not(vw.ok) or v2[1, 8] # 'https://') then
         bad = 'the address (https://, no query string)' ; fid = 'url'
      end
      if bad = '' and v3 # 'anthropic' and v3 # 'openai' then
         bad = 'the request layout (anthropic or openai)' ; fid = 'layout'
      end
      if bad = '' and v4 # 'bearer' and v4 # 'x-api-key' then
         bad = 'the authentication (bearer or x-api-key)' ; fid = 'auth'
      end
      vmax = 40 ; vw = v5 ; gosub valid.word
      if bad = '' and not(vw.ok) then
         bad = 'the version header' ; fid = 'version'
      end
      vmax = 60 ; vw = v6 ; gosub valid.word
      if bad = '' and not(vw.ok) then
         bad = 'the answer length field' ; fid = 'maxfield'
      end
      if bad = '' then exit
      call $tk_form('say', ctx, 'Not accepted: ' : bad : '.  Nothing was changed', fid, '')
   repeat
   call $tk_form('close', ctx, '', '', '')
   sent = 'set.ai custom ' : v1 : ' ' : v2 : ' ' : v3 : ' ' : v4 : ' ' : v5 : ' ' : v6
   typed = 'custom'
   el = ''
   el<-1> = 'Custom will go to ' : field(v2, '/', 3) : ' over https, with the certificate checked, and the key is sent only to that address.'
   el<-1> = 'The helper checks the address again.  It is not used until you check Custom, set a model and a key.'
   use.x = 1
   gosub confirm.and.run
   return

* D: forget the Custom connection
do.dropcustom:
   if provs<pi> # 'custom' then
      msg = 'D removes the Custom row: move the cursor to it first'
      return
   end
   sent = 'set.ai custom clear'
   typed = ''
   el = ''
   el<-1> = 'The Custom connection is removed.  The helper refuses this while Custom is the provider in use.'
   use.x = 1
   gosub confirm.and.run
   return

* A: the file of certificate authorities the helper trusts (instead of the system store); a dash is the system store
do.ca:
   screen ask 'File of certificate authorities, written with / (a dash is the system store)' width 100 value ca title 'Certificate authorities' returning cv else return
   cv = trim(cv)
   vw = cv
   vmax = 300
   gosub valid.word
   if not(vw.ok) then
      msg = 'A file name here has letters, digits and . _ : / @ + , - and nothing else'
      return
   end
   sent = 'set.ai ca ' : cv
   el = ''
   if cv = '-' then
      typed = ''
      el<-1> = 'The helper will trust the system store of certificate authorities only (the delivered state).'
   end else
      typed = 'ca'
      el<-1> = 'The helper will trust ONLY the authorities in ' : cv : ', not the system store.'
      el<-1> = 'Whoever holds a key of one of those authorities can read what accounts send and the AI key.  Use a file you trust.'
   end
   use.x = 1
   gosub confirm.and.run
   return

* L: one limit
do.limit:
   screen ask 'Limit (requests-hour, tokens-day, timeout, bytes-request, bytes-reply or max-tokens)' width 16 title 'AI limit' returning ln else return
   ln = downcase(trim(ln))
   locate ln in lnames<1> setting lk else
      msg = ln : ' is not one of the six limits'
      return
   end
   screen ask 'New value for ' : ln : ' (it is ' : lim<lk> : ' now; a whole number)' width 10 title 'AI limit' returning lv else return
   lv = trim(lv)
   if lv = '' or len(lv) > 9 or trim(convert('0123456789', space(10), lv)) # '' then
      msg = 'A limit is a whole number of up to 9 digits'
      return
   end
   sent = 'set.ai limit ' : ln : ' ' : lv
   typed = ''
   el = ''
   el<-1> = 'The limit ' : ln : ' will be ' : lv : ' (it is ' : lim<lk> : ' now).  The helper checks the range.'
   el<-1> = 'requests-hour and tokens-day count what each account sends; the other four cap one request.'
   use.x = 1
   gosub confirm.and.run
   return

end

