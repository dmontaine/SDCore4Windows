* The sentence in sent, its effect in el, the name to be typed in typed (null for Run / Cancel); use.x is 1 for SET.AI (the wider word set), 0 for MODIFY.ACCOUNT
confirm.and.run:
   call $tk_confirm(sent, el, typed, res, cmsg)
   if res = 'run' then
      if use.x then
         call $tk_runx(allow.set, sent, out, st, err)
      end else
         call $tk_run(allow.acc, sent, out, st, err)
      end
      if err # '' then
         msg = err
      end else
         said = trim(change(out, @fm, ' '))
         msg = (if said # '' then said[1, 130] else 'ran, status ' : st)
      end
      gosub read.all
      gosub draw.all
   end else
      msg = cmsg
   end
   return

* Enter on a provider: check it (the one every account uses), or uncheck the one in use (the AI is then off)
select.provider:
   if not(helper.ok) then
      msg = sysmsg(12612)
      return
   end
   p = provs<pi>
   nm.s = pnm<pi>
   if nm.s = '' then nm.s = 'Custom'
   el = ''
   if p = sel then
      sent = 'set.ai provider none'
      typed = ''
      el<-1> = 'The AI will be off for every account: no provider will be selected.'
      el<-1> = 'The model, the key and the ai gate of each account stay as they are.'
   end else
      sent = 'set.ai provider ' : p
      typed = p
      el<-1> = 'From now on every account whose ai gate is on will use ' : nm.s : '.'
      host = field(purl<pi>, '/', 3)
      if host # '' then el<-1> = 'The text they send leaves this machine for ' : host : ' over https.'
      if pmod<pi> = '' and pdef<pi> = '' then el<-1> = 'No model is set for it yet, so it cannot be used until you press S.'
      if pmod<pi> = '' and pdef<pi> # '' then el<-1> = 'It will ask its default model, ' : pdef<pi> : ' (M names another).'
      if not(pkey<pi>) then el<-1> = 'No key is set for it yet, so it cannot be used until you press S.'
      if p = 'custom' and purl<pi> = '' then el<-1> = 'Custom is not filled in yet: press C first (the helper refuses it until then).'
   end
   el<-1> = 'It takes effect at once.'
   use.x = 1
   gosub confirm.and.run
   return

* Enter on an account: its ai gate, on or off
toggle.gate:
   if an = 0 then return
   an.name = anm<ci>
   on.now = (ast<ci> = 1)
   sent = 'modify.account ' : an.name : ' ' : (if on.now then 'ai-off' else 'ai-on')
   el = ''
   typed = ''
   if on.now then
      el<-1> = an.name : ' will no longer be able to send anything to the AI.  Nothing else about the account changes.'
   end else
      typed = an.name
      lpid = sel
      gosub locate.prov
