* START-DESCRIPTION:
*
*   CALL !LISTU(DATA)
*
* Returns the raw data behind the LISTU command: one field for each user,
* ordered by user number, each of whose values is, in order,
*
*    1  user number           5  parent user number (phantoms), else 0
*    2  operating system pid  6  login user name
*    3  IP address            7  terminal device name
*    4  process flags (bits)  8  login time, seconds since 1 Jan 1970
*
* The values are those the kernel keeps for K$USERS and the flag bits are
* the USR$ values of INT$KEYS.H, so a program can test them with BITAND().
* The account a user is in is not among them: the kernel does not record it.
*
* END-DESCRIPTION
*
* START-CODE

$internal
$no.xref
subroutine listu(data)
$catalog !LISTU

$include syscom.h
$include keys.h
$include int$keys.h

   data = ''
   unsorted = kernel(K$USERS, 0)
   if unsorted = '' then return

   keys = ''
   for i = 1 to dcount(unsorted, @fm)
      uid = unsorted<i,K$USERS.UID> + 0
      locate uid in keys<1> by 'AR' setting pos else null
      ins uid before keys<pos>
      ins unsorted<i> before data<pos>
   next i

   return
end

* END-CODE
