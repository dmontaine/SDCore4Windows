* START-DESCRIPTION:
*
*   INHIBIT.LOGIN {ON | OFF}
*
* ON stops new sessions, local and API, until OFF or until the session that set it has gone; sessions already running
* are not touched, and neither are phantoms the setter starts.  OFF allows logins again.  With neither word the state
* is shown.  @SYSTEM.RETURN.CODE is the user number of the session that set the inhibit, or zero when logins are
* allowed (so after ON it equals @USERNO, after OFF it is zero).
*
* Administrator only.  The administrator can always sign in to switch it off, from any session.  See !login_inhibit.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program inhibit.login
$catalog $inhibit

$include parser.h
$include err.h
$include int$keys.h

   @system.return.code = -ER$ARGS      ;* Preset for command format errors

   if not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001) ;* Command requires administrator privileges
   end

   call !parser(parser$reset, 0, @sentence, 0)
   call !parser(parser$get.token, token.type, token, keyword) ;* Verb

   action = ''
   call !parser(parser$get.token, token.type, token, keyword)
   if token.type # PARSER$END then
      begin case
         case upcase(token) = 'ON'  ; action = 'ON'
         case upcase(token) = 'OFF' ; action = 'OFF'
         case 1
            stop sysmsg(2018, token) ;* Unexpected token (xx)
      end case
      call !parser(parser$get.token, token.type, token, keyword)
      if token.type # PARSER$END then stop sysmsg(2018, token)
   end

   begin case
      case action = 'ON'
         call !login_inhibit('SET', info, err)
         if err # '' then
            stop sysmsg(err<1,1>, err<1,2>, err<1,3>)
         end
         void kernel(K$AUDIT, 'inhibit.login on')
      case action = 'OFF'
         call !login_inhibit('CLEAR', info, err)
         if err # '' then
            stop sysmsg(err<1,1>, err<1,2>, err<1,3>)
         end
         void kernel(K$AUDIT, 'inhibit.login off')
         info = ''
      case 1
         call !login_inhibit('STATE', info, err)
         if err # '' then
            stop sysmsg(err<1,1>, err<1,2>, err<1,3>)
         end
   end case

   if info = '' then
      display sysmsg(12288) ;* Logins are allowed
      @system.return.code = 0
   end else
      display sysmsg(12289, info<3>, info<1>) ;* Logins are inhibited by %1 (user %2)
      @system.return.code = info<1>
   end

end

* END-CODE
