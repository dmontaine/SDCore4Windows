*
* START-DESCRIPTION:
*
*    seal = !ipc_seal('make',  nonce, '',   cmd, dq, log)
*    ok   = !ipc_seal('check', nonce, seal, cmd, dq, log)
*
*    $ipc is a file every SD user's process may write, so the records PHANTOM leaves in it for the new process (the
*    command in Xn, the DATA lines in Dn, the log file name in Ln) are not believed on their own.  PHANTOM seals them with a secret it
*    gives only to the process it starts (K$PHANTOM.NONCE: the new process's environment, which only the same operating-system user can
*    read), and the new process, CPROC, runs what they hold only if the seal checks.
*
*    The seal is HMAC-SHA256, keyed by the secret, over the three values, each turned into hexadecimal (so that no mark or other byte can
*    move from one value to the next) and joined with colons.  'make' answers the seal (base64), the null string if it could not be made.
*    'check' answers 1 only when the secret is present, the seal is present, and the seal given equals the one these values make
*    (compared in constant time); 0 for anything else, including an SDEXT error.
*
* END-DESCRIPTION
*
* START-CODE

$internal
function ipc_seal(mode, nonce, seal, cmd, dq, logf)
$catalog !ipc_seal

$include keys.h

   set.status 0
   checking = (mode = 'check')

   if len(nonce) < 16 then
      if checking then return 0
      return ''
   end

   signed = oconv(cmd, 'MX0C') : ':' : oconv(dq, 'MX0C') : ':' : oconv(logf, 'MX0C')
   mac = SDEXT(nonce : @FM : signed, @TRUE, SD_HMACSHA256)

   if not(checking) then return mac

   if mac = '' or seal = '' then return 0
   if SDEXT(mac : @FM : seal, @TRUE, SD_CTEQUAL) = '1' then return 1
   return 0
end

* END-CODE
