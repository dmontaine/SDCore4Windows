*****************************************************************************
* VALIDATE.ACTIONS  -  every word of the command, BEFORE ANY OF THEM IS DONE
*
* 25 Oct 26 Windows port - from Linux 1daee9d.  actions holds the words in capitals and typed.list the same words as typed.  Nothing is changed here,
*   and every refusal ends the program (stop), so a command is carried out whole or not at all as far as its WORDS go:
*     - ADD and DELETE take a user name and stand alone: among other words they are refused with 12719;
*     - a word that is not an action is refused with 12795, as typed;
*     - two different words of the same slot set one access to different states (sh-on and sh-off, or ssh and api: say both) and are refused
*       with 12796.
*   word.arr is also the ORDER the words are carried out in (run.actions): the routes, the register switches, and the suspension last.  slot.arr
*   holds the slot of each word.  do.action's case lines are the third list.  (Linux's net, files, ai, start and pins words came later: the
*   last of them, ai-on / ai-off, on 13 Nov 26.)  The conflict test compares DIFFERENT words only: the same word twice is one action (want.at is set once).

validate.actions:
   word.arr = convert(',', @fm, 'SSH,API,BOTH,NONE,SH-ON,SH-OFF,OS-ON,OS-OFF,SD-ON,SD-OFF,VOC-ON,VOC-OFF,BP-ON,BP-OFF,DICT-ON,DICT-OFF,RECOVERY-ON,RECOVERY-OFF,XFER-ON,XFER-OFF,NET-ON,NET-OFF,SHARED-READ-ON,SHARED-READ-OFF,SHARED-WRITE-ON,SHARED-WRITE-OFF,FILES-ON,FILES-OFF,FILES-WRITE-ON,FILES-WRITE-OFF,FILES-ADMIN-ON,FILES-ADMIN-OFF,AI-ON,AI-OFF,SSH-KEY-ON,SSH-KEY-OFF,START-MENU,START-TERMINAL,START-DEFAULT,PINS-ON,PINS-OFF,SUSPENDED,UNSUSPENDED')
   slot.arr = convert(',', @fm, 'R,R,R,R,SH,SH,OS,OS,SD,SD,VOC,VOC,BP,BP,DICT,DICT,RC,RC,XF,XF,NET,NET,SR,SR,SW,SW,F,F,FW,FW,FA,FA,AI,AI,KY,KY,ST,ST,ST,PN,PN,S,S')
   n.words = dcount(actions, @fm)
   pos.of = ''
   want.at = ''
   for i = 1 to n.words
      w = actions<i>
      if (w = 'ADD') or (w = 'DELETE') then
         @system.return.code = -ER$ARGS
         stop sysmsg(12719, typed.list<i>)  ;* add and delete take a user name and stand alone, and nothing was changed: %1 was not carried out
      end
      locate w in word.arr<1> setting p else
         @system.return.code = -ER$ARGS
         stop sysmsg(12795, typed.list<i>)  ;* %1 is not a modify.account action, and nothing was changed
      end
      pos.of<i> = p
      want.at<p> = 1
   next i
   for i = 1 to n.words - 1
      for j = i + 1 to n.words
         if actions<i> # actions<j> then
            pi = pos.of<i>
            pj = pos.of<j>
            if slot.arr<pi> = slot.arr<pj> then
               @system.return.code = -ER$ARGS
               stop sysmsg(12796, downcase(actions<i>), downcase(actions<j>))  ;* %1 and %2 set the same access to different states, and nothing was changed
            end
         end
      next j
   next i
* Linux 19 Oct 26: files-write-on asks for sdfiles, so files-off conflicts with it (they sit in different slots, which the test above cannot see).
   locate 'FILES-OFF' in actions<1> setting p1 then
      locate 'FILES-WRITE-ON' in actions<1> setting p2 then
         @system.return.code = -ER$ARGS
         stop sysmsg(12796, 'files-off', 'files-write-on')
      end
   end
* 21 Oct 26 dm - S.73 item 3: files-admin-on asks for the groups below it, so it is refused with the word that takes one of them away (files-off takes all three, files-write-off the
*   top two) - the same reasoning, one level up.
   locate 'FILES-ADMIN-ON' in actions<1> setting p3 then
      locate 'FILES-OFF' in actions<1> setting p1 then
         @system.return.code = -ER$ARGS
         stop sysmsg(12796, 'files-off', 'files-admin-on')
      end
      locate 'FILES-WRITE-OFF' in actions<1> setting p2 then
         @system.return.code = -ER$ARGS
         stop sysmsg(12796, 'files-write-off', 'files-admin-on')
      end
   end
   return

*****************************************************************************
* RUN.ACTIONS  -  the words, one after the other, each through do.action
*
* 25 Oct 26 Windows port - from Linux 1daee9d.  In the order of word.arr (validate.actions made it), whatever order they were typed.  Each action
*   reports itself and audits itself exactly as it did when it was the only one; the account's record is read again before each (an earlier action
*   wrote it).  An action is "carried out" when it left @system.return.code at 0, which includes "already had that access; nothing changed"; a
*   refusal or a failed write leaves a negative code.  A run of more than one ends with one line: 12798 when every action was carried out, 12799
*   naming the ones that were not (a Windows group change can fail after a register write succeeded, and the line says so rather than leaving the
*   person to count).  The code after the run is 0 only if every action was carried out.  The remaining actions are still attempted after a failure:
*   they are independent accesses, and each says what it did.

run.actions:
   run.list = ''
   for p = 1 to dcount(word.arr, @fm)
      if want.at<p> then run.list<-1> = word.arr<p>
   next p
   n.run = dcount(run.list, @fm)
   done.list = ''
   undone.list = ''
   for i = 1 to n.run
      action = run.list<i>
      read acc.rec from acc.f, acc.name else null
      @system.return.code = 0
      gosub do.action
      if @system.return.code = 0 then
         done.list<-1> = downcase(action)
      end else
         undone.list<-1> = downcase(action)
      end
   next i
   if n.run > 1 then
      if undone.list = '' then
         crt sysmsg(12798, acc.name, n.run, change(done.list, @fm, ', '))  ;* Account %1: %2 actions carried out: %3
      end else
         if done.list = '' then done.said = 'none' else done.said = change(done.list, @fm, ', ')
         crt sysmsg(12799, acc.name, done.said, change(undone.list, @fm, ', '))  ;* Account %1: NOT every action was carried out. Done: %2. Not done: %3
      end
   end
   if undone.list = '' then
      @system.return.code = 0
   end else
      @system.return.code = -ER$FAILED
   end
   return

*****************************************************************************
* START.SET  -  MODIFY.ACCOUNT <account> START-MENU | START-TERMINAL | START-DEFAULT
*
* 25 Oct 26 Windows port - from Linux 858d757 (22 Oct 26), S.75 (the home screen; owner: "terminal or menu determined by admin for each account (another gate) - default
*   menu").  Field 16 of the register record (ACC$START): menu, terminal, or blank for "follow the system default" (SET.START.DEFAULT).  Any account type may have it, as
*   SD-ON may.  It takes effect at the next sign-on, and at the next LOGTO into the account.  start.want carries the state; the state it already has is "already" (12874)
*   and changes nothing.

start.set:
   start.was = downcase(trim(acc.rec<ACC$START>))
   if start.was = start.want then
      crt sysmsg(12874, acc.name)  ;* %1 already starts that way; nothing changed
      return
   end
   readu acc.new from acc.f, acc.name else acc.new = acc.rec
   acc.new<ACC$START> = start.want
   acc.written = @true
   write acc.new to acc.f, acc.name on error acc.written = @false
   if not(acc.written) then
      release acc.f, acc.name
      @system.return.code = -ER$FAILED
      crt sysmsg(10114, acc.name)  ;* Unable to change the state of %1; its state in the register is unchanged
      return
   end
   @system.return.code = 0
   void kernel(K$AUDIT, 'modify.account ' : downcase(action) : ' account=' : acc.name)
   crt sysmsg(12873, acc.name, if start.want = '' then 'system default' else start.want)  ;* Account %1 starts at: %2
   return

*****************************************************************************
* SET.SUSPENDED  -  MODIFY.ACCOUNT <account> SUSPENDED
*
* 18 Sep 26 Windows port - RELEASE_1.1 64.  The suspension is its own flag: field 5, blank in service and SUSPENDED suspended.  LOGIN (local
*   sign-in and ssh), CPROC's logto.authorised and APISRVR's vb.account refuse it.  NOTHING IS WITHDRAWN ON WINDOWS - no group membership, no
*   VOC change - which is the owner's ruling and is what makes lifting one free.  Field 6 (the retired ACC$PRIOR.TIER) is cleared.
*
*   NOBODY SUSPENDS THE ACCOUNT THEY LOGGED IN TO OR STAND IN (10112): @logname is the account you log in to, @who the one you stand in after a
*   LOGTO; suspending either from inside it leaves a session that works until it ends and then cannot be re-established.
*
* 18 Nov 26 Windows port - D3: tier.set, split into Linux's set.suspended and set.unsuspended.  The register is read again under a lock before the
*   flag is written, and a failed write is reported (10114), not dropped.

set.suspended:
   if upcase(trim(acc.rec<ACC$SUSPENDED>)) = 'SUSPENDED' then
      crt sysmsg(10110, acc.name, 'SUSPENDED')  ;* %1 is already %2; nothing changed
      return
   end
   if (acc.name = downcase(@logname)) or (acc.name = downcase(@who)) then
      @system.return.code = -ER$FAILED
      crt sysmsg(10112)  ;* You cannot suspend your own account or the one you are standing in
      return
   end

   readu acc.new from acc.f, acc.name else acc.new = acc.rec
   acc.new<ACC$SUSPENDED> = 'SUSPENDED'
   acc.new<ACC$PRIOR.TIER> = ''
   acc.written = @true
   write acc.new to acc.f, acc.name on error acc.written = @false
   if not(acc.written) then
      release acc.f, acc.name
      @system.return.code = -ER$FAILED
      crt sysmsg(10114, acc.name)  ;* Unable to change the state of %1; its state in the register is unchanged
      return
   end

   @system.return.code = 0
   void kernel(K$AUDIT, 'modify.account suspend account=' : acc.name)
   crt sysmsg(10193, acc.name)  ;* Account %1 is now suspended
*  1 Sep 26 Windows port - PRE_RELEASE_FIXES 111 (owner: "suspend an account and all sd access is unavailable - nothing happens at the windows level is correct -
*  a message to the administrator to that effect might be good").  17 Nov 26 (P-3215, owner's answer 5b): 10159 keeps only that Windows fact - the Windows account,
*  its password, its groups and any administrator rights are left as they were.  It may be several lines (newlines in a message file become field marks).
   susp.msg = sysmsg(10159, acc.name)
   for susp.i = 1 to dcount(susp.msg, @FM)
      crt susp.msg<susp.i>
   next susp.i
   return

*****************************************************************************
* SET.UNSUSPENDED  -  MODIFY.ACCOUNT <account> UNSUSPENDED
*
* 18 Sep 26 Windows port - RELEASE_1.1 64: the way back is a keyword of its own, because there is no tier to name.  Clears the flag and the
*   retired field 6.

set.unsuspended:
   if upcase(trim(acc.rec<ACC$SUSPENDED>)) # 'SUSPENDED' then
      crt sysmsg(10194, acc.name)  ;* %1 is not suspended; nothing changed
      return
   end

   readu acc.new from acc.f, acc.name else acc.new = acc.rec
   acc.new<ACC$SUSPENDED> = ''
   acc.new<ACC$PRIOR.TIER> = ''
   acc.written = @true
   write acc.new to acc.f, acc.name on error acc.written = @false
   if not(acc.written) then
      release acc.f, acc.name
      @system.return.code = -ER$FAILED
      crt sysmsg(10114, acc.name)  ;* Unable to change the state of %1; its state in the register is unchanged
      return
   end

   @system.return.code = 0
   void kernel(K$AUDIT, 'modify.account unsuspended account=' : acc.name)
   crt sysmsg(10192, acc.name)  ;* Account %1 is no longer suspended
   return

*****************************************************************************
* SET.ROUTE  -  MODIFY.ACCOUNT <account> SSH | API | BOTH | NONE
*
* 21 Aug 26 Windows port - want.ssh and want.api are set by the caller; membership of sdssh and sdapi IS the route (sdssh is what sshd's
*   AllowGroups names, sdapi what APISRVR tests after the SCRAM proof), so nothing is written to the register.  It reports the RESULTING
*   state, not the transition, and "nothing changed" separately (10080).
*
* 18 Nov 26 Windows port - D3: account.user, route.set, route.apply and say.access, in Linux's set.route shape.
*   THE WINDOWS USER IS THE ONE THE ACCOUNT'S GROUP NAMES (sdu_<user>), as set.files, set.ai and set.sshkey read it; a group account (sdg_) is
*   refused with 10087 and any other with 10081 status 2, as they say it.
*   THE LOOKUP IS THREE-VALUED: !is_grp_member answers @false both for "not a member" and for "could not tell", and tells them apart only by
*   status().  An unreadable membership changes NOTHING and says so (10081 with the status); a person who is not in sdusers is 10081 status 2.
*   THE API HALF RUNS ONLY IF THE ssh HALF SUCCEEDED: a failure part way is reported with its status, never summarised as though it had worked.
*   No sdsshonly guard: that group carries the deny-logon rights and no verb here touches it.  A Windows access token fixes group membership at
*   sign-in, so a route GRANTED mid-session may need a new sign-in before anything token-based agrees; sshd and APISRVR ask at each connection.

set.route:
   if group.name[1,4] # 'sdu_' then
      @system.return.code = -ER$FAILED
      if group.name[1,4] = 'sdg_' then
         crt sysmsg(10087, acc.name)  ;* %1 is a group account and has no remote access; reach it with logto
      end else
         crt sysmsg(10081, acc.name, 2)  ;* Unable to change remote access for %1, status: %2
      end
      return
   end
   route.user = group.name[5,999]

   if not(valid_os_name(route.user)) then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, 2)  ;* Unable to change remote access for %1, status: %2
      return
   end

   in.sdusers = is_grp_member(route.user, 'sdusers')
   route.stat = status()
   if route.stat # 0 or not(in.sdusers) then
      @system.return.code = -ER$FAILED
      if route.stat = 0 then route.stat = 2
      crt sysmsg(10081, acc.name, route.stat)
      return
   end

   has.ssh = is_grp_member(route.user, 'sdssh')
   route.stat = status()
   if route.stat = 0 then
      has.api = is_grp_member(route.user, 'sdapi')
      route.stat = status()
   end
   if route.stat # 0 then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, route.stat)
      return
   end

   if (has.ssh = want.ssh) and (has.api = want.api) then
      @system.return.code = 0
      crt sysmsg(10080, acc.name)  ;* %1 already had that access; nothing changed
      return
   end

   if has.ssh # want.ssh then
      if want.ssh then
         route.stat = os_group("ADDMEM", 'sdssh', route.user)
      end else
         route.stat = os_group("DELMEM", 'sdssh', route.user)
      end
   end

   if route.stat = 0 and (has.api # want.api) then
      if want.api then
         route.stat = os_group("ADDMEM", 'sdapi', route.user)
      end else
         route.stat = os_group("DELMEM", 'sdapi', route.user)
      end
   end

   if route.stat # 0 then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, route.stat)
      return
   end

   @system.return.code = 0
*  6 Oct 26 Windows port - RELEASE_1.1 128: the route change is audited, with the same words SD Core for Linux uses.
   route.said = 'none'
   if want.ssh and want.api then route.said = 'both'
   if want.ssh and not(want.api) then route.said = 'ssh'
   if want.api and not(want.ssh) then route.said = 'api'
   void kernel(K$AUDIT, 'modify.account route ' : route.said : ' account=' : acc.name)

   begin case
      case want.ssh and want.api
         crt sysmsg(10078, acc.name)  ;* SD routes for %1: ssh and the API.
      case want.ssh
         crt sysmsg(10076, acc.name)  ;* SD routes for %1: ssh only, not the API.
      case want.api
         crt sysmsg(10077, acc.name)  ;* SD routes for %1: the API only, not ssh.
      case 1
         crt sysmsg(10079, acc.name)  ;* %1 has no remote access: not ssh, not the API
   end case

*  PRE_RELEASE_FIXES 125: warn (non-prohibitively) when the access just set has no transport on this machine, as create.account does.  The grant
*  stands and takes effect when the transport comes on.  Native checks only: sshd.exe on disk (the Windows feature's place or the OpenSSH MSI's,
*  RELEASE_1.1 121), and sd.conf's APIPORT for the listener.
   if want.ssh and not(ospath('C:\WINDOWS\System32\OpenSSH\sshd.exe', OS$EXISTS)) and not(ospath('C:\Program Files\OpenSSH\sshd.exe', OS$EXISTS)) then
      crt sysmsg(10161, acc.name)  ;* %1 is set up for ssh, but this machine has no ssh server yet
   end
   if want.api and (config('APIPORT') + 0) <= 0 then
      crt sysmsg(10162, acc.name)  ;* %1 is set up for the API, but this machine provides no API listener yet
   end
   return

* ======================================================================
* SET.FILES  -  MODIFY.ACCOUNT <account> FILES-ON | FILES-OFF | FILES-WRITE-ON | FILES-WRITE-OFF
*
* 18 Oct 26 dm - S.65 write group (Linux 3fbfc0d).  files.grp is set by the caller with files.want: 'sdfiles' for the first pair, 'sdfileswrite' for the second.
*
* 25 Oct 26 Windows port - from Linux 96d8be8 (17 Oct 26), S.65 slice 2c.  files.want is set by the caller.  Membership of the Windows group
* sdfiles IS the files-only route (as sdapi is the API route), so nothing is written to the register.  Same call as route.apply: os_group.
*
* THE WINDOWS USER IS THE ONE THE ACCOUNT'S GROUP NAMES (sdu_<user>), which is what ACC_OS_INFO reads for the manifest, so the state line, the
* manifest and the login agree.
*
* AS ROUTE.APPLY, THE LOOKUP IS THREE-VALUED: !is_grp_member answers @false for "not a member" and for "could not tell" and tells them apart only
* by status().  An unreadable group changes NOTHING and says so (10081 with the status).  Three further refusals:
*   - a group (sdg_) or other account has no Windows user: 10087 for a group, 10081 for the rest, as the api word ends up saying;
*   - FILES-ON for a person who is not in sdusers: the login would refuse them first (10073), so the group is not added to look like access;
*   - FILES-ON when the Windows group sdfiles does not exist on this machine (an install from before this release has not made it yet):
*     10024 names it, and nothing is changed.
*   The state line (12487) is read back from the group after the change, not taken from the request, and a read back that does not show the
*   wanted state is reported as a failure (10081), never as a success.  sdapi is not touched: a person in both groups has the whole API (sdapi
*   wins at login).
set.files:
   if group.name[1,4] # 'sdu_' then
      @system.return.code = -ER$FAILED
      if group.name[1,4] = 'sdg_' then
         crt sysmsg(10087, acc.name)  ;* %1 is a group account and has no remote access; reach it with logto
      end else
         crt sysmsg(10081, acc.name, 2)  ;* Unable to change remote access for %1, status: %2
      end
      return
   end
   files.user = group.name[5,999]

   if not(valid_os_name(files.user)) then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, 2)
      return
   end

   gosub read.files.groups
   if files.stat = 0 and files.want then
      in.sdusers = is_grp_member(files.user, 'sdusers')
      files.stat = status()
      if files.stat = 0 and not(in.sdusers) then files.stat = 2
   end
   if files.stat # 0 then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, files.stat)
      return
   end

* 19 Oct 26 dm - K4a.  All three groups are read (read.files.groups), three-valued, BEFORE the "already had it" answer: a person can be in sdfileswrite and not in
*   sdfiles (a removal that stopped half way, or a hand-made change), and that membership is inert until the next FILES-ON turns it into write access the administrator did not
*   give.  So FILES-OFF has work to do for a person who is in either group, and FILES-ON takes a stray write membership away BEFORE it adds sdfiles.
*   21 Oct 26 dm - S.73 item 3 (Linux ef9d594): the same holds one level up.  sdfilesadmin is the third level (files, files-write, files-admin): a group is never added to a person who
*   holds a group ABOVE it, and a group above is taken away first, top down, so a leftover can never turn into access nobody gave.

* 18 Oct 26 dm - S.65 write group: sdfileswrite on its own gives nothing (the login route needs sdfiles), so it is not handed out to a person without
*   it.  Asked before the "already had it" answer so that the refusal is the same whatever the group holds now.
   if files.grp = 'sdfileswrite' and files.want then
      if not(has.files) then
         @system.return.code = -ER$FAILED
         crt sysmsg(12528, acc.name)  ;* %1 does not have FILES access, so it cannot be given FILES-WRITE: use files-on first
         return
      end
   end

* 21 Oct 26 dm - S.73 item 3: sdfilesadmin gives nothing without sdfiles AND sdfileswrite (the server asks for all three), so it is not handed out to a person without
*   both.  One message for either lack: files-write-on is what to do first, and it says "use files-on first" itself when files access is what is missing.
   if files.grp = 'sdfilesadmin' and files.want then
      if not(has.files) or not(has.write) then
         @system.return.code = -ER$FAILED
         crt sysmsg(12531, acc.name)  ;* %1 does not have files-write, so it cannot be given files-admin: use files-write-on first
         return
      end
   end

* Nothing to do: FILES-ON for a person who is in sdfiles already (whatever the groups above hold: they were given on purpose), FILES-OFF for a person who is in none of the three,
* FILES-WRITE-OFF for a person who is in neither sdfileswrite nor sdfilesadmin, and FILES-WRITE-ON / the admin words for a person who has the group already, or has not.
   if files.grp = 'sdfiles' and not(files.want) then
      nothing.to.do = not(has.files) and not(has.write) and not(has.admin)
   end else
      if files.grp = 'sdfileswrite' and not(files.want) then
         nothing.to.do = not(has.write) and not(has.admin)
      end else
         nothing.to.do = (has.target = files.want)
      end
   end
   if nothing.to.do then
      @system.return.code = 0
      crt sysmsg(10080, acc.name)  ;* %1 already had that access; nothing changed
      return
   end

   if files.want then
      files.found = is_group(files.grp)
      files.stat = status()
      if files.stat # 0 then
         @system.return.code = -ER$FAILED
         crt sysmsg(10081, acc.name, files.stat)
         return
      end
      if not(files.found) then
         @system.return.code = -ER$FAILED
         crt sysmsg(10024, files.grp)  ;* %1 is not a valid Windows group
         return
      end
   end

* 19 Oct 26 dm - K4a (Linux 0bdc4bd).  THE WRITE GROUP GOES FIRST, for FILES-OFF (so a failure of the second removal leaves the person with read access and no more, never write
*   access without read: the orphan the 18 Oct build could leave) and for FILES-ON with a stray membership (so sdfiles is not added to a person who already holds write).  Each
*   removal is read back by change.files.group before the next step, and a removal that did not happen stops everything with 10081 and the state as it was.
*   21 Oct 26 dm - S.73 item 3: the same for the third level, TOP DOWN: sdfilesadmin goes first, then sdfileswrite, then the group asked for.  A command on sdfiles (on over a
*   stray membership, or off) takes whichever of the two the person holds; a command on sdfileswrite takes sdfilesadmin (write-off: it would be left without the write it needs;
*   write-on: a stray one would become admin access nobody gave).  A step that fails after an earlier one went says what did happen (report.removals) before it says it failed.
   admin.removed = @false
   write.removed = @false
   if (files.grp = 'sdfiles' or files.grp = 'sdfileswrite') and has.admin then
      cg.group = 'sdfilesadmin'
      cg.want = @false
      gosub change.files.group
      if files.stat # 0 then
         @system.return.code = -ER$FAILED
         crt sysmsg(10081, acc.name, files.stat)
         return
      end
      now.admin = cg.now
      admin.removed = @true
   end
   if files.grp = 'sdfiles' and has.write then
      cg.group = 'sdfileswrite'
      cg.want = @false
      gosub change.files.group
      if files.stat # 0 then
         @system.return.code = -ER$FAILED
         gosub report.removals  ;* sdfilesadmin may have gone before this step
         crt sysmsg(10081, acc.name, files.stat)
         return
      end
      now.write = cg.now
      write.removed = @true
   end

* The group itself - except for a person who is not in it (FILES-OFF for one who was in a group above only, FILES-WRITE-OFF for one who held sdfilesadmin only): there is
* nothing in it to take away.
   if not(files.want) and not(has.target) then
      now.files = @false
      files.stat = 0
   end else
      cg.group = files.grp
      cg.want = files.want
      gosub change.files.group
      now.files = cg.now
   end
   if files.stat # 0 then
      @system.return.code = -ER$FAILED
*     A group above HAS gone and the step after it failed: the person has lost that access, and neither the screen nor the audit trail may say otherwise.  The audit
*     lines are the removals that happened (files-admin-off, files-write-off), not the action asked for: files-off and files-on are written only when the whole command worked.
      gosub report.removals
      crt sysmsg(10081, acc.name, files.stat)
      return
   end

   @system.return.code = 0
   void kernel(K$AUDIT, 'modify.account ' : downcase(action) : ' account=' : acc.name)
   if admin.removed then gosub admin.removed.line  ;* sdfilesadmin went too (or a stray one was taken away)
   begin case
      case files.grp = 'sdfilesadmin'
         crt sysmsg(12530, acc.name, if now.files then 'yes' else 'no')  ;* Account %1 has files-admin %2
      case files.grp = 'sdfileswrite'
         crt sysmsg(12527, acc.name, if now.files then 'yes' else 'no')  ;* Account %1 has files-write %2
      case 1
         if write.removed then gosub write.removed.line  ;* the write group went too (or a stray one was taken away)
         crt sysmsg(12487, acc.name, if now.files then 'yes' else 'no')  ;* Account %1 has files %2
   end case
   return

*****************************************************************************
* WRITE.REMOVED.LINE  -  the line for a write group that was taken away (FILES-OFF, or FILES-ON over a stray membership): 12527 with the state read back.  The success path and the
* failure of the step after the removal print the same line (finish 2, Linux d93ea0d).

write.removed.line:
   crt sysmsg(12527, acc.name, if now.write then 'yes' else 'no')  ;* Account %1 has files-write %2
   return

*****************************************************************************
* ADMIN.REMOVED.LINE  -  the same for sdfilesadmin (21 Oct 26, S.73 item 3): 12530 with the state read back from the group, printed before the line of the group below it.

admin.removed.line:
   crt sysmsg(12530, acc.name, if now.admin then 'yes' else 'no')  ;* Account %1 has files-admin %2
   return

*****************************************************************************
* REPORT.REMOVALS  -  a step failed after a group above it had gone: the audit line and the state line of each removal that happened, top down (21 Oct 26, S.73 item 3; the
* write group's part is the 19 Oct finish-2 rule, verifier finding).

report.removals:
   if admin.removed then
      void kernel(K$AUDIT, 'modify.account files-admin-off account=' : acc.name)
      gosub admin.removed.line
   end
   if write.removed then
      void kernel(K$AUDIT, 'modify.account files-write-off account=' : acc.name)
      gosub write.removed.line
   end
   return

*****************************************************************************
* READ.FILES.GROUPS  -  the person's membership of the three groups, each three-valued (21 Oct 26, S.73 item 3; the one place set.files reads them).
* has.files, has.write and has.admin are the memberships of sdfiles, sdfileswrite and sdfilesadmin, has.target the one of files.grp.  files.stat is 0 when every lookup answered;
* otherwise it is the status of the first that could not.  Each is read through read.one.group (below), Linux's is_grp_member call with the Windows half added.

read.files.groups:
   rg.group = 'sdfiles'
   gosub read.one.group
   has.files = rg.is
   files.stat = rg.stat
   has.write = @false
   has.admin = @false
   if files.stat = 0 then
      rg.group = 'sdfileswrite'
      gosub read.one.group
      has.write = rg.is
      files.stat = rg.stat
   end
   if files.stat = 0 then
      rg.group = 'sdfilesadmin'
      gosub read.one.group
      has.admin = rg.is
      files.stat = rg.stat
   end
   begin case
      case files.grp = 'sdfilesadmin'
         has.target = has.admin
      case files.grp = 'sdfileswrite'
         has.target = has.write
      case 1
         has.target = has.files
   end case
   return

*****************************************************************************
* READ.ONE.GROUP  -  is files.user in the Windows group rg.group?  rg.is is the answer and rg.stat is 0 when it could be given.
*
* 18 Nov 26 Windows port - D3 (P-3384, P-3429, P-5482, P-5483).  THIS IS LINUX'S is_grp_member CALL, AND THE ONE WINDOWS DIFFERENCE IS AN OS FACT.  On Linux a group
*   that is not in /etc/group has nobody in it and the lookup answers "not a member", status 0; here NetLocalGroupGetMembers fails with NERR_GroupNotFound and
*   !is_grp_member reports that as "could not tell", status 1 (win32group.c, win32_group_has_member).  So a failed lookup asks !is_group, which answers @false with
*   status 0 only for "no such group", and that one case is read as Linux reads it: not a member, status 0.  A group that is there and cannot be read, or a lookup of
*   its existence that could not run, stays a failure.  The callers then refuse exactly as Linux does: FILES-ON, AI-ON, SSH-KEY-OFF on a machine without the group
*   reach their own is_group test and name the group with 10024; the OFF words have nothing to take away.  (An install from before the release that made the
*   group has not got it: the installer makes them, an upgrade does not.)

read.one.group:
   rg.is = is_grp_member(files.user, rg.group)
   rg.stat = status()
   if rg.stat # 0 then
      rg.is = @false
      rg.found = is_group(rg.group)
      if status() = 0 and not(rg.found) then rg.stat = 0
   end
   return

*****************************************************************************
* CHANGE.FILES.GROUP  -  put files.user in (cg.want true) or out of the Windows group cg.group through os_group, and read the membership back.
* files.stat is 0 when the person is now in the state asked for; otherwise it is os_group's status, or 2 when the group still says something else (the call said yes and
* changed nothing), or the status of a lookup that could not be answered.  19 Oct 26, K4a: this is the one place set.files changes a group, so every change is read back.

change.files.group:
   cg.now = @false          ;* assigned first: a call that failed leaves no read back, and the caller copies it
   if cg.want then
      files.stat = os_group("ADDMEM", cg.group, files.user)
   end else
      files.stat = os_group("DELMEM", cg.group, files.user)
   end
   if files.stat = 0 then
      cg.now = is_grp_member(files.user, cg.group)
      files.stat = status()
      if files.stat = 0 and cg.now # cg.want then files.stat = 2
   end
   return

*****************************************************************************
* SET.SSHKEY  -  MODIFY.ACCOUNT <account> SSH-KEY-ON | SSH-KEY-OFF
*
* 17 Nov 26 Windows port - from Linux 1557e270 (S.62 LC3; the owner, 17 Nov 2026: "key sign-in is FORBIDDEN as delivered ... a documented loosening for the
*   administrator", and only the accounts SD itself made lose it).  key.want is set by the caller.  Membership of the Windows group sdsshnokey means NO key sign-in
*   (allow-ssh-groups.ps1's "Match Group sdsshnokey" arm, PubkeyAuthentication no), so SSH-KEY-ON takes the person OUT of the group and SSH-KEY-OFF puts the person IN:
*   the opposite of the route words.  Nothing is written to the register.
*
* THE REFUSALS, IN ORDER, each before anything changes: a group (sdg_) or other account has no Windows user (10087, 10081, as set.ai says it); a Windows user name that
*   is not valid (10081); a Windows user SD did not make - no "SD account" description, read by !is_sd_user, three-valued like the groups - is refused with 15170,
*   because the keys it set up outside SD are its own; a membership that cannot be read (10081 with the status); SSH-KEY-OFF when the group does not exist on this
*   machine (10024: an install from before this release).  The state line (15171) is read back from the group by change.files.group, and a read back that does not
*   show the wanted state is a failure (10081), never a success.
*   NOTE: sshd's deny group fails OPEN where the group cannot be read; that is the price of not taking keys away from users SD did not make.

set.sshkey:
   if group.name[1,4] # 'sdu_' then
      @system.return.code = -ER$FAILED
      if group.name[1,4] = 'sdg_' then
         crt sysmsg(10087, acc.name)  ;* %1 is a group account and has no remote access; reach it with logto
      end else
         crt sysmsg(10081, acc.name, 2)  ;* Unable to change remote access for %1, status: %2
      end
      return
   end
   files.user = group.name[5,999]
   if not(valid_os_name(files.user)) then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, 2)
      return
   end

   key.made = is_sd_user(files.user)
   files.stat = status()
   if files.stat # 0 then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, files.stat)
      return
   end
   if not(key.made) then
      @system.return.code = -ER$FAILED
      crt sysmsg(15170, acc.name, files.user)  ;* %1: its Windows user %2 was not made by SD, so its ssh keys are its own ...; nothing was changed
      return
   end

   rg.group = 'sdsshnokey'
   gosub read.one.group        ;* Linux's is_grp_member, with the Windows reading of a group that is not there
   has.nokey = rg.is
   files.stat = rg.stat
   if files.stat # 0 then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, files.stat)
      return
   end

   if has.nokey = not(key.want) then
      @system.return.code = 0
      crt sysmsg(10080, acc.name)  ;* %1 already had that access; nothing changed
      return
   end

   if not(key.want) then
      key.found = is_group('sdsshnokey')
      files.stat = status()
      if files.stat # 0 then
         @system.return.code = -ER$FAILED
         crt sysmsg(10081, acc.name, files.stat)
         return
      end
      if not(key.found) then
         @system.return.code = -ER$FAILED
         crt sysmsg(10024, 'sdsshnokey')  ;* %1 is not a valid Windows group
         return
      end
   end

   cg.group = 'sdsshnokey'
   cg.want = not(key.want)
   gosub change.files.group
   if files.stat # 0 then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, files.stat)
      return
   end

   @system.return.code = 0
   void kernel(K$AUDIT, 'modify.account ' : downcase(action) : ' account=' : acc.name)
   crt sysmsg(15171, acc.name, if cg.now then 'no' else 'yes')  ;* Account %1 may sign in over ssh with a key: %2
   return

*****************************************************************************
* SET.AI  -  MODIFY.ACCOUNT <account> AI-ON | AI-OFF
*
* 23 Oct 26 dm - S.69 step 2 (Windows port 13 Nov 26, RELEASE_1.1 246; owner, 23 Oct: "an API gate for each user account, so that API access can be turned on or off
*   depending on the user").  Membership of the Windows group sdaiusers IS the gate, as sdapi and sdfiles are: nothing is written to the register, and the helper sd-ai
*   reads the membership of the caller's SID (from its named pipe) at every request, so the gate does not depend on SD's BASIC.  ai.want is set by the caller.  The
*   group stands alone (no other group is needed) and is empty for a new account.
*
* AS SET.FILES, THE LOOKUP IS THREE-VALUED: !is_grp_member answers @false for "not a member" and for "could not tell", and tells them apart only by status().  A
*   lookup that could not answer changes NOTHING and says so (10081 with the status).  The same refusals: a group (sdg_) or other account has no Windows user (10087,
*   10081); AI-ON for a person who is not in sdusers (a login would refuse them first, so the group is not added to look like access); AI-ON when the Windows group
*   sdaiusers does not exist on this machine (an install from before this release has not made it yet: 10024 names it).  The state line (12611) is read back from the
*   group after the change, and a read back that does not show the wanted state is a failure (10081), never a success.  change.files.group is the one place a group is
*   changed (it is not specific to files).

set.ai:
   if group.name[1,4] # 'sdu_' then
      @system.return.code = -ER$FAILED
      if group.name[1,4] = 'sdg_' then
         crt sysmsg(10087, acc.name)  ;* %1 is a group account and has no remote access; reach it with logto
      end else
         crt sysmsg(10081, acc.name, 2)  ;* Unable to change remote access for %1, status: %2
      end
      return
   end
   files.user = group.name[5,999]
   if not(valid_os_name(files.user)) then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, 2)
      return
   end

   rg.group = 'sdaiusers'
   gosub read.one.group        ;* Linux's is_grp_member, with the Windows reading of a group that is not there
   has.ai = rg.is
   files.stat = rg.stat
   if files.stat = 0 and ai.want then
      in.sdusers = is_grp_member(files.user, 'sdusers')
      files.stat = status()
      if files.stat = 0 and not(in.sdusers) then files.stat = 2
   end
   if files.stat # 0 then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, files.stat)
      return
   end

   if has.ai = ai.want then
      @system.return.code = 0
      crt sysmsg(10080, acc.name)  ;* %1 already had that access; nothing changed
      return
   end

   if ai.want then
      ai.found = is_group('sdaiusers')
      files.stat = status()
      if files.stat # 0 then
         @system.return.code = -ER$FAILED
         crt sysmsg(10081, acc.name, files.stat)
         return
      end
      if not(ai.found) then
         @system.return.code = -ER$FAILED
         crt sysmsg(10024, 'sdaiusers')  ;* %1 is not a valid Windows group
         return
      end
   end

   cg.group = 'sdaiusers'
   cg.want = ai.want
   gosub change.files.group
   if files.stat # 0 then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, files.stat)
      return
   end

   @system.return.code = 0
   void kernel(K$AUDIT, 'modify.account ' : downcase(action) : ' account=' : acc.name)
   crt sysmsg(12611, acc.name, if cg.now then 'yes' else 'no')  ;* Account %1 has ai %2
   return

* ======================================================================
* SH-ON / SH-OFF / OS-ON / OS-OFF - set ONE field of this account's own
* Windows user's OS.USERS record to yes or no.
*
* 27 Aug 26 Windows port - owner, 27 Aug 2026.  os.field is 1 for SH - the SH
* verb and "!" at the prompt, read by CPROC - and 2 for OS.EX, read by
* op_sh.c's os_permitted() for OS.EXECUTE and by EDIT's check.permitted for the
* two screen editors.
*
* ***THE ADMINISTRATOR REFUSAL IS GONE WITH THE TIERS, 18 Sep 26 - RELEASE_1.1
* 64.***  A Windows administrator's SD account is an ordinary account: it can
* turn its own operating-system access on and off like any other, and the only
* limit on what it can do is the one Windows imposes.  The 27 Aug rule this
* banner records - that none of the three routes could be taken away from an
* administrator - died with the tier that made the account an administrator.
*
* A MISSING RECORD READS AS "no" IN BOTH FIELDS, exactly as both gates read it,
* so turning something off that was never on is "nothing changed" and writes
* nothing.  The only way to get a record that says no twice is to have had one
* say yes, which is a fact worth keeping rather than tidying away.
*
* READU AND RELEASE, because two administrators editing OS.USERS at once is
* rare and silent corruption of a permission list is not a thing to leave to
* chance.  The no-op path releases without writing.
*
* 23 Oct 26 Windows port - from Linux 215ce2c (13 Oct 26), S.63, ON THE OWNER'S ANSWER OF 23 OCT: THE GRANT IS THE ACCOUNT'S.  The text
* above this line describes the person-keyed OS.USERS record, which is retired.  os.field is now the register field ACC$SH or
* ACC$OS.EXEC, written under a lock as SET.SUSPENDED writes ACC$SUSPENDED; OS-ON also governs what an account can open by
* pathname outside its own directory (op_sh.c, K$PATH.OK).  The grant takes effect at the NEXT ACCOUNT ENTRY: LOGIN, APISRVR
* and CPROC's logto load the field into the session (K$SH / K$OS.EXEC), so a session already in the account keeps what it had.
* A GROUP or OTHER account is entered by whoever its Windows group admits, so a shell granted to it would be a shell granted to
* all of them: only sdu_ names one person (10105).
os.set:
*   SD-ON / SD-OFF (the SD.ACCOUNTS gate, Linux 7ceb50d) are allowed on a GROUP account: what that gate opens is decided for
*   each person by the groups they are in.
   if group.name[1,4] # 'sdu_' and os.field # ACC$SD.ACCOUNTS and os.field # ACC$VOC.EDIT and os.field # ACC$BP.EDIT and os.field # ACC$DICT.EDIT and os.field # ACC$SHARED.READ and os.field # ACC$SHARED.WRITE and os.field # ACC$NET and os.field # ACC$PINS then
      @system.return.code = -ER$FAILED
*     10 Nov 26 (Linux 44807a43, S.88 plan 2.9, D2): the recovery copy has its own words for why: it is kept only in a user account, for its own person.
      if os.field = ACC$RECOVERY then
         crt sysmsg(12776, acc.name)  ;* %1 is not a user account, and a recovery copy is kept only in a user account, for its own person; nothing was changed
      end else if os.field = ACC$XFER then
         crt sysmsg(15075, acc.name)  ;* %1 is not a user account, and file transfer is only for a user account, for its own person; nothing was changed
      end else
         crt sysmsg(10105, acc.name) ;* %1 is a group account and has no Windows user
      end
      return
   end

*   18 Oct 26, S.66: shared.read is the one gate whose BLANK field means ON, so "was" is "not no" for it; for every other field it is "is yes".
*   Without this, SHARED-READ-OFF on a blank record would find was = want = false, say "already" (10080) and write nothing, and the gate could never
*   be withdrawn from an account whose field is blank.  SHARED-READ-ON on a blank record likewise says "already".
   if os.field = ACC$SHARED.READ then
      os.was = (upcase(trim(acc.rec<os.field>)) # 'NO')
   end else
      os.was = (upcase(trim(acc.rec<os.field>)) = 'YES')
   end
   if os.was = os.want then
      crt sysmsg(10080, acc.name)  ;* %1 already had that access; nothing changed
      return
   end

   readu acc.new from acc.f, acc.name else acc.new = acc.rec
   if os.want then acc.new<os.field> = 'yes' else acc.new<os.field> = 'no'
   acc.written = @true
   write acc.new to acc.f, acc.name on error acc.written = @false
   if not(acc.written) then
      release acc.f, acc.name
      @system.return.code = -ER$FAILED
      crt sysmsg(10114, acc.name)  ;* Unable to change the state of %1; its state in the register is unchanged (17 Nov 26, audit round 1 P-3212: Linux's 10114, was 10104)
      return
   end

*  THE RESULTING STATE OF BOTH FIELDS, NOT A SENTENCE ABOUT ONE: SH-OFF says nothing about OS.EXECUTE, so saying where both now
*  stand is what tells the administrator the command did only what it named.
   @system.return.code = 0
   os.sh.now = 'no'
   if upcase(trim(acc.new<ACC$SH>)) = 'YES' then os.sh.now = 'yes'
   os.ex.now = 'no'
   if upcase(trim(acc.new<ACC$OS.EXEC>)) = 'YES' then os.ex.now = 'yes'
   void kernel(K$AUDIT, 'modify.account ' : downcase(action) : ' account=' : acc.name)
   if os.field = ACC$SHARED.READ or os.field = ACC$SHARED.WRITE then
*     18 Oct 26, S.66: both shared fields, as for the edit gates: SHARED-READ-OFF says nothing about write.  Read is 'no' only when the field
*     says NO (a blank field is on); write is 'yes' only when it says YES.
      sh.read.now = 'yes'
      if upcase(trim(acc.new<ACC$SHARED.READ>)) = 'NO' then sh.read.now = 'no'
      sh.write.now = 'no'
      if upcase(trim(acc.new<ACC$SHARED.WRITE>)) = 'YES' then sh.write.now = 'yes'
      crt sysmsg(12520, acc.name, sh.read.now, sh.write.now)  ;* Account %1 has shared.read %2, shared.write %3
      return
   end
   if os.field = ACC$RECOVERY then
*     10 Nov 26 (Linux 44807a43, S.88 plan 2.9, D2): one field of its own, so the line names only it.
      crt sysmsg(12775, acc.name, if upcase(trim(acc.new<ACC$RECOVERY>)) = 'YES' then 'yes' else 'no')   ;* Account %1 keeps a recovery copy of unsaved editor text: %2
      return
   end
   if os.field = ACC$XFER then
*     15 Nov 26 (Linux e080527e, S.242): one field of its own, so the line names only it.
      crt sysmsg(15074, acc.name, if upcase(trim(acc.new<ACC$XFER>)) = 'YES' then 'yes' else 'no')   ;* Account %1 may move files over its ssh login (receive / send): %2
      return
   end
   if os.field = ACC$PINS then
*     22 Oct 26 (Linux f047abc), S.75: one field of its own, so the line names only it.
      crt sysmsg(12890, acc.name, if upcase(trim(acc.new<ACC$PINS>)) = 'YES' then 'yes' else 'no')   ;* Account %1 may add its own programs to the home screen: %2
      return
   end
   if os.field = ACC$SD.ACCOUNTS then
      crt sysmsg(12390, acc.name, if upcase(trim(acc.new<ACC$SD.ACCOUNTS>)) = 'YES' then 'yes' else 'no')   ;* Account %1 has SD.ACCOUNTS %2
   end else
      if os.field = ACC$VOC.EDIT or os.field = ACC$BP.EDIT or os.field = ACC$DICT.EDIT then
*        Where all three now stand, as for SH and OS.EXECUTE: VOC-OFF says nothing about the other two.
         ed.voc = 'no' ; ed.bp = 'no' ; ed.dict = 'no'
         if upcase(trim(acc.new<ACC$VOC.EDIT>)) = 'YES' then ed.voc = 'yes'
         if upcase(trim(acc.new<ACC$BP.EDIT>)) = 'YES' then ed.bp = 'yes'
         if upcase(trim(acc.new<ACC$DICT.EDIT>)) = 'YES' then ed.dict = 'yes'
         crt sysmsg(12414, acc.name, ed.voc, ed.bp, ed.dict)  ;* Account %1 has VOC.EDIT %2, BP.EDIT %3, DICT.EDIT %4
      end else
         if os.field = ACC$NET then
*           17 Oct 26, S.65 slice 1: the NET gate has one field of its own, so the line names only it.
            crt sysmsg(12416, acc.name, if upcase(trim(acc.new<ACC$NET>)) = 'YES' then 'yes' else 'no')   ;* Account %1 has NET %2
         end else
            crt sysmsg(10102, acc.name, os.sh.now, os.ex.now)  ;* Account %1 has SH %2, OS.EXECUTE %3
         end
      end
   end
   return

*  (the rest of this routine, the os.users write with its elevated-helper fallback and read-back, is deleted: 23 Oct 26)

end

