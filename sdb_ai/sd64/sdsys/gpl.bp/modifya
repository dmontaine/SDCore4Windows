*   not the register, so it needs a user account; sdapi, when the person is also in it, still gives the whole API.  Takes effect at the person's
*   next login.
      case action = 'FILES-ON'
         files.grp = 'sdfiles'
         files.want = @true
         gosub set.files
         return
      case action = 'FILES-OFF'
         files.grp = 'sdfiles'
