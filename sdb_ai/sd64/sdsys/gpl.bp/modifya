* 21 Oct 26 dm - S.73 item 3 (Linux ef9d594): the same helper, the group sdfilesadmin.
      case action = 'FILES-ADMIN-ON'
         files.grp = 'sdfilesadmin'
         files.want = @true
         gosub set.files
         return
      case action = 'FILES-ADMIN-OFF'
         files.grp = 'sdfilesadmin'
         files.want = @false
         gosub set.files
         return
* 23 Oct 26 dm - S.69 step 2 (Windows port 13 Nov 26, RELEASE_1.1 246; owner: "an API gate for each user account ... API access can be turned on or off depending on
*   the user"): AI-ON / AI-OFF, membership of the Windows group sdaiusers, the right to use the AI provider's API through the helper sd-ai.  It stands alone (no other
*   group is needed) and is OFF for a new account.
      case action = 'AI-ON'
         ai.want = @true
         gosub set.ai
         return
      case action = 'AI-OFF'
         ai.want = @false
         gosub set.ai
         return
* 17 Nov 26 Windows port - from Linux 1557e270 (S.62 LC3): SSH-KEY-ON / SSH-KEY-OFF, key sign-in over ssh for a Windows user SD made: out of / into the Windows group
*   sdsshnokey (in it as delivered).
      case action = 'SSH-KEY-ON'
         key.want = @true
         gosub set.sshkey
         return
      case action = 'SSH-KEY-OFF'
         key.want = @false
         gosub set.sshkey
         return
* 21 Aug 26 Windows port - SSH, API, BOTH and NONE NAME THE STATE WANTED, not what to change: API means "the API and nothing else", so it withdraws ssh.  The
*   same four words are CREATE.ACCOUNT's.  They act on the account's own Windows user and take no user name.
      case action = 'SSH'
         want.ssh = @true  ; want.api = @false ; gosub set.route
         return
      case action = 'API'
         want.ssh = @false ; want.api = @true  ; gosub set.route
         return
      case action = 'BOTH'
         want.ssh = @true  ; want.api = @true  ; gosub set.route
         return
      case action = 'NONE'
         want.ssh = @false ; want.api = @false ; gosub set.route
         return
* validate.actions has refused every word that is not one of these, so this is only a net: nothing was changed.
      case 1
         @system.return.code = -ER$ARGS
         crt sysmsg(12795, downcase(action))  ;* %1 is not a modify.account action, and nothing was changed
   end case
   return

* ADD and DELETE: a user name follows; the account's group must be a Windows group to put the person in or take them out.
add.delete.arm:
   if is_group(group.name) then
      if (upcase(action) = 'ADD') or (upcase(action) = 'DELETE') then
      *  valid action
      *   Get next token, user name
         call @parser(PARSER$GET.TOKEN, token.type, user.name, keyword) 
         if token.type = PARSER$END then
            stop sysmsg(10016)  ;* Missing User Name
         end
*        18 Oct 26 dm - one user name only; a second was added or removed by nobody (see the check after the action word above)
         call @parser(PARSER$GET.TOKEN, token.type, extra.word, keyword)
         if token.type # PARSER$END then
            stop sysmsg(12719, extra.word)  ;* modify.account does one action at a time, and nothing was changed: %1 was not carried out
         end
*        13 Nov 26 Windows port - RELEASE_1.1 202: SDRADMIN joins no group account (it would reach that group's files).
         if upcase(action) = 'ADD' and upcase(user.name) = 'SDRADMIN' then
            stop sysmsg(12704) ;* SDRADMIN is the remote administration account
         end

         if (upcase(action) = 'ADD') then

* 29 Aug 26 Windows port - THE TIER ORDERING APPLIES HERE TOO.  Owner's rule,
*   29 Aug 2026, PRE_RELEASE_FIXES 57: a grant may go down or sideways, never
*   up.  This arm makes the identical os_group('ADDMEM', ...) call GRANT makes,
*   which is exactly why PRE_RELEASE 27 had to give it the same audit record.
*
*   RELEASE_1.1 64, 18 Sep 2026 - THE REFUSAL THAT USED TO STAND HERE IS GONE
*   WITH THE TIERS.  There is no ordering left for two verbs to disagree about.
*
*   DELETE IS NOT GUARDED AND NEVER WAS: taking access away is always allowed,
*   and refusing a revoke would strand exactly the memberships that want
*   removing.

            * Add user to group
            * does user belong to sdusers?
            if is_grp_member(user.name,'sdusers') then
            * this user looks legit, add to group
            * first check to see if user is already a member of the group
               if is_grp_member(user.name,group.name) THEN
                  @system.return.code = 0  ;* 14 Nov 26 (RELEASE_1.1 306, Linux c4ce87e9): nothing to change, as run.actions counts it
                  crt sysmsg(10017,user.name,group.name)  ;* %1 is already a member of group %2
               end else
                  * Modified by Composer AI - 2026/06/10.
                  * Use shared !valid_os_name before os.execute (phase 2).
                  * if convert(os.name.chars, '', user.name) # '' ...
                  if not(valid_os_name(user.name)) or not(valid_os_name(group.name)) then
                     @system.return.code = -ER$FAILED
                     crt sysmsg(10019,user.name,group.name,2) ;* Unable to add user %1 to group %s status: %2
                  end else
* 14 Aug 26 Windows port - was: os.execute "sudo usermod -aG ..."
                  stat = os_group("ADDMEM", group.name, user.name)
                  * --------------------
                  if stat = 0 then
* 28 Aug 26 Windows port - AUDIT IT, the way GRANTA:208 does.  This arm makes
* the identical os_group('ADDMEM', ...) call that GRANT makes and wrote
* nothing, so who may enter an account could be changed by two verbs and only
* one of them left a trail.  AFTER the edit and inside "stat = 0", so it
* records what happened rather than what was attempted.  The verb is named in
* the text because the two routes are otherwise indistinguishable in the audit
* file.  The identity is stamped by audit_message() in k_error.c and is not
* passed from here, so a caller cannot forge it.  PRE_RELEASE_FIXES.md 27.
                     void kernel(K$AUDIT, 'modify.account add account=' : acc.name : ' to=' : user.name)
                     @system.return.code = 0
                     crt sysmsg(10018,user.name,group.name)  ;* %1 added to group %2
                  end else
                     @system.return.code = -ER$FAILED
                     crt sysmsg(10019,user.name,group.name,stat) ;* Unable to add user %1 to group %s status: %2
                  end
                  end
               end
            end else
               crt user.name
               @system.return.code = -ER$FAILED
               crt sysmsg(10020,user.name) ;* %1 is not a member of sdusers, not allowed
            end 
         
         end else
            * already tested action, must be delete
            if is_grp_member(user.name,group.name) THEN
               * Modified by Composer AI - 2026/06/10.
               * Use shared !valid_os_name before os.execute (phase 2).
               if not(valid_os_name(user.name)) or not(valid_os_name(group.name)) then
                  @system.return.code = -ER$FAILED
                  crt sysmsg(10022,user.name,group.name,2) ;* Unable to remove user %1 from group %s status: %2
               end else
* 14 Aug 26 Windows port - was: os.execute "sudo deluser ..."
               stat = os_group("DELMEM", group.name, user.name)
               * --------------------
                  if stat = 0 then
* 28 Aug 26 Windows port - and the DELETE arm, for the reason given at the ADD
* one above.  GRANTA:233 is the model.  PRE_RELEASE_FIXES.md 27.
                     void kernel(K$AUDIT, 'modify.account delete account=' : acc.name : ' from=' : user.name)
                     @system.return.code = 0
                     crt sysmsg(10021,user.name,group.name) ;*  %1 removed from group %2
                  end else
                     @system.return.code = -ER$FAILED
                     crt sysmsg(10022,user.name,group.name,stat) ;* Unable to remove user %1 from group %s status: %2
                  end
               end
            end else
               @system.return.code = 0  ;* 14 Nov 26 (RELEASE_1.1 306): nothing to remove
               crt sysmsg(10023,user.name,group.name) ;* %1 is not a member of  %2
            end 
          
         end
         
         
      end else
         crt 'modify.account Action Must Be add, delete, ssh, api, both, none,'
         crt '   sh-on, sh-off, os-on, os-off, sd-on, sd-off, voc-on, voc-off, bp-on, bp-off, dict-on, dict-off, recovery-on, recovery-off, xfer-on, xfer-off, net-on, net-off,'
         crt '   shared-read-on, shared-read-off, shared-write-on, shared-write-off,'
         crt '   start-menu, start-terminal, start-default, pins-on, pins-off,'
         crt '   ssh-key-on, ssh-key-off,'
         crt '   files-on, files-off, files-write-on, files-write-off, files-admin-on, files-admin-off, ai-on, ai-off, suspended or unsuspended'
      end

   end else
     crt sysmsg(10024,group.name) ;* %1 is not a valid Windows group
   end
   stop

