*
* START-DESCRIPTION:
*
*    SET.PASSWORD [account]
*
*    Sets the password of an SD account.  With no account name, sets your own.
*
*    THE PASSWORD IS NEVER AN ARGUMENT.  It is read from two hidden prompts,
*    and anything after the account name is refused rather than ignored - see
*    the comment on that test below.
*
*    Setting your own password requires the current one.  Setting someone
*    else's requires administrator rights, and does not, since an
*    administrator resetting a forgotten password does not know it.
*
*    The account must exist in the ACCOUNTS register.  See PROJECT_STATUS.md
*    section 5.6.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program set_acc_password
$catalog $SET.PASSWORD

$include parser.h
$include syscom.h
$include int$keys.h
$include err.h
$include keys.h

   prompt ''
   parser = "!PARSER"
   @system.return.code = -ER$ARGS

   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)   ;* verb

   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   if token.type = PARSER$END then
      account = upcase(@logname)
      own = @true
   end else
      account = upcase(token)
      own = (account = upcase(@logname))

* 20 Aug 26 Windows port - A TRAILING TOKEN IS REFUSED, NOT DISCARDED.
*
*   This used to read the account and stop looking, so "SET.PASSWORD DON
*   hunter2" set account = DON, threw "hunter2" away without a word, and
*   prompted for the password as though nothing had happened.  Every visible
*   sign said it worked, because it did work - just not the way the person
*   typing it believed.
*
*   THE COST OF SAYING NOTHING IS THAT THE PASSWORD IS ALREADY SOMEWHERE ELSE
*   by the time the prompt appears: in SD's command stack, and in a shell's
*   history and process list if the verb is ever reached from one.  Refusing
*   does not put it back, but it tells the person to go and deal with it
*   instead of leaving them believing the command line form is supported.
*
*   IT IS DELIBERATELY NOT "ACCEPT IT IF GIVEN".  A password on a command line
*   is the thing this whole credential model exists to avoid - it is why
*   gplbld/verify-scramlogin.ps1 generates its test password and feeds it on
*   stdin, and why SCRAM was written at all.  Making the convenient form work
*   would be undoing that.
*
*   Found 20 Aug 2026 by the owner typing it.  The parser is already positioned
*   after the account, so one more GET.TOKEN is the whole test.
      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
      if token.type # PARSER$END then
         stop sysmsg(5276)  ;* A password is never given on the command line...
      end
   end

   * Only an administrator may set an account other than their own.

   if not(own) and not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001)  ;* Command requires administrator privileges
   end

   * The account has to be a real one.

   openpath @sdsys:@ds:'accounts' to acc.f else
      stop sysmsg(2200)  ;* Cannot open accounts register
   end

   read acc.rec from acc.f, account else
      close acc.f
      stop sysmsg(5018, account)  ;* Account %1 not in register
   end
   close acc.f

   * Has this account got a credential yet?  The first one cannot require the
   * previous password, since there is not one.  That is the installer's path
   * for setting the initial SDSYS password, and it is why the install has to
   * happen before the machine is exposed to anybody.

*  19 Aug 26 Windows port - CRED$STOREDKEY, where this read CRED$VERIFIER.
*  A VERSION 1 RECORD THEREFORE READS AS "NO CREDENTIAL", which is the
*  intended migration: it cannot be checked by !CRED_VERIFY and cannot be
*  converted without the plaintext, so the first SET.PASSWORD after the
*  upgrade replaces it without demanding the old password.  That is not a way
*  in - reaching this line at all takes either administrator rights or an
*  elevated session as the account itself, and either can already reset the
*  credential outright.
   has.cred = @false
   openpath @sdsys:@ds:'$cred' to cred.f then
      read cred.rec from cred.f, account then
         if cred.rec<CRED$STOREDKEY> # '' then has.cred = @true
      end
      close cred.f
   end else
      stop 'Cannot open the $CRED register.  Has the install completed?'
   end

   if not(has.cred) then
      crt 'Account ' : account : ' has no password set.  Setting the first one.'
   end

   * Changing your own password requires the current one.  An administrator
   * resetting someone else's cannot be expected to know it.

   if own and has.cred then
      display 'Current password: ' :
      input current HIDDEN
      display

      ok = @false
      call !CRED_VERIFY(account, current, ok)
      if not(ok) then
         crt 'Password not changed.'
         @system.return.code = -ER$ARGS
         stop
      end
   end

   display 'New password: ' :
   input pw1 HIDDEN
   display

   if pw1 = '' then
      crt 'Password not changed.'
      @system.return.code = -ER$ARGS
      stop
   end

   display 'Repeat new password: ' :
   input pw2 HIDDEN
   display

   if pw1 # pw2 then
      crt 'Passwords do not match.  Password not changed.'
      @system.return.code = -ER$ARGS
      stop
   end

   ok = @false
   call !CRED_SET(account, pw1, ok)
   if ok then
      crt 'Password set for account ' : account
      @system.return.code = 0
   end else
      crt 'Unable to set password for ' : account : ', status ' : status()
      @system.return.code = -ER$ARGS
   end

   return
end

* END-CODE
