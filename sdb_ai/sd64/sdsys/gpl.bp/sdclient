local function read.record(mode, fno, id, err)
   rec = ''
   err = -1
   if context.error(CX.CONNECTED) then goto exit.read

   if len(id) < 1 or len(id) > MAX.ID.LEN then
      ServerStatus = ER$IID
      err = SV$ON.ERROR
   end else
      pkt = iconv(fno, 'ISL')
      pkt := id
      if message.pair(mode, pkt) then
         begin case
            case server.error = SV$OK
               rec = in.pkt
            case server.error = SV$ON.ERROR and not(quiet)
               abort 'READ generated an abort event'
         end case
         err = server.error
      end
   end

exit.read:
   return rec
end

* ======================================================================
* SCRAM-SHA-256 login, the client half.  docs/SCRAM_AUTH.md phase 5.
*
* Out:  47   n,,n=<user>,r=<client nonce>
* In:        r=<combined nonce>,s=<salt>,i=<iterations>
* Out:  48   c=biws,r=<combined nonce>,p=<ClientProof>
* In:        v=<ServerSignature>
*
* THE PASSWORD NEVER LEAVES THIS FUNCTION.  It is spent on PBKDF2 and what
* goes on the wire is a proof, so a capture of both packets yields an offline
* guess bounded by the iteration count and nothing else.
*
* THE 600,000 PBKDF2 ITERATIONS ARE THE CLIENT'S COST, once per connect().
* The server holds StoredKey and spends two HMACs and a hash; that asymmetry
* is the design, not an accident of it.
*
* IT MIRRORS scram_login() IN gplsrc/sdclilib/sdclilib.c, deliberately and
* without sharing code - one is C in a DLL, the other BASIC in the server's
* own catalogue.  Both are checked against the same server, which is what
* keeps them honest; RFC 7677's vectors prove the primitives underneath.
*
* 17 Oct 26 dm - S.65 slice 3a: the exchange is scram.exchange, shared by two logins.  scram.login (connect) derives the keys from
* the password.  connect.keys passes the stored salt, iteration count, ClientKey and ServerKey instead, with a null password: the
* PBKDF2 is skipped, and the salt and count the server sends must equal the stored ones (checked before the client-final message,
* so a server that is not the one the login was made with is sent nothing further).  Everything else is the same code.

local function scram.login(username, password)
   return scram.exchange(username, password, '', '', '', '')
end

local function scram.exchange(username, password, stored.salt, stored.iter, stored.ck, stored.sk)
   keys.mode = (stored.ck # '')   ;* the login from stored derived keys, no password
   cnonce = SDEXT('18', @TRUE, SD_RANDBYTES)
   if cnonce = '' then
      error = 'Unable to generate a client nonce'
      return @false
   end

*  15 Sep 26 Windows port - S.19/RELEASE_1.1 41: the connection is TLS (connect
*  opens it with SKT$TLS), so the login binds to it: 'p=tls-exporter,,'.  APISRVR
*  refuses 'n,,' over TLS.  The c= value comes from this socket's own end, below.
   cbind = socket.info(skt, SKT$INFO.TLS.CBIND)
   if cbind = '' then
      error = 'The connection is not secured'
      return @false
   end
   cfirst.bare = 'n=' : username : ',r=' : cnonce

   if not(message.pair(SrvrScramFirst, 'p=tls-exporter,,' : cfirst.bare)) then return @false
   if server.error # SV$OK then
      if server.error = SV$ON.ERROR then error = in.pkt
      else error = 'Server refused the authentication request'
      return @false
   end

*  KEPT VERBATIM FOR AuthMessage, never rebuilt from the parsed parts.  The
*  server stores the string it sent for the same reason: two sides that
*  assemble AuthMessage differently fail the signature check with nothing to
*  show for it.
   sfirst = in.pkt

   if count(sfirst, ',') # 2 then
      error = 'Malformed server-first message'
      return @false
   end

   s = field(sfirst, ',', 1)
   if s[1,2] # 'r=' then
      error = 'Malformed server-first message'
      return @false
   end
   nonce = s[3,999999]

   s = field(sfirst, ',', 2)
   if s[1,2] # 's=' then
      error = 'Malformed server-first message'
      return @false
   end
   salt = s[3,999999]

   s = field(sfirst, ',', 3)
   if s[1,2] # 'i=' then
      error = 'Malformed server-first message'
      return @false
   end
   iter = s[3,999999]

*  THE COMBINED NONCE MUST START WITH OURS.  Without this the client will
*  happily complete an exchange belonging to somebody else, and the check
*  costs one comparison.
   if nonce[1,len(cnonce)] # cnonce or len(nonce) = len(cnonce) then
      error = 'Server nonce does not extend the client nonce'
      return @false
   end

*  A SERVER DOES NOT GET TO CHOOSE THIS CLIENT'S CPU COST.  Too few iterations
*  weakens the derivation that a captured exchange would be judged against;
*  too many are a denial of service against the caller.  Same two bounds as
*  the C client - SCRAM_MIN_ITERATIONS in gplsrc/sdclilib/sdclilib.c - and
*  nothing cross-checks the two copies.
   if not(num(iter)) then
      error = 'Server sent a non-numeric iteration count'
      return @false
   end
   if iter < SCRAM$MIN.ITER or iter > SCRAM$MAX.ITER then
      error = 'Server asked for an unacceptable iteration count'
      return @false
   end

   if keys.mode then
*     ONLY THE CLIENT-FIRST MESSAGE HAS BEEN SENT: a server whose salt or count is not the stored one is not the server the login was
*     made with (or the password has been changed there), and its proof would be worth nothing.  Text comparison, as for the pin.
      if ('s' : salt) # ('s' : stored.salt) then
         error = "The server's salt is not the stored one: the stored login is out of date or this is not the server it was made with"
         stored.ck = '' ; stored.sk = ''
         return @false
      end
      if iter + 0 # stored.iter + 0 then
         error = "The server's iteration count is not the stored one: the stored login is out of date or this is not the server it was made with"
         stored.ck = '' ; stored.sk = ''
         return @false
      end
      client.key = stored.ck
      srvr.key = stored.sk
      stored.ck = '' ; stored.sk = ''
   end else
      salted = SDEXT(password : @FM : salt : @FM : iter : @FM : SCRAM$KEY.LEN, @TRUE, SD_PBKDF2)
      if salted = '' then
         error = 'Unable to derive the salted password'
         return @false
      end

      client.key = SDEXT(salted : @FM : 'Client Key', @TRUE, SD_HMACSHA256)
      srvr.key = SDEXT(salted : @FM : 'Server Key', @TRUE, SD_HMACSHA256)
      salted = ''
   end
   stored.key = SDEXT(client.key, @TRUE, SD_SHA256)

   cfinal.bare = 'c=' : cbind : ',r=' : nonce
   auth.msg = cfirst.bare : ',' : sfirst : ',' : cfinal.bare

   client.sig = SDEXT(stored.key : @FM : auth.msg, @TRUE, SD_HMACSHA256)
   proof = SDEXT(client.key : @FM : client.sig, @TRUE, SD_XORBYTES)

*  ServerKey was derived (or taken from the stored login) above, before the salted password was dropped; kept to check the reply.
   expect.v = SDEXT(srvr.key : @FM : auth.msg, @TRUE, SD_HMACSHA256)

*  Dropped as soon as they are spent.
   client.key = ''
   srvr.key = ''
   stored.key = ''
   client.sig = ''

   if proof = '' or expect.v = '' then
      error = 'Unable to derive the authentication proof'
      return @false
   end

   if not(message.pair(SrvrScramFinal, cfinal.bare : ',p=' : proof)) then return @false
   if server.error # SV$OK then
      if server.error = SV$ON.ERROR then error = in.pkt
      else error = 'Server refused the authentication proof'
      return @false
   end

*  MUTUAL AUTHENTICATION, AND A MISSING OR WRONG v= FAILS THE CONNECTION.  Not
*  a warning.  Only a holder of this account's ServerKey can compute it, so
*  this is what catches a process that took the port before SD started: it can
*  collect a proof it cannot use, but it cannot produce this.  It is also the
*  check that gets softened while debugging and never hardened again.
   if in.pkt[1,2] # 'v=' then
      error = 'Server did not return a signature'
      return @false
   end

   if SDEXT(in.pkt[3,999999] : @FM : expect.v, @TRUE, SD_CTEQUAL) # '1' then
      error = 'Server signature did not verify'
      return @false
   end

   return @true
end

