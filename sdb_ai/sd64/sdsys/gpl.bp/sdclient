local function message.pair(pkt.type, pkt)
*  18 Oct 26 dm - S.65 slice 3e: the kind of the last reply, reset BEFORE anything is written so that a request that fails to send or
*  to be answered leaves -1 (no reply read), never the previous request's answer.
   LastError = -1
   LastText = ''
   if (write.packet(pkt.type, pkt)) then
      return get.response()
   end
   return @false
end

* ======================================================================

local function get.response()
 if not(read.packet()) then return @false

*  18 Oct 26 dm - S.65 slice 3e: the kind of this reply, kept for a caller whose object is quiet (an ERROR reply is 3 here too)
 LastError = server.error
 if server.error = SV$ON.ERROR then LastText = in.pkt

 if server.error = SV$ERROR then
    error = 'Unable to retrieve error text'
    void write.packet(SrvrGetError, '')
    if read.packet() then error = in.pkt
    return @false
 end

 return @true
end

* ======================================================================

local function write.packet(pkt.type, pkt)
   packet = iconv(len(pkt) + 6, 'ILL')
   packet := iconv(pkt.type, 'ISL')
   packet := pkt

   if debugging then
      display 'Write packet: type ' : pkt.type : ', ' : len(pkt) : ' bytes.'
   end

   void write.socket(skt, packet, SKT$BLOCKING, 0)
   return (status() = 0)
end

* ======================================================================

local function read.packet()
   * Read packet header

   pkt.header = ''
   loop
      n = 10 - len(pkt.header)
   while n
      s = read.socket(skt, n, SKT$BLOCKING, io.ms)
      if status() then return @false
      pkt.header := s
   repeat

   if debugging then
      display 'Raw header = ' : oconv(pkt.header, 'MX0C')
   end

   * Extract header data

   pkt.bytes = oconv(pkt.header[1,4], 'ILL')

*  19 Oct 26 dm (K8c).  THE LENGTH THE SERVER ANNOUNCES IS CHECKED BEFORE ANYTHING ELSE IS TRUSTED OR READ.  A reply is at least its own ten byte header; the count is read as a
*   SIGNED 32 bit value, so a length of 2 GB or more arrives negative; and the owner of this object may have set a ceiling (maxpacket, 0 = none).  A server that announces less than
*   a header, or more than the ceiling, is answered as if the connection had failed: the call returns false, server.error and ServerStatus are NOT touched (a caller that marks
*   ServerStatus before a request, as $netfile does, sees the mark still there: no reply), and no byte of the body is read.  Before this the body was read for as long as the
*   server sent, and a negative count made the loop below ask for a negative number of bytes.
   if pkt.bytes < 10 then return @false
   if maxpacket > 0 and pkt.bytes > maxpacket then return @false

   server.error = oconv(pkt.header[5,2], 'ISL')
   ServerStatus = oconv(pkt.header[7,4], 'ILL')

   * Read packet data

   n = pkt.bytes - 10
   if debugging then
      display 'Incoming packet: ' : n : ' data bytes. Error ' : server.error :', Status ' : ServerStatus
   end

   in.pkt = ''
   loop
   while n
      s = read.socket(skt, n, SKT$BLOCKING, io.ms)
      if status() then return @false
      if debugging then
         display len(s) : ': ' : oconv(s, 'MX0C')
      end
      in.pkt := s
      n -= len(s)
   repeat

   return @true
end

