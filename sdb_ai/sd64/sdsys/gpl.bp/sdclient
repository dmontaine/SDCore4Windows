$define SrvrSelectRight  45    ;* Move index position to right
$define SrvrMarkMapping  46    ;* Enable/disable mark mapping
$define SrvrScramFirst   47    ;* SCRAM client-first
$define SrvrScramFinal   48    ;* SCRAM client-final

$define SV$OK             0    ;* Action successful
$define SV$ON.ERROR       1    ;* Action took ON ERROR clause
$define SV$ELSE           2    ;* Action took ELSE clause
$define SV$ERROR          3    ;* Action failed. Error text available
$define SV$LOCKED         4    ;* Took locked clause
$define SV$PROMPT         5    ;* Server requesting input

*  19 Oct 26 (K8d): the connect timeout (5 seconds) and the wait for each reply (30 seconds) of connect.keys are the configuration parameters NETWAIT and NETREPLY, which the
*  administrator sets in sd.conf (1 to 3600 seconds, these defaults); they were $defines of the same values.
$define NET.ACK.TRIES    16    ;* connect.keys: bytes to read looking for the Ack


deffun read.record(mode, fno, id, err) local
deffun message.pair(pkt.type, pkt) local
deffun get.response() local
deffun write.packet(pkt.type, pkt) local
deffun read.packet() local
deffun context.error(expected) local
deffun scram.login(username, password) local
deffun scram.exchange(username, password, stored.salt, stored.iter, stored.ck, stored.sk) local

private context,        ;* State
        skt,            ;* Socket for connection
        server.error,   ;* Returned error code from server
        io.ms           ;* Milliseconds to wait for each read; 0 waits for ever (17 Oct 26, S.65)

public debugging,       ;* Debug mode
       ServerStatus,    ;* Returned status from server
       error,           ;* Error text
       quiet,           ;* True: a server ON ERROR reply does not abort the caller (18 Oct 26, S.65 slice 3e)
       LastError,       ;* The kind of the last reply (SV$ code), -1 when no reply was read
       LastText,        ;* The payload of the last ON ERROR reply
       maxpacket        ;* The longest reply, header included, this object will read: a longer one fails the call.  0 = no ceiling (the default).  19 Oct 26, K8c

* ======================================================================

public subroutine create.object
   error = ''
   context = CX.DISCONNECTED
   debugging = @false
   io.ms = 0
   quiet = @false
   LastError = -1
   LastText = ''
   maxpacket = 0
end

* ======================================================================

public subroutine destroy.object
   if context # CX.DISCONNECTED then gosub disconnect.session
end

* ======================================================================
* CALL()

public subroutine call(subr, ...)
   if context.error(CX.CONNECTED) then return

   if len(subr) < 1 or len(subr) > MAX.CALL.NAME.LEN then
      abort 'Illegal subroutine name in call'
   end

   argc = arg.count() - 1
   if argc > 20 then
      abort 'Illegal argument count in call'
   end

   * Construct outgoing packet

   * Subroutine name
   pkt = iconv(len(subr), 'ISL') : subr
   if rem(len(subr),2) then pkt := char(0)

   * Argument count
   pkt := iconv(argc, 'ISL')

   * Arguments
   for i = 1 to argc
      if assigned(arg(i+1)) then
         s = arg(i + 1) : ''
      end else
         s = ''
      end
      pkt := iconv(len(s), 'ILL') : s
      if rem(len(s), 2) then pkt := char(0)
   next i

   * Execute subroutine
   if message.pair(SrvrCall, pkt) then
      * Process any returned arguments
      loop
      while in.pkt # ''
         i = oconv(in.pkt[1,2], 'ISL')   ;* Argument number
         n = oconv(in.pkt[3,4], 'ILL')   ;* Length
         set.arg i + 1, in.pkt[7,n]
         if rem(n, 2) then n += 1
         in.pkt = in.pkt[7+n,999999]
      repeat
   end
end

* ======================================================================
* CLEARFILE(fno)   (18 Oct 26 dm, S.65 slice 3e) - request 31, the file number and nothing else

public subroutine clearfile(fno)
   if not(context.error(CX.CONNECTED)) then
      pkt = iconv(fno, 'ISL')
      if message.pair(SrvrClearfile, pkt) then
         if server.error = SV$ON.ERROR and not(quiet) then
            abort 'CLEARFILE generated an abort event'
         end
      end
   end
end

* ======================================================================
* CLEARSELECT(listno)

public subroutine clearselect(listno)
   if not(context.error(CX.CONNECTED)) then
      pkt = iconv(listno, 'ISL')
      if message.pair(SrvrClearSelect, pkt) then
         if server.error = SV$ON.ERROR then
            abort 'CLEARSELECT generated an abort event'
         end
      end
   end
end

* ======================================================================
* CLOSE(fno)

public subroutine close(fno)
   if not(context.error(CX.CONNECTED)) then 
      pkt = iconv(fno, 'ISL')
      if message.pair(SrvrClose, pkt) then
         if server.error = SV$ON.ERROR then
            abort 'CLOSE generated an abort event'
         end
      end
   end
end

* ======================================================================
* CONNECT(host, port, username, password, account)

public function connect(host, (port), username, password, account)
   error = ''

   if len(host) = 0 then
      error = 'Invalid host name'
      return @false
   end

   * Modified by Composer AI - 2026/06/10.
   * Use shared !valid_os_name for remote login user names.
   * if len(username) = 0 or len(username) > MAX.USERNAME.LEN then
   deffun valid_os_name(name) calling '!valid_os_name'
   if not(valid_os_name(username)) then
      error = 'Invalid user name'
      return @false
   end
   * --------------------

   * Open connection to server
* 01 Oct 26 Windows port - 4247, the full product's fixed API port (it was
*   4243, which is OpenQM's).  The same number as SD_API_PORT in sddefs.h.
   if port < 0 then port = 4247
* 15 Sep 26 Windows port - S.19/RELEASE_1.1 41: TLS 1.3.  The server takes
*   every API connection through its TLS relay, and scram.login binds the login
*   to this session.
   skt = open.socket(host, port, SKT$BLOCKING + SKT$TLS)
   if status() then return @false

   * Wait for an Ack to come back before continuing
   loop
      until read.socket(skt, 1, SKT$BLOCKING, 0) = char(6)
   repeat

* 20 Aug 26 Windows port - SCRAM-SHA-256, NOT SrvrLogin.  This used to build a
*   packet holding the user name and the password, each length-prefixed and
*   padded to a two byte multiple, and send it as request 24 - so the password
*   crossed the wire in clear on every connect().  APISRVR retired request 24
*   in the same change and answers it with message 5275, so keeping the old
*   packet here would not have been a weaker login, it would have been no
*   login.  docs/SCRAM_AUTH.md phase 5.
   if not(scram.login(username, password)) then
      close.socket skt
      return @false
   end

   * Now attempt to attach to required account
   if not(message.pair(SrvrAccount, account)) then
      close.socket skt
      return @false
   end

   context = CX.CONNECTED

   return @true
end

* ======================================================================
* CONNECT.KEYS(host, port, username, salt, iterations, client.key, server.key, account, pin)   (17 Oct 26 dm, S.65 slice 3a)
*
* The login of a person who has run SET.NETLOGIN: NO PASSWORD.  salt, iterations, client.key and server.key are the four values
* that command stored (base64 except the count), username the remote user name and pin the 64 hexadecimal digits of the server's
* definition.  In this order, and nothing is sent before the third step:
*   1. every argument is checked for shape, without touching the network;
*   2. one TLS connection (NETWAIT seconds to connect, 5 unless sd.conf says otherwise), and the hash of the public key the server presents is compared with pin;
*   3. the Ack byte, then the SCRAM exchange of scram.login with the stored keys in place of the password - the salt and iteration
*      count the server sends must EQUAL the stored ones, or the stored login is out of date or this is not the server it was made
*      with, and the exchange stops with only the client-first message sent;
*   4. the account is entered as connect() does, and a refusal fails the call.
* Every wait for the server is bounded (NETREPLY seconds a read, 30 unless sd.conf says otherwise; settimeout() changes it).  THE LOGIN EXCHANGE HAS NO CEILING ON THE LENGTH A REPLY
* ANNOUNCES (maxpacket is set by the caller after connect.keys returns; only the below-ten test applies here): a pinned server that is hostile can still announce a large length in a
* login reply and send slowly, for NETREPLY seconds a read.  The arguments are passed by
* value: the copies here are cleared as soon as they are spent, the caller's variables are the caller's to clear.
* On false, error says why and the socket is closed; ServerStatus is meaningful only after a failed connection (the status of the
* open) or a refusal the server itself reported.

public function connect.keys(host, (port), username, (salt), (iterations), (client.key), (server.key), account, (pin))
   error = ''

   if context # CX.DISCONNECTED then
      error = 'A connection has already been established'
      return @false
   end

   if len(host) = 0 then
      error = 'Invalid host name'
      return @false
   end

   * valid_os_name is declared once for the module, in connect() above (a second deffun here is "Duplicate function name")
   if not(valid_os_name(username)) then
      error = 'Invalid user name'
      return @false
   end

   pin = downcase(trim(pin))
   if len(pin) # 64 or len(convert('0123456789abcdef', '', pin)) # 0 then
      error = 'Invalid public key pin'
      return @false
   end

   if salt = '' or client.key = '' or server.key = '' then
      error = 'The stored login is incomplete'
      return @false
   end

   if len(iterations) < 1 or len(iterations) > 8 or not(iterations matches '1N0N') then
      error = 'The stored iteration count is not a whole number'
      return @false
   end
   iterations += 0
   if iterations < SCRAM$MIN.ITER or iterations > SCRAM$MAX.ITER then
      error = 'The stored iteration count is unacceptable'
      return @false
   end

   if port = '' or port < 0 then port = 4247   ;* as connect()

   skt = open.socket(host, port, SKT$BLOCKING + SKT$TLS, config('NETWAIT'))
   st = status()
   oserr = os.error()
   if st # 0 then
      ServerStatus = st
      if st = ER$CONNECT and oserr = 0 then
         error = 'The TLS handshake with ' : host : ':' : port : ' did not complete (status ' : st : ')'
      end else
         error = 'Cannot connect to ' : host : ':' : port : ' (status ' : st : ')'
      end
      return @false
   end

*  THE PIN, BEFORE A BYTE IS SENT.  'p' : forces a text comparison - two all-digit strings compare as numbers.
   spki = downcase(trim(socket.info(skt, SKT$INFO.TLS.SPKI)))
   if spki = '' then
      error = 'The server gave no public key hash, so it cannot be checked against the pin; nothing was sent'
      goto keys.fail
   end
   if ('p' : spki) # ('p' : pin) then
      error = 'PIN MISMATCH: the public key of ' : host : ':' : port : ' is not the key pinned in its definition; nothing was sent'
      goto keys.fail
   end

   if io.ms = 0 then io.ms = config('NETREPLY') * 1000
   acked = @false
   tries = 0
   loop
      tries += 1
      b = read.socket(skt, 1, SKT$BLOCKING, io.ms)
      if status() # 0 or b = '' then
         error = 'No acknowledgement from ' : host : ':' : port : ' at the start of the session'
         goto keys.fail
      end
      if b = char(6) then acked = @true
   until acked or tries >= NET.ACK.TRIES
   repeat
   if not(acked) then
      error = 'No acknowledgement from ' : host : ':' : port : ' at the start of the session'
      goto keys.fail
   end

   ok = scram.exchange(username, '', salt, iterations, client.key, server.key)
   client.key = ''
   server.key = ''
   if not(ok) then
      if error = '' then error = 'No reply from ' : host : ':' : port : ' during the login (the connection failed or timed out)'
      goto keys.fail
   end

   if not(message.pair(SrvrAccount, account)) then
      if error = '' then error = 'No reply from ' : host : ':' : port : ' when entering the account'
      goto keys.fail
   end
   if server.error # SV$OK then
      error = 'The server did not enter the account'
      goto keys.fail
   end

   context = CX.CONNECTED
   return @true

keys.fail:
   client.key = ''
   server.key = ''
   close.socket skt
   return @false
end

* ======================================================================
* SETTIMEOUT(ms)   (17 Oct 26 dm, S.65 slice 3a)
* Milliseconds to wait for each read of the server's reply; 0 waits for ever.  A read that times out fails the request as a lost
* connection does (the call returns its failure value and error is not set by it).  connect() leaves this at 0; connect.keys sets
* 30000 unless this was called first with another value.

public subroutine settimeout(ms)
   if not(num(ms)) or ms < 0 then abort 'Illegal timeout'
   io.ms = ms + 0
end

* ======================================================================
* CONNECTED

public function connected()
   return context # CX.DISCONNECTED
end

* ======================================================================
* DELETE

public subroutine delete(fno, id)
   if not(context.error(CX.CONNECTED)) then
      pkt = iconv(fno, 'ISL')
      if len(id) < 1 or len(id) > MAX.ID.LEN then
         server.error = SV$ON.ERROR
         ServerStatus = ER$IID
         LastError = SV$ON.ERROR   ;* a quiet caller reads this instead of the abort
      end else
         pkt := id
         if not(message.pair(SrvrDelete, pkt)) then return
      end

      if server.error = SV$ON.ERROR and not(quiet) then
         abort 'DELETE generated an abort event'
      end
   end
end

* ======================================================================
* DELETEU

public subroutine deleteu(fno, id)
   if not(context.error(CX.CONNECTED)) then
      pkt = iconv(fno, 'ISL')
      if len(id) < 1 or len(id) > MAX.ID.LEN then
         server.error = SV$ON.ERROR
         ServerStatus = ER$IID
         LastError = SV$ON.ERROR   ;* a quiet caller reads this instead of the abort
      end else
         pkt := id
         if not(message.pair(SrvrDeleteu, pkt)) then return
      end

      if server.error = SV$ON.ERROR and not(quiet) then
         abort 'DELETE generated an abort event'
      end
   end
end

* ======================================================================
* DISCONNECT

public subroutine disconnect
   if context # CX.DISCONNECTED then gosub disconnect.session
end

* ======================================================================
* ENDCOMMAND

public subroutine endcommand
   if not(context.error(CX.EXECUTING)) then
      if message.pair(SrvrEndCommand, '') then
         context = CX.CONNECTED
      end
   end
end

* ======================================================================
* EXECUTE

public function execute(cmd, err)
   reply = ''
   if not(context.error(CX.CONNECTED)) then
      if message.pair(SrvrExecute, cmd) then
         begin case
            case server.error = SV$PROMPT
               context = CX.EXECUTING
               reply = in.pkt
            case server.error = SV$OK
               reply = in.pkt
            case server.error = SV$ON.ERROR
               abort 'EXECUTE generated an abort event'
         end case
      end
   end

   err = server.error
   return reply
end

* ======================================================================
* FILELOCK(fno, wait)   (20 Oct 26 dm, S.72) - request 32, the file number and the wait flag, two 16 bit numbers
* wait true asks the server to hold the request until the lock is free (the server blocks); false asks for it at once and a busy file takes the LOCKED reply (LastError 4, ServerStatus
* the holder's user number on the server).  The $netfile handler of a remote file only ever sends false.  A login that is not in the server's sdfileswrite group is refused with an ON
* ERROR reply (message 12526).  Like recordlock(), it aborts the caller on an ON ERROR reply unless quiet is set.

public subroutine filelock(fno, wait)
   if not(context.error(CX.CONNECTED)) then
      pkt = iconv(fno, 'ISL')
      pkt := iconv(if wait then 1 else 0, 'ISL')
      if message.pair(SrvrFilelock, pkt) then
         if server.error = SV$ON.ERROR and not(quiet) then
            abort 'FILELOCK generated an abort event'
         end
      end
   end
end

