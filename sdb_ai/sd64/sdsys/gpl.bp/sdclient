public subroutine recordlock(fno, id, update, wait)
   if not(context.error(CX.CONNECTED)) then
      if len(id) > MAX.ID.LEN then
         server.error = SV$ON.ERROR
         ServerStatus = ER$IID
         LastError = SV$ON.ERROR   ;* a quiet caller reads this instead of the abort
      end else
         flags = if update then 1 else 0
*        18 Oct 26 dm - S.65 slice 3e: flag 2 is NO wait (apisrvr; the C client sends if (!wait) flags |= 2).  This used to read
*        the test was the other way round, which made every waiting lock a no-wait one and the reverse.
         if not(wait) then flags += 2
         pkt = iconv(fno, 'ISL')
         pkt := iconv(flags, 'ISL')
         pkt := id
         if not(message.pair(SrvrLockRecord, pkt)) then
            server.error = SV$ON.ERROR
         end
      end

      if server.error = SV$ON.ERROR and not(quiet) then
         abort 'RECORDLOCK generated an abort event'
      end
   end
end

