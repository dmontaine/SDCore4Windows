* START-HISTORY:
* 8 Nov 26 dm  New (S.179, S.180).  The owner, 8 Nov: "The commands need to be consistent across all pages ... the theme switching capability should be
*              available on every page using the same methodology and should appear in the menu under view"; "all features available on a page need to
*              appear somewhere on the menus".
* 9 Nov 26 dm  S.186 (Fable's review): View > Mouse on every page - the op 'keys' adds the entry (action std.mouse, no key), the op 'mouse' switches it
*              for the session (common /$tkmouse/), the op 'apply' puts it back after a page's SCREEN OPEN ($tk_open), the op 'set' is the IDE's.  Each page
*              answers the entry (act:std.mouse) itself: the bar runs nothing (S.88 decision 25).  Ctrl-O, View > Output: the op 'output' shows the log of the
*              commands $tk_run and $tk_runx ran ($tk_out 'loglines') on a page with no output pane of its own; 'keys' adds the row only there.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $tk_std(op, ctx, keys, pane, ret)
*
*     op keys     adds to the page's key table (keys) the rows every page has - Ctrl-T theme (action theme) and Ctrl-K keys (action keys) - and their
*                 menu entries, View > Theme and Help > Keys.  A page calls it once in its build of the table, after its own View and Help entries.
*                 ret is not used.
*     op theme    the page's handler of Ctrl-T (and of the menu entry, which a page receives as the key): the next theme, kept for the person, and the
*                 library's screen drawn again in it ($tk_theme 1).  ret<1> 1 when a new theme is in force (the page then draws itself whole, as
*                 after a resize, so that colours it makes from the theme are made again), ret<2> the line for the status bar.
*     op mouse    View > Mouse (9 Nov 26): the terminal's mouse reports off, or on again, for the rest of the session.  $tk_menubar calls it when the entry is
*                 chosen; no page does.  ret<1> 1 when the mouse is now off, ret<2> the line for the status bar.
*     op output   Ctrl-O, View > Output (9 Nov 26), on a page that has no output pane of its own ('keys' adds the row only then): the log of the commands
*                 $tk_run and $tk_runx ran for this page, newest first, in a window over the page.  ret<1> 0, ret<2> null.
*     op apply    $tk_open's (and the IDE's) call after SCREEN OPEN: the mouse off again if it was switched off.  ret 1 when it is off.
*     op set      pane 1 switches the mouse off, 0 on (the IDE's MOUSE / NO.MOUSE in &ide.options&); ret 1 when it is off.  The IDE's View > Mouse is op mouse.
*     op keylist  the page's handler of Ctrl-K: the keys of this page that the focused pane (pane) uses, each with what it does and why it is out of
*                 use when it is, in a box over the page; the box puts back what was under it.  ret<1> 0, ret<2> null.
*
*   THE ROUTINE IS NOT THE REGISTRY.  The registry ($tk_keys) runs nothing; a page's own case on Ctrl-T or the action calls this routine, so every page
*   does the same thing the same way.  F1 help, F5 refresh, F6 / Shift-F6 the boxes, F10 and Esc the menu bar, Ctrl-L a redraw ($screen_key) and Ctrl-Q
*   leave are the page's own rows, as they were.
*
* END-DESCRIPTION
*
* START-CODE
$internal
subroutine tk_std(op, ctx, keys, pane, ret)
$catalog $tk_std
$include sl.h
$include tk.h

   common /$tkmouse/ tm.off                       ;* 9 Nov 26 (S.186): View > Mouse switched off, for the session ($ name: no user program can set it); 0 when never set

   ret = ''
   if tm.off # 1 then tm.off = 0
   begin case
      case op = 'keys'
         * The two rows are bound and in the menus, but not written on the page's function-key row, which is each page's own (as tool_home's off.row)
         call $tk_keys('add', keys, 'ctrl-t', 'theme', 'theme', '', 1)
         keys<dcount(keys, @fm), TK.K.ROW> = 0
         call $tk_keys('add', keys, 'ctrl-k', 'keys', 'keys', '', 1)
         keys<dcount(keys, @fm), TK.K.ROW> = 0
         call $tk_keys('menu', keys, 'theme', '&View', '&Theme', '', '')
         call $tk_keys('menu', keys, 'keys', '&Help', '&Keys', '', '')
         * 9 Nov 26 (S.186): View > Mouse, an action with no key; the menu bar runs it itself ($tk_menubar), so no page has a case for it
         call $tk_keys('add', keys, '', 'mouse', 'std.mouse', '', 1)
         keys<dcount(keys, @fm), TK.K.ROW> = 0
         call $tk_keys('menu', keys, 'std.mouse', '&View', '&Mouse', '', '')
         * 9 Nov 26 (S.186): Ctrl-O, View > Output: the log of the commands this page ran ($tk_out 'loglines'), on a page that has no output pane of its own
         *   (a page that binds Ctrl-O itself - tool.jobs, tool.sessions, tool.test - keeps its pane and gets no second entry)
         std.has.o = (ctx = '')                        ;* !CED()'s host gives no page context: it runs no command and has no menu bar, so no Ctrl-O
         for std.i = 1 to dcount(keys, @fm)
            if keys<std.i, TK.K.KEY> = 'ctrl-o' then std.has.o = @true
         next std.i
         if not(std.has.o) then
            call $tk_keys('add', keys, 'ctrl-o', 'output', 'std.output', '', 1)
            keys<dcount(keys, @fm), TK.K.ROW> = 0
            call $tk_keys('menu', keys, 'std.output', '&View', '&Output of the commands', '', '')
         end

      case op = 'output'
         * 9 Nov 26 (S.186): the log of the commands this page ran, newest first, in a window over the page that puts back what was under it; typing narrows
         *   it, Enter or Esc closes it, and nothing in it is run
         call $tk_out('loglines', ctx, '', '', std.ll)
         if std.ll = '' then std.ll = sysmsg(15041)
         call $sl_pickwin(std.ll, sysmsg(15042), 0, 1, std.pr, std.ps, '', '')
         ret = 0 : @fm : ''

      case op = 'mouse'
         * 9 Nov 26 (S.186): the terminal stops (or starts again) reporting the mouse, for every page of this session from now on (the switch is kept in the
         * named common, and $tk_open applies it when a page takes the screen); the library's screen is told, so that SCREEN CLOSE switches off only what is on
         tm.off = not(tm.off)
         gosub mouse.apply
         ret = (if tm.off then 1 else 0) : @fm : (if tm.off then sysmsg(15039) else sysmsg(15038))

      case op = 'apply'
         * after SCREEN OPEN (which switches the mouse on): off again when the person switched it off on an earlier page
         if tm.off then gosub mouse.apply
         ret = tm.off

      case op = 'set'
         * the IDE's &ide.options& MOUSE / NO.MOUSE: pane 1 off, 0 on; the terminal is told only when that changes the switch
         if (pane = 1) # tm.off then
            tm.off = (pane = 1)
            gosub mouse.apply
         end
         ret = tm.off

      case op = 'theme'
         call $tk_theme(1, chg, tmsg)
         ret = chg : @fm : tmsg

      case op = 'keylist'
         call $tk_keys('keylist', keys, pane, kl, '', '', '')
         lines = ''
         for i = 1 to dcount(kl, @fm)
            lines<1, -1> = kl<i>
         next i
         if lines = '' then lines = 'This page has no keys of its own.'
         call $sl_scr('get', scr)
         hw = ''
         hw<SL.W.D> = 'Keys of this page'
         hw<SL.W.D + 1> = lines
         hw<SL.W.D + 2> = '&OK'
         call $sl_msgbox('init', hw, scr, '', hb)       ;* over the page's own picture, which the box puts back cell for cell when it closes
         call $sl_msgbox('run', hw, scr, '', hb)
         call $sl_scr('put', scr)
         ret = 0 : @fm : ''
   end case
   return

mouse.apply:
   call $sl_scr('get', ms.scr)
   if tm.off then call $sl_mouse('off', ms.seq) else call $sl_mouse('on', ms.seq)
   display ms.seq :
   ms.scr<SL.S.MOUSE> = (if tm.off then 0 else 1)
   call $sl_scr('put', ms.scr)
   return
end

* END-CODE
