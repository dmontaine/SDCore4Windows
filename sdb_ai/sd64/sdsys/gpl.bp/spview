map.keys:
   n = seq(c)
   begin case
      case n = K$UP         ; c = 'U'
      case n = K$DOWN       ; c = 'D'
      case n = K$PAGE.UP    ; c = 'P'
      case n = K$PAGE.DOWN  ; c = 'N'
      case n = K$LEFT       ; c = 'L'
      case n = K$RIGHT      ; c = 'R'
      case n = K$RETURN     ; c = 'N'     ;* 13 Oct 26 dm - Return pages forward in a record
      case n = K$HOME       ; c = 'T'
      case n = K$END        ; c = 'B'
      case n = CTRL.B       ; c = 'L'
      case n = CTRL.F       ; c = 'R'
      case n = CTRL.N       ; c = 'D'
      case n = CTRL.P       ; c = 'U'
      case n = CTRL.V       ; c = 'N'
      case n = CTRL.Z       ; c = 'U'
      * 8 Nov 26 (S.179, S.180): the keys every page has, and the menu bar, in the pages' look
      case n = K$F5 or n = 12 ; c = '#REFRESH'      ;* F5, Ctrl-L: draw the screen again
      case n = 20 and look  ; c = '#THEME'           ;* Ctrl-T: the next theme, kept for the person
      case n = 11           ; c = '#KEYS'            ;* Ctrl-K: the keys
      case n = K$F1         ; c = '#KEYS'            ;* F1: SP.VIEW's help is its keys
      case n = 17           ; c = 'Q'                ;* Ctrl-Q: leave, as on every page (Q still does)
      case (n = 27 or n = K$F10) and look
         gosub sp.menu                              ;* Esc or F10: the menu bar; c is the letter of what was chosen, or null
   end case

   return

* 8 Nov 26 (S.180, the owner: "all features available on a page need to appear somewhere on the menus") - the menu bar of the pages' look: File, View,
* Help.  Each entry's code is the letter (or #word) the key loop acts on, so a choice does exactly what its key does.
sp.bar:
   sp.w = ''
   sp.w<SL.W.Y> = 0
   sp.w<SL.W.W> = lay.w
   sp.m = '&File'
   sp.m<1, -1> = '&Spool to a printer' : @sm : 'S' : @sm : 'S'
   sp.m<1, -1> = '&Delete the item' : @sm : 'X' : @sm : 'X'
   sp.m<1, -1> = '-'
   sp.m<1, -1> = '&Quit' : @sm : 'Ctrl-Q' : @sm : 'Q'
   sp.w<20> = sp.m
   sp.m = '&View'
   sp.m<1, -1> = '&Next page' : @sm : 'PgDn' : @sm : 'N'
   sp.m<1, -1> = '&Previous page' : @sm : 'PgUp' : @sm : 'P'
   sp.m<1, -1> = '&Top' : @sm : 'Home' : @sm : 'T'
   sp.m<1, -1> = '&Bottom' : @sm : 'End' : @sm : 'B'
   sp.m<1, -1> = 'Scroll &left' : @sm : 'Left' : @sm : 'L'
   sp.m<1, -1> = 'Scroll &right' : @sm : 'Right' : @sm : 'R'
   sp.m<1, -1> = '-'
   sp.m<1, -1> = 'T&heme' : @sm : 'Ctrl-T' : @sm : '#THEME'
   sp.m<1, -1> = 'Re&fresh' : @sm : 'F5' : @sm : '#REFRESH'
   sp.w<21> = sp.m
   sp.m = '&Help'
   sp.m<1, -1> = '&Keys' : @sm : 'Ctrl-K' : @sm : '#KEYS'
   sp.w<22> = sp.m
   sp.tw = 0
   for sp.i = 20 to 22
      sp.tw += len(convert('&', '', sp.w<sp.i, 1>)) + 2
   next sp.i
   return

sp.menu:
   gosub sp.bar
   call $sl_menu('init', sp.w, scr, '', sp.r)
   call $sl_menu('run', sp.w, scr, '', sp.code)
   c = sp.code
   gosub paint.frame                  ;* the bar as it is when closed, with the names after the titles
   return

end


