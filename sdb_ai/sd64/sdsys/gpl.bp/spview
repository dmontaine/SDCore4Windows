$internal
program spview
$catalog $spview

$include parser.h
$include err.h
$include int$keys.h
$include keys.h
$include keyin.h
$include sl.h
$include tk.h

$define LAY.WIDTH    140         ;* 2 Nov 26 (S.99): the record view has the pages' look on a window this wide ...
$define LAY.DEPTH     43         ;* ... and this deep, or bigger (used whole); below it, the old layout

   deffun edit_msg(emk) calling '!edit_msg'       ;* 18 Oct 26 dm, S.66

   parser = "!PARSER"
   prompt ''

   @system.return.code = -ER$ARGS

   prompt.line = @crthigh - 1
   info.line = @crthigh - 2
   info.fmt = (@crtwide - 1) : 'L'

   * 2 Nov 26 dm (S.99): the pages' look needs a terminal whose size the kernel can read (not a pipe, a phantom or the API) and that can
   * address a cell.  Without one, everything is as it was.
   look.able = (kernel(K$WINSIZE, '') # '' and terminfo('cup') # '')
   look = @false
   themed = @false
   view.w = @crtwide
   data.row = 0
   last.w = -1
   last.h = -1
   input.ended = @false          ;* 2 Nov 26: the input has ended (get.key), so no key will ever come

   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb

   * Get command arguments

   file.name = ''
   item.name = ''
   lptr = 0
   numbering = @false
   sort.clause = ''              ;* 13 Oct 26 dm - openQM 'SP.VIEW file BY field'
   sort.state = 0                ;* 1 = a field name must follow BY, 2 = NO.CASE may follow it
   sort.no.case = @false         ;* The NO.CASE qualifier: SELECT has no such word, so the list is sorted again here (27 Oct 26: OPTION QUERY.SORT.NO.CASE is gone)
   sort.field = ''
   sort.dsnd = @false

   loop
      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   until token.type = PARSER$END
      begin case
         case sort.state = 1 and keyword = KW$NO.CASE
            sort.no.case = @true          ;* Before the field name

         case sort.state = 1
            sort.clause := ' ' : token
            sort.field = token
            sort.state = 2

         case sort.state = 2 and keyword = KW$NO.CASE
            sort.no.case = @true          ;* After it
            sort.state = 0

         case keyword = KW$BY or keyword = KW$BY.DSND
            if sort.clause # '' then stop sysmsg(2018, token) ;* Unexpected token (xx)
            by.token = token
            sort.dsnd = (keyword = KW$BY.DSND)
            sort.clause = ' ' : token
            sort.state = 1

         case keyword = KW$DICT
            call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
            if token.type = PARSER$END then stop 'File name required'
            file.name = 'DICT ' : token

         case keyword = KW$LPTR
            call @parser(PARSER$GET.TOKEN, token.type, lptr, keyword)
            if token.type # PARSER$TOKEN or not(lptr matches '1-3N') or lptr < 0 or lptr > LPTR$HIGH.PRINT.UNIT then
               stop sysmsg(2053) ;* Invalid print unit number
            end
            lptr += 0

         case item.name = ''
            item.name = token

         case file.name = ''
            file.name = item.name
            item.name = token

         case 1
            stop sysmsg(2018, token ) ;* Unexpected token (xx)
      end case
   repeat

   if sort.state = 1 then stop sysmsg(7266, by.token) ;* Expected field name after xx

   if file.name = '' then
      * If we have just one name, resolve whether we are looking at a single
      * $hold item or whether it is a file name. We consider it as a file
      * name if it exists as an F or Q-type VOC entry and there is no item
      * in $hold with this name.

      file.name = '$hold'   ;* Assume $hold for now

      if item.name # '' then
         fn = field(item.name, ',', 1)
         read voc.rec from @voc, fn else
            read voc.rec from @voc, upcase(fn) else null
         end

         voc.type = upcase(voc.rec[1,1])
         if voc.type = 'F' or voc.type = 'Q' then
            * Check for $hold entry with this name
            open '$hold' to data.f then
               readv rec from data.f, item.name, 0 else
                  * There is no such $hold item. Assume that the name we
                  * are currently treating as an item is actually a file.
                  file.name = item.name
                  item.name = ''
               end
            end
         end
      end
   end

   open file.name to data.f else
      open downcase(file.name) to data.f then
         file.name = downcase(file.name)
      end else
         open upcase(file.name) to data.f else
            @system.return.code = status()
            stop sysmsg(2019) ;* File not found
         end
         file.name = upcase(file.name)
      end
   end

   saved.key.bindings = bindkey('', -3)
   void bindkey('', -5)
   i = bindkey(char(27):'V', K$PAGE.UP)
   i = bindkey(char(27):'v', K$PAGE.UP)
   i = bindkey(char(27):'Z', K$PAGE.UP)    ;* 13 Oct 26 dm - the page's Esc-Z, up one page in a record
   i = bindkey(char(27):'z', K$PAGE.UP)
   i = bindkey(char(27):'<', K$HOME)
   i = bindkey(char(27):'>', K$END)
   
   if item.name = '' then
      if sort.clause = '' then
         sselect data.f to 11
      end else
         * 18 Oct 26 Windows port - from Linux ab4dab3 (13 Oct 26): - openQM: the sort clause has the form of a query processor BY / BY.DSND clause.
         * Like openQM's, it makes the default select list and so replaces any that was active.
         execute 'SELECT ' : file.name : sort.clause capturing sort.output
         readlist item.list from 0 else
            item.list = ''
            if not(index(sort.output, 'selected', 1)) then   ;* Not the 'n record(s) selected' line: an error
               display sort.output
               stop
            end
         end
         if sort.no.case and item.list # '' then gosub sort.list.no.case
      end
      if sort.clause = '' then readlist item.list from 11 else null
      pick.pos = ''
      loop
         call !pick(item.name,
                    0,
                    item.list,
                    file.name,
                    pick.pos)
      until item.name = ''
         item.deleted = @false
         gosub show.item
         if input.ended then exit          ;* 2 Nov 26: nobody is there to choose another

         if item.deleted then
            * Take it off the list, and keep the cursor about where it was
            locate item.name in item.list<1> setting i then del item.list<i>
            if item.list = '' then exit
            sel = field(pick.pos, '.', 2) + 0
            if sel > dcount(item.list, @fm) then sel = dcount(item.list, @fm)
            if sel < 1 then sel = 1
            per.page = @crthigh - 3
            pick.pos = (sel - 1 - rem(sel - 1, per.page)) : '.' : sel
         end
      repeat
   end else
      gosub show.item
   end

   display @(-1) :

   @system.return.code = 0

   i = bindkey(saved.key.bindings, -4)

   return

* ======================================================================
* sort.list.no.case  -  BY / BY.DSND field NO.CASE (27 Oct 26: the query processor's option QUERY.SORT.NO.CASE is gone, so the list is
* sorted again here).  SELECT has sorted item.list with case counting; each id is now put in order of the upper-cased value of the field
* (TRANS reads it through the dictionary), the id breaking ties.  A field whose values are all numbers, or null, was ordered by value
* already and is left as it is.

sort.list.no.case:
   n.ids = dcount(item.list, @fm)
   sort.keys = ''
   all.numeric = @true
   for ix = 1 to n.ids
      sort.key = upcase(trans(file.name, item.list<ix>, sort.field, 'X'))
      if sort.key # '' and not(num(sort.key)) then all.numeric = @false
      sort.keys<ix> = sort.key
   next ix
   if all.numeric then return

   ordered.keys = ''
   ordered.ids = ''
   for ix = 1 to n.ids
      composite = sort.keys<ix> : char(1) : item.list<ix>
      if sort.dsnd then
         locate composite in ordered.keys<1> by 'DL' setting pos else null
      end else
         locate composite in ordered.keys<1> by 'AL' setting pos else null
      end
      ins composite before ordered.keys<pos>
      ins item.list<ix> before ordered.ids<pos>
   next ix
   item.list = ordered.ids
   return

* ======================================================================
* show.item  -  Show entry with name in item.name

show.item:
   data.lines.per.page = @crthigh - 4

   display @(-1) :

   read rec from data.f, item.name else
      display @(20,10) : sysmsg(7137) ;* Unable to read item. It may have been deleted.
      c = keycode()
      return
   end

   num.lines = dcount(rec, @fm)

   if look.able then gosub theme.in       ;* 2 Nov 26 (S.99): the site's theme while a record is shown (given back below)
   gosub set.look

   data.offset = 0
   pan = 1
   gosub show.data.page

   loop
      info.text = sysmsg(7138, item.name, num.lines, data.offset + 1, pan)
      * %1 (%2 lines, top = %3, left = %4)

      data.prompt = ''
      if data.offset + data.lines.per.page < num.lines then data.prompt := 'Next/'
      if data.offset > 0 then data.prompt := 'Previous/'
      if pan > 1 then data.prompt := 'Left/'
      if more.right then data.prompt := 'Right/'
      data.prompt := 'Top/Bottom/Spool/X-delete/Quit: '

      if look then
         call $sl_put(scr, 0, info.line, fmt(info.text[1, lay.w], lay.w : 'L'), rev.attr)   ;* the status line
         call $sl_put(scr, 0, prompt.line, fmt(data.prompt[1, lay.w], lay.w : 'L'), bar.attr)
      end else
         display @(0, info.line) : @(-13) : fmt(info.text, info.fmt) :
         display @(0,prompt.line) : fmt(data.prompt, info.fmt) : @(-14) :
      end
      display @(len(data.prompt), prompt.line) :

      gosub get.key
      if input.ended then exit             ;* 2 Nov 26: the input has ended (a pipe used up, a terminal gone)
      if k.relaid then                    ;* the window changed: laid out again for its new size, and drawn
         gosub show.data.page
         continue
      end
      c = upcase(c)
      gosub map.keys

      begin case
         case c = 'Q'
            prompt.text = sysmsg(7136) ;* Press return to quit, any other key to continue
            gosub say.prompt
            if seq(keycode()) = K$RETURN then exit

         case (c = 'P' or c = 'U') and data.offset > 0
            data.offset -= data.lines.per.page
            gosub show.data.page

         case (c = 'N' or c = 'D') and (data.offset + data.lines.per.page < num.lines)
            data.offset += data.lines.per.page
            gosub show.data.page

         case c = 'T'
            data.offset = 0
            gosub show.data.page

         case c = 'B'
            data.offset = num.lines - 1 - rem(num.lines - 1, data.lines.per.page)
            gosub show.data.page

         case c = 'R' and more.right
            pan += view.w - 20
            gosub show.data.page

         case c = 'L' and pan > 1
            pan -= view.w - 20
            if (pan < 1) then pan = 1
            gosub show.data.page

         case c = 'S'
            gosub spool.item
            gosub show.data.page

         case c = 'X'
            gosub delete.item
            if item.deleted then exit
            gosub show.data.page

         * 8 Nov 26 (S.179): the keys every page has
         case c = '#REFRESH'
            if look then gosub set.look
            display @(-1) :
            gosub show.data.page

         case c = '#THEME'
            themed = @true                      ;* theme.out gives the program's own theme back when the record is left
            call $tk_theme(0, sp.chg, sp.msg)   ;* 0: SP.VIEW draws its own screen, below
            if sp.chg then
               gosub set.look                   ;* the styles of the new theme
               display @(-1) :
               gosub show.data.page
            end
            prompt.text = sp.msg
            gosub say.note

         case c = '#KEYS'
            if look then
               gosub paint.frame                ;* kr.keys, the table of the key row
               call $tk_keys('keylist', kr.keys, '', sp.kl, '', '', '')
               sp.kl<-1> = 'F5   refresh (Ctrl-L too)'
               sp.kl<-1> = '^T   theme'
               sp.kl<-1> = '^K   keys (F1 too)'
               sp.kl<-1> = '^Q   quit'
               sp.kl<-1> = 'Esc  the menu bar (F10 too)'
               sp.hw = ''
               sp.hw<SL.W.D> = 'Keys of SP.VIEW'
               sp.hw<SL.W.D + 1> = convert(@fm, @vm, sp.kl)
               sp.hw<SL.W.D + 2> = '&OK'
               call $sl_msgbox('init', sp.hw, scr, '', sp.hb)     ;* over the picture, which the box puts back when it closes
               call $sl_msgbox('run', sp.hw, scr, '', sp.hb)
            end else
               display @sys.bell :
            end

         case c = ''
            null                                ;* a menu left with Esc: nothing chosen

         case 1
            display @sys.bell :
      end case
   repeat

   if themed or look then gosub theme.out   ;* 2 Nov 26 (S.99): the theme given back, and a plain screen for the pick list or TCL

   return

* ======================================================================
* 2 Nov 26 dm (S.99) - SET.LOOK  -  The layout for the window as it is now.  look: the pages' look, on a window of at least LAY.WIDTH by
*   LAY.DEPTH (a bigger one is used whole): row 0 the bar, the record's lines from row 1 (data.row), then the prompt line, the status line, the
*   border and the key row.  Otherwise the layout SP.VIEW always had: the lines from row 0, the status line and the prompt line at the foot of
*   the display SD has (@CRTWIDE by @CRTHIGH), in reverse video.

set.look:
   call $sl_window(win.w, win.h)
   last.w = win.w
   last.h = win.h
   look = (look.able and win.w >= LAY.WIDTH and win.h >= LAY.DEPTH)
   if look then
      lay.w = win.w
      lay.h = win.h
      view.w = lay.w
      data.row = 1
      data.lines.per.page = lay.h - 5
      prompt.line = lay.h - 4
      info.line = lay.h - 3
      border.line = lay.h - 2
      key.line = lay.h - 1
      call $sl_scr('get', scr)          ;* a context of this program's own, the size of the display; the library's own is not written back
      scr<SL.S.CLIP> = ''
   end else
      view.w = @crtwide
      data.row = 0
      data.lines.per.page = @crthigh - 4
      prompt.line = @crthigh - 1
      info.line = @crthigh - 2
      info.fmt = (@crtwide - 1) : 'L'
   end
   return

* GET.KEY  -  One key, in c.  On a terminal the window is looked at once a second while the key is awaited: when its size has changed, the
*   page is laid out for the new size (set.look), k.relaid is true and c is null, and the caller draws the page again.
*   2 Nov 26: input.ended is set when the input has ended - a null key that is not a timeout.  With no terminal no timeout is asked, so
*   every null key is the end; on a terminal it is a null key whose STATUS() is not ER$TIMEOUT.
get.key:
   k.relaid = @false
   if not(look.able) then
      c = keycode()
      if c = '' then input.ended = @true
      return
   end
   loop
      c = keycode(1)
      k.st = status()
   until c # '' or k.st # ER$TIMEOUT
      call $sl_window(win.w, win.h)
      if win.w # last.w or win.h # last.h then
         gosub set.look
         display @(-1) :
         k.relaid = @true
         return
      end
   repeat
   if c = '' then input.ended = @true      ;* (k.st is not ER$TIMEOUT: the loop above ends on a null key only then)
   return

* THEME.IN / THEME.OUT  -  The screen library's theme while a record is shown, chosen as the debugger chooses its own: the theme in force is
*   kept unless it is mono (as it is at TCL); then the site's theme (SCREENTHEME in sd.conf), and if that names none, or is mono, or this
*   terminal cannot show it, the classic theme; a terminal with no colour keeps mono.  THEME.OUT puts the theme back and clears the screen in
*   the plain style, for the pick list and for TCL.
theme.in:
   call $sl_theme('name', '', '', '', '', old.theme)
   themed = @false
   if old.theme = '' or old.theme = 'mono' then
      call $sl_theme('site', '', '', '', '', site.theme)     ;* 8 Nov 26 (S.179): the person's own theme first, then SCREENTHEME
      th.r = 2
      if site.theme # '' and site.theme # 'mono' then call $sl_theme('set', site.theme, '', '', '', th.r)
      if th.r # 0 then call $sl_theme('set', 'classic', '', '', '', th.r)
      if th.r = 0 then themed = @true
   end
   bar.attr = 'a'                        ;* bar: the bar, the prompt line and the key row
   text.attr = 't'                       ;* text: the record's lines and the border
   call $sl_theme('code', 'reverse', '', '', '', rev.attr)      ;* the status line
   return

theme.out:
   if themed then
      call $sl_theme('set', old.theme, '', '', '', th.r)
      if old.theme = '' or th.r # 0 then call $sl_theme('set', 'mono', '', '', '', th.r)
      themed = @false
   end
   call $sl_sgr('n', sq)
   display sq : @(-1) :
   look = @false
   return

* PAINT.FRAME  -  The bar (row 0) and the foot (the border and the key row) in the pages' look.  The status line and the prompt line are the
*   command loop's.  The key row is made from a key table by $tk_keys and $tk_fkeys, as the debugger's foot is; its table lists only keys the
*   command loop acts on (map.keys and the case c = lines).
paint.frame:
   pf.app = 'sp.view  ' : @logname : '@' : @who : ' '
   pf.left = file.name : '  ' : item.name
   * 8 Nov 26 (S.180): the menu bar's titles first (File View Help: Esc or F10 opens it), then the file and the item
   gosub sp.bar
   call $sl_menu('init', sp.w, scr, '', sp.r)
   call $sl_menu('draw', sp.w, scr, '', sp.r)
   pf.w = lay.w - len(pf.app) - sp.tw
   if pf.w > 1 then call $sl_put(scr, sp.tw, 0, fmt(pf.left[1, pf.w - 1], pf.w : 'L'), bar.attr)
   call $sl_put(scr, lay.w - len(pf.app), 0, pf.app[1, len(pf.app)], bar.attr)    ;* a copy: $sl_put cuts the text it is given
   call $sl_line('h', 0, pf.hc)
   call $sl_put(scr, 0, border.line, str(pf.hc, lay.w), text.attr)
   kr.keys = ''
   call $tk_keys('add', kr.keys, 'pgdn', 'next', 'next', '', '')
   call $tk_keys('add', kr.keys, 'pgup', 'previous', 'previous', '', '')
   call $tk_keys('add', kr.keys, 'home', 'top', 'top', '', '')
   call $tk_keys('add', kr.keys, 'end', 'bottom', 'bottom', '', '')
   call $tk_keys('add', kr.keys, 'left', 'scroll left', 'left', '', '')
   call $tk_keys('add', kr.keys, 'right', 'scroll right', 'right', '', '')
   call $tk_keys('add', kr.keys, 's', 'spool', 'spool', '', '')
   call $tk_keys('add', kr.keys, 'x', 'delete', 'delete', '', '')
   call $tk_keys('add', kr.keys, 'q', 'quit', 'quit', '', '')
   kr.ctx = ''
   kr.ctx<TK.C.W> = lay.w
   call $tk_fkeys(kr.ctx, kr.keys, '', key.row)
   call $sl_put(scr, 0, key.line, key.row, bar.attr)
   return

* SAY.PROMPT / SAY.NOTE  -  prompt.text on the prompt line (in reverse video, or in the bar style in the pages' look); SAY.PROMPT puts the
*   cursor after it.
say.prompt:
   gosub say.note
   display @(len(prompt.text), prompt.line) :
   return

say.note:
   if look then
      call $sl_put(scr, 0, prompt.line, fmt(prompt.text[1, lay.w], lay.w : 'L'), bar.attr)
   end else
      display @(0,prompt.line) : @(-13) : fmt(prompt.text, info.fmt) : @(-14) :
   end
   return

* ======================================================================
* delete.item  -  Delete the item being shown, after asking (12 Oct 26 dm,
* openQM 450: hold file items can be deleted). Sets item.deleted.

delete.item:
   item.deleted = @false

* 17 Oct 26 dm - S.64: deleting a record of a VOC, a dictionary or a program file needs the gate.  The answer comes from the kernel by the
*   pathname of the file OPEN in data.f, so a Q-pointer is caught.  Asked before the question and before the lock, and the reason goes on the
*   prompt line as every complaint here does (edit_guard() would DISPLAY over the page).  $hold and every ordinary file pass, as before.
   edit.p = fileinfo(data.f, FL$PATH)
   if not(kernel(K$EDIT.OK, edit.p)) then
      edit.kind = kernel(K$EDIT.KIND, edit.p)
      prompt.text = edit_msg(edit.kind) ;* 12410 VOC, 12411 dictionary, 12412 program file, 12518 shared record, 12519 shared structure
      gosub say.note
      c = keycode()
      return
   end

   prompt.text = sysmsg(12110, item.name, file.name) ;* Delete xx from xx (Y/N)?
   gosub say.prompt
   if upcase(keycode()) # 'Y' then return

   readvu dummy from data.f, item.name, 0 locked
      prompt.text = sysmsg(12078, item.name) ;* Record 'xx' is locked by another user and was not deleted
      gosub say.note
      c = keycode()
      return
   end then
      delete data.f, item.name
      on error
         prompt.text = sysmsg(3222, status(), item.name) ;* Error xx deleting record xx
         gosub say.note
         release data.f, item.name
         c = keycode()
         return
      end
      item.deleted = @true
   end else
      release data.f, item.name
      item.deleted = @true     ;* It has gone already
   end

   return

* ======================================================================
* show.data.page  -  Show a page of data

show.data.page:
   more.right = @false
   if look then                    ;* 2 Nov 26 (S.99): the pages' look - the bar, the lines from row 1 in the text style, the foot
      gosub paint.frame
      for i = 1 to data.lines.per.page
         j = i + data.offset
         s = ''
         if j <= num.lines then
            s = rec<j>
            if len(s) >= pan + view.w then more.right = @true
            s = s[pan, view.w]
         end
         call $sl_put(scr, 0, data.row + i - 1, s : space(view.w - len(s)), text.attr)
      next i
      return
   end

   for i = 1 to data.lines.per.page
      display @(0,i-1) : @(-4) :
      j = i + data.offset
      if j <= num.lines then
         s = rec<j>
         if len(s) >= pan + @crtwide then more.right = @true
         display s[pan,@crtwide] :
      end
   next i

   return

* ======================================================================
* spool.item  -  Spool the selected item

spool.item:
   display @(-1) :
   display @(0,2) : sysmsg(7139, file.name, item.name) ;* Preparing to print %1 %2

   display @(0,4) : sysmsg(7140, lptr) ;* Printer  : xx
   col = 11
   gosub show.printer

   display @(0,14) : sysmsg(7141, oconv(numbering, 'B')) ;* Numbering: xx

   loop
      * Confirm the printer

      loop
         input @(col,4) : lptr, 3_:
         if status() = ER$EOF then return      ;* 2 Nov 26: the input has ended; nothing is printed
      until lptr matches '1-3N' and lptr <= LPTR$HIGH.PRINT.UNIT
         inputerr sysmsg(2053) ;* Invalid printer number
      repeat

      gosub show.printer

      * Select numbering mode

      loop
         s = oconv(numbering, 'B')
         input @(col,14) : s, 1_:
         if status() = ER$EOF then return      ;* 2 Nov 26: as above
         s = iconv(s, 'B')
      until status() = 0
         inputerr sysmsg(7142) ;* Y or N only
      repeat
      numbering = s

      * Confirm everything

      yn = 'Y'
      display @(0,16) : sysmsg(7143) :  ;* 'Ok to print (Y/N/Q/?)? '
      loop
         input @(23,16) : yn, 1_:
         if status() = ER$EOF then return      ;* 2 Nov 26: the input has ended; leave the form (it used to ask again for ever)
         yn = upcase(yn)
         if yn = 'Q' then return
      until yn = 'Y' or yn = 'N'
         inputerr sysmsg(7144) ;* Y to print, N to re-enter printer details, Q to quit
      repeat
   until yn = 'Y'
   repeat

   * Spool the file
   
   display @(0, 18) : sysmsg(7145) :   ;* Printing item...
   number.format = "4'0'R"
   if lptr = 0 then printer on
   if num.lines > 9999 then number.format = len(num.lines):"'0'R"

   for i = 1 to num.lines
      if numbering then print on lptr fmt(i, number.format) : ': ' :
      print on lptr rec<i>
   next i
   printer close on lptr

   display @(0, 19) : sysmsg(7146) :  ;* Complete. Press any key to continue.
   c = keycode()

   return

* ======================================================================
* show.printer  -  Show printer settings

show.printer:
   display @(col,5)  : sysmsg(7112, getpu(PU$WIDTH, lptr)) : @(-4) :
   display @(col,6)  : sysmsg(7113, getpu(PU$LENGTH, lptr)) : @(-4) :
   display @(col,7)  : sysmsg(7114, getpu(PU$TOPMARGIN, lptr)) : @(-4) :
   display @(col,8)  : sysmsg(7115, getpu(PU$BOTMARGIN, lptr)) : @(-4) :
   display @(col,9)  : sysmsg(7127, getpu(PU$LEFTMARGIN, lptr)) : @(-4) :
   mode = getpu(PU$MODE, lptr)
   name = getpu(PU$LOCATION, lptr)
   flags = getpu(PU$SPOOLFLAGS, lptr)
   display @(col,10) : sysmsg(7128, mode) : @(-4) :
   begin case
      case mode = 1
         if name = '' then destination = sysmsg(7147) ;* Using default printer
         else destination = sysmsg(7130, name)
      case mode = 3
         if name = '' then
            name = '$hold P' : lptr
            if bitand(flags, PU$FLG.NEXT) then
               name := ' ' : sysmsg(7148) ;* (with sequence number)
            end
         end
         destination = sysmsg(7149, name) ;* File name     : xx

*     18 Oct 26 Windows port - from Linux e02672d (10 Oct 26): (openQM ref 560): modes 0, 4, 5 and 6 had no destination
*     line at all, and mode 6 is a printer and a hold file both.
      case mode = 0
         destination = sysmsg(12052) ;* Display
      case mode = 4
         destination = sysmsg(12053) ;* Standard error
      case mode = 5
         destination = sysmsg(12054) ;* Auxiliary port
      case mode = 6
         if name = '' then destination = sysmsg(7147) ;* Using default printer
         else destination = sysmsg(7130, name)
         hold.name = '$hold P' : lptr
         if bitand(flags, PU$FLG.NEXT) then hold.name := ' ' : sysmsg(7148)
         destination := '  ' : sysmsg(7149, hold.name)
   end case
   display @(col,11) : destination : @(-4) :

   flag.data = ''
   if bitand(flags, PU$FLG.NFMT) then flag.data := 'NFMT  '
   display @(col,12) : flag.data

   return

