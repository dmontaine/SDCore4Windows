* it and/or modify it under the terms of the GNU General Public License, version 3 or later.
*
* START-HISTORY:
* 28 Oct 26 dm  S.88 L2: the five boxes are panes of the layout service ($tk_layout), in two columns: drawn exactly as before at 140 by 43, and in a larger window the Accounts box takes the extra
*               rows (it shows more accounts) and What this means takes them on the right, both columns are as wide as the window allows, and the explanation wraps at its box's width.
*               The rows, widths, hit tests and the [?] buttons are counted from the pane rectangles.
* 28 Oct 26 dm  S.87: CLOSESEQ and EQU are gone as statements: this program says CLOSE and EQUATE.
* 22 Oct 26 dm  New.
* 23 Oct 26 dm  A [?] button on every setting (the rows of the Menu box, the system default, and the Accounts list), F1 and ? on the selected row: the help is the record
*               of the file context.help of the shared account ($tk_help).  The line wrapping is $tk_wrap.
* 26 Oct 26 dm  S.75, home: the Menu box lists the seven development tiles (Files, Vocabulary, Dictionary, Queries, Bulk update, Programs, Tests) and the Recent group after the seven
*               it had, so it is 17 rows (the number is nmenu); the Menu box is taller, What this means moves down with it, and the box of key hints is one line under the system default.
* 29 Oct 26 dm  S.88 g-P1: the Record editor entry (ced) is gone with the verb, so the Menu box is 16 rows (nmenu is counted from tids).
* 1 Nov 26 dm  S.99 (look only): names its focus boxes (ctx<TK.C.FOCI>), so $tk_frame marks the one with the focus [*] and the others [-], as the IDE does.
* 1 Nov 26 dm  S.97 stage 3: the AI line ($tk_aipage), as tool.voc has it: F6 or AI > Ask the AI; the pane switch and refresh are offered, none of the settings.
* 8 Nov 26 dm  S.176: F6 / Shift-F6 are the box keys of every page ($tk_aipage 'ring', the AI line one of the stops); Tab and Shift-Tab no longer switch the boxes
*              (Left and Right still do).  AI > Ask the AI is a menu entry of its own.
* 8 Nov 26 dm  S.179: Ctrl-T the theme (View > Theme) and Ctrl-K the keys of the page (Help > Keys), through $tk_std as on every page.
* 9 Nov 26 dm  S.186: View > Mouse and Ctrl-O (the log of the commands run), the same on every page (the cases act:std.mouse and ctrl-o, through $tk_std).
* END-HISTORY
*
* START-DESCRIPTION:
*
*   TOOL.MENUS
*
*   For the administrator only (it is refused, before anything is read, for anyone else; it is in SDSYS's VOC only).  A full-screen page, in the toolkit's frame
*   (140 columns by 43 lines at least), for what each account's HOME SCREEN shows and where each account starts:
*
*     Accounts    every registered account but SDSYS, with where it starts (its own setting, or the system default) and the tiles turned off for it
*     Menu        for the account selected: where it starts, whether it may add its own programs, and each standard tile of the home screen (and the Recent group) with its
*                 state, [x] on and [ ] off
*     Default     where an account with no setting of its own starts
*
*   Keys: Up and Down move in the pane, Tab and Back-tab (or Left and Right) change pane, Enter or the space bar changes the setting under the cursor, F5 reads the
*   register again, Ctrl-Q leaves.  A click selects a row.  F1 or ? on the selected row, or a click on the [?] at the end of a setting's row, shows what the
*   setting means (keys tool.menus.accounts, tool.menus.starts-in, tool.menus.pins, tool.menus.tile.<id>, tool.menus.default; the text is in helptext/).
*
*   THE PAGE WRITES NOTHING ITSELF.  Every change is a command the administrator already has, shown with its effect in a box that is answered Run or Cancel (Cancel is the
*   button Enter chooses), and then run by $tk_run: SET.TILE account tile on | off, MODIFY.ACCOUNT account START-MENU | START-TERMINAL | START-DEFAULT, SET.START.DEFAULT
*   menu | terminal.  The line under the page after a change is the command's own answer, and the page is read from the register again.  Turning the Terminal tile
*   OFF asks for the account's name to be typed: for an account that starts in the menu it removes the command prompt (the home screen signs the person out when it ends).
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $tool_menus
$catalog $tool_menus

$include keys.h
$include int$keys.h
$include err.h
$include sl.h
$include tk.h

   prompt ''

   allow = 'modify.account set.tile set.start.default'          ;* the commands this page may run

   call $tk_open('tool.menus', 'admin', ctx, err)
   if err # '' then
      display err
      stop
   end
   void kernel(K$AUDIT, 'tool start app=tool.menus')

   keys = ''
   call $tk_keys('add', keys, 'f1', 'help', 'help', '', 1)
   call $tk_keys('add', keys, 'enter', 'change', 'change', '', 1)
   call $tk_keys('add', keys, 'f6', 'box', 'pane', '', 1)                 ;* S.176: F6 / Shift-F6 move between the boxes on every page (Tab does not)
   call $tk_keys('add', keys, 'f5', 'refresh', 'refresh', '', 1)
   call $tk_keys('add', keys, 'ctrl-q', 'quit', 'quit', '', 1)
   call $tk_keys('add', keys, 'esc', 'menu', 'menu', '', 1)                ;* S.88 U4: Esc opens the menu bar (this page holds nothing of its own that Esc closes first)
   call $tk_keys('menu', keys, 'quit', '&File', '&Quit', '', '')
   call $tk_keys('menu', keys, 'change', '&Setting', '&Change the setting', '', '')
   call $tk_keys('menu', keys, 'pane', '&View', '&Next pane', '', '')
   call $tk_keys('menu', keys, 'refresh', '&View', '&Refresh', '', '')
   call $tk_keys('menu', keys, 'help', '&Help', '&Help on this setting', '', '')
   call $tk_std('keys', ctx, keys, '', '')                ;* S.179: Ctrl-T theme, Ctrl-K keys and their View and Help entries, as on every page
   * S.97 stage 3: the AI line.  The page offers the AI only the pane switch and refresh (changing where an account starts or which tiles it has is NOT offered without the
   * owner's word); a proposal is carried out by the page's own key.  Where the AI is not usable nothing here adds a key, a row or a line.
   call $tk_keys('ai', keys, 'pane', '', '', '', '')
   call $tk_keys('ai', keys, 'refresh', '', '', '', '')
   call $tk_aipage('init', ctx, keys, '', '', aout)

   tids = 'editor' : @fm : 'ide' : @fm : 'terminal' : @fm : 'keys' : @fm : 'switch' : @fm : 'signout' : @fm : 'files' : @fm : 'voc' : @fm : 'dict' : @fm : 'query' : @fm : 'bulk' : @fm : 'catalog' : @fm : 'test' : @fm : 'recent'
   tlabs = 'Editor' : @fm : 'IDE' : @fm : 'Terminal' : @fm : 'Keys' : @fm : 'Switch account' : @fm : 'Sign out' : @fm : 'Files' : @fm : 'Vocabulary' : @fm : 'Dictionary' : @fm : 'Queries' : @fm : 'Bulk update' : @fm : 'Programs' : @fm : 'Tests' : @fm : 'Recent group'
   pnames = 'Accounts' : @fm : 'Menu' : @fm : 'Default'
   nmenu = 2 + dcount(tids, @fm)                                 ;* the rows of the Menu box: where the account starts, its own programs, then a row for each standard tile

   gosub lay.declare                                             ;* the panes; VIS (the account rows shown at a time: 26 at 140 by 43) and WV (the explanation rows) come from them
   pane = 1
   ai = 1                                                        ;* the account selected, a row of ids
   si = 1                                                        ;* the row selected in the Menu pane: 1 is where the account starts, 2 its own programs, 3 to nmenu the standard tiles
   top = 0
   gen = 0
   msg = ''
   done = 0

   gosub read.all
   gosub draw.all

   loop
      call $tk_menubar('draw', ctx, keys, pnames<pane>, '', '', mr)         ;* the bar first: it writes row 0 whole, and the frame then writes the app name at its right end
      call $tk_frame(ctx, keys, pnames<pane>, msg)
      call $sl_curat(0, ctx<TK.C.YSTAT>)                          ;* the cursor waits at the start of the status line: in a window made smaller it is off the screen, and the library's cursor lock takes the keyboard
      nm = ''
      screen key returning nm
      mr = ''
      ao = ''
      if nm # '' then call $tk_aipage('key', ctx, keys, pnames<pane>, nm, ao)        ;* S.97 stage 3: while the AI line has the focus it takes the keys, before the bar sees them
      if ao<1> = 'replay' then nm = ao<2>                                            ;* an action the AI proposed and the person accepted: this page's own key for it
      if ao<1> # '' then msg = ao<4>
      if nm # '' and ao<1> = '' then call $tk_menubar('key', ctx, keys, pnames<pane>, nm, 0, mr)       ;* F10, Alt and a letter, and Esc (nothing of this page's is open): the bar
      if mr<1> # '' then nm = mr<4>
      begin case
         case ao<1> = 'taken'
            if ao<3> then
               gen += 1                                                               ;* the preview, the wait and the answer covered the page: all of it is drawn again
               ctx<TK.C.GEN> = gen
               gosub draw.all
            end
         case nm = ''
            if status() = ER$EOF then exit
         case nm = 'guardquit'
            exit
         case nm = 'resize'
            call $tk_layout('refresh', ctx, '', lay.chg)
            gosub lay.get
            gen += 1
            ctx<TK.C.GEN> = gen
            gosub draw.all
         case nm = 'mouse'
            gosub on.mouse
         case 1
            gosub on.key
      end case
      if done then exit
   repeat

   call $tk_close(ctx)
   stop

* ------------------------------------------------------------------------------------------------- what the register says

* Every registered account but SDSYS, in order; where each starts and the tiles that are off for it; the system default
read.all:
   ids = ''
   atype = ''
   astart = ''
   aoff = ''
   asusp = ''
   apins = ''
   openpath @sdsys : @ds : 'accounts' to acc.f then
      select acc.f to 11
      loop
         readnext aid from 11 else exit
         if downcase(aid) # 'sdsys' then
            locate aid in ids<1> by 'AL' setting p else
               ins aid before ids<p>
            end
         end
      repeat
      for i = 1 to dcount(ids, @fm)
         read arec from acc.f, ids<i> then
            gp = arec<ACC$GROUP>
            begin case
               case gp[1, 4] = 'sdu_'
                  atype<i> = 'USER'
               case gp[1, 4] = 'sdg_'
                  atype<i> = 'GROUP'
               case 1
                  atype<i> = 'OTHER'
            end case
            astart<i> = downcase(trim(arec<ACC$START>))
            aoff<i> = downcase(trim(convert(',' : char(9), '  ', arec<ACC$TILES.OFF>)))
            asusp<i> = (if upcase(trim(arec<ACC$SUSPENDED>)) = 'SUSPENDED' then 1 else 0)
            apins<i> = (if upcase(trim(arec<ACC$PINS>)) = 'YES' then 1 else 0)
         end
      next i
      close acc.f
   end
   defword = 'menu'
   openseq @sdsys : @ds : 'start.default' readonly to df then
      readseq line from df then
         if downcase(trim(line)) = 'terminal' then defword = 'terminal'
      end
      close df
   end else
*     26 Oct 26: an absent file takes ELSE with the name still locked for the life of the session; close the variable (see home_entry)
      if not(unassigned(df)) then close df
   end
   na = dcount(ids, @fm)
   if ai > na then ai = na
   if ai < 1 then ai = 1
   return

* Where account i starts, as it reads: its own word, or the default and a note
start.text:
   if astart<i> = 'menu' or astart<i> = 'terminal' then
      stext = astart<i>
   end else
      stext = 'default (' : defword : ')'
   end
   return

* ------------------------------------------------------------------------------------------------- the layout (S.88 L2)

* The page's five boxes as panes of $tk_layout, in two columns of one band: each size is the box drawn at 140 by 43 (the body is 138 by 39), so at that size nothing moves.  In a larger
* window the Accounts box and What this means stretch (a table shows more rows; the Menu box is 17 fixed rows) and the two columns share the width.  The first pane of the right column
* says the one column of gap between them.
lay.declare:
   d = ''
   d<1> = 'accounts' : @vm : 1 : @vm : 1 : @vm : 30 : @vm : 70 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<2> = 'default' : @vm : 1 : @vm : 1 : @vm : 5 : @vm : 70 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   d<3> = 'help' : @vm : 1 : @vm : 1 : @vm : 3 : @vm : 70 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   d<4> = 'menu' : @vm : 1 : @vm : 2 : @vm : 21 : @vm : 67 : @vm : 1 : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   d<5> = 'what' : @vm : 1 : @vm : 2 : @vm : 17 : @vm : 67 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   ctx<TK.C.FOCI> = 'accounts' : @sm : 'Accounts' : @vm : 'menu' : @sm : 'Menu' : @vm : 'default' : @sm : 'Default'        ;* S.99: the boxes that take the focus, for $tk_frame's [*] / [-]
   call $tk_layout('declare', ctx, d, lay.err)
   gosub lay.get
   return

* The rectangles of the five panes, and what is counted from them: aw and mw the width of a text line inside the Accounts and the Menu boxes (66 and 63 at 140 by 43), VIS the account rows,
* WV the rows of What this means, and the places of the [?] buttons (the right end of the first row of the Accounts and System default boxes; the Menu box has one on each row)
lay.get:
   lay.id = 'accounts'
   gosub lay.rect
   acl.x = lay.x ; acl.y = lay.y ; acl.w = lay.w ; acl.h = lay.h
   lay.id = 'menu'
   gosub lay.rect
   mnu.x = lay.x ; mnu.y = lay.y ; mnu.w = lay.w ; mnu.h = lay.h
   lay.id = 'what'
   gosub lay.rect
   wat.x = lay.x ; wat.y = lay.y ; wat.w = lay.w ; wat.h = lay.h
   lay.id = 'default'
   gosub lay.rect
   dfl.x = lay.x ; dfl.y = lay.y ; dfl.w = lay.w ; dfl.h = lay.h
   lay.id = 'help'
   gosub lay.rect
   hlp.x = lay.x ; hlp.y = lay.y ; hlp.w = lay.w ; hlp.h = lay.h
   body.y = ctx<TK.C.YBODY>
   aw = acl.w - 4
   mw = mnu.w - 4
   ww = wat.w - 4
   dw = dfl.w - 4
   hw = hlp.w - 4
   VIS = acl.h - 4
   WV = wat.h - 2
   mk.acx = acl.x + acl.w - 5
   mk.acy = acl.y + 1
   mk.mx = mnu.x + mnu.w - 5
   mk.dx = dfl.x + dfl.w - 5
   mk.dy = dfl.y + 1
   return

lay.rect:
   call $tk_layout('pane', ctx, lay.id, lay.r)
   lay.x = lay.r<1, 1>
   lay.y = lay.r<1, 2>
   lay.w = lay.r<1, 3>
   lay.h = lay.r<1, 4>
   return

* ------------------------------------------------------------------------------------------------- drawing

draw.all:
   cw = ctx<TK.C.W>
   chh = ctx<TK.C.H> - 5
   screen clear at 0,body.y size cw,chh
   screen box at acl.x,acl.y size acl.w,acl.h title 'Accounts'
   screen box at mnu.x,mnu.y size mnu.w,mnu.h title 'Menu'
   screen box at wat.x,wat.y size wat.w,wat.h title 'What this means'
   screen box at dfl.x,dfl.y size dfl.w,dfl.h title 'System default'
   screen box at hlp.x,hlp.y size hlp.w,hlp.h title 'Help'
   gosub draw.accounts
   gosub draw.menu
   gosub draw.effect
   gosub draw.default
   gosub draw.help
   return

draw.accounts:
   screen text fmt('Account', '14L') : fmt('Type', '10L') : fmt('Starts in', '19L') : fmt('Own', '5L') : 'Tiles off' at acl.x + 2,acl.y + 1 attr 'header' width aw
   if na = 0 then
      screen text 'No account is registered.' at acl.x + 2,acl.y + 3 width aw
   end
   if ai - 1 < top then top = ai - 1
   if ai > top + VIS then top = ai - VIS
   for r = 1 to VIS
      k = top + r
      s = ''
      if k <= na then
         i = k
         gosub start.text
         tf = aoff<k>
         tfw = aw - 48                                             ;* what is left of the line after the four columns (18 at 140 by 43)
         if len(tf) > tfw then tf = tf[1, tfw - 1] : '+'
         s = fmt(ids<k>[1, 13], '14L') : fmt(atype<k> : (if asusp<k> then ' (s)' else ''), '10L') : fmt(stext, '19L') : fmt((if apins<k> then 'yes' else 'no'), '5L') : tf
      end
      screen text s at acl.x + 2,acl.y + 1 + r attr (if k = ai and k <= na then (if pane = 1 then 'highlight' else 'bold') else 'normal') width aw      ;* row 1 is under the header, as the hit test at the click counts it
   next r
   call $tk_help('mark', mk.acx, mk.acy, 0, 0)                    ;* F1, ? or a click: what this box shows
   return

draw.menu:
   if na = 0 then
      for r = 1 to nmenu
         screen text '' at mnu.x + 2,mnu.y + r width mw
      next r
      return
   end
   i = ai
   gosub start.text
   for r = 1 to nmenu
      begin case
         case r = 1
            s = fmt('Starts in', '28L') : stext
         case r = 2
            s = fmt('May add own programs', '28L') : (if apins<ai> then 'yes (shown as My programs)' else 'no (as delivered)')
         case 1
            t = r - 2
            s = (if index(' ' : aoff<ai> : ' ', ' ' : tids<t> : ' ', 1) > 0 then '[ ]' else '[x]') : ' ' : fmt(tlabs<t>, '16L') : fmt(tids<t>, '10L') : (if tids<t> = 'signout' then 'cannot be turned off' else '')
      end case
      screen text s at mnu.x + 2,mnu.y + r attr (if r = si then (if pane = 2 then 'highlight' else 'bold') else 'normal') width mw - 4      ;* 4 less: the [?] is at the right end
      call $tk_help('mark', mk.mx, mnu.y + r, 0, 0)               ;* the [?] button of the setting on this row
   next r
   screen text 'Enter changes the row.  [x] is on as delivered, [ ] is off.' at mnu.x + 2,mnu.y + nmenu + 2 attr 'disabled' width mw
   return

* What the account's settings mean, in plain sentences
draw.effect:
   lines = ''
   if na > 0 then
      i = ai
      gosub start.text
      eff = (if astart<ai> = 'menu' or astart<ai> = 'terminal' then astart<ai> else defword)
      t.off = (index(' ' : aoff<ai> : ' ', ' terminal ', 1) > 0)
      lines<-1> = ids<ai> : ' starts in the ' : (if eff = 'menu' then 'home screen' else 'command prompt') : ' (' : (if astart<ai> = 'menu' or astart<ai> = 'terminal' then 'its own setting' else 'the system default') : ').'
      lines<-1> = (if aoff<ai> = '' then 'Every tile is on.' else 'Tiles off: ' : aoff<ai> : '.')
      lines<-1> = (if apins<ai> then 'It may add its own programs to its home screen (My programs).' else 'It may not add programs of its own to its home screen.')
      lines<-1> = ''
      begin case
         case t.off and eff = 'menu'
            lines<-1> = 'THE PROMPT IS REMOVED FOR THIS ACCOUNT: it starts in the home screen and the Terminal tile is off,'
            lines<-1> = 'so the screen signs the person out when it ends and never leaves them at the command prompt.'
            lines<-1> = "The programs behind the other tiles are the account's own: turn the Editor and IDE tiles off"
            lines<-1> = 'as well to keep the account to the tiles you give it.'
         case t.off
            lines<-1> = 'The Terminal tile is off, but this account starts at the command prompt, so it has the prompt.'
         case eff = 'menu'
            lines<-1> = 'The person gets the home screen, and its Terminal tile gives the command prompt.'
         case 1
            lines<-1> = 'The person gets the command prompt; HOME opens the home screen.'
      end case
      lines<-1> = ''
      lines<-1> = 'A change reaches the person at their next sign-on (or F5 in the home screen).'
   end
   gosub wrap.lines
   for r = 1 to WV
      screen text lines<r> at wat.x + 2,wat.y + r width ww
   next r
   return

* Break each line of 'lines' at a space so that none is wider than the box (a SCREEN TEXT longer than its width is cut, not wrapped)
wrap.lines:
   wrapped = ''
   for wi = 1 to dcount(lines, @fm)
      call $tk_wrap(lines<wi>, ww, pieces)
      wrapped<-1> = pieces
   next wi
   lines = wrapped
   return

draw.default:
   screen text 'An account with no setting of its own starts in the' at dfl.x + 2,dfl.y + 1 width dw
   screen text (if defword = 'menu' then 'home screen (menu)' else 'command prompt (terminal)') at dfl.x + 2,dfl.y + 2 attr (if pane = 3 then 'highlight' else 'bold') width dw
   screen text 'Enter changes it for every account that follows the default.' at dfl.x + 2,dfl.y + 3 attr 'disabled' width dw
   call $tk_help('mark', mk.dx, mk.dy, 0, 0)
   return

draw.help:
   screen text 'Arrows move, Tab changes pane, Enter changes (Run or Cancel).' at hlp.x + 2,hlp.y + 1 width hw
   return

* ------------------------------------------------------------------------------------------------- keys and the mouse

on.key:
   msg = ''
   begin case
      case nm = 'up'
         if pane = 1 and ai > 1 then
            ai -= 1
            gosub redraw.account
         end
         if pane = 2 and si > 1 then
            si -= 1
            gosub draw.menu
         end
      case nm = 'down'
         if pane = 1 and ai < na then
            ai += 1
            gosub redraw.account
         end
         if pane = 2 and si < nmenu then
            si += 1
            gosub draw.menu
         end
      case nm = 'pgup' and pane = 1
         ai = ai - VIS
         if ai < 1 then ai = 1
         gosub redraw.account
      case nm = 'pgdn' and pane = 1
         ai = ai + VIS
         if ai > na then ai = na
         if ai < 1 then ai = 1
         gosub redraw.account
      case nm = 'right'
         pane = pane + 1
         if pane > 3 then pane = 1
         gosub redraw.panes
      case nm = 'left'
         pane = pane - 1
         if pane < 1 then pane = 3
         gosub redraw.panes
      case nm = 'enter' or nm = ' '
         gosub change
      case nm = 'f1' or nm = '?'
         gosub help.here
      case nm = 'ctrl-t'                    ;* S.179: the theme, kept for the person - the same on every page ($tk_std)
         call $tk_std('theme', ctx, keys, '', std.r)
         if std.r<1> then gosub draw.all
         msg = std.r<2>
      case nm = 'act:std.mouse'             ;* S.186: View > Mouse, the same on every page ($tk_std)
         call $tk_std('mouse', ctx, keys, '', std.r)
         msg = std.r<2>
      case nm = 'ctrl-o'                    ;* S.186: the log of the commands this page ran (View > Output; $tk_std)
         call $tk_std('output', ctx, keys, '', std.r)
      case nm = 'ctrl-k'                    ;* S.179: the keys of this page, in a box
         call $tk_std('keylist', ctx, keys, pnames<pane>, std.r)
      case nm = 'f5'
         gosub read.all
         gosub draw.all
         msg = 'read the register again'
      case nm = 'f6' or nm = 'shift-f6' or nm = 'act:ai'
         call $tk_aipage('ring', ctx, keys, pane, nm : @fm : 3, ap)         ;* S.176: F6 / Shift-F6 go round the three boxes and the AI line; AI > Ask the AI goes to the line
         if ap<1> > 0 and ap<1> # pane then
            pane = ap<1>
            gosub redraw.panes
         end
         msg = ap<2>
      case nm = 'ctrl-q'
         done = 1
   end case
   return

* A new account is selected: the Menu and the explanation change with it
redraw.account:
   gosub draw.accounts
   gosub draw.menu
   gosub draw.effect
   return

redraw.panes:
   gosub draw.accounts
   gosub draw.menu
   gosub draw.default
   return

on.mouse:
   screen mouse returning mev else mev = ''
   if mev = '' then return
   mr = ''
   call $tk_menubar('click', ctx, keys, pnames<pane>, mev, '', mr)                ;* a click on the bar on row 0
   if mr<1> # '' then
      nm = mr<4>
      if nm # '' then gosub on.key                          ;* a bar left with nothing chosen has no name: the status message stays
      return
   end
   call $tk_aipage('mouse', ctx, keys, pnames<pane>, mev, ap)                       ;* S.97 stage 3: a click on the AI line gives it the focus
   if ap # '' then
      msg = ap
      return
   end
   gosub help.click
   if clicked then return
   if mev<1> = 'press' and mev<2> = 1 then
      mx = mev<3>
      my = mev<4>
      begin case
         case mx >= acl.x + 1 and mx <= acl.x + acl.w - 2 and my >= acl.y + 2 and my <= acl.y + 1 + VIS
            k = top + my - (acl.y + 1)
            if k <= na then
               ai = k
               pane = 1
               gosub redraw.account
               gosub redraw.panes
            end
         case mx >= mnu.x + 1 and mx <= mnu.x + mnu.w - 1 and my >= mnu.y + 1 and my <= mnu.y + nmenu
            si = my - mnu.y
            pane = 2
            gosub redraw.panes
         case mx >= dfl.x + 1 and mx <= dfl.x + dfl.w - 2 and my >= dfl.y + 1 and my <= dfl.y + 3
            pane = 3
            gosub redraw.panes
      end case
   end
   return

* ------------------------------------------------------------------------------------------------- help: the [?] buttons, F1 and ?

* The key of the help for what is selected: the Accounts list, the setting on the selected row of the Menu box, or the system default
help.key:
   hk = 'tool.menus.accounts'
   if pane = 2 then
      begin case
         case si = 1
            hk = 'tool.menus.starts-in'
         case si = 2
            hk = 'tool.menus.pins'
         case 1
            hk = 'tool.menus.tile.' : tids<si - 2>
      end case
   end
   if pane = 3 then hk = 'tool.menus.default'
   return

help.here:
   gosub help.key
   call $tk_help('box', hk, hm, 0, 0)
   if hm # '' then msg = hm
   return

* A left press on a [?]: that setting is selected and its help is shown
help.click:
   clicked = 0
   hit.row = 0
   if na > 0 then
      for hr = 1 to nmenu
         call $tk_help('hit', mev, mk.mx, mnu.y + hr, hit.now)
         if hit.now then hit.row = hr
      next hr
   end
   call $tk_help('hit', mev, mk.dx, mk.dy, hit.default)
   call $tk_help('hit', mev, mk.acx, mk.acy, hit.accounts)
   begin case
      case hit.row
         si = hit.row
         pane = 2
         clicked = 1
      case hit.default
         pane = 3
         clicked = 1
      case hit.accounts
         pane = 1
         clicked = 1
   end case
   if clicked then
      gosub redraw.panes
      gosub help.here
   end
   return

* ------------------------------------------------------------------------------------------------- changing something: the command, its effect, Run or Cancel, then the machine's answer

change:
   if na = 0 and pane # 3 then return
   begin case
      case pane = 1
         pane = 2
         gosub redraw.panes
      case pane = 2
         begin case
            case si = 1
               gosub change.start
            case si = 2
               gosub change.pins
            case 1
               gosub change.tile
         end case
      case pane = 3
         gosub change.default
   end case
   return

change.start:
   acct = ids<ai>
   items = 'menu (the home screen)' : @fm : 'terminal (the command prompt)' : @fm : 'the system default (' : defword : ')'
   ttl = 'Where ' : acct : ' starts'
   screen pick items title ttl returning pk else pk = 0
   if pk = 0 then return
   sent = 'modify.account ' : acct : ' ' : (if pk = 1 then 'start-menu' else (if pk = 2 then 'start-terminal' else 'start-default'))
   el = ''
   el<-1> = acct : ' will start ' : (if pk = 1 then 'in the home screen.' else (if pk = 2 then 'at the command prompt.' else 'wherever the system default says (' : defword : ').'))
   if pk = 1 then el<-1> = 'The Terminal tile on that screen gives the command prompt unless it is off for this account.'
   el<-1> = 'It takes effect at the next sign-on, and when the person types logto to enter the account.'
   typed = ''
   gosub confirm.run
   return

* Whether the person may add their own programs to their home screen (delivered off): PINS-ON or PINS-OFF
change.pins:
   acct = ids<ai>
   want = (if apins<ai> then 'off' else 'on')
   sent = 'modify.account ' : acct : ' pins-' : want
   el = ''
   if want = 'on' then
      el<-1> = acct : ' will be able to add its own programs to its home screen (a group My programs, edited with MY.MENU).'
      el<-1> = 'Each is a command the person could type at their prompt, so it adds no access: the gates apply as at the prompt.'
      el<-1> = "The standard tiles stay the administrator's; the person manages only their own list."
   end else
      el<-1> = acct : "'s own programs stay in their file but are no longer shown, and MY.MENU says it is not allowed."
   end
   el<-1> = 'It takes effect at the next sign-on (or F5 in the home screen).'
   typed = ''
   gosub confirm.run
   return

change.tile:
   acct = ids<ai>
   t = si - 2
   tid = tids<t>
   if tid = 'signout' then
      msg = 'Sign out cannot be turned off: a person must always be able to leave'
      return
   end
   is.off = (index(' ' : aoff<ai> : ' ', ' ' : tid : ' ', 1) > 0)
   want = (if is.off then 'on' else 'off')
   sent = 'set.tile ' : acct : ' ' : tid : ' ' : want
   el = ''
   begin case
      case tid = 'recent' and want = 'off'
         el<-1> = 'The Recent group will not be on ' : acct : "'s home screen, nothing will be read or written for it, and the person cannot turn it on."
      case tid = 'recent'
         el<-1> = 'The person may turn the Recent group on again in the View menu of ' : acct : "'s home screen (it is off until they do)."
      case want = 'off'
         el<-1> = 'The ' : tlabs<t> : ' tile will be left off ' : acct : "'s home screen, and its menu entry cannot be chosen."
      case 1
         el<-1> = 'The ' : tlabs<t> : ' tile will be on ' : acct : "'s home screen again."
   end case
   typed = ''
   if tid = 'terminal' and want = 'off' then
      el<-1> = 'WITH THIS TILE OFF an account that starts in the home screen is never given the command prompt:'
      el<-1> = 'when the screen ends, the person is signed out.  An account that starts at the prompt keeps it.'
      el<-1> = "The programs behind the other tiles are the account's own; turn the Editor and IDE tiles off too to keep it to the screen."
      typed = acct
   end
   el<-1> = 'It takes effect at the next sign-on (or F5 in the home screen).'
   gosub confirm.run
   return

change.default:
   items = 'menu (the home screen)' : @fm : 'terminal (the command prompt)'
   screen pick items title 'Where an account with no setting of its own starts' returning pk else pk = 0
   if pk = 0 then return
   word = (if pk = 1 then 'menu' else 'terminal')
   sent = 'set.start.default ' : word
   el = ''
   el<-1> = 'Every account with no start setting of its own will start in the ' : (if pk = 1 then 'home screen' else 'command prompt') : ' at its next sign-on.'
   el<-1> = 'An account with START-MENU or START-TERMINAL is not changed.'
   typed = ''
   gosub confirm.run
   return

* The command is shown with its effect and run only when Run is chosen; what the command printed is the line under the page, and the register is read again
confirm.run:
   call $tk_confirm(sent, el, typed, res, cmsg)
   if res = 'run' then
      call $tk_run(allow, sent, out, st, err)
      if err # '' then
         msg = err
      end else
         said = trim(change(out, @fm, ' '))
         msg = (if said # '' then said[1, 130] else 'ran, status ' : st)
      end
      gosub read.all
      gosub draw.all
   end else
      msg = cmsg
   end
   return

end

