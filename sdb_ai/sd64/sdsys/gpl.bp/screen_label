*
* START-DESCRIPTION:
*
*   SCREEN LABEL f, id, text {AT x,y} {ATTR style}
*
*   is compiled into
*
*   call !screen_label(f, id, text, x, y, attr, ret, status)
*
*     f        the form (SCREEN FORM)       id    the widget's name in the form: not null, not used before
*     text     one line                     x y   its place from the form's top left corner (0,0 is the
*                                                  border's corner), default 1,1
*     attr     a style: normal, reverse, underline
*     status   0 added; 1 not (f is not a form, or the id is null or already used): ELSE
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_label(f, id, text, ax, ay, attr, ret, status)
$catalog !screen_label

   ret = ''
   status = 1
   w = collection()
   w{'id'} = id
   w{'text'} = text
   x = 1
   y = 1
   if ax # '' then x = ax + 0
   if ay # '' then y = ay + 0
   w{'x'} = x
   w{'y'} = y
   w{'attr'} = attr
   call $sl_label('init', w, '', '', r)
   call $sl_wadd(f, w, ok)
   if ok then status = 0

   return
end

* END-CODE
