*
* START-DESCRIPTION:
*
*   SSELECTV file TO listvar {RIGHT.ALIGNED} {DESCENDING}
*
*   The record ids of the file (or the items of a dynamic array) are sorted and left in the select list variable, in the
*   order a SSELECT to a numbered list would give.  The same sort mode bits as _SSELCT: 1 right aligned, 2 descending.
*
* END-DESCRIPTION
*
* START-CODE

$internal
$no.symbols
$no.xref
$recursive
$flags allow.break

subroutine sselctv(file.var, list.var, sort.mode)

$include syscom.h
$include syscom err.h
$include syscom keys.h
$include int$keys.h

   dim sort.modes(1)
   dim keys(1)

   sort.modes(1) = sort.mode
   sortinit 1, sort.modes

   selectv file.var to unsorted
   loop
      readnext keys(1) from unsorted else exit
      sortadd keys
   repeat

   ordered = sortdata()
   sortclear

   selectv ordered to list.var       ;* a dynamic array of the ids becomes the select list variable

   return value 0
end

* END-CODE
