* 18 Oct 26 dm  The cursor is placed through $sl_curat (which tells the cursor lock where it is).
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $sl_list(op, w, scr, key, ret)      the widget contract; w is a collection (see $sl_label)
*
*   Elements:  id, ax ay (the top left cell of the list on the screen), w h (its width and the number of
*   rows it shows: there is no border, a dialogue or a form draws one), items (as values; a subvalue 1 of an
*   item is its label), multi (1: several items can be picked), cur (the current item, 1 to start with),
*   top (the first item shown), picked (multi: the numbers of the items picked, as values), value (the
*   current item's number; with multi the numbers picked)
*
*     init    w, h from what was given (at least 3 by 1); cur and top are brought into range
*     draw    the rows: the current item is in reverse video while the list has the focus and is marked
*             with > while it has not; with multi each row starts [x] or [ ].  With more items than rows
*             the right-hand column is a scroll bar.
*     focus   key = 1 gives it the focus (draws), key = 0 takes it away (draws)
*     key     up, down, home, end, pgup, pgdn move; a letter jumps to the next item that starts with it;
*             with multi the space bar picks or unpicks the current item.  ret<1> is 'handled'; 'done'
*             (Return; ret<2> is the number of the current item, or with multi the numbers picked, as
*             values); 'cancel' (Esc); or 'unhandled' with ret<2> the key's name (tab, btab, left, right,
*             a function key; and up on the first item, down on the last, so that a form can go on to
*             the widget before or after).
*     close   nothing to undo: the caller repaints what is under it
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_list(op, w, scr, key, ret)
$catalog $sl_list

$include sl.h

   ret = ''
   lw = w{'w'} + 0
   lh = w{'h'} + 0
   if lw < 3 then lw = 3
   if lh < 1 then lh = 1
   items = w{'items'}
   n = dcount(items, @vm)
   if items = '' then n = 0
   multi = w{'multi'} + 0
   picked = w{'picked'}
   cur = w{'cur'} + 0
   top = w{'top'} + 0

   begin case
      case op = 'init'
         w{'type'} = 'list'
         w{'focusable'} = 1
         w{'w'} = lw
         w{'h'} = lh
         if cur < 1 or cur > n then cur = 1
         top = 1
         gosub scroll
         gosub store

      case op = 'draw'
         gosub paint

      case op = 'focus'
         w{'focused'} = if key then 1 else 0
         gosub paint

      case op = 'key'
         w{'clk'} = ''
         gosub handle.key

      case op = 'mouse'
         gosub click
   end case

   return

* A click on a row makes it the current one (with multi it also picks or unpicks it); a second click on the row
* that the last click chose is Return.  The wheel moves the current row three at a time.
click:
   ret = 'handled'
   if key<1> = 'wheel' then
      if key<2> = 'up' then cur -= 3 else cur += 3
      if cur > n then cur = n
      if cur < 1 then cur = 1
   end else
      i = top + key<4> - w{'ay'}
      if i < 1 or i > n then return
      if i = w{'clk'} and not(multi) then
         ret = 'done' : @fm : i
         return
      end
      cur = i
      w{'clk'} = i
      if multi then gosub toggle
   end
   gosub scroll
   gosub store
   gosub paint
   return

handle.key:
   ret = 'handled'
   begin case
      case key = 'esc'
         ret = 'cancel'
      case key = 'enter'
         answer = cur
         if multi then answer = picked
         ret = 'done' : @fm : answer
      case key = 'down'
         if cur < n then cur += 1 else ret = 'unhandled' : @fm : key
      case key = 'up'
         if cur > 1 then cur -= 1 else ret = 'unhandled' : @fm : key
      case key = 'home'
         cur = 1
      case key = 'end'
         cur = n
      case key = 'pgdn'
         cur += lh - 1
         if cur > n then cur = n
      case key = 'pgup'
         cur -= lh - 1
         if cur < 1 then cur = 1
      case key = ' ' and multi
         gosub toggle
      case len(key) = 1 and key # ' '
         uk = upcase(key)
         found = 0
         for k = 1 to n
            i = cur + k
            if i > n then i -= n
            if upcase(items<1, i, 1>[1, 1]) = uk then found = i ; exit
         next k
         if found then cur = found
      case 1
         ret = 'unhandled' : @fm : key
   end case
   if cur < 1 then cur = 1
   gosub scroll
   gosub store
   gosub paint
   return

* Pick or unpick the current item
toggle:
   i = cur
   gosub find.picked
   if at then
      del picked<1, at>
   end else
      picked<1, -1> = cur
   end
   return

* at = the position of item i among the picked ones, 0 if it is not picked
find.picked:
   at = 0
   np = dcount(picked, @vm)
   for q = 1 to np
      if picked<1, q> = i then at = q ; exit
   next q
   return

* Keep the current item inside the rows shown
scroll:
   if cur < top then top = cur
   if cur > top + lh - 1 then top = cur - lh + 1
   if top < 1 then top = 1
   return

store:
   w{'cur'} = cur
   w{'top'} = top
   w{'picked'} = picked
   if multi then
      w{'value'} = picked
   end else
      w{'value'} = cur
   end
   return

paint:
   tw = lw
   bar = (n > lh)
   if bar then
      tw = lw - 1
      call $sl_scrollbar(lh, top, n, lh, sbc)           ;* ^ v | and # as long as the part showing
   end
   call $sl_attr('highlight', hl)
   call $sl_attr('window', nl)
   if w{'ccode'} # '' then nl = w{'ccode'}           ;* the rows (and the empty rows) in the colours the COLOR clause gave; the current row is still highlighted
   focused = w{'focused'} + 0
   for r = 0 to lh - 1
      i = top + r
      if i > n then
         line = space(tw)
         code = nl
      end else
         lab = items<1, i, 1>
         if multi then
            mark = '[ ] '
            gosub find.picked
            if at then mark = '[x] '
            line = mark : lab
         end else
            lead = ' '
            if i = cur and not(focused) then lead = '>'
            line = lead : lab
         end
         line = line : space(tw)
         line = line[1, tw]
         code = nl
         if i = cur and focused then code = hl
      end
      if bar then
         line := sbc[r + 1, 1]
         code = str(code, tw) : nl
      end
      call $sl_put(scr, w{'ax'} + 0, w{'ay'} + r, line, code)
   next r
   if focused then call $sl_curat(w{'ax'} + 0, w{'ay'} + cur - top)
   return
end

* END-CODE
