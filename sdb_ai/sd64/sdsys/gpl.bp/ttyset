* START-DESCRIPTION:
*
* CALL !TTYSET(settings)
*
* Puts back the terminal modes that TTYGET() returned: the array's fields are those described in the TTYGET program.  A field
* that is null is left as it is, so an array from an older release that holds fewer fields sets fewer modes.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine ttyset(settings)
$catalog !ttyset

$include int$keys.h

   v = settings<1> ; if v # '' then i = pterm(PT$BREAK, (v # 0))
   v = settings<2> ; if v # '' then i = pterm(PT$INVERT, (v # 0))
   v = settings<3> ; if v # '' and v # 0 then i = pterm(PT$BRKCH, v)
   v = settings<4> ; if v # '' then i = pterm(PT$ONEWLINE, v)
   v = settings<5> ; if v # '' then i = pterm(PT$INEWLINE, char(v))
   v = settings<6> ; if v # '' then i = pterm(PT$MARK, (v # 0))
   v = settings<7> ; if v # '' then i = pterm(PT$ERASE, v)
   v = settings<8> ; if v # '' then i = pterm(PT$CTRL.FILTER, (v # 0))
   v = settings<9> ; if v # '' then i = pterm(PT$BINARY.IN, (v # 0))
   v = settings<10> ; if v # '' then i = pterm(PT$BINARY.OUT, (v # 0))
   v = settings<11> ; if v # '' then i = pterm(PT$TELNET, (v # 0))
   return
end

* END-CODE
