draw.all:
   screen clear at 0,ctx<TK.C.YBODY> size ctx<TK.C.W>,ctx<TK.C.BODYH>
   screen box at a.x,a.y size a.w,a.h title 'Accounts'
   kw1 = (if kind = 1 then 'VOC' else (if kind = 2 then 'Dictionary items' else 'Programs'))
   if fnd # '' then
      ttl = kw1 : ' with "' : fnd : '" in every account'
   end else
      ttl = kw1 : (if an > 0 then ' of ' : anm<ac> else '') : (if filt # '' then ', matching "' : filt : '"' else '')
   end
   screen box at c.x,c.y size c.w,c.h title ttl
   screen box at m.x,m.y size m.w,m.h title 'What this means'
   screen box at h.x,h.y size h.w,h.h title 'Help'
   gosub draw.accounts
   gosub draw.entries
   gosub draw.effect
   gosub draw.help
   return

* The SDSYS column for the account group sg.grp, and the test E, N, D, C and B ask (2 Nov 26).  Out: sdw.  'n/a' when the account has no group in the register; 'no' when /etc/group
* does not list the sdsys user in it; 'yes' when it does AND this session holds the group; 'relog' when it does but this session does not.  A process keeps the groups it started with,
* so a session of SDSYS that began before the sdsys user joined the group cannot write inside the account (error 3018) until SDSYS signs on again.  The session's own groups are
* the kernel's answer (K$IN.GROUP: the process's effective and supplementary groups, compared with the group's number), not a reading of /etc/group.
* 10 Nov 26 Windows port (RELEASE_1.1 201): there is no sdsys user and no POSIX group to join (Linux S.103 is not carried).  An SDSYS session is an elevated
*   administrator, and every account directory gives Administrators full control (secure-account-dirs.ps1), so the answer is always 'yes' and 'relog' never
*   happens: the column and the refusals that ask for it stay, so the page reads as on Linux.
sdsys.state:
   sdw = 'yes'
   return

draw.accounts:
   tw = a.w - 8
   ex = a.w - 50
   screen text fmt('Account', (20 + ex) : 'L') : fmt('Gates', '7L') : fmt('SDSYS', '6L') : 'State' at a.x + 2,a.y + 1 attr 'header' width tw      ;* 20 + 7 + 6 + 'suspended' (9) = the 42 columns of the box at 140 by 43
   for r = 1 to VIS
      k = atop + r - 1
      s = ''
      if k <= an then s = fmt(anm<k>[1, 18 + ex], (20 + ex) : 'L') : fmt(agate<k>, '7L') : fmt(asds<k>, '6L') : asus<k>
      screen text s at a.x + 2,a.y + 1 + r attr (if k = ac and k <= an then (if pane = 1 then 'highlight' else 'bold') else 'normal') width tw
   next r
   if an = 0 then screen text 'No account is registered but SDSYS.' at a.x + 2,a.y + 3 width tw
   call $tk_help('mark', a.x + a.w - 5, a.y + 1, 0, 0)
   return

draw.entries:
   tw = c.w - 8
   ex = c.w - 87
   if fnd # '' then
      if kind = 1 then
         s = fmt('Account', '16L') : fmt('Id', (24 + ex) : 'L') : fmt('>', '2L') : fmt('Type', '6L') : 'Points at'
      end else
         s = fmt('Account', '14L') : fmt('File', '12L') : fmt('>', '2L') : fmt('Id', (18 + ex) : 'L') : fmt((if kind = 2 then 'Type' else 'Built'), '5L') : (if kind = 2 then 'Heading' else 'Source file')
      end
      screen text s at c.x + 2,c.y + 1 attr 'header' width tw
      for r = 1 to VIS
         k = etop + r - 1
         s = ''
         if k <= hn then
            if kind = 1 then
               s = fmt(hacc<k>[1, 14], '16L') : fmt(hid<k>[1, 22 + ex], (24 + ex) : 'L') : fmt((if hout<k> then '>' else ''), '2L') : fmt(hty<k>, '6L') : hsm<k>
            end else
               s = fmt(hacc<k>[1, 12], '14L') : fmt(hfile<k>[1, 10], '12L') : fmt((if hout<k> then '>' else ''), '2L') : fmt(hid<k>[1, 16 + ex], (18 + ex) : 'L') : fmt(hty<k>, '5L') : hsm<k>
            end
         end
         screen text s at c.x + 2,c.y + 1 + r attr (if k = ec and k <= hn then (if pane = 2 then 'highlight' else 'bold') else 'normal') width tw
      next r
      if hn = 0 then
         begin case
            case kind = 1
               s = 'No VOC has an id with "' : fnd : '" in it (' : hseen : ' VOCs read).'
            case kind = 2
               s = 'No dictionary item has "' : fnd : '" in its id or its heading (' : hseen : ' accounts read).'
            case 1
               s = 'No program has "' : fnd : '" in its id (' : hseen : ' accounts read).'
         end case
         screen text s at c.x + 2,c.y + 3 width tw
      end
      s = hn : (if hn = 1 then ' hit' else ' hits') : ' in ' : hseen
      if kind = 1 then
         s := (if hseen = 1 then ' VOC' else ' VOCs') : ' read'
      end else
         s := (if hseen = 1 then ' account' else ' accounts') : ' read'
      end
      if htrunc then s := '; only the first ' : MAXV : ' are listed'
      s := '.'
      screen text s at c.x + 2,c.y + c.h - 2 attr 'bold' width tw
   end else
      if kind = 1 then
         s = fmt('Id', (30 + ex) : 'L') : fmt('>', '2L') : fmt('Type', '6L') : 'Points at'
      end else
         s = fmt('File', '13L') : fmt('>', '2L') : fmt('Id', (22 + ex) : 'L') : fmt((if kind = 2 then 'Type' else 'Built'), '5L') : (if kind = 2 then 'Heading' else 'Source file')
      end
      screen text s at c.x + 2,c.y + 1 attr 'header' width tw
      for r = 1 to VIS
         k = etop + r - 1
         s = ''
         if k <= en then
            if kind = 1 then
               s = fmt(enm<k>[1, 28 + ex], (30 + ex) : 'L') : fmt((if eout<k> then '>' else ''), '2L') : fmt(ety<k>, '6L') : esm<k>
            end else
               s = fmt(efile<k>[1, 11], '13L') : fmt((if eout<k> then '>' else ''), '2L') : fmt(enm<k>[1, 20 + ex], (22 + ex) : 'L') : fmt(ety<k>, '5L') : esm<k>      ;* a dictionary item: its type and heading; a program: built or not, and the directory of its file
            end
         end
         screen text s at c.x + 2,c.y + 1 + r attr (if k = ec and k <= en then (if pane = 2 then 'highlight' else 'bold') else 'normal') width tw
      next r
      s = ''
      begin case
         case an = 0
            null
         case vfail
            s = "This account's VOC cannot be opened from here."
            s2 = 'Its path in the register: ' : apath<ac>                    ;* on lines of its own, WRAPPED at the box's width (2 Nov 26): cut at the edge, the account's name was in the part that was lost
            pr = 0
            loop
               screen text s2[1, tw] at c.x + 2,c.y + 4 + pr width tw
               s2 = s2[tw + 1, len(s2)]
               pr += 1
            while s2 # '' and pr < 6 repeat
         case en = 0 and filt # '' and kind = 1
            s = 'No entry has "' : filt : '" in its id.'
         case en = 0 and filt # '' and kind = 2
            s = 'No dictionary item has "' : filt : '" in its id or its heading.'
         case en = 0 and filt # ''
            s = 'No program has "' : filt : '" in its id.'
         case en = 0 and kind = 1
            s = 'The VOC of this account is empty.'
         case en = 0 and kind = 2
            s = 'No file of this account has a dictionary with an item in it.'
         case en = 0
            s = 'This account has no program file (a directory file named bp, or ending .bp, or with a .out file beside it) with a program in it.'
      end case
      if s # '' then screen text s at c.x + 2,c.y + 3 width tw
      if an > 0 and not(vfail) then
         begin case
            case kind = 1
               s = en : ' of ' : eall : (if eall = 1 then ' entry' else ' entries')
            case kind = 2
               s = en : ' of ' : eall : (if eall = 1 then ' item' else ' items')
            case 1
               s = en : ' of ' : eall : (if eall = 1 then ' program' else ' programs')
         end case
         if filt # '' then s := ' hold "' : filt : '"'
         if etrunc then s := '; only the first ' : MAXV : ' are listed'
         if dfail > 0 then s := '; ' : dfail : (if kind = 2 then (if dfail = 1 then ' dictionary' else ' dictionaries') else (if dfail = 1 then ' program file' else ' program files')) : ' could not be opened'
         s := '.'
         screen text s at c.x + 2,c.y + c.h - 2 attr 'bold' width tw
      end
   end
   call $tk_help('mark', c.x + c.w - 5, c.y + 1, 0, 0)
   return

* In plain sentences, for what is selected; then the entry under the cursor field by field
draw.effect:
   lines = ''
   if an = 0 then
      lines<-1> = 'There is no registered account but SDSYS, so there is nothing to list.'
   end else
      lines<-1> = anm<ac> : ': the gates ' : agate<ac> : ' are the right to save a change to its VOC (v, voc-edit), its dictionaries (d, dict-edit) and its programs (b, bp-edit); a dash means the account is locked out of that.  An administrator is not held to them.'
      begin case
         case asds<ac> = 'yes'
            lines<-1> = "SDSYS is an elevated administrator, and the account's directories give Administrators full control, so SDSYS can write inside them from outside SD."
         case asds<ac> = 'relog'
            lines<-1> = "The sdsys user is in the account's group, but this session of SDSYS began before it joined and does not hold the group: it cannot write inside the account.  Sign on again as SDSYS; until then E, N, D, C and B refuse it."
         case asds<ac> = 'no'
            lines<-1> = "The sdsys user is NOT in the account's group: SDSYS cannot write inside it from outside SD (modify.account " : anm<ac> : ' sdsys-on puts it in).'
         case 1
            lines<-1> = 'The account has no group in the register.'
      end case
      if asus<ac> # '' then lines<-1> = 'The account is suspended.'
      begin case
         case kind = 1
            lines<-1> = 'The entries are read from the account' : "'s own VOC file when the cursor comes to the account; nothing is copied.  E edits the entry under the cursor in the editor, N makes a new one and D deletes it: only the VOC's own records, never the file a pointer leads to."
            lines<-1> = ">: the entry is a pointer whose target lies outside this account (in SDSYS, as @SDSYS/voc.dic does, or in another account).  The pointer is this account's own record, edited like any VOC entry; what it points at belongs to the account it lies in and is never edited from this page."
         case kind = 2
            lines<-1> = 'The dictionary items are read, when the cursor comes to the account, from the dictionary of each file its VOC points at (field 3 of the file pointer); nothing is copied.  An item matches a text in its id or in its column heading.  E edits the item under the cursor as the form, N makes a new one in the dictionary of the file under the cursor and D deletes it: only dictionary items.'
            lines<-1> = ">: the item lives in a dictionary outside this account (SDSYS's, which every account's pointer to it shares, or another account's) and is only read through this account's pointer.  It is edited in the account it lives in, never from here: E and N refuse it."
         case 1
            lines<-1> = "The programs are the records of the account's program files (a directory file named bp, or ending .bp, or with a file of the same name and .out beside it), read when the cursor comes to the account; nothing is copied.  Built: yes when the compiled program is in the .out file under the same name, - when it is not (the .out file is the one the VOC names, else the one beside the program file).  E edits the program under the cursor in the editor and N makes a new one in the same program file, in the account it belongs to; C compiles it IN THAT ACCOUNT (run.in) and B debugs it there, and the editor's own Compile, Catalog and Debug do the same.  D deletes it with its compiled program (a catalog entry is left: DELETE.CATALOG in the account removes it)."
            lines<-1> = ">: the program file lies outside this account (SDSYS's or another account's) and is only read through this account's pointer.  Its programs are edited, compiled and run in the account it lives in, never from here."
      end case
   end
   lines<-1> = ''
   gosub entry.lines
   gosub wrap.lines
   for r = 1 to m.h - 3
      screen text lines<r> at m.x + 2,m.y + 1 + r width m.tw
   next r
   return

* The entry under the cursor field by field (up to nine fields), read from its account's VOC; the type in words first
entry.lines:
   eacct = '' ; eid = '' ; efl = ''
   if fnd # '' and hn > 0 and ec >= 1 and ec <= hn then
      eacct = hacc<ec> ; eid = hid<ec> ; ety1 = hty<ec> ; efl = hfile<ec>
   end
   if fnd = '' and en > 0 and ec >= 1 and ec <= en then
      eacct = anm<ac> ; eid = enm<ec> ; ety1 = ety<ec> ; efl = efile<ec>
   end
   if eid = '' then return
   if kind = 2 then
      gosub dict.item.lines
      return
   end
   if kind = 3 then
      gosub prog.item.lines
      return
   end
   gosub type.word
   lines<-1> = eid : ' in ' : eacct : '  -  ' : tword
   locate eacct in anm<1> setting ap1 then
      openpath apath<ap1>:@ds:'voc' to vf2 then
         read dr from vf2, eid then
            nfld = dcount(dr, @fm)
            if nfld > 9 then nfld = 9
            for q = 1 to nfld
               lines<-1> = fmt(q, '3R') : '  ' : convert(@vm, ' | ', convert(@sm, ' / ', dr<q>))
            next q
            if dcount(dr, @fm) > 9 then lines<-1> = '     (and ' : dcount(dr, @fm) - 9 : ' more fields)'
         end
         close vf2
      end
   end
   return

* The program under the cursor: eid in the program file efl of the account eacct, the first lines of its source (up to nine), found by the file's pointer in that account's VOC; whether
* it is built is ety1 ('yes' or '-')
prog.item.lines:
   lines<-1> = eid : ' in ' : efl : ' of ' : eacct : '  -  ' : (if ety1 = 'yes' then 'built (its compiled program is in the .out file)' else 'not built (no compiled program of that name in the .out file)')
   locate eacct in anm<1> setting ap1 then
      openpath apath<ap1>:@ds:'voc' to vf2 then
         read fr from vf2, efl then
            pp2 = parse.pathname.tokens(trim(fr<2>))
            if not(pp2 matches abs.pat) then pp2 = apath<ap1> : @ds : pp2
            openpath pp2 to pf2 then
               read psrc from pf2, eid then
                  nfld = dcount(psrc, @fm)
                  if nfld > 9 then nfld = 9
                  for q = 1 to nfld
                     lines<-1> = fmt(q, '3R') : '  ' : psrc<q>
                  next q
                  if dcount(psrc, @fm) > 9 then lines<-1> = '     (and ' : dcount(psrc, @fm) - 9 : ' more lines)'
               end
               close pf2
            end
         end
         close vf2
      end
   end
   return

* The dictionary item under the cursor: eid in the dictionary of the file efl of the account eacct, field by field (up to nine), found by the file's pointer in that account's VOC
dict.item.lines:
   begin case
      case ety1 = 'D'
         tword = 'a D-type item (a field of the record)'
      case ety1 = 'I'
         tword = 'an I-type item (calculated)'
      case ety1 = 'PH'
         tword = 'a phrase'
      case 1
         tword = 'an item of type ' : ety1
   end case
   lines<-1> = eid : ' in the dictionary of ' : efl : ' of ' : eacct : '  -  ' : tword
   locate eacct in anm<1> setting ap1 then
      openpath apath<ap1>:@ds:'voc' to vf2 then
         read fr from vf2, efl then
            dp = trim(fr<3>)
            if dp # '' then
               dp = parse.pathname.tokens(dp)
               if not(dp matches abs.pat) then dp = apath<ap1> : @ds : dp
               openpath dp to df2 then
                  read dr from df2, eid then
                     nfld = dcount(dr, @fm)
                     if nfld > 9 then nfld = 9
                     for q = 1 to nfld
                        lines<-1> = fmt(q, '3R') : '  ' : convert(@vm, ' | ', convert(@sm, ' / ', dr<q>))
                     next q
                     if dcount(dr, @fm) > 9 then lines<-1> = '     (and ' : dcount(dr, @fm) - 9 : ' more fields)'
                  end
                  close df2
               end
            end
         end
         close vf2
      end
   end
   return

* In: ety1.  Out: tword, the type in words
type.word:
   begin case
      case ety1 = 'V'
         tword = 'a verb'
      case ety1 = 'K'
         tword = 'a keyword of the query processor'
      case ety1 = 'F'
         tword = 'a file'
      case ety1 = 'Q'
         tword = 'a pointer to a file in another account'
      case ety1 = 'R'
         tword = 'a pointer to a record in another file'
      case ety1 = 'PA' or ety1 = 'PH'
         tword = 'a paragraph'
      case ety1 = 'PQ'
         tword = 'a PROC (not supported here)'
      case ety1 = 'S'
         tword = 'a stored sentence'
      case ety1 = 'X'
         tword = 'text, not a command'
      case ety1 = 'D'
         tword = 'a data descriptor'
      case ety1 = 'M'
         tword = 'a menu'
      case 1
         tword = 'an entry of type ' : ety1
   end case
   return

wrap.lines:
   wrapped = ''
   for wi = 1 to dcount(lines, @fm)
      if lines<wi> = '' then
         wrapped<-1> = ''
      end else
         call $tk_wrap(lines<wi>, m.tw, pieces)
         wrapped<-1> = pieces
      end
   next wi
   lines = wrapped
   return

draw.help:
   screen text 'Up and Down move, PgUp and PgDn a page.  Tab changes box.  Enter in Accounts goes to its entries.  F1 or ? explains the box.' at h.x + 2,h.y + 1 width h.tw
   screen text '/ filters by a part of an id (of a heading too, in dictionaries).  F finds it in every account (Enter on a hit goes to it).  Esc takes them off.' at h.x + 2,h.y + 2 width h.tw
   screen text 'K kind.  E edit, N new, D delete, C compile, B debug the row; G changes every row shown, U puts it back.  F5 again.  Ctrl-Q leaves.' at h.x + 2,h.y + 3 width h.tw
   return

* ------------------------------------------------------------------------------------------------- keys and mouse

on.key:
   msg = ''
   if len(nm) = 1 then nm = downcase(nm)
   nrows = (if fnd # '' then hn else en)
   begin case
      case nm = 'up'
         if pane = 1 and ac > 1 then
            ac -= 1
            gosub new.account
         end
         if pane = 2 and ec > 1 then
            ec -= 1
            gosub redraw
         end
      case nm = 'down'
         if pane = 1 and ac < an then
            ac += 1
            gosub new.account
         end
         if pane = 2 and ec < nrows then
            ec += 1
            gosub redraw
         end
      case nm = 'pgup' or nm = 'pgdn'
         stp = (if nm = 'pgup' then 0 - VIS else VIS)
         if pane = 1 and an > 0 then
            ac = ac + stp
            if ac < 1 then ac = 1
            if ac > an then ac = an
            gosub new.account
         end
         if pane = 2 and nrows > 0 then
            ec = ec + stp
            if ec < 1 then ec = 1
            if ec > nrows then ec = nrows
            gosub redraw
         end
      case nm = 'home' or nm = 'end'
         if pane = 1 and an > 0 then
            ac = (if nm = 'home' then 1 else an)
            gosub new.account
         end
         if pane = 2 and nrows > 0 then
            ec = (if nm = 'home' then 1 else nrows)
            gosub redraw
         end
      case nm = 'right' or nm = 'left'
         pane = (if pane = 1 then 2 else 1)
         gosub redraw
      case nm = 'enter' or nm = ' '
         if pane = 1 then
            pane = 2
            gosub redraw
         end else
            gosub open.entry
         end
      case nm = '/'
         gosub do.filter
      case nm = 'f'
         gosub do.find
      case nm = 'k'
         gosub do.kind
      case nm = 'e'
         gosub do.edit
      case nm = 'n'
         gosub do.new
      case nm = 'd'
         gosub do.delete
      case nm = 'c'
         gosub do.build
      case nm = 'b'
         gosub do.debug
      case nm = 'g'
         gosub do.global
      case nm = 'u'
         gosub do.undo
      case nm = 'f1' or nm = '?'
         gosub help.here
      case nm = 'ctrl-t'                    ;* S.179: the theme, kept for the person - the same on every page ($tk_std)
         call $tk_std('theme', ctx, keys, '', std.r)
         if std.r<1> then gosub draw.all
         msg = std.r<2>
      case nm = 'act:std.mouse'             ;* S.186: View > Mouse, the same on every page ($tk_std)
         call $tk_std('mouse', ctx, keys, '', std.r)
         msg = std.r<2>
      case nm = 'ctrl-o'                    ;* S.186: the log of the commands this page ran (View > Output; $tk_std)
         call $tk_std('output', ctx, keys, '', std.r)
      case nm = 'ctrl-k'                    ;* S.179: the keys of this page, in a box
         call $tk_std('keylist', ctx, keys, pnames<pane>, std.r)
      case nm = 'f5'
         gosub read.all
         gosub draw.all
         msg = 'read again'
      case nm = 'f6' or nm = 'shift-f6' or nm = 'act:ai'
         call $tk_aipage('ring', ctx, keys, pane, nm : @fm : 2, ap)         ;* S.176: F6 / Shift-F6 go round the two boxes and the AI line; AI > Ask the AI goes to the line
         if ap<1> > 0 and ap<1> # pane then
            pane = ap<1>
            gosub redraw
         end
         msg = ap<2>
      case nm = 'ctrl-q'
         done = 1
      case nm = 'esc'
         if fnd # '' or filt # '' then
            fnd = '' ; filt = ''
            ec = 1 ; etop = 1
            gosub read.entries
            gosub draw.all
            msg = 'every entry of the account'
         end
   end case
   return

* Another account selected: its VOC is read and the box is drawn again under its new title
new.account:
   if fnd = '' then
      ec = 1
      etop = 1
      gosub read.entries
      gosub draw.all
   end else
      gosub redraw
   end
   return

redraw:
   gosub keep.tops
   gosub draw.accounts
   gosub draw.entries
   gosub draw.effect
   return

* Enter in Entries: on a hit of a find it goes to that entry in its account; otherwise it says which key edits
open.entry:
   if fnd # '' and hn > 0 and ec >= 1 and ec <= hn then
      want.acct = hacc<ec>
      want.id = hid<ec>
      want.key = (if kind = 1 then hid<ec> else hfile<ec> : '*' : hid<ec>)
      fnd = ''
      locate want.acct in anm<1> setting ap2 then ac = ap2
      filt = ''
      ec = 1 ; etop = 1
      gosub read.entries
      locate want.key in ekey<1> setting ep2 then ec = ep2
      gosub keep.tops
      gosub draw.all
      msg = want.id : ' in ' : want.acct
   end else
      msg = 'E edits the record under the cursor in the editor, N makes a new one, D deletes it'
   end
   return

* ------------------------------------------------------------------------------------------------- E and N (S.96 M2)

* A word the page may put in a Q-pointer's name and in the sentence it gives the IDE: letters a-z, digits, dot, dash and underscore, 1 to 63 of them (what $tk_run lets through).  In: cw.  Out: okname
check.word:
   okname = (len(cw) > 0 and len(cw) <= 63)
   good = 'abcdefghijklmnopqrstuvwxyz0123456789._-'
   for cwq = 1 to len(cw)
      if index(good, cw[cwq, 1], 1) = 0 then okname = @false
   next cwq
   return

* E: the record under the cursor, in the editor.  The cursor must be in Entries on a row; a hit of a find is edited in the account it was found in.
do.edit:
   if pane # 2 then
      msg = 'Tab to the entries first, then E'
      return
   end
   nrows = (if fnd # '' then hn else en)
   if ec < 1 or ec > nrows then
      msg = 'there is no entry here to edit: N makes a new one'
      return
   end
   if fnd # '' then
      ea = hacc<ec> ; eid = hid<ec> ; efl = hfile<ec>
   end else
      ea = anm<ac> ; eid = enm<ec> ; efl = efile<ec>
   end
   enw = 0
   emode = 'edit'
   gosub edit.record
   return

* D: the record under the cursor is deleted, in its own account (a hit of a find in the account it was found in).  It goes E's way through edit.record, so the pointer rule and every
* check of E come first; delete.reached then asks for the id to be typed and deletes.
do.delete:
   if pane # 2 then
      msg = 'Tab to the entries first, then D'
      return
   end
   nrows = (if fnd # '' then hn else en)
   if ec < 1 or ec > nrows then
      msg = 'there is no entry here to delete'
      return
   end
   if fnd # '' then
      ea = hacc<ec> ; eid = hid<ec> ; efl = hfile<ec>
   end else
      ea = anm<ac> ; eid = enm<ec> ; efl = efile<ec>
   end
   enw = 0
   emode = 'delete'
   gosub edit.record
   return

* C: the program under the cursor is compiled IN ITS OWN ACCOUNT by run.in (the owner's mechanism C of 2 Nov 26: its VOC, its bp.out, its catalogue, and NO.CATALOG, so a $catalog in the
* source does not act as the administrator).  It goes E's way through edit.record first, so the pointer rule refuses a program file that lies outside the account before anything runs.
do.build:
   if pane # 2 then
      msg = 'Tab to the entries first, then C'
      return
   end
   if kind # 3 then
      msg = 'C compiles a program: K shows the programs'
      return
   end
   nrows = (if fnd # '' then hn else en)
   if ec < 1 or ec > nrows then
      msg = 'there is no program here to compile'
      return
   end
   if fnd # '' then
      ea = hacc<ec> ; eid = hid<ec> ; efl = hfile<ec>
   end else
      ea = anm<ac> ; eid = enm<ec> ; efl = efile<ec>
   end
   enw = 0
   emode = 'compile'
   gosub edit.record
   return

* B (M5): the program under the cursor in the debugger, IN ITS OWN ACCOUNT (run.in compiles it for the debugger and runs the debugger there).  E's way through edit.record first.
do.debug:
* 13 Nov 26 Windows port (RELEASE_1.1 253(b)): run.in debugs again, as on Linux - the program runs in a separate, unelevated process of the account
*   (the SD service's), so B is Linux's B.  (10 Nov 26 to 13 Nov 26 it said "B is not built on Windows" and returned here.)
   if pane # 2 then
      msg = 'Tab to the entries first, then B'
      return
   end
   if kind # 3 then
      msg = 'B debugs a program: K shows the programs'
      return
   end
   nrows = (if fnd # '' then hn else en)
   if ec < 1 or ec > nrows then
      msg = 'there is no program here to debug'
      return
   end
   if fnd # '' then
      ea = hacc<ec> ; eid = hid<ec> ; efl = hfile<ec>
   end else
      ea = anm<ac> ; eid = enm<ec> ; efl = efile<ec>
   end
   enw = 0
   emode = 'debug'
   gosub edit.record
   return

* N: a new record in the account under the cursor (a new item: in the dictionary of the file the row under the cursor belongs to).  Its id is asked first.  Not while a find is on: a hit
* belongs to an account the Accounts box does not show.
do.new:
   if an < 1 then return
   if fnd # '' then
      msg = 'Esc takes the find off first: a new record is made in the account selected in Accounts'
      return
   end
   efl = ''
   ptxt = 'Id of the new VOC entry in ' : anm<ac>
   if kind = 2 then
      if ec < 1 or ec > en or pane # 2 then
         msg = 'put the cursor on an item of the file the new item belongs to (Tab to the entries)'
         return
      end
      efl = efile<ec>
      ptxt = 'Id of the new item in the dictionary of ' : efl : ' (' : anm<ac> : ')'
   end
   if kind = 3 then
      if ec < 1 or ec > en or pane # 2 then
         msg = 'put the cursor on a program of the file the new program belongs to (Tab to the entries)'
         return
      end
      efl = efile<ec>
      ptxt = 'Id of the new program in ' : efl : ' (' : anm<ac> : ')'
   end
   screen ask ptxt width 40 value '' title 'New' returning nt then got = 1 else got = 0
   if not(got) then return
   eid = downcase(trim(nt))
   if eid = '' then return
   ea = anm<ac>
   enw = 1
   emode = 'edit'
   gosub edit.record
   return

* The record eid of the account ea (the VOC when efl is '', else the dictionary of its file efl) in the IDE, enw = 1 when it is to be made.  THE POINTER RULE (owner, 3 Nov 26): nothing is
* written, and no pointer is made, until the file that would be edited is known to lie inside the account.  The register and the account's own VOC are read AGAIN here (the list may be
* old; an account may have repointed a file since), the path is judged by the kernel's geometry (K$PATH.IN: realpath, so .. and links cannot make a path look inside), and what the
* pointer opens is judged once more before the IDE is given it.
edit.record:
   openpath @sdsys:@ds:'accounts' to acc.f else
      msg = 'the register cannot be opened'
      return
   end
   read arec from acc.f, ea else arec = ''
   close acc.f
   if arec = '' then
      msg = ea : ' is not in the register any more: F5 reads the list again'
      return
   end
   ap.f = parse.pathname.tokens(arec<1>)
   tp = ap.f : @ds : 'voc'
   isprog = (kind = 3)                                           ;* M4: a program; efl is its program file, whose DATA path (field 2) is the file edited
   if efl # '' then
      openpath ap.f : @ds : 'voc' to rvf else
         msg = 'the VOC of ' : ea : ' cannot be opened'
         return
      end
      read fr from rvf, efl else fr = ''
      dorr = ''
      if isprog then read dorr from rvf, efl : '.out' else dorr = ''     ;* M6a: the .out file this VOC names, read at the keypress like the program file (D's object)
      close rvf
      if isprog then
         if upcase(trim(fr<1>))[1, 1] # 'F' or trim(fr<2>) = '' then
            msg = efl : ' is not a program file of ' : ea
            return
         end
         tp = parse.pathname.tokens(trim(fr<2>))
      end else
         if upcase(trim(fr<1>))[1, 1] # 'F' or trim(fr<3>) = '' then
            msg = efl : ' is not a file of ' : ea : ' that has a dictionary'
            return
         end
         tp = parse.pathname.tokens(trim(fr<3>))
      end
      if not(tp matches abs.pat) then tp = ap.f : @ds : tp
   end
   if not(kernel(K$PATH.IN, ap.f : @fm : tp)) then
      msg = (if efl = '' then 'the VOC file of ' : ea : ' lies outside the account' else 'the dictionary of ' : efl : ' lies outside ' : ea : ': it is edited in the account it lives in, not from here (' : tp : ')')
      if isprog then msg = 'the program file ' : efl : ' lies outside ' : ea : ': its programs are edited and compiled in the account they live in, not from here (' : tp : ')'
      return
   end
   * The words that go into the pointer's name and the IDE's sentence: asked AFTER the rule, so that a file outside the account ($map's dictionary in SDSYS) is refused for the reason
   * that matters, not for a character
   cw = ea
   gosub check.word
   ok1 = okname
   cw = eid
   gosub check.word
   ok2 = (okname and eid # 'creating.seqkey')                    ;* the IDE reads that word as "the next sequential id", not as a record
   cw = (if efl = '' then 'voc' else efl)
   gosub check.word
   if not(ok1 and ok2 and okname) then
      msg = 'an account, file or id with a character the page does not handle: work on it in that account (' : (if emode = 'delete' then 'delete' else 'ide') : ')'
      return
   end
   * 2 Nov 26 (Linux): a session that does not hold the account's group cannot write inside the account, so E, N, D, C and B were refused here in the 'relog' state.
   * 10 Nov 26 Windows port: there is no such state here (see sdsys.state), so there is no refusal and Linux's message 11981 is not carried.
   * The pointer SDSYS's VOC holds for the length of the edit is an F pointer that holds THE PATH JUST CHECKED (review of 3 Nov 26, finding 1): a Q-pointer would send the IDE back to
   * the account's own VOC at every open, and an account that may write its VOC could repoint the file between this check and the IDE's open.  For an item both parts are the
   * dictionary, so nothing else can be reached through the name; for the VOC there is no dictionary part.
   qf = (if efl = '' then 'voc' else efl)
   qn = 'zm' : @userno : '.' : ea : '.' : qf
   if len(qn) > 63 then
      msg = 'the name of this account and file is too long for the page'
      return
   end
   qrec = 'F' : @fm : tp : @fm : (if efl = '' then '' else tp)
   if isprog then qrec = 'F' : @fm : tp                          ;* a program file: the data part only (no dictionary is reached through it)
   open 'voc' to svf else
      msg = "the VOC of SDSYS cannot be opened"
      return
   end
   read qold from svf, qn then
      if qold # qrec then
         close svf
         msg = 'SDSYS holds a VOC entry called ' : qn : ' that this page did not make: it is not changed'
         return
      end
   end
   write qrec on svf, qn on error
      close svf
      msg = 'the VOC of SDSYS refused the pointer ' : qn
      return
   end
   close svf
   dfl = (if efl = '' then '' else 'dict')
   if isprog then dfl = ''
   open dfl, qn to tf else
      gosub drop.pointer
      msg = 'SD cannot follow the pointer into ' : ea : ' (is the account suspended?)'
      return
   end
   rp = fileinfo(tf, FL$PATH)
   rt = fileinfo(tf, FL$TYPE)
   rtw = (if isprog then FL$TYPE.DIR else FL$TYPE.DH)            ;* a program file is a directory file; the VOC and a dictionary are hashed files
   * M4: a program is a file of its own in the directory.  SD writes a directory file's record by opening that name (without SAFEDIR), so a LINK in its place would be followed.
   * The kernel's test of the record's own path (below) refuses both kinds: a link to a file outside the account (realpath), and a link that leads NOWHERE (op_sh.c's
   * resolve_name, 2 Nov 26: such a name used to be judged a new file inside; SD's SELECT of a directory file does not even list it, so the page could not see it itself).
   if emode # 'delete' then close tf                            ;* D deletes through THIS open, the one judged below, not a second one
   * What the kernel opened must lie inside the account, and so must the two subfiles of the hashed file it is (finding 2: the check of a directory says nothing of a link inside it,
   * and the subfiles are opened without refusing a link).  A file that is not a hashed file is not handed over at all.
   in.ok = kernel(K$PATH.IN, ap.f : @fm : rp)
   if in.ok then in.ok = kernel(K$PATH.IN, ap.f : @fm : rp : @ds : '%0')
   if in.ok then in.ok = kernel(K$PATH.IN, ap.f : @fm : rp : @ds : '%1')
   if isprog and in.ok then in.ok = kernel(K$PATH.IN, ap.f : @fm : rp : @ds : eid)     ;* the program's own file: a link in its place to a file outside is caught here
   if rt # rtw then
      gosub drop.pointer
      msg = 'the ' : (if efl = '' then 'VOC' else 'dictionary of ' : efl) : ' of ' : ea : ' is not a hashed file: the page does not hand it to the editor'
      if isprog then msg = 'the program file ' : efl : ' of ' : ea : ' is not a directory file: the page does not hand it to the editor'
      return
   end
   if not(in.ok) then
      gosub drop.pointer
      msg = 'the pointer into ' : ea : ' opens a file outside the account: it is edited in the account it lives in, not from here (' : rp : ')'
      return
   end
   if emode = 'delete' then
      gosub delete.reached
      return
   end
   if emode = 'compile' then
      gosub drop.pointer                                        ;* run.in reaches the file through the account's own VOC, not through the pointer
      gosub compile.reached
      return
   end
   if emode = 'debug' then
      gosub drop.pointer                                        ;* the same: run.in, in the account
      gosub debug.reached
      return
   end
   akind = (if efl = '' then 'voc' else 'dict')
   if isprog then akind = 'bp'
   void kernel(K$AUDIT, 'master edit account=' : ea : ' kind=' : akind : ' file=' : qf : ' id=' : eid : ' new=' : enw)
   sent = 'ide ' : (if efl = '' then '' else 'dict ') : qn : ' ' : eid
   if isprog then sent = 'ide ' : qn : ' ' : eid : ' /in=' : ea : ',' : efl     ;* the IDE compiles and catalogues a tab of qn through run.in in ea
   keep.k = (if efl = '' then eid else efl : '*' : eid)
   keep.ec = ec
   gosub hand.over
   return

* At the start: a pointer this user number left in SDSYS's VOC when a session ended inside the IDE (the page takes its pointer away when the IDE returns; a session that is killed
* cannot).  A zm<user number>.* entry that is an F or a Q record is the page's own name and is taken away (finding 4).
sweep.pointers:
   sw.pre = 'zm' : @userno : '.'
   open 'voc' to svf then
      select svf to 8
      loop
         readnext sw.id from 8 else exit
         if sw.id[1, len(sw.pre)] = sw.pre then
            read sw.r from svf, sw.id then
               if sw.r<1> = 'F' or sw.r<1> = 'Q' then
                  delete svf, sw.id
               end
            end
         end
      repeat
      close svf
   end
   return

* The pointer qn is taken out of SDSYS's VOC, if it is the one the page made
drop.pointer:
   open 'voc' to svf then
      read qold from svf, qn then
         if qold = qrec then
            delete svf, qn
         end
      end
      close svf
   end
   return

* D, after edit.record reached the record through the pointer and judged the file it opened (tf, still open): the record is read with its update lock (a record another session holds,
* an editor's, is refused), the administrator types its id in the box (Cancel is the default), and that one record is deleted through tf.  The pointer is given back on every way out.
* Nothing is run as a command.
delete.reached:
   dwhere = (if efl = '' then 'the VOC' else 'the dictionary of ' : efl) : ' of ' : ea
   dwhat = (if efl = '' then 'VOC entry' else 'dictionary item')
   dkind = (if efl = '' then 'voc' else 'dict')
   if isprog then
      dwhere = 'the program file ' : efl : ' of ' : ea
      dwhat = 'program'
      dkind = 'bp'
   end
   dhave = 1
   readu dold from tf, eid locked
      dlu = status()
      close tf
      gosub drop.pointer
      msg = eid : ' in ' : dwhere : ' is locked by user ' : dlu : ' (an editor holds it): it is not deleted'
      return
   end else
      dhave = 0
   end
   if not(dhave) then
      close tf
      gosub drop.pointer
      msg = eid : ' is not in ' : dwhere : ' any more: F5 reads the list again'
      return
   end
   dohave = 0
   if isprog then
      gosub object.judge                                        ;* the compiled program: found by name, judged by the pointer rule, before the box
      if not(dook) then
         close tf
         gosub drop.pointer
         return
      end
   end
   dsent = 'delete ' : eid : ' from ' : dwhere
   dlines = 'Deletes the ' : dwhat : ' ' : eid : ' from the account ' : ea : ', in its own file:' : @fm : rp
   if isprog then
      if dohave then
         dlines<-1> = 'and its compiled program ' : doid : ' in ' : dorp
      end else
         dlines<-1> = 'It has no compiled program (nothing called ' : doid : ' in ' : dop : ').'
      end
      dlines<-1> = 'A catalog entry of the program is left: it is the account' : "'" : 's (DELETE.CATALOG in ' : ea : ' removes it).'
   end
   dlines<-1> = 'This is not a command: the page deletes ' : (if dohave then 'those two records' else 'that one record') : ' itself.  Type its id to confirm.'
   call $tk_confirm(dsent, dlines, eid, res, cmsg, sysmsg(12958))   ;* Delete this record?
   if res # 'run' then
      close tf                                                  ;* the lock goes with it
      if dohave then close dof
      gosub drop.pointer
      gosub draw.all
      msg = cmsg
      return
   end
   delok = @true
   delete tf, eid on error delok = @false
   close tf
   gosub drop.pointer
   dores = 'none'
   if dohave then
      if delok then
         dores = 'deleted'
         delete dof, doid on error dores = 'failed'
      end
      close dof
   end
   * The messages are made BEFORE anything is drawn: entry.lines (the box under the lists) sets eid and efl to the row under the cursor, which after a delete is another record
   if not(delok) then
      msg = 'the ' : dwhat : ' ' : eid : ' of ' : ea : ' was not deleted: the file refused it'
      gosub draw.all
      return
   end
   if isprog then
      void kernel(K$AUDIT, 'master delete account=' : ea : ' kind=' : dkind : ' file=' : qf : ' id=' : eid : ' object=' : dores)
   end else
      void kernel(K$AUDIT, 'master delete account=' : ea : ' kind=' : dkind : ' file=' : qf : ' id=' : eid)
   end
   dmsg = 'deleted ' : eid : ' from ' : dwhere
   if dores = 'deleted' then dmsg := ' and its compiled program (a catalog entry is left)'
   if dores = 'failed' then dmsg := ': its compiled program in ' : dorp : ' was NOT deleted, the file refused it'
   keep.ec = ec
   gosub read.all
   ec = keep.ec
   nrows = (if fnd # '' then hn else en)
   if ec > nrows then ec = nrows
   if ec < 1 then ec = 1
   gosub keep.tops
   gosub draw.all
   msg = dmsg
   return

* M6a: the compiled program of the program eid, for D.  Found by NAME as the list finds it (M1c): the .out file the account's VOC names (dorr, the record <efl>.out that edit.record
* read again at the keypress), else the one beside the program file (tp, the path edit.record judged, and .out); the record is the program's id in lower case, as BASIC writes it.
* THE POINTER RULE holds for it as for the program file: the .out file (as written, then as the kernel opened it) and the object's own file must lie inside the account, asked
* here, before the box and before anything is deleted; a .out file outside the account refuses the whole delete.  A .out file that is not there, or holds no such record, is no object.
* Out: dook (the delete may go on; msg when not), dohave (there is an object; dof is open on its .out file), dop (the .out path), dorp (as opened), doid (the object's id).
object.judge:
   dook = @true
   dohave = 0
   dorp = ''
   doid = downcase(eid)
   if upcase(trim(dorr<1>))[1, 1] = 'F' and trim(dorr<2>) # '' then
      dop = parse.pathname.tokens(trim(dorr<2>))
      if not(dop matches abs.pat) then dop = ap.f : @ds : dop
   end else
      dop = tp : '.out'
   end
   if not(kernel(K$PATH.IN, ap.f : @fm : dop)) then
      dook = @false
      msg = 'the compiled programs of ' : efl : ' lie outside ' : ea : ': ' : eid : ' is deleted in the account they live in, not from here (' : dop : ')'
      return
   end
   openpath dop to dof else return                              ;* no .out file: no object
   dorp = fileinfo(dof, FL$PATH)
   if fileinfo(dof, FL$TYPE) # FL$TYPE.DIR then
      close dof
      return                                                    ;* not a directory file: not where BASIC puts a compiled program
   end
   do.in = kernel(K$PATH.IN, ap.f : @fm : dorp)
   if do.in then do.in = kernel(K$PATH.IN, ap.f : @fm : dorp : @ds : doid)     ;* the object's own file: a link in its place is caught here
   if not(do.in) then
      close dof
      dook = @false
      msg = 'the compiled program of ' : eid : ' opens a file outside ' : ea : ': it is deleted in the account it lives in, not from here (' : dorp : ')'
      return
   end
   read dox from dof, doid then dohave = 1 else close dof
   return

* C, after edit.record judged the program file and the program (the pointer is already given back): run.in compiles it in its own account and the page shows what the compiler said.
* The verdict is the compiler's own success line, not a return code (run.in's answer is about run.in).  run.in writes its own audit lines; the page adds "master compile".
compile.reached:
   copt = ''
   gosub compile.in.account
   gosub compile.box
   keep.ec = ec
   gosub read.all                                               ;* Built changes
   ec = keep.ec
   nrows = (if fnd # '' then hn else en)
   if ec > nrows then ec = nrows
   if ec < 1 then ec = 1
   gosub keep.tops
   gosub draw.all
   msg = cmsg
   return

* run.in compiles eid of the program file efl in the account ea (copt: '' or ' debugging').  Out: cout (what it printed), cok (the compiler's success line is there), cmsg.
compile.in.account:
   csent = 'run.in ' : ea : ' basic ' : efl : ' ' : eid : copt
   execute csent capturing cout
   cok = (index(cout, 'Compiled 1 program(s) with no errors', 1) > 0)
   void kernel(K$AUDIT, 'master compile account=' : ea : ' file=' : efl : ' id=' : eid : ' result=' : (if cok then 'ok' else 'failed'))
   cmsg = (if cok then 'compiled ' : eid : ' in ' : ea : ' (in its own account, by run.in)' else eid : ' in ' : ea : ' did not compile: the compiler said why')
   return

* What the compiler said (cout), in a box: its last 30 lines, where the errors and the verdict are
compile.box:
   cbody = ''
   cn2 = dcount(cout, @fm)
   for cq = 1 to cn2
      cl = trimb(convert(char(13), '', cout<cq>))
      if cl # '' then cbody<-1> = cl[1, 110]
   next cq
   if dcount(cbody, @fm) > 30 then cbody = field(cbody, @fm, dcount(cbody, @fm) - 29, 30)     ;* the last 30 lines: the errors and the verdict are at the end
   if cbody = '' then cbody = '(the compiler printed nothing)'
   ctitle = 'Compile ' : eid : ' in ' : ea
   screen msgbox cbody title ctitle buttons '&OK' default 1 returning cb2 else cb2 = 0
   return

* B (M5), after edit.record judged the program file and the program (the pointer is already given back): run.in compiles it for the debugger in its own account, and when that
* worked the terminal goes to the debugger, which run.in runs IN that account (the owner's mechanism C of 2 Nov 26); the page is taken again when the debugger ends.  A compile that
* failed is shown as C shows it and nothing is debugged.
debug.reached:
   copt = ' debugging'
   gosub compile.in.account
   if not(cok) then
      gosub compile.box
      gosub draw.all
      msg = cmsg
      return
   end
   void kernel(K$AUDIT, 'master debug account=' : ea : ' file=' : efl : ' id=' : eid)
   dbsent = 'run.in ' : ea : ' debug ' : efl : ' ' : eid
   keep.k = efl : '*' : eid
   keep.ec = ec
   call $tk_close(ctx)
   execute dbsent
   gosub retake.page
   msg = 'back from the debugger: ' : eid : ' was debugged in ' : ea
   return

* The terminal goes to the IDE and comes back: the pointer is taken away as soon as the IDE has ended, then the page is taken again and what it lists is read again.  Only the IDE can get here.
hand.over:
   if field(sent, ' ', 1) # 'ide' then
      gosub drop.pointer
      msg = 'the page does not run ' : field(sent, ' ', 1)
      return
   end
   call $tk_close(ctx)
   execute sent
   gosub drop.pointer
   gosub retake.page
   msg = 'back from the editor: the list shows ' : (if kind = 1 then 'the VOC' else 'the dictionary') : ' as it is now'
   if kind = 3 then msg = 'back from the editor: the list shows the programs as they are now'
   return

* After the editor (hand.over) or the debugger (debug.reached) gave the terminal back: a pause, the page taken again for the window as it is now, the lists read again and the cursor
* put back on keep.k (keep.ec in a find).  2 Nov 26 (M5): taken out of hand.over, which had it inline, so that the debugger's way back is the same one.
retake.page:
   crt
   crt sysmsg(12870) :                                         ;* Press Enter to return
   input junk
   if junk = char(1) then null                                 ;* any answer goes back; the answer itself is not used
   call $tk_open('tool.entries', 'admin', ctx, err)              ;* 9 Nov 26 (S.186): 'admin', as at the start (it was '': the administrator was not asked again and the bar named the user)
   if err # '' then
      display err
      done = 1
      return
   end
   call $tk_aipage('again', ctx, keys, '', '', aout)            ;* the new context has no AI line yet
   gosub declare.layout                                         ;* it is laid out for the window as it is now
   gen += 1
   ctx<TK.C.GEN> = gen
   gosub read.all
   if fnd = '' then
      locate keep.k in ekey<1> setting ep2 then ec = ep2
   end else
      ec = keep.ec
      if ec > hn then ec = hn
      if ec < 1 then ec = 1
   end
   gosub keep.tops
   gosub draw.all
   return

* /: keep the entries of the account whose id holds a text (a dictionary item: its id or its heading)
do.filter:
   ptxt = 'Part of an id (empty shows every entry)'
   if kind = 2 then ptxt = 'Part of an item id or heading (empty shows every item)'
   if kind = 3 then ptxt = 'Part of a program id (empty shows every program)'
   screen ask ptxt width 40 value ai.arg title 'Filter' returning ft then got = 1 else got = 0
   if not(got) then return
   filt = trim(ft)
   fnd = ''
   ec = 1 ; etop = 1
   gosub read.entries
   gosub draw.all
   msg = (if filt = '' then 'every entry' else en : ' with "' : filt : '"')
   return

* F: a text in the entries of every account (an id for the VOC; an id or a heading for a dictionary item)
do.find:
   ptxt = 'Part of an id, searched in the VOC of every account'
   if kind = 2 then ptxt = 'Part of an item id or heading, searched in the dictionaries of every account'
   if kind = 3 then ptxt = 'Part of a program id, searched in the program files of every account'
   screen ask ptxt width 40 value ai.arg title 'Find' returning ft then got = 1 else got = 0
   if not(got) then return
   fnd = trim(ft)
   filt = ''
   if fnd = '' then
      ec = 1 ; etop = 1
      gosub read.entries
      gosub draw.all
      msg = 'every entry of the account'
      return
   end
   gosub run.find
   pane = 2
   gosub draw.all
   msg = hn : ' hit' : (if hn = 1 then '' else 's') : ' in ' : hseen : (if kind = 1 then ' VOCs' else ' accounts') : (if htrunc then '; only the first ' : MAXV : ' are listed' else '')
   return

* K: the other kind of entry.  What was filtered or found is taken off, because a filter that means an id in the VOC means an id or a heading in a dictionary
do.kind:
   kind += 1
   if kind > 3 then kind = 1
   fnd = '' ; filt = ''
   ec = 1 ; etop = 1
   gosub read.entries
   gosub draw.all
   begin case
      case kind = 1
         msg = 'the VOC entries'
      case kind = 2
         msg = 'the dictionary items'
      case 1
         msg = 'the programs'
   end case
   return

* ------------------------------------------------------------------------------------------------- G and U, the global change (S.97 / S.96, the owner's answers of 3 Nov 26)

* G: ONE change to every row the page shows - the hits of a find (every account) or the rows the filter keeps (this account).  The set is exactly the rows shown: a filter or a find
* must be on and the list must not be cut at MAXV.  The change: a field (a number, or heading for a D, I, E or L item) set to a value or a text in it replaced; for a program, a text
* replaced in its source.  A preview (gc.pass, gw = 0, nothing written) is shown in ONE Run / Cancel box (the owner's choice: no name typed), then the run (gc.pass, gw = 1).
do.global:
   if fnd = '' and filt = '' then
      msg = 'G changes every row shown: narrow the rows first with / (this account) or F (every account)'
      return
   end
   if fnd # '' then
      gn = hn
      gtr = htrunc
   end else
      gn = en
      gtr = etrunc
   end
   if gn < 1 then
      msg = 'no row is shown: there is nothing to change'
      return
   end
   if gtr then
      msg = 'the page lists only the first ' : MAXV : ' rows: narrow the filter or the find until every row is shown'
      return
   end
   gacc = '' ; gfl = '' ; gid = '' ; gdig = '' ; g1old = '' ; g1new = ''
   for gi = 1 to gn
      if fnd # '' then
         gacc<gi> = hacc<gi>
         gfl<gi> = hfile<gi>
         gid<gi> = hid<gi>
      end else
         gacc<gi> = anm<ac>
         gfl<gi> = efile<gi>
         gid<gi> = enm<gi>
      end
   next gi
   gkd = kind
   gkw = (if kind = 1 then 'voc' else (if kind = 2 then 'dict' else 'bp'))
   gfld = 0 ; gop = 'replace' ; gval = '' ; gfrom = '' ; gto = ''
   if kind # 3 then
      ptxt = 'Field to change: its number, 1 to ' : GMAXF : (if kind = 2 then ', or heading' else '')
      screen ask ptxt width 40 value '' title 'Global change' returning ft then got = 1 else got = 0
      if not(got) then return
      ft = downcase(trim(ft))
      begin case
         case kind = 2 and ft = 'heading'
            gfld = 'heading'
         case ft # '' and convert('0123456789', '', ft) = '' and len(ft) <= 3
            gfld = ft + 0
            if gfld < 1 or gfld > GMAXF then
               msg = 'the field is a number from 1 to ' : GMAXF : ': nothing was changed'
               return
            end
         case 1
            msg = 'the field is a number from 1 to ' : GMAXF : (if kind = 2 then ', or the word heading' else '') : ': nothing was changed'
            return
      end case
      * Field 1 is the TYPE of a VOC entry or a dictionary item (the owner, 3 Nov 26: "Exclude field 1 from batch actions, allow it on a single item with a confirm warning"):
      * refused here, before the preview, when more than one record is shown; on ONE record the box carries a warning line
      if gfld = 1 and gn > 1 then
         msg = 'field 1 is the type of the record: G changes it on one record only, and ' : gn : ' are shown (narrow the filter or the find to that record): nothing was changed'
         return
      end
      screen ask 'S sets the field to a value, R replaces a text in it' width 40 value '' title 'Global change' returning ft then got = 1 else got = 0
      if not(got) then return
      ft = downcase(trim(ft))
      begin case
         case ft = 's'
            gop = 'set'
         case ft = 'r'
            gop = 'replace'
         case 1
            msg = 'S or R: nothing was changed'
            return
      end case
   end
   if gop = 'set' then
      screen ask 'The new value of the field (empty empties it)' width 60 value '' title 'Global change' returning gval then got = 1 else got = 0
      if not(got) then return
      pv = gval
      gosub check.print
      if not(pok) then return
   end else
      screen ask 'Text to replace' : (if kind = 3 then ' in the source' else '') width 60 value '' title 'Global change' returning gfrom then got = 1 else got = 0
      if not(got) then return
      if gfrom = '' then
         msg = 'there is no text to replace: nothing was changed'
         return
      end
      pv = gfrom
      gosub check.print
      if not(pok) then return
      screen ask 'Replace it with (empty takes it out)' width 60 value '' title 'Global change' returning gto then got = 1 else got = 0
      if not(got) then return
      pv = gto
      gosub check.print
      if not(pok) then return
   end
   begin case
      case kind = 3
         gwhat = 'replace "' : gfrom : '" with "' : gto : '" in the source'
      case gfld = 'heading' and gop = 'set'
         gwhat = 'set the heading to "' : gval : '"'
      case gfld = 'heading'
         gwhat = 'replace "' : gfrom : '" with "' : gto : '" in the heading'
      case gop = 'set'
         gwhat = 'set field ' : gfld : ' to "' : gval : '"'
      case 1
         gwhat = 'replace "' : gfrom : '" with "' : gto : '" in field ' : gfld
   end case
   * the preview: every account and file judged, every record read, nothing written
   gw = 0
   gosub gc.pass
   gtc = 0 ; gts = 0 ; gtrf = 0 ; gtf = 0
   for gq = 1 to gk
      gtc += gnc<gq>
      gts += gns<gq>
      gtrf += gnr<gq>
      gtf += gnf<gq>
   next gq
   gsent = 'global change: ' : gwhat : ', ' : gn : (if gn = 1 then ' row' else ' rows') : ' in ' : gk : (if gk = 1 then ' account' else ' accounts')
   if gtc = 0 then
      msg = 'no row would change (' : gts : ' as they are, ' : gtrf + gtf : ' refused): nothing was written'
      return
   end
   glines = ''
   glines<-1> = 'The page writes each record itself, account by account, in the file it lives in.' : (if kind = 3 then '  Each program changed is compiled again IN ITS OWN ACCOUNT by run.in.' else '  Nothing is run.')
   glines<-1> = 'A row whose file lies outside its account (the pointer rule), one another session holds, and one that has changed since this preview are refused and left as they are; the run goes on with the rest.'
   glines<-1> = 'The records as they were are kept in ' : UNDOF : ' (this run only): U puts back those still exactly as the run left them.'
   if gfld = 1 then
      glines<-1> = ''
      glines<-1> = 'WARNING: this changes the TYPE of ' : gid<1> : ' (field 1): "' : g1old : '" -> "' : g1new : '".  A pointer (F, Q, R), a verb (V) or a dictionary item given another type becomes something else, and what used it no longer works as it did.'
   end
   glines<-1> = ''
   for gq = 1 to gk
      if gq <= 12 then
         gl = gan<gq> : ': ' : gnc<gq> : ' to change'
         if gids<gq> # '' then gl := ' (' : convert(@vm, ' ', gids<gq>) : (if gnc<gq> > dcount(gids<gq>, @vm) then ' ...' else '') : ')'
         gl := ', ' : gns<gq> : ' as they are, ' : gnr<gq> + gnf<gq> : ' refused'
         if gwhy<gq> # '' then gl := ' - ' : gwhy<gq, 1>
         glines<-1> = gl
      end
   next gq
   if gk > 12 then glines<-1> = 'and ' : gk - 12 : ' more accounts'
   glines<-1> = ''
   glines<-1> = 'In all: ' : gtc : ' to change, ' : gts : ' as they are, ' : gtrf + gtf : ' refused.'
   call $tk_confirm(gsent, glines, '', res, cmsg, sysmsg(12959))   ;* Update these records?  Run / Cancel, Cancel the default; no name typed (the owner's choice, 3 Nov 26)
   if res # 'run' then
      gosub draw.all
      msg = cmsg
      return
   end
   * the undo file first: no record is written unless its old self can be kept
   gosub undo.file
   if not(uok) then
      gosub draw.all
      return
   end
   clearfile uf
   gun = 0
   ghdr = 'entries-undo' : @fm : date() : @fm : time() : @fm : @logname : @fm : gsent : @fm : 0 : @fm : 'running'
   write ghdr on uf, 'last' on error
      close uf
      gosub draw.all
      msg = 'the undo file cannot be written (status ' : status() : '): nothing was changed'
      return
   end
   gw = 1
   gosub gc.pass
   gsum = ''
   gtc = 0 ; gtrf = 0 ; gtf = 0
   for gq = 1 to gk
      gtc += gnc<gq>
      gtrf += gnr<gq>
      gtf += gnf<gq>
      gl = gan<gq> : ': ' : gnc<gq> : ' changed, ' : gnr<gq> : ' refused, ' : gnf<gq> : ' failed'
      gsum<-1> = gl
      for gr = 1 to dcount(gwhy<gq>, @vm)
         gsum<-1> = '   ' : gwhy<gq, gr>
      next gr
      ghdr<8, gq> = gan<gq> : @sm : gnc<gq> : @sm : gnr<gq> : @sm : gnf<gq>
   next gq
   ghdr<6> = gun
   ghdr<7> = 'done'
   write ghdr on uf, 'last' on error null
   close uf
   if dcount(gsum, @fm) > 30 then gsum = field(gsum, @fm, 1, 30) : @fm : '(and more: the audit trail has a line for each account)'
   gtitle = 'Global change: ' : gtc : ' changed'
   screen msgbox gsum title gtitle buttons '&OK' default 1 returning cb2 else cb2 = 0
   gmsg = 'global change: ' : gtc : ' changed, ' : gtrf : ' refused, ' : gtf : ' failed, in ' : gk : (if gk = 1 then ' account' else ' accounts') : '; U puts it back'
   gosub after.global
   msg = gmsg
   return

* After G or U: the undo state and the key table again (U enabled or not), the lists read again
after.global:
   gosub read.undo.info
   gosub build.keys
   call $tk_aipage('keys', ctx, keys, '', '', aout)
   keep.ec = ec
   gosub read.all
   ec = keep.ec
   nrows = (if fnd # '' then hn else en)
   if ec > nrows then ec = nrows
   if ec < 1 then ec = 1
   gosub keep.tops
   gosub draw.all
   return

* In: pv.  Out: pok (printable ASCII only, at most GMAXT characters; msg when not)
check.print:
   pok = (len(pv) <= GMAXT)
   for pq = 1 to len(pv)
      pc = seq(pv[pq, 1])
      if pc < 32 or pc > 126 then pok = 0
   next pq
   if not(pok) then msg = 'a text G takes is printable ASCII, at most ' : GMAXT : ' characters: nothing was changed'
   return

* THE PASS, preview (gw = 0: records read, nothing written) or run (gw = 1).  In: gn rows gacc gfl gid (in account order: a find's hits are), gkd gkw, the change (gfld gop gval
* gfrom gto), gdig (gw = 1: the digest of each row the preview would change).  Each ACCOUNT is judged afresh (gc.account: the register read again, the relog state) and each FILE by
* THE POINTER RULE (gc.file), before it is opened for writing; each row by gc.row.  A refusal or a failure is counted and the pass goes on, in that account and in the next.
* Out, per account gq of gk: gan the name, gnc to change (or changed), gns as they are, gnr refused, gnf failed, gids the first three ids changed, gwhy the first two reasons.
gc.pass:
   gan = '' ; gnc = '' ; gns = '' ; gnr = '' ; gnf = '' ; gids = '' ; gwhy = '' ; gk = 0
   gcura = '' ; gcurf = '' ; gfopen = 0 ; gaok = 0 ; gawhy = ''
   for gi = 1 to gn
      if gk = 0 or gacc<gi> # gcura then
         if gfopen then
            close gf
            gfopen = 0
         end
         if gk > 0 and gw then gosub gc.audit
         gk += 1
         gcura = gacc<gi>
         gcurf = '?'
         gan<gk> = gcura
         gnc<gk> = 0 ; gns<gk> = 0 ; gnr<gk> = 0 ; gnf<gk> = 0 ; gids<gk> = '' ; gwhy<gk> = ''
         gosub gc.account
      end
      ea = gcura
      efl = gfl<gi>
      eid = gid<gi>
      grs = '' ; grw = ''
      if not(gaok) then
         grs = 'refused'
         grw = gawhy
      end else
         if efl # gcurf then
            if gfopen then
               close gf
               gfopen = 0
            end
            gcurf = efl
            gosub gc.file
         end
         if gfok then
            gosub gc.row
         end else
            grs = 'refused'
            grw = gfwhy
         end
      end
      gosub gc.count
   next gi
   if gfopen then
      close gf
      gfopen = 0
   end
   if gk > 0 and gw then gosub gc.audit
   return

* One audit line for each account of a run, lower case, no data: what was changed, refused and failed
gc.audit:
   void kernel(K$AUDIT, 'master global account=' : gan<gk> : ' kind=' : gkw : ' changed=' : gnc<gk> : ' refused=' : gnr<gk> : ' failed=' : gnf<gk>)
   return

* In: grs (change, done, same, refused, failed), grw (why), eid efl.  The account's counts.
gc.count:
   gwho = (if efl = '' then eid else efl : ' ' : eid)
   begin case
      case grs = 'change' or grs = 'done'
         gnc<gk> = gnc<gk> + 1
         if dcount(gids<gk>, @vm) < 3 then gids<gk, -1> = gwho
      case grs = 'same'
         gns<gk> = gns<gk> + 1
      case grs = 'refused'
         gnr<gk> = gnr<gk> + 1
         if dcount(gwhy<gk>, @vm) < 2 then gwhy<gk, -1> = gwho : ': ' : grw
      case 1
         gnf<gk> = gnf<gk> + 1
         if dcount(gwhy<gk>, @vm) < 2 then gwhy<gk, -1> = gwho : ': ' : grw
   end case
   return

* The account gcura, judged afresh at the pass: the register read again (the list may be old) and the session's hold on its group (the relog state, 12986).  Out: gaok, gawhy, ap.f.
gc.account:
   gaok = 0
   gawhy = ''
   openpath @sdsys:@ds:'accounts' to acc.f else
      gawhy = 'the register cannot be opened'
      return
   end
   read arec from acc.f, gcura else arec = ''
   close acc.f
   if arec = '' then
      gawhy = 'the account is not in the register any more'
      return
   end
   ap.f = parse.pathname.tokens(arec<1>)
* 10 Nov 26 Windows port: no 'relog' state to refuse (see sdsys.state); Linux's message 11981 is not carried.
   gaok = 1
   return

* THE POINTER RULE for the file of the rows (efl: '' the account's VOC, else the file pointer of its VOC whose dictionary (gkd 2) or data (gkd 3, a program file) is changed), asked
* BEFORE the file is opened for writing: the path (tokens expanded, made the account's when relative) must lie inside the account, and so must what the kernel opened (FL$PATH) and,
* for a hashed file, its two subfiles (K$PATH.IN: realpath, so .. and links cannot make a path look inside).  A pointer's target outside the account is NEVER written: the owner's rule.
* Out: gfok, gfwhy; gf open (gfopen) when it got that far.
gc.file:
   gfok = 0
   gfwhy = ''
   tp = ap.f : @ds : 'voc'
   if efl # '' then
      openpath ap.f : @ds : 'voc' to gvf else
         gfwhy = 'the VOC of the account cannot be opened'
         return
      end
      read fr from gvf, efl else fr = ''
      close gvf
      if gkd = 3 then
         if upcase(trim(fr<1>))[1, 1] # 'F' or trim(fr<2>) = '' then
            gfwhy = efl : ' is not a program file of the account'
            return
         end
         tp = parse.pathname.tokens(trim(fr<2>))
      end else
         if upcase(trim(fr<1>))[1, 1] # 'F' or trim(fr<3>) = '' then
            gfwhy = efl : ' is not a file of the account with a dictionary'
            return
         end
         tp = parse.pathname.tokens(trim(fr<3>))
      end
      if not(tp matches abs.pat) then tp = ap.f : @ds : tp
   end
   gin = kernel(K$PATH.IN, ap.f : @fm : tp)
   rt = ''
   if gin then
      openpath tp to gf else
         gfwhy = 'the file cannot be opened (' : tp : ')'
         return
      end
      gfopen = 1
      rp = fileinfo(gf, FL$PATH)
      rt = fileinfo(gf, FL$TYPE)
      gin = kernel(K$PATH.IN, ap.f : @fm : rp)
      if gkd # 3 then
         if gin then gin = kernel(K$PATH.IN, ap.f : @fm : rp : @ds : '%0')
         if gin then gin = kernel(K$PATH.IN, ap.f : @fm : rp : @ds : '%1')
      end
   end
   if not(gin) then
      gfwhy = 'it lies outside the account (the pointer rule): it is changed in the account it lives in'
      return
   end
   if rt # (if gkd = 3 then FL$TYPE.DIR else FL$TYPE.DH) then
      gfwhy = (if gkd = 3 then 'the program file is not a directory file' else 'the file is not a hashed file')
      return
   end
   gfok = 1
   return

* A program's row: its words go into run.in's sentence (check.word), and its own file must lie inside the account (a link in its place).  In: ea efl eid, rp.  Out: gpok, gpw.
gc.prog:
   gpok = 0
   gpw = ''
   cw = ea
   gosub check.word
   ok1 = okname
   cw = efl
   gosub check.word
   ok2 = okname
   cw = eid
   gosub check.word
   if not(ok1 and ok2 and okname) then
      gpw = 'a name with a character the page does not give run.in'
      return
   end
   if not(kernel(K$PATH.IN, ap.f : @fm : rp : @ds : eid)) then
      gpw = "the program's own file lies outside the account (the pointer rule)"
      return
   end
   gpok = 1
   return

* One row in the file gf the pass judged.  The preview reads it and works out the change (gdig keeps what it read); the run takes the record with READU (another session's lock
* refuses), works the change out again, refuses a record that is no longer what the preview read, writes the record as it was to the undo file FIRST, then WRITEU; a program
* is then compiled again in its account by run.in, judged on the compiler's success line.  Out: grs, grw.
gc.row:
   if gkd = 3 then
      gosub gc.prog
      if not(gpok) then
         grs = 'refused'
         grw = gpw
         return
      end
   end
   glk = 0
   ghave = 0
   if gw then
      readu grec from gf, eid locked
         glk = status()
         if glk = 0 then glk = '?'
      end then
         ghave = 1
      end else
         ghave = 0
      end
   end else
      read grec from gf, eid then ghave = 1
   end
   if glk then
      grs = 'refused'
      grw = 'another session holds it (user ' : glk : ')'
      return
   end
   if not(ghave) then
      if gw then release gf, eid
      grs = 'refused'
      grw = 'it is not there any more'
      return
   end
   gosub gc.new
   if gcant then
      if gw then release gf, eid
      grs = 'refused'
      grw = gcw
      return
   end
   if ('S' : gnew) = ('S' : grec) then
      if gw then release gf, eid
      grs = 'same'
      return
   end
   if not(gw) then
      g1old = grec<1>                                           ;* for the field 1 warning of the box (a set of one record only)
      g1new = gnew<1>
      gdig<gi> = digest(grec, 0, 'MD5')
      grs = 'change'
      return
   end
   if ('S' : digest(grec, 0, 'MD5')) # ('S' : gdig<gi>) then
      release gf, eid
      grs = 'refused'
      grw = 'it has changed since the preview'
      return
   end
   gun += 1
   write ea : @fm : gkw : @fm : (if efl = '' then 'voc' else efl) : @fm : eid : @fm : digest(gnew, 0, 'MD5') : @fm : grec on uf, gun on error
      gun -= 1
      release gf, eid
      grs = 'failed'
      grw = 'the undo file could not be written (status ' : status() : ')'
      return
   end
   writeu gnew on gf, eid on error
      grs = 'failed'
      grw = 'the file refused the write (status ' : status() : ')'
      delete uf, gun                                            ;* the old record of a write that did not happen is not kept
      gun -= 1
   end
   release gf, eid
   if grs = 'failed' then return
   grs = 'done'
   if gkd = 3 then
      copt = ''
      gosub compile.in.account
      if not(cok) then
         grs = 'failed'
         grw = 'changed, but it did not compile in ' : ea : ' (run.in): C shows why'
      end
   end
   return

* The change worked out on grec.  Out: gnew, gcant (1: this record cannot take it; gcw why)
gc.new:
   gcant = 0
   gcw = ''
   gnew = grec
   if gkd = 3 then
      gnew = change(grec, gfrom, gto)
      return
   end
   gfno = gfld
   if gfld = 'heading' then
      t1 = upcase(trim(grec<1>))[1, 1]
      if t1 = 'D' or t1 = 'I' or t1 = 'E' or t1 = 'L' then
         gfno = 4
      end else
         gcant = 1
         gcw = 'it has no heading (not a D, I, E or L item)'
         return
      end
   end
   if gfno > dcount(grec, @fm) and (gop # 'set' or gval = '') then return     ;* nothing there to replace or to empty: the record is left as it is
   if gop = 'set' then
      gnew<gfno> = gval
   end else
      gnew<gfno> = change(grec<gfno>, gfrom, gto)
   end
   return

* The undo file (tool.bulk's way): the page may write it only if $tk_ownfile says so (a dynamic file standing directly in this account, SDSYS's, under that name, that the kernel's
* edit rules allow).  Made on demand through a box that shows the command.  Out: uok (uf open)
check.undo:
   uck = 0
   ucw = ''
   call $tk_ownfile(uf, UNDOF, uck, ucw)
   return

undo.file:
   uok = 0
   open UNDOF to uf then
      gosub check.undo
      if uck then
         uok = 1
      end else
         close uf
         msg = ucw : ': nothing was changed'
      end
      return
   end
   ulines = ''
   ulines<-1> = 'A global change keeps the records it changes, as they were, in a file of SDSYS' : "'" : 's own account called ' : UNDOF : ', so that U can put them back.  The file does not exist yet.'
   ulines<-1> = 'This makes it (the file and its VOC entry, in ' : @who : ').  Nothing else is done now; the change comes after it.'
   usent = MKUNDO
   call $tk_confirm(usent, ulines, '', res, cmsg)
   if res # 'run' then
      msg = 'no undo file, so nothing was changed'
      return
   end
   execute MKUNDO trapping aborts capturing mkout
   open UNDOF to uf then
      gosub check.undo
      if uck then
         uok = 1
      end else
         close uf
         msg = ucw : ': nothing was changed'
      end
   end else
      mkout = change(change(change(mkout, char(13) : char(10), @fm), char(10), @fm), char(13), '')
      mkw = trim(mkout<1>)
      msg = 'the undo file could not be made: ' : mkw[1, 100]
   end
   return

* What the undo file says about the last run.  Out: un.have, un.state (running, done, undone)
read.undo.info:
   un.have = 0
   un.state = ''
   open UNDOF to uif then
      read uh from uif, 'last' then
         if uh<1> = 'entries-undo' then
            un.have = 1
            un.state = uh<7>
         end
      end
      close uif
   end
   return

* U: the last global change put back, account by account.  A record is put back only if it is STILL BYTE FOR BYTE what the run wrote (the digest kept with it); one changed since, gone,
* or held by another session is left and counted, never overwritten.  Every account is judged afresh and every file by the pointer rule (gc.account, gc.file), as the run was; a
* program put back is compiled again in its account by run.in.  One audit line per account: entries undo account=<a> records=<n>.
do.undo:
   gosub read.undo.info
   if not(un.have) then
      msg = 'there is no global change to undo'
      return
   end
   if un.state = 'undone' then
      msg = 'the last global change has been put back already: there is nothing to undo'
      return
   end
   if un.state # 'running' and un.state # 'done' then
      msg = 'the header of the undo file is not one this page wrote: nothing was put back'
      return
   end
   open UNDOF to uf else
      msg = 'the undo file cannot be opened'
      return
   end
   gosub check.undo
   if not(uck) then
      close uf
      msg = ucw : ': nothing was put back'
      return
   end
   read uh from uf, 'last' else uh = ''
   n.undo = 0
   n.rest = 0
   loop
      read ur from uf, n.undo + 1 else exit
      n.undo += 1
      if ur<5> # 'restored' then n.rest += 1
   repeat
   ulines = ''
   ulines<-1> = 'Puts back the records the last global change wrote (' : n.rest : ' still to put back), to what they were before it:'
   ulines<-1> = uh<5>
   ulines<-1> = 'A record is put back only if it is still exactly what that run wrote; one that has changed since, has gone, or is held by another session is left alone and counted.  The pointer rule is asked again; a program put back is compiled again in its account by run.in.'
   usent = 'global change undo: ' : n.rest : (if n.rest = 1 then ' record' else ' records')
   call $tk_confirm(usent, ulines, '', res, cmsg, sysmsg(12960))   ;* Put these records back?  Run / Cancel
   if res # 'run' then
      close uf
      msg = cmsg
      return
   end
   u.back = 0 ; u.lock = 0 ; u.since = 0 ; u.gone = 0 ; u.ref = 0 ; u.err = 0 ; u.done = 0
   usum = ''
   gcura = '' ; gcurf = '' ; gfopen = 0 ; gaok = 0 ; gkd = 0 ; u.acct = 0 ; u.any = 0
   for un.i = 1 to n.undo
      read ur from uf, un.i else continue
      ua = ur<1>
      ukw = ur<2>
      ufl = ur<3>
      uid = ur<4>
      uemd = ur<5>
      for uq = 1 to 5
         del ur<1>
      next uq
      if uemd = 'restored' then
         u.done += 1                                            ;* put back by an earlier U
         continue
      end
      ugk = (if ukw = 'voc' then 1 else (if ukw = 'dict' then 2 else 3))
      if not(u.any) or ua # gcura then
         if gfopen then
            close gf
            gfopen = 0
         end
         if u.any then gosub undo.audit
         u.any = 1
         gcura = ua
         gcurf = '?'
         u.acct = 0
         gosub gc.account
      end
      ea = ua
      efl = (if ukw = 'voc' then '' else ufl)
      eid = uid
      if not(gaok) then
         u.ref += 1
         if dcount(usum, @fm) < 20 then usum<-1> = ua : ' ' : uid : ': ' : gawhy
         continue
      end
      if efl # gcurf or ugk # gkd then
         if gfopen then
            close gf
            gfopen = 0
         end
         gkd = ugk
         gcurf = efl
         gosub gc.file
      end
      if not(gfok) then
         u.ref += 1
         if dcount(usum, @fm) < 20 then usum<-1> = ua : ' ' : uid : ': ' : gfwhy
         continue
      end
      if gkd = 3 then
         gosub gc.prog
         if not(gpok) then
            u.ref += 1
            if dcount(usum, @fm) < 20 then usum<-1> = ua : ' ' : uid : ': ' : gpw
            continue
         end
      end
      lk = 0 ; got = 0
      readu cur from gf, uid locked
         lk = 1
      end then
         got = 1
      end else
         got = 0
      end
      begin case
         case lk
            u.lock += 1
            if dcount(usum, @fm) < 20 then usum<-1> = ua : ' ' : uid : ': another session holds it'
         case not(got)
            u.gone += 1
            release gf, uid
         case ('S' : digest(cur, 0, 'MD5')) # ('S' : uemd)
            u.since += 1                                        ;* changed since the run: left as it is, never overwritten
            release gf, uid
            if dcount(usum, @fm) < 20 then usum<-1> = ua : ' ' : uid : ': changed since the run, left as it is'
         case 1
            uok2 = 1
            writeu ur on gf, uid on error
               uok2 = 0
               u.err += 1
               if dcount(usum, @fm) < 20 then usum<-1> = ua : ' ' : uid : ': the file refused the write (status ' : status() : ')'
            end
            release gf, uid
            if uok2 then
               u.back += 1
               u.acct += 1
               ur2 = ua : @fm : ukw : @fm : ufl : @fm : uid : @fm : 'restored'
               write ur2 on uf, un.i on error null       ;* a second U does not put it back again
               if gkd = 3 then
                  copt = ''
                  gosub compile.in.account
                  if not(cok) then
                     u.err += 1
                     if dcount(usum, @fm) < 20 then usum<-1> = ua : ' ' : uid : ': put back, but it did not compile (run.in): C shows why'
                  end
               end
            end
      end case
   next un.i
   if gfopen then
      close gf
      gfopen = 0
   end
   if u.any then gosub undo.audit
   if u.lock = 0 and u.err = 0 and u.ref = 0 then              ;* a record held, refused or failed can be put back by another U
      if uh # '' then
         uh<7> = 'undone'
         write uh on uf, 'last' on error null
      end
   end
   close uf
   uhead = u.back : ' put back, ' : u.since : ' left (changed since the run), ' : u.gone : ' left (gone), ' : u.lock : ' held by another session, ' : u.ref : ' refused, ' : u.err : ' errors'
   if u.done > 0 then uhead := ' (' : u.done : ' put back by an earlier U)'
   usum = uhead : (if usum # '' then @fm : usum else '')
   screen msgbox usum title 'Undo of the global change' buttons '&OK' default 1 returning cb2 else cb2 = 0
   gosub after.global
   msg = 'undo: ' : uhead
   return

* One audit line for each account of an undo, lower case, no data
undo.audit:
   void kernel(K$AUDIT, 'entries undo account=' : gcura : ' records=' : u.acct)
   return

on.mouse:
   screen mouse returning mev else mev = ''
   if mev = '' then return
   mr = ''
   call $tk_menubar('click', ctx, keys, pnames<pane>, mev, '', mr)
   if mr<1> # '' then
      nm = mr<4>
      if nm # '' then gosub on.key
      return
   end
   call $tk_aipage('mouse', ctx, keys, pnames<pane>, mev, ap)
   if ap # '' then
      msg = ap
      return
   end
   call $tk_help('hit', mev, a.x + a.w - 5, a.y + 1, hit.accounts)
   call $tk_help('hit', mev, c.x + c.w - 5, c.y + 1, hit.entries)
   if hit.accounts or hit.entries then
      pane = (if hit.accounts then 1 else 2)
      gosub redraw
      gosub help.here
      return
   end
   if mev<1> = 'press' and mev<2> = 1 then
      mx = mev<3>
      my = mev<4>
      nrows = (if fnd # '' then hn else en)
      begin case
         case mx >= a.x + 1 and mx <= a.x + a.w - 2 and my >= a.y + 2 and my <= a.y + 1 + VIS
            k = atop + my - a.y - 2
            pane = 1
            if k <= an and k # ac then
               ac = k
               gosub new.account
            end else
               gosub redraw
            end
         case mx >= c.x + 1 and mx <= c.x + c.w - 2 and my >= c.y + 2 and my <= c.y + 1 + VIS
            k = etop + my - c.y - 2
            if k <= nrows then ec = k
            pane = 2
            gosub redraw
      end case
   end
   return

help.here:
   call $tk_help('box', (if pane = 1 then 'tool.entries.accounts' else 'tool.entries.entries'), hm, 0, 0)
   if hm # '' then msg = hm
   return

end

