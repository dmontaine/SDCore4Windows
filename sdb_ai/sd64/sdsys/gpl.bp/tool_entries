* The layout: the two lists side by side in the first band, the explanation in the second and the help in the third, at 140 by 43 the sizes tool.jobs has.
* Out: a.x a.y a.w a.h (Accounts), c.x c.y c.w c.h (Entries), m.x m.y m.w m.h (What this means), h.x h.y h.w h.h (Help), VIS.
declare.layout:
   d = ''
   d<1> = 'accounts' : @vm : 1 : @vm : 1 : @vm : 14 : @vm : 50 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<2> = 'entries' : @vm : 1 : @vm : 2 : @vm : 14 : @vm : 87 : @vm : 1 : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<3> = 'means' : @vm : 2 : @vm : 1 : @vm : 17 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<4> = 'help' : @vm : 3 : @vm : 1 : @vm : 5 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   ctx<TK.C.FOCI> = 'accounts' : @sm : 'Accounts' : @vm : 'entries' : @sm : 'Entries'   ;* the boxes that take the focus, for $tk_frame's [*] / [-]
   call $tk_layout('declare', ctx, d, perr)
   if perr # '' then
      call $tk_close(ctx)
      display perr
      stop
   end
   gosub get.rects
   return

get.rects:
   call $tk_layout('pane', ctx, 'accounts', rc)
   a.x = rc<1, 1> ; a.y = rc<1, 2> ; a.w = rc<1, 3> ; a.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'entries', rc)
   c.x = rc<1, 1> ; c.y = rc<1, 2> ; c.w = rc<1, 3> ; c.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'means', rc)
   m.x = rc<1, 1> ; m.y = rc<1, 2> ; m.w = rc<1, 3> ; m.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'help', rc)
   h.x = rc<1, 1> ; h.y = rc<1, 2> ; h.w = rc<1, 3> ; h.h = rc<1, 4>
   m.tw = m.w - 4
   h.tw = h.w - 4
   VIS = a.h - 4                                                 ;* the header row, the rows, a blank row and the border
   gosub keep.tops
