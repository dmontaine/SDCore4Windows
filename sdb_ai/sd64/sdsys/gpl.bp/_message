*
* START-DESCRIPTION:
*
*   Called by the kernel (kernel.c, EVT_MESSAGE) when a message sent with MESSAGE ... IMMEDIATE has arrived for
*   this user.  The messages wait in the IPC record M<userno>: each is a text, a value mark and its origin.
*
* END-DESCRIPTION
*
* START-CODE


$internal
$recursive
$no.symbols
$no.xref
subroutine message

$include syscom.h
$include keys.h
$include int$keys.h
$include sl.h

   prc = 'Press return to continue'

   * Display any IPC messages

   if fileinfo(ipc.f, FL$OPEN) then
      x = 'M':@userno
      readu messages from ipc.f, x then
         delete ipc.f, x    ;* Free up the lock immediately

         if messages # '' then
            return.key = seq(pterm(PT$INEWLINE,''))

            * The terminal's alternate screen, if it is a terminal and has one

            alt = @false
            if kernel(K$WINSIZE, '') # '' and terminfo('smcup') # '' and terminfo('rmcup') # '' then alt = @true

            * There could be many queued messages.  Show them a page at a time.

            max.messages = idiv(@crthigh - 8, 2)       ;* Max per page
            if max.messages < 1 then max.messages = 1
            width = @crtwide - 10
            if width < 20 then width = 20

            loop
               s = field(messages, @fm, 1, max.messages)
               messages = field(messages, @fm, max.messages + 1, 999999)
               n = dcount(s, @fm)
            while n
               * The lines of the page: the origin (may be blank) and then the text of each message
               text = ''
               for i = 1 to n
                  text<1, -1> = (s<i,2>)[1, width]
                  text<1, -1> = (s<i,1>)[1, width]
               next i

               if alt then
                  display terminfo('smcup') : @(-1) :
                  call $sl_scr('get', scr)
                  scr<SL.S.CLIP> = ''
                  bw = ''
                  bw<SL.W.D> = ''                       ;* no title
                  bw<SL.W.D + 1> = text
                  bw<SL.W.D + 2> = '&OK'
                  call $sl_msgbox('init', bw, scr, '', rc)
                  call $sl_msgbox('run', bw, scr, '', rc)
                  display terminfo('rmcup') :
               end else
                  for i = 1 to n
                     crt s<i,2>[1, width]
                     crt s<i,1>[1, width]
                  next i
                  crt prc :
                  inputclear
                  loop
                     i = seq(keyin())
                  until i = return.key
                  repeat
                  crt
               end
            repeat
         end
      end else
         release ipc.f, x
      end
   end
end

* END-CODE
