*
* START-DESCRIPTION:
*
*   SCREEN BOX {AT x,y} {SIZE w,h} {TITLE t} {ATTR style} {FILL}
*
*   is compiled into
*
*   call !screen_box(x, y, w, h, title, attr, fill, ret, status)
*
*     x y      the top left corner, from 0 (default 0)
*     w h      the width and height, border included (default: to the right and bottom edges); at
*              least 2 by 2, else ELSE and nothing is drawn
*     title    shown in the top border, cut to fit
*     attr     the style of the border (and of the inside with FILL); default normal
*     fill     1 blanks the inside; without it the inside is left as it is
*
*   The border is + - |.  The library's cursor is not moved.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_box(x, y, w, h, title, attr, fill, ret, status)
$catalog !screen_box

$include sl.h

   ret = ''
   status = 1
   if system(25) then return                  ;* a phantom has no terminal: nothing is drawn
   call $sl_scr('get', scr)

   if x = '' then x = 0
   if y = '' then y = 0
   x += 0 ; y += 0
   if w = '' then w = scr<SL.S.W> - x
   if h = '' then h = scr<SL.S.H> - y
   if w < 2 or h < 2 then return

   call $sl_attr(attr, code)
   call $sl_frame(scr, x, y, w + 0, h + 0, title, code, fill # '')

   call $sl_scr('put', scr)
   status = 0

   return
end

* END-CODE
