* START-DESCRIPTION:
*
*   CALL !PHLOG(user, name)
*
* Returns in NAME the log record (the COMO record) of the phantom whose user
* number is USER: the newest record in the $COMO directory file whose name
* starts PH<user>_.  Null if there is none.  Only the $COMO directory file is
* searched, not one named by PHANTOM LOG.
*
* END-DESCRIPTION
*
* START-CODE

$internal
$no.xref
subroutine phlog(user, name)
$catalog !PHLOG

$include keys.h
$include int$keys.h

   name = ''
   como.dir = '$COMO'
   read como.rec from @voc, '$COMO' then
      if como.rec<2> # '' then como.dir = como.rec<2>
   end

   open como.dir to como.f else return
   if fileinfo(como.f, FL$TYPE) # FL$TYPE.DIR then
      close como.f
      return
   end
   path = fileinfo(como.f, FL$PATH)
   close como.f

   prefix = 'PH' : user : '_'
   newest = 0
   entries = dir(path)
   for i = 1 to dcount(entries, @fm)
      id = entries<i,1>
      if id[1, len(prefix)] = prefix then
         dtm = ospath(path : @ds : id, OS$DTM)
         if dtm >= newest then
            newest = dtm
            name = id
         end
      end
   next i

   return
end

* END-CODE
