* 10 Nov 26 Windows port - level with Linux e3490a7f (the 2 Nov scrolling box); the 25 Oct (04f1eaa) and 8 Nov (2930d92f) carries are in the lines below.
* 2 Nov 26 dm  The box is never taller than the screen: lines beyond what fits scroll with PgUp / PgDn / Home / End, the bottom border says
*              "lines a-b of n".  The console witness of 2 Nov showed the AI preview (documentation passages included) running off the
*              screen with its request and its Send / Cancel buttons.  A box whose lines fit is drawn exactly as before.
* 28 Oct 26 dm  S.87: CLOSESEQ and EQU are gone as statements: this program says CLOSE and EQUATE.
* 12 Oct 26 dm  New.
* 18 Oct 26 dm  The key guardquit (the user left from the cursor lock, $sl_guardmode) closes the box as Esc does.
* 18 Oct 26 dm  For a program that asked for the cursor lock, the cursor is put on the selected button ($sl_curat) while the box is up and
*               put back where it was when the box goes: a box in a part of the screen the window does not show is a question the
*               user cannot read, and the keys are then taken by the lock.  A program that has not asked is not affected.
* 28 Oct 26 dm  S.88 L1: the common block /slguard/ has the lock's mode and layout size at its end, as $sl_guardmode and $sl_key declare it.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $sl_msgbox(op, w, scr, key, ret)      the widget contract (screenlib-design.md)
*
*     init    w is filled in by the caller: SL.W.D the title (null for none), SL.W.D + 1 the
*             lines of the message as values, SL.W.D + 2 the buttons as values.  An & in a
*             button's name marks its mnemonic letter (without one, the first character).
*             The box is centred on the screen of scr unless fields 16 and 17 hold the column and
*             row of its top left corner (it is moved to fit on the screen).  SL.W.S1 may hold the
*             button to start on (the first is the default).
*     draw    the box, saving the screen under it the first time
*     focus   key = 1 gives it the focus (draws), key = 0 takes it away (as close)
*     key     one key: left / up / btab and right / down / tab move among the buttons, enter
*             chooses the selected one, esc cancels, a mnemonic letter chooses at once.
*             ret<1> 'handled', 'unhandled', 'done' (ret<2> the button number) or 'cancel'.
*     close   puts the screen under the box back
*     run     init-less modal use: draws, reads keys until done or cancel, closes.  ret is the
*             button number, 0 if the user pressed Esc or the input ended.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_msgbox(op, w, scr, key, ret)
$catalog $sl_msgbox

$include sl.h

   equate B.GEOM to 13        ;* bx : by : w : h
   equate B.UNDER to 14       ;* the screen under the box
   equate B.SHOWN to 15       ;* 1 while the box is on the screen
   equate B.AX to 16          ;* the left column and top row asked for (null: centred)
   equate B.AY to 17
   equate B.CURSAVE to 18     ;* where the cursor lock thought the cursor was before the box: has : x : y : hid (guarded programs only)
   equate B.TOP to 19         ;* 2 Nov 26: the first message line shown, less one, when the lines are more than the screen holds

   common /slguard/ g.on, g.name, g.minw, g.minh, g.quit, g.mode, g.lw, g.lh
   common /slcur/ cu.has, cu.x, cu.y, cu.hid

   title = w<SL.W.D>
   nl = dcount(w<SL.W.D + 1>, @vm)
   nb = dcount(w<SL.W.D + 2>, @vm)
   sel = w<SL.W.S1> + 0
   if sel < 1 or sel > nb then sel = 1
   ret = ''

   * Button captions and mnemonics, and the size of the box
   cap = '' ; mn = '' ; bw = 0
   for b = 1 to nb
      t = w<SL.W.D + 2, b>
      p = index(t, '&', 1)
      if p and p < len(t) then
         mn<b> = upcase(t[p + 1, 1])
         t = t[1, p - 1] : t[p + 1, 99999]
      end else
         mn<b> = upcase(t[1, 1])
      end
      cap<b> = '[ ' : t : ' ]'
      bw += len(cap<b>) + 2
   next b
   bwid = bw
   for l = 1 to nl
      if len(w<SL.W.D + 1, l>) + 4 > bwid then bwid = len(w<SL.W.D + 1, l>) + 4
   next l
   if len(title) + 6 > bwid then bwid = len(title) + 6
   bwid += 2
   if bwid > scr<SL.S.W> then bwid = scr<SL.S.W>
   * 2 Nov 26: the box never grows past the screen.  Lines beyond what fits are scrolled with PgUp / PgDn (Home / End); the bottom border says
   * which lines are shown.  Before, a long message (the AI preview with documentation passages) ran off the screen with its buttons.
   vis = nl
   maxvis = scr<SL.S.H> - 6
   if maxvis < 1 then maxvis = 1
   if vis > maxvis then vis = maxvis
   top = w<B.TOP> + 0
   if top > nl - vis then top = nl - vis
   if top < 0 then top = 0
   if nl > vis then                              ;* wide enough for the bottom border's 'lines a-b of n, PgUp PgDn'
      minw = len(' lines ' : nl : '-' : nl : ' of ' : nl : ', PgUp PgDn ') + 4
      if bwid < minw then bwid = minw
      if bwid > scr<SL.S.W> then bwid = scr<SL.S.W>
   end
   bh = vis + 5
   bx = int((scr<SL.S.W> - bwid) / 2)
   by = int((scr<SL.S.H> - bh) / 2)
   if by < 1 then by = 1
   if w<B.AX> # '' and w<B.AY> # '' then      ;* the caller asked for a place
      bx = w<B.AX> + 0 ; by = w<B.AY> + 0
      if bx + bwid > scr<SL.S.W> then bx = scr<SL.S.W> - bwid
      if by + bh > scr<SL.S.H> then by = scr<SL.S.H> - bh
      if bx < 0 then bx = 0
      if by < 0 then by = 0
   end

   begin case
      case op = 'init'
         w<SL.W.TYPE> = 'msgbox'
         w<SL.W.FLAGS> = 'focusable' : @vm : 'visible'
         w<SL.W.X> = bx ; w<SL.W.Y> = by ; w<SL.W.W> = bwid ; w<SL.W.H> = bh
         w<SL.W.S1> = sel
         w<B.SHOWN> = 0

      case op = 'draw' or (op = 'focus' and key)
         gosub show

      case op = 'close' or op = 'focus'
         gosub unpaint

      case op = 'key'
         gosub handle.key

      case op = 'run'
         w<SL.W.S1> = sel
         gosub show
         loop
            call $sl_key('', key)
            if key = '' or key = 'guardquit' then key = 'esc'      ;* guardquit: the user left from the cursor lock ($sl_guardmode)
            if key = 'resize' then
               call $sl_resize(scr)                ;* the terminal's size changed: the box is drawn again with the rest
               ret = 'handled'
            end else
               gosub handle.key
            end
            st = ret<1>
         until st = 'done' or st = 'cancel'
         repeat
         result = if st = 'done' then ret<2> else 0
         gosub unpaint
         ret = result
   end case

   return

handle.key:
   ret = 'handled'
   begin case
      case key = 'esc'
         ret = 'cancel'
      case key = 'enter'
         ret = 'done' : @fm : sel
      case key = 'left' or key = 'btab' or key = 'up'
         sel = if sel > 1 then sel - 1 else nb
      case key = 'right' or key = 'tab' or key = 'down'
         sel = if sel < nb then sel + 1 else 1
      case key = 'mouse'
         * a click on a button chooses it; a click anywhere else is ignored
         call $sl_mouse('get', mev)
         if mev<1> = 'press' and mev<2> = 1 and mev<4> = by + vis + 2 then
            x = int((bwid - bw) / 2) + 2         ;* the string position of the first button, as paint has it
            for b = 1 to nb
               ln = len(cap<b>)
               if mev<3> >= bx + x - 1 and mev<3> < bx + x - 1 + ln then
                  sel = b
                  ret = 'done' : @fm : b
               end
               x += ln + 2
            next b
         end
      case key = 'pgdn' or key = 'pgup' or key = 'home' or key = 'end'
         * the message lines scroll; a box whose lines all fit has nothing to scroll and leaves the key to its caller
         if nl > vis then
            begin case
               case key = 'pgdn'
                  top += vis
               case key = 'pgup'
                  top -= vis
               case key = 'home'
                  top = 0
               case 1
                  top = nl - vis
            end case
            if top > nl - vis then top = nl - vis
            if top < 0 then top = 0
            w<B.TOP> = top
         end else
            ret = 'unhandled'
         end
      case len(key) = 1
         ret = 'unhandled'
         for b = 1 to nb
            if mn<b> = upcase(key) then
               sel = b
               ret = 'done' : @fm : b
            end
         next b
      case 1
         ret = 'unhandled'
   end case
   w<SL.W.S1> = sel
   w<SL.W.VALUE> = sel
   if w<B.SHOWN> then gosub paint
   return

show:
   if not(w<B.SHOWN>) then
      call $sl_region('save', scr, bx, by, bwid, bh, under)
      w<B.UNDER> = under
      w<B.SHOWN> = 1
      w<B.CURSAVE> = cu.has : ':' : cu.x : ':' : cu.y : ':' : cu.hid
   end

paint:
   call $sl_attr('window', na)
   call $sl_attr('highlight', ha)
   call $sl_line('tl', '', ctl)
   call $sl_line('tr', '', ctr)
   call $sl_line('bl', '', cbl)
   call $sl_line('br', '', cbr)
   call $sl_line('h', '', chh)
   call $sl_line('v', '', cvv)
   topl = ctl : str(chh, bwid - 2) : ctr
   if title # '' then topl = ctl : chh : ' ' : title : ' ' : str(chh, bwid - 5 - len(title)) : ctr
   call $sl_put(scr, bx, by, topl[1, bwid], na)
   for l = 1 to vis
      call $sl_put(scr, bx, by + l, fmt(cvv : ' ' : w<SL.W.D + 1, top + l>, (bwid - 1) : 'L') : cvv, na)
   next l
   call $sl_put(scr, bx, by + vis + 1, cvv : space(bwid - 2) : cvv, na)
   call $sl_put(scr, bx, by + vis + 3, cvv : space(bwid - 2) : cvv, na)
   botl = cbl : str(chh, bwid - 2) : cbr
   if nl > vis then              ;* 2 Nov 26: which lines are shown, and how to see the others
      mark = ' lines ' : (top + 1) : '-' : (top + vis) : ' of ' : nl : ', PgUp PgDn '
      if len(mark) + 4 <= bwid then botl = cbl : chh : mark : str(chh, bwid - 3 - len(mark)) : cbr
   end
   call $sl_put(scr, bx, by + vis + 4, botl[1, bwid], na)
   * The button row: the buttons are laid over the blank box row, the selected one in highlight
   txt = cvv : space(bwid - 2) : cvv
   atr = str(na, bwid)
   x = int((bwid - bw) / 2) + 2                  ;* string position of the first button
   for b = 1 to nb
      ln = len(cap<b>)
      txt = txt[1, x - 1] : cap<b> : txt[x + ln, bwid]
      c = na
      if b = sel then
         c = ha
         sx = x
      end
      atr = atr[1, x - 1] : str(c, ln) : atr[x + ln, bwid]
      x += ln + 2
   next b
   call $sl_put(scr, bx, by + vis + 2, txt, atr)
   if g.on then call $sl_curat(bx + sx + 1, by + vis + 2)     ;* on the first letter of the selected button's caption, as a button widget has it
   return

unpaint:
   if w<B.SHOWN> then
      under = w<B.UNDER>
      call $sl_region('restore', scr, bx, by, bwid, bh, under)
      w<B.SHOWN> = 0
      if g.on then
         * the cursor lock is told where the cursor was before the box, which is where the program leaves it
         cs = w<B.CURSAVE>
         cu.has = field(cs, ':', 1) + 0
         cu.hid = field(cs, ':', 4) + 0
         if cu.has then call $sl_curat(field(cs, ':', 2) + 0, field(cs, ':', 3) + 0)
         if cu.hid then call $sl_curat('off', '')
      end
   end
   return
end

* END-CODE
