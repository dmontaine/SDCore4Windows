               err.msg = sysmsg(12280, token.string)  ;* %1 is not an argument of this subroutine or function
               goto error
            end
            n = symbol.var.no ; gosub emit.numeric.load
            n = 20 ; gosub emit.numeric.load      ;* XF_ARGPRESENT
            intrinsic.stack<1> = OP.XFUN
            goto intrinsic.common

