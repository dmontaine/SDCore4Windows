               * 18 Oct 26 Windows port - from Linux 0cbb8b9 (12 Oct 26): - openQM 407.  INCLUDE [file] record: inserted at the top of every program.  SD's own
               * syntax (the release note gives none): the words after INCLUDE are exactly what follows $INCLUDE.
               auto.include<-1> = "$include " : field(voc.rec<1>, ' ', 2, 99)

            case s = "LISTING"
               listing.option = @true

            case s = "SEARCH"
               * 18 Oct 26 Windows port - from Linux b51c637 (16 Oct 26): - openQM 290.  The files an $INCLUDE with no file name looks in, in this order; @ is the file the
               * source record is in.  Spaces may separate the names as well as commas.
               include.search = convert(' ', ',', trim(field(voc.rec<1>, ' ', 2, 99)))
               include.search = change(include.search, ',,', ',')

            case s = "MODE"
               * One or more mode names, comma separated, each optionally
               * preceded by a minus to turn it off (refs 105 and 406).
               s = convert(' ', '', upcase(field(voc.rec<1>, ' ', 2, 99)))
               for mk = 1 to dcount(s, ',')
                  mnm = field(s, ',', mk)
                  mneg = (mnm[1,1] = '-')
                  if mneg then mnm = mnm[2,99]
                  if mnm # '' then
                     locate mnm in mode.names<1,1> setting i then
                        mode.off = mneg ; gosub set.mode.bit
                        gosub set.kernel.modes
                     end
                  end
               next mk

