*****************************************************************************
* START.LISTING  -  Activate program listing record

start.listing:
   if not(listing.used) then
      if not(is.ctype) then
         openseq output.file.name, listing.record.name to list.f else
            if status() then
               stop sysmsg(2971, status()) ;* "Error xx creating listing record
            end
         end
      end
      listing.used = @true
      list.pg = ''
   end
   return

* ======================================================================

emit.listing:
   if is.ctype then
      display list.rec
   end else
      writeseq list.pg:list.rec to list.f else null
      list.pg = ''
   end
   return


* ======================================================================
* SET.CAT.MODE  -  Record a catalogue keyword (ref 191)
*
* In:  CAT.WORD = LOCAL, GLOBAL or NO.QUERY (upper case)
* The mode passed back to BASIC is "[LOCAL|GLOBAL][ NO.QUERY]", which BASIC
* hands on as the tail of its CATALOGUE command.

set.cat.mode:
   cat.had.nq = (index(catalogue.mode, 'NO.QUERY', 1) # 0)
   if cat.word = 'NO.QUERY' then
      cat.had.nq = @true
      cat.new = field(catalogue.mode, ' ', 1)
      if cat.new = 'NO.QUERY' then cat.new = ''
   end else
      cat.new = cat.word
   end
   catalogue.mode = trim(cat.new : (if cat.had.nq then ' NO.QUERY' else ''))
   return

* ======================================================================
* STRICT.EQUATE.CHECK  -  With $MODE STRICT.EQUATE, warn that the name
* being defined by EQUATE or $DEFINE (in DEFINE.TOKEN) is also a statement
* or function name (ref 582).  The operator names (AND, OR, EQ ...) never
* reach here: the tokenizer returns them as operators, not names.

strict.equate.check:
   if bittest(mode, M.STRICT.EQUATE) then
      strict.name = upcase(define.token)
      locate strict.name in statements<1> setting strict.pos then
         err.msg = sysmsg(12043, define.token)
         gosub warning
      end else
         locate strict.name in intrinsics<1> setting strict.pos then
            err.msg = sysmsg(12043, define.token)
            gosub warning
         end
      end
   end
   return

* ======================================================================
* IFDEF.TEST  -  Evaluate the test on a $IFDEF or $IFNDEF line (ref 219)
*
* The line holds one token name, or token names joined by AND and OR.  AND
* binds tighter than OR; there is no NOT and no brackets.  Text after a
* name that is neither AND nor OR is ignored, as it always was.
* In:  SRC = the directive line
* Out: IFDEF.RESULT = @true if the test is true.  $IFNDEF skips when it is true,
*      so "$IFNDEF a OR b" is the negation of "$IFDEF a OR b".

ifdef.test:
   ifdef.line = trim(src)
   ifdef.result = @false      ;* OR of the terms already complete
   ifdef.term = @false        ;* AND of the names in the current term
   ifdef.first = @true        ;* No name yet in the current term
   ifdef.name.next = @true
   for ifdef.i = 2 to dcount(ifdef.line, ' ')
      ifdef.word = field(ifdef.line, ' ', ifdef.i)
      if ifdef.name.next then
         token.name = ifdef.word
         if not(bittest(mode, M.CASE.SENSITIVE)) then token.name = upcase(token.name)
         ss = find(defined.tokens, token.name)
         if ifdef.first then
            ifdef.term = (status() = 0)
            ifdef.first = @false
         end else
            ifdef.term = ifdef.term and (status() = 0)
         end
         ifdef.name.next = @false
      end else
         begin case
            case upcase(ifdef.word) = 'AND'
               null
            case upcase(ifdef.word) = 'OR'
               ifdef.result = ifdef.result or ifdef.term
               ifdef.term = @false
               ifdef.first = @true
            case 1
               exit           ;* Not ours: ignore the rest
         end case
         ifdef.name.next = @true
      end
   next ifdef.i
   ifdef.result = ifdef.result or ifdef.term
   return

* ======================================================================
* Reassess kernel modes after $MODE or equivalent

set.kernel.modes:
   * Case sensitivity of names
   i = bittest(mode, M.CASE.SENSITIVE)
   if i then header.flags = bitor(header.flags, hdr.case.sensitive)
   j = kernel(k$case.sensitive, i)

   * The overlap modes reach the run time through OP.STROVL at the call (see intrinsic.common)
   if bitand(mode2, 7) # 0 then str.ovl.used = @true

   * The default file variable (openQM 17, QM4 gap 225): STDFIL gives each program its own, STDFIL.SHARED one for the command level,
   * and both together are STDFIL.  Every statement tests the STDFIL bit, so STDFIL.SHARED alone turns it on and stdfil.shared
   * says whose variable it is.
   stdfil.shared = bittest(mode2, M2.STDFIL.SHARED) and not(stdfil.user)
   if stdfil.user or stdfil.shared then mode = bitset(mode, M.STDFIL) else mode = bitreset(mode, M.STDFIL)

   return

* ======================================================================
* Turn on or off the mode that position i of mode.names stands for.  Positions 1 to 32 are bits 0 to 31 of mode; 33 and
* up are bits 0 up of mode2.
*
* In: i = position in mode.names, mode.off = @true to turn it off

set.mode.bit:
   if i = 32 then stdfil.user = not(mode.off)
   if i <= 32 then
      if mode.off then
         mode = bitreset(mode, i - 1)
      end else
         mode = bitset(mode, i - 1)
      end
   end else
      if mode.off then
         mode2 = bitreset(mode2, i - 33)
      end else
         mode2 = bitset(mode2, i - 33)
      end
   end
   return

* ======================================================================
* Expand token tables for complex source line

expand.token.tables:
   max.tokens += 100
   ntok = idiv(max.tokens, 2)
   dim operator.stack(ntok)
   dim priority.stack(ntok)
   dim tokens(max.tokens)
   dim token.strings(max.tokens)
   for ntok = num.tokens + 1 to max.tokens
      tokens(ntok) = ''
      token.strings(ntok) = ''
   next ntok

   return

* ======================================================================
* GET.FILE.REF  -  Process reference to name defined using FILE
*
* In:  pos = index into file.refs and associated tables
*      vpos = position at which to insert in field lists
* Out: fno = field number (also inserted into lists)

get.file.ref:
   err = @false

   read dict.rec from file.d(pos), token.string else
      read dict.rec from file.d(pos), downcase(token.string) then
         token = downcase(token.string)
      end else
         read dict.rec from file.d(pos), upcase(token.string) else
            err.msg = sysmsg(3415, token.string)  ;* Field name %1 is not in the dictionary
            goto error
         end
         token = upcase(token.string)
      end
   end

   s = upcase(dict.rec[1,1])
   begin case
      case s = 'D'
         fno = dict.rec<2>

      case s = 'A' or s = 'S'
         if dict.rec<DICT.A.CORRELATIVE> # '' then
            err.msg = sysmsg(3417, token.string) ;* %1 has a correlative expression
            goto error
         end
         fno = dict.rec<2>

      case 1
         err.msg = sysmsg(3416, token.string) ;* %1 is not a D, A or S-type dictionary item
         goto error
   end case

   if not(fno matches '1N0N') then
      err.msg = sysmsg(3418, token.string) ;* Dictionary item %1 has a non-numeric field position
      goto error
   end

   if fno = 0 then
      err.msg = sysmsg(3419, token.string) ;* Dictionary item %1 is a record id reference
      goto error
   end

   ins token.string before file.fields<pos,vpos>
   ins fno before file.fld.nums<pos,vpos>

   return

* ======================================================================

convert.pick.file.reference:
   locate u.look.ahead.token.string in file.refs<1> setting pos then
      look.ahead.token.string = '__':look.ahead.token.string
   end
   return

* ======================================================================
* $MODE STDFIL  -  the default file variable (openQM 4, sheet item 17)
*
* The statements that take a file variable may leave it out; the file is then
* a hidden variable of the program, __STDFIL, which OPEN name (no TO) sets.
* It is per program (QM's STDFIL, not STDFIL.SHARED) and @STDFIL names it.
* A statement that names a file variable is compiled exactly as before.

* STDFIL.VAR.LOAD  -  Emit a load of the default file variable
stdfil.var.load:
   symbol.name = '__STDFIL'
   if not(stdfil.shared) then
      goto hidden.var.load     ;* the routine FOR EACH uses for its counters (15 Oct 26 dm: this was a copy of it)
   end
   symbol.mode = SYM.SET
   gosub find.var
   if symbol.var.no < 0 then gosub stdfil.shared.make
   goto emit.var.load

* STDFIL.SHARED.MAKE  -  Make the variable of $MODE STDFIL.SHARED (16 Oct 26 dm, QM4 gap 225)
*
* openQM's @STDFIL is one variable for every program of a command processor level, and an EXECUTE starts a level of its own
* and gives the old one back on return.  It is the only element of a named common block, $STDFIL, which every program that
* uses it binds to by name; op_execute saves and clears the element for the command it starts and op_return puts it back.
* Out: the symbol is entered as the first and only element of the block, SYMBOL.VAR.NO / COMMON.OFFSET / DIM / COMMON.INDEX set.
stdfil.shared.make:
   s = '$STDFIL'
   locate s in commons<1,1> setting common.index else
      symbol.var.no = var.count
      var.count += 1
      symbol.table<-1> = s
      commons<1,common.index> = s
      commons<2,common.index> = symbol.var.no
      commons<3,common.index> = '1'
   end
   symbol.var.no = commons<2,common.index>
   symbol.common.offset = 1
   symbol.dim = 0
   symbol.common.index = common.index
   locate symbol.name in symbols<1> by 'AL' setting sympos else
      ins symbol.name before symbols<sympos>
      ins symbol.var.no : @vm : symbol.common.offset : @vm : symbol.dim : @vm : common.index before symbol.info<sympos>
      ins '' before symbol.refs<sympos>
   end
   commons<4,common.index,1> = symbol.name
   commons<5,common.index,1> = 0
   commons<6,common.index,1> = 0
   symbol.mode = SYM.SET
   gosub note.symbol.ref
   symbol.mode = SYM.USE
   return

* SELLIST.DEFAULT.LOAD  -  Emit a load of the default select list variable  (15 Oct 26 dm, openQM item 85)
*
* $MODE SELECTV makes the list variable of SELECT / SELECTV / SSELECTV and the FROM list of READNEXT optional. Left out, it
* is a hidden variable of the program, __SELLIST: per program like __STDFIL, so a called subroutine has a default list
* of its own, and a CALL gets a fresh (unassigned) one.  Made on first use, as __STDFIL is.
sellist.default.load:
   symbol.name = '__SELLIST'
   goto hidden.var.load

* STDFIL.NO.OPERAND  -  For CLEARFILE, CLOSE, FILELOCK, FILEUNLOCK.
* STDFIL.USE is true when the mode is on and the next token is not a file
* variable (the statement ends, or an ON ERROR / LOCKED clause starts).
stdfil.no.operand:
   stdfil.use = @false
   if bittest(mode, M.STDFIL) then
      if look.ahead.token # TKN.NAME and look.ahead.token # TKN.NAME.LBR then
         stdfil.use = @true
      end else
         stdfil.s = u.look.ahead.token.string
         if stdfil.s = "ON" or stdfil.s = "LOCKED" then stdfil.use = @true
      end
   end
   return

* STDFIL.FVAR.TEST  -  For the statements with a record id after the file.
* STDFIL.FVAR is false only when the mode is on and the rest of the statement
* has no comma outside brackets, subscripts and clauses: then there is no
* file variable and the first expression is the record id.  Called with the
* look-ahead token at the start of that file-or-id expression.
stdfil.fvar.test:
   stdfil.fvar = @true
   if not(bittest(mode, M.STDFIL)) then return

   stdfil.depth = 0
   stdfil.i = token.index
   loop
      stdfil.t = tokens(stdfil.i)
   until stdfil.t = TKN.END or stdfil.t = TKN.SEMICOLON
      begin case
         case stdfil.t = TKN.LBR or stdfil.t = TKN.NAME.LBR or stdfil.t = TKN.LT
            stdfil.depth += 1
         case stdfil.t = TKN.RBR or stdfil.t = TKN.GT
            if stdfil.depth > 0 then stdfil.depth -= 1
         case stdfil.depth = 0 and stdfil.t = TKN.COMMA
            return
         case stdfil.depth = 0 and stdfil.t = TKN.NAME
            stdfil.s = upcase(token.strings(stdfil.i))
            if stdfil.s = "THEN" or stdfil.s = "ELSE" or stdfil.s = "ON" or stdfil.s = "LOCKED" then
               stdfil.fvar = @false
               return
            end
      end case
      stdfil.i += 1
   repeat

   stdfil.fvar = @false
   return

* ======================================================================

process.int.sub.args:
   err = @false
   call.arg.count = 0

   gosub get.token   ;* Skip left bracket

   loop
   while look.ahead.token # TKN.RBR

      if u.look.ahead.token.string = "MAT" then
         gosub get.token
         if look.ahead.token # TKN.NAME then
            err.msg = sysmsg(2856) ;* Matrix name required
            goto error
         end

         gosub get.token
         symbol.name = token.string
         symbol.mode = SYM.ARG
         gosub find.var

         if (symbol.var.no < 0) or (symbol.dim = 0) then
            err.msg = sysmsg(2856) ;* Matrix name required
            goto error
         end

         gosub emit.var.load
         int.sub.call.args := 'M'
      end else
         deref = (look.ahead.token = TKN.LBR)
         symbol.mode = SYM.ARG
         gosub exprf
         symbol.mode = SYM.USE
         if err then return
         if deref then
            opcode.byte = OP.VALUE
            gosub emit.simple
         end
         int.sub.call.args := 'S'
      end

      call.arg.count += 1

   while look.ahead.token = TKN.COMMA
      gosub get.token
   repeat

   if call.arg.count > 255 then
      err.msg = sysmsg(2884) ;* Too many arguments in CALL
      goto error
   end

   if look.ahead.token # TKN.RBR then goto err.rbr

   gosub get.token     ;* Skip close bracket

   if call.arg.count > greatest.call.arg.count then
      greatest.call.arg.count = call.arg.count
   end

   return

* ======================================================================
* Get a property name for an object reference

get.property.name:
   gosub get.token
   begin case
      case token = TKN.LBR    ;* Property name expression
         gosub expr       ;* Emit property name
         if look.ahead.token # TKN.RBR then goto err.rbr
         gosub get.token      
      case 1        
         opcode.string = u.token.string ; gosub emit.string.load
   end case

   return

* ====================================================================
* Process arguments to PUBLIC function/subroutine, SET and GET
*
* Returns
*   object.arg.names = FM delimited argument name list
*   obj.arg.count    = Arg count, possible with VAR.ARGS flag set

process.object.arg.list:
   object.arg.names = ''
   gosub get.token
   if look.ahead.token # TKN.RBR then ;* Not a null argument list
      loop
         gosub get.token
         if token = TKN.LABEL and token.string = '...' then
            * Special syntax for max length unnamed argument list
            * Add dummy arguments for the missing items
            for obj.arg.count = dcount(object.arg.names,@fm) + 1 to objargs
               object.arg.names<-1> = '*Arg':fmt(obj.arg.count,'R%3')
            next obj.arg.count
            obj.arg.count = bitor(obj.arg.count, 0x80)
            if look.ahead.token # TKN.RBR then goto err.rbr
            gosub get.token
            return
         end

         if token = TKN.LBR then  ;* Dereference argument
            deref = @true
            gosub get.token
         end else deref = @false

         if token # TKN.NAME then goto err.name

         locate u.token.string in object.arg.names<1> setting pos then
            err.msg = sysmsg(3456) ;* Duplicate argument name
            goto error
         end

         object.arg.names<-1> = u.token.string

         if deref then
            symbol.name = '*Arg':fmt(dcount(object.arg.names, @fm), 'R%3')

            symbol.mode = SYM.CHK
            gosub find.var
            gosub emit.var.load
            opcode.byte = OP.DEREF ; gosub emit.simple
         end

         if deref then
            if look.ahead.token # TKN.RBR then goto err.rbr
            gosub get.token
         end
      while look.ahead.token = TKN.COMMA
         gosub get.token
      repeat

      if dcount(object.arg.names, @fm) > objargs then
         err.msg = sysmsg(3444) ;* Too many arguments in public function/subroutine
         goto error
      end

      if look.ahead.token # TKN.RBR then goto err.rbr
   end

   gosub get.token

   obj.arg.count = dcount(object.arg.names, @fm)
   if u.look.ahead.token.string = 'VAR.ARGS' then
      obj.arg.count = bitor(obj.arg.count, 0x80)
      gosub get.token
   end

   return

* ======================================================================
* Process function/subroutine dimensioned argument

get.arg.mat.dimensions:
   gosub get.token  ;* Skip bracket
   gosub get.token  ;* Get first dimension
   if token # TKN.NUM then
      err.msg = sysmsg(2900) ;* Matrix dimensions required
      goto error
   end

   if look.ahead.token = TKN.COMMA then
      gosub get.token  ;* Skip comma
      gosub get.token  ;* Get second dimension
      if token # TKN.NUM then
         err.msg = sysmsg(2900) ;* Matrix dimensions required
         goto error
      end
      dim.dimensions = 2
   end else
      dim.dimensions = 1
   end
 
   if look.ahead.token # TKN.RBR then goto err.rbr

   gosub get.token

   return

*****************************************************************************
* Emit inheritance code for inherited objects

emit.inheritance:
   for inh.i = 1 to dcount(inherited.classes, @fm)
      inherited.class = inherited.classes<inh.i>
      inherited.var = inherited.vars<inh.i>
      token.string = inherited.var ; gosub emit.lvar.reference
      opcode.string = inherited.class ; gosub emit.string.load
      * The initialisation values given on the CLASS statement (Fixes item 356) follow the class name as OBJECT()'s own arguments
      inh.arg.list = inherited.args<inh.i>
      inh.arg.count = dcount(inh.arg.list, @vm)
      for inh.j = 1 to inh.arg.count
         init.kind = inh.arg.list<1,inh.j>[1,1]
         init.value = inh.arg.list<1,inh.j>[2,999999]
         if init.kind = 'N' then init.value += 0
         gosub emit.class.init.value
      next inh.j
      opcode.byte = OP.OBJECT ; gosub emit.simple
      opcode.byte = inh.arg.count ; gosub emit.simple
      opcode.byte = OP.STOR ; gosub emit.simple
      token.string = inherited.var ; gosub emit.var.reference
      opcode.byte = OP.INHERIT ; gosub emit.simple
   next inh.i

   return

*****************************************************************************
* ERROR  -  Report error

local sub error:
   private i, s

   del reserved.names<2>   ;* 0265 Ensure no "local" reserved names left active

   format.allowed.stack = ''

   if star.printed then
      display
      star.printed = @false
   end

   * An attempt to tidy this up by not displaying line numbers for errors
   * detected at the end of the source failed. It prevented SED's BASIC
   * command recognising errors and cutting them into the source.

   s = line.no(1)
   for i = 2 to level
      s := "." : line.no(i)
   next i
   err.msg = s : ': ' : err.msg

   display err.msg
   if listing(level) or print.code then
      list.rec = err.msg
      gosub emit.listing
   end

   errors += 1
   err = @true

   lock.opcode = 0            ;* Clear any unprocessed lock opcode
   op.stack.depth = 0         ;* Clear all stacked expression operators
   unary.minus = @false

   loop
   while look.ahead.token
      gosub get.token
   repeat

   return
end

* ======================================================================

local sub warning:
   private i, s

   if warnings.as.errors then errors += 1

   if star.printed then
      display
      star.printed = @false
   end

   if end.source then
      s = ''
   end else
      s = line.no(1)
      for i = 2 to level
         s := "." : line.no(i)
      next i
      s := ': '
   end
   err.msg = s : sysmsg(2970) : ': ' :err.msg

   display err.msg
   if listing(level) or print.code then
      list.rec = err.msg
      gosub emit.listing
   end

   return
end
end

