                        * 4 = In Set routine / public subroutine
                        * 5 = In public function
                        * 6 = In public subroutine
   object.arg.names = ''    ;* Names of arguments to current object routine
   inherited.classes = ''
   inherited.vars = ''    ;* Object variable name for each inherited class
   inherited.args = ''    ;* The initialisation values given for each inherited class, kind and value (hex) pairs in a value mark list (16 Oct 26, Fixes item 356)
   class.inits = ''       ;* PRIVATE and PUBLIC variables given an initial value: name, dimension, kind, value (16 Oct 26, Fixes item 565)
   init.kind = ''         ;* Set by get.class.init.constant: 'N' number, 'S' string, 'A' constant @-variable
