*** LASTS NV NS TRIMWS MATCHESS MATCHFIELDS): one opcode, OP.XFUN, with the function number loaded after the arguments
*** (op_xfun.c).  XFUN.ROWS gives for each name: its function number, the number of arguments the program must write, the
*** value of one optional last argument that may be left out (blank for none), and whether it is a multivalued function, in
*** which case the opcode is the wrapper for that many arguments (OP.XFUNM1 MVDS, OP.XFUNM2 MVDSS, OP.XFUNM3 MVDSSS) with XFUN
*** as the opcode it runs on every element.  test-xfun-units.py keeps this table and the XF_ numbers in step.
*** (15 Oct 26 dm, QM4 gaps Q-1)
in.xfun:
            if xfun.names = '' then gosub xfun.table.load
            locate x.symbol.name in xfun.names<1> setting xf.i else goto err.syntax
            * An argument can be a call of one of these functions, which changes XF.I, so the row is kept on a stack
            * while the arguments are read
            ins xf.i before xfun.stack<1>
            arg.count = xfun.argc<xf.i> ; gosub get.args
            xf.i = xfun.stack<1>
            if xfun.opt<xf.i> # '' then          ;* an optional last argument
               if look.ahead.token = TKN.COMMA then
                  gosub get.token
                  gosub exprf
                  xf.i = xfun.stack<1>
               end else
                  n = xfun.opt<xf.i> ; gosub emit.numeric.load
               end
            end
            del xfun.stack<1>
            n = xfun.sel<xf.i> ; gosub emit.numeric.load
            if xfun.mv<xf.i> then
               begin case
                  case xfun.argc<xf.i> = 1 ; intrinsic.stack<1> = OP.XFUNM1
                  case xfun.argc<xf.i> = 2 ; intrinsic.stack<1> = OP.XFUNM2
                  case 1 ; intrinsic.stack<1> = OP.XFUNM3
               end case
            end
            goto intrinsic.common

xfun.table.load:
            * name, function number, arguments written, optional last argument's default, multivalued (1) or not (0)
            xfun.rows = "CEIL,1,1,,0":@fm:"FLOOR,2,1,,0":@fm:"ROUNDUP,3,2,,0":@fm:"ROUNDDOWN,4,2,,0"
            xfun.rows := @fm:"IS.ALNUM,5,1,,0":@fm:"IS.ALPHA,6,1,,0":@fm:"IS.DIGIT,7,1,,0":@fm:"IS.GRAPH,8,1,,0"
            xfun.rows := @fm:"IS.MARK,9,1,,0":@fm:"IS.SPACE,10,1,,0":@fm:"LEFT,11,2,,0":@fm:"RIGHT,12,2,,0"
            xfun.rows := @fm:"LAST,13,2,,0":@fm:"LASTS,13,2,,1":@fm:"NV,14,1,0,0":@fm:"NS,15,1,,0"
            xfun.rows := @fm:"TRIMWS,16,1,,1":@fm:"MATCHESS,17,2,,1":@fm:"MATCHFIELDS,18,3,,1"
            xfun.rows := @fm:"BOOL,21,1,,0":@fm:"IS.NULL,22,1,,0":@fm:"NUMERIC,23,1,,0":@fm:"SIGNAL,25,1,,0"
            xfun.rows := @fm:"DIGEST,26,3,,0"   ;* 15 Oct 26 dm - QM4 gaps Q-13
            xfun.rows := @fm:"SWAPMARKS,28,1,,0" ;* 15 Oct 26 dm - QM4 gaps Q-1, sheet 238 (27 is SELECT.SOCKET, which has its own handler)
            for xf.j = 1 to dcount(xfun.rows, @fm)
               xf.row = xfun.rows<xf.j>
               xfun.names<xf.j> = field(xf.row, ',', 1)
               xfun.sel<xf.j> = field(xf.row, ',', 2)
               xfun.argc<xf.j> = field(xf.row, ',', 3)
               xfun.opt<xf.j> = field(xf.row, ',', 4)
