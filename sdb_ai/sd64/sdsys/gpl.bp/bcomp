   end

   * Perform common back-end processing

   ins '1' before onerror.stack<1>        ;* Optional ON ERROR clause
   ins '0' before testlock.stack<1>       ;* No LOCKED clause allowed
   ins '1' before thenelse.stack<1>       ;* THEN / ELSE clause required
