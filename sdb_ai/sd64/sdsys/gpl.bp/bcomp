   print.code = @false                ;* Expanded listing control
   star.printed = @false
   emit.symbol.table = emit.xref.tables
   emit.line.table = emit.xref.tables
   recursive = 0
   greatest.call.arg.count = 0
   final.end.seen = @false
   lsub.var.no = -1
   is.local.function = @false

