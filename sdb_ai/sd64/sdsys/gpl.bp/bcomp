            symbol.mode = SYM.CHK
            gosub find.var
            gosub emit.var.load

            n = commons<5, common.index, common.var.idx> + 0  ;* Rows
            gosub emit.numeric.load

            n = commons<6, common.index, common.var.idx> + 0  ;* Cols
            gosub emit.numeric.load

            opcode.byte = OP.DIMCOM  ; gosub emit.simple
