*****************************************************************************
* Statements that take two comma separated expressions
* ST.BREAKPOINT  -  BREAKPOINT statement (restricted)
* ST.SETNLS      -  SETNLS

st.breakpoint:
   opcode = OP.DBGBRK
   goto st2.common

st.setnls:
