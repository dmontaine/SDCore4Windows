*****************************************************************************
* ST.SELECT   -  SELECT statement
* ST.SELECTN  -  SELECTN statement
* ST.SELECTV  -  SELECTV statement
* ST.SSELECT  -  SSELECT statement

st.sselect:
   opcode = OP.SSELECT
   goto st.select.common

st.sselectv:
   opcode = OP.SSELECTV
   goto st.select.common

st.selectn:
   opcode = OP.SELECT
   goto st.select.common

st.selectv:
   opcode = OP.SELECTV
   goto st.select.common

st.select:
   opcode = if bittest(mode, M.SELECTV) then OP.SELECTV else OP.SELECT

st.select.common:
   * 14 Oct 26: the two questions this routine kept asking of OPCODE, once each in several places, are asked once here
   is.formlistv = formlistv.stmt ; formlistv.stmt = @false           ;* FORMLISTV is SELECTV of an array (st.formlistv)
   sorted.select = (opcode = OP.SSELECT or opcode = OP.SSELECTV)    ;* SSELECT clauses: RIGHT.ALIGNED, DESCENDING
   to.variable = (opcode = OP.SELECTV or opcode = OP.SSELECTV)      ;* TO names a select list VARIABLE, not a list number

   * Emit file variable / dynamic array reference

   stdfil.use = @false
   if bittest(mode, M.STDFIL) and not(sorted.select) then
      * $MODE STDFIL: SELECT {TO list} names no file, so it is the default file variable
      if look.ahead.token = TKN.END or look.ahead.token = TKN.SEMICOLON then stdfil.use = @true
      if u.look.ahead.token.string = "TO" or u.look.ahead.token.string = "ON" then stdfil.use = @true
   end
   if stdfil.use then
      gosub stdfil.var.load
   end else
      * A FORMLISTV array is not a file, so a single literal in it is not a file name (convert.pick.file.reference reads it
      * as one: FORMLISTV '' TO sl made a list with the item __ in it)
      if not(is.formlistv) then gosub convert.pick.file.reference
      gosub expr    ;* 0208
   end

   sselect.mode = 0
   if sorted.select then gosub sselect.clauses    ;* the clauses may come before TO...

   if u.look.ahead.token.string = "TO" then
      gosub get.token       ;* Skip TO
      if to.variable then
         gosub simple.lvar.reference
      end else
         gosub exprf            ;* Emit list number expression
      end
   end else     ;* Use default select list
      if to.variable then
         * 18 Oct 26 Windows port - from Linux ff49d57 (15 Oct 26): - openQM 85: under $MODE SELECTV the list variable is optional, and is the program's default one
         if not(bittest(mode, M.SELECTV)) then goto err.to
         gosub sellist.default.load
      end else
         n = 0 ; gosub emit.numeric.load
      end
   end

   * 18 Oct 26 Windows port - from Linux 9d13815 (11 Oct 26): - openQM 243 and 367: SSELECT [TO n] [RIGHT.ALIGNED] [DESCENDING], the two in either order.
   * The sort mode goes in as a third argument through its own opcode; the two-argument SSELECT is unchanged.
   * 14 Oct 26 - openQM 209: SSELECTV file TO var takes the same clauses and always has the mode (its own opcode).

   if sorted.select then
      gosub sselect.clauses                ;* ...or here, when there is no TO (after TO the list number swallows the word)
      if opcode = OP.SSELECTV then
         n = sselect.mode ; gosub emit.numeric.load
      end else if sselect.mode then
         n = sselect.mode ; gosub emit.numeric.load
         opcode = OP.SSELECTM
      end
   end

   * 18 Oct 26 Windows port - from Linux c608b9f (15 Oct 26): - QM4 gaps Q-16, $MODE PICK.SELECT: SELECTV (and SELECT, when $MODE SELECTV makes it one) moves an active
   * default list to the target and ignores the file, which op_selectv does when it is given P_PICK_SEL
   if opcode = OP.SELECTV and bittest(mode2, M2.PICK.SELECT) and not(is.formlistv) then
      opcode.byte = OP.SETFLAGS  ; gosub emit.simple
      code.value = 0x2000 ; code.bytes = 2 ; gosub emit.multibyte.value
   end

   * Perform common back-end processing

   ins '1' before onerror.stack<1>        ;* Optional ON ERROR clause
   ins '0' before testlock.stack<1>       ;* No LOCKED clause allowed
   ins '0' before thenelse.stack<1>       ;* No THEN / ELSE clause
   goto back.end

sselect.clauses:
   loop
      begin case
         case u.look.ahead.token.string = "RIGHT.ALIGNED"
            sselect.mode = bitor(sselect.mode, 1) ; gosub get.token
         case u.look.ahead.token.string = "DESCENDING"
            sselect.mode = bitor(sselect.mode, 2) ; gosub get.token
         case 1
            exit
      end case
   repeat
   return

