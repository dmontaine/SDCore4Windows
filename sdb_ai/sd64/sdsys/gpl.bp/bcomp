*****************************************************************************
* ST.SELECTINDEXV  -  SELECTINDEXV index {, value} FROM file.var TO list.var     (15 Oct 26 dm, QM4 gaps Q-2)
*
* SELECTINDEX into a select list VARIABLE: the indexed values of the index, or the ids of the records that have the value.
* Made of what exists: the SELECTINDEX goes to numbered list 10, and !movelist (MOVELISTV) moves that list into the variable,
* which leaves list 10 empty.  So list 10 is used as scratch, and what it held is lost; a program that keeps something in
* list 10 should keep it somewhere else.  STATUS() is the SELECTINDEX's (1 for an unknown index).

st.selectindexv:
   * A call of the catalogued subroutine !selidxv(index, value, has.value, file.var, list.var): the SELECTINDEX is done inside
   * it, so that STATUS() is the SELECTINDEX's when it returns (a call made after it would have set STATUS() to zero).
   s = '!selidxv'
   gosub emit.direct.call.reference
   gosub expr                  ;* Index name

   if look.ahead.token = TKN.COMMA then
      gosub get.token          ;* Skip comma
      gosub expr               ;* Indexed value
      has.value = 1
   end else
      opcode.byte = OP.LDNULL ; gosub emit.simple
      has.value = 0
   end
   n = has.value ; gosub emit.numeric.load

   if u.look.ahead.token.string # 'FROM' then goto err.from
   gosub get.token

   gosub convert.pick.file.reference
   gosub simple.var.reference  ;* The file variable

   if u.look.ahead.token.string # 'TO' then goto err.to
   gosub get.token             ;* Skip TO
   gosub simple.lvar.reference ;* The variable that is to hold the list
   if err then return
   sys.call.n = 5
   gosub emit.sys.call.end
   return

*****************************************************************************
* ST.ROOT  -  ROOT file.name, index TO scan.var THEN / ELSE       (15 Oct 26 dm, QM4 gaps Q-2)
* ST.KEY   -  KEY( operator, scan.var, index.key, item.id ) THEN / ELSE
* ST.BSCAN -  BSCAN value {, ids} FROM file.var {, key} USING index {RESET} {BY A | D} THEN / ELSE
*
* The Pick style index scans.  Each is a call of a catalogued function (!rootidx, !keyop, !bscan), made of SETLEFT, SELECTINDEX,
* SELECTLEFT and SELECTRIGHT, whose 1 or 0 the THEN and ELSE test, as OSREAD's does; the function leaves STATUS() as the manual
* describes it (SET.STATUS just before it returns).  A scan variable is a string, the file name and the index name, so KEY
* opens the file again each time.  The brackets of KEY are optional.  KEY( is a statement unless the program has a matrix
* called KEY, which proc.statement checks before it gets here.

st.root:
   s = '!rootidx'
   gosub emit.direct.call.reference
   gosub emit.function.return.argument
   gosub expr                           ;* The file name
   gosub check.comma
   gosub expr                           ;* The index
   if u.look.ahead.token.string # 'TO' then goto err.to
   gosub get.token
   gosub simple.lvar.reference          ;* The scan variable
   if err then return
   sys.call.n = 4
   gosub emit.sys.call.end
   gosub emit.function.result.load
   goto st.if.back.end

st.key:
   s = '!keyop'
   gosub emit.direct.call.reference
   gosub emit.function.return.argument
   key.paren = @false
   if look.ahead.token = TKN.LBR then
      gosub get.token
      key.paren = @true
   end
   gosub expr                           ;* The operator
   gosub check.comma
   gosub expr                           ;* The scan variable
   gosub check.comma
   gosub simple.lvar.reference          ;* The indexed value, in and out
   if err then return
   gosub check.comma
   gosub simple.lvar.reference          ;* The record id, in and out
   if err then return
   if key.paren then
      if look.ahead.token # TKN.RBR then goto err.rbr
      gosub get.token
   end
   sys.call.n = 5
   gosub emit.sys.call.end
   gosub emit.function.result.load
   goto st.if.back.end

st.bscan:
   s = '!bscan'
   gosub emit.direct.call.reference
   gosub emit.function.return.argument
   gosub simple.lvar.reference          ;* The indexed value
   if err then return
   if look.ahead.token = TKN.COMMA then
      gosub get.token
      gosub simple.lvar.reference       ;* The list of ids
      if err then return
   end else
      opcode.byte = OP.LDNULL ; gosub emit.simple    ;* none wanted: a constant takes the callee's assignment
   end
   if u.look.ahead.token.string # 'FROM' then goto err.from
