   if u.look.ahead.token.string = "FROM" then
      gosub get.token       ;* Skip FROM
      gosub exprf            ;* Emit list number expression
   end else if bittest(mode, M.SELECTV) then
      * 18 Oct 26 Windows port - from Linux ff49d57 (15 Oct 26): - openQM 85: under $MODE SELECTV the list is optional, and is the program's default select list variable
      * (the one a SELECT with no TO fills), not list 0; a variable no SELECT has filled is an empty list (P_DEF_SELLIST)
      gosub sellist.default.load
