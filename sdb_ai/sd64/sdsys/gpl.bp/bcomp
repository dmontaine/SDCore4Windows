   return

*****************************************************************************
* ST.TRY  -  TRY / CATCH construct (12 Oct 26 dm, openQM 355)
*
*     TRY {statement}
*        statements
*     CATCH exception {qualifiers} {, exception {qualifiers}...}
*        statements
*     {CATCH ...
*        statements}
*     END
*
* The code generated, and what the kernel does with it, are described above
* op_try() in gplsrc/op_jumps.c. The qualifiers are DUMPING and SAVING.STACK.
*
* The jump stack entry holds after its type and number: <1,3> the handler
* table (entries "<flags digit><NAME>" separated by commas, turned into value
* marks when emitted), <1,4> the number of CATCH clauses and <1,4+n> the names
* in clause n (commas, upper case). Everything needed after a nested construct
* has been compiled is read back from the top of the jump stack, because the
* nested TRY uses the same variables.

st.try:
   ins j.try:@vm:jump.no before jump.stack<1>
   jump.no += 1
   jump.stack<1,3> = ''
   jump.stack<1,4> = 0

   label.name = "_":jump.stack<1,2>:"T"
   opcode.byte = OP.TRY ; gosub emit.simple
   gosub emit.jump.addr

   * A statement may follow TRY on the same line

   if look.ahead.token = TKN.END then     ;* Nothing further on this line
      gosub get.token
   end else
      gosub get.token
      gosub proc.statement.group
      if look.ahead.token = TKN.END then gosub get.token
   end

   * The TRY clause

   loop
      if end.source then
         err.msg = sysmsg(12101) ;* Unterminated TRY clause
         gosub error
         goto exit.try
      end

      gosub get.token
      gosub check.for.label
   until u.token.string = "CATCH" or u.token.string = "END"
      gosub proc.line.prefetched
   repeat

   if u.token.string # "CATCH" then
      err.msg = sysmsg(12106) ;* TRY needs at least one CATCH clause
      gosub error
      goto exit.try
   end

   * Normal end of the clause: drop the handlers and skip the CATCH clauses

   label.name = "_":jump.stack<1,2>:"T"
   opcode.byte = OP.ENDTRY ; gosub emit.simple
   gosub emit.jump.addr
   label.name = "_":jump.stack<1,2>:"X"
   opcode.byte = OP.JMP ; gosub emit.jump

   * The CATCH clauses; the token is CATCH, the first on its line

   loop
      gosub try.catch.names
      if try.err then goto exit.try

      label.name = "_":jump.stack<1,2>:"H":jump.stack<1,4>
      gosub set.label

      loop
         if end.source then
            err.msg = sysmsg(12102) ;* Unterminated CATCH clause
            gosub error
            goto exit.try
         end

         gosub get.token
         gosub check.for.label
      until u.token.string = "CATCH" or u.token.string = "END"
         gosub proc.line.prefetched
      repeat

      label.name = "_":jump.stack<1,2>:"X"
      opcode.byte = OP.JMP ; gosub emit.jump
   until u.token.string = "END"
   repeat

   if look.ahead.token = TKN.END then gosub get.token

   * The handler table, and the code the kernel arrives at when an exception
   * is thrown: choose the CATCH clause that names it.

   label.name = "_":jump.stack<1,2>:"T"
   gosub set.label
   opcode.string = change(jump.stack<1,3>, ',', @vm)
   gosub emit.string.load

   try.n = jump.stack<1,4>
   for try.i = 1 to try.n
      opcode.string = change(jump.stack<1,4 + try.i>, ',', @vm)
      gosub emit.string.load
      opcode.byte = OP.EXC ; gosub emit.simple
      opcode.byte = 3 ; gosub emit            ;* Sub-opcode MATCH
      label.name = "_":jump.stack<1,2>:"H":try.i
      opcode.byte = OP.JTRUE ; gosub emit.jump
   next try.i

   opcode.byte = OP.EXC ; gosub emit.simple
   opcode.byte = 4 ; gosub emit               ;* Sub-opcode RETHROW

   label.name = "_":jump.stack<1,2>:"X"
   gosub set.label

exit.try:
   del jump.stack<1>

   return

* CATCH exception {qualifiers} {, exception {qualifiers}...}
* The token is CATCH. Reads to the end of the line and adds the clause to the
* top jump stack entry.

try.catch.names:
   try.err = @false
   try.h = jump.stack<1,4> + 1
   jump.stack<1,4> = try.h
   try.list = ''
   try.table = jump.stack<1,3>

   loop
      gosub get.token                ;* The exception name

      begin case
         case token = TKN.STRING
            try.name = upcase(token.string)
         case token = TKN.NAME
            try.name = u.token.string
         case 1
            try.name = ''
      end case

      if try.name = '' then
         err.msg = sysmsg(12100) ;* Exception name expected in CATCH clause
         gosub error
         try.err = @true
         return
      end

      if len(try.name) > 63 then
         err.msg = sysmsg(12104) ;* Exception name is longer than 63 characters
         gosub error
         try.err = @true
         return
      end

      try.flags = 0
      if bittest(mode, M.EXCEPTION.SAVE.STACK) then try.flags = 2

      loop
      while (look.ahead.token = TKN.NAME) and ~
            ((u.look.ahead.token.string = "DUMPING") or (u.look.ahead.token.string = "SAVING.STACK"))
         gosub get.token
         if u.token.string = "DUMPING" then
            try.flags = bitor(try.flags, 1)
         end else
            try.flags = bitor(try.flags, 2)
         end
      repeat

      if try.list # '' then try.list := ','
      try.list := try.name
      if try.table # '' then try.table := ','
      try.table := try.flags : try.name

      try.more = (look.ahead.token = TKN.COMMA)
      if try.more then gosub get.token   ;* Skip the comma
   while try.more
   repeat

   if look.ahead.token # TKN.END then
      err.msg = sysmsg(12103) ;* Unknown CATCH qualifier
      gosub error
      try.err = @true
      return
   end

   if len(try.table) > 250 then
      err.msg = sysmsg(12105) ;* Too many exception names in one TRY construct
      gosub error
      try.err = @true
      return
   end

   gosub get.token                   ;* Skip the end of the line

   jump.stack<1,3> = try.table
   jump.stack<1,4 + try.h> = try.list

   return

