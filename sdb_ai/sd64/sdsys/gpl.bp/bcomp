               catalogue.name = ''

            case s = "NOCASE.STRINGS"
               header.flags = bitor(header.flags, HDR.NOCASE)

            case s = "NOXREF"
               emit.xref.tables = @false

            case s = "WARNINGS.AS.ERRORS"
               warnings.as.errors = @true

            case s = "XREF"
               listing.option = @true
               list.xref = @true
         end case
      repeat
   end

   * The automatic includes go in front of the source.  The line counter starts that many lines early, so
   * every line number reported or recorded for debugging is still the line of the program as written.

   auto.include.lines = 0
   if auto.include # '' then
      auto.include.lines = dcount(auto.include, @fm)
      include.record(1) = auto.include : @fm : include.record(1)
   end

   last.debug.line = -1
   errors = 0
   if is.ctype then header.flags = bitor(header.flags, HDR.CTYPE + HDR.ITYPE)
   gosub set.kernel.modes

