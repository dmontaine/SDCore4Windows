st.akwrite:
   gosub expr            ;* Get record to write

   if (u.look.ahead.token.string = "TO") or (u.look.ahead.token.string = "ON") then
      gosub get.token      ;* Skip TO/ON token
      gosub expr            ;* Get file
      gosub check.comma
   end else
      opcode.byte = OP.LDUNASS
