      n = dcount(symbols, @fm)
      list.rec = ''
      gosub emit.listing
      list.rec = '===== VARIABLES ====='
      gosub emit.listing

      for i = 1 to n
         * Emit type
         z = symbol.info<i>
         if z<1,2> >= 0 then
            if symbol.refs<i> = '' then continue   ;* Ignore unreferenced common
