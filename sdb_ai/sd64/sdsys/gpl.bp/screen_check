*
* START-DESCRIPTION:
*
*   SCREEN CHECK f, id, text {AT x,y} {VALUE v}
*
*   is compiled into
*
*   call !screen_check(f, id, text, x, y, value, ret, status)
*
*     f id     the form and the widget's name in it (as SCREEN LABEL)
*     text     shown after [x] or [ ]
*     x y      the place of the box from the form's top left corner, default 1,1
*     value    1 to start checked (default 0)
*     status   0 added; 1 not (ELSE)
*
*   The space bar checks and unchecks it; SCREEN GET f, id answers 1 or 0.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_check(f, id, text, ax, ay, value, ret, status)
$catalog !screen_check

   ret = ''
   status = 1
   w = collection()
   w{'id'} = id
   w{'text'} = text
   x = 1
   y = 1
   if ax # '' then x = ax + 0
   if ay # '' then y = ay + 0
   w{'x'} = x
   w{'y'} = y
   w{'value'} = value
   call $sl_check('init', w, '', '', r)
   call $sl_wadd(f, w, ok)
   if ok then status = 0

   return
end

* END-CODE
