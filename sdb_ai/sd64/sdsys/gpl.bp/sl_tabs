* 18 Oct 26 Windows port - from Linux 7ff476f (12 Oct 26): New.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $sl_tabs(op, w, scr, key, ret)      the widget contract; w is a collection (see $sl_label)
*
*   Elements:  id, ax ay (the left cell of the strip on the screen), w h (its width, as wide as its
*   labels, and 1), items (the labels, as values), value (the number of the tab that is chosen, 1 to start with)
*
*     init    w and h from the labels; value is brought into range
*     draw    the labels in a row; the chosen one in square brackets, and in the highlight style while the
*             strip has the focus
*     focus   key = 1 gives it the focus (draws), key = 0 takes it away (draws)
*     key     left and right choose the tab before and after (not past the first or last), home and end the
*             first and last: ret<1> is 'handled'.  Anything else is 'unhandled' with ret<2> the key.
*             The form then shows the page of the widgets that belong to the chosen tab.
*     close   nothing to undo
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_tabs(op, w, scr, key, ret)
$catalog $sl_tabs

$include sl.h

   ret = ''
   items = w{'items'}
   n = dcount(items, @vm)
   if items = '' then n = 0
   cur = w{'value'} + 0

   begin case
      case op = 'init'
         w{'type'} = 'tabs'
         w{'focusable'} = 1
         wd = 0
         for i = 1 to n
            wd += len(items<1, i, 1>) + 3
         next i
         w{'w'} = wd
         w{'h'} = 1
         if cur < 1 then cur = 1
         if cur > n then cur = n
         w{'value'} = cur

      case op = 'draw'
         gosub paint

      case op = 'focus'
         w{'focused'} = if key then 1 else 0
         gosub paint

      case op = 'key'
         ret = 'handled'
         begin case
            case key = 'left'
               if cur > 1 then cur -= 1
            case key = 'right'
               if cur < n then cur += 1
            case key = 'home'
               cur = 1
            case key = 'end'
               cur = n
            case 1
               ret = 'unhandled' : @fm : key
         end case
         if ret = 'handled' then
            w{'value'} = cur
            gosub paint
         end

      case op = 'mouse'
         * a click on a tab's label chooses it
         ret = 'handled'
         if key<1> = 'press' then
            pos = 0
            for i = 1 to n
               l = len(items<1, i, 1>) + 3
               if key<3> >= w{'ax'} + pos and key<3> < w{'ax'} + pos + l then
                  cur = i
                  w{'value'} = cur
                  exit
               end
               pos += l
            next i
            gosub paint
         end
   end case

   return

paint:
   call $sl_attr('window', wc)
   call $sl_attr('highlight', hc)
   line = ''
   codes = ''
   focused = w{'focused'} + 0
   for i = 1 to n
      lab = items<1, i, 1>
      if i = cur then
         cap = '[' : lab : '] '
         line := cap
         cc = wc
         if focused then cc = hc
         codes := str(cc, len(cap) - 1) : wc
      end else
         cap = ' ' : lab : '  '
         line := cap
         codes := str(wc, len(cap))
      end
   next i
   call $sl_put(scr, w{'ax'} + 0, w{'ay'} + 0, line, codes)
   if focused and cur >= 1 then
      pos = 0
      for i = 1 to cur - 1
         pos += len(items<1, i, 1>) + 3
      next i
      display @(w{'ax'} + pos + 1, w{'ay'} + 0) :
   end
   return
end

* END-CODE
