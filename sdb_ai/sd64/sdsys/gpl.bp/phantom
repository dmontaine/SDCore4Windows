*
* START-DESCRIPTION:
*
*    PHANTOM command
*
* How a phantom starts....
* 1. This command takes the file lock on the $IPC file.
* 2. The phantom() function creates a new process and returns the SD user no.
* 3. This user number is entered in the phantom register together with the
*    command to be executed.
* 4. The command is also written to the Xn record for access by the phantom as
*    this process may have terminated by the time it gets off the ground.
*    (W.11 F10: before step 1 this process makes a secret, and in step 2 it
*    gives it to the new process in its environment, where only the same
*    operating-system user can read it.  The Xn record, and the Dn and Ln
*    records the options below may add, are written with a SEAL made with that
*    secret over what they hold (!IPC_SEAL); $ipc itself is a file any SD
*    user's process can write.)
* 5. We release the $IPC file lock.
* 6. The phantom gets the file lock on the $IPC file, possibly waiting for the
*    parent to write the Xn record.
* 7. The phantom process reads the phantom register entry for its parent and
*    locates the entry for its own process, setting the timestamp.  This record
*    will not exist if the parent has terminated while the phantom was
*    starting.
* 8. The phantom retrieves the command from the Xn record, deleting the record,
*    and checks the seal on it and on the Dn and Ln records (CPROC,
*    read.phantom.cargo).  If the seal does not check, nothing is run.
* 9. The phantom process executes the command.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $phantom
$catalog $PHANTOM

$include syscom.h
$include syscom err.h
$include syscom keys.h
$include int$keys.h

deffun ipc_seal(sl.mode, sl.key, sl.seal, sl.opts, sl.cmd, sl.data, sl.log) calling '!ipc_seal'     ;* 26 Oct 26 dm, W.11 F10

$define default.como.dir "$COMO"
$define como.dir.voc.name "$COMO"

   @system.return.code = -ER$ARGS

   if @transaction.id then
      @system.return.code = -ER$TXN
      stop sysmsg(6480) ;* Phantom processes cannot be started within a transaction
   end

   * Get phantom command string
 
   ph.command = trimb(field(@sentence, ' ', 2, 999999))

   * 18 Oct 26 Windows port - from Linux 778b4d9 (12 Oct 26): - openQM 483, 137, 364, in SD's own syntax.  Words in front of the command, in any order:
   *    NO.MSG        do not display the "Started phantom" message
   *    DATA          hand the DATA queue of this process to the phantom (it is emptied here)
   *    LOG dirfile   the phantom's log (COMO record) goes in this directory file instead of $COMO
   *    GROUP         the phantom is grouped with this process: it is logged out when this process ends (15 Oct 26)
   *    USER n        the phantom is user number n, one of the numbers the PHANTOMS parameter keeps (16 Oct 26)
   no.msg = @false
   pass.data = @false
   group.it = @false
   req.user = ''
   log.file = ''
   loop
      w = upcase(field(ph.command, ' ', 1))
      begin case
         case w = 'NO.MSG'
            no.msg = @true
            ph.command = trimf(ph.command[len(w) + 1, 999999])
         case w = 'DATA'
            pass.data = @true
            ph.command = trimf(ph.command[len(w) + 1, 999999])
         case w = 'GROUP'      ;* 15 Oct 26 dm - logged out when this process ends (QM4 gaps Q-8, sheet 427 and 433)
            group.it = @true
            ph.command = trimf(ph.command[len(w) + 1, 999999])
         case w = 'USER'      ;* 16 Oct 26 dm - PHANTOM USER n: the user number the phantom is to take
            ph.command = trimf(ph.command[len(w) + 1, 999999])
            req.user = field(ph.command, ' ', 1)
            ph.command = trimf(ph.command[len(req.user) + 1, 999999])
            if req.user = '' then stop sysmsg(12361)
            if not(num(req.user)) then stop sysmsg(12361)
            if req.user < 1 or req.user # int(req.user) then stop sysmsg(12361)
         case w = 'LOG'
            ph.command = trimf(ph.command[4, 999999])
            log.file = field(ph.command, ' ', 1)
            ph.command = trimf(ph.command[len(log.file) + 1, 999999])
            if log.file = '' then stop sysmsg(12084) ;* Directory file name required after LOG
         case 1
            exit
      end case
   repeat

   if len(ph.command) then
      gosub check.como.dir

      * USER n (16 Oct 26): the number has to be one the PHANTOMS parameter keeps.  CONFIG('PHANTOMS') is "first,count", null
      * when none are kept.  Whether the number is free is for the kernel to say, under the lock on the user table.

      if req.user # '' then
         ph.range = config('PHANTOMS')
         if ph.range = '' then
            ok.range = @false
         end else
            ok.range = (req.user >= field(ph.range, ',', 1) and req.user < field(ph.range, ',', 1) + field(ph.range, ',', 2))
         end
         if not(ok.range) then
            @system.return.code = -ER$ARGS
            stop sysmsg(12362, req.user)
         end
      end

      * 26 Oct 26 dm - W.11 F10.  $ipc is a file every SD user's process may write, so what the new process takes from it is sealed: the
      *   seal is made now, before anything is created, with a secret that is given to the new process in its environment and written
      *   nowhere.  If the secret or the seal cannot be made, no process is started.  The values are exactly the ones written to the
      *   records below - the option flags, the command, the DATA queue when it is passed, and the log file name - and CPROC
      *   (read.phantom.cargo) makes the same seal from what it reads and runs nothing unless it is the same.
      opt.s = if option(OPT.INHERIT) then kernel(K$GET.OPTIONS,0) else ''
      dq = if pass.data then @data.pending else ''
      nonce = SDEXT('24', @TRUE, SD_RANDBYTES)
      seal = ipc_seal('make', nonce, '', opt.s, ph.command, dq, log.file)
      if seal = '' then
         @system.return.code = -ER$PROCESS
         stop sysmsg(12951)
      end

      * We hold the file lock on the $IPC file across process creation so
      * that we can enter the uid of the new process into the parent process
      * register entry and write a copy of the command in the Xn record.

      filelock ipc.f

      if kernel(K$PHANTOM.NONCE, 'S':nonce) # 1 then   ;* the secret for this phantom() only
         fileunlock ipc.f
         @system.return.code = -ER$PROCESS
         stop sysmsg(12951)
      end

      if req.user # '' then void kernel(K$PHANTOM.USER, req.user)

      uid = phantom()

      if (uid = 0) then   ;* Could not create process
        fileunlock ipc.f
        @system.return.code = -ER$PROCESS
        if req.user # '' then stop sysmsg(12363, req.user)   ;* that user number is already in use
        stop sysmsg(6481) ;* Failed to create phantom process
      end

      if group.it then void kernel(K$GROUP.PHANTOM, uid)

      * Update parent process Pn phantom register record

      id = 'P':@userno
      readu ipc.rec from ipc.f, id else null

      * Do a locate so that...
      * 1. If there is a dead entry with our process id, we overwrite it
      * 2. If there is no dead entry, we append a new entry.

      locate uid in ipc.rec<1,1> setting pos else null
      ipc.rec<1,pos> = uid                 ;* Phantom process uid
      ipc.rec<2,pos> = ''                  ;* Timestamp (set by phantom)
      ipc.rec<3,pos> = ph.command          ;* Command to execute
      write ipc.rec to ipc.f, id

      * Write phantom command to Xn record: the seal, the option flags, then the command (26 Oct 26 F10: the seal is first)

      write seal:@fm:opt.s:@fm:ph.command to ipc.f, 'X':uid

      * The extras travel in their own records, read and deleted by the phantom (cproc); the seal covers them
      if pass.data then
         cleardata
         write dq to ipc.f, 'D':uid
      end
      if log.file # '' then write log.file to ipc.f, 'L':uid

      fileunlock ipc.f

      if not(no.msg) then crt sysmsg(6482, uid) ;* Started phantom user xx
      @system.return.code = uid
   end else
      stop sysmsg(6483) ;* Phantom command missing
   end

   return

*****************************************************************************
* CHECK.COMO.DIR  -  Check $COMO exists

check.como.dir:
   read como.rec from @voc,como.dir.voc.name then
      como.dir = como.rec<2>

      * Check if COMO directory exists
      
      open como.dir to como.dir.file then
         * Check file type
         if fileinfo(como.dir.file, fl$type) # fl$type.dir then
            @system.return.code = -ER$NDIR
            stop sysmsg(6484) ;* $COMO is not a directory file
         end
         close como.dir.file
      end else
         if status() # ER$NVR then
            @system.return.code = -status()
            stop sysmsg(1430, status(), como.dir) ;* Error %1 opening %2
         end
      end
   end else
      como.dir = default.como.dir

      * Create new COMO directory

      create.file como.dir directory on error
         @system.return.code = -ER$NOT.CREATED
         stop sysmsg(1432, status(), os.error(), como.dir) ;* Error xx creating xx
      end

      como.rec = "File for COMO output" : @fm : como.dir

      recordlocku @voc, como.dir.voc.name
      write como.rec to @voc, como.dir.voc.name
   end

   return
end

* END-CODE
