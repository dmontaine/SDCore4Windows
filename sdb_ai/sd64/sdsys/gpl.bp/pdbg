$internal

subroutine $pdbg(prog.id, dtm, line, sub.ref, event)
$catalog $PDBG

$flags debugger

$include keys.h
$include debug.h
$include syscom.h

$include int$keys.h

deffun atvar(name) calling "!atvar"

   if not(debug.initialised) then
      * There should (hopefully) be a user sitting in PDEBUG waiting to
      * pick up this connection. If so, there will be a DR.xxx record
      * in the user's private store (!pdbg_store, not $IPC) where xxx is
      * the account name. This record will
      * contain the PDEBUG process user number which will be used for
      * subsequent parts of the conversation so that a second user could
      * start a debugging session.

      call !pdbg_store(dbg.store, store.why)
      if store.why # '' then goto cannot.debug

      id = 'DR.':@who:'!':@logname
      readu in.msg from dbg.store, id else goto cannot.debug
      if in.msg<1> # 'START' then goto cannot.debug
      debugger.uid = in.msg<2>
      if kernel(K$USERS, debugger.uid) = '' then
         delete dbg.store, id      ;* PDEBUG has gone and left its record: nobody is waiting
         goto cannot.debug
      end
      delete dbg.store, id

      id = 'D.':debugger.uid
      recordlocku dbg.store, id
      delete dbg.store, id

      debug.initialised = @true
   end

   * Send debug line information

   out.msg = 'DBG'
   out.msg<2> = prog.id
   out.msg<3> = dtm
   out.msg<4> = line
   out.msg<5> = sub.ref
   out.msg<6> = event
   out.msg<7> = @userno

   * Process commands from client side of link

   loop
      * Send outgoing message to client side

      id = 'D.':debugger.uid
      recordlocku dbg.store, id
      write out.msg to dbg.store, id
      wake debugger.uid

      * Get incoming message

      id = 'DR.':debugger.uid
      loop
         readu in.msg from dbg.store, id then exit
         release dbg.store, id
         pause
      repeat
      delete dbg.store, id

      msg.type = in.msg<1>
      begin case
         case msg.type = 'ATVAR'
            s = atvar(in.msg<2>)
            out.msg = 'ATVAR'
            out.msg<2> = status()
            out.msg<3> = s

         case msg.type = 'BRK'
            breakpoint in.msg<2>, in.msg<3>
            out.msg = 'BRK'
            out.msg<2> = status()

         case msg.type = 'DBG'
            exit

         case msg.type = 'INFO'
            s = debug.info(in.msg<2>,in.msg<3>)
            out.msg = 'INFO'
            out.msg<2> = status()          
            out.msg<3> = s

         case msg.type = 'SET'
            debug.set in.msg<2>, in.msg<3> to field(in.msg, @fm, 4, 99999)
            out.msg = 'SET'
            out.msg<2> = status()

         case msg.type = 'STOP'
            stop

         case msg.type = 'WATCH'
            watch in.msg<2>, in.msg<3>
            out.msg = 'WATCH'
            out.msg<2> = status()
      end case
   repeat

   return

cannot.debug:
   if store.why = '' then release dbg.store      ;* store.why is set by the call above, before any jump here
   void kernel(K$SUPPRESS.COMO,@false)
   * 17 Oct 26 (QM4 Fixes 513): a process that has an exception handler for it gets SYS.PROGRAM.NO_PDEBUG, the message as
   * its data, and the phantom goes on; without one the phantom ends as it always did.
   if caught('SYS.PROGRAM.NO_PDEBUG', 3) then throw 'SYS.PROGRAM.NO_PDEBUG', sysmsg(6727)
   stop sysmsg(6727) ;* Phantom debugger not active
end

* END-CODE
