$internal

subroutine $pdbg(prog.id, dtm, line, sub.ref, event)
$catalog $PDBG

$flags debugger

$include keys.h
$include debug.h
$include syscom.h

$include int$keys.h

deffun atvar(name) calling "!atvar"

   if not(debug.initialised) then
      * There should (hopefully) be a user sitting in PDEBUG waiting to
      * pick up this connection. If so, there will be a DR.xxx record
      * in the user's private store (!pdbg_store, not $IPC) where xxx is
      * the account name. This record will
      * contain the PDEBUG process user number which will be used for
      * subsequent parts of the conversation so that a second user could
      * start a debugging session.

      * 13 Nov 26 Windows port - RELEASE_1.1 253(b): run.in's debugged child (sd -RUNIN, the SD service's process) talks to the
      * administrator's session through the run's own store, which the service made for this logon and administrators alone, and
      * the administrator's START record there is DR.START.  Any other process uses its user's private store as before.
      runin.info = kernel(K$RUNIN.CHILD, 0)
      if runin.info # '' then
         store.why = ''
         openpath runin.info<2> to dbg.store else
            store.why = 'open'
            goto cannot.debug
         end
         mark.mapping dbg.store, off
         id = 'DR.START'
         * The administrator's session writes it when the service has answered, which may be after this process reached here:
         * up to ten seconds
         runin.try = 0
         loop
            readv runin.x from dbg.store, id, 0 then exit
            runin.try += 1
         until runin.try >= 40
            nap 250
         repeat
      end else
         call !pdbg_store(dbg.store, store.why)
         if store.why # '' then goto cannot.debug

         id = 'DR.':@who:'!':@logname
      end
      readu in.msg from dbg.store, id else goto cannot.debug
      if in.msg<1> # 'START' then goto cannot.debug
      debugger.uid = in.msg<2>
      if kernel(K$USERS, debugger.uid) = '' then
         delete dbg.store, id      ;* PDEBUG has gone and left its record: nobody is waiting
         goto cannot.debug
      end
      delete dbg.store, id

      id = 'D.':debugger.uid
      recordlocku dbg.store, id
      delete dbg.store, id

      debug.initialised = @true
   end

   * Send debug line information

   out.msg = 'DBG'
   out.msg<2> = prog.id
   out.msg<3> = dtm
   out.msg<4> = line
   out.msg<5> = sub.ref
   out.msg<6> = event
   out.msg<7> = @userno

   * Process commands from client side of link

   loop
      * Send outgoing message to client side

      id = 'D.':debugger.uid
      recordlocku dbg.store, id
      write out.msg to dbg.store, id
      wake debugger.uid

      * Get incoming message

      id = 'DR.':debugger.uid
      loop
         readu in.msg from dbg.store, id then exit
         release dbg.store, id
         pause
      repeat
      delete dbg.store, id

      msg.type = in.msg<1>
      begin case
         case msg.type = 'ATVAR'
            s = atvar(in.msg<2>)
            out.msg = 'ATVAR'
            out.msg<2> = status()
            out.msg<3> = s

         case msg.type = 'BRK'
            breakpoint in.msg<2>, in.msg<3>
            out.msg = 'BRK'
            out.msg<2> = status()

         case msg.type = 'DBG'
            exit

         case msg.type = 'INFO'
            s = debug.info(in.msg<2>,in.msg<3>)
            out.msg = 'INFO'
            out.msg<2> = status()          
            out.msg<3> = s

         case msg.type = 'SET'
            debug.set in.msg<2>, in.msg<3> to field(in.msg, @fm, 4, 99999)
            out.msg = 'SET'
            out.msg<2> = status()

         case msg.type = 'STOP'
            stop

         * 13 Nov 26 Windows port - RELEASE_1.1 253(b): the program's source, read HERE, with this process's reach, for a debugger in
         * another process that must not open the name itself (run.in's: that session is the elevated administrator's).  2 is 0 when
         * the record was read, 3 its date and time, 4 on the record.
         case msg.type = 'SOURCE'
            src.path = debug.info(3, 0)
            out.msg = 'SOURCE'
            out.msg<2> = 1
            n = count(src.path, @ds)
            openpath field(src.path, @ds, 1, n) to src.f then
               read src.text from src.f, field(src.path, @ds, n + 1) then
                  out.msg<2> = 0
                  out.msg<3> = ospath(src.path, OS$DTM)
                  out.msg<4> = src.text
               end
               close src.f
            end
            src.text = ''

         case msg.type = 'WATCH'
            watch in.msg<2>, in.msg<3>
            out.msg = 'WATCH'
            out.msg<2> = status()
      end case
   repeat

   return

cannot.debug:
   if store.why = '' then release dbg.store      ;* store.why is set by the call above, before any jump here
   void kernel(K$SUPPRESS.COMO,@false)
   * 17 Oct 26 (QM4 Fixes 513): a process that has an exception handler for it gets SYS.PROGRAM.NO_PDEBUG, the message as
   * its data, and the phantom goes on; without one the phantom ends as it always did.
   if caught('SYS.PROGRAM.NO_PDEBUG', 3) then throw 'SYS.PROGRAM.NO_PDEBUG', sysmsg(6727)
   stop sysmsg(6727) ;* Phantom debugger not active
end

* END-CODE
