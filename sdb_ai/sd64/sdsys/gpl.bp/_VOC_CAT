$internal
$no.symbols
$no.xref
$recursive

subroutine voc_cat(voc.id, pathname)
$include int$keys.h

   pathname = ""
   saved.status = status()

*  14 Sep 26 - RELEASE_1.1 5 stage 3a.  voc.id arrives lower case - the kernel
*  lowers every call name - but an entry catalogued before that is under the
*  upper-case VOC id, so the upper-case spelling is tried second.
   found = @true
   read rec from @voc,voc.id else
      read rec from @voc,upcase(voc.id) else found = @false
   end

   if found then
      if upcase(rec[1,1]) = "V" then
         if rec<2> = "CS" then pathname = trimb(rec<3>)
         if not(ospath(pathname, OS$EXISTS)) then
            display sysmsg(2030, voc.id, pathname) ;* Cannot load %1 - %2 not found
            pathname = ''
         end
      end
   end

   set.status saved.status
   return
end

* END-CODE
