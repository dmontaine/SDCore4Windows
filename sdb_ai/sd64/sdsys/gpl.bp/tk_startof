* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $tk_startof(word, st)
*     word  the account's register field ACC$START as it is stored: menu, terminal, or blank
*     st    returned: 1 when a session of the account starts at the home screen (the gate is ON), 0 when it starts at the command prompt
*   menu is 1 and terminal is 0.  Blank follows the system's default, the file start.default in the SDSYS directory that the installer writes from its question (Start new
*   sessions at the home screen or at the command prompt?) and set.start.default changes: terminal there is 0, anything else or no file is 1.  The same rule !home_entry
*   applies at sign-on.  It only reads.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine tk_startof(word, st)
$catalog $tk_startof

   st = 1
   w = downcase(trim(word))
   if w = 'terminal' then
      st = 0
      return
   end
   if w = 'menu' then return

   openseq @sdsys : @ds : 'start.default' readonly to df then      ;* READONLY: without it an absent file is created by the open
      readseq line from df then
         if downcase(trim(line)) = 'terminal' then st = 0
      end
      close df
   end else
      if not(unassigned(df)) then close df                         ;* an absent file keeps a lock on the name until the variable is closed (!home_entry, 26 Oct 26)
   end

   return
end

* END-CODE
