* In: fn.  Out: dpath (the path of the dictionary), dref (null when this session may change that dictionary, else the kernel's own reason).  Asked of the kernel, never tried.  The dictionary is
* closed again at once.  The question is about the file that is open, not about its name, so a dictionary that is really the VOC or a program file is judged as that (voc-edit, bp-edit).
dict.access:
   dpath = ''
   dref = ''
   open 'DICT', fn to dv2 then
      dpath = fileinfo(dv2, FL$PATH)
      close dv2
      if not(kernel(K$EDIT.OK, dpath)) then dref = edit_msg(kernel(K$EDIT.KIND, dpath))
   end else
      dref = fn : ' has no dictionary now.'
   end
   return

* ------------------------------------------------------------------------------------------------- try an item on a record

* T: the value an item gives for one record of the data file.  The page writes nothing: the item's compiled form is evaluated with ITYPE(), which is what the query processor does (so an item that calls a subroutine of the account runs it).
do.test:
   if nis < 1 then return
   iid = iids<ishown<ci>>
   rec = ''
   open 'DICT', fn to dv then
      read rec from dv, iid else rec = ''
      close dv
   end
   if rec = '' then
      msg = iid : ' is not in the dictionary now (F5 reads it again)'
      return
   end
   gosub classify.item
   if index(' D I ', ' ' : ty : ' ', 1) = 0 then
      msg = 'only D and I items give a value for a record; ' : iid : ' is of type ' : ty
      return
   end
   needs.obj = (ty = 'I')
   if needs.obj and (rec<DICT.SYS.INFO> = '' or rec<DICT.ITYPE.OBJECT> = '') then
      msg = iid : ' has not been compiled yet: C compiles it, then T can try it'
      return
   end
   * S.88: the record is picked from the file's own list (read only, no lock), not typed; the picker puts the screen back under it
   rid = ''
   pnew = ''
   call $tk_pickrec(ctx, 'record', fn, rid, pres, pnew)
   if pres # 'ok' then
      msg = 'nothing tried'
      return
   end
   rid = trim(rid)
   if rid = '' or len(rid) > 200 then
      msg = 'give the id of a record'
      return
   end
   lastrec = rid
   drec = ''
   got.rec = 0
   open fn to df then
      read drec from df, rid then got.rec = 1 else got.rec = 0
      close df
   end
   if not(got.rec) then
      msg = 'there is no record ' : rid : ' in ' : fn
      return
   end
   @id = rid
   @record = drec
   val = ''
   failed = ''
   try
      val = itype(rec)
   catch sys
      failed = @exception.data
   end
   if failed # '' then
      msg = iid : ' could not be evaluated: ' : failed
      return
   end
   body = ''
   body<-1> = iid : ' (' : ty : ') on the record ' : rid : ' of ' : fn : ':'
   body<-1> = ''
   nv = dcount(val, @vm)
   if val = '' then nv = 0
   raw = ''
   for vq = 1 to nv
      one = val<1, vq>
      one = change(one, @sm, ' \ ')
      raw := (if vq = 1 then '' else ' | ') : one
   next vq
   ct = raw
   ct = change(ct, @fm, ' / ')
   gosub clean.text
   raw = ct[1, 1500]
   if nv = 0 then
      body<-1> = 'The value is empty.'
   end else
      body<-1> = 'The value' : (if nv > 1 then ' (' : nv : ' values, between bars)' else '') : ':'
      call $tk_wrap(raw, 100, pieces)
      for pq = 1 to dcount(pieces, @fm)
         if pq <= 8 then body<-1> = '  ' : pieces<pq>
      next pq
   end
   * the value as a query prints it: the conversion first, then the format, when the format is one the page can read (a text format wraps lines and is not shown)
   fs = ft2
   fw = '' ; fj = ''
   if fs # '' then gosub describe.format
   fmt.ok = (fs # '' and fw # '' and fj # '' and index('LRCU', fj, 1) > 0)
   if nv > 0 and (ty = 'D' or ty = 'I') and (cv # '' or fmt.ok) then
      body<-1> = ''
      body<-1> = 'As a query prints it' : (if cv # '' then ' (converted with ' : cv : ')' else '') : (if fmt.ok then ' (format ' : fs : ')' else '') : ', between bars:'
      for vq = 1 to nv
         one = val<1, vq>
         one = change(one, @sm, ' \ ')
         shown.v = one
         try
            if cv # '' then shown.v = oconv(one, cv)
            if fmt.ok then shown.v = fmt(shown.v, fs)
         catch sys
            shown.v = '(' : @exception.data : ')'
         end
         ct = shown.v ; gosub clean.text
         if vq <= 8 then body<-1> = '  |' : ct[1, 96] : '|'
      next vq
   end
   screen msgbox body title 'Try an item' buttons '&Close' default 1
   msg = iid : ' tried on ' : rid
   gosub draw.all
   return

* ------------------------------------------------------------------------------------------------- a new item

* N: the id, then the terminal goes to the IDE on a NEW item, which it shows as the dictionary form (S.90 stage 3, 1 Nov 26).  The page asks the id and checks it (the same rules as ever: lower
* case, a plain word that no VOC keyword is, not taken, and the file's name a word the page may give to a command); the type, the fields, their checks, the write, the dict-edit gate and the
* overwrite question are the IDE's and the form's.  THE PAGE WRITES NOTHING.
do.new:
   atl = 'New item'
   aq = 'Id of the new item (a-z, 0-9, dot, dash and underscore)'
   adef = ai.arg                                                 ;* S.97 stage 4: the id the AI proposed, offered here and checked as a typed one
   aw = 40
   vk = 'id'
   vopt = 0
   gosub ask.valid
   if not(askok) then
      msg = 'nothing written'
      return
   end
   nid = askv
   cw = fn
   gosub check.word
   if not(okname) then
      msg = 'this file name is not given to a command by the page (a character it does not pass, or an SD keyword): type  ide dict ' : fn : ' ' : nid : '  at the prompt'
      return
   end
   sent = 'ide dict ' : fn : ' ' : nid
   keep = nid
   gosub hand.over
   return

* The answers to a question until one passes the test named by vk, or the person cancels.  In: aq, adef, aw, atl, vk, vlo, vhi, vopt (1 when an empty answer is allowed).  Out: askok, askv
ask.valid:
   askok = 0
   etxt = ''
   loop
      screen ask aq : (if etxt = '' then '' else '   <-  ' : etxt) width aw value adef title atl returning askv then got = 1 else got = 0
      if not(got) then return
      askv = trim(askv)
      gosub test.answer
      if vok then
         askok = 1
         return
      end
      adef = askv
   repeat
   return

* In: askv, vk, vlo, vhi, vopt.  Out: vok, etxt (what to say when the answer is no good); askv may be put in its normal form
test.answer:
   vok = 1
   etxt = ''
   if askv = '' then
      if not(vopt) then
         vok = 0
         etxt = 'an answer is needed'
      end
      return
   end
   begin case
      case vk = 'id'
         askv = downcase(askv)
         cw = askv
         gosub check.word
         vok = okname
         etxt = 'a-z, 0-9, dot, dash, underscore only, starting with a letter or a digit, and not an SD keyword'
*        26 Oct 26 (review, low): '.', '..' and an id that starts with a dash or a dot are read as options or directories by some verbs: a new id starts with a letter or a digit
         if vok then
            if index('abcdefghijklmnopqrstuvwxyz0123456789', askv[1, 1], 1) = 0 then vok = 0
         end
         if vok then
            for xq = 1 to ni
               if upcase(iids<xq>) = upcase(askv) then vok = 0
            next xq
            if not(vok) then etxt = 'that id is taken'
         end
   end case
   return

* ------------------------------------------------------------------------------------------------- the indices

* N: an index on an item of the dictionary, picked from the list; CREATE.INDEX defines it and, when that worked, BUILD.INDEX builds it (one box, the second command in its text)
do.newindex:
   cand = ''
   cdef = 1
   for q = 1 to ni
      ma = imeta<q>
      if index(' D I ', ' ' : ma<1, 1> : ' ', 1) > 0 then
         cw = iids<q>
         gosub check.word
         if okname then
            cand<-1> = iids<q>
            if iids<q> = pre.item then cdef = dcount(cand, @fm)
         end
      end
   next q
   if cand = '' then
      msg = 'the dictionary has no data or I item with an id the page can give to a command: type create.index ' : fn : ' and the item at the prompt, then build.index'
      return
   end
   pk = ''
   cand.v = convert(@fm, @vm, cand)
   screen pick cand.v title 'Index which item?' size 40,16 default cdef returning pk else pk = ''
   iid = ''
   if pk # '' and num(pk) then
      if pk >= 1 and pk <= dcount(cand, @fm) then iid = cand<pk>
   end
   if iid = '' then
      msg = 'nothing made'
      return
   end
   for q = 1 to nx
      if upcase(xnames<q>) = upcase(iid) then
         msg = iid : ' already has an index (' : xnames<q> : ')'
         return
      end
   next q
   cw = fn
   gosub check.word
   if not(okname) then
      msg = 'this file name is not given to a command by the page (a character it does not pass, or an SD keyword): type  create.index ' : fn : ' ' : iid : '  and build.index ' : fn : ' ' : iid : '  at the prompt'
      return
   end
   sent = 'create.index ' : fn : ' ' : iid
   lines = ''
   lines<-1> = 'Defines an index on ' : iid : ', then runs  build.index ' : fn : ' ' : iid : '  to build it from the records now.  An index that is not built finds nothing.'
   lines<-1> = 'The build needs the file to itself: if another session has it open the verb says so, the index stays defined and B builds it later.'
   call $tk_confirm(sent, lines, '', res, cmsg)
   if res # 'run' then
      msg = cmsg
      return
   end
   gosub run.sent
   if rerr = '' and stat = 0 then
      sent = 'build.index ' : fn : ' ' : iid
      gosub run.sent
   end
   gosub read.indices
   for q = 1 to nx
      if upcase(xnames<q>) = upcase(iid) then cx = q
   next q
   gosub draw.all
   return

