*
* START-HISTORY:
* 18 Oct 26 Windows port - from Linux 1e23a00 (12 Oct 26): New.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   SCREEN FRAME f, id {AT x,y} {SIZE w,h} {TITLE t}
*
*   is compiled into
*
*   call !screen_frame(f, id, x, y, w, h, title, ret, status)
*
*     f id     the form and the widget's name in it (as SCREEN LABEL)
*     x y      the top left corner from the form's top left corner, default 1,1
*     w h      its size, border included, default 10 by 3
*     title    shown in its top border
*     status   0 added; 1 not (ELSE)
*
*   Widgets added after a frame are drawn over it; the frame draws its border only, so what is
*   inside it is the widgets' (and the form's blank).
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_frame(f, id, ax, ay, sw, sh, title, ret, status)
$catalog !screen_frame

   ret = ''
   status = 1
   w = collection()
   w{'id'} = id
   w{'type'} = 'frame'
   w{'focusable'} = 0
   w{'title'} = title
   x = 1
   y = 1
   fw = 10
   fh = 3
   if ax # '' then x = ax + 0
   if ay # '' then y = ay + 0
   if sw # '' then fw = sw + 0
   if sh # '' then fh = sh + 0
   w{'x'} = x
   w{'y'} = y
   w{'w'} = fw
   w{'h'} = fh
   call $sl_wadd(f, w, ok)
   if ok then status = 0

   return
end

* END-CODE
