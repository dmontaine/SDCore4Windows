* 22 Oct 26 dm  The letter marked with & is drawn in the hotkey style while the button does not have the focus (apos; S.75 TK-0.12).
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $sl_button(op, w, scr, key, ret)      the widget contract; w is a collection (see $sl_label)
*
*   Elements:  id, text (an & puts the letter after it first as the button's key), x y, ax ay, default
*   (1: Return in any other widget of the form presses this one), cancel (1: pressing it, like Esc,
*   ends the form with ELSE).
*
*     init    w = the width of "[ text ]", h = 1
*     draw    [ text ], in reverse video while it has the focus
*     focus   key = 1 gives it the focus (draws), key = 0 takes it away (draws)
*     key     Return or the space bar presses it: ret<1> 'done', ret<2> its id.  Anything else is
*             'unhandled' with the key (Tab, the arrows ...) for the form to act on.
*     close   nothing to undo
*
*   The mnemonic is w{'mn'} (the letter, upper case) for the form to match a typed letter against.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_button(op, w, scr, key, ret)
$catalog $sl_button

$include sl.h

   ret = ''

   begin case
      case op = 'init'
         w{'type'} = 'button'
         w{'focusable'} = 1
         t = w{'text'}
         p = index(t, '&', 1)
         w{'amn'} = ''
         w{'apos'} = 0
         if p and p < len(t) then
            w{'mn'} = upcase(t[p + 1, 1])
            w{'amn'} = w{'mn'}                  ;* only a letter marked with & is also an Alt-letter
            w{'apos'} = p                       ;* and is the p-th cell of the label once the & is out: paint underlines it (the plain mnemonic is not drawn)
            t = t[1, p - 1] : t[p + 1, 99999]
         end else
            w{'mn'} = upcase(t[1, 1])
         end
         w{'label'} = t
         w{'w'} = len(t) + 4
         w{'h'} = 1

      case op = 'draw'
         gosub paint

      case op = 'focus'
         w{'focused'} = if key then 1 else 0
         gosub paint

      case op = 'key'
         if key = 'enter' or key = ' ' then
            ret = 'done' : @fm : w{'id'}
         end else
            ret = 'unhandled' : @fm : key
         end

      case op = 'mouse'
         * a click on the button presses it (key is the event: kind, button, x, y, mods; the form sends only left presses)
         if key<1> = 'press' then
            ret = 'done' : @fm : w{'id'}
         end else
            ret = 'handled'
         end
   end case

   return

paint:
   call $sl_attr('window', code)
   if w{'ccode'} # '' then code = w{'ccode'}
   if w{'focused'} then call $sl_attr('highlight', code)
   rowtext = '[ ' : w{'label'} : ' ]'
   cells = str(code, len(rowtext))
   * the marked letter of the label, in the hotkey style: not while the button has the focus, not when it is disabled.  The label starts after "[ ".
   if not(w{'focused'}) and w{'disabled'} + 0 = 0 and w{'apos'} + 0 > 0 and w{'apos'} + 0 <= len(w{'label'}) then
      call $sl_attr('hotkey', hcode)
      cells[w{'apos'} + 2, 1] = hcode
   end
   call $sl_put(scr, w{'ax'} + 0, w{'ay'} + 0, rowtext, cells)
   if w{'focused'} then call $sl_curat(w{'ax'} + 2, w{'ay'} + 0)
   return
end

* END-CODE
