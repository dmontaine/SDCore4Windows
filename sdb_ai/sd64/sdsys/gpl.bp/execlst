* START-DESCRIPTION:
*
*    EXECUTE.LIST command1 {; command2 {; command3 ...}}
*
* Runs the commands for each id of the default select list (list 0), in order.  A pair of empty round brackets in a command is
* replaced by the id.  The ids are all taken out of the list first, so a command that uses list 0 does not take ids from the
* loop.  Commands are separated by semicolons.  With no active list nothing is run.
*
*    SELECT VOC WITH TYPE = 'F'
*    EXECUTE.LIST ANALYSE.FILE () ; PAUSE
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $execute.list
$catalog $execlst

$include err.h

   @system.return.code = -ER$ARGS      ;* Preset for command format errors

   * What follows the verb: the sentence without its first word
   text = trim(@sentence)
   p = index(text, ' ', 1)
   if p = 0 then stop sysmsg(12285)  ;* A command is needed after EXECUTE.LIST
   text = trimf(text[p + 1, 99999])

   cmds = ''
   n = dcount(text, ';')
   for i = 1 to n
      c = trim(field(text, ';', i))
      if c # '' then cmds<-1> = c
   next i
   if cmds = '' then stop sysmsg(12285)

   * Take every id out of list 0 before the first command runs
   ids = ''
   loop
      readnext id else exit
      ids<-1> = id
   repeat

   @system.return.code = 0
   for k = 1 to dcount(ids, @fm)
      id = ids<k>
      for i = 1 to dcount(cmds, @fm)
         execute change(cmds<i>, '()', id)
      next i
   next k

   return
end

* END-CODE
