* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $sl_wadd(f, w, ok)
*
*     f    the form: a data collection ($sl_form)
*     w    the widget, a collection whose own init has run
*     ok   1 if it was added; 0 if f is not a form, the widget has no id (or one with a / or a * in it:
*          SCREEN VALUES names an element of a collection by it), or the form already has a widget
*          of that id (nothing is changed)
*
*   The widget is put at the end of the form's array of widgets, so the focus ring goes round them in
*   the order they were added and the last one added is drawn last.  If SCREEN PAGE has named a page
*   (f{'curpage'}) the widget is given it (w{'page'}): the form shows the widget only while the chosen tab
*   of its tab strip is that page.  If SCREEN IN has named a container (f{'curparent'}) the widget is put inside it.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_wadd(f, w, ok)
$catalog $sl_wadd

   ok = 0
   if jtype(f) # 'collection' then return
   if w{'id'} = '' then return
   if index(w{'id'}, '/', 1) or index(w{'id'}, '*', 1) then return    ;* a / is a path in c{id}, a * a wildcard

   call $sl_form('find', f, '', w{'id'}, n)
   if n then return                           ;* a second widget of the same id

   if jtype(f{'widgets'}) # 'array' then f{'widgets'} = mat()
   n = inmat(f{'widgets'}) + 1
   if f{'curpage'} + 0 > 0 then w{'page'} = f{'curpage'} + 0      ;* SCREEN PAGE: the widget belongs to a tab's page
   if f{'curparent'} # '' then
      * SCREEN IN: the widget is inside a container, which must already be in the form (it comes first in the array)
      call $sl_form('find', f, '', f{'curparent'}, pn)
      if pn > 0 then
         pw = f{'widgets', pn}
         if pw{'type'} = 'container' or pw{'type'} = 'viewport' then
            w{'parent'} = pw{'id'}
            w{'pn'} = pn
         end
      end
   end
   f{'widgets', n} = w
   ok = 1

   return
end

* END-CODE
