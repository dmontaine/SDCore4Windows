      lines<-1> = 'Nothing is allowed as delivered: such a session is refused, and the refusal is in the audit trail.'
      lines<-1> = ''
      lines<-1> = 'Only a paragraph or a sentence can be allowed, and it takes no arguments, so a listed name cannot be turned into another command.'
      lines<-1> = 'The same test is made each time the command is run; a name whose VOC record has gone or changed type is refused then.'
      lines<-1> = 'This page does not make that schedule: it is a Task Scheduler task of the account' : "'s Windows account.  J shows the administrator's own jobs."
