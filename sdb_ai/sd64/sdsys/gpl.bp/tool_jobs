* Name 20, schedule 18, command 21, next run 30, last run the rest (130 columns at 140 by 43)
draw.jobs:
   tw = j.w - 8
   ex = j.w - 138
   screen text fmt('Job', '20L') : fmt('Schedule', '18L') : fmt('Command', '21L') : fmt('Next run', '30L') : 'Last run' at j.x + 2,j.y + 1 attr 'header' width tw
   for r = 1 to JVIS
      k = jtop + r - 1
      s = ''
      if k <= jn then
         s = fmt(jnm<k>[1, 19], '20L')
         if jbad<k> # '' then
            s := 'damaged: ' : jbad<k>
         end else
            s := fmt(jsch<k>[1, 17], '18L') : fmt(jcmd<k>[1, 20], '21L') : fmt(jnext<k>[1, 29], '30L') : jlast<k>[1, 41 + ex]
         end
      end
      screen text s at j.x + 2,j.y + 1 + r attr (if k = ji and k <= jn then 'highlight' else 'normal') width tw
