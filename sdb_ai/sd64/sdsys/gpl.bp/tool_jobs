* ------------------------------------------------------------------------------------------------- keys and mouse

on.key:
   msg = ''
   if view = 2 then
      gosub jobs.key
      return
   end
   begin case
      case nm = 'up'
         if pane = 1 and ai > 1 then
            ai -= 1
            gosub new.account
         end
         if pane = 2 and ci > 1 then
            ci -= 1
            gosub redraw
         end
      case nm = 'down'
         if pane = 1 and ai < an then
            ai += 1
            gosub new.account
         end
         if pane = 2 and ci < cn then
            ci += 1
            gosub redraw
         end
      case nm = '/'                         ;* S.186: the next account (or command, in Commands) whose name holds the text typed ($tk_findrow)
         call $tk_findrow((if pane = 1 then anm else cnm), (if pane = 1 then ai else ci), find.last, fpos)
         if fpos < 0 then msg = sysmsg(15045, find.last)
         if fpos > 0 and pane = 1 then
            ai = fpos
            gosub new.account
         end
         if fpos > 0 and pane = 2 then
            ci = fpos
            gosub redraw
         end
      case (nm = 'pgup' or nm = 'pgdn') and not(outopen)
         stp = (if nm = 'pgup' then 0 - VIS else VIS)
         if pane = 1 and an > 0 then
            ai = ai + stp
            if ai < 1 then ai = 1
            if ai > an then ai = an
            gosub new.account
         end
         if pane = 2 and cn > 0 then
            ci = ci + stp
            if ci < 1 then ci = 1
            if ci > cn then ci = cn
            gosub redraw
         end
      case nm = 'right' or nm = 'left'
         pane = (if pane = 1 then 2 else 1)
         gosub redraw
      case nm = 'enter' or nm = ' '
         if pane = 1 then
            pane = 2
            gosub redraw
         end else
            gosub change
         end
      case nm = 'j'
         gosub switch.view
      case nm = 'f1' or nm = '?'
         gosub help.here
      case nm = 'ctrl-t'                    ;* S.179: the theme, kept for the person - the same on every page ($tk_std)
         call $tk_std('theme', ctx, keys, '', std.r)
         if std.r<1> then gosub draw.all
         msg = std.r<2>
      case nm = 'act:std.mouse'             ;* S.186: View > Mouse, the same on every page ($tk_std)
         call $tk_std('mouse', ctx, keys, '', std.r)
         msg = std.r<2>
      case nm = 'ctrl-k'                    ;* S.179: the keys of this page, in a box
         call $tk_std('keylist', ctx, keys, pnames<pane>, std.r)
      case nm = 'f5'
         gosub read.all
         gosub draw.all
         msg = 'read the lists again'
      case nm = 'f6' or nm = 'shift-f6' or nm = 'act:ai'
         call $tk_aipage('ring', ctx, keys, pane, nm : @fm : 2, ap)         ;* S.176: F6 / Shift-F6 go round the two boxes and the AI line; AI > Ask the AI goes to the line
         if ap<1> > 0 and ap<1> # pane then
            pane = ap<1>
            gosub redraw
         end
         msg = ap<2>
      case nm = 'ctrl-q'
         done = 1
      case nm = 'ctrl-o'
         gosub toggle.out
      case nm = 'esc'
         if outopen then gosub toggle.out
      case (nm = 'pgup' or nm = 'pgdn') and outopen
         call $tk_out('key', ctx, nm, '', oc)
         call $tk_out('draw', ctx, 'output', '', oc)
   end case
   return

* The keys of the Jobs view
jobs.key:
   begin case
      case nm = 'up'
         if ji > 1 then
            ji -= 1
            gosub redraw
         end
      case nm = 'down'
         if ji < jn then
            ji += 1
            gosub redraw
         end
      case nm = '/'                         ;* S.186: the next job whose name holds the text typed ($tk_findrow)
         call $tk_findrow(jnm, ji, find.last, fpos)
         if fpos < 0 then msg = sysmsg(15045, find.last)
         if fpos > 0 then
            ji = fpos
            gosub redraw
         end
      case (nm = 'pgup' or nm = 'pgdn') and not(outopen)
         if jn > 0 then
            ji = ji + (if nm = 'pgup' then 0 - JVIS else JVIS)
            if ji < 1 then ji = 1
            if ji > jn then ji = jn
            gosub redraw
         end
      case nm = 'a'
         gosub switch.view
      case nm = 'n'
         gosub job.new
      case nm = 'c' or nm = 'enter' or nm = ' '
         gosub job.change
      case nm = 'd'
         gosub job.delete
      case nm = 'r'
         gosub job.run
      case nm = 'f1' or nm = '?'
         gosub help.here
      case nm = 'ctrl-t'                    ;* S.179: the theme, as in the page's other view ($tk_std)
         call $tk_std('theme', ctx, keys, '', std.r)
         if std.r<1> then gosub draw.all
         msg = std.r<2>
      case nm = 'act:std.mouse'             ;* S.186: View > Mouse, the same on every page ($tk_std)
         call $tk_std('mouse', ctx, keys, '', std.r)
         msg = std.r<2>
      case nm = 'ctrl-k'                    ;* S.179: the keys of this page, in a box
         call $tk_std('keylist', ctx, keys, pnames<pane>, std.r)
      case nm = 'f5'
         gosub read.jobs
         gosub draw.all
         msg = 'read the jobs again'
      case nm = 'f6' or nm = 'shift-f6' or nm = 'act:ai'
         call $tk_aipage('ring', ctx, keys, 1, nm : @fm : 1, ap)            ;* S.176: the Jobs view is one box: F6 / Shift-F6 go to the AI line and back
         msg = ap<2>
      case nm = 'ctrl-q'
         done = 1
      case nm = 'ctrl-o'
         gosub toggle.out
      case nm = 'esc'
         if outopen then gosub toggle.out
      case (nm = 'pgup' or nm = 'pgdn') and outopen
         call $tk_out('key', ctx, nm, '', oc)
         call $tk_out('draw', ctx, 'output', '', oc)
   end case
   return

* Another account selected: its commands are read and the box is drawn again under its new title
new.account:
   ci = 1
   ctop = 1
   cn = 0
   gosub read.commands
   gosub draw.all
   return

redraw:
   gosub keep.tops
   if view = 2 then
      gosub draw.jobs
   end else
      gosub draw.accounts
      gosub draw.commands
   end
   gosub draw.effect
   return

on.mouse:
   screen mouse returning mev else mev = ''
   if mev = '' then return
   mr = ''
   call $tk_menubar('click', ctx, keys, pnames<pane>, mev, '', mr)
   if mr<1> # '' then
      nm = mr<4>
      if nm # '' then gosub on.key
      return
   end
   call $tk_aipage('mouse', ctx, keys, pnames<pane>, mev, ap)
   if ap # '' then
      msg = ap
      return
   end
   if view = 2 then
      call $tk_help('hit', mev, j.x + j.w - 5, j.y + 1, hit.jobs)
      if hit.jobs then
         gosub help.here
         return
      end
      if mev<1> = 'press' and mev<2> = 1 then
         mx = mev<3>
         my = mev<4>
         if mx >= j.x + 1 and mx <= j.x + j.w - 2 and my >= j.y + 2 and my <= j.y + 1 + JVIS then
            k = jtop + my - j.y - 2
            if k <= jn then ji = k
            gosub redraw
         end
      end
      return
   end
   call $tk_help('hit', mev, a.x + a.w - 5, a.y + 1, hit.accounts)
   call $tk_help('hit', mev, c.x + c.w - 5, c.y + 1, hit.commands)
   if hit.accounts or hit.commands then
      pane = (if hit.accounts then 1 else 2)
      gosub redraw
      gosub help.here
      return
   end
   if mev<1> = 'press' and mev<2> = 1 then
      mx = mev<3>
      my = mev<4>
      begin case
         case mx >= a.x + 1 and mx <= a.x + a.w - 2 and my >= a.y + 2 and my <= a.y + 1 + VIS
            k = atop + my - a.y - 2
            pane = 1
            if k <= an and k # ai then
               ai = k
               gosub new.account
            end else
               gosub redraw
            end
         case mx >= c.x + 1 and mx <= c.x + c.w - 2 and my >= c.y + 2 and my <= c.y + 1 + VIS
            k = ctop + my - c.y - 2
            if k <= cn then ci = k
            pane = 2
            gosub redraw
      end case
   end
   return

help.here:
   begin case
      case view = 2
         hkey = 'tool.jobs.jobs'
      case pane = 1
         hkey = 'tool.jobs.accounts'
      case 1
         hkey = 'tool.jobs.commands'
   end case
   call $tk_help('box', hkey, hm, 0, 0)
   if hm # '' then msg = hm
   return

* ------------------------------------------------------------------------------------------------- changing something: the command, its effect, Run or Cancel, then the answer

change:
   if an = 0 or cn = 0 then return
   acct = anm<ai>
   cmd = cnm<ci>
   on.now = con<ci>
   act = (if on.now then 'remove' else 'add')
   if convert(PLAIN, '', acct) # '' or convert(PLAIN, '', cmd) # '' then
      msg = 'This name cannot be sent from the page: at the prompt, set.batch ' : act : ' ' : acct : ' ' : cmd
      return
   end
   sent = 'set.batch ' : act : ' ' : acct : ' ' : cmd
   el = ''
   if on.now then
      el<-1> = "A session started as sd -a" : acct : " '" : cmd : "' will be refused, and the refusal written to the audit trail."
      el<-1> = 'A scheduled job that runs it will fail from its next run.  The paragraph or sentence itself is not changed.'
   end else
      el<-1> = "A session started as sd " : cmd : " in " : acct : ", by a Task Scheduler task of the account's Windows account, will run " : cmd : ' and nothing else.'
      el<-1> = "It runs with the account's own rights.  Whoever can change the " : ctype<ci> : ' record ' : cmd : ' in that VOC changes what the job does.'
   end
   el<-1> = 'It takes effect at the next such session.'
   call $tk_confirm(sent, el, '', res, cmsg)
   if res = 'run' then
      gosub run.sent
      gosub read.all
      gosub draw.all
   end else
      msg = cmsg
   end
   return

* sent in: $tk_run, then what it answered on the status line and in the output pane (the last line the command printed, which is the helper's own result line)
run.sent:
   call $tk_run(allow, sent, out, st, err)
   if err # '' then
      msg = err
      call $tk_out('add', ctx, 'refuse', sent : '  ' : err, '')
      return
   end
   out = change(change(out, char(13) : char(10), @fm), char(13), '')
   said = ''
   for oi = dcount(out, @fm) to 1 step -1
      if said = '' and trim(out<oi>) # '' then said = trim(out<oi>)
   next oi
   msg = (if said # '' then said[1, 130] else 'ran, status ' : st)
   okind = (if st = 0 then 'ok' else 'refuse')
   otext = sent : '  ' : trim(change(out, @fm, ' '))
   call $tk_out('add', ctx, okind, otext, '')
   return

* ------------------------------------------------------------------------------------------------- the administrator's jobs: N, C, D, R

* N: one form, the name, the job and the schedule; the page checks all three before it shows the box (set.job and the job helper check them again)
job.new:
   if jerr # '' then
      msg = 'the jobs could not be read, so none can be made from here (F5 reads them again)'
      return
   end
   fname = '' ; fjob = 'update-accounts' ; fsch = 'daily 02:30'
   spec = 'New scheduled job' : @fm : '&Next' : @fm : ''
   spec<-1> = 'name' : @vm : 'Name (a-z 0-9 -)' : @vm : 34 : @vm : 32
   spec<-1> = 'job' : @vm : 'Job: backup-all, update-accounts' : @vm : 20 : @vm : 20
   spec<-1> = 'sched' : @vm : 'Schedule: every 15 minutes, hourly, daily 02:30, weekly sun 03:00, monthly 1 04:00' : @vm : 24 : @vm : 24
   fv = fname : @fm : fjob : @fm : fsch
   fmode = 'add'
   gosub job.form
   if not(fok) then return
   gosub job.confirm
   return

* C: the same form for the selected job, its name fixed (a job is renamed by making the new one and deleting the old)
job.change:
   if jn = 0 then
      msg = 'there is no job to change: N makes one'
      return
   end
   fname = jnm<ji>
   jname = fname
   gosub name.ok
   if not(nok) then                                             ;* a damaged file whose name is not a job name: the form could never pass
      msg = 'This file is not a job: neither the page nor set.job can remove it; an administrator removes it from C:\ProgramData\SD\sd-jobs: ' : fname
      return
   end
   spec = 'Change the job ' : fname : @fm : '&Next' : @fm : ''
   spec<-1> = 'job' : @vm : 'Job: backup-all, update-accounts' : @vm : 20 : @vm : 20
   spec<-1> = 'sched' : @vm : 'Schedule: every 15 minutes, hourly, daily 02:30, weekly sun 03:00, monthly 1 04:00' : @vm : 24 : @vm : 24
   fv = (if jbad<ji> = '' then jid<ji> else 'update-accounts') : @fm : (if jbad<ji> = '' then jsch<ji> else 'daily 02:30')
   fmode = 'change'
   gosub job.form
   if not(fok) then return
   gosub job.confirm
   return

* spec, fv, fmode, fname in; fok, fname, fjob, fsch (with hh:mm) out.  The form stays until the answers pass or it is cancelled.
job.form:
   fok = 0
   call $tk_form('open', ctx, spec, fv, fo)
   if fo = 'no' then
      msg = 'the form does not fit this window'
      return
   end
   loop
      call $tk_form('run', ctx, fans, fv, fid)
      if fans # 'ok' then
         call $tk_form('close', ctx, '', '', '')
         msg = sysmsg(12826)                                     ;* nothing was run
         return
      end
      if fmode = 'add' then
         fname = downcase(trim(fv<1>))
         fjob = downcase(trim(fv<2>))
         fsch = downcase(trim(fv<3>))
      end else
         fjob = downcase(trim(fv<1>))
         fsch = downcase(trim(fv<2>))
      end
      fsch = trim(change(fsch, '.', ':'))
      fbad = ''
      fid = ''
      jname = fname
      gosub name.ok
      locate fjob in JOBIDS<1> setting jx else jx = 0
      sch = fsch
      gosub sched.words
      begin case
         case not(nok)
            fbad = 'a job name is 1 to 32 characters: a lower case letter first, then lower case letters, digits and dashes, not ending in a dash' ; fid = 'name'
         case fmode = 'add' and jn > 0 and index(@fm : jnm : @fm, @fm : fname : @fm, 1) > 0
            fbad = 'a job named ' : fname : ' exists: C changes it' ; fid = 'name'
         case jx = 0
            fbad = 'the job is backup-all or update-accounts' ; fid = 'job'
         case sw = ''
            fbad = 'the schedule is every 5|10|15|20|30 minutes, hourly, daily hh:mm, weekly mon..sun hh:mm or monthly 1..28 hh:mm' ; fid = 'sched'
      end case
      if fbad = '' then exit
      call $tk_form('say', ctx, fbad, fid, '')
   repeat
   call $tk_form('close', ctx, '', '', '')
   fok = 1
   return

* The box for N and C: the whole sentence (the time as hh.mm, which set.job reads as hh:mm), the job's command and the schedule in words
job.confirm:
   sent = 'set.job ' : fmode : ' ' : fname : ' ' : fjob : ' ' : change(fsch, ':', '.')
   sch = fsch
   gosub sched.words
   el = ''
   el<-1> = 'The job ' : fname : ' will run ' : JOBCMDS<jx> : ' as the administrator, unattended, ' : sw : " (the machine's time)."
   if fmode = 'change' then
      if jbad<ji> = '' then
         el<-1> = 'It replaces what ' : fname : ' does now: ' : jcmd<ji> : ' ' : jsch<ji> : '.'
      end else
         el<-1> = 'It writes the damaged definition of ' : fname : ' again.'
      end
   end
   el<-1> = 'The job helper writes the definition and the Task Scheduler task; only an administrator can change them.  The command reaches every account.'
   el<-1> = 'A run missed while the machine is off is not made up.'
   call $tk_confirm(sent, el, '', res, cmsg)
   if res = 'run' then
      gosub run.sent
      gosub read.jobs
      if fmode = 'add' then
         locate fname in jnm<1> setting op then ji = op
         gosub keep.tops
      end
      gosub draw.all
   end else
      msg = cmsg
   end
   return

* D: the name is typed in the box (a job that runs unattended goes; nothing asks again)
job.delete:
   if jn = 0 then
      msg = 'there is no job to delete'
      return
   end
   fname = jnm<ji>
   jname = fname
   gosub name.ok
   if not(nok) then
      msg = 'This file is not a job: neither the page nor set.job can remove it; an administrator removes it from C:\ProgramData\SD\sd-jobs: ' : fname
      return
   end
   sent = 'set.job delete ' : fname
   el = ''
   if jbad<ji> = '' then
      sch = jsch<ji>
      gosub sched.words
      el<-1> = 'The job ' : fname : ' stops: its task is removed, then its definition.  It ran ' : jcmd<ji> : ' ' : sw : '.'
   end else
      el<-1> = 'The job ' : fname : ' (damaged) is removed: its task and its definition.'
   end
   el<-1> = 'A run already going is let finish.  Type the name of the job to delete it.'
   call $tk_confirm(sent, el, fname, res, cmsg)
   if res = 'run' then
      gosub run.sent
      gosub read.jobs
      gosub draw.all
   end else
      msg = cmsg
   end
   return

* R: start the job now, exactly as its task's trigger would (set.job run, the helper's job-run); the page does not wait for it
job.run:
   if jn = 0 then
      msg = 'there is no job to run'
      return
   end
   fname = jnm<ji>
   if jbad<ji> # '' then
      msg = 'a damaged job cannot be run: C writes it again, D deletes it'
      return
   end
   jname = fname
   gosub name.ok
   if not(nok) then
      msg = 'This name cannot be sent from the page: at the prompt, set.job run ' : fname
      return
   end
   sent = 'set.job run ' : fname
   el = ''
   el<-1> = 'Starts the job ' : fname : ' now: ' : jcmd<ji> : ', as the administrator, exactly as its schedule would.  Its schedule is not changed.'
   el<-1> = 'The page does not wait for it: F5 shows when it has finished, under Last run.'
   call $tk_confirm(sent, el, '', res, cmsg)
   if res = 'run' then
      gosub run.sent
      gosub read.jobs
      gosub draw.all
   end else
      msg = cmsg
   end
   return

* jname in; nok out: 1 to 32 characters, a lower case letter first, then lower case letters, digits and dashes, not ending in a dash (the helper's rule)
name.ok:
   nok = 0
   if len(jname) < 1 or len(jname) > 32 then return
   if index('abcdefghijklmnopqrstuvwxyz', jname[1, 1], 1) = 0 then return
   if jname[len(jname), 1] = '-' then return
   if convert('abcdefghijklmnopqrstuvwxyz0123456789-', '', jname) # '' then return
   nok = 1
   return

* sch in (hh:mm); sw out: the schedule in words, or null when it is none of the five shapes
sched.words:
   sw = ''
   if convert('abcdefghijklmnopqrstuvwxyz0123456789: ', '', sch) # '' then return
   ns = dcount(sch, ' ')
   s1 = field(sch, ' ', 1)
   s2 = field(sch, ' ', 2)
   s3 = field(sch, ' ', 3)
   begin case
      case s1 = 'every'
         if ns = 3 and s3 = 'minutes' and index(' 5 10 15 20 30 ', ' ' : s2 : ' ', 1) > 0 and s2 # '' then sw = 'every ' : s2 : ' minutes'
      case s1 = 'hourly'
         if ns = 1 then sw = 'every hour, on the hour'
      case s1 = 'daily'
         tm = s2
         gosub time.ok
         if ns = 2 and tok then sw = 'every day at ' : tm
      case s1 = 'weekly'
         tm = s3
         gosub time.ok
         locate s2 in DAYS<1> setting dx else dx = 0
         if ns = 3 and tok and dx > 0 then sw = 'every ' : field('Monday Tuesday Wednesday Thursday Friday Saturday Sunday', ' ', dx) : ' at ' : tm
      case s1 = 'monthly'
         tm = s3
         gosub time.ok
         dd = (if s2 matches '1N' or s2 matches '2N' then s2 else '')
         dok = 0
         if dd # '' then
            if dd[1, 1] # '0' and dd >= 1 and dd <= 28 then dok = 1
         end
         if ns = 3 and tok and dok then sw = 'on day ' : dd : ' of every month at ' : tm
   end case
   return

* tm in; tok out: hh:mm, 00:00 to 23:59
time.ok:
   tok = 0
   if len(tm) # 5 or tm[3, 1] # ':' then return
   hh = tm[1, 2]
   mm = tm[4, 2]
   if not(hh matches '2N') or not(mm matches '2N') then return
   if hh > 23 or mm > 59 then return
   tok = 1
   return

end

