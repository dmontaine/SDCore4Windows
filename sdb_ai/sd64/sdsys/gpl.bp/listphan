* START-DESCRIPTION:
*
*   LIST.PHANTOMS {USER username}
*
* A subset of LISTU: only the phantom processes, with their user number, process id, user name, login time and account.  As in
* LISTU the account is shown for the administrator and for the caller's own phantoms, and left blank for anyone else's.  USER
* shows the phantoms of one user name (the name is case sensitive).  The openQM POOL qualifier is refused: SD has no pools of
* phantoms.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program list.phantoms
$catalog $listphan

$include parser.h
$include err.h
$include int$keys.h
$include keys.h

   @system.return.code = -ER$ARGS      ;* Preset for command format errors
   only.user = ''

   call !parser(parser$reset, 0, @sentence, 0)
   call !parser(parser$get.token, token.type, token, keyword) ;* Verb

   loop
      call !parser(parser$get.token, token.type, token, keyword)
   while token.type # PARSER$END
      begin case
         case upcase(token) = 'USER'
            call !parser(parser$get.token, token.type, only.user, keyword)
            if token.type = PARSER$END or only.user = '' then stop sysmsg(12281) ;* User name required after USER
         case upcase(token) = 'POOL'
            stop sysmsg(12282) ;* SD has no pools of phantom processes
         case 1
            stop sysmsg(2018, token) ;* Unexpected token (xx)
      end case
   repeat

   @system.return.code = 0

   users = kernel(K$USERS, 0)
   * uid VM pid VM ip_addr VM flags VM puid VM username FM...

   see.all = kernel(K$ADMINISTRATOR, -1)
   me = kernel(K$USERNAME, 0)

   print '  User  Pid          Username                          Login time    Account'
   for i = 1 to dcount(users, @fm)
      udata = raise(users<i>)
      flg = udata<K$USERS.FLAGS> + 0
      if not(bitand(flg, USR$PHANTOM)) then continue
      username = udata<K$USERS.UNAME>
      if only.user # '' and username # only.user then continue
      acct = udata<K$USERS.ACCOUNT>
      if not(see.all) and username # me then acct = ''
      login.time = udata<K$USERS.LOGIN>
      print fmt(udata<K$USERS.UID>, '6R') : '  ' :
      print fmt(udata<K$USERS.PID>, '11L') : '  ' :
      print fmt(username, '32L') : '  ' :
      print oconv(idiv(login.time, 86400), 'DDML[,A3]') : ' ' :
      print oconv(rem(login.time, 86400), 'MT') : '  ' :
      print acct
   next i

   return
end

* END-CODE
