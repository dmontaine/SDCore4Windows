* The Recent group (the first group of the top page): the tiles the person started last, newest first, when they have turned it on (View menu) and the administrator has not turned it
* off for the account (SET.TILE account recent off: then nothing is read at all).  What the list keeps is an id: each recent tile is a copy of a tile of THIS table as it is now (a
* tile that is off, or that this page does not offer, is not there), so the list can start nothing the page does not.  rc.on says whether the group is on.
add.recent:
   rc.on = 0
   if index(off.set, ' recent ', 1) then return
   call !home_recent('get', rc.on, rc.ids)
   if not(rc.on) then return
   rc.tiles = ''
   for rk = 1 to dcount(rc.ids, @fm)
      for ri = 1 to nt
         if tl<ri, HT.ID> = rc.ids<rk> and tl<ri, HT.GROUP> > 0 and tl<ri, HT.ACT>[1, 4] = 'cmd:' then
            t = tl<ri>
            t<1, HT.ID> = 'r:' : tl<ri, HT.ID>
            t<1, HT.GROUP> = 1
            t<1, HT.SIZE> = 'n'
            rc.tiles<-1> = t
            exit
         end
      next ri
   next rk
   if rc.tiles = '' then return
   for ri = 1 to nt
      if tl<ri, HT.GROUP> > 0 then tl<ri, HT.GROUP> = tl<ri, HT.GROUP> + 1       ;* every group moves down one place; Recent is the first, in a band of its own before band 1
   next ri
   gr = 'Recent' : @vm : 0 : @vm : 6 : @fm : gr
   tl = rc.tiles : @fm : tl
   nt = dcount(tl, @fm)
   return

* Only the page being shown is kept.  A folder tile (action menu:<name>) whose menu holds no tile is left out first (leaving one out can empty the menu above it); then the groups
* of the menu cur.menu and the tiles of those groups stay, with the header tiles, and the groups are numbered again.
pick.level:
   loop
      dropped = 0
      for pi = nt to 1 step -1
         pa = tl<pi, HT.ACT>
         if pa[1, 5] = 'menu:' then
            pn = 0
            for pj = 1 to nt
               pg = tl<pj, HT.GROUP>
               if pg > 0 then
                  if gr<pg, HG.MENU> = pa[6, 99] then pn += 1
               end
            next pj
            if pn = 0 then
               del tl<pi>
               nt -= 1
               dropped = 1
            end
         end
      next pi
      if dropped = 0 then exit
   repeat
   gmap = ''
   gr2 = ''
   for pk = 1 to dcount(gr, @fm)
      if gr<pk, HG.MENU> = cur.menu then
         gr2<-1> = gr<pk>
         gmap<pk> = dcount(gr2, @fm)
      end
   next pk
   tl2 = ''
   for pi = 1 to nt
      pg = tl<pi, HT.GROUP>
      if pg = 0 then
         tl2<-1> = tl<pi>
      end else
         if gmap<pg> # '' then
            t = tl<pi>
            t<1, HT.GROUP> = gmap<pg>
            tl2<-1> = t
         end
      end
   next pi
   tl = tl2
   gr = gr2
   nt = dcount(tl, @fm)
   return

add.tile:
   added = 0
   if index(off.set, ' ' : id : ' ', 1) then return        ;* turned off by the administrator: not on the page at all
   t = id : @vm : grp : @vm : label : @vm : glyph : @vm : sub : @vm : act : @vm : pal : @vm : size : @vm : pause : @vm : why
   tl<-1> = t
   nt = dcount(tl, @fm)
   added = 1
   return

* A header tile: its place is fixed on the screen (place.header), and it does not scroll
add.header:
   gosub add.tile
   if not(added) then return
   tl<nt, HT.H> = 3
   tl<nt, HT.FIXED> = 1
   return

* The header tiles' places, from the header's rectangle and the tile columns: Switch account and Sign out on the last two columns, Back on the first, all on the header's first
* row and as wide as a tile.  At 140 by 43: 95, 117 and 3 on row 1, 21 wide.
place.header:
   for i = 1 to nt
      if tl<i, HT.FIXED> then
         begin case
            case tl<i, HT.ID> = 'switch'
               tl<i, HT.X> = xcol<ncol - 1>
            case tl<i, HT.ID> = 'signout'
               tl<i, HT.X> = xcol<ncol>
            case 1
               tl<i, HT.X> = xcol<1>                      ;* back
         end case
         tl<i, HT.Y> = hdy
         tl<i, HT.W> = tw.n
      end
   next i
   return

* A style for each palette in use: the colours and the same reversed and bold for the tile that has the focus.  A terminal with no colour (the library says none) gets
* the tiles in boxes, reverse video for the focus: nothing here depends on colour.
alloc.styles:
   colour = 1
   pnames = ''
   pcode = ''
   pfocus = ''
   tile.plain = 'normal'
   tile.focus = 'reverse'
   * 8 Nov 26 (S.172): the near-monochrome themes paper and night have no coloured tiles: every tile is boxed in the theme's window colours and the one with the
   * focus in its highlight, so that all text is the theme's own high-contrast pair
   call $sl_theme('name', '', '', '', '', thn)
   if thn = 'paper' or thn = 'night' then
      colour = 0
      tile.plain = 'window'
      tile.focus = 'highlight'
      return
   end
   for i = 1 to nt
      p = tl<i, HT.PAL>
      locate p in pnames<1> setting k else
         pnames<-1> = p
         gosub palette.colours
         call $sl_theme('slot', pf, pb, '', '', c1)
         call $sl_theme('slot', pf, pb, 'reverse bold', '', c2)
         if c1 = 'none' or c1 = 'full' or c1 = 'bad' or c2 = 'none' or c2 = 'full' or c2 = 'bad' then
            colour = 0                                    ;* one style missing: the whole page is drawn plain, boxed
            c1 = 'normal'
            c2 = 'reverse'
         end
         pcode<-1> = c1
         pfocus<-1> = c2
      end
   next i
   return

* The eight colours of a terminal are all there are: the page's accents are the nearest of them
palette.colours:
   begin case
      case p = 'amber'
         pf = 'black' ; pb = 'brown'
      case p = 'rust'
         pf = 'white' ; pb = 'red'
      case p = 'olive'
         pf = 'black' ; pb = 'green'
      case p = 'plum'
         pf = 'white' ; pb = 'magenta'
      case p = 'blue'
         pf = 'white' ; pb = 'blue'
      case p = 'teal'
         pf = 'black' ; pb = 'cyan'
      case p = 'green'
         pf = 'black' ; pb = 'green'
      case p = 'violet'
         pf = 'white' ; pb = 'magenta'
      case 1
         pf = 'black' ; pb = 'white'                      ;* gray
   end case
   return

* The panel's rows: bands one under another, the groups of a band side by side, the tiles of a group flowing left to right and wrapping.  The panel row 1 is the first
* heading (the panel's first row, 5 at 140 by 43).  ch is the height of the whole page.  The header tiles are placed first.
layout:
   gosub place.header
   nb = 0
   b0 = 1                                                 ;* the first band: 1, or 0 when the Recent group is on the page
   ng = dcount(gr, @fm)
   for k = 1 to ng
      if gr<k, HG.BAND> > nb then nb = gr<k, HG.BAND>
      if gr<k, HG.BAND> < b0 then b0 = gr<k, HG.BAND>
   next k
   gcw = ''                                               ;* the columns each group is given (band.cols)
   gtiles = ''                                            ;* the tiles of each group: a group whose tiles are all off has no heading either
   for k = 1 to ng
      gtiles<k> = 0
   next k
   for i = 1 to nt
      gk = tl<i, HT.GROUP>
      if gk > 0 then gtiles<gk> = gtiles<gk> + 1
   next i
   ys = 1
   for b = b0 to nb
      c0 = 0
      bandend = ys
      gosub band.cols
      for k = 1 to ng
         if gr<k, HG.BAND> = b and gtiles<k> > 0 then
            gcols = gcw<k>
            gr<k, HG.Y> = ys
            gr<k, HG.X> = xcol<c0 + 1>
            cc = 0
            ry = ys + 1
            rowh = 0
            for i = 1 to nt
               if tl<i, HT.GROUP> = k then
                  tw = (if tl<i, HT.SIZE> = 'w' then 2 else 1)
                  th = (if tl<i, HT.SIZE> = 's' then 3 else 5)
                  if cc + tw > gcols then
                     cc = 0
                     ry += rowh + 1
                     rowh = 0
                  end
                  tl<i, HT.X> = xcol<c0 + cc + 1>
                  tl<i, HT.Y> = ry
                  tl<i, HT.W> = tw.n                      ;* a wide tile takes two columns and what is between them
                  if tw = 2 then tl<i, HT.W> = xcol<c0 + cc + 2> + tw.n - xcol<c0 + cc + 1>
                  tl<i, HT.H> = th
                  tl<i, HT.FIXED> = 0
                  cc += tw
                  if th > rowh then rowh = th
               end
            next i
            if ry + rowh > bandend then bandend = ry + rowh
            c0 += gcols
         end
      next k
      if c0 > 0 then ys = bandend + 1                     ;* a band with no group (a sub-menu's groups start at a later band, or all of a band is off) takes no room
   next b
   ch = ys
   if top > ch - ph then top = ch - ph
   if top < 0 then top = 0
   return

* The columns each group of band b is given (gcw<k>): its HG.COLS, and the columns the panel has beyond the band's sum shared among the band's groups by those same numbers -
* all of them to a band's one group, in whole pairs to the groups of a band of several (so that each still starts on the first column of a pair, after the wider gap), what
* is left one (pair) at a time from the first.  A panel of HT.BASECOLS columns or fewer (140 by 43 is six) shares nothing out: every group has exactly its HG.COLS, whichever
* groups of its band have no tiles on (a band of one group with tiles must stay as wide as the page was drawn before the service).
band.cols:
   bsum = 0
   nbg = 0
   for k = 1 to ng
      gcw<k> = gr<k, HG.COLS>
      if gr<k, HG.BAND> = b and gtiles<k> > 0 then
         bsum += gr<k, HG.COLS>
         nbg += 1
      end
   next k
   if bsum < 1 then return
   if ncol <= HT.BASECOLS then return
   unit = 1
   if nbg > 1 then unit = 2
   bx = idiv(ncol - bsum, unit)
   if bx < 1 then return
   given = 0
   for k = 1 to ng
      if gr<k, HG.BAND> = b and gtiles<k> > 0 then
         gadd = idiv(bx * gr<k, HG.COLS>, bsum)
         gcw<k> = gcw<k> + gadd * unit
         given += gadd
      end
   next k
   rest = bx - given
   loop while rest > 0 do
      for k = 1 to ng
         if rest > 0 and gr<k, HG.BAND> = b and gtiles<k> > 0 then
            gcw<k> = gcw<k> + unit
            rest -= 1
         end
      next k
   repeat
   return

* fb: the first tile of a group (the first tile of the page when only the header has any)
find.first:
   fb = 1
   for i = 1 to nt
      if tl<i, HT.GROUP> > 0 then
         fb = i
         exit
      end
   next i
   return

first.focus:
   gosub find.first
   fi = fb
   return

* ------------------------------------------------------------------------------------------------- drawing

draw.all:
   screen clear at 0,py0 size lw,ph
   gosub draw.header
   gosub draw.panel
   ctx<TK.C.BAR> = ''                                     ;* the menu bar is drawn again by the loop's $tk_menubar 'draw' (its menus may have changed with the page)
   if ctx<TK.C.AI> then
      call $tk_ai('draw', ctx, aif, '')
   end else
      screen text '' at 0,hny width lw
      screen text 'arrows move  -  a letter jumps  -  PgDn next group' at hnx + 2,hny attr 'desktop'      ;* S.136: Enter and / are on the key row; each is said once
   end
   return

draw.header:
   screen clear at 0,hdy size xcol<ncol - 1> - 1,3        ;* the left of the header, up to the Switch account tile: the identity moves right of the Back tile and left again
   if is.admin then
      who.line = 'administrator'
   end else
      who.line = @logname : ' @ ' : @who
   end
   screen text fmt(who.line, '60L') at idx,hdy + 1 attr 'bold'
   gosub draw.clock
   for i = 1 to nt
      if tl<i, HT.FIXED> then
         di = i
         gosub draw.tile
      end
   next i
   return

* The date and the time, dim: written again when the minute changes (the key wait is 30 seconds)
draw.clock:
   mm = oconv(time(), 'MT')
   if mm # lastmin then
      lastmin = mm
      wd = downcase(oconv(date(), 'DWA'))
      wd[1, 1] = upcase(wd[1, 1])
      dt = oconv(date(), 'D4DMY[,A3]')
      mo = field(dt, ' ', 2)
      mo = upcase(mo[1, 1]) : downcase(mo[2, 9])
      screen text fmt(wd : ' ' : field(dt, ' ', 1) : ' ' : mo : ' ' : field(dt, ' ', 3) : '  -  ' : mm, '60L') at idx,hdy + 2 attr 'desktop'
   end
   return

* ------------------------------------------------------------------------------------------------- live lines

* A tile may carry one short live line in place of its sub line (plan 13.1).  Only the administrator's page has any: how many accounts there are, how many sessions are
* signed on.  Each is a question the page could ask on its own screen and each only reads.  They are read when the page is built
* (the first time and on F5) and when the key wait runs out (30 seconds); live.chg holds the tiles whose line is not the one it was.
live.read:
   live.chg = ''
   if not(is.admin) then return
   for i = 1 to nt
      lid = tl<i, HT.ID>
      if lid[1, 2] = 'r:' then lid = lid[3, 99]              ;* a recent tile is a copy and shows the live line of the tile it copies
      txt = ''
      begin case
         case lid = 'accounts'
            gosub live.accounts
         case lid = 'sessions'
            gosub live.sessions
      end case
      if txt # tl<i, HT.LIVE> then
         tl<i, HT.LIVE> = txt
         live.chg<-1> = i
      end
   next i
   return

live.accounts:
   n = 0
   openpath @sdsys : @ds : 'accounts' to lf then
      select lf to 9
      loop
         readnext lacc from 9 else exit
         if lacc # 'sdsys' then n += 1
      repeat
      close lf
      txt = n : (if n = 1 then ' account' else ' accounts')
   end
   return

live.sessions:
   call !listu(ludata)
   n = dcount(ludata, @fm)
   txt = n : ' signed on'
   call !sdsysn(sdn, sdids, sdmine, sdtty)                      ;* S.76: SDSYS on a terminal in more than one place is said on the tile (the tile is 19 characters wide)
   if sdn > 1 then txt = n : ' signed, ' : sdn : ' sdsys'
   return

* The key wait ran out: read the lines again and draw only the tiles whose line changed
live.draw:
   gosub live.read
   for k = 1 to dcount(live.chg, @fm)
      di = live.chg<k>
      gosub draw.tile
   next k
   return

draw.panel:
   for k = 1 to ng
      gy = gr<k, HG.Y>
      if gy # '' then
         sy = py0 + gy - top
         if sy >= py0 and sy <= py1 then
            screen text fmt(gr<k, HG.NAME>, '40L') at gr<k, HG.X>,sy attr 'header' width 40
         end
      end
   next k
   for i = 1 to nt
      if tl<i, HT.FIXED> = 0 then
         di = i
         gosub draw.tile
      end
   next i
   gosub draw.scrollbar
   return

* One tile, row by row so that a tile only partly in the panel draws the rows that are
draw.tile:
   tx = tl<di, HT.X>
   tw = tl<di, HT.W>
   th = tl<di, HT.H>
   ty = tl<di, HT.Y>
   if tl<di, HT.FIXED> = 0 then ty = py0 + ty - top
   focused = (di = fi)
   if aif then focused = 0                               ;* the AI line has the focus: no tile does
   p = tl<di, HT.PAL>
   locate p in pnames<1> setting pk else pk = 1
   begin case
      case tl<di, HT.WHY> # ''
         sty = 'disabled'
      case colour and focused
         sty = pfocus<pk>
      case colour
         sty = pcode<pk>
      case focused
         sty = tile.focus
      case 1
         sty = tile.plain
   end case
   for r = 0 to th - 1
      sy = ty + r
      lo = (if tl<di, HT.FIXED> then 0 else py0)
      hi = (if tl<di, HT.FIXED> then lh else py1)
      if sy >= lo and sy <= hi then
         if colour then
            begin case
               case th = 3
                  s = (if r = 1 then '  ' : tl<di, HT.GLYPH> : '  ' : tl<di, HT.LABEL> else '')
               case r = 1
                  s = '  ' : tl<di, HT.GLYPH>
               case r = 3
                  s = '  ' : tl<di, HT.LABEL>
               case r = 4
                  s = '  ' : (if tl<di, HT.WHY> # '' then tl<di, HT.WHY> else (if tl<di, HT.LIVE> # '' then tl<di, HT.LIVE> else tl<di, HT.SUB>))
               case 1
                  s = ''
            end case
         end else
            call $sl_line('h', 0, hc)
            call $sl_line('v', 0, vc)
            begin case
               case r = 0
                  call $sl_line('tl', 0, c1)
                  call $sl_line('tr', 0, c2)
                  s = c1 : str(hc, tw - 2) : c2
               case r = th - 1
                  call $sl_line('bl', 0, c1)
                  call $sl_line('br', 0, c2)
                  s = c1 : str(hc, tw - 2) : c2
               case th = 3
                  btxt = tl<di, HT.GLYPH> : tl<di, HT.LABEL>      ;* the glyph keeps its own trailing space: " <> Switch account" is 18
                  gosub boxed.line
               case r = 1
                  btxt = tl<di, HT.GLYPH>
                  gosub boxed.line
               case r = 2
                  btxt = tl<di, HT.LABEL>
                  gosub boxed.line
               case 1
                  btxt = (if tl<di, HT.WHY> # '' then tl<di, HT.WHY> else (if tl<di, HT.LIVE> # '' then tl<di, HT.LIVE> else tl<di, HT.SUB>))
                  gosub boxed.line
            end case
         end
         screen text s at tx,sy attr sty width tw
      end
   next r
   return

* One text row of a boxed tile: s = the bar, one space, btxt cut to what fits (tw - 3), padded, the bar.  8 Nov 26 (S.172): it was two spaces and fmt(.., 'nL'),
* which does not cut a longer text: the row ran past the tile and the screen's cut took the right bar and ended the caption in '.' ("Switch accou.").
boxed.line:
   btxt = btxt[1, tw - 3]
   s = vc : ' ' : btxt : space(tw - 3 - len(btxt)) : vc
   return

* The scroll bar in the last column, in the library's scroll style (dark grey in the colour themes), only when the page is taller than the panel
draw.scrollbar:
   if ch > ph then
      call $sl_scrollbar(ph, top + 1, ch, ph, bar)
      for r = 1 to ph
         screen text bar[r, 1] at lw - 1,py0 + r - 1 attr 'scroll'
      next r
   end
   return

* ------------------------------------------------------------------------------------------------- the focus

* Move the focus to tile j, scroll to keep it in the panel, and draw what changed
set.focus:
   if j < 1 or j > nt then return
   oldfi = fi
   fi = j
   oldtop = top
   gosub scroll.into.view
   if top # oldtop then
      screen clear at 0,py0 size lw,ph
      gosub draw.panel
      di = fi
      gosub draw.tile
      if tl<oldfi, HT.FIXED> then
         di = oldfi
         gosub draw.tile
      end
   end else
      di = oldfi
      gosub draw.tile
      di = fi
      gosub draw.tile
   end
   return

* The tile with its group's heading when it is the first row of its group
scroll.into.view:
   if tl<fi, HT.FIXED> then return
   ty = tl<fi, HT.Y>
   th = tl<fi, HT.H>
   fg = tl<fi, HT.GROUP>
   gy = gr<fg, HG.Y>
   first.row = (ty = gy + 1)
   want.top = (if first.row then ty - 2 else ty)       ;* the heading is the row above, with the blank row above that
   if want.top < 0 then want.top = 0
   if ty - (if first.row then 1 else 0) < top then
      top = want.top
   end else
      if ty + th - 1 > top + ph - 1 then top = ty + th - ph
   end
   if top > ch - ph then top = ch - ph
   if top < 0 then top = 0
   return

* The nearest tile in the direction dir: the distance along it, plus three times the distance across it
move.focus:
   best = 0
   bests = 1000000
   fx0 = tl<fi, HT.X>
   fx1 = fx0 + tl<fi, HT.W> - 1
   fy0 = tl<fi, HT.Y> - (if tl<fi, HT.FIXED> then py0 else 0)        ;* panel rows: a header tile is above the panel, so negative
   fy1 = fy0 + tl<fi, HT.H> - 1
   for j = 1 to nt
      if j # fi then
         jx0 = tl<j, HT.X>
         jx1 = jx0 + tl<j, HT.W> - 1
         jy0 = tl<j, HT.Y> - (if tl<j, HT.FIXED> then py0 else 0)
         jy1 = jy0 + tl<j, HT.H> - 1
         along = 0
         across = 0
         ov = 0
         ok = 0
         begin case
            case dir = 'right' and jx0 > fx1
               along = jx0 - fx1 ; across = abs(jy0 - fy0) ; ok = 1
               ov = (jy0 <= fy1 and jy1 >= fy0)
            case dir = 'left' and jx1 < fx0
               along = fx0 - jx1 ; across = abs(jy0 - fy0) ; ok = 1
               ov = (jy0 <= fy1 and jy1 >= fy0)
            case dir = 'down' and jy0 > fy1
               along = jy0 - fy1 ; across = abs(jx0 - fx0) ; ok = 1
               ov = (jx0 <= fx1 and jx1 >= fx0)
            case dir = 'up' and jy1 < fy0
               along = fy0 - jy1 ; across = abs(jx0 - fx0) ; ok = 1
               ov = (jx0 <= fx1 and jx1 >= fx0)
         end case
         if ok then
            sc = along + across + (if ov then 0 else 1000)           ;* a tile that shares rows (or columns) with this one comes before any that does not
            if sc < bests then
               bests = sc
               best = j
            end
         end
      end
   next j
   if best > 0 then
      j = best
      gosub set.focus
   end
   return

* The first tile of the next (dir = down) or previous group; a header tile has none
move.group:
   g = tl<fi, HT.GROUP>
   if g = 0 then return
   g += (if dir = 'down' then 1 else -1)
   if g < 1 or g > ng then return
   for j = 1 to nt
      if tl<j, HT.GROUP> = g then
         gosub set.focus
         return
      end
   next j
   return

* Reading order: the header first, then the groups
next.tile:
   j = fi + dir
   if j < 1 then j = nt
   if j > nt then j = 1
   gosub set.focus
   return

* A letter: the next tile, after this one, whose label begins with it
jump.letter:
   for n = 1 to nt
      j = fi + n
      if j > nt then j = j - nt
      if upcase(tl<j, HT.LABEL>[1, 1]) = upcase(nm) then
         gosub set.focus
         return
      end
   next n
   return

* ------------------------------------------------------------------------------------------------- keys and the mouse

on.key:
   msg = ''
   if aif then
      gosub ai.key
      return
   end
   begin case
      case nm = 'up' or nm = 'down' or nm = 'left' or nm = 'right'
         dir = nm
         gosub move.focus
      case nm = 'tab'
         dir = 1
         gosub next.tile                                   ;* S.176: round the tiles only; F6 is the way to the AI line, as on every page
      case nm = 'btab'
         dir = -1
         gosub next.tile
      case nm = 'home'
         gosub find.first
         j = fb
         gosub set.focus
      case nm = 'end'
         j = nt
         for i = nt to 1 step -1
            if tl<i, HT.GROUP> > 0 then
               j = i
               exit
            end
         next i
         gosub set.focus
      case nm = 'pgdn'
         dir = 'down'
         gosub move.group
      case nm = 'pgup'
         dir = 'up'
         gosub move.group
      case nm = 'enter' or nm = ' '
         gosub start.tile
      case nm = 'esc' or nm = 'bs'
         gosub close.menu                                  ;* back one page (S.88 U9, the Esc rule: on the top page the bar takes Esc and opens; Backspace there does nothing)
      case nm = 'f1'
         call $tk_help('box', 'tool.home.page', hm, 0, 0)
         if hm # '' then msg = hm
      case nm = 'f5'
         gosub rebuild
      case nm = 'f6' or nm = 'shift-f6'
         if ctx<TK.C.AI> then
            gosub ai.focus.on                              ;* F6, Shift-F6 or AI > Ask the AI: the focus goes to the line (S.176: the tiles and the line are the two stops of the box ring)
         end else
            msg = H.AI.OFF
         end
      case nm = 'ctrl-q'
         if leave.ok then
            outcome = 'leave'
            done = 1
         end else
            gosub do.signout
         end
      case nm = 'alt-x' and leave.ok                       ;* S.179: Alt-X (Ctrl-X is cut wherever there is text)
         gosub do.signout
      case nm = 'ctrl-t'                                   ;* S.179: the theme, kept for the person - the same on every page ($tk_std)
         call $tk_std('theme', ctx, keys, '', std.r)
         if std.r<1> then gosub rebuild                    ;* the tiles' colours come from the theme (alloc.styles): the page is made again
         msg = std.r<2>
      case nm = 'act:std.mouse'                            ;* S.186: View > Mouse, the same on every page ($tk_std)
         call $tk_std('mouse', ctx, keys, '', std.r)
         msg = std.r<2>
      case nm = 'ctrl-o'                                   ;* S.186: the log of the commands this page ran (View > Output; $tk_std)
         call $tk_std('output', ctx, keys, '', std.r)
      case nm = 'alt-t'                                    ;* S.179: the Terminal (it had Ctrl-T)
         if terminal.off then
            msg = H.TILE.OFF                               ;* the Terminal tile is off for this account: its key and its menu entry are too
         end else
            outcome = 'terminal'
            done = 1
         end
      case nm = 'ctrl-w'
         if index(off.set, ' switch ', 1) then msg = H.TILE.OFF else gosub switch.account
      case nm = 'ctrl-r'
         gosub toggle.recent                               ;* it refuses itself when the administrator has turned the group off (12966)
      case nm = 'ctrl-k'                                   ;* S.179: the keys of this page, as on every page (the Keys tile still opens tool.keys)
         call $tk_std('keylist', ctx, keys, ttl, std.r)
      case nm = '/'
         gosub find.tile
      case len(nm) = 1 and nm > ' '
         gosub jump.letter
   end case
   return

on.mouse:
   screen mouse returning mev else mev = ''
   if mev = '' then return
   mr = ''
   call $tk_menubar('click', ctx, keys, ttl, mev, '', mr)        ;* a click on the bar on row 0
   if mr<1> # '' then
      nm = mr<4>
      if nm # '' then                                     ;* a bar left with nothing chosen has no name: the status message stays
         if aif then gosub ai.leave
         gosub on.key
      end
      return
   end
   kind = mev<1>
   mx = mev<3>
   my = mev<4>
   begin case
      case kind = 'wheel'
         oldtop = top
         top += (if mev<2> = 'up' then -3 else 3)
         if top > ch - ph then top = ch - ph
         if top < 0 then top = 0
         if top # oldtop then
            screen clear at 0,py0 size lw,ph
            gosub draw.panel
         end
      case kind = 'press' and mev<2> = 1 and ctx<TK.C.AI> and my = hny
         gosub ai.focus.on                                 ;* a click on the AI line gives it the focus
      case kind = 'press' and mev<2> = 1
         for j = 1 to nt
            tx = tl<j, HT.X>
            ty = tl<j, HT.Y>
            if tl<j, HT.FIXED> = 0 then ty = py0 + ty - top
            in.rows = (my >= ty and my < ty + tl<j, HT.H>)
            if tl<j, HT.FIXED> = 0 then in.rows = (in.rows and my >= py0 and my <= py1)
            if in.rows and mx >= tx and mx < tx + tl<j, HT.W> then
               gosub set.focus
               gosub start.tile
               exit
            end
         next j
   end case
   return

* ------------------------------------------------------------------------------------------------- the AI line

ai.focus.on:
   aif = 1
   di = fi
   gosub draw.tile                                       ;* the tile that had the focus is drawn without it
   call $tk_ai('focus', ctx, 1, '')
   msg = sysmsg(12643)
   return

* The tile that had the focus before the AI line took it has it again
ai.tile.back:
   di = fi
   gosub draw.tile
   return

* The AI line gives the focus up because the person chose something on the menu bar with the mouse: the key that entry stands for is then the page's, not the line's
ai.leave:
   aif = 0
   call $tk_ai('focus', ctx, 0, '')
   gosub ai.tile.back
   return

* A key while the AI line has the focus: the line edits it; Esc, Tab, Back-tab, Up and Down give the focus back, and Enter on a request asks
* S.176: F6 and Shift-F6 give it back too, to the tile that had it (the line and the tiles are the box ring of every page)
ai.key:
   if nm = 'f6' or nm = 'shift-f6' then
      gosub ai.leave
      msg = ''
      return
   end
   call $tk_ai('key', ctx, nm, out)
   begin case
      case out = 'leave'
         aif = 0
         msg = ''
         gosub ai.tile.back
      case out = 'tab'
         aif = 0
         j = 1                                            ;* round the ring: the first tile
         gosub set.focus
      case out = 'btab' or out = 'up'
         aif = 0
         j = nt                                           ;* back to the last tile
         gosub set.focus
      case out = 'down'
         aif = 0
         gosub ai.tile.back
      case out = 'ask'
         gosub ask.ai
   end case
   return

* The request in the line goes to $tk_ai with what this page can do: the tiles that start a tool (never Sign out or Switch account).  The answer is a tile to start or a command
* to run, each only after the person has chosen Accept or Run; both are done exactly as a click on a tile or the Terminal tile's prompt would do them.
ask.ai:
   acts = ''
   ai.nav = 1                                             ;* the actions offered open a tool, except those named in ai.more (S.88 phase 2, S6; per proposal since handoff step 2)
   ai.more = ''                                           ;* the ids of the offered actions that do more than open a tool: the person's own programs and the Terminal tile
   for i = 1 to nt
      ta = tl<i, HT.ACT>
      if ta[1, 4] = 'cmd:' or ta = 'terminal' then
         if tl<i, HT.ID>[1, 2] # 'r:' then                ;* a recent tile is a copy of one that is offered already
            acts<1, -1> = tl<i, HT.ID> : ':' : tl<i, HT.LABEL> : ' - ' : (if tl<i, HT.SUB> = '' then 'starts ' : ta else tl<i, HT.SUB>)
            * the person's own programs (pin1, pin2 ...) run a command the person wrote, and the Terminal tile leaves the toolkit for the prompt: neither only NAVIGATES, so when the AI
            * proposes one of THESE Enter alone must reject the proposal and not accept it (a pin the model chose would run on one stray Enter); a delivered tile, which only opens a tool
            * the person could open anyway, keeps Accept as its default (the owner's answer of 23 Oct) even while pins are offered
            if tl<i, HT.ID>[1, 3] = 'pin' or ta = 'terminal' then ai.more<1, -1> = tl<i, HT.ID>
         end
      end
   next i
   ctxt = 'This is the home screen of the SD database system, a page of tiles.' : @vm : 'Each action starts the tool of that tile, exactly as the person could by choosing the tile.'
   ctxt := @vm : 'The person is ' : (if is.admin then 'the administrator.' else 'an account holder.')     ;* the lines of the page's text are VALUES (a field mark would move the fields after it)
   actx = 'home' : @fm : 'home' : @fm : ctxt : @fm : acts : @fm : ai.nav
   actx<12> = ai.more                                     ;* the library's default is Reject for a proposal of one of these
   actx<13> = 'none'                                      ;* 1 Nov 26: the home screen sends no text of any file (the AI's wall asks every app where its text comes from)
   * The Terminal tile turned off for the account means no command prompt through the AI either: the library is told there is nowhere to run a command (<11> 'nocmd') and ignores one
   if terminal.off then actx<11> = 'nocmd'
   call $tk_ai('ask', ctx, actx, res)
   call $tk_ai('clear', ctx, '', '')
   aif = 0
   msg = res<5>
   begin case
      case res<1> = 'action'
         found = 0
         for i = 1 to nt
            if tl<i, HT.ID> = res<2> then found = i
         next i
         if found then
            j = found
            gosub set.focus
            gosub start.tile
         end
      case res<1> = 'command' and terminal.off
         msg = 'the Terminal is turned off for this account'      ;* defence in depth: the library was told 'nocmd' and should never return one
      case res<1> = 'command'
         sentence = res<2>
         pause = 1
         keep.id = tl<fi, HT.ID>
         keep.top = top
         gosub run.command
         keep.id = ''
   end case
   return

* ------------------------------------------------------------------------------------------------- what a tile does

start.tile:
   act = tl<fi, HT.ACT>
   begin case
      case act[1, 4] = 'cmd:'
         sentence = act[5, 9999]
         pause = tl<fi, HT.PAUSE>
         gosub note.recent
         gosub run.command
      case act[1, 5] = 'menu:'
         gosub open.menu
      case act = 'back'
         gosub close.menu
      case act = 'terminal'
         outcome = 'terminal'
         done = 1
      case act = 'switch'
         gosub switch.account
      case act = 'signout'
         gosub do.signout
   end case
   return

* The tile just started goes first in the Recent list, when the group is on for this page.  The id is what is kept (a recent tile's id is r: and the tile's own); the person's
* own programs (pin1, pin2 ...) are their own list already and are not kept here.  When the group is off nothing is asked of the file at all.
note.recent:
   if not(rc.on) then return
   rid = tl<fi, HT.ID>
   if rid[1, 2] = 'r:' then rid = rid[3, 99]
   if rid[1, 3] = 'pin' then return
   call !home_recent('add', rid, '')
   return

* The command is given the terminal: the screen is closed, the command runs as the person would have typed it, and the screen is taken again
run.command:
   keep.id = tl<fi, HT.ID>                               ;* the screen comes back with the same tile selected, scrolled as it was
   keep.top = top
   call $tk_close(ctx)
   * 28 Oct 26 (S.88 phase 2, plan 2.5): TRAPPING ABORTS - a command that is refused (a verb that aborts, a program that stops with an error) comes back here and the page is taken again,
   * where it used to end HOME and leave the person at the prompt of a session that had been in the toolkit.  An app the command started and that was aborted may still hold the screen and
   * the break setting: $sl_cleanup gives both back (it writes nothing where the library holds nothing), and reopen takes the screen again.
   * An abort prints its message on the ordinary terminal and the page then draws over it, so the person never read why the tile failed (every delivered tile has pause = 0).  EXECUTE ... TRAPPING ABORTS
   * reports an abort only through @abort.message (@abort.code is back to 0 when the command processor returns): a sentinel message is set first, as tool.test does, and an aborted command is the
   * one that leaves a different message.  The key is waited for as for a tile with a pause, before the screen is taken again.
   gosub set.sentinel
   execute sentence trapping aborts
   aborted = (@abort.message # sentinel)                  ;* read before $sl_cleanup
   call $sl_cleanup
   if pause or aborted then gosub wait.key
   gosub reopen
   keep.id = ''
   return

* The system keeps the message of the last abort (and of an exception that was caught), which a command that ends normally does not touch: a message of the page's own is set first
set.sentinel:
   zero = 0
   sentv = 0
   sentinel = ''
   try
      sentv = 1 / zero
   catch sys.program.div_zero
      sentinel = @abort.message
   end
   if sentv # 0 then sentinel = ''
   return

* The terminal is the ordinary one again here (the screen was closed), where a key is read when Enter is pressed: so the question is for Enter, and INPUT reads it
wait.key:
   crt
   crt sysmsg(12870) :
   input junk
   return

* Take the screen again after a command (or a LOGTO) and draw the page; the window may have changed, and the account may be another
reopen:
* S.164 (the owner, 7 Nov 26: "if the window is shrunk the default is to show only a portion of the home screen and lock user input until it is the right size, not
*   log the person out"): a window made too small during a command is held behind the library's size lock, as a window shrunk with the screen up is, until it is big
*   enough again.  Only Ctrl-Q then y in the lock (or input that ended) leaves: a session's own screen signs out, a screen typed at the prompt goes back to it.
   loop
      call $sl_need('home', TK.MINW, TK.MINH, need.msg, '')
   while need.msg # '' do
      call $sl_guard('home', TK.MINW, TK.MINH, TK.MINW - 1, TK.MINH - 1, guard.res, 'layout')
      if guard.res = 'quit' then
         if menu.session then hrefused = 1
         outcome = 'closed'
         done = 1
         return
      end
   repeat
   call $tk_open('home', '', ctx, err)
   if err # '' then
      if menu.session then hrefused = 1                 ;* S.164: a session's own screen that cannot open again is not a way to the prompt
      display err
      outcome = 'closed'
      done = 1
      return
   end
   is.admin = kernel(K$ADMINISTRATOR, -1)
   if is.admin then ctx<TK.C.AUD> = sysmsg(12808)
   gen += 1
   ctx<TK.C.GEN> = gen
   lastmin = ''
   aif = 0
   call $tk_ai('init', ctx, '', '')                       ;* the account may be another, and the window another size
   gosub declare.panes
   if perr # '' then
      call $tk_close(ctx)
      display perr
      outcome = 'closed'
      done = 1
      return
   end
   gosub geometry
   want.id = keep.id
   want.top = keep.top
   gosub enter.level
   return

* F5: the page again for what the session is now
rebuild:
   aif = 0
   call $tk_ai('init', ctx, '', '')                       ;* F5 also reads whether the AI is on now
   want.id = ''
   want.top = 0
   gosub enter.level
   msg = 'page built again'
   return

* The page of the menu being shown (cur.menu), built, laid out and drawn.  want.id (null for none) is the tile that has the focus and want.top how far the panel was scrolled when it
* had it: the page comes back as it was left, scrolled further only when that tile is out of the panel (a Recent group may have appeared above it).
enter.level:
   aif = 0
   gosub make.keys
   gosub set.title
   gosub build.page
   gosub layout
   gosub first.focus
   top = 0
   if want.id # '' then
      for i = 1 to nt
         if tl<i, HT.ID> = want.id then
            fi = i
            top = want.top
         end
      next i
      if top > ch - ph then top = ch - ph
      if top < 0 then top = 0
      gosub scroll.into.view
   end
   gosub draw.all
   return

* The key table (the registry, /tkreg/ once $tk_frame has drawn it): the function-key row, F1's list of keys and the menu bar are all made from it.  A sub-menu page also has
* Esc (back).  Every action on the menu bar has a key, so the bar's answer is replayed through the page's own case for that key; the keys that are not on the function-key row
* (off.row: the row would be too long to read) are in the menus and in F1's list.  F10 and Alt and a letter are the bar's own and have no row.
make.keys:
   keys = ''
   call $tk_keys('add', keys, 'enter', 'start', 'start', '', 1)
   if cur.menu # '' then call $tk_keys('add', keys, 'esc', 'back', 'back', '', 1)
   call $tk_keys('add', keys, 'bs', 'back', 'back', '', 1)
   gosub off.row
   call $tk_keys('add', keys, 'f1', 'help', 'help', '', 1)
   call $tk_keys('add', keys, 'f5', 'refresh', 'refresh', '', 1)
   if leave.ok then
      call $tk_keys('add', keys, 'ctrl-q', 'prompt', 'leave', '', 1)
   end else
      call $tk_keys('add', keys, 'ctrl-q', 'sign out', 'signout', '', 1)
   end
   call $tk_keys('add', keys, 'alt-t', 'terminal', 'terminal', '', 1)      ;* S.179: Alt-T (Ctrl-T is the theme on every page)
   gosub off.row
   call $tk_keys('add', keys, 'ctrl-w', 'switch', 'switch', '', 1)
   gosub off.row
   call $tk_keys('add', keys, '/', 'find', 'find', '', 1)
   call $tk_keys('add', keys, 'ctrl-r', 'recent', 'recent', '', 1)
   gosub off.row
   call $tk_keys('add', keys, 'f6', 'ai', 'ai', '', 1)
   if leave.ok then
      call $tk_keys('add', keys, 'alt-x', 'sign out', 'signout', '', 1)        ;* Ctrl-Q left the screen for the prompt: Sign out has this key (the menu and the tile as well); S.179: Alt-X (Ctrl-X is cut wherever there is text)
      gosub off.row
   end
   return

* The row just added stays bound and in the menus, but is not written on the function-key row
off.row:
   keys<dcount(keys, @fm), TK.K.ROW> = 0
   return

* The status line's pane is the path of the page (Home > Develop), and the identity stands right of the Back tile on a sub-menu page
set.title:
   ttl = 'Home'
   for ck = 1 to dcount(crumb, @fm)
      ttl := ' > ' : crumb<ck>
   next ck
   idx = (if cur.menu # '' then xcol<2> else xcol<1>)     ;* 25 or 3 at 140 by 43
   lastmin = ''                                          ;* the clock is written again where the identity now stands
   return

* ------------------------------------------------------------------------------------------------- sub-menus

* A folder tile (action menu:<name>): the menu opens as a page of its own.  What is left behind - the menu, the tile that had the focus and the scroll - is kept to give back.
* A menu that is already open above this one is refused (a page cannot open itself), and so is a ninth level.
open.menu:
   mname = act[6, 99]
   dep = dcount(stk, @fm)
   already = (mname = cur.menu or mname = '')
   for sk = 1 to dep
      if stk<sk, 1> = mname then already = 1
   next sk
   if already then
      msg = sysmsg(12961, mname)
      return
   end
   if dep >= HM.DEPTH then
      msg = sysmsg(12962, HM.DEPTH)
      return
   end
   stk<-1> = cur.menu : @vm : tl<fi, HT.ID> : @vm : top
   crumb<-1> = tl<fi, HT.LABEL>
   cur.menu = mname
   want.id = ''
   want.top = 0
   gosub enter.level
   return

* Back one page: the page left is built again with the focus and the scroll it had.  On the top page there is nothing to go back to.
close.menu:
   dep = dcount(stk, @fm)
   if dep = 0 then return
   e = stk<dep>
   cur.menu = e<1, 1>
   want.id = e<1, 2>
   want.top = e<1, 3>
   del stk<dep>
   del crumb<dep>
   gosub enter.level
   return

* View > Recent group: the person turns the group on (the file &menus& is made when it is not there) or off (the list is forgotten).  The administrator's SET.TILE ... recent off wins.
toggle.recent:
   if index(off.set, ' recent ', 1) then
      msg = sysmsg(12966)
      return
   end
   junk = ''
   rok = 0
   if rc.on then
      call !home_recent('off', rok, junk)
      rmsg = 12964
   end else
      call !home_recent('on', rok, junk)
      rmsg = (if rok then 12963 else 12965)
   end
   gosub rebuild
   msg = sysmsg(rmsg)
   return

* A resize: the layout service makes the frame, the body and the three panes the window's again ($tk_layout 'refresh', which also arms the cursor lock with them), and the page
* is laid out and drawn again from the new rectangles - the tile columns, the header tiles, the panel, the hint row.  The screen kept the old page's cells where they still fit and
* the header tiles move with the columns, so the rows above the status line are cleared first; the frame is written again whole (the generation).
relayout:
   call $tk_layout('refresh', ctx, '', lay.chg)
   gen += 1
   ctx<TK.C.GEN> = gen
   lastmin = ''
   call $tk_ai('move', ctx, '', '')                       ;* the rows moved: the line is put where they are now; the request typed in it and its focus (aif) are kept
   gosub geometry
   gosub set.title                                        ;* the identity's column is a tile column's
   gosub layout
   screen clear at 0,hdy size lw,ctx<TK.C.YSTAT> - hdy
   gosub draw.all
   return

* ------------------------------------------------------------------------------------------------- the menu bar

* The menus, put into the key table (S.88 U9: $tk_menubar draws and runs the bar from it; the page builds no menu array of its own).  The key an entry shows is the table's.
* An action that cannot be used now is given a reason ($tk_keys 'why'): its entry is dimmed and cannot be chosen, and its key is out of the row - a tile the administrator
* turned off for this account has no entry that can be chosen either, Back is only on a sub-menu page (on the top page Esc opens this bar, so the dimmed entry shows no key),
* and Ask the AI follows the AI (the line works when the provider is on).  Called last by build.page, after make.keys, so F5 and Switch account see a change.
make.menus:
   if leave.ok then call $tk_keys('menu', keys, 'leave', '&File', '&Back to the prompt', '', '')
   call $tk_keys('menu', keys, 'signout', '&File', '&Sign out', '', '')
   call $tk_keys('menu', keys, 'back', '&Go', '&Back', '', '')
   call $tk_keys('menu', keys, 'terminal', '&Go', '&Terminal', '', '')
   call $tk_keys('menu', keys, 'switch', '&Go', 'S&witch account', '', '')
   call $tk_keys('menu', keys, 'find', '&Go', '&Find a tile', '', '')
   call $tk_keys('menu', keys, 'start', '&Go', '&Start the tile', '', '')   ;* S.180: every key's action is on a menu (Enter)
   call $tk_keys('menu', keys, 'refresh', '&View', '&Refresh', '', '')
   call $tk_keys('menu', keys, 'recent', '&View', 'Recent &group on or off', '', '')     ;* a literal, as every registry entry is (test-tk-keys-units regmenu); the status line says which it became
   call $tk_keys('menu', keys, 'ai', '&AI', '&Ask the AI', '', '')
   call $tk_keys('menu', keys, 'help', '&Help', '&Help on this page', '', '')
   call $tk_std('keys', ctx, keys, '', '')                ;* S.179: Ctrl-T theme (View > Theme), Ctrl-K the keys of this page (Help > Keys), as on every page
   if terminal.off then call $tk_keys('why', keys, 'terminal', H.TILE.OFF, '', '', '')
   if index(off.set, ' switch ', 1) then call $tk_keys('why', keys, 'switch', H.TILE.OFF, '', '', '')
   if index(off.set, ' recent ', 1) then call $tk_keys('why', keys, 'recent', H.TILE.OFF, '', '', '')
   if cur.menu = '' then call $tk_keys('why', keys, 'back', H.TOP.PAGE, '', '', '')
   if not(ctx<TK.C.AI>) then call $tk_keys('why', keys, 'ai', H.AI.OFF, '', '', '')
   return

* / (or Go > Find a tile): a window of the page's tiles ($tk_pickrec 'list', the toolkit's pick window): typing narrows the list to the tiles that hold the text in their name or
* their group, Enter moves the focus to the tile chosen (it does not start it: Enter on the page does), Esc leaves the focus where it was.  A Recent copy is not listed twice.
find.tile:
   fitems = ''
   fmap = ''
   fdef = 1
   for i = 1 to nt
      if tl<i, HT.ID>[1, 2] # 'r:' then
         fg = tl<i, HT.GROUP>
         fitems<-1> = tl<i, HT.LABEL> : @vm : (if fg > 0 then gr<fg, HG.NAME> else 'header')
         fmap<-1> = i
         if i = fi then fdef = dcount(fmap, @fm)
      end
   next i
   fsel = 'Find a tile'                                    ;* in: the window's title; out: the number of the entry chosen
   fstart = fdef                                           ;* in: the entry the window starts on (the tile that has the focus)
   call $tk_pickrec(ctx, 'list', fitems, fsel, fres, fstart)
   if fres = 'ok' then
      j = fmap<fsel>
      if aif then gosub ai.leave
      gosub set.focus
      msg = tl<fi, HT.LABEL> : ': Enter starts it'
   end
   return

* ------------------------------------------------------------------------------------------------- sign out and switch account

do.signout:
   so.text = sysmsg(12871)
   so.btns = '&Sign out' : @vm : '&Cancel'                ;* Cancel is the one Enter chooses: a stray Enter never signs anyone out
   screen msgbox so.text title 'Sign out' buttons so.btns default 2 returning b else b = 0
   if b = 1 then
      outcome = 'signout'
      done = 1
   end else
      msg = ''
   end
   return

* The accounts this person may enter, by the rule LOGTO applies (the administrator any, anyone else the account's group; a suspended account and SDSYS never), then
* the screen of the one chosen.  The process cannot become another person: it runs as one Linux user (plan 13.4).
switch.account:
   alist = ''
   openpath @sdsys : @ds : 'accounts' to acc.f then
      select acc.f to 11
      loop
         readnext aid from 11 else exit
         read arec from acc.f, aid then
            ok = (upcase(trim(arec<ACC$SUSPENDED>)) # 'SUSPENDED')
            if downcase(aid) = 'sdsys' then ok = 0
            if ok and not(is.admin) then ok = is_grp_member(@logname, arec<ACC$GROUP>)
            if ok then
               locate aid in alist<1> by 'AL' setting pos else
                  ins aid before alist<pos>
               end
            end
         end
      repeat
      close acc.f
   end
   if alist = '' then
      msg = 'no account to switch to'
      return
   end
   screen pick alist title 'Switch account' returning pk else pk = 0
   if pk = 0 then return
   acct = alist<pk>
   if acct = @who then
      msg = 'already in ' : acct
      return
   end
   call $tk_close(ctx)
   hlogto = 1
   execute 'logto ' : acct trapping aborts              ;* 28 Oct 26 (S.88 phase 2): a LOGTO that aborts comes back here too; the screen is taken again below, in whichever account the session is in
   hlogto = 0
   call $sl_cleanup
   cur.menu = ''                                          ;* the screen of the new account starts at its top page
   stk = ''
   crumb = ''
   gosub reopen
   if @who # acct then msg = sysmsg(12872, acct)
   return

end

