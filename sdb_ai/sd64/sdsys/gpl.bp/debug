zoned.update:
   left = 0
   text.line = ss : space(wm1)

   if image # text.line then
      for cl = 1 to wm1
         if text.line[cl,1] # image[cl,1] then
            left = cl ; right = cl
            loop
               cl += 1
            while cl <= wm1
               if text.line[cl,1] # image[cl,1] then right = cl
            repeat

            w = right - left + 1
            i = left - 1
            if i # csr.x then display @(i) :
            display text.line[left,w] :
            csr.x = i + w
            image = text.line[1,wm1]
            exit
         end
      next cl
   end

   return

