* GET.INPUT  -  Keyboard input

get.input:
   pan.increment = 32

   spos = 0               ;* Stack position
   command = ''

   if guard.left then     ;* the user left from the cursor lock in a listing: that is Stop (F3)
      guard.left = @false
      command = char(K$F3)
      goto exit.get.input
   end

   prefix = '>'
   prefix.len = len(prefix)
   command.width = wm1 - prefix.len

   loop
      command.pan = 1

      csr.x = -1
      x = len(command) + 1
      image = space(wm1)

      if full.screen then
         call $sl_put(scr, 0, command.line, space(wm1), command.attr)
      end else display @(0) : @(-4) :

      first = @true
      loop
         if (x < command.pan) or (x >= (command.pan + command.width)) then
            command.pan = (int((x - 1) / pan.increment) * pan.increment) - pan.increment
            if command.pan <= 0 then command.pan = 1
         end

         ss = prefix : command[command.pan, command.width]
         if full.screen then
            * the whole command line, in the library's style, and the cursor in it
            i = prefix.len + x - command.pan
            call $sl_put(scr, 0, command.line, fmt(ss, wm1 : 'L'), command.attr)
            call $sl_curat(i, command.line)
         end else
            gosub zoned.update         ;* (it uses i: the cursor's place is worked out after it)
            i = prefix.len + x - command.pan
            if i # csr.x then
               display @(i) :
               csr.x = i
            end
         end

         if full.screen then
            * the window may change while the debugger waits, and the cursor may be off the screen: WAIT.KEY sees to both
            cur.x = i
            gosub wait.key
            command.width = wm1 - prefix.len
            if key.quit then
               command = char(K$F3)               ;* the user left from the cursor lock: Stop
               goto exit.get.input
            end
            if wk.relaid then continue            ;* the screen was drawn again: the command line is painted again from the top
            c = wk.c
         end else
            c = keycode()
         end
         n = seq(c)

         if first and n >= 32 and n < 128 then
            command = ''
            x = 1
         end
         first = @false

         begin case
            case n = 254    ;* Ignore field marks (Destroys the stack)
               display @sys.bell :

            case n = K$HOME or n = 1
               x = 1

            case n = K$LEFT or n = 2
               if x > 1 then x -= 1

            case n = K$DELETE or n = 4
               command = command[1, x - 1] : command[x + 1, 999]

            case n = K$END or n = 5
               x = len(command) + 1

            case n = K$RIGHT or n = 6
               if x <= len(command) then x += 1

            case n = K$BACKSPACE
               if x > 1 then
                  x -= 1
                  command = command[1, x - 1] : command[x + 1, 999]
               end

            * 8 Nov 26 (S.179, the owner: the same keys on every page): Ctrl-K the keys in use, Ctrl-T the theme, Ctrl-L a redraw, Esc alone or
            * F10 the menu bar.  Delete to the end of the line and swap two characters, which had Ctrl-K and Ctrl-T, are Esc K and Esc T (Alt-K,
            * Alt-T: a terminal sends Esc and the letter).
            case n = 11      ;* Ctrl-K: the keys in use
               gosub dbg.keys

            case n = 20 and full.screen      ;* Ctrl-T: the theme
               gosub dbg.theme

            case n = 12 and full.screen      ;* Ctrl-L: a redraw
               gosub relayout

            case n = 27 or n = K$F10
               dk.c = ''
               if n = 27 then dk.c = keyin(0.4)     ;* a letter at once is Alt-letter; nothing is Esc on its own
               begin case
                  case upcase(dk.c) = 'K'           ;* Esc K: delete to the end of the line
                     command = command[1, x - 1]
                  case upcase(dk.c) = 'T'           ;* Esc T: swap the two characters before the cursor
                     if x > 1 and x < len(command) then
                        command[x-1,2] = command[x,1]:command[x-1,1]
                     end
                  case dk.c = '' and full.screen    ;* Esc on its own, or F10: the menu bar
                     gosub dbg.menu
                     if dm.cmd # '' then
                        command = dm.cmd
                        goto exit.get.input
                     end
                  case 1
                     display @sys.bell :
               end case

            case n = K$RETURN
               command = trim(command, ' ', 'B')
               if not(full.screen) then display
               debug.command.stack = command : @fm : field(debug.command.stack, @fm, 1, 98)
               goto exit.get.input

            case n = K$DOWN or n = 14
               if spos > 1 then
                  spos -= 1
                  command = debug.command.stack<spos>
               end else
                  spos = 0
                  command = ''
               end
               exit
   
            case n = K$INSERT or n = 15   ;* Ctrl-O
               debug.overlay = not(debug.overlay)
         
            case n = K$UP or n = 16 or n = 26
               if spos < dcount(debug.command.stack, @fm) then
                  spos += 1
                  command = debug.command.stack<spos>
               end
               exit

            case n = 7          ;* Ctrl-G
               spos = 0
               command = ''
               exit

            case n = 21         ;* Ctrl-U
               command = upcase(command)


            * 9 Nov 26 (S.186, the owner: "consistency within SD"): F2 is Find an action and Ctrl-Q leaves (Stop, as F3), as on every page, in the full screen.
            *   Abort is on the Run menu and in the finder.  In line mode, which has no menu bar, F2 is still Abort.
            case n = K$F2 and full.screen and len(command) = 0
               gosub dbg.find
               if dm.cmd # '' then
                  command = dm.cmd
                  goto exit.get.input
               end

            case n = 17 and full.screen and len(command) = 0      ;* Ctrl-Q: stop the program and leave, as F3
               command = char(K$F3)
               goto exit.get.input

            case len(command) = 0 and n > 127
               command = c
               goto exit.get.input

            case n >= 32
               if debug.overlay then
                  if x <= len(command) then command[x, 1] = c
                  else command := c
               end else
                  command = command[1, x - 1] : c : command[x, 999]
               end
               x += 1

            case 1
               display @sys.bell :
         end case
      repeat
   repeat

exit.get.input:
   return


