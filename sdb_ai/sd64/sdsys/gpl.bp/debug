show.call.stack:
   s = system(1002)
   n = dcount(s, @fm)
   zz = 1
   for stack.index = 2 to n      ;* Skip debugger
      ss = s<stack.index>
      message = ss<1,1>
      begin case
         case message = '$cproc'   ;* 14 Sep 26 stage 3a: program names are lower
            message = 'Command processor'
            gosub emit.msg
         case 1
            k = dcount(ss, @vm)
            for j = 2 to k
               if rem(zz, data.lines) = 0 then
                  loop
                     call $sl_put(scr, 0, command.line, fmt(sysmsg(6710), wm1 : 'L'), command.attr)  ;* ---more---
                     cur.x = len(sysmsg(6710))
                     gosub wait.key
                  while wk.relaid repeat
                  if key.quit then guard.left = @true
                  if upcase(wk.c) = 'Q' or key.quit then return
                  call $sl_put(scr, 0, command.line, space(wm1), command.attr)
               end
               ln = ss<1,j,2>
               if ln then message := ' @ ' : ln           ;* If no line no...
               else message := ' @ (x' : ss<1,j,1> : ')'  ;* ...use address
               message = zz:': ':message
               gosub emit.msg
               message = '   '
               zz += 1
            next j 
      end case
   next stack.index
   return

