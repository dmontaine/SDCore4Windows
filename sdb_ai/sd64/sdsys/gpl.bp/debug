* 8 Nov 26 (S.179, S.180): the menu bar, the theme and the keys in use.  The owner: "all features available on a page need to appear somewhere on
* the menus"; the theme "should appear in the menu under view".  The bar is drawn on the top row by display.source; the menus hold every key the
* command loop acts on.  A menu's code is a key: a function key goes back to the command loop as if it had been pressed (dm.cmd), the others
* are done here.

* DBG.BAR  -  The menu bar widget (sl.h): Run, View and Help.  dm.tw = the width of the titles, where the program's name starts.
dbg.bar:
   dm.bar = ''
   dm.bar<SL.W.Y> = 0
   dm.bar<SL.W.W> = lay.w
   dm.m = '&Run'
   dm.m<1, -1> = '&Run to a breakpoint' : @sm : 'F9' : @sm : 'f9'
   dm.m<1, -1> = '&Step' : @sm : 'F7' : @sm : 'f7'
   dm.m<1, -1> = 'Step a &line' : @sm : 'F8' : @sm : 'f8'
   dm.m<1, -1> = 'Run to the &parent' : @sm : 'Ctrl-F7' : @sm : 'cf7'
   dm.m<1, -1> = 'Run to the parent pr&ogram' : @sm : 'Ctrl-F8' : @sm : 'cf8'
   dm.m<1, -1> = '-'
   dm.m<1, -1> = 'S&top the program' : @sm : 'F3 / Ctrl-Q' : @sm : 'f3'
   dm.m<1, -1> = '&Abort' : @sm : '' : @sm : 'f2'     ;* 9 Nov 26 (S.186): no key in the full screen (F2 is Find an action, as on every page); still F2 in line mode
   dm.bar<20> = dm.m
   dm.m = '&View'
   dm.m<1, -1> = "The program's &screen" : @sm : 'F4' : @sm : 'f4'     ;* 11 Nov 26: was 'The program''s &screen' - SD BASIC has no '' escape, so that was two strings side by side
   dm.m<1, -1> = '&Theme' : @sm : 'Ctrl-T' : @sm : 'theme'
   dm.m<1, -1> = '&Refresh' : @sm : 'F5' : @sm : 'f5'
   dm.bar<21> = dm.m
   dm.m = '&Help'
   dm.m<1, -1> = '&Help' : @sm : 'F1' : @sm : 'f1'
   dm.m<1, -1> = '&Keys' : @sm : 'Ctrl-K' : @sm : 'keys'
   dm.m<1, -1> = '&Find an action' : @sm : 'F2' : @sm : 'find'
   dm.bar<22> = dm.m
   dm.tw = 0
   for dm.i = 20 to 22
      dm.t = dm.bar<dm.i, 1>
      dm.tw += len(convert('&', '', dm.t)) + 2
   next dm.i
   return

* DBG.MENU  -  Esc on its own or F10: the menu bar.  dm.cmd returned: the key a chosen function-key item stands for, else null.
dbg.menu:
   dm.cmd = ''
   gosub dbg.bar
   call $sl_menu('init', dm.bar, scr, '', dm.r)
   call $sl_menu('run', dm.bar, scr, '', dm.code)
   gosub dbg.code
   gosub display.source                ;* the bar, with the program's name after the titles
   return

* DBG.FIND  -  F2, Help > Find an action (9 Nov 26, S.186: the finder every page has on F2): every entry of the menu bar in one list ($sl_palette), typed to narrow
*   it; the entry chosen is run as the menu runs it (dm.cmd, dbg.code).  The palette draws with the library's context, which is the PROGRAM's while it is debugged: the
*   debugger's own (scr) is put in its place for the palette and the program's given back after, as the theme does.
dbg.find:
   dm.cmd = ''
   gosub dbg.bar
   pal.m = dm.bar<20> : @fm : dm.bar<21> : @fm : dm.bar<22>
   call $sl_scr('get', pal.keep)
   call $sl_scr('put', scr)
   call $sl_palette(pal.m, '', dm.code, pal.s, pal.why)
   call $sl_scr('get', scr)
   call $sl_scr('put', pal.keep)
   begin case
      case pal.s = 0
         gosub dbg.code
      case pal.s = 2
         message = pal.why
         gosub emit.msg
   end case
   gosub display.source
   return

* DBG.CODE  -  dm.code, an entry of the menu bar or the finder: dm.cmd the key it stands for, or the action done here
dbg.code:
   begin case
      case dm.code = 'f9' ; dm.cmd = char(K$F9)
      case dm.code = 'f7' ; dm.cmd = char(K$F7)
      case dm.code = 'f8' ; dm.cmd = char(K$F8)
      case dm.code = 'cf7' ; dm.cmd = char(K$CTRL.F7)
      case dm.code = 'cf8' ; dm.cmd = char(K$CTRL.F8)
      case dm.code = 'f3' ; dm.cmd = char(K$F3)
      case dm.code = 'f2' ; dm.cmd = char(K$F2)
      case dm.code = 'f4' ; dm.cmd = char(K$F4)
      case dm.code = 'f5' ; dm.cmd = char(K$F5)
      case dm.code = 'f1' ; dm.cmd = char(K$F1)
      case dm.code = 'theme' ; gosub dbg.theme
      case dm.code = 'keys' ; gosub dbg.keys
      case dm.code = 'find' ; gosub dbg.find
   end case
   return

* DBG.THEME  -  Ctrl-T, View > Theme: the next theme, kept for the person ($tk_theme, as every page has it), the debugger drawn whole in it.
*   The theme in force belongs to the debugged program; theme.out gives the program back its own when the debugger leaves.
dbg.theme:
   dbg.themed = @true                  ;* dbg.theme (theme.in) is the program's: theme.out puts it back
   call $tk_theme(0, dt.chg, dt.msg)   ;* 0: the debugger draws itself (the library's context is the program's)
   if dt.chg then gosub relayout
   message = dt.msg
   gosub emit.msg
   return

* DBG.KEYS  -  Ctrl-K, Help > Keys: every key the debugger acts on, in the messages.
dbg.keys:
   gosub key.text
   call $tk_keys('keylist', kr.keys, '', dk.list, '', '', '')
   dk.list<-1> = '^T  theme'
   dk.list<-1> = '^K  keys in use'
   dk.list<-1> = '^L  redraw'
   dk.list<-1> = '^Q  stop the program and leave'
   dk.list<-1> = 'Esc / F10  the menu bar'
   dk.list<-1> = 'Alt-K  delete to the end of the line;  Alt-T  swap two characters'
   for dk.i = 1 to dcount(dk.list, @fm)
      message = dk.list<dk.i>
      gosub emit.msg
   next dk.i
   return

* ======================================================================
* VIEW

view:
   if alt.on then
      * The program's screen is behind the alternate one: show it until a key, then come back and draw again
      display terminfo('rmcup') :
      s = keycode()
      display terminfo('smcup') : @(-1) :
      call $sl_scr('get', scr)
      scr<SL.S.CLIP> = ''
      gosub paint.layout
      gosub paint.data.area
      src.line = line
      gosub display.source
      gosub refresh.panes
   end
   if main.on then
      * S.98 H3: there is no second screen.  A program that owns the library's screen has it drawn again from its shadow, in its own theme, until a key; any other program's screen is not
      * kept by anybody, and the debugger says so.
      call $sl_scr('get', ps)
      if ps<SL.S.OWNED> then
         gosub theme.out
         call $sl_repaint(ps)
         s = keycode()
         gosub theme.in
         gosub paint.layout
         gosub paint.data.area
         src.line = line
         gosub display.source
         gosub refresh.panes
      end else
         message = sysmsg(12602)
         gosub emit.msg
      end
   end
   return

* ======================================================================
* ABORT.DEBUG:

abort.debug:
   gosub ibk.sync                       ;* S.98 H2: these two end the program and never reach the loop's end
   if full.screen then gosub theme.out
   gosub leave.screen
   gosub dbg.stop(6716) ;* ABORT : Debugging terminated
   return

* ======================================================================
* STOP.DEBUG:

stop.debug:
   gosub ibk.sync
   if full.screen then gosub theme.out
   gosub leave.screen
   gosub dbg.stop(6715) ;* STOP : Debugging terminated
   return

* ======================================================================
* STEP  -  Step n debug elements

step:
   gosub dbg.breakpoint(BRK$STEP, n)
   done = @true
   return

* ======================================================================
* STEP.LINE  -  Step n lines

step.line:
   gosub dbg.breakpoint(BRK$STEP.LINE, n)
   done = @true
   return

* ======================================================================
* DISPLAY.VARIABLE  -  Display a variable
* var.name - variable name
* dump.path = path if doing DUMP, else null

display.array.element:
   var.info = dbg.info(2, array.offset)
   array.offset += 1
   fpos = 0 ; vpos = 0 ; spos = 0
   goto display.data.common

fold.var.name:
   * Fold the case of var.name, but not of the path of a collection element, which
   * is case sensitive: name{path}

   if not(case.sensitive) then
      brace.pos = index(var.name, '{', 1)
      if brace.pos then
         var.name = upcase(var.name[1, brace.pos - 1]) : var.name[brace.pos, 99999]
      end else
         var.name = upcase(var.name)
      end
   end
   return

* EQUATE.RESOLVE  -  An equate token of a $MODE DEBUG.EQUATES program stands for what it was equated to  (16 Oct 26, QM4 gap 218)
*
* In: var.name, perhaps with an index, a field position or a collection path after the token.
* Out: var.name is the variable, element or field the token stood for, with what followed the token put back, so that the
*      ordinary code takes it from there; or equ.const is true and equ.value is the constant the token stands for (a token of
*      a number, a string or CHAR(n) is not a variable: it can be shown, not set or watched).  A name that is not a token is
*      left alone.

equate.resolve:
   equ.const = @false
   if equates(idx) = '' then return
   equ.cut = len(var.name) + 1
   for equ.i = 1 to len(var.name)
      if index('({<', var.name[equ.i, 1], 1) then equ.cut = equ.i ; exit
   next equ.i
   equ.tok = var.name[1, equ.cut - 1]
   locate equ.tok in equates(idx)<1,1> setting equ.pos else return
   equ.def = equates(idx)<2, equ.pos>
   equ.body = equ.def[2, 99999]
   equ.rest = var.name[equ.cut, 99999]
   begin case
      case equ.def[1,1] = '4'      ;* a variable
         var.name = equ.body : equ.rest
      case equ.def[1,1] = '5'      ;* an @variable
         var.name = '@' : equ.body : equ.rest
      case equ.def[1,1] = '2'      ;* an element of a matrix: name row {col}
         var.name = field(equ.body, ' ', 1) : '(' : field(equ.body, ' ', 2) : (if field(equ.body, ' ', 3) # '' then ',' : field(equ.body, ' ', 3) else '') : ')'
      case equ.def[1,1] = '6'      ;* a field of a dynamic array variable: name field {value {subvalue}}
         var.name = field(equ.body, ' ', 1) : '<' : field(equ.body, ' ', 2)
         if field(equ.body, ' ', 3) # '' then var.name := ',' : field(equ.body, ' ', 3)
         if field(equ.body, ' ', 4) # '' then var.name := ',' : field(equ.body, ' ', 4)
         var.name := '>'
      case equ.def[1,1] = '3'      ;* CHAR(n)
         equ.const = @true ; equ.value = 'CHAR(' : equ.body : ')'
      case 1                       ;* 0 a string, 1 a number
         equ.const = @true ; equ.value = equ.body
   end case
   return

display.variable:
   gosub equate.resolve
   if equ.const then
      message = var.name : ' = ' : equ.value
      gosub emit.msg
      return
   end
   has.path = @false
   brace.pos = index(var.name, '{', 1)
   if brace.pos then   ;* An element of a collection: name{path}
      var.path = var.name[brace.pos + 1, 99999]
      if var.path[len(var.path), 1] = '}' then var.path = var.path[1, len(var.path) - 1]
      var.name = var.name[1, brace.pos - 1]
      has.path = @true
   end

   if var.name matches '...<1N...>' then
      fpos = matchfield(var.name, '...<0N...', 3) + 0
      vpos = matchfield(var.name, '...<0N,0N...', 5) + 0
      spos = matchfield(var.name, '...<0N,0N,0N...', 7) + 0
      var.name = matchfield(var.name, '...<1N...>', 1)
   end else
      fpos = 0 ; vpos = 0 ; spos = 0
   end

   * Is it a system variable?

   locate upcase(var.name) in system.variables<1,1> setting i then
      s = dbg.info(4,0)
      message = var.name : ' = ' : s<i>
      gosub emit.msg
      return
   end

   * Is it an @-variable?

   if var.name[1,1] = '@' then
      message = var.name : ' = '
      var.name = upcase(var.name)
      s = dbg.atvar(var.name)
      if status() then message = sysmsg(6717) ;* Unrecognised @-variable
      else message := s
      gosub emit.msg
      return
   end

   begin case
      case var.name matches "0X'('1N0N')'"
         var.row = matchfield(var.name, "0X'('0N')'", 3)
         var.name = field(var.name, '(', 1)
         var.dim = 1

      case var.name matches "0X'('1N0N','1N0N')'"
         var.row = matchfield(var.name, "0X'('0N','0N')'", 3)
         var.col = matchfield(var.name, "0X'('0N','0N')'", 5)
         var.name = field(var.name, '(', 1)
         var.dim = 2

      case 1 
         var.dim = 0
   end case

   find var.name in symbols(idx) setting f, v, sv else
      message = sysmsg(6718) ;* Variable not defined
      gosub emit.err.msg
      return
   end

   if f = 1 then  ;* Local variable
      var.no = v - 1  ;* Form variable number
   end else       ;* Common variable
      var.no = symbols(idx)<f,1> + shift(sv, -16)
   end

   var.info = dbg.info(1, var.no)
   var.type = var.info<1> + 0   ;* 0554

   if var.dim then
      var.flags = var.info<4>
      if var.info<1> # V$ARRAY then
         message = sysmsg(6719) ;* Index not allowed with scalar variable
         gosub emit.err.msg
         return
      end

      rows = var.info<2> + 0
      cols = var.info<3> + 0
      if var.dim = 1 then  ;* One index value
         if cols and var.row # 0 then
            message = sysmsg(6720) ;* Two dimensional matrix requires two index values
            gosub emit.err.msg
            return
         end
         if var.row > rows then
            message = sysmsg(6725) ;* Index out of range
            gosub emit.err.msg
            return
         end
         var.info = dbg.info(2, var.row)
      end else  ;* Two index values
         if cols = 0 then
            message = sysmsg(6721) ;* Single dimensional matrix requires one index value
            gosub emit.err.msg
            return
         end
         if var.col < 1 or var.col > cols then
            message = sysmsg(6722) ;* Column index out of range
            gosub emit.err.msg
            return
         end
         if var.row < 1 or var.row > rows then
            message = sysmsg(6723) ;* Row index out of range
            gosub emit.err.msg
            return
         end
         var.info = dbg.info(2, cols * (var.row - 1) + var.col)
      end
   end

   if has.path then
      if var.dim or var.info<1> + 0 # V$COLL then
         message = sysmsg(6719) ;* Index not allowed with scalar variable
         gosub emit.err.msg
         return
      end
      var.info = dbg.info(6, var.no : @fm : var.path)
      if len(var.info) = 0 then
         message = sysmsg(12136) ;* Element not found in the collection
         gosub emit.err.msg
         return
      end
   end

   message = ''

display.data.common:
   var.type = var.info<1> + 0   ;* Will not have set above if enter here
   s = ''  ;* Will end up as data for DUMP command

   * ++ALLTYPES++
   begin case
      case len(var.info) = 0
         message := sysmsg(6724) ;* Unable to fetch variable information

      case var.type = V$UNASSIGNED
         message := 'Unassigned'

      case var.type = V$INTEGER
         s = var.info<2>
         message := 'Integer: ' : s

      case var.type = V$FLOATNUM
         s = var.info<2>
         message := 'Float: ' : s

      case var.type = V$SUBR
         s = var.info<2>
         message := 'Subr: ' : s

      case var.type = V$STRING
         s = field(var.info, @fm, 3, 9999999)
         if fpos or vpos or spos then
            s = s<fpos,vpos,spos>
            rmv = 0
         end else
            rmv = var.info<2,2> + 0
         end

         if dump.path = '' then
            n.len = len(s)
            gosub show.np
            message := 'String (' : n.len : ' bytes'
            if rmv then message := ',R=' : rmv
            message := '): "' : s : '"'  ;* 0307
         end

      case var.type = V$FILE.REF
         message := 'File: ' : var.info<3>
         n = var.info<2>
         begin case
            case n = FVAR.DIRECTORY
               message := ' (Directory)'
            case n = FVAR.DYNAMIC
               message := ' (Dynamic)'
            case n = FVAR.SEQ
               message := ' (Sequential)'
         end case

      case var.type = V$ARRAY
         var.flags = var.info<4>
         message := 'Array: '
         rows = var.info<2> + 0
         cols = var.info<3> + 0
         if cols then message := 'Dim (' : rows : ',' : cols :')'
         else message := 'Dim (' : rows :')'
         array.offset = 0
         array.name = var.name

      case var.type = V$COMMON
         message := 'Common: '

      case var.type = V$IMAGE
         message := 'Image: '

      case var.type = V$BTREE
         message := 'BTree: '

      case var.type = V$SELLIST
         s = field(var.info, @fm, 3, 99999)
         if fpos or vpos or spos then s = s<fpos,vpos,spos>
         if dump.path = '' then
            s = s[1,10240]
            gosub show.np
            message := 'Select list (' : var.info<2> : ' bytes): "' : s : '"'
         end

      case var.type = V$SOCK
         message := 'Socket: '

      case var.type = V$LOCALVARS
         message := 'Local: '

      case var.type = V$OBJ
         message := 'Object: ' : var.info<2>

      case var.type = V$PERSISTENT
         message := 'Persistent: '

      case var.type = V$JSON.BOOLEAN
         s = var.info<2>
         message := 'Boolean: ' : s

      case var.type = V$JSON.NULL
         message := 'Null'

      case var.type = V$COLL
         * Field 2 is C or A, field 3 the number of elements, then the JSON text
         s = field(var.info, @fm, 4, 9999999)
         n = var.info<3> + 0
         message := if var.info<2> = 'A' then 'Array' else 'Collection'
         message := ' (' : n : ' element' : (if n = 1 then '' else 's') : ')'
         if dump.path = '' then
            t.len = len(s)
            s = s[1, 10240]
            gosub show.np
            message := ': ' : s
            if t.len > 10240 then message := '...'
         end
   end case

   if dump.path = '' then
      gosub emit.msg
   end else
      message = ''
      openseq dump.path overwrite to dump.f on error
         message = sysmsg(2105, status())   ;* Error %1 opening file
      end else
         if status() then
            message = sysmsg(2105, status())   ;* Error %1 opening file
         end
      end

      if message = '' then
         writeblk s to dump.f on error
            message = sysmsg(1435, status(), os.error())   ;* Write error %1 (os.error %2)
         end else
            message = sysmsg(1435, status(), os.error())   ;* Write error %1 (os.error %2)
         end
         close dump.f
      end

      if message # '' then gosub emit.err.msg
   end

   return

* ======================================================================
* Watch variable

watch:
   watch.var.name = var.name
   gosub equate.resolve
   if equ.const then
      message = sysmsg(6718) ;* Variable not defined: a token of a constant is not a variable
      gosub emit.err.msg
      return
   end

   begin case
      case var.name matches "0X'('1N0N')'"
         var.row = matchfield(var.name, "0X'('0N')'", 3)
         var.name = field(var.name, '(', 1)
         var.dim = 1

      case var.name matches "0X'('1N0N','1N0N')'"
         var.row = matchfield(var.name, "0X'('0N','0N')'", 3)
         var.col = matchfield(var.name, "0X'('0N','0N')'", 5)
         var.name = field(var.name, '(', 1)
         var.dim = 2

      case 1 
         var.dim = 0
   end case

   find var.name in symbols(idx) setting f, v, sv else
      message = sysmsg(6718) ;* Variable not defined"
      gosub emit.err.msg
      return
   end

   if f = 1 then  ;* Local variable
      var.no = v - 1  ;* Form variable number
   end else       ;* Common variable
      var.no = symbols(idx)<f,1> + shift(sv, -16)
   end

   var.info = dbg.info(1, var.no)

   if var.dim then
      if var.info<1> # V$ARRAY then
         message = sysmsg(6719) ;* Index not allowed with scalar variable
         gosub emit.err.msg
         return
      end

      rows = var.info<2> + 0
      cols = var.info<3> + 0
      if var.dim = 1 then  ;* One index value
         if cols and var.row # 0 then
            message = sysmsg(6720) ;* Two dimensional matrix requires two index values
            gosub emit.err.msg
            return
         end
         if var.row > rows then
            message = sysmsg(6725) ;* Index out of range
            gosub emit.err.msg
            return
         end
         arm.no = var.no ; arm.index = var.row ; gosub arm.watch
      end else  ;* Two index values
         if cols = 0 then
            message = sysmsg(6721) ;* Single dimensional matrix requires one index value
            gosub emit.err.msg
            return
         end
         if var.col < 1 or var.col > cols then
            message = sysmsg(6722) ;* Column index out of range
            gosub emit.err.msg
            return
         end
         if var.row < 1 or var.row > rows then
            message = sysmsg(6723) ;* Row index out of range
            gosub emit.err.msg
            return
         end
         arm.no = var.no ; arm.index = cols * (var.row - 1) + var.col ; gosub arm.watch
      end
   end else    ;* Scalar variable
      arm.no = var.no ; arm.index = 0 ; gosub arm.watch
   end

   return

* ======================================================================
* ARM.WATCH  -  Start watching variable arm.no (element arm.index of a matrix, 0 for a scalar), with the condition
* that PARSE.WATCH.CONDITION found, if any

arm.watch:
   watch.var.no = arm.no
   watch.index = arm.index
   watch.op = watch.op.new
   watch.val = watch.val.new
   gosub dbg.watch(arm.no, arm.index)
   return

* ======================================================================
* PARSE.WATCH.CONDITION  -  WATCH var {op value}.  Sets watch.op.new and watch.val.new (null for a plain WATCH) and
* watch.cond.ok false, with the unrecognised command message, when there is an operator that is not one of the
* relational operators or MATCHES, or no value after it.  LIKE and UNLIKE are not supported.

parse.watch.condition:
   watch.op.new = '' ; watch.val.new = '' ; watch.cond.ok = @true
   w.op = upcase(field(command, ' ', 3))
   if w.op = '' then return

   if not(index(',=,EQ,#,NE,<,LT,>,GT,<=,LE,>=,GE,MATCHES,MATCH,', ',' : w.op : ',', 1)) then
      message = sysmsg(6709) ;* Unrecognised command
      gosub emit.err.msg
      watch.cond.ok = @false
      return
   end

   w.val = trim(field(command, ' ', 4, 999999))
   if w.val = '' then
      message = sysmsg(6709) ;* Unrecognised command
      gosub emit.err.msg
      watch.cond.ok = @false
      return
   end

   * A quoted value is that text; anything else is taken as typed

   q = w.val[1, 1]
   if (q = '"' or q = "'") and len(w.val) > 1 and w.val[len(w.val), 1] = q then w.val = w.val[2, len(w.val) - 2]

   watch.op.new = w.op
   watch.val.new = w.val
   return

* ======================================================================
* WATCH.TEST  -  Is the watched variable's new value one that the WATCH condition wants?  Sets watch.met.  A WATCH without
* a condition, a value that cannot be read (an array, a file...) and an element the variable no longer has all count as met,
* so the program stops as it always did.

watch.test:
   watch.met = @true
   if watch.op = '' then return

   w.info = dbg.info(1, watch.var.no)
   if watch.index then w.info = dbg.info(2, watch.index)
   w.type = w.info<1> + 0
   begin case
      case w.type = V$INTEGER or w.type = V$FLOATNUM
         w.now = w.info<2>
      case w.type = V$STRING
         w.now = field(w.info, @fm, 3, 9999999)
      case 1
         return
   end case

   w.want = watch.val
   begin case
      case watch.op = '=' or watch.op = 'EQ' ; watch.met = (w.now = w.want)
      case watch.op = '#' or watch.op = 'NE' ; watch.met = (w.now # w.want)
      case watch.op = '<' or watch.op = 'LT' ; watch.met = (w.now < w.want)
      case watch.op = '>' or watch.op = 'GT' ; watch.met = (w.now > w.want)
      case watch.op = '<=' or watch.op = 'LE' ; watch.met = (w.now <= w.want)
      case watch.op = '>=' or watch.op = 'GE' ; watch.met = (w.now >= w.want)
      case 1 ; watch.met = (w.now matches w.want)     ;* MATCHES
   end case
   return

* ======================================================================
* Set variable

setvar:
   gosub equate.resolve
   if equ.const then
      message = sysmsg(6718) ;* Variable not defined: a token of a constant is not a variable
      gosub emit.err.msg
      return
   end
* 16 Oct 26 dm - QM4 Fixes 239: the value may be an equate token that stands for a constant (a string, a number or CHAR(n)), as the
*   name may be one.  A token of a variable is not a value here, so it is left to be refused as "Illegal value" as it was.
   set.token.done = @false
   if equates(idx) # '' and new.value # '' and not(index('"' : "'" : '\', new.value[1,1], 1)) and not(num(new.value)) then
      set.save.name = var.name
      var.name = new.value
      gosub equate.resolve
      if equ.const then
         begin case
            case equ.def[1,1] = '3' ; new.value = char(equ.body + 0)
            case equ.def[1,1] = '1' and num(equ.body) ; new.value = equ.body + 0
            case 1 ; new.value = equ.body
         end case
         set.token.done = @true
      end
      var.name = set.save.name
   end

   c = new.value[1,1]
   begin case
      case set.token.done
         null

      case (c = '"' or c = "'" or c = '\') and len(new.value) > 1 and new.value[1] = c
         new.value = new.value[2,len(new.value)-2]

      case num(new.value) and new.value # ''
         new.value = new.value + 0

      case 1
         message = "Illegal value"
         gosub emit.err.msg
         return
   end case

   begin case
      case var.name matches "0X'('1N0N')'"
         var.row = matchfield(var.name, "0X'('0N')'", 3)
         var.name = field(var.name, '(', 1)
         var.dim = 1

      case var.name matches "0X'('1N0N','1N0N')'"
         var.row = matchfield(var.name, "0X'('0N','0N')'", 3)
         var.col = matchfield(var.name, "0X'('0N','0N')'", 5)
         var.name = field(var.name, '(', 1)
         var.dim = 2

      case 1 
         var.dim = 0
   end case

   find var.name in symbols(idx) setting f, v, sv else
      message = sysmsg(6718) ;* Variable not defined
      gosub emit.err.msg
      return
   end

   if f = 1 then  ;* Local variable
      var.no = v - 1  ;* Form variable number
   end else       ;* Common variable
      var.no = symbols(idx)<f,1> + shift(sv, -16)
   end

   var.info = dbg.info(1, var.no)
   var.type = var.info<1>

   if var.dim then
      var.flags = var.info<4>

      if var.type # V$ARRAY then ;* 0530
         message = sysmsg(6719) ;* Index not allowed with scalar variable
         gosub emit.err.msg
         return
      end

      rows = var.info<2> + 0
      cols = var.info<3> + 0
      if var.dim = 1 then  ;* One index value
         if cols and var.row # 0 then
            message = sysmsg(6720) ;* Two dimensional matrix requires two index values
            gosub emit.err.msg
            return
         end
         if var.row > rows then
            message = sysmsg(6725)  ;* Index out of range
            gosub emit.err.msg
            return
         end
         gosub dbg.set(var.no, var.row, new.value)
      end else  ;* Two index values
         if cols = 0 then
            message = sysmsg(6721) ;* Single dimensional matrix requires one index value
            gosub emit.err.msg
            return
         end
         if var.col < 1 or var.col > cols then
            message = sysmsg(6722) ;* Column index out of range
            gosub emit.err.msg
            return
         end
         if var.row < 1 or var.row > rows then
            message = sysmsg(6723) ;* Row index out of range
            gosub emit.err.msg
            return
         end
         gosub dbg.set(var.no, cols * (var.row - 1) + var.col, new.value)
      end
   end else    ;* Scalar variable
      gosub dbg.set(var.no, 0, new.value)
   end

   return

* ======================================================================
* Check line looks executable
* In:
*   n  = line number
* Out:
*   n  = unchanged
*   ok = result

check.debugable:
   gosub get.source.line

   s = upcase(trimf(s<1>))
   c = s[1,1]
   s = field(s, ' ', 1)
   ok = @false
   begin case
      case s = ''
      case c = '*' or c = '!' or s = 'REM'
      case s = '$'
      case s = 'PROGRAM' or s = 'SUBROUTINE' or s = 'FUNCTION'
      case s = 'EQU' or s = 'EQUATE'
      case 1
         ok = @true
   end case

   return

* ======================================================================
* THE IDE'S BREAKPOINTS  (S.98 H2, idebrk.h)
*
* The IDE arms the named common /idebrk/ before it runs "debug file record" (F7): the pathname of the source record it compiled (ibk.path), the lines the person marked (ibk.in) and whether to
* run on to the first of them (ibk.go).  At the FIRST stop of that run this program checks that the program it stopped in is the one named, clears both lists of breakpoints, sets the lines the
* kernel says begin a statement and, with ibk.go, runs on without showing anything.  It writes the lines that have a breakpoint back to ibk.out as the person works and when the program is aborted
* or stopped; when it dies on the way the IDE finds ibk.mode still LIVE and takes what was last written.  Nothing is opened, run or sent anywhere with any of it: the values are compared and counted.
* Every value is tested before it is used (the first of this runs after the alternate screen was entered, and nothing may stop the program there).

* Out: ib.on, true when the IDE armed this run and the debugger is the one of a session with a terminal (a phantom is never handed anything)
ibk.armed:
   ib.on = @false
   if not(phantom) then
      if ibk.mode matches '1N' then
         if ibk.mode = IBK.K.ARMED then ib.on = @true
      end
   end
   return

* In: ib.pa, ib.pb (two source pathnames: a directory, the separator, the record id).  Out: ib.eq, true when the directories are the same text and the record ids are the same in either case.
* The directory is compared as it is (a file of another directory is another program whatever its name); the id folds, as the compiler is given it as typed and the file may fold names.
ibk.same:
   ib.eq = @false
   ib.pa := ''
   ib.pb := ''
   ib.ca = count(ib.pa, @ds)
   ib.cb = count(ib.pb, @ds)
   if ib.ca > 0 and ib.ca = ib.cb then
      if (field(ib.pa, @ds, 1, ib.ca) : '|') = (field(ib.pb, @ds, 1, ib.cb) : '|') then
         ib.eq = ((downcase(field(ib.pa, @ds, ib.ca + 1)) : '|') = (downcase(field(ib.pb, @ds, ib.cb + 1)) : '|'))
      end
   end
   return

* The hand-over at the first stop.  In: idx, line, event (this program's arguments).  Out: ib.run, true when the program is to go on to its first breakpoint; ib.msgs, what to say if it is not.
ibk.apply:
   ibk.mode = IBK.K.LIVE                         ;* taken: a later stop of this run does not apply it again
   ibk.out = ''
   ibk.bad = ''
   ib.pa = program.src(idx)
   ib.pb = ibk.path
   gosub ibk.same
   if not(ib.eq) then
      * not the program the editor compiled: nothing is touched, so that a session that debugs another program (or a program that runs a debugger of its own) keeps what it has
      ibk.mode = IBK.K.IDLE
      ib.msgs<-1> = sysmsg(12722, convert(banned, replacements, ib.pa), convert(banned, replacements, ib.pb))
      return
   end
   gosub dbg.breakpoint(BRK$CLEAR, 0)            ;* the kernel's list holds 20 and was never emptied between the runs of one session; the text of this program is the other list
   breakpoints = ''
   ib.in = ibk.in : ''
   ib.cnt = dcount(ib.in, @fm)
   if ib.in = '' then ib.cnt = 0
   ib.good = ''
   ib.badl = ''
   for ib.i = 1 to ib.cnt
      ib.n = trim(ib.in<ib.i>)
      if ib.n matches '1N0N' then               ;* the same test the BRK command makes: a whole number, from 1 to the last line of the source
         ib.n += 0
         ib.set = @false
         begin case
            case ib.n < 1 or ib.n > lines(idx)
            case dcount(ib.good, @fm) >= MAX.BREAKPOINTS
            case 1
               locate ib.n in ib.good<1> setting ib.at then
                  ib.set = @true                ;* a line given twice
               end else
                  n = ib.n
                  src.idx = idx
                  gosub check.debugable         ;* the BRK command's own test of a line
                  if ok then
                     gosub dbg.breakpoint(BRK$ADD.LINE, ib.n)
                     if status() then           ;* the kernel found a statement that begins on that line; if not the breakpoint could never be reached
                        ib.good<-1> = ib.n
                        breakpoints<-1> = idx : '.' : ib.n
                        ib.set = @true
                     end else
                        gosub dbg.breakpoint(BRK$CLR.LINE, ib.n)
                     end
                  end
               end
         end case
         if not(ib.set) then ib.badl<-1> = ib.n
      end
   next ib.i
   ibk.bad = ib.badl
   ib.nset = dcount(ib.good, @fm)
   if ib.good = '' then ib.nset = 0
   gosub ibk.sync
   if ibk.go matches '1N' then
      if ibk.go # 0 and ib.nset > 0 and bitand(event, 3) = 0 then
         * a line the program is stopped on stays: the kernel looks at the DEBUG opcodes still to come, and a run on from here would never see it
         locate line in ib.good<1> setting ib.at else
            gosub dbg.breakpoint(BRK$RUN, 0)
            ib.run = @true
         end
      end
   end
   if not(ib.run) then
      if ib.nset > 0 then ib.msgs<-1> = sysmsg(12720, ib.nset)
      if ib.badl # '' then ib.msgs<-1> = sysmsg(12721, change(ib.badl, @fm, ' '))
   end
   return

* The lines that have a breakpoint now, ascending, in ibk.out: from the text list, and only those of the program the IDE named
ibk.sync:
   if ibk.mode matches '1N' then
      if ibk.mode = IBK.K.LIVE then
         ib.o = ''
         for ib.i = 1 to dcount(breakpoints, @fm)
            ib.b = breakpoints<ib.i>
            if ib.b matches '1N0N"."1N0N' then
               ib.x = field(ib.b, '.', 1) + 0
               ib.l = field(ib.b, '.', 2) + 0
               if ib.x >= 0 and ib.x <= last.program then
                  ib.pa = program.src(ib.x)
                  ib.pb = ibk.path
                  gosub ibk.same
                  if ib.eq then
                     ib.at = 0
                     for ib.j = 1 to dcount(ib.o, @fm)
                        if ib.o<ib.j> + 0 >= ib.l then
                           ib.at = ib.j
                           exit
                        end
                     next ib.j
                     begin case
                        case ib.at = 0
                           ib.o<-1> = ib.l
                        case ib.o<ib.at> + 0 = ib.l
                        case 1
                           ins ib.l before ib.o<ib.at>
                     end case
                  end
               end
            end
         next ib.i
         ibk.out = ib.o
      end
   end
   return

* What the hand-over did, said in the messages area once the source is shown
ibk.say:
   for ib.i = 1 to dcount(ib.msgs, @fm)
      message = ib.msgs<ib.i>
      gosub emit.msg
   next ib.i
   ib.msgs = ''
   return

