* DISPLAY.SOURCE

display.source.and.name:
   if sub.ref then
      display program.name(idx) : ", Line " : line : "." : sub.ref
   end else
      display program.name(idx) : ", Line " : line
   end

display.source:
   n = len(lines(src.idx))
   line.no.fmt = n : "R"
   src.width = src.cols - (GUTTER.W + n + 2)     ;* what is left of the source pane for the text: less the gutter, the number and its ': '

   if full.screen then
      * the bar: the program and its line, and at the right end the app and the audience, as the pages have them
      s = program.name(src.idx) : " : "
      if src.idx = idx then s := src.line : "." : sub.ref
      else s := src.line
      if kernel(K$ADMINISTRATOR, -1) then ds.aud = sysmsg(12808) else ds.aud = @logname : '@' : @who
      ds.app = 'debugger  ' : ds.aud : ' '
      * 8 Nov 26 (S.180): the menu bar's titles first (Run View Help: Esc or F10 opens it), then the program and its line
      gosub dbg.bar
      call $sl_menu('init', dm.bar, scr, '', dm.r)
      call $sl_menu('draw', dm.bar, scr, '', dm.r)
      ds.w = lay.w - len(ds.app) - dm.tw
      if ds.w > 1 then call $sl_put(scr, dm.tw, 0, fmt(s[1, ds.w - 1], ds.w : 'L'), title.attr)
      call $sl_put(scr, lay.w - len(ds.app), 0, ds.app, title.attr)

      if unassigned(syn.lang) then call $sl_syntax('index', 'sd.basic', '', '', '', syn.lang)     ;* the colour of SD BASIC; 0 if the library has no such language

      n = src.line - idiv(source.area.lines, 2) ;* First line to display
      if n < 1 then n = 1

      gosub get.source.line
* 20240121 mab remove hard coded hex character  
*       convert "	" to "   " in s  charactes where hex "A8" x 3
      convert char(9):Char(27) to char(168):char(168):char(168) in s

      * One row of the source pane for each line: the gutter (* a breakpoint, > the line about to run, in their styles), the number (in the breakpoint style when it has a
      * breakpoint) and the text, in the highlight style when it is the line about to run, else in the colours of the language; padded to the width of the pane
      for i = 1 to source.area.lines
      until keyready()
         if n <= lines(src.idx) then
            ds.mark = ' '
            ds.mc = source.attr
            numcode = num.attr
            ds.cur = (n = line and src.idx = idx)
            locate src.idx:'.':n in breakpoints<1> setting pos then
               numcode = breakpoint.source.attr
               ds.mark = '*'
               ds.mc = breakpoint.source.attr
            end else
               if ds.cur then
                  ds.mark = '>'
                  ds.mc = highlight.source.attr
               end
            end
            numtxt = fmt(n, line.no.fmt) : ': '
            tx = fmt(s<i>[1, src.width], src.width : 'L')
            if ds.cur then
               txtcode = str(highlight.source.attr, src.width)
            end else
               txtcode = ''
               if syn.lang and syn.on then
                  call $sl_syntax('line', syn.lang, s<i>, 0, ds.st2, ds.sty)
                  convert 'n' to source.attr in ds.sty          ;* what the language leaves plain is the pane's text, not the terminal's own ground
                  txtcode = ds.sty[1, src.width]
               end
               txtcode := str(source.attr, src.width - len(txtcode))
            end
            call $sl_put(scr, 0, SOURCE.AREA + i - 1, ds.mark : ' ' : numtxt : tx, ds.mc : source.attr : str(numcode, len(numtxt)) : txtcode)
         end else
            call $sl_put(scr, 0, SOURCE.AREA + i - 1, space(src.cols), source.attr)
         end
         n += 1
      next i
   end else     ;* Not full screen mode
      n = src.line
      gosub get.source.line
* 20240121 mab remove hard coded hex character  
*       convert "	" to "   " in s  charactes where hex "A8" x 3
      convert char(9):Char(27) to char(168):char(168):char(168) in s
      display fmt(src.line, line.no.fmt) : ": " : s<1>
   end

   return

* ======================================================================
* AI  (AI line stage 3, 24 Oct 26)  -  AI, or AI and a question, at the debugger's prompt, in the full-screen display when the AI is usable for the account.  The model is told where the
* program has stopped, the call stack and the source lines round the stop.  Nothing is sent until the person has seen EVERYTHING that is sent and chosen Send ($tk_ai 'ask'); the answer is
* words only (there is no text here to edit and a command is ignored); nothing in the program or the debugger is changed.

ai.run:
   ai.req = trim(command[3, 99999])
   if ai.req = '' then ai.req = sysmsg(12686)
   ai.page = 'This is the debugger of SD Core. The program is stopped.'
   ai.page<1, -1> = 'Program ' : program.name(src.idx) : ', line ' : src.line : '.'
   ai.st = system(1002)
   ai.stk = ''
   for ai.i = 2 to dcount(ai.st, @fm)
      ai.ss = ai.st<ai.i>
      ai.nm = ai.ss<1, 1>
      if ai.nm = '$cproc' then ai.nm = 'Command processor'
      ai.stk := (if ai.stk = '' then '' else '; ') : ai.nm
      for ai.j = 2 to dcount(ai.ss, @vm)
         if ai.ss<1, ai.j, 2> then ai.stk := ' @ ' : ai.ss<1, ai.j, 2>
      next ai.j
   next ai.i
   if ai.stk # '' then ai.page<1, -1> = 'The call stack, the innermost first: ' : ai.stk[1, 600]
   ai.page<1, -1> = 'The source around the stop (line number, then the text; > marks the line about to run):'
   ai.first = src.line - 25
   if ai.first < 1 then ai.first = 1
   ai.last = src.line + 25
   if ai.last > lines(src.idx) then ai.last = lines(src.idx)
   for ai.q = ai.first to ai.last
      n = ai.q
      gosub get.source.line
      ai.page<1, -1> = (if ai.q = src.line then '>' else ' ') : fmt(ai.q, '6R') : ' ' : s<1>[1, 120]
   next ai.q
   * 1 Nov 26: the page text above holds the program's source, so its origin is the source record's pathname (the wall refuses the source of a program of SD itself, and a source it cannot place)
   ai.org = 'path' : @vm : '' : @vm : program.src(src.idx)
   ai.actx = 'debugger' : @fm : 'debugger' : @fm : ai.page : @fm : '' : @fm : 0 : @fm : ai.req : @fm : command.line : @fm : '' : @fm : 1 : @fm : '' : @fm : 'nocmd' : @fm : '' : @fm : ai.org
   ai.ctx = ''
   ai.ctx<1> = lay.w                                       ;* TK.C.W
   ai.res = ''
   call $tk_ai('ask', ai.ctx, ai.actx, ai.res)
   gosub relayout                                          ;* the library put plain blanks back where its boxes were: the whole display is drawn again
   if ai.res<5> # '' then
      message = ai.res<5>
      gosub emit.msg
   end
   return

