* DISPLAY.SOURCE

display.source.and.name:
   if sub.ref then
      display program.name(idx) : ", Line " : line : "." : sub.ref
   end else
      display program.name(idx) : ", Line " : line
   end

display.source:
   n = len(lines(src.idx))
   line.no.fmt = n : "R"
   src.width = lay.w - (n + 3)

   if full.screen then
      s = program.name(src.idx) : " : "
      if src.idx = idx then s := src.line : "." : sub.ref
      else s := src.line
      call $sl_put(scr, 0, 0, fmt(s, wm1 : 'L'), title.attr)

      n = src.line - idiv(source.area.lines, 2) ;* First line to display
      if n < 1 then n = 1

      gosub get.source.line
* 20240121 mab remove hard coded hex character  
*       convert "	" to "   " in s  charactes where hex "A8" x 3
      convert char(9):Char(27) to char(168):char(168):char(168) in s

      * One row of the source area for each line: its number (in the breakpoint style when it has a breakpoint)
      * and its text (in the highlight style when it is the line about to run), padded to the width of the screen
      for i = 1 to source.area.lines
      until keyready()
         if n <= lines(src.idx) then
            numcode = source.attr
            locate src.idx:'.':n in breakpoints<1> setting pos then
               numcode = breakpoint.source.attr
            end
            numtxt = fmt(n, line.no.fmt) : ': '
            txtcode = source.attr
            if n = line and src.idx = idx then txtcode = highlight.source.attr
            tx = fmt(s<i>[1, src.width], src.width : 'L')
            call $sl_put(scr, 0, SOURCE.AREA + i - 1, numtxt : tx, str(numcode, len(numtxt)) : str(txtcode, src.width))
         end else
            call $sl_put(scr, 0, SOURCE.AREA + i - 1, space(lay.w), source.attr)
         end
         n += 1
      next i
   end else     ;* Not full screen mode
      n = src.line
      gosub get.source.line
* 20240121 mab remove hard coded hex character  
*       convert "	" to "   " in s  charactes where hex "A8" x 3
      convert char(9):Char(27) to char(168):char(168):char(168) in s
      display fmt(src.line, line.no.fmt) : ": " : s<1>
   end

   return

