$internal
subroutine $debug(prog.id, dtm, line, sub.ref, event)
$catalog $DEBUG

$flags debugger

$include keys.h
$include keyin.h
$include debug.h
$include idebrk.h
$include syscom.h

$include int$keys.h
$include header.h
$include sl.h
$include tk.h
$include err.h

deffun atvar(name) calling "!atvar"
deffun dbg.atvar(name) local
deffun dbg.info(mode, qualifier) local

$define SOURCE.AREA            1
$define LAY.WIDTH            140       ;* what the full-screen display is laid out for (a bigger window is used whole)
$define LAY.DEPTH             43       ;* 1 Nov 26 (S.98): the toolkit's floor; the foot (status line, border, key row) is three rows below the command line
$define AUTO.WIDTH            48       ;* the Autos pane's width; a window wider than 140 gives the source the rest
$define GUTTER.W               2       ;* the source's gutter: a mark (* a breakpoint, > the line about to run) and a blank, before the line number

   gosub read.layout                    ;* lay.w by lay.h: the window, and never less than LAY.WIDTH by LAY.DEPTH
   guard.left = @false                  ;* the user left from the cursor lock, in a place that cannot leave at once
   msg.prefix = ''
   if data.lines < 5 then data.lines = DATA.AREA.LINES      ;* a common block starts at 0
   gosub set.geometry
   return.key = seq(pterm(PT$INEWLINE,''))
   phantom = bitand(event, 0x80000000) # 0

   * On a terminal that has an ALTERNATE screen the debugger takes the whole of it: the program's own screen is kept
   * by the terminal and comes back when the debugger lets go.  alt.on is true between the two (initialise enters it
   * itself the first time, to paint on it).  A terminal without one, or a session with no terminal, gets line mode.
   * 2 Nov 26 (S.98 H3): a terminal with none but with cup and clear gets the same display on the MAIN screen (main.on between take.main and give.main): the program's own text is
   *   cleared when the debugger comes up and what the screen library knows of the program's screen is drawn again when it lets go.  The screen is taken only once this stop is known
   *   to be shown (after the IDE's hand-over and a conditional WATCH may have sent the program straight on).
   alt.on = @false
   main.on = @false
   if ibk.mode + 0 = IBK.K.ARMED then debug.initialised = @false     ;* 2 Nov 26 (S.98 H2): CPROC does this before each command; an IDE session never passes through it, and a run-on in the 2nd run of a session ran to the end
   if not(debug.initialised) then gosub initialise

   alt.screen = full.screen and not(phantom) and alt.able
   if alt.screen and not(alt.on) then
      display terminfo('smcup') : @(-1) :
      alt.on = @true
      ibk.alt = 1                              ;* S.98 H2: the IDE gives the main screen back if this program dies before it does
   end

   * Find program details

   for idx = 0 to last.program
      if program.id(idx) = prog.id then goto found.program
   next idx

   gosub allocate.new.program

found.program:
   case.sensitive = bitand(program.flags(idx), HDR.CASE.SENSITIVE)

   * S.98 H2: the breakpoints the IDE handed over (idebrk.h), at the first stop of the run it armed.  Before the theme and the layout; nothing in it can stop the program (every value is tested before it is
   * used: a fault here would leave the terminal on the alternate screen, which ibk.alt lets the IDE repair only after the fact)
   ib.msgs = ''
   ib.run = @false
   gosub ibk.armed                              ;* ib.on: this run was armed by the IDE and this is the debugger of a session with a terminal
   if ib.on then
      gosub ibk.apply
      if ib.run then goto exit.debug            ;* the run goes on to the first breakpoint without showing anything, as a WATCH whose condition is not met does
   end

   if alt.screen then gosub theme.in           ;* the library's styles for what follows (given back at exit.debug)
   if alt.screen then                         ;* a fresh alternate screen: the frame is drawn and the messages of the last stop are shown again
      gosub paint.layout
      gosub paint.data.area
   end

   * A WATCH with a condition (WATCH var op value, 14 Oct 26, openQM 45): the variable was assigned, but if the new value is not
   * one the condition wants the program goes straight on, as the RUN command would, without showing anything

   if bitand(event, DE$WATCH) and watch.op # '' then
      gosub watch.test
      if not(watch.met) then
         gosub dbg.breakpoint(BRK$RUN, 0)
         goto exit.debug
      end
   end

   if full.screen and not(alt.able) then       ;* S.98 H3: this stop is to be shown: the main screen is taken (the library's styles after it, so that the program's are still the ones in force when it reads them)
      gosub take.main
      gosub theme.in
      gosub paint.layout
      gosub paint.data.area
   end

   * ------------------------------------------------------------
   * Display source program window

   src.idx = idx
   src.line = line
   auto.prev = auto.here                       ;* the Autos pane: the line the debugger last stopped at, and this one
   auto.here = idx : ':' : line
   gosub display.source
   if full.screen then gosub refresh.panes
   gosub ibk.say                               ;* S.98 H2: what the hand-over did (null when it was not asked for)

   if bitand(event, DE$WATCH) then
      message = sysmsg(6700, watch.var.name) ;* Watched variable %1 has changed
      gosub emit.msg

      var.name = watch.var.name
      dump.path = ''    ;* 0499
      gosub display.variable
   end

   * ------------------------------------------------------------
   * Command processing loop

   done = @false
   prompt ""

   last.command = ''

   loop
      gosub get.input
      dump.path = ''

      * A blank line repeats the last command, unless it is the keystroke
      * that walks an array or the source (11 Oct 26 dm, openQM ref 21)

      if command = '' then
         if array.offset < 0 and src.pos = 0 and last.command # '' then command = last.command
      end else
         last.command = command
      end

      if command = '' then
         if array.offset >= 0 then  ;* Show next element
            if array.offset > 0 and cols then
               hi = cols * rows
               n = array.offset - 1
               message = array.name : '(' : idiv(n, cols) + 1 : ',' : rem(n, cols) + 1 : ') = '
            end else
               hi = rows
               message = array.name : '(' : array.offset : ') = '
            end
            gosub display.array.element
            if array.offset > hi then array.offset = -1
         end else if src.pos # 0 then
            src.line = src.pos
            for src.ct = 1 to src.incr
            until src.line > lines(src.idx)
               gosub display.source
               src.line += 1
               src.pos = src.line
            next src.ct
         end
      end else
         array.offset = -1  ;* Kill array walking mode...
         src.pos = 0        ;* ...and "source walk"

         n = seq(command[1,1])
         if n >= 128 then      ;* Function key
            begin case
               case n = K$F1             ;* Help
                  gosub help

               case n = K$F2             ;* Abort
                  gosub abort.debug

               case n = K$F3             ;* Stop
                  gosub stop.debug

               case n = K$F4 and full.screen and not(phantom)  ;* Show user screen
                  gosub view

               case n = K$F5 and full.screen   ;* Refresh (8 Nov 26, S.179: F5 refreshes on every page; run is F9)
                  gosub relayout

               case n = K$F9             ;* Free run (F5 until 8 Nov 26, S.179)
                  gosub dbg.breakpoint(BRK$RUN, 0)
                  done = @true

               case n = K$F7             ;* Step debug element
                  n = 1
                  gosub step

               case n = K$F8             ;* Step line
                  n = 1
                  gosub step.line

               case n = K$F11 and kernel(K$INTERNAL, -1)
                  gosub dbg.breakpoint(BRK$TRACE, 0)
                  done = @true

               case n = K$CTRL.F7        ;* Run to parent
                  gosub dbg.breakpoint(BRK$PARENT, 0)
                  done = @true

               case n = K$CTRL.F8        ;* Run to parent program
                  gosub dbg.breakpoint(BRK$PARENT.PROGRAM, 0)
                  done = @true

               case n = K$CTRL.PAGE.UP and full.screen
                  src.line = 1
                  gosub display.source

               case n = K$CTRL.PAGE.DOWN and full.screen
                  src.line = lines(src.idx)
                  gosub display.source

               case n = K$PAGE.UP and full.screen
                  src.line -= source.area.lines - 1
                  if src.line < 1 then src.line = 1
                  gosub display.source

               case n = K$PAGE.DOWN and full.screen
                  src.line += source.area.lines - 1
                  if src.line > lines(src.idx) then src.line = lines(src.idx)
                  gosub display.source

               case 1
                  display @sys.bell :
            end case
         end else                              ;* Text command
            if full.screen then
               message = prefix : command[1,wm1]
               gosub emit.msg
            end

            command = trimf(trimb(command))
            u.command = upcase(command)
            action = matchfield(u.command, "0A0X", 1)

            begin case
               case action = 'HELP' or u.command = '?'
                  gosub help

               case u.command = '^'          ;* 16 Oct 26 (QM4 Fixes 550): non-printing characters as ^nnn, or as ? again
                  expand.np = not(expand.np)
                  message = sysmsg(if expand.np then 12393 else 12394)
                  gosub emit.msg

               case action = 'WINDOW' or action = 'WIN'     ;* 16 Oct 26 (QM4 Fixes 193)
                  new.lines = trim(matchfield(u.command, '0A0X', 2))
                  begin case
                     case not(full.screen)
                        message = sysmsg(6702) ;* Command format error
                        gosub emit.err.msg
                     case not(new.lines matches '1N0N') or new.lines < 5 or new.lines > MAX.DATA.AREA.LINES
                        message = sysmsg(12395) ;* The data area must be 5 to 15 lines
                        gosub emit.err.msg
                     case 1
                        gosub new.window
                  end case

               case u.command[1] = '/' or u.command[1] = '?' or ~
                    u.command[1,1] = '/' or u.command[1,1] = '?'
                  begin case
                     case len(u.command) > 1
                        if u.command[1] = '/' or u.command[1] = '?' then
                           var.name = command[1, len(u.command) - 1]
                        end else
                           var.name = command[2, 9999]
                        end
                        if var.name = '*' then
                           gosub display.all           ;* 16 Oct 26 (QM4 Fixes 67): /* shows every variable of the program
                        end else
                           gosub fold.var.name
                           last.display = var.name
                           gosub display.variable
                        end

                     case last.display # ''
                        var.name = last.display
                        gosub display.variable
                  end case

               case action = 'AI' and ai.ok
                  gosub ai.run

               case action = "ABORT" or action = "Q" or action = "QUIT"
                  gosub abort.debug

               case action = "BRK"
                  n = trim(matchfield(u.command, '0A0X', 2))
                  begin case
                     case n = ''
*                       18 Oct 26 Windows port - from Linux bc2f159 (11 Oct 26): (openQM ref 142): with no line number,
*                       list the breakpoints that are set, as module.line
                        if breakpoints = '' then
                           message = sysmsg(12063) ;* No breakpoints are set
                        end else
                           message = sysmsg(12062, change(breakpoints, @fm, ' ')) ;* Breakpoints: xx
                        end
                        gosub emit.msg

                     case not(n matches '1N0N')
                        message = sysmsg(6702) ;* Command format error
                        gosub emit.err.msg

                     case n = 0 or n > lines(src.idx)
                        message = sysmsg(6703) ;* Invalid source line number
                        gosub emit.err.msg

                     case dcount(breakpoints, @fm) = MAX.BREAKPOINTS
                        message = sysmsg(6704) ;* Too many breakpoints defined
                        gosub emit.err.msg

                     case 1
                        locate src.idx:'.':n in breakpoints<1> setting i then
                           message = sysmsg(6705) ;* Specified breakpoint already set
                           gosub emit.err.msg
                        end else
                           gosub check.debugable
                           if ok then
                              breakpoints<-1> = src.idx:'.':n
                              gosub dbg.breakpoint(BRK$ADD.LINE, n)
                              if full.screen then gosub display.source
                           end else
                              message = sysmsg(6706) ;* Cannot set breakpoint on this line
                              gosub emit.err.msg
                           end
                        end
                  end case

               case action = 'CLR'
                  n = trim(matchfield(u.command, '0A0X', 2))
                  begin case
                     case n = ''
                        gosub dbg.breakpoint(BRK$CLEAR, 0)
                        breakpoints = ''
                        if full.screen then gosub display.source

                     case not(n matches "1N0N")
                        message = sysmsg(6702) ;* Command format error
                        gosub emit.err.msg

                     case n = 0 or n > lines(src.idx)
                        message = sysmsg(6703) ;* Invalid source line number
                        gosub emit.err.msg

                     case 1
                        locate src.idx:'.':n in breakpoints<1> setting i then
                           del breakpoints<i>
                           gosub dbg.breakpoint(BRK$CLR.LINE, n)
                           if full.screen then gosub display.source
                        end else
                           message = sysmsg(6707) ;* Specified breakpoint not found
                           gosub emit.err.msg
                        end
                  end case

               case action = 'DUMP'
                  command = trim(command) ;* Tidy up embedded spaces
                  var.name = field(command, ' ', 2)
                  gosub fold.var.name
                  dump.path = field(command, ' ', 3, 999) ;* Allow spaces in path
                  if dump.path = '' then
                     message = sysmsg(6702) ;* Command format error
                     gosub emit.err.msg
                  end else
                     gosub display.variable
                  end

               case action = 'EP'
                  gosub dbg.breakpoint(BRK$PARENT.PROGRAM, 0)
                  done = @true

               case action = 'EX' or action = 'EXIT'
                  gosub dbg.breakpoint(BRK$PARENT, 0)
                  done = @true

               case action = 'G' or action = 'GOTO'
                  s = trim(u.command[2,9999])
                  if s matches '1N0N' and s <= lines(src.idx) then
                     gosub dbg.breakpoint(BRK$GOTO.LINE, s)
                     if status() then
                        line = status()
                        sub.ref = 0
                        src.line = line
                        gosub display.source
                     end else
                        message = sysmsg(6726)  ;* Cannot find source line
                        gosub emit.err.msg
                     end
                  end else
                     message = sysmsg(6703)  ;* Invalid source line number
                     gosub emit.err.msg
                  end

               case action = "R" or action = "RUN"
                  n = matchfield(u.command, '0X0N', 2)
                  if n = '' then
                     gosub dbg.breakpoint(BRK$RUN, 0)
                  end else
                     n += 0
                     gosub dbg.breakpoint(BRK$LINE, n)
                  end
                  done = @true

               case action = 'SET'
                  s = field(command, ' ', 2, 999999)
                  var.name = trimb(field(s, '=', 1))
                  if not(case.sensitive) then var.name = upcase(var.name)
                  new.value = trimb(trimf(field(command, '=', 2, 999999)))
                  gosub setvar

               case action = "S" or action = "STEP"
                  s = trim(matchfield(u.command, '0A0X', 2))
                  begin case
                     case s = ''
                        n = 1
                        gosub step.line

                     case s matches "1N0N"
                        n = s + 0
                        gosub step.line

                     case s matches "'.'1N0N"
                        n = matchfield(s, "'.'0N", 2)
                        gosub step

                     case 1
                        goto error
                  end case

               case action = "SRC"    ;* Adjust source window
                  s = trim(matchfield(u.command, '0A0X', 2))

                  if full.screen then
                     if s = '' then    ;* Reset to default display
                        src.idx = idx
                        src.line = line
                        gosub display.source
                     end else
                        u.command = s
                        s = field(u.command, " ", 1)
                        u.command = u.command[col2() + 1, 9999]
                        for i = 0 to last.program
                           if program.name(i) = s then
                              * Token is a program name  -  Switch display
                              src.idx = i
                              src.line = 1
   
                              s = field(u.command, " ", 1)
                              u.command = u.command[col2() + 1, 9999]
                           end
                        next i
   
                        begin case
                           case s = ""
                              null

                           case s matches "1N0N"             ;* Position to line
                              src.line = s + 0
* 20240121 mab use @VM not hard coded hex fd 
                           case s matches "'+'1N0N":@VM:"'-'1N0N"  ;* Relative position
                              src.line += s

                           case 1
                              message = sysmsg(6708) ;* Invalid SRC command
                              gosub emit.err.msg
                              continue
                        end case

                        if src.line < 1 then src.line = 1
                        if src.line > lines(src.idx) then src.line = lines(src.idx)
                        gosub display.source
                     end
                  end else   ;* Not full screen mode
                     begin case
                        case s = ''    ;* Display current line
                           src.idx = idx
                           src.line = line
                           gosub display.source.and.name

                        case s matches "1N0N"             ;* Display given line
                           src.line = s + 0
                           src.incr = 1
                           gosub display.source
                           src.pos = src.line + 1

                        case s matches "1N0N','1N0N"     ;* Display from given line
                           src.line = matchfield(s, "0N','0N",1) + 0
                           src.incr = min(matchfield(s, "0N','0N",3) + 0, @crthigh - 3)
                           for src.ct = 1 to src.incr
                           until src.line > lines(src.idx)
                              gosub display.source
                              src.line += 1
                              src.pos = src.line
                           next src.ct

                        case 1
                           message = sysmsg(6708) ;* Invalid SRC command
                           gosub emit.err.msg
                           continue
                     end case
                  end

               case action = "STACK"
                  gosub show.call.stack

               case action = "STOP"
                  gosub stop.debug

               case action = "TRACE" and kernel(K$INTERNAL, -1)
                  gosub dbg.breakpoint(BRK$TRACE, 0)
                  done = @true

               case action = "UW" or action = "UNWATCH"
                  watch.op = '' ; watch.val = ''
                  gosub dbg.watch(-1, 0)

               case (action = "V" or action = "VIEW") and full.screen and not(phantom)
                  gosub view

               case action = 'W' or action = 'WATCH'
                  var.name = field(command, ' ', 2)
                  if not(case.sensitive) then var.name = upcase(var.name)
                  gosub parse.watch.condition        ;* WATCH var op value (14 Oct 26, openQM 45)
                  if watch.cond.ok then gosub watch

               case 1
error:
                  message = sysmsg(6709) ;* Unrecognised command
                  gosub emit.err.msg
            end case
         end
      end
      gosub ibk.sync                                            ;* S.98 H2: the lines that have a breakpoint now go back to the IDE (a command may have set or cleared one)
      if full.screen and not(done) then gosub refresh.panes     ;* what the command changed: the Autos pane's values, the breakpoint count
   until done
   repeat

exit.debug:
   if full.screen then gosub theme.out
   gosub leave.screen

exit.loop:
   return to exit.loop

* **********************************************************************
* THEME.IN / THEME.OUT  -  The screen library's styles for the debugger's own screen.  The theme belongs to the
* debugged program, which has usually asked for none (mono): then, on a terminal with colour, the debugger
* uses the 'classic' theme while it is up, so that it looks as it always has; any other theme is the program's
* or the site's choice and is kept.  The library's context of the program is not touched: what is drawn goes
* through a context of the debugger's own.

theme.in:
   call $sl_theme('name', '', '', '', '', dbg.theme)
   dbg.themed = @false
   if dbg.theme = '' or dbg.theme = 'mono' then
      * S.98: the site's theme (SCREENTHEME of sd.conf), as the IDE and the pages have, else the classic one; a name that is no theme, or one this terminal cannot show, leaves classic
      call $sl_theme('site', '', '', '', '', dbg.site)     ;* 8 Nov 26 (S.179): the person's own theme first, then SCREENTHEME
      dbg.r = 2
      if dbg.site # '' and dbg.site # 'mono' then call $sl_theme('set', dbg.site, '', '', '', dbg.r)
      if dbg.r # 0 then call $sl_theme('set', 'classic', '', '', '', dbg.r)
      if dbg.r = 0 then dbg.themed = @true       ;* refused on a terminal with no colour: mono it stays
   end
   gosub scr.in
   return

* SCR.IN  -  The library's context of the debugger's own screen, and the style codes of what is drawn on it (the theme is in force already)
scr.in:
   call $sl_scr('get', scr)
   scr<SL.S.CLIP> = ''                           ;* a clip the program set is not the debugger's
   title.attr = 'a'                              ;* bar: the title and the command line
   command.attr = 'a'
   source.attr = 't'                             ;* text: the source
   highlight.source.attr = 'h'                   ;* highlight: the line about to run
   breakpoint.source.attr = 'k'                  ;* hotkey: a line with a breakpoint (underlined in mono)
   call $sl_theme('code', 'reverse', '', '', '', rev.attr)      ;* the status line
   call $sl_theme('code', 'gutter', '', '', '', num.attr)       ;* the line numbers
   call $sl_theme('code', 'header', '', '', '', head.attr)      ;* the Autos pane's title
   data.attr = source.attr                       ;* the messages and the Autos rows are text on the same ground as the source
   auto.attr = source.attr
   call $sl_theme('name', '', '', '', '', syn.th)
   syn.on = (syn.th # 'classic' and syn.th # 'mono')     ;* the colours of the language were chosen for the ground of blue, dark and light; classic's text ground is blue, which they do not carry
   return

* LEAVE.ALT  -  Give the terminal's main screen back (the program's), if the debugger was on the alternate one
leave.alt:
   if alt.on then
      display terminfo('rmcup') :
      alt.on = @false
      ibk.alt = 0
   end
   return

* ----------------------------------------------------------------------
* LEAVE.SCREEN  -  give the terminal back: the alternate screen, or the main screen as the program had it (S.98 H3).  After theme.out, so that the program's theme is the one in force
* when its screen is drawn again.

leave.screen:
   gosub leave.alt
   if main.on then gosub give.main
   return

* TAKE.MAIN  -  a terminal with no alternate screen: the main screen is cleared for the debugger.  Nothing of the program's is lost that the screen library holds: the debugger draws
* on a copy of the library's context (scr.in) and never writes it back, so the program's shadow, cursor, theme and mouse are as they were when give.main reads them again.  What the
* program PRINTed, and what was on the screen before, is not held by anyone, and goes.
take.main:
   main.on = @true
   call $sl_sgr('n', sq)
   display sq : @(-1) :
   return

* GIVE.MAIN  -  the screen of a program that owns the library's screen is drawn again from its shadow ($sl_repaint clears first and sets SL.S.SYNC, so that the program's next form
* writes what it believes is not shown), and the context is put back (that places the cursor, shown or hidden as the program left it).  Any other program gets a clear screen with the
* cursor on and the plain style: its PRINT output cannot be asked of the terminal.  The kept context is read again here, not remembered from take.main: the window may have been
* resized while the debugger was up.
give.main:
   main.on = @false
   call $sl_scr('get', ps)
   if ps<SL.S.OWNED> then
      call $sl_repaint(ps)
      call $sl_scr('put', ps)
   end else
      call $sl_sgr('n', sq)
      display @(-31) : sq : @(-1) :
   end
   return

theme.out:
   if dbg.themed then
      call $sl_theme('set', dbg.theme, '', '', '', dbg.r)
      if dbg.theme = '' then call $sl_theme('set', 'mono', '', '', '', dbg.r)
      dbg.themed = @false
   end
   return

* **********************************************************************
* EMIT.MSG

emit.err.msg:
   crt @sys.bell :

emit.msg:
   if msg.prefix # '' then            ;* the name /* is showing the value of (QM4 Fixes 67)
      message = msg.prefix : message
      msg.prefix = ''
   end
   if full.screen then
      ct = 0
      loop                           ;* 0309 Reworked this loop
      while len(message)
         for i = 2 to data.lines
            debug.data.area(i-1) = debug.data.area(i)
         next i
         debug.data.area(data.lines) = message[1,wm1]
         ct += 1
         if rem(ct, data.lines) = 0 then
            gosub paint.data.area
            loop
               call $sl_put(scr, 0, command.line, fmt(sysmsg(6710), wm1 : 'L'), command.attr)  ;* ---more---
               cur.x = len(sysmsg(6710))
               gosub wait.key
            while wk.relaid repeat
            s = upcase(wk.c)
            if key.quit then
               s = 'Q'
               guard.left = @true
            end
            call $sl_put(scr, 0, command.line, space(wm1), command.attr)
            if s = 'Q' or s = char(27) then exit
            ct = 0
         end

         message = message[wm1+1, 9999999]
      repeat
      gosub paint.data.area
   end else
      display message
   end

   return

paint.data.area:
   for i = 1 to data.lines
      call $sl_put(scr, 0, data.area + i - 1, fmt(debug.data.area(i), lay.w : 'L'), data.attr)
   next i
   return

* DISPLAY.ALL  -  /*  -  every variable of the program, locals first and then the common blocks it names, one to a line (a
*                 matrix or a collection says what it is; /name goes into it).  Hidden names (*Arg1) are left out.
display.all:
   all.shown = 0
   all.fields = dcount(symbols(idx), @fm)
   for all.f = 1 to all.fields
      all.values = dcount(symbols(idx)<all.f>, @vm)
      all.first = 2                    ;* in a common block's field the first value is the number of its first variable
      if all.f = 1 then all.first = 1
      for all.v = all.first to all.values
         all.subs = dcount(symbols(idx)<all.f, all.v>, @sm)
         for all.s = 1 to all.subs
            all.name = symbols(idx)<all.f, all.v, all.s>
            if all.name # '' and all.name[1,1] # '*' then
               var.name = all.name
               msg.prefix = all.name : '  '
               gosub display.variable
               msg.prefix = ''
               all.shown += 1
            end
         next all.s
      next all.v
   next all.f
   if all.shown = 0 then
      message = sysmsg(12396)         ;* There are no variables to show
      gosub emit.msg
   end
   return

* SHOW.NP  -  s as it is to be shown: a non-printing character is a ? or, after the ^ command, ^ and its decimal number  (16 Oct 26)
show.np:
   if expand.np then
      np.t = ''
      for np.i = 1 to len(s)
         np.c = seq(s[np.i, 1])
         if np.c < 32 or np.c = 127 then np.t := '^' : np.c else np.t := s[np.i, 1]
      next np.i
      s = np.t
   end else
      s = convert(banned, replacements, s)
   end
   return

* SET.GEOMETRY  -  The rows and columns of the display from lay.w, lay.h and data.lines (S.98): the bar on row 0; the source and, at its right, the Autos pane, down to
*                  the rule above the messages; the messages (the data area); the command line; and the foot, three rows (status line, border, function keys).
set.geometry:
   wm1 = lay.w - 1
   key.line = lay.h - 1
   border.line = lay.h - 2
   status.line = lay.h - 3
   command.line = lay.h - 4
   data.area = command.line - data.lines
   source.area.lines = data.area - 2             ;* the row above the messages is their rule
   auto.x = lay.w - AUTO.WIDTH                   ;* the Autos pane's first column
   src.cols = auto.x - 1                         ;* the source's width: the column before the Autos pane is the rule between them
   return

* The bar, the source and Autos areas, the messages, the command line and the foot, in the library's styles (the caller has the theme in)
paint.layout:
   call $sl_put(scr, 0, 0, space(lay.w), title.attr)
   call $sl_line('v', 0, vc)
   call $sl_line('h', 0, hc)
   for i = SOURCE.AREA to SOURCE.AREA + source.area.lines - 1
      call $sl_put(scr, 0, i, space(src.cols), source.attr)
      call $sl_put(scr, src.cols, i, vc, source.attr)             ;* the rule between the source and the Autos pane
      call $sl_put(scr, auto.x, i, space(lay.w - auto.x), auto.attr)
   next i
   call $sl_put(scr, 0, data.area - 1, str(hc, lay.w), source.attr)   ;* the rule above the messages
   for i = data.area to command.line - 1
      call $sl_put(scr, 0, i, space(lay.w), data.attr)
   next i
   call $sl_put(scr, 0, command.line, space(lay.w), command.attr)
   gosub paint.foot
   return

* PAINT.FOOT  -  The status line (reverse), the border and the function-key row, as the toolkit's pages have them: the key row is made from a key table by $tk_keys and $tk_fkeys,
*                and the status line says what the display cannot show beside the source, how many breakpoints there are and which variable is watched.
paint.foot:
   fo.n = 0
   for fo.i = 1 to dcount(breakpoints, @fm)
      if breakpoints<fo.i> matches '1N0N"."1N0N' then fo.n += 1
   next fo.i
   fo.t = '[Command]  breakpoints ' : fo.n
   if watch.var.name # '' and watch.var.name # 0 then fo.t := '  watching ' : watch.var.name
   call $sl_put(scr, 0, status.line, fmt(fo.t[1, lay.w], lay.w : 'L'), rev.attr)
   call $sl_line('h', 0, hc)
   call $sl_put(scr, 0, border.line, str(hc, lay.w), source.attr)
   gosub key.text
   call $sl_put(scr, 0, key.line, key.row, title.attr)
   return

* KEY.TEXT  -  The text of the function-key row in key.row.  Its table lists the keys the command loop acts on (the case n = K$... lines of the loop); a label cannot name a key the loop ignores.
key.text:
   kr.keys = ''
   call $tk_keys('add', kr.keys, 'f1', 'help', 'help', '', '')
   call $tk_keys('add', kr.keys, 'f2', 'find', 'find', '', '')          ;* 9 Nov 26 (S.186): Find an action, as on every page (Abort is on the Run menu)
   call $tk_keys('add', kr.keys, 'f3', 'stop', 'stop', '', '')
   call $tk_keys('add', kr.keys, 'f4', 'screen', 'screen', '', '')
   call $tk_keys('add', kr.keys, 'f5', 'refresh', 'refresh', '', '')     ;* 8 Nov 26 (S.179): F5 refreshes on every page; run is F9
   call $tk_keys('add', kr.keys, 'f7', 'step', 'step', '', '')
   call $tk_keys('add', kr.keys, 'f8', 'line', 'line', '', '')
   call $tk_keys('add', kr.keys, 'f9', 'run', 'run', '', '')
   call $tk_keys('add', kr.keys, 'f10', 'menu', 'menu', '', '')
   call $tk_keys('add', kr.keys, 'ctrl-f7', 'parent', 'parent', '', '')
   call $tk_keys('add', kr.keys, 'ctrl-f8', 'program', 'program', '', '')
   kr.ctx = ''
   kr.ctx<TK.C.W> = lay.w
   call $tk_fkeys(kr.ctx, kr.keys, '', key.row)
   return

* REFRESH.PANES  -  What changes with the program's variables and the commands: the Autos pane and the status line.  The source and the messages are drawn by their own routines.
refresh.panes:
   gosub paint.autos
   gosub paint.foot
   return

* PAINT.AUTOS  -  The Autos pane (S.98): the variables the line about to run uses, then those of the line the debugger last stopped at (the same program only: a variable number is the
*                 running frame's), the watched variable, and then the locals in the order the program declares them until the pane is full - one row each, name = value.  The pane is
*                 therefore empty only for a program that has no variable.  A row costs one dbg.info call; the drawing stops when a key is waiting.  The names on a line are the words
*                 outside strings and comments that are in the program's symbol table; a name the debugger does not know (a function, a label, a statement) is not there.
paint.autos:
   au.rows = source.area.lines - 1                  ;* the first row of the pane is its title
   au.w = lay.w - auto.x
   call $sl_put(scr, auto.x, SOURCE.AREA, fmt('Autos', au.w : 'L'), head.attr)
   au.names = ''                                    ;* the names, an @FM list, and in step with it au.nums, the variable numbers
   au.nums = ''
   for au.k = 1 to 2
      au.at = (if au.k = 1 then auto.here else auto.prev)
      if au.at # 0 and field(au.at, ':', 1) + 0 = idx and (au.k = 1 or au.at # auto.here) then
         gl.idx = idx
         gl.n = field(au.at, ':', 2) + 0
         gosub fetch.source.lines
         au.t = gl.s<1>
         gosub auto.words
         for au.wi = 1 to dcount(au.words, @fm)
            au.word = au.words<au.wi>
            gosub auto.add.word
         next au.wi
      end
   next au.k
   if watch.var.name # '' and watch.var.name # 0 then
      au.word = watch.var.name
      gosub auto.add.word
   end
   au.nv = dcount(symbols(idx)<1>, @vm)             ;* then the locals, in the order the program declares them
   for au.v = 1 to au.nv
   until dcount(au.names, @fm) >= au.rows
      au.nm = symbols(idx)<1, au.v, 1>
      if au.nm # '' and au.nm[1, 1] # '*' then
         locate au.nm in au.names<1> setting au.pos else
            au.names<-1> = au.nm
            au.nums<-1> = au.v - 1
         end
      end
   next au.v
   au.n = dcount(au.names, @fm)
   for au.k = 1 to au.rows
   until keyready()
      au.txt = ''
      if au.k <= au.n then
         au.vn = au.nums<au.k>
         gosub auto.value
         au.txt = au.names<au.k> : ' = ' : au.val
      end
      call $sl_put(scr, auto.x, SOURCE.AREA + au.k, fmt(au.txt[1, au.w], au.w : 'L'), auto.attr)
   next au.k
   return

* AUTO.WORDS  -  In: au.t, a line of source.  Out: au.words, an @FM list of the words in it that are outside a string and a comment.  A line that is a comment gives none.
auto.words:
   au.words = ''
   au.q = ''                                        ;* the quote of the string the scan is in
   au.word = ''
   au.tt = trimf(au.t)
   if au.tt[1, 1] = '*' or au.tt[1, 1] = '!' or upcase(au.tt[1, 4]) = 'REM ' then return
   for au.c = 1 to len(au.t) + 1
      au.ch = au.t[au.c, 1]                         ;* null past the end, which ends the last word
      if au.q # '' then
         if au.ch = au.q then au.q = ''
      end else
         if au.ch # '' and index(basic.chars, au.ch, 1) then
            au.word := au.ch
         end else
            if au.word # '' and not(au.word[1, 1] matches '1N0X') then au.words<-1> = au.word
            au.word = ''
            if au.ch = "'" or au.ch = '"' then au.q = au.ch
            if au.ch = ';' and (au.t[au.c + 1, 1] = '*' or au.t[au.c + 1, 1] = '!') then exit    ;* a comment to the end of the line
         end
      end
   next au.c
   return

* AUTO.ADD.WORD  -  In: au.word.  If it names a variable of the program and is not in the pane yet it is added (au.names, au.nums).  The variable number is worked out as display.variable does.
auto.add.word:
   au.nm = au.word
   if not(case.sensitive) then au.nm = upcase(au.nm)
   locate au.nm in au.names<1> setting au.pos then return
   find au.nm in symbols(idx) setting au.f, au.v, au.sv else return
   if au.f = 1 then
      au.vn = au.v - 1
   end else
      au.vn = symbols(idx)<au.f, 1> + shift(au.sv, -16)
   end
   au.names<-1> = au.nm
   au.nums<-1> = au.vn
   return

* AUTO.VALUE  -  In: au.vn, a variable number.  Out: au.val, its value on one line, as display.variable words it but short (a string is cut, a matrix or a collection says what it is).
auto.value:
   au.info = dbg.info(1, au.vn)
   au.type = au.info<1> + 0
   begin case
      case len(au.info) = 0
         au.val = '?'
      case au.type = V$UNASSIGNED
         au.val = 'Unassigned'
      case au.type = V$INTEGER or au.type = V$FLOATNUM
         au.val = au.info<2>
      case au.type = V$STRING
         au.s = field(au.info, @fm, 3, 9999999)
         au.val = '"' : convert(banned, replacements, au.s[1, 200]) : '"'
      case au.type = V$ARRAY
         au.val = 'Dim (' : (au.info<2> + 0) : (if au.info<3> + 0 then ',' : (au.info<3> + 0) else '') : ')'
      case au.type = V$COLL
         au.cn = au.info<3> + 0
         au.val = (if au.info<2> = 'A' then 'Array' else 'Collection') : ' (' : au.cn : ' element' : (if au.cn = 1 then '' else 's') : ')'
      case au.type = V$FILE.REF
         au.val = 'File: ' : au.info<3>
      case au.type = V$SELLIST
         au.val = 'Select list (' : au.info<2> : ' bytes)'
      case au.type = V$OBJ
         au.val = 'Object: ' : au.info<2>
      case au.type = V$JSON.BOOLEAN
         au.val = 'Boolean: ' : au.info<2>
      case au.type = V$JSON.NULL
         au.val = 'Null'
      case au.type = V$SUBR
         au.val = 'Subr: ' : au.info<2>
      case 1
         au.val = '(not shown)'                     ;* a common block, an image, a socket ...: /name shows what the debugger can say of it
   end case
   return

* READ.LAYOUT  -  lay.w by lay.h, the size the full-screen display is laid out for: the window, and never less than LAY.WIDTH by
*                 LAY.DEPTH.  A window made smaller after the debugger started shows the upper left corner of the layout and the
*                 library cuts what falls outside it.  win.w by win.h is the window as it was looked at (WAIT.KEY compares it).
read.layout:
   call $sl_window(win.w, win.h)
   lay.w = win.w
   lay.h = win.h
   if lay.w < LAY.WIDTH then lay.w = LAY.WIDTH
   if lay.h < LAY.DEPTH then lay.h = LAY.DEPTH
   last.w = win.w
   last.h = win.h
   return

* RELAYOUT  -  The window changed size (or the cursor lock was lifted, which leaves the screen the lock's): the layout is made
*              again for the window and everything is drawn again.  The messages of the data area are kept.
relayout:
   * the prompt the debugger was waiting in may be a listing (emit.msg, show.call.stack) whose loops use s, n, i and j, which
   * display.source uses too
   if unassigned(s) then rl.s = '' else rl.s = s
   if unassigned(n) then rl.n = '' else rl.n = n
   if unassigned(i) then rl.i = '' else rl.i = i
   if unassigned(j) then rl.j = '' else rl.j = j
   gosub read.layout
   gosub set.geometry
   gosub scr.in                          ;* the theme is the debugger's already (S.98: theme.in / theme.out here lost the program's theme at exit)
   display @(-1) :
   gosub paint.layout
   gosub paint.data.area
   gosub display.source
   gosub refresh.panes
   s = rl.s ; n = rl.n ; i = rl.i ; j = rl.j
   return

* WAIT.KEY  -  One key from a full-screen prompt, in wk.c.  In: cur.x, the column the cursor is in (on the command line).  Out: key.quit, true
*              if the user left from the cursor lock (Ctrl-Q, y) and wk.c is null; wk.relaid, true if the window had changed and
*              the screen was laid out and drawn again (RELAYOUT wipes the prompt line): wk.c is null and the caller paints its
*              prompt again and calls this again.
*              While the cursor is off the screen the keys are not the debugger's: $sl_guard takes the keyboard until the window is
*              made bigger.  Line mode just waits.
wait.key:
   key.quit = @false
   wk.relaid = @false
   wk.c = ''
   if not(full.screen) then
      wk.c = keycode()
      return
   end
   loop
      call $sl_window(win.w, win.h)
      if win.w # last.w or win.h # last.h then
         gosub relayout
         wk.relaid = @true
         return
      end
      if cur.x >= win.w or command.line >= win.h then
         call $sl_guard('the debugger', LAY.WIDTH, LAY.DEPTH, cur.x, command.line, guard.result)
         if guard.result = 'quit' then
            key.quit = @true
            return
         end
         last.w = -1                      ;* the screen is the lock's, not ours: it is laid out and drawn again at the top
         continue
      end
      wk.c = keycode(1)
      wk.st = status()
      if wk.c # '' or wk.st # ER$TIMEOUT then exit
   repeat
   return

* WINDOW n  -  the data area becomes n rows high (QM4 Fixes 193); the source area takes what is left
new.window:
   data.lines = new.lines + 0
   gosub set.geometry
   mat debug.data.area = ''
   gosub paint.layout
   gosub paint.data.area
   gosub display.source
   return

* ======================================================================
* INITIALISE  -  Initialise common block

initialise:
   * Full screen: a real terminal (the kernel can read its window size) that has an alternate screen.  (Until
   * 13 Oct 26 it was a terminal with the AccuTerm 'sreg' capability, which kept screen images, a mouse and key
   * rebinding of its own; all of that has been removed.)
   * 2 Nov 26 (S.98 H3): any terminal that can address a cell and clear itself, not only one with an alternate screen.  With an alternate screen (alt.able) the program's own screen
   *   is kept by the terminal and comes back; without one (the Linux console, vt100, vt220, ansi, ...) the debugger takes the main screen for the length of a stop, and what the
   *   library knows of the program's screen is drawn again when it lets go (take.main, give.main).  dumb, unknown and null have no cup and stay in line mode.
   full.screen = @false
   alt.able = @false
   if not(phantom) then
      if kernel(K$WINSIZE, '') # '' and terminfo('cup') # '' and terminfo('clear') # '' then
         full.screen = @true
         alt.able = (terminfo('smcup') # '' and terminfo('rmcup') # '')
      end
   end

   * Display attributes: the style codes of the screen library (set at every entry, theme.in, because the theme
   * is the program's to change)
   title.attr = 'a'
   source.attr = 'n'
   highlight.source.attr = 'n'
   breakpoint.source.attr = 'n'
   command.attr = 'a'
   data.attr = 'n'
   auto.attr = 'n'
   rev.attr = 'r'
   num.attr = 'n'
