     banned := char(i)
   next i
   banned := char(127)
   replacements = str("?", len(banned))

   debug.command.stack = ''
   mat debug.data.area = ''

   * 16 Oct 26 dm - QM4 Fixes 193: WINDOW n in the VOC record $DEBUG.OPTIONS sets the height of the data area (5 to 15 rows)
   expand.np = @false
   data.lines = DATA.AREA.LINES
   read init.options from @voc, '$debug.options' then
      init.options = upcase(init.options)
      for i = 1 to dcount(init.options, @fm)
         if field(trim(init.options<i>), ' ', 1) = 'WINDOW' then
            n = field(trim(init.options<i>), ' ', 2)
            if n matches '1N0N' and n >= 5 and n <= MAX.DATA.AREA.LINES then data.lines = n + 0
         end
         if field(trim(init.options<i>), ' ', 1) = 'LINE.MODE' then full.screen = @false     ;* 2 Nov 26 (S.98 H3): the way back to line mode on a terminal that would otherwise get the full screen
      next i
