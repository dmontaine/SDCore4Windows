* START-DESCRIPTION:
*
*   BLOCK.PRINT text      to the default printer (print unit 0)
*   BLOCK.TERM text       to the terminal
*
* Text in large letters, each character drawn in a 7 by 7 block of the letter W with two blank columns after it, so that
* eight characters fill an 80 column line.  Long text wraps, breaking at a space where it can.  Lower case prints as
* upper case.  Letters, digits and  . , ! ? - : / + = * ( ) '  have shapes; any other character prints as a question
* mark, and a space is a blank block.
*
* openQM can change the drawing character and the shapes through an X-type record $BIGLTRS in the VOC of QMSYS.  SD has
* no such record: the letter is always W.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program blockprt
$catalog $blockprt

$include err.h

   @system.return.code = -ER$ARGS

   verb = downcase(field(trim(@sentence), ' ', 1))
   text = trim(@sentence)
   text = trim(text[index(text, ' ', 1) + 1, 99999])
   if text = '' or index(trim(@sentence), ' ', 1) = 0 then stop sysmsg(12320)  ;* Text to print required
   text = upcase(text)

   gosub load.font

   to.printer = (verb = 'block.print')
   @system.return.code = 0
   if to.printer then printer on

   * Split the text into lines of at most eight characters.
   rest = text
   loop
   while rest # ''
      if len(rest) <= 8 then
         line = rest
         rest = ''
      end else
         cut = 8
         if rest[9, 1] # ' ' then
            for i = 8 to 1 step -1
               if rest[i, 1] = ' ' then cut = i - 1 ; exit
            next i
            if cut < 1 then cut = 8
         end
         line = trim(rest[1, cut], ' ', 'T')
         rest = rest[cut + 1, 99999]
      end
      rest = trim(rest, ' ', 'L')
      gosub draw.line
   repeat

   if to.printer then printer close
   stop

* ======================================================================
* draw.line - seven rows of LINE, then a blank row.
draw.line:
   for r = 1 to 7
      out = ''
      for c = 1 to len(line)
         ch = line[c, 1]
         locate ch in keys<1> setting p else
            locate '?' in keys<1> setting p else p = 1
         end
         g = glyphs<p>
         bits = field(g, '|', r)
         bits = convert('#.', 'W ', bits)
         out := ' ' : bits : '   '
      next c
      out = trim(out, ' ', 'T')
      if to.printer then print on 0 out else print out
   next r
   if to.printer then print on 0 '' else print ''
   return

* ======================================================================
* load.font - KEYS holds the characters, GLYPHS the seven rows of five columns of each, separated by |.
load.font:
