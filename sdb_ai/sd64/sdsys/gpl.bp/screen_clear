*
* START-DESCRIPTION:
*
*   SCREEN CLEAR {AT x,y} {SIZE w,h} {ATTR style}
*
*   is compiled into
*
*   call !screen_clear(x, y, w, h, attr, ret, status)
*
*     (none)   the whole screen is cleared and the library's cursor goes to 0,0
*     x y      the left column and top row of the rectangle, from 0 (default 0)
*     w h      its width and height (default: to the right and bottom edges)
*     attr     the style the blank cells are given (default desktop, see $sl_theme); the whole-screen form
*              always uses the desktop style
*
*   The shadow is made to match.  The cursor is left where it was, except in the whole-screen form.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_clear(x, y, w, h, attr, ret, status)
$catalog !screen_clear

$include sl.h

   ret = ''
   status = 1
   if system(25) then return                  ;* a phantom has no terminal: nothing is drawn
   call $sl_scr('get', scr)

   if x = '' and y = '' and w = '' and h = '' then
      call $sl_desktop(scr)
   end else
      if x = '' then x = 0
      if y = '' then y = 0
      if w = '' then w = scr<SL.S.W> - x
      if h = '' then h = scr<SL.S.H> - y
      if attr = '' then attr = 'desktop'
      call $sl_attr(attr, code)
      for r = 0 to h - 1
         call $sl_put(scr, x + 0, y + r, space(w), code)
      next r
   end

   call $sl_scr('put', scr)
   status = 0

   return
end

* END-CODE
