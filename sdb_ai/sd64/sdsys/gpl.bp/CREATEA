$internal
program $create.account
$catalog $CREATEA

$include keys.h
$include int$keys.h
$include parser.h
$include err.h
* 20240219 mab user must be member of sdusers  
deffun is_grp_member(user,group) calling '!is_grp_member'
deffun os_group(action,group,member) calling '!os_group'
* rev 0.9.0 *
deffun is_group(group) calling '!is_group'
deffun is_user(uname) calling '!is_user'
deffun create_user(uname) calling '!create_user'
deffun set_passwd(uname)  calling '!set_passwd'
* 21 Aug 26 Windows port - for the unwind when no password is set.  An account
*   cannot be created without one (owner's rule), and the Windows user is made
*   BEFORE the password is asked for, so refusing has to take it back.
deffun delete_user(uname) calling '!delete_user'
* 28 Aug 26 Windows port - for the refusal below.  PRE_RELEASE_FIXES.md 36.
deffun profile_dir(uname) calling '!profile_dir'
deffun valid_os_name(name) calling '!valid_os_name'
deffun valid_os_path(path) calling '!valid_os_path'
deffun ps_script(script) calling '!ps_script'

   prompt ''

* rev 0.9.0 create-account requires admin priv, are we admin?
   if not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001)  ;* Command requires administrator privileges
   end
      
* we run as root, and the root umask is usually 022, that will not work for us
   if umask(002) then null

   parser = "!PARSER"
   no.query = @false
   make.admin = @false
* 17 Aug 26 Windows port - PROGRAMMER, PROJECT_STATUS.md section 8.  tier is one
*   of STANDARD, PROGRAMMER and ADMINISTRATOR, and it decides the VOC: STANDARD
*   gets NEWVOC less the capabilities in TIER.OMIT.STANDARD, PROGRAMMER gets all
*   of NEWVOC, ADMINISTRATOR gets that plus the administration verbs named in
*   TIER.ADD.ADMINISTRATOR.  An administrator is a programmer and more.
*
*   A STRING RATHER THAN A FLAG, and not for taste: it is written to the
*   ACCOUNTS record (ACC$TIER) and read back by LOGIN, so a person running
*   LIST ACCOUNTS should be able to see which tier an account is without a
*   lookup table.  It replaced a boolean full.voc, which could not tell
*   PROGRAMMER from ADMINISTRATOR at all.
   tier = 'STANDARD'
* 27 Aug 26 Windows port - OPERATING-SYSTEM ACCESS IS A CREATE-TIME PROPERTY
*   TOO, as remote access became one on 21 Aug.  Owner, 27 Aug 2026: "sh-on"
*   and "os-on" on CREATE.ACCOUNT, and both ways round on MODIFY.ACCOUNT.
*
*   THE TWO ARE SEPARATE BECAUSE OS.USERS HAS TWO FIELDS AND THEY GATE
*   DIFFERENT THINGS: field 1 is the SH verb and "!" at the prompt (CPROC),
*   field 2 is OS.EXECUTE from a program, the SH verb's own execution and the
*   two screen editors (op_sh.c os_permitted, EDIT check.permitted).
*
*   ON ONLY, ON THIS VERB.  An account is created with nothing, so there is
*   nothing to turn off; MODIFY.ACCOUNT carries sh-off and os-off for later.
*   An ADMINISTRATOR gets both without asking - see the block at the end of
*   more.args - and can be narrowed afterwards, because this is a DEFAULT and
*   not the rule that ssh and the API are.
   os.sh   = @false
   os.exec = @false
* 14 Aug 26 Windows port - ADOPT attaches an SD account to an OS account that
*   already exists, instead of creating one.  See more.args for what gates it.
   adopt = @false
* 21 Aug 26 Windows port - REMOTE ACCESS IS A CREATE-TIME PROPERTY NOW.
*   Owner's decision, 21 Aug 2026: CREATE.ACCOUNT USER says how the account is
*   reached - SSH, API, BOTH or NONE - and MODIFY.ACCOUNT changes it later with
*   the same four words.  It replaced "ssh yes, API no" applied silently.
*
*   access.given IS SEPARATE FROM THE TWO FLAGS ON PURPOSE.  NONE and "nothing
*   said" both leave access.ssh and access.api false, and they are not the same
*   thing: one is a decision and the other is a caller who has not made one.
*   Only the flags decide what happens; access.given decides whether to refuse.
*
*   ASSIGNED HERE RATHER THAN IN more.args because BCOMP's "is not assigned a
*   value" is what bootstrap.py:229 fails the bootstrap on, and all three are
*   read below the subroutine that sets them.
   access.given = @false
   access.ssh = @false
   access.api = @false

* 21 Aug 26 Windows port - THE ONE-SHOT MARKER THAT MAKES ADOPT INSTALL-ONLY.
*   gplbld/adopt-account.ps1 writes this file immediately before running the
*   verb and removes it again afterwards; more.args accepts ADOPT only while it
*   is there, and deletes it on acceptance.  The reasoning is at the keyword
*   itself - the name is assigned here for the same reason access.given is,
*   which is that BCOMP's "is not assigned a value" is what bootstrap.py:229
*   fails the whole bootstrap on.
*
*   IT IS NOT SHIPPED AND MUST NEVER BE.  A marker in the source tree would be
*   staged into every install and leave the door open permanently, which is the
*   state this replaces.
*
* 21 Aug 26 Windows port - AND IT NAMES THE ACCOUNT IT AUTHORISES.  The USER arm
*   overwrites this with '$adopt.<name>' as soon as the name is parsed, so one
*   marker opens the door for one account rather than for the verb in general.
*   Owner's ruling: the project AS DELIVERED must enforce that SD account setup
*   happens in SD.  Somebody who forges a marker afterwards is degrading their
*   own install, which is their right and is not what this defends against.
*
*   WHAT IS LEFT HERE IS THE FALLBACK FOR THE ARMS THAT NEVER ADOPT - GROUP and
*   OTHER, which share more.args and never assign acc.uname.  Nothing writes
*   this bare name any more, so it cannot exist on a delivered system.
   adopt.marker = @sdsys:@ds:'$adopt'

   @system.return.code = -ER$ARGS     ;* Preset for argument errors


   openpath @sdsys:@ds:'accounts' to acc.f else
      @system.return.code = -status()
      stop sysmsg(6000) ;* Cannot open ACCOUNTS file in SDSYS account
   end


   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb create-account
   * 20240219 mab dflt user and group parent directory for accounts
   * Get next token, could be USER, GROUP or account name

   call @parser(PARSER$GET.TOKEN, token.type, acc.type, keyword)
   *
   group_name = ''   ;* will be set to callers entered group name on group create, no case changes
   begin case
   case upcase(acc.type) = 'USER' 
*    CREATE.ACCOUNT USER <user acct name>  SSH|API|BOTH|NONE  {NO.QUERY}
     pathname = CONFIG('USRDIR')
     if pathname = '' then pathname = 'C:\ProgramData\SD\user_accounts'
     call @parser(PARSER$GET.TOKEN, token.type, acc.uname, keyword)
     if token.type = PARSER$END then stop

* 21 Aug 26 Windows port - THE MARKER NAMES THE ONE ACCOUNT IT AUTHORISES.
*   Built HERE rather than in more.args because that subroutine is shared with
*   the GROUP and OTHER arms, where acc.uname is never assigned - and AND DOES
*   NOT SHORT-CIRCUIT, so putting downcase(acc.uname) in the ADOPT case
*   condition would abort every CREATE.ACCOUNT GROUP with an unassigned
*   variable.  That is the defect PROJECT_STATUS.md section 6 records at
*   CREATEA:1405, which went unnoticed from 10 June to 21 Aug 2026.
*
*   DOWNCASED, BECAUSE THIS PATH DOES NOT DO IT.  adopt-account.ps1 writes the
*   name in lower case; acc.uname keeps whatever case was typed until the
*   is_user test below, and on the ADOPT branch that downcase runs only in its
*   ELSE - so an account found under its typed spelling is never folded.
     adopt.marker = @sdsys:@ds:'$adopt.':downcase(acc.uname)

     * any other args? (specifically no.query)
     * rem we may abort in this routine
     gosub more.args

* 30 Aug 26 Windows port - THE STAND-ALONE REFUSAL IS REMOVED, WITH THE MODE IT
*   BELONGED TO.  PRE_RELEASE_FIXES 75.  This read '$standalone' in SDSYS and
*   stopped with message 10100, on the reasoning that an account joined to
*   sdsshonly is denied the console and Remote Desktop, so with no ssh server it
*   "can sign in NOWHERE".
*
*   THE REASONING WAS SOUND AND IS NOW ANSWERED EARLIER AND PER ROUTE.  The ssh
*   server is a per-install choice rather than a mode (PRE_RELEASE 67), and
*   CREATE.ACCOUNT already requires the caller to say how the account is reached
*   - SSH, API, BOTH or NONE, the block immediately below, with no default.  So
*   the case this refusal existed to prevent is now refused by the argument the
*   caller must supply, at the point where it is actually known, instead of by a
*   marker written once at install time.
*
*   AND THE OWNER RULED THE BLANKET FORM OUT: an installation with no ssh server
*   may still legitimately create accounts - for the API, or for LOGTO from an
*   administrator's session - and 10100 refused all of them.  Message 10100 is
*   withdrawn with this code.
* 21 Aug 26 Windows port - SAY HOW THIS ACCOUNT IS REACHED, or nothing is made.
*   Owner's decision, 21 Aug 2026.  There is no default: a site that wants an
*   application user who can only be reached by LOGTO says NONE and means it,
*   and the old silent "ssh yes, API no" could not tell that apart from a
*   caller who had not thought about it.
*
*   REFUSED HERE, BEFORE ANY WINDOWS ACCOUNT EXISTS.  more.args has run and
*   nothing after it has yet created a user, a group, a directory or a register
*   record, so this stops with the machine untouched - the same reason the
*   NO.QUERY and reserved-name refusals sit in this stretch.
*
*   THE USER ARM ONLY.  more.args is shared with GROUP and OTHER, which have no
*   Windows user and therefore no route to set; the check cannot live inside it.
     if not(access.given) then
       @system.return.code = -ER$ARGS
       stop sysmsg(10082) ;* Say who may reach this account: SSH, API, BOTH or NONE
     end

     * Is the user a valid os user?
     * Check reserved names then
     * Check user name as entered, then force to lower case and re check
     begin case
     
     * is user reserved?
     case upcase(acc.uname) = 'ROOT' 
       @system.return.code = -ER$ARGS
       stop sysmsg(6052) ;* User name is invalid
     
     case upcase(acc.uname) = 'SDSYS' 
       @system.return.code = -ER$ARGS
       stop sysmsg(6052) ;* User name is invalid
      
     case upcase(acc.uname) = 'SDUSERS' 
       @system.return.code = -ER$ARGS
       stop sysmsg(6052) ;* User name is invalid
          
