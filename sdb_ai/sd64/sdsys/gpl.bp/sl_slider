* START-HISTORY:
* 25 Oct 26 Windows port - from Linux 04f1eaa - the screen library as of S.75 TK-0.13 (containers and viewports, slider, selector, colour, accelerators, table styles)
* 22 Oct 26 dm  New (S.75, TK-0.8; the owner asked for a slider button for on / off, 22 Oct 2026).
* 22 Oct 26 dm  The look is [off | ON] and [OFF | on], as the owner was first shown (the first build drew a knob on a track, [O--] and [==O], and said nothing
*               of the change); the word in force is in capitals and in the style attr (bold unless the program says another).  A click on a word sets that
*               state.  The words are the program's to choose (offw and onw: [left | RIGHT]); off and on when it says nothing.
* 22 Oct 26 dm  The label goes where place says (left by default, right, above, below), through $sl_caption (TK-0.9).
* 22 Oct 26 dm  The letter marked with & in the label is drawn in the hotkey style while the switch does not have the focus (apos; S.75 TK-0.12).
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $sl_slider(op, w, scr, key, ret)      the widget contract; w is a collection (see $sl_label)
*
*   Elements:  id, text, x y, ax ay, value (1 on, 0 off), offw and onw (the word of each state, off and on when null), attr (the style of the word in force: any
*   style of $sl_theme, bold when null; window leaves it as the form's own, so only the capitals show it), place (where the label is: left, right, above or
*   below; left when null)
*
*     init    w and h from the switch and the label (one row; two rows when the label is above or below); value is made 0 or 1
*     draw    the label and [off | ON] when it is on, [OFF | on] when it is off (label on the left by default: text [off | ON]): the word in force is in capitals and in
*             the style attr, the other in lower case.  While the switch has the focus the whole of it, label included, is in reverse video (the capitals still show
*             the state) and the cursor is on the word in force
*     focus   key = 1 gives it the focus (draws), key = 0 takes it away (draws)
*     key     the space bar slides it the other way; Left sets it off and Right sets it on (whatever it was: 'handled' either way).  Anything else is
*             'unhandled' with the key (Return, Tab, Up, Down ...) for the form to act on.
*     mouse   a click on the first word (or the cells before it, or the bar) sets it off, a click on the second word (or the cells after it, the bracket) sets it
*             on, and a click on the label slides it the other way
*     close   nothing to undo
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_slider(op, w, scr, key, ret)
$catalog $sl_slider

$include sl.h

   ret = ''

   begin case
      case op = 'init'
         w{'type'} = 'slider'
         w{'focusable'} = 1
         t = w{'text'}
         p = index(t, '&', 1)
         w{'amn'} = ''
         w{'apos'} = 0
         if p and p < len(t) then
            w{'amn'} = upcase(t[p + 1, 1])      ;* the letter marked with & is its Alt-letter (the form acts on it)
            w{'apos'} = p                       ;* and is the p-th cell of the label once the & is out: paint underlines it
            t = t[1, p - 1] : t[p + 1, 99999]
         end
         w{'label'} = t
         v = 0
         if w{'value'} + 0 # 0 then v = 1
         w{'value'} = v
         if w{'attr'} = '' then w{'attr'} = 'bold'
         if w{'offw'} = '' then w{'offw'} = 'off'
         if w{'onw'} = '' then w{'onw'} = 'on'
         call $sl_caption(w{'place'}, len(w{'offw'}) + len(w{'onw'}) + 5, t, geom)
         w{'w'} = geom<1, SL.CAP.W>
         w{'h'} = geom<1, SL.CAP.H>

      case op = 'draw'
         gosub paint

      case op = 'focus'
         w{'focused'} = if key then 1 else 0
         gosub paint

      case op = 'key'
         begin case
            case key = ' '
               ret = 'handled'
               v = 1
               if w{'value'} then v = 0
               w{'value'} = v
               gosub paint
            case key = 'left'
               ret = 'handled'
               w{'value'} = 0
               gosub paint
            case key = 'right'
               ret = 'handled'
               w{'value'} = 1
               gosub paint
            case 1
               ret = 'unhandled' : @fm : key
         end case

      case op = 'mouse'
         ret = 'handled'
         if key<1> = 'press' then
            lo = len(w{'offw'})
            ln = len(w{'onw'})
            call $sl_caption(w{'place'}, lo + ln + 5, w{'label'}, geom)
            rel = key<3> - w{'ax'} - geom<1, SL.CAP.CX>
            rrow = key<4> - w{'ay'} - geom<1, SL.CAP.CY>
            begin case
               case rrow = 0 and rel >= 0 and rel <= lo + 2
                  w{'value'} = 0
               case rrow = 0 and rel >= 0 and rel <= lo + ln + 4
                  w{'value'} = 1
               case 1
                  v = 1
                  if w{'value'} then v = 0
                  w{'value'} = v
            end case
            gosub paint
         end
   end case

   return

paint:
   call $sl_attr('window', code)
   if w{'ccode'} # '' then code = w{'ccode'}
   if w{'focused'} then call $sl_attr('highlight', code)
   lo = len(w{'offw'})
   ln = len(w{'onw'})
   sw = '[' : upcase(w{'offw'}) : ' | ' : downcase(w{'onw'}) : ']'
   a0 = 1
   al = lo
   if w{'value'} then
      sw = '[' : downcase(w{'offw'}) : ' | ' : upcase(w{'onw'}) : ']'
      a0 = lo + 4
      al = ln
   end
   call $sl_caption(w{'place'}, len(sw), w{'label'}, geom)
   gw = geom<1, SL.CAP.W>
   gh = geom<1, SL.CAP.H>
   cx = geom<1, SL.CAP.CX>
   cy = geom<1, SL.CAP.CY>
   lx = geom<1, SL.CAP.LX>
   ly = geom<1, SL.CAP.LY>
   gosub hotkey
   for r = 0 to gh - 1
      rowtext = space(gw)
      cells = str(code, gw)
      if r = cy then
         rowtext[cx + 1, len(sw)] = sw
         if not(w{'focused'}) then
            call $sl_attr(w{'attr'}, ac)
            for k = 1 to al
               cells[cx + a0 + k, 1] = ac
            next k
         end
      end
      if r = ly and w{'label'} # '' then
         rowtext[lx + 1, len(w{'label'})] = w{'label'}
         if hk then cells[lx + w{'apos'}, 1] = hcode      ;* the marked letter of the label, in the hotkey style
      end
      call $sl_put(scr, w{'ax'} + 0, w{'ay'} + r, rowtext, cells)
   next r
   if w{'focused'} then call $sl_curat(w{'ax'} + cx + a0, w{'ay'} + cy)
   return

* hk = 1 when the label's marked letter is to be drawn in the hotkey style (hcode): not while the control has the focus (the whole of it is in the focus
* style then) and not when it is disabled (its Alt-letter does nothing)
hotkey:
   hk = 0
   if not(w{'focused'}) and w{'disabled'} + 0 = 0 and w{'apos'} + 0 > 0 and w{'apos'} + 0 <= len(w{'label'}) then
      hk = 1
      call $sl_attr('hotkey', hcode)
   end
   return
end

* END-CODE
