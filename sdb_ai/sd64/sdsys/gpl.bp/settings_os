* START-DESCRIPTION:
*
*    call !settings_os(lines, err)
*
* A per-OS helper of SETTINGS.REPORT (agreed with SD Core for Linux, 1 Oct
* 2026).  lines is the report text, one line per field, "[name]" opening each
* section.  err is '' or a message number then its arguments, value-mark
* separated.
*
* WHAT IS HERE: sd.conf, ssh (the sshd service and sshd_config's access
* lines), api (the certificate's subject, expiry and thumbprint - never the
* key), firewall (SD's API rule and OpenSSH's), service, groups (sdusers,
* sdssh, sdapi, sdsshonly) from gplbld sd-settings-os.ps1; and os.users, read
* here because it is an SD file.  A section with nothing to report is left out.
*
* REFERENCE TEXT ONLY, owner 1 Oct 2026: nothing reads it back, so a part that
* could not be read is said in its own section and the rest still go out.
* Only a script that did not finish is an error.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine settings_os(lines, err)
$catalog !settings_os

$include int$keys.h

deffun ps_script_out(script, want.out) calling '!ps_script_out'

   lines = ''
   err   = ''
   q     = char(39)

   script = '& ' : q : kernel(K$WINPATH, '/sd-settings-os.ps1') : q : '; exit $LASTEXITCODE'
   both = ps_script_out(script, @true)
   rc = both<1>
   del both<1>

   ok  = @false
   why = ''
   n = dcount(both, @fm)
   for i = 1 to n
      ln = both<i>
      begin case
         case ln[1, 7] = 'REPORT '
            lines<-1> = ln[8, len(ln)]
         case ln[1, 15] = 'SETTINGS-OS OK '
            ok = @true
         case ln[1, 18] = 'SETTINGS-OS ERROR '
            why = ln[19, len(ln)]
      end case
   next i

   if not(ok) or rc # 0 then
      if why = '' then why = 'exit ' : rc : ', and no result line'
      lines = ''
      err = 12002 : @vm : why
      return
   end

*  os.users - one line per record: user, SH, OS.EXECUTE.
   openpath @sdsys : @ds : 'os.users' to osu.f then
      sel.lines = ''
      select osu.f to 11
      loop
         readnext id from 11 else exit
         read rec from osu.f, id then
            sel.lines<-1> = id : ': sh ' : rec<1> : ', os.execute ' : rec<2>
         end
      repeat
      close osu.f
      if sel.lines # '' then
         lines<-1> = '[os.users]'
         lines<-1> = sel.lines
      end
   end else
      lines<-1> = '[os.users]'
      lines<-1> = '(could not be read: os.users)'
   end

   return
end
