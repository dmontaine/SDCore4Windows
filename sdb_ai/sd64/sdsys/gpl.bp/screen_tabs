*
* START-DESCRIPTION:
*
*   SCREEN TABS f, id, labels {AT x,y} {VALUE n} {ACCEL key}
*
*   is compiled into
*
*   call !screen_tabs(f, id, labels, x, y, value, accel, ret, status)
*
*     f id     the form and the widget's name in it (as SCREEN LABEL)
*     labels   the tabs' captions, as values (a field mark does as well)
*     x y      the place of the strip from the form's top left corner, default 1,1
*     value    the tab that is chosen to start with (default the first)
*     status   0 added; 1 not (ELSE)
*
*   Left and Right choose the tab before and after, Home and End the first and last.  The chosen tab is
*   the PAGE the form shows: a widget added after SCREEN PAGE f, n belongs to page n and is drawn, takes
*   the focus and answers keys only while tab n is chosen; widgets added before any SCREEN PAGE, or after
*   SCREEN PAGE f, 0, are on every page.  SCREEN GET f, id answers the number of the tab, and SCREEN WAIT
*   gives a change event when it moves.  SCREEN SET f, id VALUE n chooses a tab from the program.
*
*   ACCEL key gives the tab strip a key that reaches it wherever the focus is: f1 to f12, ctrl-a to ctrl-z, alt-a to alt-z or alt-0 to alt-9 (see SCREEN ENTRY).  The
*   strip takes the focus.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_tabs(f, id, labels, ax, ay, value, accel, ret, status)
$catalog !screen_tabs

   ret = ''
   status = 1
   w = collection()
   w{'id'} = id
   w{'items'} = convert(@fm, @vm, labels)
   x = 1
   y = 1
   if ax # '' then x = ax + 0
   if ay # '' then y = ay + 0
   w{'x'} = x
   w{'y'} = y
   w{'value'} = if value = '' then 1 else value + 0
   call $sl_tabs('init', w, '', '', r)
   call $sl_accel(w, accel, ast)
   if ast # 0 then return
   call $sl_wadd(f, w, ok)
   if ok then status = 0

   return
end

* END-CODE
