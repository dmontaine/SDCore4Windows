$internal
program setfile
$catalogue $setfile

$include parser.h
$include syscom err.h
$include syscom keys.h
$include int$keys.h

   parser = "!PARSER"
   prompt ''
   prompting = @false

   @system.return.code = -ER$ARGS    ;* Preset for command format errors

   openpath @sdsys:@ds:'accounts' to acc.f else
      @system.return.code = -status()
      stop sysmsg(2200) ;* Cannot open ACCOUNTS register
   end      

   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb

   * Account name

   call @parser(PARSER$GET.TOKEN, token.type, account, keyword)
   prompting = (token.type = PARSER$END)

   loop
      if prompting then
         display sysmsg(5032) :  ;* Account:
         input account
         account = trim(account, ' ', 'B')
         if account = '' then stop sysmsg(2059) ;* Command aborted
      end

      account = upcase(account)
      read acc.rec from acc.f, account then exit

      display sysmsg(2201, account) ;* Account name '%1' is not in register
      if not(prompting) then goto exit.set.file
   repeat

   acc.path = parse.pathname.tokens(acc.rec<ACC$PATH>)

   openpath acc.path:@ds:'voc' to rvoc.f else
      @system.return.code = -status()
      stop sysmsg(6870) ;* Cannot open target account VOC file
   end

   * File name

   call @parser(PARSER$MFILE, token.type, filename, keyword)
   prompting = (token.type = PARSER$END)

   loop
      if prompting then
         display sysmsg(6871) :  ;* Filename:
         input filename
         filename = trim(filename, ' ', 'B')
         if filename = '' then stop sysmsg(2059) ;* Command aborted
      end

* 14 Sep 26 Windows port - RELEASE_1.1 5.  THE downcase TIER THIS FOLD LACKED.
*     It tried as typed, then upcase only, so once CREATE.FILE stores new ids
*     lower case, "SET.FILE acc ZZX" could not find the account's zzx.
      read voc.rec from rvoc.f, filename else
         read voc.rec from rvoc.f, downcase(filename) then
            filename = downcase(filename)
         end else
            filename = upcase(filename)
            read voc.rec from rvoc.f, filename else
               display sysmsg(6872) ;* File name is not in target VOC
               if not(prompting) then goto exit.set.file
               continue
            end
         end
      end

      if upcase(voc.rec[1,1]) = 'F' then exit

      display sysmsg(6873) ;* Target VOC entry is not a file
      if not(prompting) then goto exit.set.file
   repeat

   * Pointer name

   call @parser(PARSER$GET.TOKEN, token.type, pointer, keyword)
! 2.4-4   prompting = (token.type = PARSER$END)

   loop
      if prompting then
         display sysmsg(6874) :  ;* Pointer (default QFILE):
         input pointer
         pointer = trim(pointer, ' ', 'B')
      end

      if pointer = '' then
* 18 Aug 26 Windows port - the default pointer name folds, 5.12 (b).  @voc is a
*        DYNAMIC file, so an exact read of 'QFILE' stops finding the shipped
*        record once that id is lower case, and SET.FILE would then create a
*        second upper-case QFILE beside it.  pointer keeps the id that matched.
         pointer = 'QFILE'
         read voc.rec from @voc, pointer else
            read voc.rec from @voc, downcase(pointer) then
               pointer = downcase(pointer)
            end else
               pointer = downcase(pointer)   ;* RELEASE_1.1 5 - a new id is lower case
               exit
            end
         end
         if voc.rec[1,1] = 'Q' then exit
         display sysmsg(6875) ;* QFILE is already in the VOC but not as a Q-pointer
         if not(prompting) then goto exit.set.file
         continue
      end

* 14 Sep 26 Windows port - RELEASE_1.1 5.  A NEW POINTER'S ID IS LOWER CASE,
*     AND AN EXISTING ONE IS FOUND IN ANY CASE.  Owner's ruling, 13 Sep 2026:
*     ids in SD system files are lower case.  @voc is a DYNAMIC file, so an
*     exact-case test let "SET.FILE acc file MYPTR" write a second pointer
*     beside an existing myptr instead of reaching 6876.  As typed, then down,
*     then up: a hit keeps the id it matched and takes the existing-record path
*     (owner, 14 Sep 2026: "treat it as the same id"); no hit writes downcase().
      read voc.rec from @voc, pointer else
         read voc.rec from @voc, downcase(pointer) then
            pointer = downcase(pointer)
         end else
            read voc.rec from @voc, upcase(pointer) then
               pointer = upcase(pointer)
            end else
               pointer = downcase(pointer)
               exit
            end
         end
      end

      display sysmsg(6876) ;* Pointer name is already in VOC

*     18 Aug 26 Windows port - and the test that goes with it, 5.12 (b).  Once
*     the block above can match a lower-case id, pointer holds it, and an
*     exact comparison here would send the default QFILE down the overwrite
*     path instead of accepting it.
      if upcase(pointer) # 'QFILE' and voc.rec[1,1] = 'Q' then
prompting = @true
         loop
            display sysmsg(2060) :  ;* Overwrite (Y/N/Q)?
            input yn upcase
* 30 Aug 26 Windows port - ENTER TAKES THE DEFAULT, AND IT IS N.
*   PRE_RELEASE_FIXES.md 79.  A multi-way prompt, which is why the entry left it:
*   Q is not simply "not yes".  But the DEFAULT is still a two-way question -
*   does Enter act or not - and N is the arm that leaves the existing Q-pointer
*   alone.  Q remains a thing you have to type, and still stops the verb.
            if yn = '' then yn = 'N'
         until yn = 'Y' or yn = 'N'
            if yn = 'Q' then
               @system.return.code = -ER$STOPPED
               stop
            end
         repeat
         if yn = 'Y' then exit
      end else
         if not(prompting) then goto exit.set.file
      end
   repeat

   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   if token.type # PARSER$END then
      stop sysmsg(2018, token) ;* Unexpected token (xx)
   end

   * Add new VOC entry

   voc.rec = 'Q'
   voc.rec<2> = account
   voc.rec<3> = filename
   recordlocku @voc, pointer
   write voc.rec to @voc, pointer

   @system.return.code = 0

exit.set.file:
   return
end

* END-CODE
