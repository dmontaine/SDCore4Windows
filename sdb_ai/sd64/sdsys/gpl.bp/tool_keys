* START-DESCRIPTION:
*
*   TOOL.KEYS
*
*   Shows what SD knows about the terminal and what a key does, on the toolkit's frame (140 columns by 43 lines at least; a smaller window is refused).
*
*     Terminal    the terminal type SD is using and the one in the environment, the window and the layout, the locale and whether the borders are line
*                 characters, whether the terminal can show colour, the theme, the mouse events that have arrived, the way keys are being read, and how
*                 many of the keys in the grid have been seen
*     Last keys   the 25 newest keys, newest first.  Names mode (the start): the name the screen library reports for the key ($sl_key: up, f5, ctrl-g,
*                 alt-s, mouse, or the character itself), and for a character its code.  Raw mode (Ctrl-R): the bytes the terminal sent, in hex, with
*                 the characters beside them, for the keys the terminal type does not name
*     Keys seen   the arrows, the twelve function keys, the control keys, an Alt-letter, a printable character and the mouse, each ticked when it has
*                 been pressed (names mode)
*     Mouse       the last mouse event and how many presses, releases, drags and wheel turns have come
*     Styles      the library's sixteen styles, each drawn in itself, to see what the theme in force looks like on this terminal
*     Box         the border characters the library draws with
*
*   Every key is shown BEFORE the program acts on it.  The keys the program uses are Ctrl-L (clear what has been seen, and draw the page again), Ctrl-R (names or raw
*   bytes), Ctrl-T (the next theme, kept for the person, as on every page), Ctrl-K (the keys of the page) and Ctrl-Q (leave); a key that ends the program can only be
*   tested by leaving.
*
*   A key that makes the terminal beep and shows nothing in names mode is one the terminal type does not give a name: press Ctrl-R and press it again to
*   see its bytes.  An Alt-letter shows as alt-x on a terminal that sends Alt+x as Esc and x.  Make the window smaller to see the cursor lock, and larger
*   again to leave it.  The end of the input ends the program.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $tool_keys
$catalog $tool_keys

$include keys.h
$include err.h
$include sl.h
$include tk.h

   prompt ''

   call $tk_open('tool.keys', '', ctx, err)
   if err # '' then
      display err
      stop
   end

   keys = ''
   call $tk_keys('add', keys, 'ctrl-l', 'clear', 'clear', '', 1)          ;* S.179: Ctrl-L, which clears and redraws here; a key tester takes no function key for itself
   call $tk_keys('add', keys, 'ctrl-r', 'raw/names', 'raw', '', 1)
   call $tk_keys('add', keys, 'ctrl-t', 'theme', 'theme', '', 1)
   call $tk_keys('add', keys, 'ctrl-k', 'keys', 'keys', '', 1)            ;* S.179: the keys of this page, as on every page
   call $tk_keys('add', keys, 'ctrl-q', 'quit', 'quit', '', 1)

   LOGN = 25                                            ;* lines in Last keys (the pane's height less 2: set by get.rects)
   GRIDROWS = 13                                        ;* rows in a column of the grid (names are not case sensitive: no other variable may be called gridrows)
   gnames = 'up' : @fm : 'down' : @fm : 'left' : @fm : 'right' : @fm : 'home' : @fm : 'end' : @fm : 'pgup' : @fm : 'pgdn' : @fm : 'ins' : @fm : 'del'
   gnames := @fm : 'bs' : @fm : 'tab' : @fm : 'btab' : @fm : 'enter' : @fm : 'esc'
   for i = 1 to 12
      gnames := @fm : 'f' : i
   next i
   for i = 1 to 26
      if i # 8 and i # 9 and i # 10 and i # 13 then gnames := @fm : 'ctrl-' : downcase(char(i + 64))     ;* ctrl-h, i, j and m arrive as bs, tab and enter
   next i
   gnames := @fm : 'alt-x' : @fm : 'char' : @fm : 'mouse'
   gn = dcount(gnames, @fm)
   snames = 'normal' : @fm : 'reverse' : @fm : 'underline' : @fm : 'both' : @fm : 'bold' : @fm : 'window' : @fm : 'highlight' : @fm : 'bar'
   snames := @fm : 'barsel' : @fm : 'hotkey' : @fm : 'hotkey.bar' : @fm : 'field' : @fm : 'disabled' : @fm : 'desktop' : @fm : 'text' : @fm : 'header'

   * can this terminal show colour?  The library says 'none' for a colour it cannot make; asking for one pair costs a spare style that this app never uses
   call $sl_theme('slot', 'white', 'black', '', '', cs)
   colour = (if cs = 'none' then 'no' else 'yes')

   rawmode = 0
   pane = 'Keys'
   msg = 'press any key'
   logl = ''
   seenf = ''
   nkeys = 0
   mp = 0 ; mr = 0 ; md = 0 ; mu = 0 ; mdn = 0          ;* the mouse events seen: press, release, drag, wheel up, wheel down
   mlast = 'none yet - use the mouse here'
   lastsz = @crtwide : ',' : @crthigh
   gen = 0

   perr = ''
   gosub declare.layout
   gosub draw.all

   loop
      call $tk_frame(ctx, keys, pane, msg)
      call $sl_curat(0, ctx<TK.C.YSTAT>)                 ;* the cursor waits at the start of the status line: in a window made smaller it is off the screen, and the library's cursor lock takes the keyboard
      ended = 0
      nm = ''
      detail = ''
      if rawmode then gosub read.raw else gosub read.names
      if ended then exit
      if nm = 'guardquit' then exit                      ;* the cursor lock's own way out
      if nm = 'resize' then
         call $tk_layout('refresh', ctx, '', chg)         ;* the frame, the body and the seven panes from the window as it is now
         gosub get.rects
         gosub redraw.all                                ;* the screen was repainted under the frame (a resize, or the lock lifted)
      end else
         if nm # '' or detail # '' then
            gosub record
            call $tk_keys('action', keys, nm, pane, act, '', '')
            begin case
               case act = 'quit'
                  exit
               case act = 'clear'
                  logl = ''
                  seenf = ''
                  nkeys = 0
                  mp = 0 ; mr = 0 ; md = 0 ; mu = 0 ; mdn = 0
                  mlast = 'none yet - use the mouse here'
                  msg = 'cleared'
                  gosub draw.dynamic
               case act = 'raw'
                  rawmode = (if rawmode then 0 else 1)
                  pane = (if rawmode then 'Raw' else 'Keys')
                  msg = (if rawmode then 'raw bytes: what the terminal sent' else 'names: what the screen library reports')
                  gosub draw.dynamic
               case act = 'theme'
                  * 8 Nov 26 (S.179): the routine every page uses - the library's one list and order, only the themes this terminal can show, and the choice kept for the person
                  call $tk_std('theme', ctx, keys, '', std.r)
                  msg = std.r<2>
                  gosub redraw.all
               case act = 'keys'
                  call $tk_std('keylist', ctx, keys, pane, std.r)          ;* S.179: the keys of this page, as on every page
            end case
         end
      end
   repeat

   call $tk_close(ctx)
   stop

* One key read the usual way: the name the screen library gives it, and what there is to say about it
read.names:
   screen key returning nm
   if nm = '' then
      if status() = ER$EOF then ended = 1
      return
   end
   begin case
      case nm = 'mouse'
         screen mouse returning mev else mev = ''
         detail = mev<1> : ' button ' : mev<2> : ' at ' : mev<3> : ',' : mev<4> : (if mev<5> # '' then ' (' : mev<5> : ')' else '')
         begin case
            case mev<1> = 'press' ; mp += 1
            case mev<1> = 'release' ; mr += 1
            case mev<1> = 'drag' ; md += 1
            case mev<1> = 'wheel' and mev<2> = 'up' ; mu += 1
            case mev<1> = 'wheel' ; mdn += 1
         end case
         mlast = detail
      case len(nm) = 1
         detail = 'code ' : seq(nm)
      case nm[1, 4] = 'alt-'
         detail = 'Esc then ' : nm[5, 99]
   end case
   return

* One key read as bytes: the first byte, then the rest of what the terminal sent in one go.  The wait is a second at a time so that a change of the window is noticed.
read.raw:
   raw = ''
   loop
      c = keyin(1)
      if c # '' then exit
      if status() = ER$EOF then
         ended = 1
         exit
      end
      if @crtwide : ',' : @crthigh # lastsz then
         screen key timeout 1 returning nm               ;* the library notices the new size and says resize (it also takes the keyboard if the cursor is off the window)
         exit
      end
   repeat
   if ended or nm = 'resize' or nm = 'guardquit' then return
   raw = c
   loop
      c = keyin(0.05)
   until c = '' do
      raw := c
   repeat
   hx = ''
   pr = ''
   for i = 1 to len(raw)
      n = seq(raw[i, 1])
      hx := '0123456789abcdef'[int(n / 16) + 1, 1] : '0123456789abcdef'[mod(n, 16) + 1, 1] : ' '
      pr := (if n >= 32 and n < 127 then raw[i, 1] else '.')
   next i
   detail = fmt(hx[1, 24], '24L') : ' ' : pr[1, 8]       ;* the first eight bytes: the line is 41 cells wide
   nm = ''
   if len(raw) = 1 then
      n = seq(raw)
      if n = 17 then nm = 'ctrl-q'
      if n = 12 then nm = 'ctrl-l'
      if n = 18 then nm = 'ctrl-r'
      if n = 20 then nm = 'ctrl-t'
      if n = 11 then nm = 'ctrl-k'
   end
   return

* The key in nm / detail goes to the top of Last keys, and in names mode into the grid; the status line says the last one
record:
   nkeys += 1
   if rawmode then
      line = fmt(nkeys, '4R') : '  ' : detail
      msg = 'raw ' : trim(detail[1, 30])
   end else
      line = fmt(nkeys, '4R') : '  ' : fmt(nm, '10L') : ' ' : detail
      msg = 'key ' : nm
      cell = nm
      if len(nm) = 1 then cell = 'char'
      if nm[1, 4] = 'alt-' then cell = 'alt-x'
      locate cell in gnames<1> setting gk then
         null
      end else
         gk = 0
      end
      if gk > 0 then
         seenf<gk> = 1
         gosub draw.cell
      end
   end
   ins line before logl<1>
   if dcount(logl, @fm) > LOGN then del logl<LOGN + 1>
   gosub draw.log
   gosub draw.info
   gosub draw.mouse
   return

* The screen again, after the screen was cleared or repainted: the frame as well
redraw.all:
   gen += 1
   ctx<TK.C.GEN> = gen
   gosub draw.all
   return

* The layout (S.88 L2).  The seven boxes are panes of the layout service, declared in the sizes of the reference layout (140 by 43, the body 138 by 39): three columns in one band, Terminal
* over Last keys, Keys seen over Styles, Mouse over Box drawing over Help.  A bigger window gives each column a third of the extra columns, and the extra rows to Last keys, Styles and Help.
* Out: t.x t.y t.w t.h (Terminal), k.* (Last keys), s.* (Keys seen), st.* (Styles), mo.* (Mouse), bx.* (Box drawing), hp.* (Help), each with .tw, the text width (the box less 4), and LOGN.
declare.layout:
   d = ''
   d<1> = 'terminal' : @vm : 1 : @vm : 1 : @vm : 12 : @vm : 45 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   d<2> = 'lastkeys' : @vm : 1 : @vm : 1 : @vm : 27 : @vm : 45 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<3> = 'seen' : @vm : 1 : @vm : 2 : @vm : 17 : @vm : 46 : @vm : 1 : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   d<4> = 'styles' : @vm : 1 : @vm : 2 : @vm : 22 : @vm : 46 : @vm : 1 : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<5> = 'mouse' : @vm : 1 : @vm : 3 : @vm : 10 : @vm : 45 : @vm : 1 : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   d<6> = 'boxes' : @vm : 1 : @vm : 3 : @vm : 14 : @vm : 45 : @vm : 1 : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   d<7> = 'help' : @vm : 1 : @vm : 3 : @vm : 15 : @vm : 45 : @vm : 1 : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   call $tk_layout('declare', ctx, d, perr)
   gosub get.rects
   return

get.rects:
   call $tk_layout('pane', ctx, 'terminal', rc)
   t.x = rc<1, 1> ; t.y = rc<1, 2> ; t.w = rc<1, 3> ; t.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'lastkeys', rc)
   k.x = rc<1, 1> ; k.y = rc<1, 2> ; k.w = rc<1, 3> ; k.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'seen', rc)
   s.x = rc<1, 1> ; s.y = rc<1, 2> ; s.w = rc<1, 3> ; s.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'styles', rc)
   st.x = rc<1, 1> ; st.y = rc<1, 2> ; st.w = rc<1, 3> ; st.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'mouse', rc)
   mo.x = rc<1, 1> ; mo.y = rc<1, 2> ; mo.w = rc<1, 3> ; mo.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'boxes', rc)
   bx.x = rc<1, 1> ; bx.y = rc<1, 2> ; bx.w = rc<1, 3> ; bx.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'help', rc)
   hp.x = rc<1, 1> ; hp.y = rc<1, 2> ; hp.w = rc<1, 3> ; hp.h = rc<1, 4>
   t.tw = t.w - 4
   k.tw = k.w - 4
   st.tw = st.w - 4
   mo.tw = mo.w - 4
   hp.tw = hp.w - 4
   LOGN = k.h - 2                                       ;* a key to a row of Last keys; the list is cut to it when the window gets smaller
   loop while dcount(logl, @fm) > LOGN do
      del logl<LOGN + 1>
   repeat
   return

draw.all:
   lastsz = @crtwide : ',' : @crthigh
   screen clear at 0,ctx<TK.C.YBODY> size ctx<TK.C.W>,ctx<TK.C.BODYH>
   screen box at t.x,t.y size t.w,t.h title 'Terminal'
   screen box at k.x,k.y size k.w,k.h title 'Last keys'
   screen box at s.x,s.y size s.w,s.h title 'Keys seen'
   screen box at mo.x,mo.y size mo.w,mo.h title 'Mouse'
   screen box at bx.x,bx.y size bx.w,bx.h title 'Box drawing'
   screen box at hp.x,hp.y size hp.w,hp.h title 'Help'
   screen box at st.x,st.y size st.w,st.h title 'Styles'
   gosub draw.static
   gosub draw.dynamic
   return

* What does not change while the program runs: the styles, the boxes to look at, the help
draw.static:
   for i = 1 to dcount(snames, @fm)
      sn = snames<i>
      screen text fmt(sn, '12L') : ' sample text 0123456789' at st.x + 2,st.y + i attr sn width st.tw
   next i
   screen text 'A style is drawn in itself.' at st.x + 2,st.y + 18
   screen text 'The theme changes with Ctrl-T.' at st.x + 2,st.y + 19
   screen box at bx.x + 2,bx.y + 2 size 20,6
   screen box at bx.x + 24,bx.y + 2 size 19,10 title 'x'
   screen box at bx.x + 4,bx.y + 8 size 14,4
   screen text (if ctx<TK.C.UTF8> then 'The borders are line characters.' else 'The borders are + - | (not UTF-8).') at bx.x + 2,bx.y + 12
   helps = 'Press any key: its name is added to Last keys' : @fm : 'and ticked in Keys seen.' : @fm : ''
   helps := @fm : 'A key that beeps and shows nothing is not named'
   helps := @fm : 'by the terminal type: Ctrl-R, then press it again'
   helps := @fm : 'to see the bytes the terminal sent.'
   helps := @fm : ''
   helps := @fm : 'Ctrl-L clears, Ctrl-R names/bytes, Ctrl-T'
   helps := @fm : 'theme, Ctrl-K keys, Ctrl-Q leaves.'
   helps := @fm : ''
   helps := @fm : 'Make the window smaller to see the cursor'
   helps := @fm : 'lock, larger again to leave it.'
   for i = 1 to dcount(helps, @fm)
      screen text helps<i> at hp.x + 2,hp.y + i width hp.tw
   next i
   return

draw.dynamic:
   gosub draw.info
   gosub draw.log
   gosub draw.mouse
   for gk = 1 to gn
      gosub draw.cell
   next gk
   return

draw.info:
   loc = env('LC_ALL')
   if loc = '' then loc = env('LC_CTYPE')
   if loc = '' then loc = env('LANG')
   call $sl_theme('name', '', '', '', '', thn)
   nseen = 0
   for i = 1 to gn
      if seenf<i> then nseen += 1
   next i
   il = 'TERM (SD)   ' : @term.type
   il<-1> = 'TERM (env)  ' : env('TERM')
   il<-1> = 'Window      ' : @crtwide : ' x ' : @crthigh : '  (layout ' : ctx<TK.C.W> : ' x ' : ctx<TK.C.H> : ')'
   il<-1> = 'Locale      ' : (if loc = '' then '(none set)' else loc)
   il<-1> = 'Borders     ' : (if ctx<TK.C.UTF8> then 'line characters (UTF-8)' else '+ - | (not UTF-8)')
   il<-1> = 'Color       ' : colour
   il<-1> = 'Theme       ' : thn
   il<-1> = 'Mouse       ' : (mp + mr + md + mu + mdn) : ' events'
   il<-1> = 'Reading     ' : (if rawmode then 'raw bytes (KEYIN)' else 'names ($sl_key)')
   il<-1> = 'Keys seen   ' : nseen : ' of ' : gn : ', ' : nkeys : ' pressed'
   for i = 1 to dcount(il, @fm)
      screen text il<i> at t.x + 2,t.y + i width t.tw
   next i
   return

draw.log:
   for i = 1 to LOGN
      screen text logl<i> at k.x + 2,k.y + i width k.tw
   next i
   return

* One cell of the grid, number gk: [x] name when seen, [ ] name when not
draw.cell:
   gx = int((gk - 1) / GRIDROWS)
   gy = mod(gk - 1, GRIDROWS)
   screen text (if seenf<gk> then '[x] ' else '[ ] ') : gnames<gk> at s.x + 2 + gx * 11,s.y + 1 + gy width 10 attr (if seenf<gk> then 'bold' else 'normal')
   return

draw.mouse:
   screen text 'Last   ' : mlast at mo.x + 2,mo.y + 1 width mo.tw
   screen text 'Press ' : mp : '  release ' : mr at mo.x + 2,mo.y + 3 width mo.tw
   screen text 'Drag  ' : md : '  wheel up ' : mu : '  down ' : mdn at mo.x + 2,mo.y + 4 width mo.tw
   screen text 'Click, drag or turn the wheel here.' at mo.x + 2,mo.y + 6 width mo.tw
   screen text 'Raw mode shows the reports: Esc [ < ...' at mo.x + 2,mo.y + 7 width mo.tw
   return

end

* END-CODE
