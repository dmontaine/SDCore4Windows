* START-DESCRIPTION:
*
*    x = !is_grp_member(user,group)
*
*    user - linux user name to test if member of linux group (found in /etc/group)
*
*    This function sets the STATUS() value to 0 if successful, 1 if the
*    specified group does not exist.
*
* END-DESCRIPTION
*
* START-CODE

$internal
function is_grp_member(user,group)
$catalog !is_grp_member

user_found = @false
set.status 0
* Modified by Composer AI - 2026/06/10.
* Empty user or group cannot match membership; skip file scan.
* read the /etc/group file
if user = '' or group = '' then
   set.status 1
   return user_found
end
* --------------------
* read the /etc/group file
openpath "/etc" to etc then 
  read rec from etc, "group" then 
    lns = dcount(rec, @FM)

    for i = 1 to lns
      grpname = field(rec<i>,':',1)
      if grpname = group then
* rev 0.9.0  is this the user's group?
        if user = grpname then
          user_found = @true
          exit
        end
* not the user's group, see if user is a member                
        members = field(rec<i>,':',4)
        * Modified by Composer AI - 2026/06/10.
        * No supplementary members when field 4 is empty.
        * usr.ct = dcount(members,',')
        if members = '' then
           usr.ct = 0
        end else
           usr.ct = dcount(members,',')
        end
        * --------------------
        for u = 1 to usr.ct
          if user = field(members,',',u) then
            user_found = @true
            exit 
          end
        next u
      end
      if user_found then exit
    next i
  end else
  * cannot read /etc/group
    set.status 1
  end
end else
* cannot open /etc
  set.status 1
end

return user_found
end
