* START-DESCRIPTION:
*
*    call !CRED_VERIFY(account, password, ok)
*
*    Returns ok = @true only if the account has a credential recorded and the
*    password derives to the stored verifier.
*
*    It fails closed.  An account with no entry in $CRED cannot be entered,
*    and neither can one whose entry is incomplete.
*
*    The caller is responsible for not revealing which of the account name or
*    the password was wrong.
*
*    See PROJECT_STATUS.md section 5.6.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine CRED_VERIFY(account, password, ok)
$catalog !CRED_VERIFY

$include int$keys.h
$include err.h

   ok = @false
   set.status 0

   account = upcase(trim(account))
   if account = '' or password = '' then return

   openpath @sdsys:@ds:'$CRED' to cred.f else
      set.status ER$NVR
      return
   end

   read cred.rec from cred.f, account else
      close cred.f
      return                     ;* no credential - fail closed
   end

   close cred.f

   salt = cred.rec<CRED$SALT>
   verifier = cred.rec<CRED$VERIFIER>
   if salt = '' or verifier = '' then return

   derived = ''
   call !SD_KEY_FROM_PW(password, salt, derived)
   if derived = '' then return

   if derived = verifier then ok = @true

   return
end

* END-CODE
