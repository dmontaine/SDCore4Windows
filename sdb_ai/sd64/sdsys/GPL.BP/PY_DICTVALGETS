$internal
$no.symbols
$no.xref
function py_dictvalgets(dictname,key)
$catalog !py_dictvalgets

$include KEYS.H
$include ERR.H

* Modified by Composer AI - 2026/06/10.
* Reject empty Python object name(s) before SDPYOBJ/SDEXT call.
if dictname = '' or key = '' then
   set.status 1
   return ''
end
* --------------------
string = SDPYOBJ("",key,dictname,SD_PyDictVget)
*
return string

end
