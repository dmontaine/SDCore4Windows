*
* START-DESCRIPTION:
*
* GRANT <account> TO <user>
* REVOKE <account> FROM <user>
* LIST.GRANTS <account>
*
* THE GRANT IS WINDOWS GROUP MEMBERSHIP, NOT A FIELD IN THE RECORD.  Owner's
* decision, 14 Aug 2026.  Entry to an account is membership of the Windows
* group named in its ACC$GROUP, which CREATE.ACCOUNT writes as sdu_<name>, and
* which LOGIN and CPROC both test.  So these verbs edit that group and write
* NOTHING to the ACCOUNTS record.  ACC$USERS, the 13 Aug grant list, was
* removed with this step - see SYSCOM/KEYS.H.
*
* THREE VERBS, ONE PROGRAM, distinguished by the verb token.  GRANT and REVOKE
* are the owner's wording in step 5a.  LIST.GRANTS follows the LIST.KEYS
* precedent beside GRANT.KEY and REVOKE.KEY (docs/TCL_VERBS.md); "GRANT
* <account>" with no TO clause does the same thing, because it is the natural
* thing to try and answering it costs nothing.
*
* WHY LISTING NEEDED BUILDING AT ALL.  Once the grant stopped being a field,
* "who may enter this account" stopped being a question the dictionary could
* answer, and an account whose grants cannot be listed cannot be audited by
* eye.  !os_group grew a LISTMEM action for it (step 5e).
*
* THE ACCOUNT'S OWN USER IS IN THE GROUP and is listed like any other member.
* It is not a grant - CREATE.ACCOUNT puts it there - but hiding it would make
* this disagree with the Windows group it is reporting, and quietly disagreeing
* with the operating system is worse than a line that needs a moment's thought.
*
* THE AUDIT RECORD IS WRITTEN, step 5f, 16 Aug 2026 - the file it was waiting
* for is step 4 and now exists.  kernel(K$AUDIT, ...) after each successful
* group edit; the identity is stamped by audit_message() in k_error.c and is
* not passed from here, so it cannot be got wrong or forged by a caller.
* Windows still records the group edit in its own security log, and the two are
* independent records of the same act, which is the point of having both.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $grant.account
$catalog $GRANTA

$include keys.h
$include int$keys.h
$include parser.h
$include err.h

deffun os_group(action,group,member) calling '!os_group'
deffun is_grp_member(user,group) calling '!is_grp_member'
deffun is_user(uname) calling '!is_user'

   prompt ''

   parser = "!PARSER"

* IT SAYS SO BEFORE IT TRIES.  Step 5b: !os_group returns 5 for "not
* elevated", but that is the backstop - the refusal a person sees should be
* SD's, in SD's words, and not a status code out of PowerShell.  CREATEA
* line 87 gates the same way.
   if not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001)  ;* Command requires administrator privileges
   end

   @system.return.code = -ER$ARGS     ;* Preset for argument errors

   call @parser(parser$reset, 0, @sentence, 0)
   call @parser(parser$get.token, token.type, verb, keyword)

   verb = upcase(verb)
   listing = (verb = 'LIST.GRANTS')
   granting = (verb = 'GRANT')

   * Account name, prompted for if it was left off

   call @parser(parser$get.token, token.type, acc.name, keyword)
   if token.type = PARSER$END then
      display sysmsg(6001) :  ;* Account name:
      input acc.name
      acc.name = trim(acc.name)
      if acc.name = '' then stop
   end
   acc.name = upcase(acc.name)

   * TO / FROM clause.  Absent means "list", which is what LIST.GRANTS is.

   user = ''
   if not(listing) then
      call @parser(parser$get.token, token.type, kw, keyword)
      begin case
         case token.type = PARSER$END
            listing = @true
         case granting and upcase(kw) = 'TO'
            gosub get.user
         case (not(granting)) and upcase(kw) = 'FROM'
            gosub get.user
         case 1
            stop sysmsg(2018, kw) ;* Unexpected token (xx)
      end case
   end else
      call @parser(parser$get.token, token.type, token, keyword)
      if token.type # PARSER$END then
         stop sysmsg(2018, token) ;* Unexpected token (xx)
      end
   end

   gosub resolve.account

   begin case
      case listing
         gosub do.list
      case granting
         gosub do.grant
      case 1
         gosub do.revoke
   end case

   stop

* ======================================================================
* Read the account and find the Windows group that IS the grant.

resolve.account:
   openpath @sdsys:@ds:'ACCOUNTS' to acc.f else
      @system.return.code = -status()
      stop sysmsg(6000) ;* Cannot open ACCOUNTS file in SDSYS account
   end

   read acc.rec from acc.f, acc.name else
      @system.return.code = -status()
      stop sysmsg(6027) ;* Account not registered in ACCOUNTS file
   end

*  REFUSED RATHER THAN GUESSED.  Step 5a: an empty ACC$GROUP means a record
*  older than CREATE.ACCOUNT's group work.  Inventing "sdu_":acc.name here
*  would create a Windows group nothing else consults and report success,
*  which is a worse outcome than saying the record needs attention.
   grp = trim(acc.rec<ACC$GROUP>)
   if grp = '' then
      @system.return.code = -ER$ARGS
      stop sysmsg(10044, acc.name) ;* Account %1 has no Windows group recorded
   end

   return

* ======================================================================

get.user:
   call @parser(parser$get.token, token.type, user, keyword)
   if token.type = PARSER$END then
      stop sysmsg(6074) ;* Invalid user name
   end

   call @parser(parser$get.token, token.type, token, keyword)
   if token.type # PARSER$END then
      stop sysmsg(2018, token) ;* Unexpected token (xx)
   end

   return

* ======================================================================

do.grant:
   if not(is_user(user)) then
      stop sysmsg(10045, user) ;* There is no Windows account named %1
   end

*  !os_group ADDMEM is idempotent and would report success either way.  Asking
*  first is what lets this say "already" rather than implying it did something.
   if is_grp_member(user, grp) then
      crt sysmsg(10017, user, grp) ;* %1 is already a member of group %2
      @system.return.code = 0
      return
   end

   rc = os_group('ADDMEM', grp, user)
   if rc # 0 then gosub group.failed

* 16 Aug 26 Windows port - step 5f, written once step 4 gave it a file.  After
*   the group edit, so this records what happened and not what was attempted;
*   a failed ADDMEM leaves through group.failed and never reaches here.
   void kernel(K$AUDIT, 'GRANT account=' : acc.name : ' to=' : user)

   crt sysmsg(10041, user, acc.name) ;* %1 may now use account %2
   gosub say.sign.out

   @system.return.code = 0
   return

* ======================================================================

do.revoke:
*  No is_user test.  Revoking somebody whose Windows account has been deleted
*  is a reasonable thing to want, and is_grp_member answers the question that
*  actually matters here.  A member left as an orphaned SID matches no name and
*  reports "has not been granted", which is honest about what this can see.
   if not(is_grp_member(user, grp)) then
      crt sysmsg(10049, user, acc.name) ;* %1 has not been granted account %2
      @system.return.code = 0
      return
   end

   rc = os_group('DELMEM', grp, user)
   if rc # 0 then gosub group.failed

* 16 Aug 26 Windows port - step 5f.  See do.grant above.
   void kernel(K$AUDIT, 'REVOKE account=' : acc.name : ' from=' : user)

   crt sysmsg(10042, user, acc.name) ;* %1 no longer has account %2
   gosub say.sign.out

   @system.return.code = 0
   return

* ======================================================================

do.list:
   members = ''
   rc = os_group('LISTMEM', grp, members)
   if rc # 0 then
      @system.return.code = -ER$ARGS
      stop sysmsg(10048, grp, rc) ;* Cannot read the members of group %1
   end

   count.members = dcount(members, @fm)
   if members = '' then count.members = 0

   if count.members = 0 then
      crt sysmsg(10046, acc.name) ;* Nobody has been granted account %1
      @system.return.code = 0
      return
   end

   crt sysmsg(10047, acc.name) ;* Windows accounts granted %1:
   for m = 1 to count.members
      crt '   ' : members<m>
   next m

   @system.return.code = 0
   return

* ======================================================================
* THE SIGN-OUT LINE IS NOT A PLEASANTRY - step 5c.
*
* Group membership is fixed in the access token at logon, so a grant does not
* reach the person until they sign out of Windows and back in, and until then
* SD refuses them with sysmsg(10003) exactly as though the grant had failed.
* It is the single most confusing thing about this model and the grant is the
* moment to explain it.
*
* IT APPLIES TO REVOKE JUST AS MUCH, and there it matters more: somebody whose
* grant has been taken away KEEPS the account until their next sign-in.  An
* administrator who reads this line as a formality on the way past will believe
* access ended when it has not.

say.sign.out:
   crt sysmsg(10043, user) ;* %1 must sign out of Windows and back in
   return

* ======================================================================

group.failed:
*  5 is "not elevated".  The gate at the top should have caught it, so seeing
*  it here means elevation was lost between the two - report !os_group's answer
*  rather than a guess, because it is the more precise one.
   if rc = 5 then stop sysmsg(2001) ;* Command requires administrator privileges

   @system.return.code = -ER$ARGS
   stop sysmsg(10050, grp, rc) ;* Cannot change the members of group %1

end

* END-CODE
