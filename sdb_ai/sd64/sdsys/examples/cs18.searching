* cs18.searching - linear search and binary search, counting how many items each looks at
*
* A linear search looks at every item in turn.  A binary search of a SORTED list looks at the middle and throws
* away the half that cannot hold the item, so 1000 items take at most 10 looks.

program cs18.searching
   n = 1000
   dim list(n)
   for i = 1 to n
      list(i) = i * 3                        ;* 3, 6, 9 ... 3000: sorted
   next i
   targets = 3 : @fm : 1500 : @fm : 2997 : @fm : 1001
   for t = 1 to dcount(targets, @fm)
      want = targets<t>
      gosub linear(want, pos.l, looks.l)
      gosub binary(want, pos.b, looks.b)
      crt fmt(want, 'R#5') : '  linear: ' : fmt((if pos.l then 'at ' : pos.l else 'absent'), 'L#8') : fmt(looks.l, 'R#5') : ' looks' : '   binary: ' : fmt((if pos.b then 'at ' : pos.b else 'absent'), 'L#8') : fmt(looks.b, 'R#3') : ' looks'
   next t
   stop

local subroutine linear(want, pos, looks)
   private i
   pos = 0
   looks = 0
   for i = 1 to n
      looks += 1
      if list(i) = want then
         pos = i
         exit
      end
   next i
   return
end

local subroutine binary(want, pos, looks)
   private lo, hi, mid
   pos = 0
   looks = 0
   lo = 1
   hi = n
   loop
   while lo <= hi do
      mid = int((lo + hi) / 2)
      looks += 1
      begin case
         case list(mid) = want
            pos = mid
            exit
         case list(mid) < want
            lo = mid + 1
         case 1
            hi = mid - 1
      end case
   repeat
   return
end
end
