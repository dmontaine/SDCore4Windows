' Server status constants (sorted)
Public Const SV_ELSE As Integer = 2
Public Const SV_ERROR As Integer = 3
Public Const SV_LOCKED As Integer = 4
Public Const SV_OK As Integer = 0
Public Const SV_ON_ERROR As Integer = 1
Public Const SV_PROMPT As Integer = 5
