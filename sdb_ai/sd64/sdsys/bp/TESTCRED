* TESTCRED
* Phase 2 test: version 2 $CRED records, written by !CRED_SET and checked by
* !CRED_VERIFY.
*
* It works on scratch ids - ZZSCRAMTEST and ZZSCRAMV1 - and deletes them at
* the end, so no real account's credential is touched.  !CRED_SET does not
* require the account to exist; SET.PASSWORD is what checks the register.
*
* EXPECT IT TO PAUSE.  Six PBKDF2 derivations at 600,000 iterations each, and
* that cost is the point of the setting - it is what an offline attack on a
* stolen $CRED has to pay per guess.
*
* Needs SDSYS and internal mode, like everything that calls SDEXT:
*
*   sd -INTERNAL -ASDSYS
*   BASIC BP TESTCRED
*   RUN BP TESTCRED
*
* docs/SCRAM_AUTH.md
$internal

*  THREE-TOKEN INCLUDE, because this program lives in BP.  BCOMP resolves a
*  two-token $include against the source's OWN file first and then syscom
*  (BCOMP:2990).  INT$KEYS.H is in gpl.bp and in neither of those, so from
*  here it has to be named explicitly.  KEYS.H is in syscom and does not.
$include gpl.bp INT$KEYS.H
$include keys.h

      ACCT = 'ZZSCRAMTEST'
      V1.ACCT = 'ZZSCRAMV1'
      PW = 'pencil'

      CHECKS = 0
      BAD = 0

      CRT 'Writing a credential'

      OK = @FALSE
      CALL !CRED_SET(ACCT, PW, OK)
      NAME = 'CRED_SET ok'
      GOT = OK
      WANT = @TRUE
      GOSUB CHECK.IT

      OPENPATH @SDSYS : @DS : '$cred' TO CRED.F ELSE
         CRT 'Cannot open $cred - are you elevated?'
         STOP
      END

      READ REC FROM CRED.F, ACCT ELSE
         CRT 'No record was written for ' : ACCT
         CLOSE CRED.F
         STOP
      END

      CRT
      CRT 'Stored record'

      NAME = 'version'
      GOT = REC<CRED$VERSION>
      WANT = SCRAM$CRED.VERSION
      GOSUB CHECK.IT

      NAME = 'mechanism'
      GOT = REC<CRED$MECH>
      WANT = 'SCRAM-SHA-256'
      GOSUB CHECK.IT

      NAME = 'iterations'
      GOT = REC<CRED$ITER>
      WANT = SCRAM$ITERATIONS
      GOSUB CHECK.IT

      NAME = 'salt present'
      IF REC<CRED$SALT> = '' THEN GOT = 0 ELSE GOT = 1
      WANT = 1
      GOSUB CHECK.IT

      NAME = 'StoredKey present'
      IF REC<CRED$STOREDKEY> = '' THEN GOT = 0 ELSE GOT = 1
      WANT = 1
      GOSUB CHECK.IT

      NAME = 'ServerKey present'
      IF REC<CRED$SERVERKEY> = '' THEN GOT = 0 ELSE GOT = 1
      WANT = 1
      GOSUB CHECK.IT

*     The whole point of the store: the password must not be recoverable from
*     it, so it must not be sitting in it either.
      NAME = 'password absent'
      IF INDEX(REC, PW, 1) THEN GOT = 0 ELSE GOT = 1
      WANT = 1
      GOSUB CHECK.IT

*     Recompute independently from the stored salt and iteration count.  This
*     is what proves CRED_SET derived what it claims rather than storing
*     something that merely round-trips through CRED_VERIFY.
      CRT
      CRT 'Independent derivation'

      SALTED = SDEXT(PW : @FM : REC<CRED$SALT> : @FM : REC<CRED$ITER> : @FM : SCRAM$KEY.LEN, @TRUE, SD_PBKDF2)
      CK = SDEXT(SALTED : @FM : 'Client Key', @TRUE, SD_HMACSHA256)

      NAME = 'StoredKey matches'
      GOT = SDEXT(CK, @TRUE, SD_SHA256)
      WANT = REC<CRED$STOREDKEY>
      GOSUB CHECK.IT

      NAME = 'ServerKey matches'
      GOT = SDEXT(SALTED : @FM : 'Server Key', @TRUE, SD_HMACSHA256)
      WANT = REC<CRED$SERVERKEY>
      GOSUB CHECK.IT

      SALTED = ''
      CK = ''

      CRT
      CRT 'Verification'

      OK = @FALSE
      CALL !CRED_VERIFY(ACCT, PW, OK)
      NAME = 'right password'
      GOT = OK
      WANT = @TRUE
      GOSUB CHECK.IT

      OK = @TRUE
      CALL !CRED_VERIFY(ACCT, 'pencil2', OK)
      NAME = 'wrong password'
      GOT = OK
      WANT = @FALSE
      GOSUB CHECK.IT

      OK = @TRUE
      CALL !CRED_VERIFY('ZZNOSUCHACCOUNT', PW, OK)
      NAME = 'unknown account'
      GOT = OK
      WANT = @FALSE
      GOSUB CHECK.IT

*     A version 1 record must be refused rather than misread.  Field 1 of a v1
*     record is a base64 salt, which is not "2", so the version gate rejects it
*     before anything tries to derive from a field that is not what it thinks.
      V1REC = ''
      V1REC<1> = 'W22ZaJ0SNY7soEsUEjb6gQ=='
      V1REC<2> = 'an-argon2-verifier-from-version-1'
      WRITE V1REC TO CRED.F, V1.ACCT ON ERROR
         CRT 'Could not write the version 1 test record'
         CLOSE CRED.F
         STOP
      END

      OK = @TRUE
      CALL !CRED_VERIFY(V1.ACCT, PW, OK)
      NAME = 'version 1 refused'
      GOT = OK
      WANT = @FALSE
      GOSUB CHECK.IT

      DELETE CRED.F, V1.ACCT
      DELETE CRED.F, ACCT
      CLOSE CRED.F

      CRT
      CRT CHECKS : ' checks, ' : BAD : ' failed'
      CRT 'Scratch records removed.'
      STOP

CHECK.IT:
      CHECKS = CHECKS + 1
      IF GOT = WANT THEN
         CRT '  ok    ' : NAME
      END ELSE
         BAD = BAD + 1
         CRT '  FAIL  ' : NAME
         CRT '          got  ' : GOT
         CRT '          want ' : WANT
      END
      RETURN

      END
