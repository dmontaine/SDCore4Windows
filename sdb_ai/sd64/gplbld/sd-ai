def sid_text(psid):
    """A SID (pointer) as S-1-..., or None."""
    out = wt.LPWSTR()
    if not psid or not adv.ConvertSidToStringSidW(psid, ctypes.byref(out)):
        return None
    try:
        return out.value
    finally:
        k32.LocalFree(out)


def computer_name():
    buf = ctypes.create_unicode_buffer(64)
    n = wt.DWORD(len(buf))
    return buf.value if k32.GetComputerNameW(buf, ctypes.byref(n)) else ""


def account_sid(name):
    """The SID of an account named DOMAIN\\name or name, as text; None when there is no such account."""
    sid = ctypes.create_string_buffer(68)
    slen = wt.DWORD(len(sid))
    dom = ctypes.create_unicode_buffer(256)
    dlen = wt.DWORD(len(dom))
    use = wt.DWORD()
    if not adv.LookupAccountNameW(None, name, sid, ctypes.byref(slen), dom, ctypes.byref(dlen), ctypes.byref(use)):
        return None
    return sid_text(sid)


def token_info(tok, cls):
    need = wt.DWORD()
    adv.GetTokenInformation(tok, cls, None, 0, ctypes.byref(need))
    if need.value == 0:
        return None
    buf = ctypes.create_string_buffer(need.value)
    if not adv.GetTokenInformation(tok, cls, buf, need, ctypes.byref(need)):
        return None
    return buf


class Caller:
    """Who is on the other end of the pipe: the account's SID, whether its token is elevated, and whether Administrators is ENABLED in it (only so when elevated)."""

    def __init__(self, sid, elevated, admins):
        self.sid, self.elevated, self.admins = sid, elevated, admins

    def __str__(self):
        return self.sid


def read_token(tok):
    """A Caller from a token handle, or None when any part cannot be read."""
    tu = token_info(tok, TokenUser)
    if tu is None:
        return None
    sid = sid_text(ctypes.cast(tu, ctypes.POINTER(ctypes.c_void_p))[0])
    if sid is None:
        return None
    te = token_info(tok, TokenElevation)
    elevated = te is not None and ctypes.cast(te, ctypes.POINTER(wt.DWORD))[0] != 0
    admins = False
    tg = token_info(tok, TokenGroups)
    if tg is not None:
        count = ctypes.cast(tg, ctypes.POINTER(wt.DWORD))[0]
        off = ctypes.sizeof(ctypes.c_void_p)                         # SID_AND_ATTRIBUTES[] after the count, pointer-aligned
        step = 2 * ctypes.sizeof(ctypes.c_void_p)
        base = ctypes.addressof(tg)
        for i in range(count):
            psid = ctypes.c_void_p.from_address(base + off + i * step).value
            attr = wt.DWORD.from_address(base + off + i * step + ctypes.sizeof(ctypes.c_void_p)).value
            if sid_text(psid) == SID_ADMINS and attr & SE_GROUP_ENABLED and not attr & SE_GROUP_USE_FOR_DENY_ONLY:
                admins = True
    return Caller(sid, elevated, admins)


def own_sid():
    """The account this process runs as (in the service: NT SERVICE\\sd-ai's own SID)."""
    tok = wt.HANDLE()
    if not adv.OpenProcessToken(k32.GetCurrentProcess(), TOKEN_QUERY, ctypes.byref(tok)):
        return None
    try:
        c = read_token(tok)
        return c.sid if c else None
    finally:
        k32.CloseHandle(tok)


# ---------------------------------------------------------------------------------------------------- settings

def parse_kv(path):
    """key=value lines (blank lines and # comments allowed); a line with no = is a damaged file, not something to skip."""
    out = {}
    try:
        with open(path, encoding="ascii") as f:
            for n, line in enumerate(f, 1):
                line = line.rstrip("\n")
                if not line.strip() or line.lstrip().startswith("#"):
                    continue
                if "=" not in line:
                    raise Refuse("badconf", "%s line %d has no =" % (os.path.basename(path), n))
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip()
    except FileNotFoundError:
        return out
    except (OSError, UnicodeDecodeError) as e:
        raise Refuse("badconf", "cannot read %s: %s" % (os.path.basename(path), e.__class__.__name__))
    return out


def read_providers(path):
    """The shipped table: [name] sections of key=value lines, only the named providers, every value checked."""
    table = {}
    cur = None
    try:
        with open(path, encoding="ascii") as f:
            for n, line in enumerate(f, 1):
                line = line.rstrip("\n")
                if not line.strip() or line.lstrip().startswith("#"):
                    continue
                m = re.match(r"^\[([a-z]+)\]$", line.strip())
                if m:
                    cur = m.group(1)
                    if cur not in NAMED or cur in table:
                        raise Refuse("badconf", "providers file: section %s is not a shipped provider or is repeated" % cur)
                    table[cur] = {}
                elif cur is None or "=" not in line:
                    raise Refuse("badconf", "providers file line %d" % n)
                else:
                    k, v = line.split("=", 1)
                    table[cur][k.strip()] = v.strip()
    except FileNotFoundError:
        raise Refuse("badconf", "the providers file is missing")
    except (OSError, UnicodeDecodeError):
        raise Refuse("badconf", "cannot read the providers file")
    for name, p in table.items():
        check_connection(p, "providers file [%s]" % name)
        if not MODEL_RE.match(p.get("model", "x")):
            raise Refuse("badconf", "providers file [%s]: model has characters a model name may not have" % name)
    if set(table) != set(NAMED):
        raise Refuse("badconf", "providers file does not describe exactly %s" % ", ".join(NAMED))
    return table


def check_connection(p, what):
    """The connection details of one provider are well formed: an https URL, a known format, auth style and token parameter."""
    if not URL_RE.match(p.get("url", "")):
        raise Refuse("badconf", "%s: url must be https://host[:port]/path with plain characters" % what)
    host = URL_RE.match(p["url"]).group(1)
    port = URL_RE.match(p["url"]).group(2)
    if host.endswith("-") or ".." in host or (port and not 1 <= int(port[1:]) <= 65535):
        raise Refuse("badconf", "%s: bad host or port" % what)
    if p.get("format") not in FORMATS:
        raise Refuse("badconf", "%s: format must be one of %s" % (what, ", ".join(FORMATS)))
    if p.get("auth") not in AUTHS:
        raise Refuse("badconf", "%s: auth must be one of %s" % (what, ", ".join(AUTHS)))
    if p.get("maxparam") not in MAXPARAMS:
        raise Refuse("badconf", "%s: maxparam must be one of %s" % (what, ", ".join(MAXPARAMS)))
    if p.get("version", "") and not VERSION_RE.match(p["version"]):
        raise Refuse("badconf", "%s: version has characters a header value may not have" % what)
    if not NAME_RE.match(p.get("name", "x")):
        raise Refuse("badconf", "%s: name" % what)


def plain_path(v):
    """A local drive path of plain characters, written with forward slashes (C:/...), with no .. part (the ca-file setting).  Windows: Linux takes /path; SET.AI
    words may not hold a backslash, and Python opens C:/a/b as it opens C:\\a\\b."""
    return bool(re.match(r"^[A-Za-z]:/[A-Za-z0-9._/+-]{1,200}$", v)) and ".." not in v.split("/")


def int_setting(conf, name):
    try:
        v = int(conf.get("limit." + name, LIMITS[name]))
    except ValueError:
        raise Refuse("badconf", "limit.%s is not a number" % name)
    if v < 1 or v > (300 if name == "timeout" else 10 ** 9):
        raise Refuse("badconf", "limit.%s out of range" % name)
    return v


def selected(conf, table):
    """(provider name, its connection details, its model), or None when AI is off (no provider selected).  The model is the administrator's, or the provider's starting model
    from the shipped table while the administrator has set none (Custom has no starting model)."""
    name = conf.get("provider", "")
    if name == "":
        return None
    if name not in PROVIDERS:
        raise Refuse("badconf", "provider is not one of %s" % ", ".join(PROVIDERS))
    if name == "custom":
        p = {k[len("custom."):]: v for k, v in conf.items() if k.startswith("custom.")}
        check_connection(p, "the custom provider")
        p.setdefault("name", "Custom")
    else:
        p = dict(table[name])
    return name, p, conf.get("model." + name, "") or p.get("model", "")


# ---------------------------------------------------------------------------------------------------- the caller

def peer(fd):
    """The caller on the other end of the pipe that is fd, read from the pipe itself (Linux: peer_uid and SO_PEERCRED), or None when fd is not a pipe whose
    client can be read, or the caller is a service account.  The thread impersonates at IDENTIFICATION level only (the client asked for no more), reads the
    token, and reverts; if it cannot revert, the process ends rather than go on as anyone else."""
    try:
        h = msvcrt.get_osfhandle(fd)
    except OSError:
        return None
    if not adv.ImpersonateNamedPipeClient(h):
        return None
    caller = None
    tok = wt.HANDLE()
    try:
        if adv.OpenThreadToken(k32.GetCurrentThread(), TOKEN_QUERY, True, ctypes.byref(tok)) or \
                adv.OpenThreadToken(k32.GetCurrentThread(), TOKEN_QUERY, False, ctypes.byref(tok)):
            try:
                caller = read_token(tok)
            finally:
                k32.CloseHandle(tok)
    finally:
        if not adv.RevertToSelf():
            os._exit(5)
    if caller is None or caller.sid in SERVICE_SIDS:
        return None
    return caller


def in_group(sid, group):
    """True only when the local group exists and the caller's own SID is a direct member of it, read now; every doubt is False."""
    if not sid:
        return False
    resume = ctypes.c_size_t(0)
    try:
        while True:
            buf = ctypes.c_void_p()
            read = wt.DWORD()
            total = wt.DWORD()
            rc = netapi.NetLocalGroupGetMembers(None, group, 0, ctypes.byref(buf), 0xFFFFFFFF, ctypes.byref(read), ctypes.byref(total), ctypes.byref(resume))
            if rc not in (0, 234):                       # NERR_Success, ERROR_MORE_DATA
                return False
            try:
                for i in range(read.value):
                    psid = ctypes.c_void_p.from_address(buf.value + i * ctypes.sizeof(ctypes.c_void_p)).value
                    if sid_text(psid) == sid:
                        return True
            finally:
                if buf:
                    netapi.NetApiBufferFree(buf)
            if rc == 0:
                return False
    except (OSError, ValueError):
        return False


def is_sdsys(caller):
    """The local account SDSYS, elevated (it is only ever an elevated sign-in on Windows)."""
    if caller is None or not caller.elevated:
        return False
    want = account_sid(computer_name() + "\\" + ADMIN_USER)
    return want is not None and caller.sid == want


def is_admin(caller):
    """May change the settings and read the connection details: SDSYS, or another ELEVATED member of Administrators (owner, 13 Nov 2026, Q6; Linux: sdsys or root)."""
    return caller is not None and (is_sdsys(caller) or (caller.elevated and caller.admins))


def may_ask(caller):
    """S.163: the administrator SDSYS may always ask; anyone else only as a member of the gate group - another Windows administrator too (owner, Q6).  SDSYS
    cannot be given the gate (modify.account refuses the account name sdsys, 2202), and is the one who turns the AI on at all (provider, model, key)."""
    return caller is not None and (is_sdsys(caller) or in_group(caller.sid, GATE_GROUP))


# ---------------------------------------------------------------------------------------------------- key (DPAPI), limits

def _blob(data):
    buf = ctypes.create_string_buffer(data, len(data))
    return DATA_BLOB(len(data), ctypes.cast(buf, ctypes.POINTER(ctypes.c_char))), buf


def dpapi(data, entropy, protect):
    """CryptProtectData / CryptUnprotectData in THIS ACCOUNT'S user scope (no CRYPTPROTECT_LOCAL_MACHINE: only this account can open it), no UI.  None on failure."""
    din, k1 = _blob(data)
    ent, k2 = _blob(entropy)
    out = DATA_BLOB()
    if protect:
        ok = crypt.CryptProtectData(ctypes.byref(din), None, ctypes.byref(ent), None, None, 0x1, ctypes.byref(out))
    else:
        ok = crypt.CryptUnprotectData(ctypes.byref(din), None, ctypes.byref(ent), None, None, 0x1, ctypes.byref(out))
    if not ok:
        return None
    try:
        return ctypes.string_at(out.pbData, out.cbData)
    finally:
        k32.LocalFree(out.pbData)


def key_entropy(name):
    return ("sd-ai key " + name).encode("ascii")


def acl_sids(path):
    """The SIDs that an ALLOW entry of the file's access list names, or None when it cannot be read, has no list (everyone), or holds an entry of a kind not known here."""
    dacl = ctypes.c_void_p()
    sd = ctypes.c_void_p()
    if adv.GetNamedSecurityInfoW(path, SE_FILE_OBJECT, DACL_SECURITY_INFORMATION, None, None, ctypes.byref(dacl), None, ctypes.byref(sd)) != 0:
        return None
    try:
        if not dacl.value:
            return None
        info = ACL_SIZE_INFORMATION()
        if not adv.GetAclInformation(dacl, ctypes.byref(info), ctypes.sizeof(info), 2):
            return None
        sids = set()
        for i in range(info.AceCount):
            ace = ctypes.c_void_p()
            if not adv.GetAce(dacl, i, ctypes.byref(ace)):
                return None
            hdr = ACE_HEADER.from_address(ace.value)
            if hdr.AceType == 1:                          # ACCESS_DENIED_ACE: takes nothing away from who may NOT read it
                continue
            if hdr.AceType != 0:                          # anything but a plain ALLOW: not a list this helper can judge
                return None
            sids.add(sid_text(ace.value + 8))             # ACE_HEADER, the mask, then the SID
        return sids
    finally:
        k32.LocalFree(sd)


def private_file(path):
    """True when path is a plain file (not a link or other reparse point) whose access list allows only this account and SYSTEM (Linux: mode 0600, sdai's own)."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    if not stat.S_ISREG(st.st_mode) or getattr(st, "st_file_attributes", 0) & FILE_ATTRIBUTE_REPARSE_POINT:
        return False
    sids = acl_sids(path)
    me = own_sid()
    return sids is not None and me is not None and sids <= {me, SID_SYSTEM}


def read_key(state, name):
    """The key of a provider: a DPAPI blob of this account's, in a file only it and SYSTEM may open (a file anyone else can open is refused: the helper does not repair it)."""
    path = os.path.join(state, "keys", name)
    if not os.path.lexists(path):
        raise Refuse("nokey", "no key has been set for this provider")
    if not private_file(path):
        raise Refuse("nokey", "the key file is not private")
    try:
        with open(path, "rb") as f:
            blob = f.read(65536)
    except OSError:
        raise Refuse("nokey", "the key file cannot be read")
    raw = dpapi(blob, key_entropy(name), False)
    if raw is None:
        raise Refuse("nokey", "the key file cannot be opened by this helper")
    try:
        key = raw.decode("ascii").strip()
    except UnicodeDecodeError:
        raise Refuse("nokey", "the key file does not hold a key")
    if not re.match(r"^[\x21-\x7e]{8,512}$", key):
        raise Refuse("nokey", "the key file does not hold a key")
    return key


def private_create(path):
    """A new file (replacing one) whose access list is protected and names only this account and SYSTEM, open for writing in binary."""
    me = own_sid()
    if me is None:
        raise OSError("the account of this helper cannot be read")
    sddl = "O:%sD:P(A;;FA;;;SY)(A;;FA;;;%s)" % (me, me)
    psd = ctypes.c_void_p()
    if not adv.ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl, 1, ctypes.byref(psd), None):
        raise OSError("the access list cannot be made")
    try:
        sa = SECURITY_ATTRIBUTES(ctypes.sizeof(SECURITY_ATTRIBUTES), psd, False)
        h = k32.CreateFileW(path, 0x40000000, 0, ctypes.byref(sa), 2, 0x80, None)   # GENERIC_WRITE, no sharing, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL
    finally:
        k32.LocalFree(psd)
    if h == INVALID_HANDLE or h is None:
        raise OSError("cannot create %s" % os.path.basename(path))
    return os.fdopen(msvcrt.open_osfhandle(h, os.O_WRONLY | os.O_BINARY), "wb")


def replace(tmp, path):
    """os.replace, tried a few times: on Windows a file another request is reading cannot be replaced for that moment."""
    for attempt in range(20):
        try:
            os.replace(tmp, path)
            return
        except PermissionError:
            if attempt == 19:
                raise
            time.sleep(0.05)


class Locked:
    """An exclusive byte lock on an open descriptor, for the with statement (Linux: flock LOCK_EX).  msvcrt.locking retries for ten seconds, then raises."""

    def __init__(self, fd):
        self.fd = fd

    def __enter__(self):
        os.lseek(self.fd, 0, 0)
        msvcrt.locking(self.fd, msvcrt.LK_LOCK, 1)
        return self

    def __exit__(self, *a):
        os.lseek(self.fd, 0, 0)
        msvcrt.locking(self.fd, msvcrt.LK_UNLCK, 1)


def counters(state, uid, now, limits, add_tokens=None, count=False):
    """The per-caller counters under an exclusive lock.  count=True first checks the limits and, if they hold, records the request; add_tokens
    adds a finished request's tokens.  Requests are kept as the times of the last hour, tokens as the total of the UTC day.  uid is the caller (its SID names the file)."""
    d = os.path.join(state, "state")
    path = os.path.join(d, "u%s" % uid)
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_BINARY, 0o600)
    except OSError:
        raise Refuse("limit", "the counters cannot be kept, so no request is made")
    try:
        try:
            lock = Locked(fd).__enter__()
        except OSError:
            raise Refuse("limit", "the counters cannot be kept, so no request is made")
        try:
            os.lseek(fd, 0, 0)
            raw = b""
            while True:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                raw += chunk
            try:
                data = json.loads(raw.decode("ascii") or "{}")
                reqs = [float(t) for t in data.get("requests", []) if now - float(t) < 3600]
                day = str(data.get("day", ""))
                tokens = int(data.get("tokens", 0))
            except (ValueError, TypeError, UnicodeDecodeError, AttributeError):
                reqs, day, tokens = [], "", 0
            today = time.strftime("%Y-%m-%d", time.gmtime(now))
            if day != today:
                day, tokens = today, 0
            if count:
                if len(reqs) >= limits["requests-hour"]:
                    raise Refuse("limit", "the hourly limit of %d requests is used up" % limits["requests-hour"])
                if tokens >= limits["tokens-day"]:
                    raise Refuse("limit", "the daily limit of %d tokens is used up" % limits["tokens-day"])
                reqs.append(now)
            if add_tokens:
                tokens += int(add_tokens)
            out = json.dumps({"requests": reqs, "day": day, "tokens": tokens}).encode("ascii")
            os.lseek(fd, 0, 0)
            os.ftruncate(fd, 0)
            os.write(fd, out)
            return len(reqs), tokens
        finally:
            lock.__exit__()
    finally:
        os.close(fd)


# ---------------------------------------------------------------------------------------------------- reply hygiene

def hygiene(text):
    """ASCII, newline and tab only.  Returns (text, number of characters replaced by ?)."""
    out = []
    replaced = 0
    for ch in text:
        o = ord(ch)
        if ch in "\n\t" or 0x20 <= o < 0x7F:
            out.append(ch)
        elif ch == "\r":
            continue
        elif o in PLAIN:
            out.append(PLAIN[o])
        else:
            out.append("?")
            replaced += 1
    return "".join(out), replaced


# ---------------------------------------------------------------------------------------------------- the provider call

HISTORY_MAX = 3                   # earlier exchanges a follow-up may carry (SD keeps no more)


def read_history(req):
    """The earlier exchanges of a follow-up as a list of (question, answer); [] when the request has none.  Refuse(badreq) for any other shape."""
    h = req.get("history")
    if h is None:
        return []
    if not isinstance(h, list) or len(h) > HISTORY_MAX:
        raise Refuse("badreq", "history is a list of at most %d exchanges" % HISTORY_MAX)
    out = []
    for e in h:
        if not isinstance(e, dict) or set(e) != {"q", "a"} or not isinstance(e["q"], str) or not isinstance(e["a"], str) or not e["q"].strip():
            raise Refuse("badreq", "an exchange of the history is {\"q\": text, \"a\": text}")
        out.append((e["q"], e["a"]))
    return out


def history_messages(history):
    """The earlier exchanges as messages, oldest first: the question as the user's, the answer as the assistant's."""
    msgs = []
    for q, a in history:
        msgs.append({"role": "user", "content": q})
        msgs.append({"role": "assistant", "content": a if a.strip() else "(no answer)"})
    return msgs


def build_request(name, p, key, model, system, prompt, maxtokens, history=()):
    """(path, headers, body bytes) for the provider's wire format.  history (a follow-up): earlier (question, answer) pairs, sent as messages before the prompt."""
    url = urllib.parse.urlsplit(p["url"])
    path = url.path or "/"
    if url.query:
        path += "?" + url.query
    headers = {"Content-Type": "application/json", "Accept": "application/json", "User-Agent": "sd-ai/1"}
    if p["auth"] == "bearer":
        headers["Authorization"] = "Bearer " + key
    else:
        headers["x-api-key"] = key
    if p["format"] == "anthropic":
        headers["anthropic-version"] = p.get("version") or "2023-06-01"
        body = {"model": model, p["maxparam"]: maxtokens, "messages": history_messages(history) + [{"role": "user", "content": prompt}]}
        if system:
            blk = {"type": "text", "text": system}
            if len(system) >= 4096:
                blk["cache_control"] = {"type": "ephemeral"}      # a long fixed system text (the guide) is cached by the provider
            body["system"] = [blk]
    else:
        msgs = []
        if system:
            msgs.append({"role": "system", "content": system})
        msgs.extend(history_messages(history))
        msgs.append({"role": "user", "content": prompt})
        body = {"model": model, p["maxparam"]: maxtokens, "messages": msgs}
    return path, headers, json.dumps(body).encode("utf-8")


def parse_reply(fmt, raw):
    """(text, tokens in, tokens out, truncated) from a provider's JSON; Refuse for an error object, a refusal or a shape it does not know."""
    try:
        j = json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        raise Refuse("badreply", "the provider's answer is not JSON")
    if not isinstance(j, dict):
        raise Refuse("badreply", "the provider's answer is not an object")
    if j.get("type") == "error" or ("error" in j and fmt == "openai"):
        raise Refuse("refused", "the provider returned an error")
    try:
        if fmt == "anthropic":
            if j.get("stop_reason") == "refusal":
                raise Refuse("declined", "the model declined the request")
            text = "".join(b.get("text", "") for b in j["content"] if isinstance(b, dict) and b.get("type") == "text")
            u = j.get("usage", {})
            tin = int(u.get("input_tokens", 0)) + int(u.get("cache_creation_input_tokens", 0) or 0) + int(u.get("cache_read_input_tokens", 0) or 0)
            tout = int(u.get("output_tokens", 0))
            trunc = j.get("stop_reason") == "max_tokens"
        else:
            ch = j["choices"][0]
            m = ch["message"]
            if m.get("refusal") or ch.get("finish_reason") == "content_filter":
                raise Refuse("declined", "the model declined the request")
            text = m.get("content") or ""
            u = j.get("usage", {})
            tin = int(u.get("prompt_tokens", 0))
            tout = int(u.get("completion_tokens", 0))
            trunc = ch.get("finish_reason") == "length"
        if not isinstance(text, str):
            raise Refuse("badreply", "the reply text is not text")
    except (KeyError, IndexError, TypeError, ValueError, AttributeError):
        raise Refuse("badreply", "the provider's answer has a shape this helper does not know")
    return text, tin, tout, trunc


def https_call(p, method, path, headers, body, ca_file, timeout):
    """One request (POST or GET).  Returns (status, headers, raw).  The context verifies the certificate and the host name; there is no way to turn that off.
    Windows: with no ca-file the context holds the Windows certificate store (load_default_certs).  No proxy is used, as on Linux (owner, Q7)."""
    ctx = ssl.create_default_context(cafile=ca_file or None)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    ctx.check_hostname = True
    ctx.verify_mode = ssl.CERT_REQUIRED
    u = urllib.parse.urlsplit(p["url"])
    conn = http.client.HTTPSConnection(u.hostname, u.port or 443, timeout=CONNECT_TIMEOUT, context=ctx)
    try:
        conn.connect()
        conn.sock.settimeout(timeout)
        conn.request(method, path, body=body, headers=headers)
        r = conn.getresponse()
        raw = r.read(RAW_CAP + 1)
        return r.status, dict(r.getheaders()), raw
    finally:
        conn.close()


def call_once(p, method, path, headers, body, ca, left, limits):
    """https_call with the network failures turned into refusals, and an answer that is far too large refused."""
    try:
        status, rh, raw = https_call(p, method, path, headers, body, ca, left)
    except ssl.SSLCertVerificationError:
        raise Refuse("net", "the provider's certificate was not accepted")
    except ssl.SSLError:
        raise Refuse("net", "the TLS connection failed")
    except socket.timeout:
        raise Refuse("timeout", "no answer in %d seconds" % limits["timeout"])
    except (OSError, http.client.HTTPException):
        raise Refuse("net", "the provider could not be reached")
    if len(raw) > RAW_CAP:
        raise Refuse("badreply", "the provider's answer is far too large")
    return status, rh, raw


def provider_words(raw, key):
    """8 Nov 26: a short, safe excerpt of the provider's own explanation of a refusal (DeepSeek's 400 says the model does not exist; the helper used to say only "HTTP 400").
    The message of the error object both formats use; the key, if the provider repeated it, replaced; ASCII only (hygiene), one line, ERRTEXT_MAX characters.  '' when the
    answer holds no such message.  It goes back to the person who asked, never to a provider."""
    try:
        j = json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return ""
    msg = ""
    if isinstance(j, dict):
        e = j.get("error")
        if isinstance(e, dict):
            msg = e.get("message", "")
        elif isinstance(e, str):
            msg = e
        if not msg and isinstance(j.get("message"), str):
            msg = j["message"]
    if not isinstance(msg, str):
        return ""
    if key:
        msg = msg.replace(key, "<key>")
    msg, _ = hygiene(msg)
    msg = " ".join(msg.split())
    return msg[:ERRTEXT_MAX]


def check_status(status, raw, key):
    """The refusal for an answer that is not 200 (a redirect, the key, busy, any other), with the provider's own words where it gave some.  The words are left out for
    401 and 403: a provider may quote part of the key there."""
    if 300 <= status < 400:
        raise Refuse("refused", "the provider answered with a redirect, which is not followed")
    if status in (401, 403):
        raise Refuse("refused", "the provider did not accept the key")
    words = provider_words(raw, key)
    tail = (": " + words) if words else ""
    if status == 429 or status >= 500:
        raise Refuse("busy", "the provider is busy or failing (HTTP %d)%s" % (status, tail))
    if status != 200:
        raise Refuse("refused", "the provider refused the request (HTTP %d)%s" % (status, tail))


def ask(state, conf, name, p, model, key, system, prompt, maxtokens, limits, history=()):
    """The call, with one bounded retry on 429 and 5xx.  Returns (text, tin, tout, truncated)."""
    path, headers, body = build_request(name, p, key, model, system, prompt, maxtokens, history)
    ca = ca_file(conf)
    deadline = time.time() + limits["timeout"]
    for attempt in (1, 2):
        left = deadline - time.time()
        if left <= 0:
            raise Refuse("timeout", "no answer in %d seconds" % limits["timeout"])
        status, rh, raw = call_once(p, "POST", path, headers, body, ca, left, limits)
        if status in (429, 500, 502, 503, 504) and attempt == 1:
            try:
                wait = min(5.0, max(0.5, float(rh.get("Retry-After", "1"))))
            except ValueError:
                wait = 1.0
            if time.time() + wait < deadline:
                time.sleep(wait)
                continue
        check_status(status, raw, key)
        return parse_reply(p["format"], raw)
    raise Refuse("busy", "the provider is busy")


def ca_file(conf):
    ca = conf.get("ca-file", "") or None
    if ca and not plain_path(ca):
        raise Refuse("badconf", "ca-file is not a plain drive path written with /")
    return ca


# ---------------------------------------------------------------------------------------------------- the provider's list of models (8 Nov 26)

def models_path(p):
    """The path of the provider's list of models, made from its request path: .../chat/completions becomes .../models (OpenAI, DeepSeek, Google's compatible endpoint and
    the servers that copy them), .../messages becomes .../models (Anthropic).  None for a path that ends otherwise: a Custom server whose layout is not known."""
    path = urllib.parse.urlsplit(p["url"]).path or "/"
    for tail in ("/chat/completions", "/messages"):
        if path.endswith(tail):
            return path[: -len(tail)] + "/models"
    return None


def list_models(conf, name, p, key, limits):
    """The model names the provider offers this key, sorted, at most MODELS_MAX, each one a name the helper accepts (MODEL_RE).  One GET to the same host as the requests,
    with the same key and the same certificate rules; nothing of anybody's text is sent.  Refuse(nolist) when the provider has no list SD knows how to ask for."""
    path = models_path(p)
    if path is None:
        raise Refuse("nolist", "%s has no list of models this helper knows how to ask for: type the model's name" % p.get("name", name))
    headers = {"Accept": "application/json", "User-Agent": "sd-ai/1"}
    if p["auth"] == "bearer":
        headers["Authorization"] = "Bearer " + key
    else:
        headers["x-api-key"] = key
    if p["format"] == "anthropic":
        headers["anthropic-version"] = p.get("version") or "2023-06-01"
        path += "?limit=1000"                                         # Anthropic pages its list (20 by default)
    status, rh, raw = call_once(p, "GET", path, headers, None, ca_file(conf), limits["timeout"], limits)
    if status == 404:
        raise Refuse("nolist", "%s gives no list of models: type the model's name" % p.get("name", name))
    check_status(status, raw, key)
    try:
        j = json.loads(raw.decode("utf-8"))
        data = j["data"]
        ids = [d["id"] for d in data if isinstance(d, dict) and isinstance(d.get("id"), str)]
    except (ValueError, UnicodeDecodeError, KeyError, TypeError):
        raise Refuse("badreply", "the provider's list of models has a shape this helper does not know")
    out = set()
    for m in ids:
        if m.startswith("models/"):                                   # Google names its models models/<name>; requests take the name alone
            m = m[len("models/"):]
        if MODEL_RE.match(m):
            out.add(m)
    return sorted(out)[:MODELS_MAX]


# ---------------------------------------------------------------------------------------------------- one request

def read_context(state, providers_path):
    """The standing text and whose it is: the administrator's (state/context) when there is one, else the shipped default beside the providers file
    ('default'), else none.  A file that is not a plain file (a link or other reparse point included), is over CONTEXT_MAX or holds anything but printable
    ASCII and line feeds is not used (an administrator's that is bad gives 'bad' and no text: SD then sends none, rather than the default the administrator replaced)."""
    for path, whose in ((os.path.join(state, "context"), "own"), (os.path.join(os.path.dirname(providers_path), "ai-context"), "default")):
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            continue
        except OSError:
            return "", "bad"
        if not stat.S_ISREG(st.st_mode) or getattr(st, "st_file_attributes", 0) & FILE_ATTRIBUTE_REPARSE_POINT:
            return "", "bad"
        try:
            with open(path, "rb") as f:
                data = f.read(CONTEXT_MAX + 2)
        except OSError:
            return "", "bad"
        if len(data) > CONTEXT_MAX + 1:
            return "", "bad"
        try:
            text = data.decode("ascii").replace("\r\n", "\n").rstrip("\n")
        except UnicodeDecodeError:
            return "", "bad"
        if len(text) > CONTEXT_MAX or not CONTEXT_RE.match(text):
            return "", "bad"
        return text, whose
    return "", "none"


def status_reply(state, conf, table, uid, providers_path=DEFAULT_PROVIDERS):
    """What anyone allowed to ask may be told (provider, model, whether a key is set, the gate, the standing text) and, for the administrator, the connection details."""
    sel = None
    try:
        sel = selected(conf, table)
    except Refuse as e:
        return {"t": "err", "code": e.code, "msg": e.msg}
    out = {"t": "status", "provider": sel[0] if sel else "", "model": sel[2] if sel else "", "gate": may_ask(uid)}
    out["key"] = bool(sel) and os.path.isfile(os.path.join(state, "keys", sel[0]))
    if out["gate"] or (uid is not None and is_admin(uid)):
        out["context"], out["context-from"] = read_context(state, providers_path)        # S.160: sent by SD with every request, shown in its preview
    if uid is not None and is_admin(uid):
        det = {}
        for n in PROVIDERS:
            if n == "custom":
                p = {k[len("custom."):]: v for k, v in conf.items() if k.startswith("custom.")}
            else:
                p = dict(table[n])
            det[n] = {"name": p.get("name", n.title()), "url": p.get("url", ""), "format": p.get("format", ""), "auth": p.get("auth", ""),
                      "version": p.get("version", ""), "maxparam": p.get("maxparam", ""), "model": conf.get("model." + n, ""), "default": ("" if n == "custom" else p.get("model", "")),
                      "key": os.path.isfile(os.path.join(state, "keys", n))}
        out["providers"] = det
        out["ca-file"] = conf.get("ca-file", "")
        out["limits"] = {k: int_setting(conf, k) for k in LIMITS}
    return out


# ---------------------------------------------------------------------------------------------------- the settings (administrator only)

def write_conf(state, conf):
    """ai.conf from a dict, whole and atomic (a temporary file in the same directory, then replace).  Empty values are left out, except
    provider= (empty is AI off, said so on purpose).  The caller holds the lock and has already checked the result.  It takes the state directory's access list."""
    path = os.path.join(state, "ai.conf")
    lines = ["# ai.conf - the settings of the AI helper, written by sd-ai for the administrator (set.ai.*, the AI choice page).  Not for hand editing."]
    for k in sorted(conf):
        if conf[k] != "" or k == "provider":
            lines.append("%s=%s" % (k, conf[k]))
    tmp = path + ".new"
    with open(tmp, "w", encoding="ascii", newline="\n") as f:
        f.write("\n".join(lines) + "\n")
        f.flush()
        os.fsync(f.fileno())
    replace(tmp, path)


def write_key(state, name, key):
    """The key of one provider, encrypted for this account (DPAPI) in a private file of its own (private_create), replaced whole.  Never echoed, never logged."""
    d = os.path.join(state, "keys")
    tmp = os.path.join(d, "." + name + ".new")
    blob = dpapi(key.encode("ascii"), key_entropy(name), True)
    if blob is None:
        raise Refuse("nokey", "the key could not be encrypted for this helper")
    with private_create(tmp) as f:
        f.write(blob)
        f.flush()
        os.fsync(f.fileno())
    replace(tmp, os.path.join(d, name))


def set_context(state, v):
    """S.160: the administrator's standing text, replaced whole (a temporary file, then replace), or removed by an empty value, which
    puts the shipped default back.  Checked BEFORE it is written: printable ASCII and line feeds, at most CONTEXT_MAX bytes.  Never logged."""
    if not isinstance(v, str):
        raise Refuse("badreq", "the standing text is text")
    v = v.replace("\r\n", "\n").rstrip("\n")
    path = os.path.join(state, "context")
    if v == "":
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        return {"t": "ok", "context": "default"}
    if len(v) > CONTEXT_MAX or not CONTEXT_RE.match(v):
        raise Refuse("badreq", "the standing text is at most %d characters of printable ASCII and line feeds" % CONTEXT_MAX)
    tmp = path + ".new"
    with open(tmp, "w", encoding="ascii", newline="\n") as f:
        f.write(v + "\n")
        f.flush()
        os.fsync(f.fileno())
    replace(tmp, path)
    return {"t": "ok", "context": "own"}


def admin_op(state, providers_path, req):
    """set, keyset and keyclear: what the AI choice page and set.ai.* do.  Only the administrator gets here.  Every value is checked as the helper checks
    it at the time of use, and the whole result is checked BEFORE it is written, so a request can never leave a file the helper then refuses to read."""
    table = read_providers(providers_path)
    lock = os.open(os.path.join(state, "conf.lock"), os.O_RDWR | os.O_CREAT | os.O_BINARY, 0o600)
    try:
        with Locked(lock):
            conf = parse_kv(os.path.join(state, "ai.conf"))
            op = req["op"]
            if op in ("keyset", "keyclear"):
                name = req.get("provider")
                if name not in PROVIDERS:
                    raise Refuse("badreq", "provider must be one of %s" % ", ".join(PROVIDERS))
                if op == "keyclear":
                    try:
                        os.remove(os.path.join(state, "keys", name))
                    except FileNotFoundError:
                        pass
                    return {"t": "ok", "key": "clear"}
                key = req.get("key")
                if not isinstance(key, str) or not re.match(r"^[\x21-\x7e]{8,512}$", key):
                    raise Refuse("badreq", "a key is 8 to 512 printable characters with no space")
                write_key(state, name, key)
                return {"t": "ok", "key": "set"}
            what = req.get("what")
            if what == "context":
                return set_context(state, req.get("value"))
            new = dict(conf)
            if what == "provider":
                v = req.get("value")
                if not isinstance(v, str) or (v != "" and v not in PROVIDERS):
                    raise Refuse("badreq", "provider must be one of %s, or empty to turn the AI off" % ", ".join(PROVIDERS))
                new["provider"] = v
            elif what == "model":
                name, v = req.get("provider"), req.get("value")
                if name not in PROVIDERS or not isinstance(v, str) or (v != "" and not MODEL_RE.match(v)):
                    raise Refuse("badreq", "a provider and a model name of letters, digits and . _ : / @ + - (empty clears it)")
                new["model." + name] = v
            elif what == "custom":
                p = {k: req.get(k, "") for k in ("name", "url", "format", "auth", "version", "maxparam")}
                if not all(isinstance(v, str) for v in p.values()):
                    raise Refuse("badreq", "the custom connection is text")
                check_connection(p, "the custom provider")
                for k, v in p.items():
                    new["custom." + k] = v
            elif what == "custom-clear":
                if conf.get("provider") == "custom":
                    raise Refuse("badreq", "custom is the selected provider: select another first")
                for k in [k for k in new if k.startswith("custom.")]:
                    del new[k]
            elif what == "ca":
                v = req.get("value")
                if not isinstance(v, str) or (v != "" and (not plain_path(v) or not os.path.isfile(v) or not readable(v))):
                    raise Refuse("badreq", "ca-file is empty (the Windows certificate store) or a drive path written with / of a file this helper can read")
                new["ca-file"] = v
            elif what == "limit":
                name, v = req.get("name"), req.get("value")
                if name not in LIMITS or not isinstance(v, str) or not re.match(r"^[0-9]{1,10}$", v):
                    raise Refuse("badreq", "a limit is one of %s and a whole number" % ", ".join(LIMITS))
                new["limit." + name] = v
            else:
                raise Refuse("badreq", "what is one of provider, model, custom, custom-clear, ca, limit, context")
            selected(new, table)                                   # the whole result must be one the helper will read: custom complete before it is selected
            for k in LIMITS:
                int_setting(new, k)
            write_conf(state, new)
            return {"t": "ok"}
    finally:
        os.close(lock)


def readable(path):
    """Can this helper open the file?  (Linux: os.access R_OK, which on Windows reads only the read-only bit.)"""
    try:
        with open(path, "rb"):
            return True
    except OSError:
        return False


def handle(line, fd, state, providers_path):
    """One request line to one reply dict.  fd is the connection (for the caller)."""
    try:
        req = json.loads(line.decode("utf-8"))
        if not isinstance(req, dict) or req.get("v") != VERSION or req.get("op") not in ("ask", "status", "set", "keyset", "keyclear", "models"):
            raise ValueError
    except (ValueError, UnicodeDecodeError):
        return {"t": "err", "code": "badreq", "msg": "not a request this helper understands"}, "-"
    uid = peer(fd)
    if req["op"] == "models":
        # 8 Nov 26: the provider's list of models, for the administrator choosing one (the AI page's M, set.ai models).  The administrator's alone, as the settings are:
        # it spends the key, and the names are the administrator's choice to make.  Any provider with a key may be asked, not only the selected one.
        if uid is None or not is_admin(uid):
            return {"t": "err", "code": "noadmin", "msg": "only the administrator may ask for the list of models"}, "-"
        try:
            conf = parse_kv(os.path.join(state, "ai.conf"))
            table = read_providers(providers_path)
            name = req.get("provider") or conf.get("provider", "")
            if name not in PROVIDERS:
                raise Refuse("badreq", "provider must be one of %s" % ", ".join(PROVIDERS))
            _n, p, _m = selected(dict(conf, provider=name), table)
            key = read_key(state, name)
            limits = {k: int_setting(conf, k) for k in LIMITS}
            return {"t": "models", "provider": name, "models": list_models(conf, name, p, key, limits)}, name
        except Refuse as e:
            return {"t": "err", "code": e.code, "msg": e.msg}, "-"
    if req["op"] in ("set", "keyset", "keyclear"):
        if uid is None or not is_admin(uid):
            return {"t": "err", "code": "noadmin", "msg": "only the administrator may change the AI settings"}, "-"
        try:
            return admin_op(state, providers_path, req), "-"
        except Refuse as e:
            return {"t": "err", "code": e.code, "msg": e.msg}, "-"
    if not may_ask(uid):
        if req["op"] == "ask" or uid is None:
            return {"t": "err", "code": "nogate", "msg": "this account may not use the AI"}, "-"
    try:
        conf = parse_kv(os.path.join(state, "ai.conf"))
        table = read_providers(providers_path)
        if req["op"] == "status":
            return status_reply(state, conf, table, uid, providers_path), "-"
        limits = {k: int_setting(conf, k) for k in LIMITS}
        sel = selected(conf, table)
        if sel is None:
            raise Refuse("disabled", "no AI provider is selected")
        name, p, model = sel
        if not model:
            raise Refuse("nomodel", "no model has been chosen for %s" % p.get("name", name))
        if not MODEL_RE.match(model):
            raise Refuse("badconf", "the model name has characters a model name may not have")
        key = read_key(state, name)
        prompt = req.get("prompt")
        system = req.get("system", "")
        if not isinstance(prompt, str) or not prompt.strip() or not isinstance(system, str):
            raise Refuse("badreq", "a prompt is required")
        history = read_history(req)
        hbytes = sum(len(q.encode("utf-8")) + len(a.encode("utf-8")) for q, a in history)        # a follow-up's earlier exchanges count towards the limit
        if len(prompt.encode("utf-8")) + len(system.encode("utf-8")) + hbytes > limits["bytes-request"]:
            raise Refuse("toobig", "the request is over %d bytes" % limits["bytes-request"])
        try:
            maxtokens = int(req.get("maxtokens", limits["max-tokens"]))
        except (TypeError, ValueError):
            raise Refuse("badreq", "maxtokens is not a number")
        maxtokens = max(1, min(maxtokens, limits["max-tokens"]))
        counters(state, uid, time.time(), limits, count=True)
        text, tin, tout, trunc = ask(state, conf, name, p, model, key, system, prompt, maxtokens, limits, history)
        counters(state, uid, time.time(), limits, add_tokens=tin + tout)
        text, replaced = hygiene(text)
        if len(text.encode("ascii")) > limits["bytes-reply"]:
            raise Refuse("toobig", "the reply is over %d bytes" % limits["bytes-reply"])
        return {"t": "ok", "text": text, "in": tin, "out": tout, "provider": name, "truncated": trunc, "replaced": replaced}, name
    except Refuse as e:
        return {"t": "err", "code": e.code, "msg": e.msg}, "-"


def write_all(fd_out, data):
    view = 0
    while view < len(data):
        view += os.write(fd_out, data[view:])


def serve(fd_in, fd_out, state, providers_path, log):
    """Read one line from fd_in, answer on fd_out.  A watchdog ends the process if a call runs far past its own deadline (Linux: alarm; here a timer that writes
    the timeout reply, if none has been written, and ends the process)."""
    limit = LIMITS["bytes-request"] * 2 + 65536
    buf = b""
    while b"\n" not in buf and len(buf) <= limit:
        try:
            chunk = os.read(fd_in, 65536)
        except OSError:
            break
        if not chunk:
            break
        buf += chunk
    if b"\n" not in buf:
        if len(buf) > limit:
            reply, prov = {"t": "err", "code": "toobig", "msg": "the request is far too large"}, "-"
        else:
            reply, prov = {"t": "err", "code": "badreq", "msg": "no request line"}, "-"
    else:
        done = threading.Lock()

        def stuck():
            if done.acquire(blocking=False):
                try:
                    write_all(fd_out, (json.dumps({"t": "err", "code": "timeout", "msg": "no answer in time"}) + "\n").encode("ascii"))
                except OSError:
                    pass
                flush_out(fd_out)
            os._exit(4)

        dog = threading.Timer(WATCHDOG, stuck)
        dog.daemon = True
        dog.start()
        try:
            reply, prov = handle(buf.split(b"\n", 1)[0], fd_in, state, providers_path)
        except Refuse as e:
            reply, prov = {"t": "err", "code": e.code, "msg": e.msg}, "-"
        except Exception as e:       # nothing is allowed to escape as a traceback with request text in it
            reply, prov = {"t": "err", "code": "badreply", "msg": "internal error: %s" % e.__class__.__name__}, "-"
        if not done.acquire(blocking=False):
            return None                                  # the watchdog has answered and is ending the process
        dog.cancel()
    data = (json.dumps(reply, ensure_ascii=True) + "\n").encode("ascii")
    try:
        write_all(fd_out, data)
    except OSError:
        pass
    flush_out(fd_out)
    uid = peer(fd_in)
    log("%s sd-ai: sid=%s provider=%s status=%s in=%s out=%s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), uid, prov, reply.get("code", reply.get("t")),
                                                                  reply.get("in", "-"), reply.get("out", "-")))
    return reply


def flush_out(fd_out):
    """Wait until the client has read the reply (a pipe's buffered bytes would go with the handle otherwise); nothing for a file or a closed pipe."""
    try:
        k32.FlushFileBuffers(msvcrt.get_osfhandle(fd_out))
    except OSError:
        pass


# ---------------------------------------------------------------------------------------------------- the pipe and the service (Windows; Linux: systemd's socket)

def event_log(text):
    """One line to the Application event log, source sd-ai (install-aihelper.ps1 registers it).  Used when the service cannot start, so it is not silent."""
    try:
        h = adv.RegisterEventSourceW(None, SERVICE_NAME)
        if h:
            arr = (wt.LPCWSTR * 1)(text)
            adv.ReportEventW(h, 1, 0, 1, None, 1, 0, ctypes.cast(arr, ctypes.POINTER(wt.LPCWSTR)), None)        # EVENTLOG_ERROR_TYPE
            adv.DeregisterEventSource(h)
    except (OSError, AttributeError, ctypes.ArgumentError):
        pass


def pipe_sddl():
    """The pipe's security: owner this account (the kernel refuses a pipe owned by anyone else), SYSTEM and this account full, sdusers and Administrators
    PIPE_CLIENT_MASK, nothing for anyone else.  P: no inherited entries."""
    me = own_sid()
    if me is None:
        raise OSError("the account of this helper cannot be read")
    parts = ["O:%sD:P(A;;GA;;;SY)(A;;GA;;;%s)" % (me, me)]
    sdusers = account_sid("sdusers")
    if sdusers:
        parts.append("(A;;0x%08X;;;%s)" % (PIPE_CLIENT_MASK, sdusers))
    parts.append("(A;;0x%08X;;;BA)" % PIPE_CLIENT_MASK)
    return "".join(parts)


def create_pipe(name, first, sa):
    """One instance of the pipe.  first: FILE_FLAG_FIRST_PIPE_INSTANCE - if anyone else already made a pipe of this name, this fails, and the service will not run on it."""
    open_mode = 0x00000003 | (0x00080000 if first else 0)                 # PIPE_ACCESS_DUPLEX | FILE_FLAG_FIRST_PIPE_INSTANCE
    pipe_mode = 0x00000000 | 0x00000000 | 0x00000000 | 0x00000008         # PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS
    h = k32.CreateNamedPipeW(name, open_mode, pipe_mode, MAX_INSTANCES, PIPE_BUFFER, PIPE_BUFFER, 0, ctypes.byref(sa))
    if h == INVALID_HANDLE or h is None:
        return None, ctypes.get_last_error()
    return h, 0


class JOBOBJECT_BASIC_LIMIT_INFORMATION(ctypes.Structure):
    _fields_ = [("PerProcessUserTimeLimit", ctypes.c_int64), ("PerJobUserTimeLimit", ctypes.c_int64), ("LimitFlags", wt.DWORD),
                ("MinimumWorkingSetSize", ctypes.c_size_t), ("MaximumWorkingSetSize", ctypes.c_size_t), ("ActiveProcessLimit", wt.DWORD),
                ("Affinity", ctypes.c_size_t), ("PriorityClass", wt.DWORD), ("SchedulingClass", wt.DWORD)]


class IO_COUNTERS(ctypes.Structure):
    _fields_ = [(n, ctypes.c_uint64) for n in ("ReadOperationCount", "WriteOperationCount", "OtherOperationCount", "ReadTransferCount", "WriteTransferCount",
                                               "OtherTransferCount")]


class JOBOBJECT_EXTENDED_LIMIT_INFORMATION(ctypes.Structure):
    _fields_ = [("BasicLimitInformation", JOBOBJECT_BASIC_LIMIT_INFORMATION), ("IoInfo", IO_COUNTERS), ("ProcessMemoryLimit", ctypes.c_size_t),
                ("JobMemoryLimit", ctypes.c_size_t), ("PeakProcessMemoryUsed", ctypes.c_size_t), ("PeakJobMemoryUsed", ctypes.c_size_t)]


def make_job():
    """A job object that ends every request process when it is closed (the service stopping): JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE."""
    job = k32.CreateJobObjectW(None, None)
    if not job:
        return None
    info = JOBOBJECT_EXTENDED_LIMIT_INFORMATION()
    info.BasicLimitInformation.LimitFlags = 0x00002000
    if not k32.SetInformationJobObject(job, 9, ctypes.byref(info), ctypes.sizeof(info)):
        k32.CloseHandle(job)
        return None
    return job


class Listener:
    """The service's loop (Linux: sd-ai.socket with Accept=true).  ONE instance of the pipe always waits; each connection is handed to a new process of this
    program (--one), which inherits it as its standard input and output, and the next instance is made BEFORE this process lets go of the connected one, so
    there is never a moment with no instance of ours (another user could otherwise make the name)."""

    def __init__(self, name, state, providers, log_path):
        self.name, self.state, self.providers, self.log_path = name, state, providers, log_path
        self.stopping = threading.Event()
        self.children = []
        self.job = make_job()
        self.psd = ctypes.c_void_p()
        if not adv.ConvertStringSecurityDescriptorToSecurityDescriptorW(pipe_sddl(), 1, ctypes.byref(self.psd), None):
            raise OSError("the pipe's access list cannot be made")
        self.sa = SECURITY_ATTRIBUTES(ctypes.sizeof(SECURITY_ATTRIBUTES), self.psd, False)
        self.cur, err = create_pipe(self.name, True, self.sa)
        if self.cur is None:
            raise OSError("the pipe %s could not be made (error %d): another program may hold the name" % (self.name, err))

    def reap(self):
        self.children = [c for c in self.children if c.poll() is None]

    def spawn(self, h):
        fd = msvcrt.open_osfhandle(h, 0)
        try:
            with open(self.log_path, "ab") as logf:
                child = subprocess.Popen([sys.executable, "-I", "-B", os.path.abspath(__file__), "--one", "--state", self.state, "--providers", self.providers],
                                         stdin=fd, stdout=fd, stderr=logf, close_fds=True, creationflags=0x08000000)       # CREATE_NO_WINDOW
            if self.job:
                k32.AssignProcessToJobObject(self.job, int(child._handle))
            self.children.append(child)
        finally:
            os.close(fd)                                   # this process's copy; the child holds its own

    def run(self):
        while not self.stopping.is_set():
            ok = k32.ConnectNamedPipe(self.cur, None)
            if not ok and ctypes.get_last_error() != 535:          # ERROR_PIPE_CONNECTED: the client came first, which is a connection
                k32.CloseHandle(self.cur)
                self.cur = None
                while self.cur is None and not self.stopping.is_set():
                    self.cur, _err = create_pipe(self.name, False, self.sa)
                    if self.cur is None:
                        time.sleep(0.1)
                continue
            if self.stopping.is_set():
                break
            self.reap()
            nxt = None
            while nxt is None and not self.stopping.is_set():
                nxt, err = create_pipe(self.name, False, self.sa)      # every instance is in use (231, ERROR_PIPE_BUSY): wait for a request to end
                if nxt is None:
                    time.sleep(0.05)
                    self.reap()
            try:
                self.spawn(self.cur)                       # closes this process's handle of the connected instance
            except OSError as e:
                sys.stderr.write("sd-ai: a request process could not be started: %s\n" % e.__class__.__name__)
                k32.CloseHandle(self.cur)
            self.cur = nxt
        if self.cur:
            k32.CloseHandle(self.cur)
        if self.job:
            k32.CloseHandle(self.job)                      # ends any request still running

    def stop(self):
        """Ask the loop to end: set the flag, then connect to our own pipe once so that ConnectNamedPipe returns."""
        self.stopping.set()
        h = k32.CreateFileW(self.name, 0x80000000 | 0x40000000, 0, None, 3, 0, None)
        if h not in (None, INVALID_HANDLE):
            k32.CloseHandle(h)


# ---- the Windows service (SCM) ----
SERVICE_WIN32_OWN_PROCESS = 0x10
SERVICE_START_PENDING, SERVICE_RUNNING, SERVICE_STOP_PENDING, SERVICE_STOPPED = 2, 4, 3, 1
SERVICE_ACCEPT_STOP, SERVICE_ACCEPT_SHUTDOWN = 0x1, 0x4


class SERVICE_STATUS(ctypes.Structure):
    _fields_ = [(n, wt.DWORD) for n in ("dwServiceType", "dwCurrentState", "dwControlsAccepted", "dwWin32ExitCode", "dwServiceSpecificExitCode",
                                        "dwCheckPoint", "dwWaitHint")]


SERVICE_MAIN = ctypes.WINFUNCTYPE(None, wt.DWORD, ctypes.POINTER(wt.LPWSTR))
HANDLER_EX = ctypes.WINFUNCTYPE(wt.DWORD, wt.DWORD, wt.DWORD, ctypes.c_void_p, ctypes.c_void_p)


class SERVICE_TABLE_ENTRYW(ctypes.Structure):
    _fields_ = [("lpServiceName", wt.LPWSTR), ("lpServiceProc", SERVICE_MAIN)]


def run_service(state, providers):
    """Run under the service control manager (binPath ... --service).  Started, the loop runs until a stop or a shutdown."""
    adv.RegisterServiceCtrlHandlerExW.restype = ctypes.c_void_p
    adv.RegisterServiceCtrlHandlerExW.argtypes = [wt.LPCWSTR, HANDLER_EX, ctypes.c_void_p]
    adv.SetServiceStatus.argtypes = [ctypes.c_void_p, ctypes.POINTER(SERVICE_STATUS)]
    adv.StartServiceCtrlDispatcherW.argtypes = [ctypes.POINTER(SERVICE_TABLE_ENTRYW)]
    keep = {}
    status = SERVICE_STATUS(SERVICE_WIN32_OWN_PROCESS, SERVICE_START_PENDING, 0, 0, 0, 0, 10000)

    def set_state(s, code=0):
        status.dwCurrentState = s
        status.dwControlsAccepted = (SERVICE_ACCEPT_STOP | SERVICE_ACCEPT_SHUTDOWN) if s == SERVICE_RUNNING else 0
        status.dwWin32ExitCode = code
        status.dwCheckPoint = 0 if s in (SERVICE_RUNNING, SERVICE_STOPPED) else status.dwCheckPoint + 1
        adv.SetServiceStatus(keep["h"], ctypes.byref(status))

    def handler(control, etype, edata, ctx):
        if control in (1, 5):                              # SERVICE_CONTROL_STOP, SERVICE_CONTROL_SHUTDOWN
            set_state(SERVICE_STOP_PENDING)
            if keep.get("listener"):
                keep["listener"].stop()
            return 0
        return 0 if control == 4 else 120                  # INTERROGATE; ERROR_CALL_NOT_IMPLEMENTED

    def main(argc, argv):
        keep["h"] = adv.RegisterServiceCtrlHandlerExW(SERVICE_NAME, keep["handler"], None)
        if not keep["h"]:
            return
        set_state(SERVICE_START_PENDING)
        try:
            os.makedirs(os.path.join(state, "keys"), exist_ok=True)
            os.makedirs(os.path.join(state, "state"), exist_ok=True)
            keep["listener"] = Listener(PIPE_NAME, state, providers, os.path.join(state, "sd-ai.log"))
        except OSError as e:
            event_log("sd-ai could not start: %s" % e)
            set_state(SERVICE_STOPPED, 1064)               # ERROR_EXCEPTION_IN_SERVICE
            return
        set_state(SERVICE_RUNNING)
        try:
            keep["listener"].run()
        finally:
            set_state(SERVICE_STOPPED)

    keep["handler"] = HANDLER_EX(handler)
    keep["main"] = SERVICE_MAIN(main)
    table = (SERVICE_TABLE_ENTRYW * 2)(SERVICE_TABLE_ENTRYW(SERVICE_NAME, keep["main"]), SERVICE_TABLE_ENTRYW(None, SERVICE_MAIN()))
    if not adv.StartServiceCtrlDispatcherW(table):
        sys.stderr.write("sd-ai: --service is for the service control manager (error %d)\n" % ctypes.get_last_error())
        return 2
    return 0


def main(argv):
    state, providers, mode, pipe = DEFAULT_STATE, DEFAULT_PROVIDERS, None, None
    i = 1
    while i < len(argv):
        if argv[i] == "--state" and i + 1 < len(argv):
            state = argv[i + 1]
            i += 2
        elif argv[i] == "--providers" and i + 1 < len(argv):
            providers = argv[i + 1]
            i += 2
        elif argv[i] in ("--one", "--service") and mode is None:
            mode = argv[i]
            i += 1
        elif argv[i] == "--listen" and i + 1 < len(argv) and mode is None and argv[i + 1].lower().startswith("\\\\.\\pipe\\"):
            mode, pipe = argv[i], argv[i + 1]
            i += 2
        else:
            mode = "bad"
            break
    if mode == "--one":
        serve(0, 1, state, providers, sys.stderr.write)
        sys.stderr.flush()
        return 0
    if mode == "--service":
        return run_service(state, providers)
    if mode == "--listen":
        try:
            lst = Listener(pipe, state, providers, os.path.join(state, "sd-ai.log"))
        except OSError as e:
            sys.stderr.write("sd-ai: %s\n" % e)
            return 3
        try:
            lst.run()
        except KeyboardInterrupt:
            pass
        return 0
    sys.stderr.write("usage: sd-ai --service | --one | --listen \\\\.\\pipe\\NAME   [--state DIR] [--providers FILE]\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
