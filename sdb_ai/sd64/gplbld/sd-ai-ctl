#!/usr/bin/env python3
#
# sd-ai-ctl - the administrator's client of the AI helper (from Linux b1d496df, S.69 step 2; RELEASE_1.1 246).  Run as SDSYS (or another elevated Windows
# administrator): the helper refuses everyone else, by the account it reads from the pipe, so there is no password here and nothing to guess.  Standard library
# only.  SD runs it through sd-ai-ctl.ps1, which finds the all-users Python.
#
#   sd-ai-ctl [--pipe NAME] show [--json]
#   sd-ai-ctl [--pipe NAME] provider anthropic | openai | google | deepseek | custom | none
#   sd-ai-ctl [--pipe NAME] model PROVIDER NAME            (NAME - clears it: the provider's starting model is used again)
#   sd-ai-ctl [--pipe NAME] custom NAME URL FORMAT AUTH VERSION MAXPARAM      (VERSION - for none; FORMAT anthropic | openai; AUTH bearer | x-api-key)
#   sd-ai-ctl [--pipe NAME] custom-clear
#   sd-ai-ctl [--pipe NAME] ca PATH                         (PATH - for the Windows certificate store; a drive path written with /, C:/...)
#   sd-ai-ctl [--pipe NAME] limit NAME NUMBER               (requests-hour tokens-day timeout bytes-request bytes-reply max-tokens)
#   sd-ai-ctl [--pipe NAME] key PROVIDER                    (the key is read from the console and not shown; from standard input when it is not a console)
#   sd-ai-ctl [--pipe NAME] key PROVIDER --handover FILE    (Windows: the key is the first line of FILE, which is removed whatever happens)
#   sd-ai-ctl [--pipe NAME] key-clear PROVIDER
#   sd-ai-ctl [--pipe NAME] context HEX | -                 (S.160: the standing text sent with every request, hexadecimal ASCII; - the shipped default)
#   sd-ai-ctl [--pipe NAME] models PROVIDER
#
# THE KEY IS NEVER AN ARGUMENT (an argument is in the process list and the shell's history) and never printed.  SD's set.ai key verb runs this program
# with the console handed to it, so the key is typed here and never passes through SD.  Exit 0 done, 1 the helper refused (its code and words are
# printed), 2 the helper could not be reached or the command line is wrong.
#
# WINDOWS FACTS: EVERYTHING IS PRINTED ON STANDARD OUTPUT, the "could not be reached" line and the usage included: SD runs this through PowerShell 5.1, which
# would wrap a native program's standard error in error records where set.ai reads "error:" and "ok".  The pipe of the real name is checked before anything
# is sent - its owner must be the service account NT SERVICE\sd-ai - because a key sent to a pipe someone else made would be theirs (the pipe namespace is
# global; Linux's socket directory is root's).  --handover replaces Linux's "< file": PowerShell has no input redirection from a file.
#
# START-HISTORY:
# 13 Nov 26 Windows port - from Linux b1d496df (RELEASE_1.1 246): the pipe instead of the Unix socket (--pipe, SD_AI_PIPE instead of --socket, SD_AI_SOCKET),
#               the owner check, everything on stdout, key --handover FILE, the ca path written C:/...
# 8 Nov 26 dm   S.170: models PROVIDER, the provider's own list of model names ("models: N", then one name to a line, indented).
# 7 Nov 26 dm   S.160: context HEX | - (the standing text); show says whose it is and its length.
# 23 Oct 26 dm  New.
# END-HISTORY

import ctypes
import ctypes.wintypes as wt
import getpass
import json
import msvcrt
import os
import sys
import time

DEFAULT_PIPE = r"\\.\pipe\sd-ai"       # --pipe NAME names another; so does SD_AI_PIPE in the environment (the tests; the product never sets either)
SERVICE_ACCOUNT = r"NT SERVICE\sd-ai"
PROVIDERS = ("anthropic", "openai", "google", "deepseek", "custom")
PIPE_CLIENT_MASK = 0x00120183          # read, write, attributes, the owner: what the helper's pipe grants (win32ai.c AI_ACCESS is the same)
TIMEOUT = 60

k32 = ctypes.WinDLL("kernel32", use_last_error=True)
adv = ctypes.WinDLL("advapi32", use_last_error=True)
k32.CreateFileW.restype = wt.HANDLE
k32.CreateFileW.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, ctypes.c_void_p, wt.DWORD, wt.DWORD, wt.HANDLE]
k32.CloseHandle.argtypes = [wt.HANDLE]
k32.SetNamedPipeHandleState.argtypes = [wt.HANDLE, ctypes.POINTER(wt.DWORD), ctypes.c_void_p, ctypes.c_void_p]
k32.PeekNamedPipe.argtypes = [wt.HANDLE, ctypes.c_void_p, wt.DWORD, ctypes.c_void_p, ctypes.POINTER(wt.DWORD), ctypes.c_void_p]
k32.WriteFile.argtypes = [wt.HANDLE, ctypes.c_char_p, wt.DWORD, ctypes.POINTER(wt.DWORD), ctypes.c_void_p]
k32.ReadFile.argtypes = [wt.HANDLE, ctypes.c_void_p, wt.DWORD, ctypes.POINTER(wt.DWORD), ctypes.c_void_p]
k32.LocalFree.argtypes = [ctypes.c_void_p]
adv.GetSecurityInfo.restype = wt.DWORD
adv.GetSecurityInfo.argtypes = [wt.HANDLE, ctypes.c_int, wt.DWORD, ctypes.POINTER(ctypes.c_void_p), ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p,
                                ctypes.POINTER(ctypes.c_void_p)]
adv.LookupAccountNameW.argtypes = [wt.LPCWSTR, wt.LPCWSTR, ctypes.c_void_p, ctypes.POINTER(wt.DWORD), wt.LPWSTR, ctypes.POINTER(wt.DWORD), ctypes.POINTER(wt.DWORD)]
adv.EqualSid.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
INVALID_HANDLE = ctypes.c_void_p(-1).value


def say(s):
    sys.stdout.write(s + "\n")
    sys.stdout.flush()


def usage():
    say("usage: sd-ai-ctl [--pipe NAME] show [--json] | provider NAME|none | model PROVIDER NAME|- | custom NAME URL FORMAT AUTH VERSION|- MAXPARAM |\n"
        "                 custom-clear | ca PATH|- | limit NAME NUMBER | key PROVIDER [--handover FILE] | key-clear PROVIDER | context HEX|- | models PROVIDER")
    return 2


def owned_by_service(h):
    """Is the pipe's owner the service account?  Every doubt is no."""
    want = ctypes.create_string_buffer(68)
    wlen = wt.DWORD(len(want))
    dom = ctypes.create_unicode_buffer(256)
    dlen = wt.DWORD(len(dom))
    use = wt.DWORD()
    if not adv.LookupAccountNameW(None, SERVICE_ACCOUNT, want, ctypes.byref(wlen), dom, ctypes.byref(dlen), ctypes.byref(use)):
        return False
    owner = ctypes.c_void_p()
    sd = ctypes.c_void_p()
    if adv.GetSecurityInfo(h, 6, 0x1, ctypes.byref(owner), None, None, None, ctypes.byref(sd)) != 0:      # SE_KERNEL_OBJECT, OWNER_SECURITY_INFORMATION
        return False
    try:
        return bool(owner.value) and bool(adv.EqualSid(owner, want))
    finally:
        k32.LocalFree(sd)


def talk(path, req, check_owner):
    """One request, one reply (a dict).  The request is one JSON line; the helper answers with one and ends the connection.  The pipe is opened at
    identification level (the helper can read who called, never act as the caller), non-blocking, and given up after TIMEOUT seconds."""
    h = k32.CreateFileW(path, PIPE_CLIENT_MASK, 0, None, 3, 0x00100000 | 0x00010000, None)    # OPEN_EXISTING; SECURITY_SQOS_PRESENT | SECURITY_IDENTIFICATION
    if h in (None, INVALID_HANDLE):
        raise OSError("no helper on %s (error %d)" % (path, ctypes.get_last_error()))
    try:
        if check_owner and not owned_by_service(h):
            raise OSError("the pipe %s is not the AI helper's" % path)
        mode = wt.DWORD(0x00000001)                         # PIPE_NOWAIT, byte read mode
        if not k32.SetNamedPipeHandleState(h, ctypes.byref(mode), None, None):
            raise OSError("the pipe cannot be set up")
        data = (json.dumps(req) + "\n").encode("utf-8")
        deadline = time.time() + TIMEOUT
        done = 0
        while done < len(data):
            n = wt.DWORD()
            if not k32.WriteFile(h, data[done:done + 4096], min(4096, len(data) - done), ctypes.byref(n), None):
                raise OSError("the request could not be sent")
            done += n.value
            if n.value == 0:
                if time.time() > deadline:
                    raise OSError("the helper did not take the request")
                time.sleep(0.01)
        buf = b""
        while b"\n" not in buf:
            avail = wt.DWORD()
            if not k32.PeekNamedPipe(h, None, 0, None, ctypes.byref(avail), None):
                break                                       # the helper has closed its end
            if avail.value == 0:
                if time.time() > deadline:
                    raise OSError("no answer in %d seconds" % TIMEOUT)
                time.sleep(0.05)
                continue
            chunk = ctypes.create_string_buffer(min(avail.value, 65536))
            n = wt.DWORD()
            if not k32.ReadFile(h, chunk, len(chunk), ctypes.byref(n), None):
                break
            buf += chunk.raw[:n.value]
    finally:
        k32.CloseHandle(h)
    if not buf.strip():
        raise OSError("the helper gave no answer")
    return json.loads(buf.split(b"\n", 1)[0].decode("utf-8"))


def show(reply, as_json):
    if as_json:
        say(json.dumps(reply, indent=1, sort_keys=True))
        return
    say("AI provider in use by every account: %s" % (reply.get("provider") or "none (the AI is off)"))
    if "providers" not in reply:
        say("  model %s, key %s, your account's gate %s" % (reply.get("model") or "-", "set" if reply.get("key") else "not set", "on" if reply.get("gate") else "off"))
        return
    for n in PROVIDERS:
        p = reply["providers"][n]
        say("  [%s] %-9s %-10s %s  (%s, %s%s, size field %s)" % ("x" if reply.get("provider") == n else " ", n, p["name"], p["url"] or "(not set)", p["format"] or "-", p["auth"] or "-",
            (", version " + p["version"]) if p["version"] else "", p["maxparam"] or "-"))
        say("      model: %s   key: %s" % (p["model"] or (("%s (default)" % p["default"]) if p.get("default") else "(not set)"), "set" if p["key"] else "(not set)"))
    say("  ca-file: %s" % (reply.get("ca-file") or "(the Windows certificate store)"))
    say("  limits: " + ", ".join("%s=%s" % (k, v) for k, v in sorted(reply.get("limits", {}).items())))
    say("  standing text: %s, %d characters" % ({"own": "the administrator's", "default": "the shipped default", "none": "none", "bad": "unusable (none is sent)"}
                                              .get(reply.get("context-from"), "unknown"), len(reply.get("context", ""))))


def handover_key(path):
    """The key from the AI page's hand-over file (its first line), and the file removed whatever happens.  '' when it cannot be read."""
    try:
        with open(path, encoding="ascii", errors="replace") as f:
            return f.readline().rstrip("\r\n")
    except OSError:
        return ""
    finally:
        try:
            os.remove(path)
        except OSError:
            pass


def main(argv):
    path = os.environ.get("SD_AI_PIPE") or DEFAULT_PIPE
    args = argv[1:]
    if len(args) >= 2 and args[0] == "--pipe":
        path, args = args[1], args[2:]
    if not path.lower().startswith("\\\\.\\pipe\\"):
        return usage()
    check_owner = path.lower() == DEFAULT_PIPE.lower()
    if not args:
        return usage()
    cmd, rest = args[0], args[1:]
    req = None
    if cmd == "show" and rest in ([], ["--json"]):
        req = {"v": 1, "op": "status"}
    elif cmd == "provider" and len(rest) == 1:
        req = {"v": 1, "op": "set", "what": "provider", "value": "" if rest[0] == "none" else rest[0]}
    elif cmd == "model" and len(rest) == 2:
        req = {"v": 1, "op": "set", "what": "model", "provider": rest[0], "value": "" if rest[1] == "-" else rest[1]}
    elif cmd == "custom" and len(rest) == 6:
        req = {"v": 1, "op": "set", "what": "custom", "name": rest[0], "url": rest[1], "format": rest[2], "auth": rest[3], "version": "" if rest[4] == "-" else rest[4], "maxparam": rest[5]}
    elif cmd == "custom-clear" and not rest:
        req = {"v": 1, "op": "set", "what": "custom-clear"}
    elif cmd == "ca" and len(rest) == 1:
        req = {"v": 1, "op": "set", "what": "ca", "value": "" if rest[0] == "-" else rest[0]}
    elif cmd == "limit" and len(rest) == 2:
        req = {"v": 1, "op": "set", "what": "limit", "name": rest[0], "value": rest[1]}
    elif cmd == "context" and len(rest) == 1:
        # S.160: the standing text, as HEX (one word that a command line carries whole: SD's set.ai context gives it so), or - for the shipped default
        if rest[0] == "-":
            text = ""
        else:
            try:
                text = bytes.fromhex(rest[0]).decode("ascii")
            except (ValueError, UnicodeDecodeError):
                say("sd-ai-ctl: the standing text is given as hexadecimal ASCII")
                return 2
        req = {"v": 1, "op": "set", "what": "context", "value": text}
    elif cmd == "models" and len(rest) == 1:
        req = {"v": 1, "op": "models", "provider": rest[0]}          # 8 Nov 26 (S.170): the provider's own list, one name to a line
    elif cmd == "key-clear" and len(rest) == 1:
        req = {"v": 1, "op": "keyclear", "provider": rest[0]}
    elif cmd == "key" and len(rest) == 3 and rest[1] == "--handover":
        key = handover_key(rest[2])                                   # removed first, whatever follows
        if rest[0] not in PROVIDERS:
            say("sd-ai-ctl: the provider is one of %s" % ", ".join(PROVIDERS))
            return 2
        req = {"v": 1, "op": "keyset", "provider": rest[0], "key": key}
    elif cmd == "key" and len(rest) == 1:
        if rest[0] not in PROVIDERS:
            say("sd-ai-ctl: the provider is one of %s" % ", ".join(PROVIDERS))
            return 2
        if sys.stdin.isatty():
            key = getpass.getpass("Key for %s (not shown): " % rest[0])
        else:
            key = sys.stdin.readline().rstrip("\r\n")
        req = {"v": 1, "op": "keyset", "provider": rest[0], "key": key}
    if req is None:
        return usage()
    try:
        reply = talk(path, req, check_owner)
    except (OSError, ValueError) as e:
        say("sd-ai-ctl: the AI helper could not be reached (%s)" % e.__class__.__name__)
        return 2
    if reply.get("t") == "err":
        say("error: %s: %s" % (reply.get("code"), reply.get("msg")))
        return 1
    if cmd == "show":
        show(reply, rest == ["--json"])
    elif cmd == "models":
        say("models: %d" % len(reply.get("models", [])))
        for m in reply.get("models", []):
            say("  " + m)
    elif cmd == "key":
        say("The key for %s is set." % rest[0])
    elif cmd == "key-clear":
        say("The key for %s is cleared." % rest[0])
    else:
        say("ok")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
