# 19 Aug 26 Windows port - "windows" is a byte-exact copy of "linux" above,
# and it is the login default.  The name "linux" describes an operating
# system; what matters here is the byte protocol, and every Windows console
# host - cmd, PowerShell and Windows Terminal - speaks exactly this one:
#   arrows send ESC [ A/B/C/D, not the ESC O A/B/C/D of application cursor
#   mode, because nothing in SD ever sends smkx to enter that mode; and
#   backspace sends DEL, which is what kbs below says.
# vt100 and xterm say ESC O and ^H, so under either of those every arrow key
# and the backspace key are discarded.  PROJECT_STATUS.md 5.18.
#
# KEEP IT A COPY.  If linux is corrected, correct this too - the two are the
# same protocol and a difference between them is a defect, not a variant.
windows|Windows console,
    am, xenl, eo, mir, msgr, xon, ccc, bce,
    it#8, colors#8, pairs#64, ncv#18,
    bel=^G, cr=\r, csr=\E[%i%p1%d;%p2%dr, tbc=\E[3g, clear=\E[H\E[J, el=\E[K,
    ed=\E[J, hpa=\E[%i%p1%dG, cup=\E[%i%p1%d;%p2%dH, cud1=\n, home=\E[H,
    civis=\E[?25l\E[?1c, cub1=\b, cnorm=\E[?25h\E[?0c, cuf1=\E[C, cuu1=\E[A,
    cvvis=\E[?25h\E[?8c, dch1=\E[P, dl1=\E[M, smacs=\E[11m, blink=\E[5m,
    bold=\E[1m, dim=\E[2m, smir=\E[4h, invis=\E[8m, rev=\E[7m, smso=\E[7m,
    smul=\E[4m, ech=\E[%p1%dX, rmacs=\E[10m, sgr0=\E[0;10m, rmir=\E[4l,
    rmso=\E[27m, rmul=\E[24m, flash=\E[?5h\E[?5l, ich1=\E[@, il1=\E[L,
    kbs=, kdch1=\E[3~, kcud1=\E[B, kf1=\E[[A, kf10=\E[21~, kf2=\E[[B,
    kf3=\E[[C, kf4=\E[[D, kf5=\E[[E, kf6=\E[17~, kf7=\E[18~, kf8=\E[19~,
    kf9=\E[20~, khome=\E[1~, kich1=\E[2~, kcub1=\E[D, knp=\E[6~, kpp=\E[5~,
    kcuf1=\E[C, kcuu1=\E[A, nel=\r\n, dch=\E[%p1%dP, dl=\E[%p1%dM,
    ich=\E[%p1%d@, il=\E[%p1%dL, rs1=\Ec\E]R, rc=\E8, vpa=\E[%i%p1%dd, sc=\E7,
    ind=\n, ri=\EM,
    sgr=\E[0;10%?%p1%t;7%;%?%p2%t;4%;%?%p3%t;7%;%?%p4%t;5%;%?%p5%t;2%;%?%p6%t;1%;%?%p7%t;8%;%?%p9%t;11%;m,
    hts=\EH, ht=\t, kb2=\E[G, kcbt=\E[Z, kend=\E[4~, kspd=^Z, kf11=\E[23~,
    kf12=\E[24~, kf13=\E[25~, kf14=\E[26~, kf15=\E[28~, kf16=\E[29~,
    kf17=\E[31~, kf18=\E[32~, kf19=\E[33~, kf20=\E[34~, el1=\E[1K,
    u6=\E[%i%d;%dR, u7=\E[6n, op=\E[39;49m, oc=\E]R,
    initc=\E]P%p1%x%p2%{256}%*%{1000}%/%02x%p3%{256}%*%{1000}%/%02x%p4%{256}%*%{1000}%/%02x,
    kmous=\E[M, setaf=\E[3%p1%dm, setab=\E[4%p1%dm, smpch=\E[11m, rmpch=\E[10m,
